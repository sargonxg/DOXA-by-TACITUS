      "body_end": 952,
      "source_links": [],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-787650-b00009",
      "text": "San Marino: 3",
      "page": null,
      "paragraph": 9,
      "body_start": 954,
      "body_end": 967,
      "source_links": [],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-787650-b00010",
      "text": "Croatia: 2",
