      "paragraph": 10,
      "body_start": 969,
      "body_end": 979,
      "source_links": [],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-787650-b00011",
      "text": "The contestants from Moldova did not receive a single point from any other countries.",
