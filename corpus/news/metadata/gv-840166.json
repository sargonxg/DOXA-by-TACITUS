  "policy_sha256": "84f656b16099dcb248866f714453e5bd3e275bdb5d4929c4fad838ee8b29ed2c",
  "blocks": [
    {
      "id": "gv-840166-b00001",
      "text": "Soaring summer temperatures in Iran and widespread blackouts have pushed the government to shut down public offices in at least 12 provinces and warn of a possible nationwide week-long closure to conserve energy, according to Iran Open Data.",
      "page": null,
      "paragraph": 1,
      "body_start": 0,
      "body_end": 241,
      "source_links": [
        "https://iranopendata.org/en/article/269-iran-heat-water-crisis-shutdown/"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00002",
      "text": "Warnings about drought have echoed for years from Lake Urmia, the Hur-Al-Azim Marshes, Hamun, Anzali Lagoon, Quru Gol, Bakhtegan, and Zarivar. Yet chronic mismanagement has prevented any real solutions.",
      "page": null,
      "paragraph": 2,
      "body_start": 243,
      "body_end": 445,
      "source_links": [
        "http://aslonarfa.com/portfolio/h",
        "https://en.wikipedia.org/wiki/Anzali_Lagoon",
        "https://en.wikipedia.org/wiki/Bakhtegan_Lake",
        "https://en.wikipedia.org/wiki/Hamun_Lake",
        "https://en.wikipedia.org/wiki/Lake_Urmia",
        "https://en.wikipedia.org/wiki/Zrebar_Lake",
        "https://fa.wikipedia.org/wiki/%D9%82%D9%88%D8%B1%DB%8C%DA%AF%D9%84"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00003",
      "text": "The water crisis has now reached Iran’s capital. Tehran and Alborz provinces are experiencing the most severe water shortages in their history. As of July 11, 2025, official reports show major drops in dam reserves: Karaj Dam by 58 percent, Lar by 34 percent, Taleghan by 32 percent, and Latyan and Mamloo collectively by 47 percent. Since the beginning of the water year, inflow to these dams has totaled just 22.4 billion cubic meters—a 43 percent decrease from last year.",
      "page": null,
      "paragraph": 3,
      "body_start": 447,
      "body_end": 921,
      "source_links": [
        "https://en.wikipedia.org/wiki/Alborz_province",
        "https://en.wikipedia.org/wiki/Tehran_province",
        "https://www.asriran.com/fa/news/1076291/%DB%B4%DB%B3-%D8%AF%D8%B1%D8%B5%D8%AF-%D8%B9%D9%82%D8%A8-%D9%85%D8%A7%D9%86%D8%AF%DA%AF%DB%8C-%D8%AF%D8%B1-%D9%88%D8%B1%D9%88%D8%AF%DB%8C-%D8%B3%D8%AF%D9%87%D8%A7-%D9%86%D8%B3%D8%A8%D8%AA-%D8%A8%D9%87-%D8%B3%D8%A7%D9%84-%DA%AF%D8%B0%D8%B4%D8%AA%D9%87",
        "https://www.eghtesadran.com/%D8%A2%D8%A8-%D9%86%DB%8C%D8%B3%D8%AA-%D8%AA%D9%87%D8%B1%D8%A7%D9%86%DB%8C-%D9%87%D8%A7-%D8%AF%D8%B1-%D9%85%D8%AD%D8%A7%D8%B5%D8%B1-%D8%AE%D8%B4%DA%A9%D8%B3%D8%A7%D9%84%DB%8C/",
        "https://www.isna.ir/news/1404043018730/%D8%A8%D8%AD%D8%B1%D8%A7%D9%86-%D8%A2%D8%A8-%D8%AC%D8%AF%DB%8C-%D8%AA%D8%B1-%D8%A7%D8%B2-%D9%87%D9%85%DB%8C%D8%B4%D9%87-%D9%85%D8%B3%D8%A6%D9%88%D9%84%D8%A7%D9%86-%D8%B5%D8%B1%D9%81%D9%87-%D8%AC%D9%88%DB%8C%DB%8C-%DA%A9%D9%86%DB%8C%D8%AF-%DA%A9%D8%A7%D8%B1%D8%B4%D9%86%D8%A7%D8%B3%D8%A7%D9%86",
        "https://www.yjc.ir/fa/news/8979441/%DB%B2%DB%B4-%D8%A7%D8%B3%D8%AA%D8%A7%D9%86-%D9%88-%DB%B5%DB%B0-%D8%B4%D9%87%D8%B1-%DA%A9%D8%B4%D9%88%D8%B1-%D8%A8%D8%A7-%D8%AA%D9%86%D8%B4-%D8%A2%D8%A8%DB%8C-%D9%85%D9%88%D8%A7%D8%AC%D9%87-%D8%A7%D8%B3%D8%AA%DB%B4%DB%B0-%D8%AF%D8%B1%D8%B5%D8%AF-%D8%A8%D8%A7%D8%B1%D8%B4-%D8%A2%D8%A8-%D9%87%D8%A7-%DA%A9%D8%A7%D9%87%D8%B4-%DB%8C%D8%A7%D9%81%D8%AA%D9%87-%D8%A7%D8%B3%D8%AA"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00004",
      "text": "An apocalyptic scenario",
      "page": null,
      "paragraph": 4,
      "body_start": 923,
      "body_end": 946,
      "source_links": [],
      "source_kind": "h3",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00005",
      "text": "The Ministry of Energy has urged citizens to drastically reduce water usage. Only 46 percent of the country's dam capacity is currently full, a decrease of 26 percent from the previous year. Citizens are now paying the price for decades of governmental mismanagement—just as they did with last year’s electricity crisis. According to the spokesperson for Iran’s Water Industry, Tehran, Alborz, and parts of Qazvin are under the highest water stress. Consumption in Tehran must drop from 3.7 billion to 2.2 billion cubic meters by 2028.",
      "page": null,
      "paragraph": 5,
      "body_start": 948,
      "body_end": 1483,
      "source_links": [
        "https://carnegieendowment.org/sada/2025/06/irans-energy-dilemma-constraints-repercussions-and-policy-options?lang=en",
        "https://de.wikipedia.org/wiki/Qazvin",
        "https://donya-e-eqtesad.com/%D8%A8%D8%AE%D8%B4-%D8%B5%D9%86%D8%B9%D8%AA-%D9%85%D8%B9%D8%AF%D9%86-3/4198130-%D8%B1%D8%A7%D9%87%DA%A9%D8%A7%D8%B1-%D8%B3%D9%87-%D9%84%D8%A7%DB%8C%D9%87-%D8%A8%D8%AD%D8%B1%D8%A7%D9%86-%D8%A2%D8%A8",
        "https://en.wikipedia.org/wiki/Alborz_province",
        "https://fararu.com/fa/news/886633/%D9%BE%D8%A7%DB%8C%D8%AA%D8%AE%D8%AA-%D8%AF%D8%B1-%D8%A2%D8%B3%D8%AA%D8%A7%D9%86%D9%87-%D9%81%D8%A7%D8%AC%D8%B9%D9%87-%D8%A8%D8%AD%D8%B1%D8%A7%D9%86-%D8%A2%D8%A8%DB%8C-%D8%A8%DB%8C-%D8%B3%D8%A7%D8%A8%D9%82%D9%87-%D8%AF%D8%B1-%D8%AA%D9%87%D8%B1%D8%A7%D9%86-%DA%A9%D8%B1%D8%AC",
        "https://rahbordemoaser.ir/fa/news/284144/%D8%B3%D8%AE%D9%86%DA%AF%D9%88%DB%8C-%D8%B5%D9%86%D8%B9%D8%AA-%D8%A2%D8%A8-%D8%AA%D9%87%D8%B1%D8%A7%D9%86-%D9%88-%D8%A7%D9%84%D8%A8%D8%B1%D8%B2-%D8%A8%D8%A7-%DB%B2%DB%B0-%D9%85%DB%8C%D9%84%DB%8C%D9%88%D9%86-%D8%AC%D9%85%D8%B9%DB%8C%D8%AA-%D8%AF%D8%B1-%D9%85%D8%B9%D8%B1%D8%B6-%D8%A8%DB%8C%D8%B4%D8%AA%D8%B1%DB%8C%D9%86-%D8%AA%D9%86%D8%B4-%D8%A2%D8%A8%DB%8C-%D9%87%D8%B3%D8%AA%D9%86%D8%AF-%D8%AF%D8%B1-%DB%B2%DB%B4-%D8%A7%D8%B3%D8%AA%D8%A7%D9%86-%D9%88-%DB%B5%DB%B0-%D8%B4%D9%87%D8%B1-%D8%AA%D9%86%D8%B4-%D8%A2%D8%A8%DB%8C-%D8%AF%D8%A7%D8%B1%DB%8C%D9%85",
        "https://www.asriran.com/fa/news/1079343/%D9%86%D8%B8%D8%A7%D8%B1%D8%AA-%D8%A8%D8%B1-%DA%A9%DB%8C%D9%81%DB%8C%D8%AA-%D8%A2%D8%A8-%D8%A8%D9%87%E2%80%8C%D8%B5%D9%88%D8%B1%D8%AA-%D9%85%D8%B3%D8%AA%D9%85%D8%B1-%D8%A7%D8%AF%D8%A7%D9%85%D9%87-%D8%AF%D8%A7%D8%B1%D8%AF"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00006",
      "text": "Experts warn that if consumption is not reduced, Tehran could face an “apocalyptic” scenario akin to the prolonged water cutoffs experienced by the city of Hamedan in 2022. Beyond the drought itself, much of the crisis stems from poor consumption patterns and a lack of ecological infrastructure. A member of Tehran’s city council has noted that the capital’s infrastructure cannot handle population growth and that comparisons to other megacities are misleading. He brings up the importance of consumption reform, greywater recycling, and halting unrestrained urban development.",
      "page": null,
      "paragraph": 6,
      "body_start": 1485,
      "body_end": 2064,
      "source_links": [
        "https://en.wikipedia.org/wiki/Apocalyptic",
        "https://fa.wikipedia.org/wiki/%D8%A8%D8%AD%D8%B1%D8%A7%D9%86_%D8%A2%D8%A8_%DB%B1%DB%B4%DB%B0%DB%B1_%D9%87%D9%85%D8%AF%D8%A7%D9%86",
        "https://www.sharghdaily.com/%D8%A8%D8%AE%D8%B4-%D8%B1%D9%88%D8%B2%D9%86%D8%A7%D9%85%D9%87-100/941521-%D8%AA%D9%87%D8%B1%D8%A7%D9%86-%D8%A8%D9%87-%D8%AD%D8%A7%D9%84-%D8%AE%D9%88%D8%AF-%D8%B1%D9%87%D8%A7-%D8%B4%D8%AF%D9%87-%D8%A7%D8%B3%D8%AA#:~:text=%DB%B1%DB%B4%20%D9%85%DB%8C%D9%84%DB%8C%D9%88%D9%86%20%D9%88%20%D8%B4%D9%87%D8%B1%20%D8%AA%D9%87%D8%B1%D8%A7%D9%86,%D8%B7%D8%B1%DB%8C%D9%82%20%D8%A7%DB%8C%D9%86%20%D9%84%DB%8C%D9%86%DA%A9%20%D9%BE%DB%8C%DA%AF%DB%8C%D8%B1%DB%8C%20%DA%A9%D9%86%DB%8C%D8%AF."
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00007",
      "text": "The head of the council’s Health Commission has stated that, although the municipality has allocated significant funds to water transfer projects from the Taleghan and Lar dams, these efforts are time-consuming and insufficient on their own. Jahangir Parhamat, a natural resources expert, told the outlet Fararu that the country is facing an “intensifying and severe crisis.” He claims Iran is experiencing a drought cycle whose return period could exceed a century.",
      "page": null,
      "paragraph": 7,
      "body_start": 2066,
      "body_end": 2532,
      "source_links": [
        "https://fararu.com/fa/news/886489/%D8%A8%D8%AD%D8%B1%D8%A7%D9%86-%D8%A2%D8%A8-%D8%AA%D9%87%D8%B1%D8%A7%D9%86-%D9%86%D9%87-%D8%A7%D9%81%D8%B3%D8%A7%D9%86%D9%87-%D8%A7%D8%B3%D8%AA-%D9%86%D9%87-%D8%B3%DB%8C%D8%A7%D9%87-%D9%86%D9%85%D8%A7%DB%8C%DB%8C-%D8%AF%D9%88%D8%B1%D9%87-%D8%A8%D8%B1%DA%AF%D8%B4%D8%AA-%D8%A7%DB%8C%D9%86-%D8%AE%D8%B4%DA%A9%D8%B3%D8%A7%D9%84%DB%8C-%D8%B5%D8%AF%D8%B3%D8%A7%D9%84-%D8%AF%DB%8C%DA%AF%D8%B1-%D8%A7%D8%B3%D8%AA",
        "https://www.iran-emrooz.net/index.php/news1/2013-07-21_1204/khabaronline.ir/x4bRf",
        "https://www.pishkhan.com/news/336675"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00008",
      "text": "Statistical analyses show a consistent decline in rainfall, and the past winter saw alarmingly little snow—meaning the mountains were unable to store water to slowly release during the hot season.",
      "page": null,
      "paragraph": 8,
      "body_start": 2534,
      "body_end": 2730,
      "source_links": [],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00009",
      "text": "Worsening crisis",
      "page": null,
      "paragraph": 9,
      "body_start": 2732,
      "body_end": 2748,
      "source_links": [],
      "source_kind": "h3",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00010",
      "text": "According to assessments, 2025 marks the beginning of a difficult era for Iran’s water and energy sectors. Average precipitation during the current hydrological year was just 101 mm—37 percent below the long-term average. In Tehran, it has dropped 46 percent. Inflow to national reservoirs has dropped to 9.5 billion cubic meters, 3.5 billion less than last year. Key dams like Karaj and Lar have lost much of their storage capacity. Karaj Dam, with a capacity of 179 million cubic meters, now holds just 11 million—only 7 percent of its capacity. At the same time last year, it held 29 million cubic meters.",
      "page": null,
      "paragraph": 10,
      "body_start": 2750,
      "body_end": 3358,
      "source_links": [
        "https://fa.wikipedia.org/wiki/%D8%B3%D8%AF_%D9%84%D8%A7%D8%B1",
        "https://snn.ir/fa/news/1237894/%D8%AF%D8%B1-%D8%AD%D8%A7%D9%84-%D8%AD%D8%A7%D8%B6%D8%B1-%DB%B3%DB%B7-%D8%AF%D8%B1%D8%B5%D8%AF-%D8%B9%D9%82%D8%A8-%D9%85%D8%A7%D9%86%D8%AF%DA%AF%DB%8C-%D8%A8%D8%A7%D8%B1%D8%B4-%D8%AF%D8%B1-%DA%A9%D8%B4%D9%88%D8%B1-%D9%88%D8%AC%D9%88%D8%AF-%D8%AF%D8%A7%D8%B1%D8%AF",
        "https://www.asriran.com/fa/news/1044045/%D9%87%D8%B4%D8%AF%D8%A7%D8%B1-%D8%B0%D8%AE%DB%8C%D8%B1%D9%87-%D8%B3%D8%AF-%DA%A9%D8%B1%D8%AC-%D8%A8%D9%87-7-%D8%AF%D8%B1%D8%B5%D8%AF-%D8%B1%D8%B3%DB%8C%D8%AF-%DA%A9%D8%A7%D9%87%D8%B4-%D8%A8%DB%8C%E2%80%8C%D8%B3%D8%A7%D8%A8%D9%82%D9%87-%D8%A8%D8%A7%D8%B1%D9%86%D8%AF%DA%AF%DB%8C-%D8%AF%D8%B1-%D9%86%DB%8C%D9%85-%D9%82%D8%B1%D9%86-%D8%A7%D8%AE%DB%8C%D8%B1",
        "https://www.asriran.com/fa/news/1077594/%D8%A2%D8%BA%D8%A7%D8%B2-%D8%AC%DB%8C%D8%B1%D9%87%E2%80%8C%D8%A8%D9%86%D8%AF%DB%8C-%D8%AE%D8%A7%D9%85%D9%88%D8%B4-%D8%A2%D8%A8",
        "https://www.britannica.com/place/Karaj-Dam",
        "https://www.entekhab.ir/fa/news/855284/%DA%A9%D8%A7%D9%87%D8%B4-%DA%86%D8%B4%D9%85%DA%AF%DB%8C%D8%B1-%D8%A8%D8%A7%D8%B1%D9%86%D8%AF%DA%AF%DB%8C-%D8%AF%D8%B1-%DB%B2%DB%B8-%D8%A7%D8%B3%D8%AA%D8%A7%D9%86-%D8%B3%D8%A7%D9%84-%D8%A2%D8%A8%DB%8C-%D8%AC%D8%A7%D8%B1%DB%8C-%DB%8C%DA%A9%DB%8C-%D8%A7%D8%B2-%D8%A8%D8%AF%D8%AA%D8%B1%DB%8C%D9%86-%D8%B3%D8%A7%D9%84%E2%80%8C%D9%87%D8%A7%DB%8C-%D9%86%DB%8C%D9%85%E2%80%8C%D9%82%D8%B1%D9%86-%D8%A7%D8%AE%DB%8C%D8%B1%C2%A0%C2%A0%D8%A7%D8%B3%D8%AA"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00011",
      "text": "Excessive withdrawal from underground aquifers has worsened the crisis of land subsidence. In some urban areas, the ground is sinking by up to 30 cm per year—1.5 times higher than the previous year. Since the 2000s, the government has encouraged drilling deep wells, leading to around 300,000 illegal and 500,000 legal wells. The Ministry of Energy states that groundwater withdrawal should not exceed 48 billion cubic meters per year—yet current rates exceed 54 billion.",
      "page": null,
      "paragraph": 11,
      "body_start": 3360,
      "body_end": 3831,
      "source_links": [
        "https://hammihanonline.ir/%D8%A8%D8%AE%D8%B4-%D8%AA%DB%8C%D8%AA%D8%B1-%DB%8C%DA%A9-14/25984-%D9%81%D8%B1%D9%88%D9%86%D8%B4%D8%B3%D8%AA-%D8%B2%D9%85%DB%8C%D9%86-%D8%A7%DB%8C%D8%B1%D8%A7%D9%86",
        "https://www.asriran.com/fa/news/1076673/%DB%B3%DB%B0-%D8%B3%D8%A7%D9%86%D8%AA%DB%8C-%D9%85%D8%AA%D8%B1-%D9%81%D8%B1%D9%88%D9%86%D8%B4%D8%B3%D8%AA-%D8%AF%D8%B1-%D8%AA%D9%87%D8%B1%D8%A7%D9%86-%D8%AF%D8%B1-%DB%8C%DA%A9-%D8%B3%D8%A7%D9%84",
        "https://www.asriran.com/fa/news/652583/%D9%85%D8%AC%D9%88%D8%B2-%D8%A8%D8%B1%D8%A7%DB%8C-%D8%AD%D9%81%D8%B1-%DA%86%D8%A7%D9%87-%D8%B9%D9%85%DB%8C%D9%82-%D8%AF%D8%B1-%D8%AF%D8%B4%D8%AA%E2%80%8C%D9%87%D8%A7%DB%8C-%D9%85%D9%85%D9%86%D9%88%D8%B9%D9%87-%D8%A7%DB%8C%D8%B1%D8%A7%D9%86",
        "https://www.bultannews.com/fa/news/398778/%D9%85%D8%B4%D8%A7%D9%88%D8%B1-%D9%88%D8%B2%DB%8C%D8%B1-%D9%86%DB%8C%D8%B1%D9%88%D8%B4%D8%B4-%D9%85%DB%8C%D9%84%DB%8C%D8%A7%D8%B1%D8%AF-%D9%85%D8%AA%D8%B1%D9%85%DA%A9%D8%B9%D8%A8-%D8%A7%D8%B2-%D9%85%D9%86%D8%A7%D8%A8%D8%B9-%D8%A2%D8%A8-%D8%B2%DB%8C%D8%B1%D8%B2%D9%85%DB%8C%D9%86%DB%8C-%DA%A9%D8%B4%D9%88%D8%B1-%D8%A7%D8%B6%D8%A7%D9%81%D9%87-%D8%A8%D8%B1%D8%AF%D8%A7%D8%B4%D8%AA-%D9%85%DB%8C-%D8%B4%D9%88%D8%AF",
        "https://www.yjc.ir/fa/news/8969315/%D8%A8%DB%8C%D8%B4-%D8%A7%D8%B2-%DB%B1%DB%B5-%D9%85%DB%8C%D9%84%DB%8C%D8%A7%D8%B1%D8%AF-%D9%85%D8%AA%D8%B1-%D9%85%DA%A9%D8%B9%D8%A8-%D8%A8%D8%B1%D8%AF%D8%A7%D8%B4%D8%AA-%D8%BA%DB%8C%D8%B1%D9%85%D8%AC%D8%A7%D8%B2-%D8%A2%D8%A8-%D8%AF%D8%B1-%DA%A9%D8%B4%D9%88%D8%B1-%D8%AF%D8%A7%D8%B1%DB%8C%D9%85-%D9%81%DB%8C%D9%84%D9%85"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00012",
      "text": "Combined with reduced rainfall and snowmelt, weakened rivers, and management failures, evaporation and over-extraction are intensifying the crisis. The spokesperson for the water industry has warned that rationing might be inevitable in summer 2025.",
      "page": null,
      "paragraph": 12,
      "body_start": 3833,
      "body_end": 4082,
      "source_links": [
        "https://44300981.khabarban.com/"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00013",
      "text": "However, rationing itself brings additional problems: fluctuating pressure, sediment intrusion into household networks, and psychological stress. Tehran consumes five times the national average of drinking water. With a population near 20 million—driven by industrial, governmental, and migration-related concentration—basic conservation campaigns and plumbing upgrades are insufficient to meet the scale of the crisis.",
      "page": null,
      "paragraph": 13,
      "body_start": 4084,
      "body_end": 4503,
      "source_links": [
        "https://fararu.com/fa/news/886456/%D8%AA%D9%87%D8%B1%D8%A7%D9%86-%D8%A7%D9%84%D8%A8%D8%B1%D8%B2-%D8%A8%D8%A7-%D9%85%DB%8C%D9%84%DB%8C%D9%88%D9%86-%D9%86%D9%81%D8%B1-%D8%AF%D8%B1-%D8%A2%D8%B3%D8%AA%D8%A7%D9%86%D9%87-%D8%AA%D9%86%D8%B4-%D8%A2%D8%A8%DB%8C"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00014",
      "text": "No solution in sight",
      "page": null,
      "paragraph": 14,
      "body_start": 4505,
      "body_end": 4525,
      "source_links": [],
      "source_kind": "h3",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00015",
      "text": "Since the late Pahlavi era, a project known as Iranrud has proposed connecting the Sea of Oman to the Caspian Sea to address water shortages. It resurfaced in the 1990s, with estimated costs as high as USD 14 billion. However, decades later, neither Iranrud nor smaller projects — such as reviving Lake Hamun, redirecting the Zab River, or transferring water from the Caspian or Aras rivers to Lake Urmia — have materialized.",
      "page": null,
      "paragraph": 15,
      "body_start": 4527,
      "body_end": 4952,
      "source_links": [
        "https://fa.wikipedia.org/wiki/%D8%A7%DB%8C%D8%B1%D8%A7%D9%86%D8%B1%D9%88%D8%AF",
        "https://fa.wikipedia.org/wiki/%D8%AF%D9%88%D8%AF%D9%85%D8%A7%D9%86_%D9%BE%D9%87%D9%84%D9%88%DB%8C",
        "https://inn.ir/news/article/111917/%D8%B2%D8%A7%D8%A8-%D8%A8%D9%87-%DA%A9%D8%B4%D8%A7%D9%88%D8%B1%D8%B2%DB%8C-%D8%B1%D8%B3%DB%8C%D8%AF-%D9%86%D9%87-%D8%AF%D8%B1%DB%8C%D8%A7%DA%86%D9%87-%D8%A7%D8%B1%D9%88%D9%85%DB%8C%D9%87",
        "https://mana.ir/fa/news/90108/%D8%A2%D8%BA%D8%A7%D8%B2-%D9%BE%D8%B1%D9%88%DA%98%D9%87-%DB%B5-%D8%B3%D8%A7%D9%84%D9%87-%D8%A7%D8%AD%DB%8C%D8%A7%DB%8C-%D8%AA%D8%A7%D9%84%D8%A7%D8%A8-%D9%87%D8%A7%D9%85%D9%88%D9%86-%D8%A8%D8%A7-%DB%B1%DB%B0-%D9%85%DB%8C%D9%84%DB%8C%D9%88%D9%86-%DB%8C%D9%88%D8%B1%D9%88-%D8%A7%D8%B9%D8%AA%D8%A8%D8%A7%D8%B1",
        "https://rc.majlis.ir/fa/news/show/764439",
        "https://www.isna.ir/news/98072317409/%D9%85%DB%8C-%D8%AE%D9%88%D8%A7%D8%B3%D8%AA%D9%86%D8%AF-%D8%A2%D8%A8-%D8%AE%D8%B2%D8%B1-%D8%B1%D8%A7-%D8%A8%D9%87-%D8%AF%D8%B1%DB%8C%D8%A7%DA%86%D9%87-%D8%A7%D8%B1%D9%88%D9%85%DB%8C%D9%87-%D9%85%D9%86%D8%AA%D9%82%D9%84-%DA%A9%D9%86%D9%86%D8%AF",
        "https://www.tahlilbazaar.com/news/242148/%D9%85%D8%B2%D8%A7%DB%8C%D8%A7%DB%8C-%D8%B3%D8%A7%D8%AE%D8%AA-%D9%BE%D8%B1%D9%88%DA%98%D9%87-%D8%A7%DB%8C%D8%B1%D8%A7%D9%86-%D8%B1%D9%88%D8%AF-%D8%AF%D8%B1-%D8%B4%D8%B1%D8%A7%DB%8C%D8%B7-%DA%A9%D9%85%D8%A8%D9%88%D8%AF-%D8%A2%D8%A8-%D8%A7%DB%8C%D8%B1%D8%A7%D9%86-%D8%AA%D8%AD%D8%B1%DB%8C%D9%85-%D8%A7%D9%85%D8%B1%DB%8C%DA%A9%D8%A7"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00016",
      "text": "Considering that over 95 percent of Iran’s water use is in agriculture, focusing solely on urban drinking water is futile unless agriculture and industry are comprehensively restructured. Water must be redefined as a national security asset.",
      "page": null,
      "paragraph": 16,
      "body_start": 4954,
      "body_end": 5195,
      "source_links": [
        "https://www.iranjib.ir/shownews/52691/95-%D8%AF%D8%B1%D8%B5%D8%AF-%D8%A7%D8%B2-%D8%A2%D8%A8-%DA%A9%D8%B4%D9%88%D8%B1-%D8%AF%D8%B1-%D8%AD%D9%88%D8%B2%D9%87-%DA%A9%D8%B4%D8%A7%D9%88%D8%B1%D8%B2%DB%8C-%D9%85%D8%B5%D8%B1%D9%81-%D9%85%DB%8C%E2%80%8C%E2%80%8C%E2%80%8C%E2%80%8C%E2%80%8C%E2%80%8C%D8%B4%D9%88%D8%AF/"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00017",
      "text": "In the short term, no immediate solution exists to resolve Tehran’s crisis as long as the intertwined crises of water, energy, and electricity persist. Given Iran’s economic struggles, international sanctions, and domestic instability, launching mega-projects like Iranrud or Caspian transfers seems highly improbable. If current policies continue, Tehran may soon become a city governed by strict water rationing—a catastrophe for a metropolis of that size.",
      "page": null,
      "paragraph": 17,
      "body_start": 5197,
      "body_end": 5655,
      "source_links": [
        "https://fa.wikipedia.org/wiki/%D8%A7%DB%8C%D8%B1%D8%A7%D9%86%D8%B1%D9%88%D8%AF",
        "https://www.asriran.com/fa/news/973250/%D9%85%D8%A7%D8%AC%D8%B1%D8%A7%DB%8C-%D8%A7%D8%AA%D8%B5%D8%A7%D9%84-%D8%AE%D8%B2%D8%B1-%D8%A8%D9%87-%D8%AE%D9%84%DB%8C%D8%AC-%D9%81%D8%A7%D8%B1%D8%B3-%D8%A8%D9%87-%DA%A9%D8%AC%D8%A7-%D8%B1%D8%B3%DB%8C%D8%AF"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00018",
      "text": "With subsidence increasing up to 20 cm in many areas, we are now witnessing visible effects on buildings. Tehran’s forbidden plains are host to over 100,000 wells that continue to extract groundwater, deepening the crisis. As the situation worsens, affluent groups are retreating to the cooler, water-rich northern suburbs. Meanwhile, environmental devastation accelerates under the pressure of unchecked housing development and profiteering.",
      "page": null,
      "paragraph": 18,
      "body_start": 5657,
      "body_end": 6099,
      "source_links": [
        "https://avalkhune.com/articles/migration-north-challenges-advantages-disadvantages-you-need-know",
        "https://snn.ir/fa/news/1087887/%D9%87%D9%85%D9%87-%D8%AF%D8%B4%D8%AA%E2%80%8C%D9%87%D8%A7%DB%8C-%D8%A7%D8%B3%D8%AA%D8%A7%D9%86-%D8%AA%D9%87%D8%B1%D8%A7%D9%86-%D9%85%D9%85%D9%86%D9%88%D8%B9%D9%87-%D8%A7%D8%B9%D9%84%D8%A7%D9%85-%D8%B4%D8%AF%D9%87%E2%80%8C%D8%A7%D9%86%D8%AF-%D9%85%D8%B3%D8%AF%D9%88%D8%AF%DB%8C%D8%AA-%D8%A8%DB%8C%D8%B4-%D8%A7%D8%B2-%D9%87%D8%B2%D8%A7%D8%B1-%D8%AD%D9%84%D9%82%D9%87-%DA%86%D8%A7%D9%87-%D8%BA%DB%8C%D8%B1%D9%85%D8%AC%D8%A7%D8%B2",
        "https://www.asriran.com/fa/news/805233/%D9%81%D8%B1%D9%88%D9%86%D8%B4%D8%B3%D8%AA-%D8%AF%D8%B4%D8%AA%E2%80%8C%D9%87%D8%A7%DB%8C-%D8%AA%D9%87%D8%B1%D8%A7%D9%86-%D8%A8%D8%B1%D8%AF%D8%A7%D8%B4%D8%AA%E2%80%8C-%D8%BA%DB%8C%D8%B1%D9%85%D8%AC%D8%A7%D8%B2-%D8%A2%D8%A8-%D8%B1%D8%A7-%D9%85%D8%AA%D9%88%D9%82%D9%81-%DA%A9%D9%86%DB%8C%D8%AF",
        "https://www.yjc.ir/fa/news/8902332/%D8%AA%D9%87%D8%B1%D8%A7%D9%86-%D8%B3%D8%A7%D9%84%D8%A7%D9%86%D9%87-%DB%B2%DB%B0-%D8%B3%D8%A7%D9%86%D8%AA%DB%8C-%D9%85%D8%AA%D8%B1-%D9%81%D8%B1%D9%88%D9%86%D8%B4%D8%B3%D8%AA-%D8%AF%D8%A7%D8%B1%D8%AF"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-840166-b00019",
      "text": "Migration to Tehran continues, and with the concentration of military, industrial, and governmental facilities, the city’s water “trunk” grows more unsustainable. At this point, there may be no choice but to revive proposals—dating back to the monarchy—for relocating the capital.",
      "page": null,
      "paragraph": 19,
      "body_start": 6101,
      "body_end": 6381,
      "source_links": [
        "https://www.sharghdaily.com/%D8%A8%D8%AE%D8%B4-%D8%AC%D8%A7%D9%85%D8%B9%D9%87-220/1018074-%D9%85%D9%87%D8%A7%D8%AC%D8%B1%D8%AA-%D8%AA%D9%87%D8%B1%D8%A7%D9%86-%D9%82%D8%B1%D8%A8%D8%A7%D9%86%DB%8C-%D8%AA%D9%85%D8%B1%DA%A9%D8%B2-%D9%82%D8%AF%D8%B1%D8%AA-%D8%AB%D8%B1%D9%88%D8%AA"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    }
  ],
