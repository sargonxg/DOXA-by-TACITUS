  "policy_sha256": "84f656b16099dcb248866f714453e5bd3e275bdb5d4929c4fad838ee8b29ed2c",
  "blocks": [
    {
      "id": "gv-707184-b00001",
      "text": "After closing temporarily because of the ongoing COVID-19 pandemic, one of Japan's most beloved tourist attractions is offering short virtual tours on YouTube.",
      "page": null,
      "paragraph": 1,
      "body_start": 0,
      "body_end": 159,
      "source_links": [
        "http://www.ghibli-museum.jp/en/notice/",
        "https://www.youtube.com/watch?v=FNEVhGy9HzM&feature=emb_title"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-707184-b00002",
      "text": "The Ghibli Museum is located in Mitaka, a leafy suburb about twenty minutes west of central Tokyo by train, and is devoted to recreating not only the animated worlds of Studio Ghibli, but also the artistic process of the studio itself.",
      "page": null,
      "paragraph": 2,
      "body_start": 161,
      "body_end": 396,
      "source_links": [
        "http://www.ghibli-museum.jp/en/",
        "http://www.ghibli.jp/"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-707184-b00003",
      "text": "Studio Ghibli's films, which include “My Neighbor Totoro” and “Spirited Away” by Hayao Miyazaki are popular with audiences all over the world. Each year the museum attracts thousands of visitors, and admission is limited. Only a certain number of visitors can enter the museum each day, and tickets typically must be reserved months in advance.",
      "page": null,
      "paragraph": 3,
      "body_start": 398,
      "body_end": 742,
      "source_links": [
        "https://www.travelandleisure.com/culture-design/studio-ghibli-japan-museum-virtual-video-tour",
        "https://www.youtube.com/watch?v=92a7Hj0ijLs",
        "https://www3.nhk.or.jp/nhkworld/en/ondemand/program/video/10yearshayaomiyazaki/?type=tvEpisode&",
        "https://youtu.be/qCgon52mp2M"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-707184-b00004",
      "text": "The museum has been closed since February 25. After sharing free-to-use backgrounds for web meetings to help people who must now work from home, Ghibli Studios have launched short video tours of the Ghibli Museum.",
      "page": null,
      "paragraph": 4,
      "body_start": 744,
      "body_end": 957,
      "source_links": [
        "http://www.ghibli-museum.jp/en/notice/",
        "http://www.ghibli.jp/info/013251/"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-707184-b00005",
      "text": "The five video tours begin with the museum exterior, before continuing on to various rooms and exhibits.",
      "page": null,
      "paragraph": 5,
      "body_start": 959,
      "body_end": 1063,
      "source_links": [
        "https://www.youtube.com/channel/UCd1b2TUlpmDLU7YpPu889Lg/videos",
        "https://youtu.be/C4f3DAQU6ok"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-707184-b00006",
      "text": "The room “Where a Film is Born” showcases “inspiration for what will go on to the blank piece of paper on the desk to become the origin of an actual film.”",
      "page": null,
      "paragraph": 6,
      "body_start": 1065,
      "body_end": 1220,
      "source_links": [],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-707184-b00007",
      "text": "All five videos can be viewed on Studio Ghibli's official YouTube channel.",
      "page": null,
      "paragraph": 7,
      "body_start": 1222,
      "body_end": 1296,
      "source_links": [
        "https://www.youtube.com/watch?v=FNEVhGy9HzM&feature=emb_title"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-707184-b00008",
      "text": "YouTuber CocoTak has posted a slightly longer tour of the Ghibli Museum, including the journey from Mitaka Station:",
      "page": null,
      "paragraph": 8,
      "body_start": 1298,
      "body_end": 1413,
      "source_links": [],
      "source_kind": "p",
      "source_is_quotation": false
    }
  ],
