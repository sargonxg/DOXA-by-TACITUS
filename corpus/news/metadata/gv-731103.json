  "blocks": [
    {
      "id": "gv-731103-b00001",
      "text": "Argentina's historic legalization of abortion in December 2020 triggered a wave of debates on reproductive rights across Latin America. Will Argentina's “green tide” spread throughout the region, bringing legal and attitudinal changes regarding abortion?",
      "page": null,
      "paragraph": 1,
      "body_start": 0,
      "body_end": 254,
      "source_links": [
        "https://globalvoices.org/2020/12/31/argentina-closes-2020-with-historic-senate-vote-legalizing-abortion/"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-731103-b00002",
      "text": "This lively Spanish-language discussion on these issues, moderated by Global Voices’ Latin America editor Melissa Vida, was live-streamed on March 9 and featured:",
      "page": null,
      "paragraph": 2,
      "body_start": 256,
      "body_end": 418,
      "source_links": [
        "https://globalvoices.org/author/melissa-vida/"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-731103-b00003",
      "text": "Anette Eklund, translator and content creator, journalist, professor, activist and advocate for linguistic democracy and human rights; also a Global Voices contributor.",
      "page": null,
      "paragraph": 3,
      "body_start": 420,
      "body_end": 588,
      "source_links": [
        "https://es.globalvoices.org/author/anette-eklund/"
      ],
      "source_kind": "li",
      "source_is_quotation": false
    },
    {
      "id": "gv-731103-b00004",
      "text": "Vienna Herrera, multimedia reporter with the Honduras news outlet Contracorriente, focused on issues of gender, sexual and reproductive rights, extractivism, environment and power structures; also a member of the team of the project “Land of Resistants,” a finalist for the Premio Gabo 2020.",
      "page": null,
      "paragraph": 4,
      "body_start": 590,
      "body_end": 881,
      "source_links": [],
      "source_kind": "li",
      "source_is_quotation": false
    },
    {
      "id": "gv-731103-b00005",
      "text": "Gabriela Mesones Rojo, Venezuelan journalist specializing in gender and human rights, editorial coordinator of Caracas Chronicles and Cinco8; also a contributor and researcher on Global Voices’ Civic Media Observatory.",
      "page": null,
      "paragraph": 5,
      "body_start": 883,
      "body_end": 1101,
      "source_links": [
        "https://es.globalvoices.org/author/gabriela-mesones/",
        "https://globalvoices.org/special/observatory/"
      ],
      "source_kind": "li",
      "source_is_quotation": false
    },
    {
      "id": "gv-731103-b00006",
      "text": "Giselle Carino, Argentine political scientist and activist, CEO of IPPFRHO (International Planned Parenthood Federation, Western Hemisphere Region), a growing feminist and progressive ecosystem of 26 local partner organizations, mostly from the South. Giselle's mission is to be a change agent and high-impact leader driving change toward gender equality throughout the global South.",
      "page": null,
      "paragraph": 6,
      "body_start": 1103,
      "body_end": 1486,
      "source_links": [],
      "source_kind": "li",
      "source_is_quotation": false
    }
  ],
