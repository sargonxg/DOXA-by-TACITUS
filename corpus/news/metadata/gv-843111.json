  "policy_sha256": "84f656b16099dcb248866f714453e5bd3e275bdb5d4929c4fad838ee8b29ed2c",
  "blocks": [
    {
      "id": "gv-843111-b00001",
      "text": "Palestine concerns you! It matters to everyone who is dedicated to human rights, committed to supporting stateless people, and invested in multilateralism. To understand how each of us can stand in meaningful solidarity with the Palestinian people and contribute towards stronger, more effective action in response to the genocide in Gaza, we must start by listening to Palestine. Join us for a Global Voices Insights in Arabic and English for a conversation about what statelessness and belonging, solidarity and resistance, mean in the Palestinian experience.",
      "page": null,
      "paragraph": 1,
      "body_start": 0,
      "body_end": 561,
      "source_links": [
        "https://globalvoices.org/special/gv-insights/"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-843111-b00002",
      "text": "Join us on Zoom on Wednesday, September 10, 2025, at 1:00 pm BST/ 2:00 pm CET / 3:00 pm Palestine / 8:00 am EST for this discussion featuring:",
      "page": null,
      "paragraph": 2,
      "body_start": 563,
      "body_end": 705,
      "source_links": [
        "https://us02web.zoom.us/webinar/register/WN_R_B_aADaTbyxYpnjjRBWdw"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-843111-b00003",
      "text": "Palestinian activist Lubnah Shomali has a bachelor's degree in molecular biology and a Master of Business Administration from the University of Michigan. She has been working with BADIL since 2012 and is responsible for donor relations, fund development, and legal and international advocacy.",
      "page": null,
      "paragraph": 3,
      "body_start": 707,
      "body_end": 999,
      "source_links": [
        "https://badil.org/"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-843111-b00004",
      "text": "Salah Hammouri is a French–Palestinian lawyer, human rights defender, former political prisoner who spent ten years in Israeli prisons and was forcibly deported to France in 2022.",
      "page": null,
      "paragraph": 4,
      "body_start": 1001,
      "body_end": 1180,
      "source_links": [],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-843111-b00005",
      "text": "Information about our third speaker is withheld for security reasons.",
      "page": null,
      "paragraph": 5,
      "body_start": 1182,
      "body_end": 1251,
      "source_links": [],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-843111-b00006",
      "text": "The session will be moderated by Areej al-Khalifa, an interdisciplinary scholar, researcher, and advocate whose work bridges academia, community organizing, and international advocacy. She is a member of the Interim Core Group of the Global Movement Against Statelessness delivering mentorship and strategic advice.",
      "page": null,
      "paragraph": 6,
      "body_start": 1253,
      "body_end": 1568,
      "source_links": [],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-843111-b00007",
      "text": "REGISTER HERE.",
      "page": null,
      "paragraph": 7,
      "body_start": 1570,
      "body_end": 1584,
      "source_links": [
        "https://us02web.zoom.us/webinar/register/WN_R_B_aADaTbyxYpnjjRBWdw?mc_cid=6f5a46559e&mc_eid=4c62fe99bb#/"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-843111-b00008",
      "text": "We look forward to having you join us on Wednesday, September 10, 2025, at 1:00 pm BST/ 2:00 pm CET / 3:00 pm Palestine / 8:00 am EST (click here to convert to your local time zone).",
      "page": null,
      "paragraph": 8,
      "body_start": 1586,
      "body_end": 1768,
      "source_links": [
        "https://www.timeanddate.com/worldclock/fixedtime.html?msg=GV+Insights%3A+The+shape+of+solidarity+%E2%80%94+Listening+to+Palestine&iso=20250910T13&p1=136&ah=1",
        "https://www.youtube.com/watch?v=Ez6EgNjY3Gg&ab_channel=GlobalVoices"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-843111-b00009",
      "text": "This 1-hour online event is being organised with the Institute on Statelessness and Inclusion, as part of the Standing with Palestine initiative.",
      "page": null,
      "paragraph": 9,
      "body_start": 1770,
      "body_end": 1915,
      "source_links": [
        "https://institutesi.us10.list-manage.com/track/click?u=e5784428f36e3696ddd26f1dd&id=6efe04fb97&e=4c62fe99bb",
        "https://www.institutesi.org/about-us"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    }
