  "tag_ids": [],
  "policy_sha256": "84f656b16099dcb248866f714453e5bd3e275bdb5d4929c4fad838ee8b29ed2c",
  "blocks": [
    {
      "id": "gv-786343-b00001",
      "text": "Global Voices’ reporting on authoritarianism and tech focuses on the harassment of women journalists around the world.",
      "page": null,
      "paragraph": 1,
      "body_start": 0,
      "body_end": 118,
      "source_links": [],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-786343-b00002",
      "text": "Join us on YouTube Live on May 2, 2023, at 12pm GMT for a discussion of how these dynamics play out online and of strategies that can make the internet a safer place for women journalists.",
      "page": null,
      "paragraph": 2,
      "body_start": 120,
      "body_end": 308,
      "source_links": [
        "https://www.youtube.com/watch?v=7Jg97-AJNRI"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-786343-b00003",
      "text": "The conversation will draw on research conducted by Global Voices Advox’s Unfreedom Monitor, a research project tracking instances of digital authoritarianism around the world and the media discourse surrounding them.",
      "page": null,
      "paragraph": 3,
      "body_start": 310,
      "body_end": 527,
      "source_links": [
        "https://advox.globalvoices.org/wp-content/uploads/2022/04/GV_Unfreedom_Monitor_Briefing_Note_Apr2022.pdf"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-786343-b00004",
      "text": "The session is free and open to the public. Register below to receive a reminder about the event:",
      "page": null,
      "paragraph": 4,
      "body_start": 529,
      "body_end": 626,
      "source_links": [],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-786343-b00005",
      "text": "Register for free on Eventbrite",
      "page": null,
      "paragraph": 5,
      "body_start": 628,
      "body_end": 659,
      "source_links": [
        "https://www.eventbrite.com/e/live-on-may-2-how-authoritarians-target-women-online-tickets-588331765147"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-786343-b00006",
      "text": "The event will be moderated by Global Voices’ associate editor and Advox editor, Ameya Nagarajan, and will feature the following panelists:",
      "page": null,
      "paragraph": 6,
      "body_start": 661,
      "body_end": 800,
      "source_links": [
        "https://globalvoices.org/author/ameya-nagarajan/"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-786343-b00007",
      "text": "Arzu Geybullayeva, Global Voices’ regional editor for the South Caucasus and Turkey",
      "page": null,
      "paragraph": 7,
      "body_start": 802,
      "body_end": 885,
      "source_links": [
        "https://globalvoices.org/author/arzu-geybullayeva/"
      ],
      "source_kind": "li",
      "source_is_quotation": false
    },
    {
      "id": "gv-786343-b00008",
      "text": "Laís Martins, a researcher and legal analyst with a background in environmental and digital rights",
      "page": null,
      "paragraph": 8,
      "body_start": 887,
      "body_end": 985,
      "source_links": [
        "https://globalvoices.org/author/laismartins/"
      ],
      "source_kind": "li",
      "source_is_quotation": false
    },
    {
      "id": "gv-786343-b00009",
      "text": "Melissa Vida, Global Voices’ Latin America editor and editor of the Undertones newsletter",
      "page": null,
      "paragraph": 9,
      "body_start": 987,
      "body_end": 1076,
      "source_links": [
        "https://globalvoices.org/author/melissa-vida/"
      ],
      "source_kind": "li",
      "source_is_quotation": false
    },
    {
      "id": "gv-786343-b00010",
      "text": "We look forward to having you join us on Tuesday, May 2, at 12pm GMT (click here to convert to your local time zone).",
      "page": null,
      "paragraph": 10,
      "body_start": 1078,
      "body_end": 1195,
      "source_links": [
        "https://www.timeanddate.com/worldclock/fixedtime.html?msg=LIVE+on+May+2%3A+How+authoritarians+target+women+online&iso=20230502T12&p1=1440&ah=1",
        "https://www.youtube.com/watch?v=jFes4fVDyfg"
      ],
      "source_kind": "p",
      "source_is_quotation": false
    },
    {
      "id": "gv-786343-b00011",
      "text": "The Unfreedom Monitor",
      "page": null,
      "paragraph": 11,
      "body_start": 1197,
      "body_end": 1218,
      "source_links": [],
      "source_kind": "h3",
      "source_is_quotation": false
    },
    {
      "id": "gv-786343-b00012",
      "text": "Authoritarian regimes have long had a complicated relationship with media and communications technologies. The Unfreedom Monitor is a Global Voices Advox research initiative examining the growing phenomenon of networked or digital authoritarianism.",
      "page": null,
      "paragraph": 12,
      "body_start": 1220,
      "body_end": 1468,
      "source_links": [
        "https://advox.globalvoices.org/",
        "https://advox.globalvoices.org/special/unfreedom-monitor/"
      ],
      "source_kind": "h4",
      "source_is_quotation": false
    },
    {
      "id": "gv-786343-b00013",
      "text": "Download a PDF of the briefing document.",
      "page": null,
      "paragraph": 13,
      "body_start": 1470,
      "body_end": 1510,
      "source_links": [
        "https://advox.globalvoices.org/wp-content/uploads/2022/04/GV_Unfreedom_Monitor_Briefing_Note_Apr2022.pdf"
      ],
      "source_kind": "h4",
      "source_is_quotation": false
    },
    {
      "id": "gv-786343-b00014",
      "text": "Access the public database.",
      "page": null,
      "paragraph": 14,
      "body_start": 1512,
      "body_end": 1539,
      "source_links": [
        "https://airtable.com/shrOdQb22l6gKghDn"
      ],
      "source_kind": "h4",
      "source_is_quotation": false
    }
  ],
