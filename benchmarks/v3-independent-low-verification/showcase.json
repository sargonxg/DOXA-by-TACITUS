            },
            {
              "id": "political_expression_boundary",
              "label": "Political-expression boundary",
              "description": "Differentiate anti-Jewish expression from political criticism. BDS, anti-Zionism, constitutional alternatives securing equality, and disproportionate criticism are not inherently antisemitic under this framework.",
              "kind": "boundary"
            }
          ],
          "context_rules": "Read all relevant contextual guidelines. Political position by itself does not establish anti-Jewish prejudice. Preserve genuine ambiguity and distinguish a speaker's statements from text quoting or opposing them.",
