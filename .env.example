# Copy to .env for Docker Compose. Never commit credentials or real document data.
DOXA_OCR=false
DOXA_ENABLE_OCR=0
# Docker OCR artifacts should be prefetched and mounted at /models/docling.
DOXA_DOCLING_ARTIFACTS=/models/docling
DOXA_PARSER_MEMORY_MB=4096
# Local native launcher also accepts DOXA_DATA_DIR; Compose persists /data in a named volume.
DOXA_DATA_DIR=data
# CPU Ollama scheduling; source prompts and model weights remain unchanged.
DOXA_OLLAMA_NUM_THREADS=4
DOXA_LOCAL_TASK_TIMEOUT_SECONDS=1800
# Installed wheel: optional clone root containing corpus/ and benchmarks/.
# DOXA_ASSET_ROOT=/path/to/DOXA-by-TACITUS
# Local-only visible request capture additionally requires explicit opt-in on each new run.
DOXA_ENABLE_PRIVATE_JOURNAL=false
DOXA_PRIVATE_JOURNAL_MAX_BYTES=67108864
# Optional dedicated native pilot installation. Use scripts/configure_pilot.py;
# keep its generated files outside the repository. Local mode needs no credential.
# DOXA_ACCESS_MODE=managed
# DOXA_ACCESS_CONFIG_FILE=/private/operator/doxa/access.json
# DOXA_PILOT_WORKSPACE_KIND=organization
# DOXA_PRIVACY_VAULT_KEY=base64-encoded-32-byte-key-generated-by-the-helper
# Optional remote inference credentials. Selecting a provider in the UI controls whether data is sent.
DOXA_OPENAI_API_KEY=
DOXA_OPENAI_BASE_URL=https://api.openai.com/v1
DOXA_OPENAI_MODE=remote
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
RUNPOD_API_KEY=
DOXA_RUNPOD_ENDPOINT_ID=
DOXA_RUNPOD_BASE_URL=
# Cloud container only; use Wrangler secrets, never a public frontend environment variable.
# DOXA_CLOUD_STATE_URL=https://your-worker.workers.dev
# DOXA_SERVICE_TOKEN=generate-a-random-secret-of-at-least-32-characters
# DOXA_INTERNAL_TOKEN=same-secret-as-DOXA_SERVICE_TOKEN
