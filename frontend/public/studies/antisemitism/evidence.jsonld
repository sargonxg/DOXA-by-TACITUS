178fbdf3bd88293f1fa22ab60009e913a82da6","urn:doxa:passage:dc62e10a9b4a9d92d49696a61621f165d589c821c2320e0fe7629184888f81e7","urn:doxa:passage:c5ce2bbb1e58781084a76c677a65704cda029cd45475894ee847ae40134482b1","urn:doxa:passage:e5312d6e8ff8076f47b8dea4bbb0ba3a6235becfe30c289abd5295c29b84d517","urn:doxa:passage:42389e0e80c55aa24b5811cd6785e41f06b72f03949d135f5bba2e4a9f1ab752","urn:doxa:passage:73172c0227e7497975f22fb0c9811f6725c6498d357ee87ba2d8d92f8a54373a","urn:doxa:passage:1e3964d7f51c38632e9cafec3595cfa7c423edab567f74f2566de4eef3e743a8","urn:doxa:passage:fb8f1de59b893d79e623516cb43dbbf93459c4777357080b2c15436436d51e15","urn:doxa:passage:5d4742383dcd70fa24333b732e11eab792267ac595012b21e457e1a448ce63e5","urn:doxa:passage:c290f21a48c2768ad2e2dd946c82284f34fb6beb4bac32b368f66d6910b84e9f","urn:doxa:passage:972000d40b821b1bf6d6517717f9fe00d7ca5e33f3a2c4582dca3b63e21de2ab","urn:doxa:passage:00294ed196f96fc5e37ac7bc75eb6a0445031b5c85fb27bb902926b257d2ce20","urn:doxa:passage:53ebb09e7e9b4a0e2cad849915427b535096849ecf6190f57284b3e24f9824a4"]},{"@id":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-801447","title":"Is selective coverage of Israel’s war on Gaza in the Czech Republic following or creating anti-Semitism?","author":"Elmira Lyapina","translator":[],"publishedOn":"2023-12-05","sourceUrl":"https://globalvoices.org/2023/12/05/is-selective-coverage-of-israels-war-on-gaza-in-the-czech-republic-following-or-creating-anti-semitism/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"c3541b7df8fe254883102bcce5afe0afba618f2df9b552ea85b4728b73857e31","textSha256":"112835a763d4aede56fc6dc3a55c609600b766f2a342a7627599cfa67dfe3105","archivedRecordSha256":"2278f79417c5b1d5e7e66b102dda12631358269ee7a994ea4a6238b88d1df3b8","inStudy":"urn:doxa:study:antisemitism-case-1"},{"@id":"urn:doxa:unit:5086d88fbf68c0413d14241baeb3f1fa:u_4473e2fa6ec064ee138edfd9","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_4473e2fa6ec064ee138edfd9","status":"accepted","fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa"},{"@id":"urn:doxa:unit:5086d88fbf68c0413d14241baeb3f1fa:u_90e15805e44e7757870e5b4e","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_90e15805e44e7757870e5b4e","status":"accepted","fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa"},{"@id":"urn:doxa:unit:5086d88fbf68c0413d14241baeb3f1fa:u_bd62777ea21a6bc3a04e7732","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_bd62777ea21a6bc3a04e7732","status":"accepted","fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa"},{"@id":"urn:doxa:passage:c97d258dc73d6995c0f420f870945a92865beeafc1da22e43f78567114e610fc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00018","start":0,"end":197,"exact":"In a case in Plzeň involving a kebab shop, the Turkish owner displayed verses from the Quran out of context on wall posters, stating, “These Jews are the people who killed the prophets like sheep. "},{"@id":"urn:doxa:passage:1aa29593a5c52adeeda6512e4127179ee39db3b068112eac70daa9ca8d31cd21","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00018","start":197,"end":388,"exact":"For this reason, God cursed them.” Despite investigating the case for defamation based on nationality, race, or ethnicity, the prosecutor canceled the prosecution, citing a lack of substance."},{"@id":"urn:doxa:decision:95f0ecd347b4a8348d80017aa7a32a29","@type":["doxa:Decision","prov:Entity"],"recordId":"95f0ecd347b4a8348d80017aa7a32a29","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:ihra:anti_jewish_generalization:2026-11-operational-1:07872328c821afca407bc3f824933eae27582cd486ab34cf52466ad43ab7b92a","scoredUnit":"urn:doxa:unit:5086d88fbf68c0413d14241baeb3f1fa:u_4473e2fa6ec064ee138edfd9","attribution":"reported_speaker","speaker":"Turkish owner of a kebab shop","speakerStance":"unclear","documentStance":"neutral","proposition":"Jews are people who killed prophets like sheep and are cursed by God","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports a specific instance where a shop owner used religious justifications to claim Jews killed prophets like sheep and were cursed by God.","modelPassage":["urn:doxa:passage:c97d258dc73d6995c0f420f870945a92865beeafc1da22e43f78567114e610fc","urn:doxa:passage:1aa29593a5c52adeeda6512e4127179ee39db3b068112eac70daa9ca8d31cd21"]},{"@id":"urn:doxa:passage:52554c756a25f60ff994a80465ea56e1f114e6bf5490bce04882bc2b077ef1f3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00015","start":0,"end":110,"exact":"> The language games have entered an Orwellian phase, where everything can be manipulated for someone’s gain. "},{"@id":"urn:doxa:passage:ce41cabb70b3617027dd3d1dd76d236eb72b832f47ee895e36235dc7c5caee4f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00015","start":110,"end":171,"exact":"One day, even “Free Palestine” will be considered an insult. "},{"@id":"urn:doxa:passage:b3190d7f18376085ce24ea5b6dd3eac74bbcb5a522a7fafbbb9c799b4b1054c4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00015","start":171,"end":377,"exact":"The exaggerated focus on the detail, […] its potential criminal connotations — is successfully hiding the factual, concrete, ongoing genocidal atrocities committed by the Israeli army in these very moments."},{"@id":"urn:doxa:passage:f5935fa1724c36624ba165592faf3609bfd6522318ca52f0a290e1274ceb9f63","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00016","start":0,"end":41,"exact":"Navigating anti-Semitism and Islamophobia"},{"@id":"urn:doxa:passage:a79e1ee88552a6b96e6093027a36cda471ea176d62c254055d455a5ae348bab0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00017","start":0,"end":222,"exact":"Some of those who support the Palestinian people and those who participate in pro-Palestinian demonstrations find that their calls for a ceasefire are often misinterpreted as anti-Semitism by both officials and the media. "},{"@id":"urn:doxa:passage:aeb4378c474cc8d3fdf1d20f7d34348a994965fa65e0c42a86b9adc394d443f7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00017","start":222,"end":308,"exact":"Fortunately, the actual reports of anti-Semitism have not been as numerous as assumed."},{"@id":"urn:doxa:passage:2f887186e7208439918b80fdc8951c33020a2f2b80b22d6c225ad8a2bf87d557","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00019","start":0,"end":119,"exact":"Adam Šlerka asserts: “‘Anti-Semitism’ has become an empty slogan, detracting from addressing the actual anti-Semitism. "},{"@id":"urn:doxa:passage:afaa23036cb386cac870f3caae52cae29871b9bc78a8aca6cc4a466f07d3a714","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00019","start":119,"end":164,"exact":"It now serves to defend Israel and the West.”"},{"@id":"urn:doxa:passage:2341a4c7af8430d52668061f28e3556434d42cb20ba9f7caddbf246df51bc819","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00020","start":0,"end":180,"exact":"According to the 2022 Reuters Institute of Journalism Digital News Report, the younger generation in the Czech Republic relies on social media and online media platforms for news. "},{"@id":"urn:doxa:passage:9ec9ae77f666f668e3a438a56e4a2373c99a1a9547c55c3a9bc042a25db228d4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00020","start":180,"end":358,"exact":"However, this trend also amplifies societal polarization, notably in the rise of Islamophobic views, where commenters often express unchecked aggression towards Muslims or Arabs."},{"@id":"urn:doxa:passage:16d9545d51dc9a5bd490b40b9aec5ea8af3dd631aafbff6faba06fb4c1690470","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00021","start":0,"end":154,"exact":"In an email to Global Voices, a 22-year-old master's student in organic chemistry, choosing to remain anonymous, described herself as a digital activist. "},{"@id":"urn:doxa:passage:1d72ef5fbbd208f53ea600d1ff69dc05073574a1068605ffa95692d695c98f51","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00021","start":154,"end":323,"exact":"Frustrated by the limited coverage of the pro-Palestinian stance, she started operating an Instagram account where she translated news from English and Arabic to Czech. "},{"@id":"urn:doxa:passage:db6af61278f55ecee673eaa383924f512a7218bb4dd91a28a386366d8d16df9c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00021","start":323,"end":334,"exact":"She shared:"},{"@id":"urn:doxa:passage:db722c8018cad41ae8ea66cbb766fc6fa94f053465e299affed05bd5ef883369","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00022","start":0,"end":159,"exact":"> They keep talking about anti-Semitism in the Czech Republic, but I would say that Islamophobia is much more rampant in the Czech society, especially online. "},{"@id":"urn:doxa:passage:48973f1726d13ee1d73c1970ce13bbf3ea8ebc0d9c62a543415622139edd3def","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00022","start":159,"end":182,"exact":"It is absolutely wild. "},{"@id":"urn:doxa:passage:6d405cac6f9df8e515075678cb2aaaaf743f43f130155240612037012c85319e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00022","start":182,"end":339,"exact":"When I read such comments, I have no doubt that if these people met me in real life and had the opportunity, they would gas me or murder me in any other way."},{"@id":"urn:doxa:passage:9842c30270b495b70816f5ca1feb6f8f7327ffb8d51da0f6f857e5e73055d453","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00023","start":0,"end":110,"exact":"> The account is private because society here is very pro-Israeli, anti-Palestinian, Islamophobic and racist. "},{"@id":"urn:doxa:passage:df6b06b5b32b620d67c020202a53dd34169652f515f8c00b5517859301f3f99c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00023","start":110,"end":156,"exact":"I am afraid of receiving disgusting comments. "},{"@id":"urn:doxa:passage:240e98d1e6e25dd0e258a6ac4e79ab1170a0c43978e7894498b4113183ee67c5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00023","start":156,"end":400,"exact":"I have already read several comments online coming from people of all age groups saying stuff like “a dead Muslim is a good Muslim” or “a dead Arab is a good Arab,” “kill them all,” “destroy their ID’s and expel them,” “deport all Muslims” etc."},{"@id":"urn:doxa:passage:f50ce1df94af2dc3e944c0a183897101b6fec841f1476352a91886caa7f61339","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00024","start":0,"end":50,"exact":"Examining selective coverage in the Czech Republic"},{"@id":"urn:doxa:passage:9facebe637c55eb26819e47f2dd29ce3ec8b786f1c9dd8d9589aed8d433f2027","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00025","start":0,"end":155,"exact":"The Czech media ethic codes stress the importance of creating an open space for public debate by sharing confronting information, opinions, and attitudes. "},{"@id":"urn:doxa:passage:8df6fb257f7ef761bab7cee33aab9c4bfd8f1cc5cff4b1cc5e09fce0f5697b1a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00025","start":155,"end":268,"exact":"However, the context of Israel's war on Gaza may differ: ČT24 seems to interchangeably use Israel and Jerusalem. "},{"@id":"urn:doxa:passage:45fadb81f23d0bbee5ff4ee5a5c8248eac10fe1c790586a3ce80b44884728f14","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00025","start":268,"end":331,"exact":"Additionally, the information presented is not always verified."},{"@id":"urn:doxa:passage:4098e8610c9163a0c1865b19c6f18b23d08d91d97e7d49c6714624b1bf567393","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00026","start":0,"end":120,"exact":"Details about tortured children or attacks from a hospital by Hamas were refuted by internationally recognized sources. "},{"@id":"urn:doxa:passage:6914a109fdfae3e549b4833b65460a082c0b3ea7be963fbe377d6876ff736928","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00026","start":120,"end":282,"exact":"On November 7, ČT24 published an interview with the Chief of the General Staff of the Czech Army, Karel Řehka, without a disclaimer on the aforementioned issues. "},{"@id":"urn:doxa:passage:b68d41d40d203914657d92afac593be10abb116d26ac522db26ce1ab07abd1f7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00026","start":282,"end":426,"exact":"This allowed him once again to share stories of beheaded children and newborns baked in the oven, calling the conflict a “fight with pure evil.”"},{"@id":"urn:doxa:passage:2e3dfcf417dbc8a015e47acadeef4049cb0362d023ec689f5e6fdd137774117f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00027","start":0,"end":155,"exact":"In another example, Yara Abu Aataya, a Czech designer with Palestinian roots, was invited for an interview on Czech Television — Česká televize 168 hodin. "},{"@id":"urn:doxa:passage:b8cadf058793a2430ff476d272a4fea563c99cab1efa140f983f0696b0445632","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00027","start":155,"end":373,"exact":"Despite the risks associated with the lack of electricity, internet, and other scarcities in Gaza, she was asked to connect by phone with her family in Gaza to evoke empathy and understanding from pro-Israeli viewers. "},{"@id":"urn:doxa:passage:377c045685ad0011335982ecf84b89fc8814f1c1ddbe8030875489557daf0b72","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00027","start":373,"end":472,"exact":"However, the interview was cut out from the program, and Czech Television never mentioned it again."},{"@id":"urn:doxa:decision:c2ebe40a294f57aa26678d8cfd24fa3e","@type":["doxa:Decision","prov:Entity"],"recordId":"c2ebe40a294f57aa26678d8cfd24fa3e","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:ihra:collective_responsibility:2026-11-operational-1:e16d6fd95efec64cdfce140ba7d4f040e9e19b26