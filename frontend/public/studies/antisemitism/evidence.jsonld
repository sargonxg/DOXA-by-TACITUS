a714","urn:doxa:passage:2341a4c7af8430d52668061f28e3556434d42cb20ba9f7caddbf246df51bc819","urn:doxa:passage:9ec9ae77f666f668e3a438a56e4a2373c99a1a9547c55c3a9bc042a25db228d4","urn:doxa:passage:16d9545d51dc9a5bd490b40b9aec5ea8af3dd631aafbff6faba06fb4c1690470","urn:doxa:passage:1d72ef5fbbd208f53ea600d1ff69dc05073574a1068605ffa95692d695c98f51","urn:doxa:passage:db6af61278f55ecee673eaa383924f512a7218bb4dd91a28a386366d8d16df9c","urn:doxa:passage:db722c8018cad41ae8ea66cbb766fc6fa94f053465e299affed05bd5ef883369","urn:doxa:passage:48973f1726d13ee1d73c1970ce13bbf3ea8ebc0d9c62a543415622139edd3def","urn:doxa:passage:6d405cac6f9df8e515075678cb2aaaaf743f43f130155240612037012c85319e","urn:doxa:passage:9842c30270b495b70816f5ca1feb6f8f7327ffb8d51da0f6f857e5e73055d453","urn:doxa:passage:df6b06b5b32b620d67c020202a53dd34169652f515f8c00b5517859301f3f99c","urn:doxa:passage:240e98d1e6e25dd0e258a6ac4e79ab1170a0c43978e7894498b4113183ee67c5","urn:doxa:passage:f50ce1df94af2dc3e944c0a183897101b6fec841f1476352a91886caa7f61339","urn:doxa:passage:9facebe637c55eb26819e47f2dd29ce3ec8b786f1c9dd8d9589aed8d433f2027","urn:doxa:passage:8df6fb257f7ef761bab7cee33aab9c4bfd8f1cc5cff4b1cc5e09fce0f5697b1a","urn:doxa:passage:45fadb81f23d0bbee5ff4ee5a5c8248eac10fe1c790586a3ce80b44884728f14","urn:doxa:passage:4098e8610c9163a0c1865b19c6f18b23d08d91d97e7d49c6714624b1bf567393","urn:doxa:passage:6914a109fdfae3e549b4833b65460a082c0b3ea7be963fbe377d6876ff736928","urn:doxa:passage:b68d41d40d203914657d92afac593be10abb116d26ac522db26ce1ab07abd1f7","urn:doxa:passage:2e3dfcf417dbc8a015e47acadeef4049cb0362d023ec689f5e6fdd137774117f","urn:doxa:passage:b8cadf058793a2430ff476d272a4fea563c99cab1efa140f983f0696b0445632","urn:doxa:passage:377c045685ad0011335982ecf84b89fc8814f1c1ddbe8030875489557daf0b72"]},{"@id":"urn:doxa:passage:5c6fcb77a325de0649a419e9cddfbcca85b1aabfb3d00228d8d846e769eb33aa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00001","start":0,"end":161,"exact":"Since the Hamas attack on October 7, 2023, the Czech government and mass media have consistently expressed unwavering support for Israel and the Israeli people. "},{"@id":"urn:doxa:passage:4cf3fe0306faf18de02af47b63a1eb2fc51cbf0709ffcb2c3262475d7c560720","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00001","start":161,"end":282,"exact":"This support persists even through the Israeli response to Gaza, which is effectively decimating the civilian population."},{"@id":"urn:doxa:passage:2f468873dfe5230b0314cd7e9dbe7d00d4ecbf5a0661eccb44733cccccfde128","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00002","start":0,"end":50,"exact":"Official Czech support is not merely declarative. "},{"@id":"urn:doxa:passage:9cf82bb8a7e6f4a51062a5dfeb988ff8814b7d53e0dd7fb7768c84f05570c00b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00002","start":50,"end":186,"exact":"Following Prime Minister Petr Fiala’s visit to Israel on October 25, the Czech Republic started supplying military equipment to Israel. "},{"@id":"urn:doxa:passage:768bd91e3477811365f805ed3fc6a77dea8eba78337a94917a0570032c5d139e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00002","start":186,"end":268,"exact":"Fiala even advocated for relocating the Czech embassy from Tel Aviv to Jerusalem. "},{"@id":"urn:doxa:passage:ee331f4fc144d1b29d07da3189b00bb5e8e0a6134c1eabfc4a076670b881f32d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00002","start":268,"end":401,"exact":"He actively advocates for Israel’s right to self-defense internationally, including within the EU, the European Council, and the UN. "},{"@id":"urn:doxa:passage:931ad921319d51a8bc14c05fb4ffce33a106b2777cf73715eb1abb8a3d5bdaad","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00002","start":401,"end":559,"exact":"Notably, the Czech Republic was one of 14 countries voting against the UN General Assembly resolution calling for a ceasefire in the Israeli war on Palestine."},{"@id":"urn:doxa:passage:0a2f331c3fff80b30f5fa058d092bb1f7c9032fbfc3204789064adc18dc07690","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00003","start":0,"end":198,"exact":"Fiala calls the country “the voice of Israel in Europe.” He has participated in pro-Israel demonstrations in Prague, condemning the October 7 attack as an assault on “humanity and our civilization.”"},{"@id":"urn:doxa:passage:cd782758bac4b892fc0240b331cb0b14a1d60e39f15c12cdb9d94335f4e50a63","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00004","start":0,"end":90,"exact":"Other officials, including Czech Defense Minister Jana Černochová, openly support Israel. "},{"@id":"urn:doxa:passage:b5bf8c21de818a100e08392241a2939616f5c5d8969ee2ede3874ed8255921de","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00004","start":90,"end":465,"exact":"She even called for the Czech Republic to withdraw from the UN in response to the ceasefire resolution. Černochová participated in Prague’s first pro-Palestinian demonstration organized by Not in Our Name! — Initiative for a Just Peace in the Middle East (Ne naším jménem! – Iniciativa za spravedlivý mír na Blízkém východě); however, her participation was to support Israel."},{"@id":"urn:doxa:passage:81265fc49dde971fa7c81b0d6dfec323b83f472e9e5cd01a5b9c014c2b2d5a82","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00005","start":0,"end":259,"exact":"The pro-Israeli official stance frequently emphasizes the mischaracterization of the right to self-defense as oppression, aligning with sentiments articulated in a letter shared with the government by leaders of Israeli universities and research institutions."},{"@id":"urn:doxa:passage:1d4a6507b2cbd93919cf0d32749882e8443c68c116d9727e209769ca79f0f168","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00006","start":0,"end":130,"exact":"President of the Czech Republic Petr Pavel also expressed his support for Israel during the national Czech holiday on October 28. "},{"@id":"urn:doxa:passage:b3ca4c8ee8878fade0442c952c0269b8a1079c3c7f6cc4380f515dfb03ff05ab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00006","start":130,"end":288,"exact":"In his address, he acknowledged the threats facing the country, including Russia’s war against Ukraine, and the need for Israel to respond to Islamist terror."},{"@id":"urn:doxa:passage:c97ad6a823e1a05a8762d3b16c1de72d268ef2c5d5720b3c1da93fe5a3ab3c1c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00007","start":0,"end":22,"exact":"Collusion of the media"},{"@id":"urn:doxa:passage:08e2414eaeaff9a56a05c2e22988a00d4058a102810f16853bd5761441025de4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00008","start":0,"end":168,"exact":"Ranked 14th out of 180 countries in Reporters Without Borders’ 2023 World Press Freedom Index, the Czech Republic faces growing political pressure on its public media. "},{"@id":"urn:doxa:passage:ddf30de2c658b64558eb6b74f8f0287e31ade3039ce3123fa1d8b1a2ca09487c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00008","start":168,"end":340,"exact":"The index highlights that the pro-Israel stance of Czech officials is echoed by public media such as ČT24 or iRozhlas, along with mainstream channels such as Seznam Zprávy."},{"@id":"urn:doxa:passage:d65cdcff813d2ab7ae04dc8aeace2359a1f1e2f896040dcb07c1bede5239d562","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00009","start":0,"end":141,"exact":"Seznam Zprávy and ČT24‘s official Instagram and Facebook pages lean pro-Israel, offering minimal coverage of pro-Palestinian demonstrations. "},{"@id":"urn:doxa:passage:608997276a8741d39f1ec0be0976c8b749167225a40288ffc0af0aaae9930956","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00009","start":141,"end":332,"exact":"Only one in 10 demonstrations organized by the Association of the Friends of Palestine receive attention from public media, leading activists to argue that mainstream media lacks objectivity."},{"@id":"urn:doxa:passage:e3eec5d9e6542be681b5e7bbce5152bf28de716a766e55ec38c57a9963f10314","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00010","start":0,"end":248,"exact":"In an email interview with Global Voices, Giuseppe Picheca, an Italian living in the Czech Republic with master's degrees in peace and conflict studies, and human rights and democracy, and a former academic tutor in political sciences, pointed out:"},{"@id":"urn:doxa:passage:4378cf7434a3ceffa5b0fcd7fd3f821e78ceb0aa52ad9dc4f48006971c284996","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00011","start":0,"end":111,"exact":"> The more the protests persist, the less media coverage they receive, and the more police presence increases. "},{"@id":"urn:doxa:passage:08c67a1e9f844995fea78aa58330e458a9696d7c5642aede0c752b70d76d0d5b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00011","start":111,"end":375,"exact":"During the last demonstration, we had a total of six police vans, including anti-riot equipment, closely following, […] filming and recording us, and some officials dressed in civilian clothes blending in with us and reporting afterward; they don’t try to hide it."},{"@id":"urn:doxa:passage:e77df57816dc4c8877436e5a608ad52ff59ffdd44e54f32a08633c274370a816","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00012","start":0,"end":346,"exact":"Media coverage of pro-Palestinian demonstrations often incorporates comments on anti-Semitism, portrays demonstrators in a light linked to anti-Semitism, mentions aggressive attitudes towards pro-Israel groups (although both sides deny it on social media), or diminishes the number of demonstrators with a brief description lacking wider context."},{"@id":"urn:doxa:passage:62defe88b42d400c9da7097b07489193068bc0f700317e7fe503ec4b4076c3c8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00013","start":0,"end":241,"exact":"In an email interview with Global Voices, Adam Šlerka, a Czech activist and participant in pro-Palestinian protests, emphasizes how “the media tends to label support for Palestine as an endorsement for Hamas and terrorism when it covers it.”"},{"@id":"urn:doxa:passage:a61c180f1dbd9bf8f5f1601f8c647e0902aab0d2043a133bb517f1ca8473b9ea","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:5086d88fbf68c0413d14241baeb3f1fa","blockId":"gv-801447-b00014","start":0,"end":17,"exact":"Picheca suggests:"},{"@id":"urn:doxa:decision:e837ba04eecc2af2a7a44a5e4872391b","@type":["doxa:Decision","prov:Entity"],"recordId":"e837ba04eecc2af2a7a44a5e4872391b","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:ihra:anti_jewish_generalization:2026-11-operational-1:07872328c821afca407bc3f824933eae27582cd486ab34cf52466ad43ab7b92a","scoredUnit":"urn:doxa:unit:5086d88fbf68c0413d14241baeb3f1fa:u_90e15805e44e7757870e5b4e","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:5c6fcb77a325de0649a419e9cddfbcca85b1aabfb3d00228d8d846e769eb33aa","urn:doxa:passage:4cf3fe0306faf18de02af47b63a1eb2fc51cbf0709ffcb2c3262475d7c560720","urn:doxa:passage:2f468873dfe5230b0314cd7e9dbe7d00d4ecbf5a0661eccb44733cccccfde128","urn:doxa:passage:9cf82bb8a7e6f4a51062a5dfeb988ff8814b7d53e0dd7fb7768c84f05570c00b","urn:doxa:passage:768bd91e3477811365f805ed3fc6a77dea8eba78337a94917a0570032c5d139e","urn:doxa:passage:ee331f4fc144d1b29d07da3189b00bb5e8e0a6134c1eabfc4a076670b881f32d","urn:doxa:passage:931ad921319d51a8bc14c05fb4ffce33a106b2777cf73715eb1abb8a3d5bdaad","urn:doxa:passage:0a2f331c3fff80b30f5fa058d092bb1f7c9032fbfc3204789064adc18dc07690","urn:doxa:passage:cd782758bac4b892fc0240b331cb0b14a1d60e39f15c12cdb9d94335f4e50a63","urn:doxa:passage:b5bf8c21de818a100e08392241a2939616f5c5d8969ee2ede3874ed8255921de","urn:doxa:passage:81265fc49dde971fa7c81b0d6dfec323b83f472e9e5cd01a5b9c014c2b2d5a82","urn:doxa:passage:1d4a6507b2cbd93919cf0d32749882e8443c68c116d9727e209769ca79f0f168","urn:doxa:passage:b3ca4c8ee8878fade0442c952c0269b8a1079c3c7f6cc4380f515dfb03ff05ab","urn:doxa:passage:c97ad6a823e1a05a8762d3b16c1de72d268ef2c5d5720b3c1da93fe5a3ab3c1c","urn:doxa:passage:08e2414eaeaff9a56a05c2e22988a00d4058a102810f16853bd5761441025de4","urn:doxa:passage:ddf30de2c658b64558eb6b74f8f0287e31ade3039ce3123fa1d8b1a2ca09487c","urn:doxa:passage:d65cdcff813d2ab7ae04dc8aeace2359a1f1e2f896040dcb07c1bede5239d562","urn:doxa:passage:608997276