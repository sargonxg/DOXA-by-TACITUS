c337ea34bb0374144769f2870aca0f46bb7d1fe1c457b7","urn:doxa:passage:1d49e1c61ff365b32b18f69abb71890e8d0857248b8099a02654c95718ebda1c","urn:doxa:passage:ff3dde413211efd5366fb7a8f378cf0bd5bcf0543555db6fc3c85e80118c0227"]},{"@id":"urn:doxa:decision:97bbbc6d82037ad5fbec2f5939b88bf9","@type":["doxa:Decision","prov:Entity"],"recordId":"97bbbc6d82037ad5fbec2f5939b88bf9","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:nexus:collective_guilt:2024-06-operational-1:212538155292d7b06703f99172c0f53ed71912c679ca433fdaa76527f6722fdf","scoredUnit":"urn:doxa:unit:1e799a3b99709d52255fdea3d9253a54:u_1ecbc14c1ac02ceb1981f8bb","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:1c1a55ab05f9df823e53fae1bc6243c70f594c865a309784c0d738f025efd85f","urn:doxa:passage:4dbeff439cb66a928c0bd35675f879a4f6acd08e9ddc7eeeb0a12b76d3d3a581","urn:doxa:passage:098ec9948761d5c6ff0bd0a56eb06145e05ddb3cf4f5d32b604ae8f7bc6493fc","urn:doxa:passage:76b2ac173cae1ba2f2773347d02b169d5740d7336fa8add7ed953ffa21deac08","urn:doxa:passage:a406778d6081d535d6321c75fc1fa0fb7974412598feacc450fac99e7dad3f0e","urn:doxa:passage:6de57ba8880783eb45883af8782fe46d1cb4bdac2717aed7f4f61c0cc2822165","urn:doxa:passage:bb32c4dcb8ec019062d00f9dfb05b241f62bd184dd88f4d8528b6047bab00454","urn:doxa:passage:cd9ddbfb8acbe39273f51a85ba5cd3adab92f9feccfacce4e5da61a93401035f","urn:doxa:passage:c5d24e6b1c01b4c3a444d4ad2b5e49045ccee79b7b1446c31ffd76f61772ae77","urn:doxa:passage:0d6a4ab07d96eebf6c0bae122de5ff5fc5769887cab536c593f673a31b6bcb69","urn:doxa:passage:80735c7d3e0db63b462e5ca418a6cb292ca4d51ad36acc1fd0f8dfe8db342529","urn:doxa:passage:dc8186a57a4e2c6581c337ea34bb0374144769f2870aca0f46bb7d1fe1c457b7","urn:doxa:passage:1d49e1c61ff365b32b18f69abb71890e8d0857248b8099a02654c95718ebda1c","urn:doxa:passage:ff3dde413211efd5366fb7a8f378cf0bd5bcf0543555db6fc3c85e80118c0227"]},{"@id":"urn:doxa:decision:0cd9382200fee88f556e33179397fdc9","@type":["doxa:Decision","prov:Entity"],"recordId":"0cd9382200fee88f556e33179397fdc9","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:nexus:opposition_boundary:2024-06-operational-1:8b20e096fd16200fd404e92c0882468e6052f2760fe7367ad537deae7244cf29","scoredUnit":"urn:doxa:unit:1e799a3b99709d52255fdea3d9253a54:u_1ecbc14c1ac02ceb1981f8bb","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:1c1a55ab05f9df823e53fae1bc6243c70f594c865a309784c0d738f025efd85f","urn:doxa:passage:4dbeff439cb66a928c0bd35675f879a4f6acd08e9ddc7eeeb0a12b76d3d3a581","urn:doxa:passage:098ec9948761d5c6ff0bd0a56eb06145e05ddb3cf4f5d32b604ae8f7bc6493fc","urn:doxa:passage:76b2ac173cae1ba2f2773347d02b169d5740d7336fa8add7ed953ffa21deac08","urn:doxa:passage:a406778d6081d535d6321c75fc1fa0fb7974412598feacc450fac99e7dad3f0e","urn:doxa:passage:6de57ba8880783eb45883af8782fe46d1cb4bdac2717aed7f4f61c0cc2822165","urn:doxa:passage:bb32c4dcb8ec019062d00f9dfb05b241f62bd184dd88f4d8528b6047bab00454","urn:doxa:passage:cd9ddbfb8acbe39273f51a85ba5cd3adab92f9feccfacce4e5da61a93401035f","urn:doxa:passage:c5d24e6b1c01b4c3a444d4ad2b5e49045ccee79b7b1446c31ffd76f61772ae77","urn:doxa:passage:0d6a4ab07d96eebf6c0bae122de5ff5fc5769887cab536c593f673a31b6bcb69","urn:doxa:passage:80735c7d3e0db63b462e5ca418a6cb292ca4d51ad36acc1fd0f8dfe8db342529","urn:doxa:passage:dc8186a57a4e2c6581c337ea34bb0374144769f2870aca0f46bb7d1fe1c457b7","urn:doxa:passage:1d49e1c61ff365b32b18f69abb71890e8d0857248b8099a02654c95718ebda1c","urn:doxa:passage:ff3dde413211efd5366fb7a8f378cf0bd5bcf0543555db6fc3c85e80118c0227"]},{"@id":"urn:doxa:passage:6f97157c38118233f49704a44dcbca650a8108efd5b6adb894118152f76ebd37","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00001","start":0,"end":291,"exact":"To mark International Holocaust Remembrance Day on January 27, the Ukrainian Armed Forces’ choir released a YouTube video showing Ukrainian servicemen performing a Hebrew song at the site of one of the biggest Holocaust massacres in Europe, which has since been turned into a memorial site. "},{"@id":"urn:doxa:passage:404330884ac2678a00636b703d9f3f567cba0998e4777e072f9367b9544de8a6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00001","start":291,"end":513,"exact":"The video features a complex mix of symbols, for a moment, the camera focuses on one of the performer's insignia showing the Tamga, Crimean Tatar coat of arms, next to a Trident, one of the symbols of the Ukrainian state. "},{"@id":"urn:doxa:passage:72b28203e24024a8ccb30ad42b7de60ad41f1e66e3153eec53dbc2f5cf7e2c2e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00001","start":513,"end":616,"exact":"This video occurs against the context of Moscow claiming they attacked Ukraine to “denazify” the state."},{"@id":"urn:doxa:passage:d4bdb2360cb7484c81dfa291509650ae350fe685368aaa83f1becbc38c740b8a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00002","start":0,"end":265,"exact":"The symbolism of the video is multilayered: The song, “A Walk to Caesarea” (1942), was written by Hannah Szenes (Senesh), a Hungarian-Israeli poet, and resistance operative working agianst the Nazis who was captured and killed in 1944 in Budapest at the age of 23. "},{"@id":"urn:doxa:passage:1e2fcb59539f416f79361b6d0a21ec87f6cd8eb854c047b59e771016e9aa2e81","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00002","start":265,"end":476,"exact":"The song is associated with the national Holocaust Remembrance Day of Israel, where it is performed annually, implying the authors of the video clip intended to direct their message to an international audience."},{"@id":"urn:doxa:passage:757c834a2155a29103b4f585d53e07cad4d719afdb0efc23c2e5f1b5ad304f22","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00003","start":0,"end":78,"exact":"The video was filmed in Babyn Yar, an infamous site of mass genocide in Kyiv. "},{"@id":"urn:doxa:passage:9dda7d75e2da70e1f3730296376566c9ad0878c592075af503eded50a861829e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00003","start":78,"end":312,"exact":"Thousands of Kyiv Jews and Roma were murdered by Nazis here and left in ravines, along with Soviet prisoners of war, Ukrainian nationalists and occasionally Nazi collaborators often accused of being Holocaust perpetrators themselves. "},{"@id":"urn:doxa:passage:ebbd3d9060ec0bd728bcbce03a51f08679761b8c3c364428bf9248d18b9973f2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00003","start":312,"end":454,"exact":"Babyn Yar has its own two days of remembrance, September 29–30, where citizens mourn the roughly 33,770 Jews killed by the Nazis at this site."},{"@id":"urn:doxa:passage:4d93d0ea755dab05443f4f6ca8fbb362b45a389621f8fe57a4871bef765d2235","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00004","start":0,"end":155,"exact":"Given Russia's ongoing invasion of Ukraine, marking this day and the history of the Jewish community in Ukraine was especially important in 2022 and 2023. "},{"@id":"urn:doxa:passage:e7ed4597493a1d4b95f122a997df561668a2828da52d3b61ee5332d4d463583f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00004","start":155,"end":316,"exact":"Internal disputes and antagonisms were put aside as institutions and groups addressed their sorrows together over the current war, rather than over past terrors."},{"@id":"urn:doxa:passage:250b74a663137bb095e3e06699178fbdf3bd88293f1fa22ab60009e913a82da6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00005","start":0,"end":39,"exact":"Zelensky: in search of strong symbolism"},{"@id":"urn:doxa:passage:dc62e10a9b4a9d92d49696a61621f165d589c821c2320e0fe7629184888f81e7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00006","start":0,"end":111,"exact":"Since Feb 24, 2022 when Moscow attacked Ukraine, Kyiv has been looking for ways to counter Russian propaganda. "},{"@id":"urn:doxa:passage:c5ce2bbb1e58781084a76c677a65704cda029cd45475894ee847ae40134482b1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00006","start":111,"end":226,"exact":"One of the state strategies in Ukraine is to highlight different genocides that have taken place in its territory. "},{"@id":"urn:doxa:passage:e5312d6e8ff8076f47b8dea4bbb0ba3a6235becfe30c289abd5295c29b84d517","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00006","start":226,"end":434,"exact":"These include the Stalin-made famine of the early 1930s known as Holodomor, the Holocaust, and the current Russian war and occupation that is believed to have cost over 7,000 civilian lives in Ukraine so far."},{"@id":"urn:doxa:passage:42389e0e80c55aa24b5811cd6785e41f06b72f03949d135f5bba2e4a9f1ab752","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00007","start":0,"end":143,"exact":"These days, each Ukrainian official address mentioning Nazi-led extermination of Jews draws parallels to Russian atrocities in Ukraine in 2022."},{"@id":"urn:doxa:passage:73172c0227e7497975f22fb0c9811f6725c6498d357ee87ba2d8d92f8a54373a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00008","start":0,"end":157,"exact":"In international politics, it is almost unthinkable to compare the Holocaust with anything else: insensitive at best and equal to Holocaust denial at worst. "},{"@id":"urn:doxa:passage:1e3964d7f51c38632e9cafec3595cfa7c423edab567f74f2566de4eef3e743a8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00008","start":157,"end":372,"exact":"This was exactly what Ukrainian president Volodymyr Zelensky was accused of doing by several Israeli politicians after his Zoom speech for the Israeli Parliment in the first month of the Russian full-scale invasion."},{"@id":"urn:doxa:passage:fb8f1de59b893d79e623516cb43dbbf93459c4777357080b2c15436436d51e15","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00009","start":0,"end":176,"exact":"But since Zelensky himself comes from a Jewish family which directly suffered from the Nazis, he may think that his personal history gives him legitimacy to draw this parallel."},{"@id":"urn:doxa:passage:5d4742383dcd70fa24333b732e11eab792267ac595012b21e457e1a448ce63e5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00010","start":0,"end":112,"exact":"It was not Zelensky, however, who initiated the comparisons, and not even him who emphasised his Jewish origin. "},{"@id":"urn:doxa:passage:c290f21a48c2768ad2e2dd946c82284f34fb6beb4bac32b368f66d6910b84e9f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00010","start":112,"end":437,"exact":"Right after Russia attacked Ukraine, as soon as it became clear that the Kyiv leadership was not going to flee and its people would fight, the Ukrainian president became an icon for Jewish media who called him “the modern Maccabee” — a reference to the history of Jewish resistance to oppression, including that of the Nazis."},{"@id":"urn:doxa:passage:972000d40b821b1bf6d6517717f9fe00d7ca5e33f3a2c4582dca3b63e21de2ab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00011","start":0,"end":237,"exact":"While Ukrainian Jewish history has been associated with discrimination and persecution, in 2022, many Jews worldwide proudly rediscovered their Ukrainian roots and shared family stories about oppression they faced at the hands of Russia."},{"@id":"urn:doxa:passage:00294ed196f96fc5e37ac7bc75eb6a0445031b5c85fb27bb902926b257d2ce20","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00012","start":0,"end":46,"exact":"Is wartime really the time to revisit history?"},{"@id":"urn:doxa:passage:53ebb09e7e9b4a0e2cad849915427b535096849ecf6190f57284b3e24f9824a4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00013","start":0,"end":174,"exact":"The parallel cited above raises the question of Jewish-Ukrainain relations that remains a source of contention among different segments and generations of Ukrainian society. "},{"@id":"urn:doxa:decision:3fb5c699c85c3fa16d618e555a3f8ffb","@type":["doxa:Decision","prov:Entity"],"recordId":"3fb5c699c85c3fa16d618e555a3f8ffb","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:ihra:anti_jewish_generalization:2026-11-