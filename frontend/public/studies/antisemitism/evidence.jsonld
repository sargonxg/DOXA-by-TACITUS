5d3fb23bcb7a29b268d1ff59a5fafae2af576c4af2fd13447","urn:doxa:passage:fb886a3db3ff57d77dd0bca4d7945e9826e0278f4eab2bc184955136ab26f79f","urn:doxa:passage:30e3aa763890e8d1823e261b5f101c69a5842abee5ca9eddc29f1a6cffbf36eb","urn:doxa:passage:e450df59a9ddcd8da110716085ed7e666332ade34e3c2270b3617a44e7a1ee6d","urn:doxa:passage:2695cf41188504e46b9d1610178c09304885e78570d1f0ad28ca21884b0798fb","urn:doxa:passage:9b8d0caddf4d1bb72c7c84a16f6dd17ef216f066b056fc9e0355fc93ac97a671","urn:doxa:passage:0f9c61b33df7c13631edb7cc6ad23aa77b59a88f7b257e2112004f0e1967bc0c","urn:doxa:passage:2b1ff03759ee28ca3cca34435de51aadf71b8bc264c9126fdbd6d0d70e840066","urn:doxa:passage:a9f78e760558efeaba67707486614a0d53712c555cd9e4b2e57d90e4a80e45a2","urn:doxa:passage:aefe0741019152563656aa2ef504b61cce10b051639e568414660902faa9b12c","urn:doxa:passage:29f7a1cb287802cf3eb437c9e155f7d7fbae552b43c4a013f4ca4549ba2efadb","urn:doxa:passage:a6b81be4b29019b249a9a510ecaa9d28934f3194dfb438233f476c41f9630c17","urn:doxa:passage:dfbc9716b15019ad3893c911798c9589c4d8b3a1893376a8c9bf0913bf6f46bd","urn:doxa:passage:2f25c4011bbf832366971c2dcbeec313d68fa497d87216f75ececb2d3122ffa8","urn:doxa:passage:c40776cdad63454674a95d9906119b792fa5b4021dd78d6ae1ae6fd5303be695","urn:doxa:passage:63fb489fcc4548ae6397960e79aa2b17f42aea5619ce48fa03e86fbfbaf53255","urn:doxa:passage:11ac9fe1952cf80ffedf40194122fdacfeb7022598b86c983470e78f0c068fce","urn:doxa:passage:5d75bcf5372233751c11d937083745622ec190daf83dc068cd74d0a97d56c9fe","urn:doxa:passage:c856f2584e8df50d1b14d38513d4874e8ea1ad23e18a372d46ed3718cc0f3b90","urn:doxa:passage:1653869a1b20a2f3d6641354e2369c328299a24563d305ee6042f14f7efcfeb0","urn:doxa:passage:a5fb2476df6085dfdeb1afb880ed7f8065fb3994743dfd8afc59f2cbf05a7b0e"]},{"@id":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-780962","title":"Explaining ‘Ukrainian antisemitism’ and Holocaust diplomacy","author":"Yulia Abibok","translator":[],"publishedOn":"2023-02-13","sourceUrl":"https://globalvoices.org/2023/02/13/explaining-ukrainian-antisemitism-and-holocaust-diplomacy/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"503dca92e756470bd25e6190e21656172fa369dcb7650c60e6621b8da55e2a7f","textSha256":"bc79e39db1b73e08fedce366eee5b02499e79915ee634a66f9b930d4452ee3b6","archivedRecordSha256":"0841f31cb67537d53e485dd05b3545429765c19022145da1878c86a4b0413e13","inStudy":"urn:doxa:study:antisemitism-case-1"},{"@id":"urn:doxa:unit:1e799a3b99709d52255fdea3d9253a54:u_1ecbc14c1ac02ceb1981f8bb","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_1ecbc14c1ac02ceb1981f8bb","status":"accepted","fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54"},{"@id":"urn:doxa:unit:1e799a3b99709d52255fdea3d9253a54:u_fcf4156689f78935238ca1fc","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_fcf4156689f78935238ca1fc","status":"accepted","fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54"},{"@id":"urn:doxa:passage:1c1a55ab05f9df823e53fae1bc6243c70f594c865a309784c0d738f025efd85f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00013","start":174,"end":370,"exact":"The truth is that the country has still not reconciled the conflicting narratives about its 20th century history with anti-Jewish pogroms, Nazi-era persecutions, and Soviet-sponsored antisemitism."},{"@id":"urn:doxa:passage:4dbeff439cb66a928c0bd35675f879a4f6acd08e9ddc7eeeb0a12b76d3d3a581","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00014","start":0,"end":369,"exact":"Certain historical figures, like Bohdan Khmelnytsky, Symon Petliura, or Stepan Bandera who are today perceived as champions of Ukrainian patriotism in mainstream discourse, particularly for their opposition to Russian and Soviet colonialism, abroad are usually associated with major mass massacres of Jews and as such, they left deep traces in Jewish collective memory."},{"@id":"urn:doxa:passage:098ec9948761d5c6ff0bd0a56eb06145e05ddb3cf4f5d32b604ae8f7bc6493fc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00015","start":0,"end":361,"exact":"Paradoxically, in their parallels with the Russian invasion of Ukraine, Ukrainian officials, including Zelensky, refer to Jews who suffered in this area, as “you” but not “we.” For example in his speech before the Knesset Zelensky said, “I have the right to this parallel and to this comparison,” referring to the Holocaust and the Russian invasion of Ukraine. "},{"@id":"urn:doxa:passage:76b2ac173cae1ba2f2773347d02b169d5740d7336fa8add7ed953ffa21deac08","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00015","start":361,"end":402,"exact":"He added: “Our history and your history. "},{"@id":"urn:doxa:passage:a406778d6081d535d6321c75fc1fa0fb7974412598feacc450fac99e7dad3f0e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00015","start":402,"end":501,"exact":"Our war for our survival and World War II,” as if Jews have never been a part of the local society."},{"@id":"urn:doxa:passage:6de57ba8880783eb45883af8782fe46d1cb4bdac2717aed7f4f61c0cc2822165","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00016","start":0,"end":284,"exact":"Since Ukraine gained its independence in 1991, Jewish studies and Holocaust research, education, and remembrance have been blooming in the country thanks to foreign financing, but also local grassroots initiatives and genuine empathy and interest in the history and culture repressed."},{"@id":"urn:doxa:passage:bb32c4dcb8ec019062d00f9dfb05b241f62bd184dd88f4d8528b6047bab00454","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00017","start":0,"end":436,"exact":"Internally and internationally, however, it is Russia which is associated with the fight against Nazi Germany (internationally, the former Soviet Union is often referred to simply as “Russia”) while Ukrainians are still widely seen as collaborators: the expression “Ukrainian collaborators” is widely used in media and academia in WWII history discourse, which reinforces the idea that all Ukrainians were collaborators during the war. "},{"@id":"urn:doxa:passage:cd9ddbfb8acbe39273f51a85ba5cd3adab92f9feccfacce4e5da61a93401035f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00017","start":436,"end":595,"exact":"Ukraine's rejection of its Soviet past and Russia's activities of spreading anti-Ukrainian historical narratives contributed heavily to this state of affairs. "},{"@id":"urn:doxa:passage:c5d24e6b1c01b4c3a444d4ad2b5e49045ccee79b7b1446c31ffd76f61772ae77","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00017","start":595,"end":732,"exact":"In modern Ukraine, the Red Army fighters are perceived as occupiers even though hundreds of thousands of them were Ukrainians themselves."},{"@id":"urn:doxa:passage:0d6a4ab07d96eebf6c0bae122de5ff5fc5769887cab536c593f673a31b6bcb69","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00018","start":0,"end":200,"exact":"The Twitter post of Andriy Yermak, the presidential office's main adviser on media issues, drawing parallels between Holocaust and Russian invasion of Ukraine, met mixed reactions from users, such as:"},{"@id":"urn:doxa:passage:80735c7d3e0db63b462e5ca418a6cb292ca4d51ad36acc1fd0f8dfe8db342529","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00019","start":0,"end":14,"exact":"Another wrote:"},{"@id":"urn:doxa:passage:dc8186a57a4e2c6581c337ea34bb0374144769f2870aca0f46bb7d1fe1c457b7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00020","start":0,"end":150,"exact":"There have been attempts to review and reevaluate historic figures and formations like Stepan Bandera and the Organisation of Ukrainian Nationalists. "},{"@id":"urn:doxa:passage:1d49e1c61ff365b32b18f69abb71890e8d0857248b8099a02654c95718ebda1c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00020","start":150,"end":415,"exact":"But the Russian full-scale invasion of Ukraine made them once again irrelevant for many and toxic for some as the Ukrainian society faces incessent disinformation attacks from Russia, but also an urgent need for patriotism and inspiration from the national history."},{"@id":"urn:doxa:passage:ff3dde413211efd5366fb7a8f378cf0bd5bcf0543555db6fc3c85e80118c0227","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1e799a3b99709d52255fdea3d9253a54","blockId":"gv-780962-b00021","start":0,"end":87,"exact":"The fact is that today, Ukraine is now among the least antisemitic countries in Europe."},{"@id":"urn:doxa:decision:90c13c15512aa00ccdf3a373c391c224","@type":["doxa:Decision","prov:Entity"],"recordId":"90c13c15512aa00ccdf3a373c391c224","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:ihra:anti_jewish_generalization:2026-11-operational-1:07872328c821afca407bc3f824933eae27582cd486ab34cf52466ad43ab7b92a","scoredUnit":"urn:doxa:unit:1e799a3b99709d52255fdea3d9253a54:u_1ecbc14c1ac02ceb1981f8bb","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitCo