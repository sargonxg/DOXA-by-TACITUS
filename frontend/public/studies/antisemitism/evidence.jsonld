antisemitism","snapshotSha256":"2feef47f32f5fdd91c5a826827a88e9f3b01e7ccc44b4e6e8ab06d456eec3fac"},{"@id":"urn:doxa:criterion:ihra:anti_jewish_generalization:2026-11-operational-1:07872328c821afca407bc3f824933eae27582cd486ab34cf52466ad43ab7b92a","@type":["doxa:Criterion","prov:Entity"],"recordId":"anti_jewish_generalization","title":"Anti-Jewish hostility or stereotyping","rule":"Assess hostility, dehumanization, conspiracies, or collective allegations directed at Jews as Jews.","kind":"indicator","inFramework":"urn:doxa:framework:ihra:2026-11-operational-1:2feef47f32f5fdd91c5a826827a88e9f3b01e7ccc44b4e6e8ab06d456eec3fac"},{"@id":"urn:doxa:criterion:ihra:collective_responsibility:2026-11-operational-1:e16d6fd95efec64cdfce140ba7d4f040e9e19b26de13fe0b44e218b8f243a841","@type":["doxa:Criterion","prov:Entity"],"recordId":"collective_responsibility","title":"Collective responsibility","rule":"Assess holding Jewish people collectively responsible for real or alleged acts of another person, group, or Israel.","kind":"indicator","inFramework":"urn:doxa:framework:ihra:2026-11-operational-1:2feef47f32f5fdd91c5a826827a88e9f3b01e7ccc44b4e6e8ab06d456eec3fac"},{"@id":"urn:doxa:criterion:ihra:israel_related_context:2026-11-operational-1:0fdd40b36673cc7bde17c931d6e5ec129488ae1c8fcd956797d4a44e396340b6","@type":["doxa:Criterion","prov:Entity"],"recordId":"israel_related_context","title":"Israel-related expression in context","rule":"Assess relevant IHRA examples in overall context, including anti-Jewish tropes, discriminatory standards or denial of Jewish self-determination. Do not assume that policy criticism alone satisfies a criterion.","kind":"indicator","inFramework":"urn:doxa:framework:ihra:2026-11-operational-1:2feef47f32f5fdd91c5a826827a88e9f3b01e7ccc44b4e6e8ab06d456eec3fac"},{"@id":"urn:doxa:framework:jda:2021-operational-1:4c6de2019f4741d35a348805e046578dff7a8804d28dd67d6978d95bef4f24e1","@type":["doxa:Framework","prov:Entity"],"recordId":"jda","title":"Antisemitism · Jerusalem Declaration","version":"2021-operational-1","sourceUrl":"https://jerusalemdeclaration.org/","snapshotSha256":"4c6de2019f4741d35a348805e046578dff7a8804d28dd67d6978d95bef4f24e1"},{"@id":"urn:doxa:criterion:jda:jews_as_jews:2021-operational-1:1ddce80ac8cf0e3c8383100cf8cd3fe0e5aec195ca096952cb7f0c746b7cd61d","@type":["doxa:Criterion","prov:Entity"],"recordId":"jews_as_jews","title":"Discrimination against Jews as Jews","rule":"Assess discrimination, prejudice, hostility, or violence against Jews as Jews or Jewish institutions as Jewish.","kind":"indicator","inFramework":"urn:doxa:framework:jda:2021-operational-1:4c6de2019f4741d35a348805e046578dff7a8804d28dd67d6978d95bef4f24e1"},{"@id":"urn:doxa:criterion:jda:tropes_collective_guilt:2021-operational-1:836c2876f37a544b554f941409291bcaed0b54db6c21905f4b4f666038449741","@type":["doxa:Criterion","prov:Entity"],"recordId":"tropes_collective_guilt","title":"Tropes and collective guilt","rule":"Assess anti-Jewish conspiracies, essentializing stereotypes, and responsibility assigned to Jews for Israel's conduct.","kind":"indicator","inFramework":"urn:doxa:framework:jda:2021-operational-1:4c6de2019f4741d35a348805e046578dff7a8804d28dd67d6978d95bef4f24e1"},{"@id":"urn:doxa:criterion:jda:political_expression_boundary:2021-operational-1:5be0cbcb6099e904a8856a25661d2c725d2f5412e9505400eea148cdfed57d13","@type":["doxa:Criterion","prov:Entity"],"recordId":"political_expression_boundary","title":"Political-expression boundary","rule":"Differentiate anti-Jewish expression from political criticism. BDS, anti-Zionism, constitutional alternatives securing equality, and disproportionate criticism are not inherently antisemitic under this framework.","kind":"boundary","inFramework":"urn:doxa:framework:jda:2021-operational-1:4c6de2019f4741d35a348805e046578dff7a8804d28dd67d6978d95bef4f24e1"},{"@id":"urn:doxa:framework:nexus:2024-06-operational-1:c95095d8f3bdffb85d633f8a995f0721b99822d0bae4657cb10244b4aec34be6","@type":["doxa:Framework","prov:Entity"],"recordId":"nexus","title":"Antisemitism · Nexus","version":"2024-06-operational-1","sourceUrl":"https://nexusproject.us/nexus-resources/the-nexus-document/","snapshotSha256":"c95095d8f3bdffb85d633f8a995f0721b99822d0bae4657cb10244b4aec34be6"},{"@id":"urn:doxa:criterion:nexus:anti_jewish_tropes:2024-06-operational-1:95dc4e45e8caafbdff294385181d9ffacd4d9ecc7602d5404731b2a4e0772333","@type":["doxa:Criterion","prov:Entity"],"recordId":"anti_jewish_tropes","title":"Anti-Jewish tropes","rule":"Assess stereotypical assertions, conspiracies, demonization, or unequal treatment directed at Jews as Jews.","kind":"indicator","inFramework":"urn:doxa:framework:nexus:2024-06-operational-1:c95095d8f3bdffb85d633f8a995f0721b99822d0bae4657cb10244b4aec34be6"},{"@id":"urn:doxa:criterion:nexus:collective_guilt:2024-06-operational-1:212538155292d7b06703f99172c0f53ed71912c679ca433fdaa76527f6722fdf","@type":["doxa:Criterion","prov:Entity"],"recordId":"collective_guilt","title":"Collective guilt","rule":"Assess blaming Jews collectively for Israel or presuming Jewish individuals are agents of Israel.","kind":"indicator","inFramework":"urn:doxa:framework:nexus:2024-06-operational-1:c95095d8f3bdffb85d633f8a995f0721b99822d0bae4657cb10244b4aec34be6"},{"@id":"urn:doxa:criterion:nexus:opposition_boundary:2024-06-operational-1:8b20e096fd16200fd404e92c0882468e6052f2760fe7367ad537deae7244cf29","@type":["doxa:Criterion","prov:Entity"],"recordId":"opposition_boundary","title":"Political-opposition boundary","rule":"Distinguish hostility to Jews from criticism of Israel or Zionism. Disproportionate attention to Israel is not prima facie proof of antisemitism.","kind":"boundary","inFramework":"urn:doxa:framework:nexus:2024-06-operational-1:c95095d8f3bdffb85d633f8a995f0721b99822d0bae4657cb10244b4aec34be6"},{"@id":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-774621","title":"Remembering Moshe Ha Elion, Sephardic Jewish author and Holocaust survivor from Thessaloniki","author":"Filip Stojanovski","translator":[],"publishedOn":"2022-11-15","sourceUrl":"https://globalvoices.org/2022/11/15/remembering-moshe-ha-elion-sephardic-jewish-author-and-holocaust-survivor-from-thessaloniki/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"4b877d3b8a5c1c420ccf50ae350cbe2b04286ccd33e36aeb2b068fb6653262fb","textSha256":"07bff4ceeafae1a941c970e6241ae85cf1034edef826a04a34593801222c253e","archivedRecordSha256":"dba0102529175b0e375216e9bcaf3999c88b30d6f5083ba795531ba0c291b43f","inStudy":"urn:doxa:study:antisemitism-case-1"},{"@id":"urn:doxa:unit:b45552ca52b8c063301f73af3554c25d:u_1a9b96003cb2484f49191ea6","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_1a9b96003cb2484f49191ea6","status":"accepted","fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d"},{"@id":"urn:doxa:unit:b45552ca52b8c063301f73af3554c25d:u_e1701692cd44e8286d93a6b5","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_e1701692cd44e8286d93a6b5","status":"accepted","fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d"},{"@id":"urn:doxa:passage:d90ee9dae5c7e378513ad6be3167f752e723682ed29966aba3480cdeda1ddb00","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00017","start":0,"end":309,"exact":"Visitors today can see several several sites dedicated to remembrance of the Jewish presence in the city, including a Jewish Museum and a monument to the 50.000 victims of the Holocaust in the shape of burning menorah with a memorial plaque in the center, next to Eleftherias (Freedom) Square, near the port. "},{"@id":"urn:doxa:passage:8dc6410ec882666c962f933c4987cc9acb1bf679520f40fb1915adf1a577b797","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00017","start":309,"end":411,"exact":"The square was used by the Nazis to round up and publicly humiliate local Jewish men on July 11, 1942."},{"@id":"urn:doxa:passage:8de5981271fad33f9fcf42fb02691805f45eb9eafd5ccb4357bfbcb73a403581","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00018","start":0,"end":234,"exact":"Greek anti-fascist activists often warn of increasing antisemitism fueled by right wing extremists, while the local Jewish community is striving to urge authorities to increase the visibility and remembrance of the historic heritage. "},{"@id":"urn:doxa:passage:04d340b78a64478dbdd58d0af6ae71f509834df3150a54412bd0ae27b6897732","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00018","start":234,"end":330,"exact":"In particular there's controversy over using the Eleftherias Square as a municipal parking lot. "},{"@id":"urn:doxa:passage:585db42730d760cac1c45faa30e8c818d333d93d9500532653c92c0f9d7d3af0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00018","start":330,"end":434,"exact":"Local activists have been using stickers to explain the context to the public and to warn “never again.”"},{"@id":"urn:doxa:passage:91d72f76f2259a644b1bddd0fe8190058f3fbd653dec9610c76115d450b0d798","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00019","start":0,"end":156,"exact":"In 2016 the local Jewish community and the mayor started an initiative to build a Holocaust Memorial Museum & Educational Center of Greece on Human Rights. "},{"@id":"urn:doxa:passage:f73b662a969b7520982e3034dae205b1fea9b4cce010c710fea92aed55782a42","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00019","start":156,"end":242,"exact":"The construction, initially supported by Germany, stalled due to the economic crisis. "},{"@id":"urn:doxa:passage:64842cb040cd5260467177dc7819ea894f69dcc48c20629d137aa9068bd0a12f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00019","start":242,"end":262,"exact":"In January 2022 Dr. "},{"@id":"urn:doxa:passage:dbd9e622cd28a7c74680495ba62e227b2740c6252f1db27f7c8aa634fb6cc871","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00019","start":262,"end":478,"exact":"Albert Bourla, CEO of Pfizer, who was also born in Thessaloniki, asked The Genesis Prize Foundation to direct his USD 1 million award received for the COVID-19 vaccine towards the establishment of a Holocaust museum."},{"@id":"urn:doxa:decision:4a2bca68d13399e6c43a12f1b3a027a0","@type":["doxa:Decision","prov:Entity"],"recordId":"4a2bca68d13399e6c43a12f1b3a027a0","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:ihra:anti_jewish_generalization:2026-11-operational-1:07872328c821afca407bc3f824933eae27582cd486ab34cf52466ad43ab7b92a","scoredUnit":"urn:doxa:unit:b45552ca52b8c063301f73af3554c25d:u_1a9b96003cb2484f49191ea6","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:d90ee9dae5c7e378513ad6be3167f752e723682ed29966aba3480cdeda1ddb00","urn:doxa:passage:8dc6410ec882666c962f933c4987cc9acb1bf679520f40fb1915adf1a577b797","urn:doxa:passage:8de5981271fad33f9fcf42fb02691805f45eb9eafd5ccb4357bfbcb73a403581","urn:doxa:passage:04d340b78a64478dbdd58d0af6ae71f509834df3150a54412bd0ae27b6897732","urn:doxa:passage:585db42730d760cac1c45faa30e8c818d333d93d9500532653c92c0f9d7d3af0","urn:doxa:passage:91d72f76f2259a644b1bddd0fe8190058f3fbd653dec9610c76115d450b0d798","urn:doxa:passage:f73b662a969b7520982e3034dae205b1fea9b4cce010c710fea92aed55782a42","ur