8bd0a12f","urn:doxa:passage:dbd9e622cd28a7c74680495ba62e227b2740c6252f1db27f7c8aa634fb6cc871"]},{"@id":"urn:doxa:decision:b2bdaacfcdc1878d0c3b6b8cc63d211b","@type":["doxa:Decision","prov:Entity"],"recordId":"b2bdaacfcdc1878d0c3b6b8cc63d211b","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:nexus:opposition_boundary:2024-06-operational-1:8b20e096fd16200fd404e92c0882468e6052f2760fe7367ad537deae7244cf29","scoredUnit":"urn:doxa:unit:b45552ca52b8c063301f73af3554c25d:u_1a9b96003cb2484f49191ea6","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:d90ee9dae5c7e378513ad6be3167f752e723682ed29966aba3480cdeda1ddb00","urn:doxa:passage:8dc6410ec882666c962f933c4987cc9acb1bf679520f40fb1915adf1a577b797","urn:doxa:passage:8de5981271fad33f9fcf42fb02691805f45eb9eafd5ccb4357bfbcb73a403581","urn:doxa:passage:04d340b78a64478dbdd58d0af6ae71f509834df3150a54412bd0ae27b6897732","urn:doxa:passage:585db42730d760cac1c45faa30e8c818d333d93d9500532653c92c0f9d7d3af0","urn:doxa:passage:91d72f76f2259a644b1bddd0fe8190058f3fbd653dec9610c76115d450b0d798","urn:doxa:passage:f73b662a969b7520982e3034dae205b1fea9b4cce010c710fea92aed55782a42","urn:doxa:passage:64842cb040cd5260467177dc7819ea894f69dcc48c20629d137aa9068bd0a12f","urn:doxa:passage:dbd9e622cd28a7c74680495ba62e227b2740c6252f1db27f7c8aa634fb6cc871"]},{"@id":"urn:doxa:passage:b307de9feb14661258c4b783f2c0635efc573b6e76b3451815745924c211a50b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00001","start":0,"end":119,"exact":"Holocaust survivor, writer and translator Moshe Ha Elion passed away on November 1 at the age of 97, eSephard reported."},{"@id":"urn:doxa:passage:a50b26aaee70d751720879635db507d1e649fb7cf035050ecdb8dff141ab4ac8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00002","start":0,"end":222,"exact":"He was originally from Thessaloniki, Greece, and was internationally known for documenting the suffering of the Salonikan Jews in the Nazi extermination camps through his memoirs and poems, published in Ladino and Hebrew. "},{"@id":"urn:doxa:passage:11471a2ab8200fd8e02549c7c77451af1b125c327c8498820592f497c75e31ee","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00002","start":222,"end":454,"exact":"Ha Elion lived in Israel and served as representative of the community of Sephardic Jews, and promotor of their ancestral language Ladino, or Judeo-Spanish, a Romance language derived from Old Spanish, and one considered endangered."},{"@id":"urn:doxa:passage:3c0608e9e43a0fe528a53ecc2c34e301d79860ffd5dbd9de92ba54866c01bdfe","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00003","start":0,"end":42,"exact":"Ladino scholar, educator and activist Dr. "},{"@id":"urn:doxa:passage:a3294679c9dd8e8095a4759b47cc9f5b83cb4895a01a6cebe1807cd5432002e9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00003","start":42,"end":228,"exact":"Bryan Kirshen, who only a week ago mourned the passing of one of the last Ladino speakers from the Balkans, Moris Albahari from Bosnia and Herzegovina, expressed his remorse via Twitter:"},{"@id":"urn:doxa:passage:33ee06e393b4902718a6dff2f9f49c12eacbc2fb7761f2b1cbece537e7fa1979","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00004","start":0,"end":142,"exact":"Moshe Ha Elion was born in Thessaloniki in 1925 in a a middle-class Sephardic Jewish family which spoke Ladino in the home and Greek outside. "},{"@id":"urn:doxa:passage:5d3b847b99c38571efcf4527c080f3c0a5f80cd33be3a248803b9c4abda0983e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00004","start":142,"end":364,"exact":"In 1943, German Nazis who occupied the city deported him and his family alongside almost entire Jewish population of 46,091 to concentration camps, killing the majority of prisoners in gas chambers over the next two years."},{"@id":"urn:doxa:passage:5ddc8f03f94ead9824d0be57bf5c506ef8f905de6bb8f7e763cb1c925043ae37","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00005","start":0,"end":188,"exact":"As a teenager, Ha Elion survived Auschwitz, the death march, Mauthausen, Melk, and Ebensee, and after the liberation immigrated to Palestine, and took part in the establishment of Israel. "},{"@id":"urn:doxa:passage:8e6a66554db421ae4b211906059f579e04640abf714dda042ec1793c5d101851","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00005","start":188,"end":375,"exact":"After retiring from career in the military and state administration, he served as member, vice president and president of the Association of the Holocaust Survivors from Greece in Israel."},{"@id":"urn:doxa:passage:0ce226ee570d9fb5e5fe71fae8d77294d87d72e5b484b9a1d0db3650e07ca98a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00006","start":0,"end":242,"exact":"In 2020, Yad Vashem, the World Holocaust Remembrance Center based in Jerusalem, released the documentary about his life “Recuerdos en ladino – La historia de Moshé Haelion” as part of their series of video testimonies of survivors in Spanish."},{"@id":"urn:doxa:passage:d5bcb8772e6d141808de927fbdf697bf8a444d448a65dfa3452cea622fa46c3d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00007","start":0,"end":363,"exact":"In 2000 Moshe Ha Elion published “En los Kampos de la Muerte” (The Death Camps) a poetic and autobiographical text written in Ladino and formed of three very large poems: “La djovenika al lager” (“The Fair Young Maiden of the Lager,” dedicated to his sister); “Komo komian el pan” (“How they ate the bread”); and “En marcha de la muerte” (“On the road to death”)."},{"@id":"urn:doxa:passage:bf266302077e4ad5d3fb23bcb7a29b268d1ff59a5fafae2af576c4af2fd13447","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00008","start":0,"end":193,"exact":"In 2005 Greek music group Codex ensemble led by Kostis Papazoglou and the Jewish Community Choir of Thessaloniki recorded “La djovenika al lager” at the Monastirioton Synagoge in Thessaloniki. "},{"@id":"urn:doxa:passage:fb886a3db3ff57d77dd0bca4d7945e9826e0278f4eab2bc184955136ab26f79f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00008","start":193,"end":263,"exact":"The song was included in the CD “En la mar ay una torre” (EMI, 2008). "},{"@id":"urn:doxa:passage:30e3aa763890e8d1823e261b5f101c69a5842abee5ca9eddc29f1a6cffbf36eb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00008","start":263,"end":280,"exact":"Papazoglou wrote:"},{"@id":"urn:doxa:passage:e450df59a9ddcd8da110716085ed7e666332ade34e3c2270b3617a44e7a1ee6d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00009","start":0,"end":61,"exact":"> “During my trip (1998) to Israel with the Choir, I met Mr. "},{"@id":"urn:doxa:passage:2695cf41188504e46b9d1610178c09304885e78570d1f0ad28ca21884b0798fb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00009","start":61,"end":158,"exact":"Moshe Ha-Elion, who gave me his poem “La Djovenika Al Lager” with the melody he composed for it. "},{"@id":"urn:doxa:passage:9b8d0caddf4d1bb72c7c84a16f6dd17ef216f066b056fc9e0355fc93ac97a671","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00009","start":158,"end":209,"exact":"Based on it, I made the arrangement we sing today. "},{"@id":"urn:doxa:passage:0f9c61b33df7c13631edb7cc6ad23aa77b59a88f7b257e2112004f0e1967bc0c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00009","start":209,"end":243,"exact":"The simultaneous narration by Mr. "},{"@id":"urn:doxa:passage:2b1ff03759ee28ca3cca34435de51aadf71b8bc264c9126fdbd6d0d70e840066","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00009","start":243,"end":332,"exact":"Ha-Elion describes the terrible history of the deported Jews in the concentration camps.”"},{"@id":"urn:doxa:passage:a9f78e760558efeaba67707486614a0d53712c555cd9e4b2e57d90e4a80e45a2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00010","start":0,"end":41,"exact":"In 2017 American educator and writer Dr. "},{"@id":"urn:doxa:passage:aefe0741019152563656aa2ef504b61cce10b051639e568414660902faa9b12c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00010","start":41,"end":250,"exact":"Judith Lin from the University of Virginia, who worked alongside Moshe for several years, translating his Holocaust work into English, published a short video about part of the process of translating the song."},{"@id":"urn:doxa:passage:29f7a1cb287802cf3eb437c9e155f7d7fbae552b43c4a013f4ca4549ba2efadb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00011","start":0,"end":54,"exact":"In a statement for Global Voices given via email, Dr. "},{"@id":"urn:doxa:passage:a6b81be4b29019b249a9a510ecaa9d28934f3194dfb438233f476c41f9630c17","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00011","start":54,"end":127,"exact":"Lin shared part of her experience in light of the loss of Moshe Ha Elion."},{"@id":"urn:doxa:passage:dfbc9716b15019ad3893c911798c9589c4d8b3a1893376a8c9bf0913bf6f46bd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00012","start":0,"end":144,"exact":"> On November 29, 2021 I directed the first choral performance of “The Fair Young Maiden” in English at my university, but this is only a start."},{"@id":"urn:doxa:passage:2f25c4011bbf832366971c2dcbeec313d68fa497d87216f75ececb2d3122ffa8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00013","start":0,"end":58,"exact":"> The world is no longer the same without Moshe Ha Elion. "},{"@id":"urn:doxa:passage:c40776cdad63454674a95d9906119b792fa5b4021dd78d6ae1ae6fd5303be695","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00013","start":58,"end":175,"exact":"His dream was that his song, “The Fair Young Maiden” would become an international hymn of remembrance of the Shoah. "},{"@id":"urn:doxa:passage:63fb489fcc4548ae6397960e79aa2b17f42aea5619ce48fa03e86fbfbaf53255","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00013","start":175,"end":233,"exact":"I have tried to do my part to help him realize this goal. "},{"@id":"urn:doxa:passage:11ac9fe1952cf80ffedf40194122fdacfeb7022598b86c983470e78f0c068fce","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00013","start":233,"end":335,"exact":"Ha Elion’s voice and his invaluable artistic contributions will live on through his writing and music."},{"@id":"urn:doxa:passage:5d75bcf5372233751c11d937083745622ec190daf83dc068cd74d0a97d56c9fe","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00014","start":0,"end":28,"exact":"> He will be greatly missed!"},{"@id":"urn:doxa:passage:c856f2584e8df50d1b14d38513d4874e8ea1ad23e18a372d46ed3718cc0f3b90","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00015","start":0,"end":37,"exact":"Holocaust remembrance in Thessaloniki"},{"@id":"urn:doxa:passage:1653869a1b20a2f3d6641354e2369c328299a24563d305ee6042f14f7efcfeb0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00016","start":0,"end":73,"exact":"Until 1912, Jews made up the majority of the population in Thessaloniki. "},{"@id":"urn:doxa:passage:a5fb2476df6085dfdeb1afb880ed7f8065fb3994743dfd8afc59f2cbf05a7b0e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b45552ca52b8c063301f73af3554c25d","blockId":"gv-774621-b00016","start":73,"end":201,"exact":"During the Second World War Holocaust or the Shoah, 94 percent of this Jewish population was deported and murdered by the Nazis."},{"@id":"urn:doxa:decision:d03c68bcca7ed9899c97c1bfefd7097a","@type":["doxa:Decision","prov:Entity"],"recordId":"d03c68bcca7ed9899c97c1bfefd7097a","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:ihra:anti_jewish_generalization:2026-11-operational-1:07872328c821afca407bc3f824933eae27582cd486ab34cf52466ad43ab7b92a","scoredUnit":"urn:doxa:unit:b45552ca52b8c0