ba666b10","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00025","start":36,"end":119,"exact":"Guardian regular First Dog on the Moon (aka Andrew Marlton) took a strong position:"},{"@id":"urn:doxa:passage:22bc24483b474b220e9130cd710f3e166b44f1f903bfc0fd40400e6ad665f374","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00026","start":0,"end":39,"exact":"> Post by @firstdogonthemoon@aus.social"},{"@id":"urn:doxa:passage:c6eaa22e2c5dacbc47d83aeca228bb5a616ef0842168ca435162f723ef457bfb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00027","start":0,"end":18,"exact":"> View on Mastodon"},{"@id":"urn:doxa:passage:e424aed6f6239724e9d996786a6d5dd36cb8182810c31493f951c89eab9bfade","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00028","start":0,"end":221,"exact":"> The Envoy is however keen to dictate the politics of people engaging in protest, as well as visa applications, school curriculum, content in the media, and also funding for universities and the arts to name just a few. "},{"@id":"urn:doxa:passage:324ce8747cc52716b1dc70bc398e63a9bc831c6e7594ff7af856e9cb11f03b40","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00028","start":221,"end":254,"exact":"Who knows where it all might end."},{"@id":"urn:doxa:passage:6d57b50c40646aea079afd9e09dcd486b35656c9942472dd58cf87bb2eb4e9f5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00029","start":0,"end":35,"exact":"> ‘Put that cartoonist in the van!’"},{"@id":"urn:doxa:passage:ee0e4ec39eecfbae8d379cb825cf12e88876e56c7f61c1b8c8d57380243b4712","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00030","start":0,"end":178,"exact":"The release of the plan was followed by revelations that Jillian Segal’s husband was linked to a AUD 50,000 (USD 32,500) donation to Advance Australia, a right-wing lobby group. "},{"@id":"urn:doxa:passage:ec9f9521b4ee8b947fabc04f41c8d4880de6cc4b685484b243c414a87fec57a5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00030","start":178,"end":219,"exact":"Jillian Segal has denied any involvement."},{"@id":"urn:doxa:passage:2386b85b0cfaafccb4f2f68fc212b9a70ff4146ec2595a396ea8d286bbde637e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00031","start":0,"end":57,"exact":"Cathy Wilcox raised the question of conflict of interest:"},{"@id":"urn:doxa:passage:e1ab33dba7128e56d272c7139517e6eafd28a5da091d952ef6da91d928515b0a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00032","start":0,"end":35,"exact":"> Post by @cathywilcox@theblower.au"},{"@id":"urn:doxa:passage:995ddc7112bcb60ecc2d57c735221d334a5fb230e17f6d56665205fa21804381","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00033","start":0,"end":18,"exact":"> View on Mastodon"},{"@id":"urn:doxa:passage:3a4661341d3f2936f78dd2ec6bbab2fe19eb0831d49fbfc804cb6a27adb3be18","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00034","start":0,"end":137,"exact":"Scott Morrison's conservative government endorsed the International Holocaust Remembrance Alliance’s definition of antisemitism in 2021. "},{"@id":"urn:doxa:passage:18a1c8b758c159f82f376b37a72f0a0f97554a164b9628fcdb347e681d861ab7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00034","start":137,"end":247,"exact":"Anthony Albanese's Labor government is currently considering its response to Jillian Segal's recommendations. "},{"@id":"urn:doxa:passage:d8fb2969533ee50b64e6711f42d0622f95eaf8fa5e26f3767bda8b70ab71b8ab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00034","start":247,"end":375,"exact":"Its latest criticism of the Israeli government reflects growing international outrage over the state-driven starvation in Gaza. "},{"@id":"urn:doxa:passage:9b868be7c9859482f8941dc60bf1e51a8a401dad3770067b16d0290d6b1130b4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00034","start":375,"end":418,"exact":"Australian Associated Press (AAP) reported:"},{"@id":"urn:doxa:passage:72c4ae37c4eda813931d471c265e517efae0f18fae05ffefb7cb34e3af6ec308","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:98a3627d929ec9f0ffea0c823f822ca1","blockId":"gv-839816-b00035","start":0,"end":206,"exact":"> Israel has ‘quite clearly’ breached international law by limiting food deliveries to starving civilians in Gaza, Anthony Albanese has declared in a notable escalation of his criticism of the Jewish state."},{"@id":"urn:doxa:decision:aa48e24c94c459ad4a049f94523e6427","@type":["doxa:Decision","prov:Entity"],"recordId":"aa48e24c94c459ad4a049f94523e6427","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:ihra:anti_jewish_generalization:2026-11-operational-1:07872328c821afca407bc3f824933eae27582cd486ab34cf52466ad43ab7b92a","scoredUnit":"urn:doxa:unit:98a3627d929ec9f0ffea0c823f822ca1:u_8ff88fe69e51196256ce8f55","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetic