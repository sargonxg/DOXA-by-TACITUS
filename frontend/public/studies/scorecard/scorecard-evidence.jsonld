    {
      "@id": "urn:doxa:passage:c1ff0928743ed10bcd256bcba49d08b80cf2c0834e242496f6dfa7c96984a898",
      "@type": "doxa:Passage",
      "source": "urn:doxa:source-version:bf80acbd3004f0f7d21238f509581a8b1659113054e8c7170dbfce27b614baa6",
      "exact": "Last September, dispatch logs recorded two ambulance delays while access lanes to Civic Square were blocked.",
      "block_id": "b000001",
      "start": 0,
      "end": 108,
      "cue_start_ms": null,
      "cue_end_ms": null
    },
