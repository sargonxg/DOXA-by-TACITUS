      "status": "positive",
      "planned": 1,
      "retained": 1,
      "decision": "urn:doxa:decision:094902efa264a3fa6df1df9903b2cf4fe9afb7cceae3115bb3c8d8edf76ddbb7"
    },
    {
      "@id": "urn:doxa:passage:93bec40b72500020f9117b21b0672f90d4d8a2696288aae9afa41b3fed001e8c",
      "@type": "doxa:Passage",
      "source": "urn:doxa:source-version:bf80acbd3004f0f7d21238f509581a8b1659113054e8c7170dbfce27b614baa6",
      "exact": "The committee recommends keeping demonstrators outside two blocks of the square between six and ten in the evening. The exclusion zone is a proportionate safety measure that would keep the emergency route open.\n",
      "block_id": "b000002",
      "start": 0,
      "end": 211,
      "cue_start_ms": null,
      "cue_end_ms": null
    },
