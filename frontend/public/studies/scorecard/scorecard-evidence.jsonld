    {
      "@id": "urn:doxa:passage:c1ff0928743ed10bcd256bcba49d08b80cf2c0834e242496f6dfa7c96984a898",
      "@type": "doxa:Passage",
      "source": "urn:doxa:source-version:bf80acbd3004f0f7d21238f509581a8b1659113054e8c7170dbfce27b614baa6",
      "exact": "Last September, dispatch logs recorded two ambulance delays while access lanes to Civic Square were blocked.",
      "block_id": "b000001",
      "start": 0,
      "end": 108,
      "cue_start_ms": null,
      "cue_end_ms": null
    },
    {
      "@id": "urn:doxa:decision:094902efa264a3fa6df1df9903b2cf4fe9afb7cceae3115bb3c8d8edf76ddbb7",
      "@type": "doxa:Decision",
      "criterion": "urn:doxa:method-card:06480baf98f423d1ced1dfdb299feba4b2218ce500b712b807eafdb8cb05afb8",
      "passage": "urn:doxa:passage:c1ff0928743ed10bcd256bcba49d08b80cf2c0834e242496f6dfa7c96984a898",
      "run": "urn:doxa:run:authored-civic-square-v1",
      "assessmentId": "5ba657a63675754f2bdcfe6babcf3c8efe7081315f9de84501f38828e01d4a05"
    },
    {
      "@id": "urn:doxa:scorecard-cell:bc3035c4d527d15d111798f405ad0eb71ee52d6453ecb9c43ae270fc24b9e6f3",
      "@type": "doxa:SourceCriterion",
