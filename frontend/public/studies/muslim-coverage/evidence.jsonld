c520370ba640d86670d93213ff56c27a8c8201ca593f78541be1a8c18c6ebd","urn:doxa:passage:9f652cf9f9de0fa685bab74552508e07680e166720307419dc24ec315d7f9d26","urn:doxa:passage:cf61bc9c92d202cf91bab41487a8a1bb9854fa34ce49575d381ca11590ff9f11"]},{"@id":"urn:doxa:passage:c89ee6c63e77c9a47e34a39c7ad75aec103eca17d8046a877e930101aeacfa3b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00001","start":0,"end":61,"exact":"This article was first published by Raseef22 on November 24. "},{"@id":"urn:doxa:passage:9b1eb5149705c43e96ad7d9385243c114415113b736b531a012b641137d3a063","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00001","start":61,"end":138,"exact":"An edited version is republished as part of a partnership with Global Voices."},{"@id":"urn:doxa:passage:e21adff8b7444a2c281519145c9f8eb83a737c5f24ee0e735743f639c51b1cfe","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00002","start":0,"end":169,"exact":"Etel Adnan, iconic Lebanese-American poet, essayist, and internationally acclaimed visual artist, died on November 14 at the age of 96, peacefully at her home in Paris. "},{"@id":"urn:doxa:passage:10bbfe7b03b45683ca698986f009e26b3780598ebb9452aef848bf966d31bb17","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00002","start":169,"end":255,"exact":"She leaves behind her longtime partner, renowned Syrian Lebanese artist Simone Fattal."},{"@id":"urn:doxa:passage:56932b0cee089e8e928cb2840ca9e0ac9a8358f6af6d3e78b5b48d9675e991fc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00003","start":0,"end":145,"exact":"Over a lifetime that spanned almost a century, Adnan had multiple lives, through her work in journalism, teaching, writing, painting and poetry. "},{"@id":"urn:doxa:passage:09eca8b7a46dc20f9f6a932122550eb88afd0bf1fb197867b28e9a78d7659937","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00003","start":145,"end":380,"exact":"She had had a profound impact on a multitude of people, and an outpouring of tributes, memories and condolences continue on social media, as her life is celebrated, her memory cherished, and her loss mourned by many all over the world."},{"@id":"urn:doxa:passage:f3bef09ccf01b722e0d5d49954a0f2343beb967c4f99fd9f4cf8f115c7452f50","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00004","start":0,"end":325,"exact":"The countless facets of her career come in part from her multiple identities, as she grew up in a mixed household in the city of Beirut – which she held dear to her heart-, with her Greek Christian mother from Smyrna (now the city of Izmir) and her Syrian Muslim father from Damascus, who was a high-ranking Ottoman officer. "},{"@id":"urn:doxa:passage:6d1db4428a4d7d38bf67671bae2b0608fb0eb4635f9fef526b555d4eddc2dc52","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00004","start":325,"end":463,"exact":"Her exposure to multiple languages and faiths from a very young age became a formative aspect of her identity, as did her time in Lebanon."},{"@id":"urn:doxa:passage:5526a6e014921220a913d3c05d1eb8beb128dde21106415d6ccf361f32d08b0a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00005","start":0,"end":88,"exact":"She considered her age a “gift of the heavens” for the perspective that it offered her. "},{"@id":"urn:doxa:passage:719525f1caa453e6186194bf86d348ef4816107d65034a4f324fbeacbc05738e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00005","start":88,"end":259,"exact":"In her nineties, she claimed to have a unique perspective on the country of Lebanon, because she was born in 1925, so close to the founding of the Lebanese state in 1926. "},{"@id":"urn:doxa:passage:8ffc8dca2174f3dc9380f3c07232b67d98b6aaedf601ae2002f0b5d60f550c7c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00005","start":259,"end":466,"exact":"In an interview with Ricardo Karam in 2019, she said she considered herself a guardian of the memories of Lebanon, recalling growing up in a cosmopolitan Lebanon, witnessing the many periods of its history. "},{"@id":"urn:doxa:passage:c75549795c5e0e1a6cc1050ca17361a924f9e6894a014b16de4dc910e15162e8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00005","start":466,"end":673,"exact":"She described seeing the period of French rule, the World War, and the first generation of women who were able to swim, and who were able to work; she witnessed the liberation of the women of her generation."},{"@id":"urn:doxa:passage:10b10bd63bccdd7b50593080dc534308d646229616e0ea306a777bf72ec57d8d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00006","start":0,"end":115,"exact":"Actively engaged in the liberation of her generation, she was among the first Lebanese women to work in an office. "},{"@id":"urn:doxa:passage:f2bca92cebdfa3dc811384e599758897eac773c4148a89949a41775d60b37507","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00006","start":115,"end":208,"exact":"At 16 years old, she worked at a press office, where she described seeing the end of the war."},{"@id":"urn:doxa:passage:1b5f2d29532d9bde945a6d73f1a34740aad06d0d309a61de4f43d021c702304e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00007","start":0,"end":128,"exact":"Adnan painted liberty through her vibrant canvases, dabbing and spreading saturated colours of vitality with her palette knife. "},{"@id":"urn:doxa:passage:cf457d7d7e7e990031ef9d4c17c1bbc878af8dab2602c4f7c5568926503c4ca6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00007","start":128,"end":188,"exact":"She believed that liberty was a gift that had to be earned. "},{"@id":"urn:doxa:passage:ae6233965aa9061e0a6a42bb78dc9e8eddeb450523bcef8aa9b516a8c44d0b1d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00007","start":188,"end":233,"exact":"For her, love existed between two liberties. "},{"@id":"urn:doxa:passage:86cfd82173f4903fec4fa92a42baf53426fe41b60352dfa8ba1a7c8b553447e0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00007","start":233,"end":329,"exact":"Her ultimate liberty was her ability to maintain her childlike spirit and her ability to dream. "},{"@id":"urn:doxa:passage:e0970259bee436c70fb46e170b8967bba47e4973b47a1373a0a06fa53b01d547","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00007","start":329,"end":396,"exact":"In the same interview, she described her dreams for a better world:"},{"@id":"urn:doxa:passage:5f447d7c4887809cb388fc344d657b34859e2cc3a77accb818e2c73d00e89916","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00008","start":0,"end":181,"exact":"> My dreams are not for me, but for my environment, I dream of a Lebanon that is at peace with itself, a Lebanon at the level of the quality of the people that live in this country."},{"@id":"urn:doxa:passage:cb6ab218a4b3905e9c5973839064ff036e8f2f3cd7ff9517367d5244f96ed8dc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00009","start":0,"end":145,"exact":"Throughout her life and work Adnan felt a responsibility and affinity towards Lebanon and the Arab world, constructing her mountains around them."},{"@id":"urn:doxa:passage:ea0988cd54f360d7af1aa04be07e21c4802faad97be08c08ab43a2a61d248f61","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00010","start":0,"end":101,"exact":"Etel Adnan was educated in French schools in Beirut and studied philosophy at the Sorbonne in Paris. "},{"@id":"urn:doxa:passage:9e50b814b0a933ec6768a48b9254541b385f1c16d74920bfe5ac0b3622196416","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00010","start":101,"end":194,"exact":"She later moved to the US for postgraduate studies in philosophy at UC Berkeley and Harvard. "},{"@id":"urn:doxa:passage:386eb45c3f6d6de7ac07369ad8819e276a4e47af957b4a427e6eadaf1766c383","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00010","start":194,"end":284,"exact":"She taught philosophy and avidly wrote poems, essays, and plays, to wide critical acclaim."},{"@id":"urn:doxa:passage:a0061534d1c65980686d4965da20da1d087721ad4858e681596c68cce38c8e00","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00011","start":0,"end":163,"exact":"Adnan returned to Lebanon in 1972, where she worked as a cultural editor for two cultural journals, Al Safa and L’Orient le Jour, and met Simone Fattal in Beirut. "},{"@id":"urn:doxa:passage:5d963bb0f359017317a06f44e007fb9fc9c6994c9f201ab58a14fd3f0cb437e0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00011","start":163,"end":314,"exact":"With Fattal, she fled the civil war to Paris, where she wrote her award-winning novel “Sitt Marie-Rose,” which has become a classic of war literature. "},{"@id":"urn:doxa:passage:37afa21cc675538a4ce46988919a66f5968368d108ab3ee8f851fac713b35b16","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00011","start":314,"end":456,"exact":"Simone Fattal describes her writing as “incisive, fearless, and fierce,” also an apt description of her character and work across disciplines."},{"@id":"urn:doxa:passage:1282d763defca3f80ecf03d1da7717b9ddab09ee2ca2f61dd7ca290040755cae","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00012","start":0,"end":179,"exact":"In an interview with the San Francisco Museum of Modern Art (SF MoMA) in 2018, she described her first encounter with painting at the age of 20, when she went to study in France. "},{"@id":"urn:doxa:passage:6c3b4bef4fd37e494fe35672df7f33637b04f78c6f2173e52a0365a0e1a97e83","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00012","start":179,"end":302,"exact":"She went to the Louvre and described being so “innocent towards art” that it impressed her beyond what she could dream of. "},{"@id":"urn:doxa:passage:0dcd9d8a9eba9bdcafb061850e2ce86cebafb787a7c312d5eb3f8617ff013440","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00012","start":302,"end":377,"exact":"“I considered myself lucky not to have contact with art before,” she said. "},{"@id":"urn:doxa:passage:61bd72a905500a7ff731c7d0cda20bd8ce39c27c6ea321f47da5e67ee39f7501","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:11060d21b8953b263b2bafa1be781bad","blockId":"gv-751324-b00012","start":377,"end":403,"exact":"“It hit me full strength!”"},{"@id":"urn:doxa:decision:bba511a75c2e46f753f6e8fde5d43ef3","@type":["doxa:Decision","prov:Entity"],"recordId":"bba511a75c2e46f753f6e8fde5d43ef3","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:11060d21b8953b263b2bafa1be781bad:u_9ac0fc75f20d46da5159e4a0","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:c89ee6c63e77c9a47e34a39c7ad75aec103eca17d8046a877e930101aeacfa3b","urn:doxa:passage:9b1eb5149705c43e96ad7d9385243c114415113b736b531a012b641137d3a063","urn:doxa:passage:e21adff8b7444a2c281519145c9f8eb83a737c5f24ee0e735743f639c51b1cfe","urn:doxa:passage:10bbfe7b03b45683ca698986f009e26b3780598ebb9452aef848bf966d31bb17","urn:doxa:passage:56932b0cee089e8e928cb2840ca9e0ac9a8358f6af6d3e78b5b48d9675e991fc","urn:doxa:passage:09eca8b7a46dc20f9f6a932122550eb88afd0bf1fb197867b28e9a78d7659937","urn:doxa:passage:f3bef09ccf01b722e0d5d49954a0f2343beb967c4f99fd9f4cf8f115c7452f50","urn:doxa:passage:6d1db4428a4d7d38bf67671bae2b0608fb0eb4635f9fef526b555d4eddc2dc52","urn:doxa:passage:5526a6e014921220a913d3c05d1eb8beb128dde21106415d6ccf361f32d08b0a","urn:doxa:passage:719525f1caa453e6186194bf86d348ef4816107d65034a4f324fbeacbc05738e","urn:doxa:passage:8ffc8dca2174f3dc9380f3c07232b67d98b6aaedf601ae2002f0b5d60f550c7c","urn:doxa:passage:c75549795c5e0e1a6cc1050ca17361a924f9e6894a014b16de4dc910e15162e8","urn:doxa:passage:10b10bd63bccdd7b50593080dc534308d646229616e0ea306a777bf72ec57d8d","urn:doxa:passage:f2bca92cebdfa3dc811384e599758897eac773c4148a89949a41775d60b37507","urn:doxa:passage:1b5f2d29532d9bde945a6d73f1a34740aad06d0d309a61de4f43d021c702304e","urn:doxa:passage:cf457d7d7e7e990031ef9d4c17c1bbc878af8dab2602c4f7c5568926503c4ca6","urn:doxa:passage:ae6233965aa9061e0a6a42bb78dc9e8eddeb450523bcef8aa9b516a8c44d0b1d","urn:doxa:passage:86cfd82173f4903fec4fa92a42baf53426fe41b60352dfa8ba1a7c8b553447e0","urn:doxa:passage:e0970259bee436c70fb46e170b8967bba47e4973b47a1373a0a06fa53b01d547","urn:doxa:passage:5f447d7c4887809cb388fc344d657b34859e2cc3a77accb818e2c73d00e89916","urn:doxa:passage:cb6ab218a4b3905e9c5973839064ff036e8f2f3cd7ff9517367d5244f96ed8dc","urn:doxa:passage:ea0988cd54f360d7af1aa04be07e21c4802faad97be08c08ab43a2a61d248f61","urn:doxa:passage:9e50b814b0a933ec6768a48b9254541b385f1c16d74920bfe5ac0b3622196416","urn:doxa:passage:386eb45c3f6d6de7ac07369ad8819e276a4e47af957b4a427e6eadaf1766c383","urn:doxa:passage:a0061534d1c65980686d4965da20da1d087721ad4858e681596c68cce38c8e00","urn:doxa:passage:5d963bb0f359017317a06f44e007fb9fc9c6994c9f201ab58a14fd3f0cb437e0","urn:doxa:passage:37afa21cc675538a4ce46988919a66f5968368d108ab3ee8f851fac713b35b16","urn:doxa:passage:1282d763defca3f80ecf03d1da7717b9ddab09ee2ca2f61dd7ca290040755cae","urn:doxa:passage:6c3b4bef4fd37e494fe35672df7f33637b04f78c6f2173e52a0365a0e1a97e83","urn:doxa:passage:0dcd9d8a9eba9bdcafb061850e2ce86cebafb787a7c312d5eb3f8617ff013440","urn:doxa:passage:61bd72a905500a7ff731c7d0cda20bd8ce39c27c6ea321f47da5e67ee39f7501"]},{"@id":"urn:doxa:decision:f74a8b95377d3610009362f04625a190","@type":["doxa:Decision","prov:Entity"],"recordId":"f74a8b95377d3610009362f04625a190","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:11060d21b8953b263b2bafa1be781bad:u_9ac0fc75f20d46da5159e4a0","attribution":"unknown","speaker":"Unknown","speakerStance":"not_appli