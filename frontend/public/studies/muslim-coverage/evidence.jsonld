f66d6cac3b5852e56dd325dd886153018f8e79ac99bebc0e118a78c6ccd02","urn:doxa:passage:f184d2dbfeb8e96056314cac537d26105dc5d31cd3ce489322c9e6c96b8ef1e7","urn:doxa:passage:db1f5e316c6148f8364735869023c2bb1af51aa9b0aa354b2fce82c946cf924d","urn:doxa:passage:0ff1d4bf1be55b644a93552ec6017f49b44ed6bd9a96eb545bfb0d8bdeab67e9","urn:doxa:passage:7bad054a5d449f949313bbbadf1c428757ca02bda61fba57b2e76e4f02cee93b","urn:doxa:passage:3029a6b3122b67fdee248d91fe0e6724b68d51ce301c6992a22e9f287f3e112d","urn:doxa:passage:2cc1e27b10d400217cdb14c274707fea9cd0b8f686af5b85471d59a824fe52b8","urn:doxa:passage:0d1c0f04b9f5acfacc2fc29430677be16e61b2ed2a15c7de9a4a3b628c5e5b19","urn:doxa:passage:61427a77a026969cd5c76de8ea282e4c4bda43e70eb9b94cdb55534d36707e1d"]},{"@id":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-763265","title":"Covering the economic crisis in Sri Lanka: The cost of pursuing journalism","author":"Raisa Wickrematunge","translator":[],"publishedOn":"2022-05-17","sourceUrl":"https://globalvoices.org/2022/05/17/covering-the-economic-crisis-in-sri-lanka-the-cost-of-pursuing-journalism/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"ea826eb7ff69d85e5e665a93383731cb49e2c54e38c596a6cb66ba7a82a0dffb","textSha256":"5899cd57166a5ca7503628f66f133a8ce85f989bfa7e69f1813fe296861a3f54","archivedRecordSha256":"9653c27a6bb28b9657ce608aa6aec92cfa801d0542d1f92ba496b0c96c8133f5","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:7b5a99a6f76cc2bd125bc93b8fab55bb:u_d8d30502d014d987c3b2a84c","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_d8d30502d014d987c3b2a84c","status":"accepted","fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb"},{"@id":"urn:doxa:unit:7b5a99a6f76cc2bd125bc93b8fab55bb:u_fee10bc98d610b744d7b1537","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_fee10bc98d610b744d7b1537","status":"accepted","fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb"},{"@id":"urn:doxa:passage:9cfec96d683cb6cfc376083196d62da8a490910595029a7e98f1f9a82668c5e8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00001","start":0,"end":37,"exact":"May 3 marks World Press Freedom Day. "},{"@id":"urn:doxa:passage:e1c220da6682ab3d26b86d62e8c99106a5146454c05807ff4af527caabef4eb0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00001","start":37,"end":208,"exact":"In Sri Lanka, the day dawned as the country continued to struggle with an economic crisis caused by years of mismanagement and bad policies, and escalating debt payments. "},{"@id":"urn:doxa:passage:7c5c7df71100ee790e53a033ac76e72129c719aae5ea397a36d61dc4b524f512","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00001","start":208,"end":254,"exact":"This has already begun to impact media houses."},{"@id":"urn:doxa:passage:49a57c8e343d11bc2ba3b803bcdbffd844a5dfcc7a8aff59fc32d965350114f4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00002","start":0,"end":196,"exact":"At least one publisher — Upali Newspapers Ltd — was forced to suspend the Saturday print editions of the English newspaper The Islander and the Sinhalese Divaina, because of a newsprint shortage. "},{"@id":"urn:doxa:passage:d6da69be4d623f78eab9852e409041e7ced3a96e4fb9322e49b61a3e71950b5d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00002","start":196,"end":228,"exact":"Others may have to follow suit. "},{"@id":"urn:doxa:passage:c3772b4a1f8d164456d63bfc776a5db180cfbbae54cb741acd2b78efe18d387d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00002","start":228,"end":424,"exact":"The chief operating officer of Liberty Publishers said that newsprint had already doubled in cost, from around USD 600–700 per metric tonne in 2021 to USD 1,200 per metric tonne as of March 2022. "},{"@id":"urn:doxa:passage:467ff260389b15e4fd106f5c40dbd65055578c790912b97d2373805dffac79f2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00002","start":424,"end":617,"exact":"While Liberty hasn’t yet reduced the frequency of its three editions — the English language Morning daily, the Sinhala language Aruna and Tamil language Thamilan — it’s looking at streamlining."},{"@id":"urn:doxa:passage:b7b1f61f843fe2d093f25febbccfe623bc856cd544ba243ac4c92b9e7fe0b4d6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00003","start":0,"end":153,"exact":"Apart from rising costs, journalists covering the economic crisis and growing public protests around it have to prepare for the possibility of violence. "},{"@id":"urn:doxa:passage:0e6aec8e4ec5fdc07afbf2debb71e89f0f0889af892ea84d1a48d040cc390c84","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00003","start":153,"end":252,"exact":"On May 6, journalists were impacted by tear gas fired at a protest outside Sri Lanka's Parliament. "},{"@id":"urn:doxa:passage:5ab7b9960f7e89a97824bd427215e4b4599966f273bb4dd95a40019e34746ac9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00003","start":252,"end":467,"exact":"Three days later on May 9, supporters of the Sri Lanka Podujana Peramuna party attacked peaceful protesters at Galle Face Green, with the police initially standing by and eventually using tear gas and water cannons."},{"@id":"urn:doxa:passage:c4d40698e7d97b98a4645282bf2bac9b89f9fb70bcf47f27f847c77c30afb8f3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00004","start":0,"end":120,"exact":"The same day, journalists were also caught up in tension outside Temple Trees, the official Prime Minister’s residence. "},{"@id":"urn:doxa:passage:86c1dfdfaa9b10e910156625fe5ab0a93d635c893f707f43931879986cd01a5e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00004","start":120,"end":312,"exact":"On March 31, at least nine journalists were injured and six detained under Section 120 of the penal code while covering a protest outside President Gotabaya Rajapaksa’s residence in Mirihana. "},{"@id":"urn:doxa:passage:75f36ac1bb2cdf754cbaea84a82d0566bc51529b88d9a7a79c632fcd5c69b9e5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00004","start":312,"end":412,"exact":"One was reportedly denied medical assistance at the police station, while cameras were also damaged."},{"@id":"urn:doxa:passage:62c009531f954ef7968be32aae1d02cfe07206180c091c532896f3a3bef7f99b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00005","start":0,"end":243,"exact":"Daily Mirror photographer Waruna Wanniarachchi, who was at Mirihana that day, said police personnel from Sri Lanka’s special task force hit him on the head with a baton when they emerged from the president’s house after a bus was set on fire. "},{"@id":"urn:doxa:passage:35b7a605f3863f0533960e13edc295b8239f903d966fea453c2800a51c8e32f5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00005","start":243,"end":414,"exact":"The next day, he was visited by officers from the Criminal Investigations Department who asked him to hand over his camera’s memory card to help them identify protesters. "},{"@id":"urn:doxa:passage:a06a163947082162d2f0734b76f426ae21a3b447a04112532744a5a80a162f00","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00005","start":414,"end":553,"exact":"Wanniarachchi asked them to make an official request to his workplace, instead, as he had already handed over his equipment to his office. "},{"@id":"urn:doxa:passage:4b79f68376766c6d49c9173dac59de5a508e4a7f9e8ffbab570f5b7a427c3b20","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00005","start":553,"end":787,"exact":"Another journalist, Tharindu Jayawardhana, the founder of Sinhala language news site MediaLK, said he received verbal threats from the president’s media division staff stationed outside Rajapaksa’s house, demanding he stop reporting. "},{"@id":"urn:doxa:passage:10466259dbd1cd40f618ec57e428f5a9785f51bfabc5f9acfaf0b1ddf8c3ae7a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00005","start":787,"end":856,"exact":"Jayawardhana later filed a complaint at the Mirihana police station. "},{"@id":"urn:doxa:passage:1f97a21625afa221873d7d38cb7e189fb3ea2cc85258347b95fe9651982dfe9e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00005","start":856,"end":1018,"exact":"The police chief ordered an investigation into at least one private TV channel, NewsFirst, on April 1, in an effort to blame the unrest on the channel's coverage."},{"@id":"urn:doxa:passage:f5032e9c65cd9cc4eaa3aa33df72a48552ca6ea28ecf755f321945d1487c4bd3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00006","start":0,"end":134,"exact":"Many journalists in Sri Lanka learn safety practices on the go, as there is often a lack of resources for safety training programmes. "},{"@id":"urn:doxa:passage:aeab06b80655105850000394b45aeb8c105e701d8a487e200522eae277c82817","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00006","start":134,"end":176,"exact":"Instead, senior journalists pass on tips. "},{"@id":"urn:doxa:passage:5c38a1d542b9c7c829a332fd2ee96c1787d2e801a88f7f3955b4dbfb28c6dccd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00006","start":176,"end":354,"exact":"Equipment like gas masks and helmets for journalists going into volatile situations is in short supply, according to the founder of news website Colombo Gazette, Easwaran Rutnam."},{"@id":"urn:doxa:passage:06df753fad66742d5791dba3a262efa3e1019040e20455cac20d6b7b3ceb7a47","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00007","start":0,"end":40,"exact":"The normalisation of social media blocks"},{"@id":"urn:doxa:passage:d10530f6b321765c68b75d666ae15095f970a9174a87961dd5deef98b7af9318","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00008","start":0,"end":155,"exact":"Safety threats aside, journalists in Sri Lanka also have to adapt quickly to modes of communication being cut off, or being unable to report on the ground."},{"@id":"urn:doxa:passage:7cd35efaa5f43fb95c783487b10710297886cdcf575da1596f0d4288db34f295","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00009","start":0,"end":294,"exact":"Just after midnight on April 3, the Telecommunications Regulatory Commission ordered mobile service providers to block several social media platforms — including Facebook, Twitter, WhatsApp, YouTube, TikTok, Telegram and Instagram — ahead of large protests planned against the economic crisis. "},{"@id":"urn:doxa:passage:277eb1c545ef87f39b20d7d5b7a11458d2b871b3bf69dfcb836f1f843d6f9826","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00009","start":294,"end":396,"exact":"The block, which lasted 15 hours, followed a curfew and a state of emergency imposed over the weekend."},{"@id":"urn:doxa:passage:a164bb3950f8a58eb9763fe3cca87b94d33732a94260df8611d5ec7106559fd4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00010","start":0,"end":82,"exact":"Social media is a vital tool for disseminating information and news in Sri Lanka. "},{"@id":"urn:doxa:passage:a56cc86c74a021d27e27ec5f482829d8739d7fa68034cb1594369ca9b29a0f0c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00010","start":82,"end":219,"exact":"Citizens have used social media to share their views on the economic crisis, using the hashtags #EconomicCrisisLK and #GoHomeRajapaksas. "},{"@id":"urn:doxa:decision:39e08d98d5123d2e9bf538ac836c5b62","@type":["doxa:Decision","prov:Entity"],"recordId":"39e08d98d5123d2e9bf538ac836c5b62","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:7b5a99a6f76cc2bd125bc93b8fab55bb:u_d8d30502d014d987c3b2a84c","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:9cfec96d683cb6cfc376083196d62da8a490910595029a7e98f1f9a82668c5e8","urn:doxa:passage:e1c220da6682ab3d26b86d62e8c99106a5146454c05807ff4af527caabef4eb0","urn:doxa:passage:7c5c7df71100ee790e53a033ac76e