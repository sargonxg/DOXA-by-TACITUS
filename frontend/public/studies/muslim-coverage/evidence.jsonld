9dacad915956597a04bd32555fbf268100d00fd389fc","urn:doxa:passage:1c80d0aced09bd6dcdb98dc73ba9b1b0ce522b623b213bbe5dfc9c3dd71a4f77","urn:doxa:passage:7b3dfb178cfea4d9be134e73290a8a27fef76288883f48624729bdb06f9e9e77","urn:doxa:passage:6eba0b0bc9555d5b9304fa36d4f4596711fcd23360d1d4899cb5454a04e9dc2d","urn:doxa:passage:681375adf6e1bf96f7e95e33c35c2fcb9f610734b0c6b6ec9295bbe3fe196cf6","urn:doxa:passage:1aeae67189b7c200a1641fd66234cbef533d0a3d12cb000c9169242429b8a39e","urn:doxa:passage:37af2759e9ab4368abbae815147e325f7a7166bf138e5483b9397a3aedb23ee6","urn:doxa:passage:9edc741a1509a34cbc6935a47e66390edd7bfc7b73b8edf928231d2bf29a76a6"]},{"@id":"urn:doxa:decision:295716b3e3f57f2554a5f975d70442e6","@type":["doxa:Decision","prov:Entity"],"recordId":"295716b3e3f57f2554a5f975d70442e6","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:80c5cac76de53b70b4f99ff6e5a1adad:u_5ad64440b98dafe4b8d1013f","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:e4f1a4d5e8057ddbcee7530979c266de1cf0105307f0627c5e5982f8498454c2","urn:doxa:passage:276672dc7d487eaa8b03bc92cef97daa8fc670f7a8f7603549a5841ca927e2d6","urn:doxa:passage:26944238b6d0e640ed29a53d5b67132a5fd47ef3f425a67ddb301e2a883b1afd","urn:doxa:passage:721208d50bf7046e7c88543b93add9433a5ce9b743ef439bbc107f09490ca644","urn:doxa:passage:5fc0f941f2b737f272cb03575d81d60989b667a156d7235d53772014071069a0","urn:doxa:passage:66afa75c02c340f0bed53ec9d4212e5cd0afa501d8b7ea39e8bbfffc73cf5a50","urn:doxa:passage:087a28492e9024ac230e55f7a4c06f95197ba0b8b34a5089187c3196fea1f9e6","urn:doxa:passage:e48d9b296a64428aa0d94f7baae26aeadf46a99fdc92c1e64d8953de69e43689","urn:doxa:passage:a514140fc0f240c49da8ca0014f22f613cb9c4da4b275336e83c0266fdbecbf2","urn:doxa:passage:c15772b836a301cd77597ee0649552ee49e1be171a815f09e18dda936c4d669b","urn:doxa:passage:ad77b2f0747c900e5b6d498111260b75dbc1e4a1e66fdce88c8260e203c933f8","urn:doxa:passage:affc4ff61767b6f970b64cac92df774c988a7640a7a11075036d820ba6f21468","urn:doxa:passage:1ddcef93070bd585b47d3e56253313018750edd7c9ec3be8027e5174ff8b2298","urn:doxa:passage:fbe6344df4c06f59b6a52779edf8f82d52f23f67b1dc73eea2fa218c51711e04","urn:doxa:passage:cf29626fc666d3fbc7bf71d65503b66ec75364eb4240ce0632fad331de659295","urn:doxa:passage:00b3648b00cba5e657169dacad915956597a04bd32555fbf268100d00fd389fc","urn:doxa:passage:1c80d0aced09bd6dcdb98dc73ba9b1b0ce522b623b213bbe5dfc9c3dd71a4f77","urn:doxa:passage:7b3dfb178cfea4d9be134e73290a8a27fef76288883f48624729bdb06f9e9e77","urn:doxa:passage:6eba0b0bc9555d5b9304fa36d4f4596711fcd23360d1d4899cb5454a04e9dc2d","urn:doxa:passage:681375adf6e1bf96f7e95e33c35c2fcb9f610734b0c6b6ec9295bbe3fe196cf6","urn:doxa:passage:1aeae67189b7c200a1641fd66234cbef533d0a3d12cb000c9169242429b8a39e","urn:doxa:passage:37af2759e9ab4368abbae815147e325f7a7166bf138e5483b9397a3aedb23ee6","urn:doxa:passage:9edc741a1509a34cbc6935a47e66390edd7bfc7b73b8edf928231d2bf29a76a6"]},{"@id":"urn:doxa:passage:b23440448fd9976d04a2d28ba090b148312f1e0846d27cb6ae26e94532741063","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00001","start":0,"end":252,"exact":"Over the last 45 years, the Islamic Republic of Iran has weaponized textbooks, religious debates, movies and series, city walls, and even cemeteries to impose cultural violence and institutionalize its dominance, particularly over religious minorities."},{"@id":"urn:doxa:passage:95237c52ba28e6becaf48ec6cd9285d41696176ef0194496ec317152c0ee79ab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00002","start":0,"end":102,"exact":"The government has employed physical, structural, and cultural violence against religious minorities. "},{"@id":"urn:doxa:passage:8db223de0a7f4e6fa6ffe977b3bfabeb316421583def7939a2d9b28023323198","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00002","start":102,"end":401,"exact":"While physical violence (prison, destruction of worship places, execution, confiscation of properties), and structural or legal violence (discrimination in the labor market and education, testimony in court) are often tangible, cultural violence (art, religious debates, education) is more nuanced. "},{"@id":"urn:doxa:passage:bf102f80956c1ef2432bc16d26a1b3b1560331c148d2f855b83b07ac75cc0033","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00002","start":401,"end":545,"exact":"Cultural violence not only facilitates direct (physical) and structural violence but also legitimizes violence, making it acceptable in society."},{"@id":"urn:doxa:passage:e085f4087195299d4538fd04c3c99cd6498dc6c71960601928bb27c0730c81b2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00003","start":0,"end":323,"exact":"The mention of discrimination or persecution brings to mind those officially recognized in the constitution — Jews, Zoroastrians, and Christians, with converts excluded — and the minorities who are not recognized in the constitution, including Baha'is, Christian converts, Mandaeans, and followers of the Yarasan religion. "},{"@id":"urn:doxa:passage:41928f4555c5360bec7d35d97d12bcfc0087db316ff2d6ea5f225b45dd11ee50","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00003","start":323,"end":559,"exact":"Iran goes to the extent of turning them into “ghosts,” a discriminatory policy that goes further, affecting a diverse array of believers, including Sunnis, and dervishes — who are Twelver Shiites, which is the official religion of Iran."},{"@id":"urn:doxa:passage:709edfcab96c97e30218ba37d64599c81775a56df1183107fd2a1d3b2f4ded81","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00004","start":0,"end":78,"exact":"Cultural violence transcends religious minorities, affecting broader society. "},{"@id":"urn:doxa:passage:12e5a9f28da865af47de36633f0aa32055afd4870c73b2e679405c2a944f54a3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00004","start":78,"end":164,"exact":"Many Iranians face multiple layers of discrimination due to their complex identities. "},{"@id":"urn:doxa:passage:8f1999c56afe46b0a7ff9fb22c79b8e9cb0396459d49275c13190cd6acef2114","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00004","start":164,"end":323,"exact":"For instance, a Baloch woman experiences triple discrimination based on her gender, ethnicity, and religion, demonstrating the intersectionality of oppression."},{"@id":"urn:doxa:passage:e6b38be86459122c672ca3c4e915016dada9508d0f63fb43c5d1c9b483839724","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00005","start":0,"end":21,"exact":"‘Class’ of oppression"},{"@id":"urn:doxa:passage:9c2efc7dfaa29e6e29cb23fad0deb7c959e1bb56e1a7f9cb6b009d4bd5c3ed69","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00006","start":0,"end":181,"exact":"Iran's education system oppresses religious minorities, from directly threatening children belonging to these communities to embedding the ideology of Shiite supremacy in textbooks."},{"@id":"urn:doxa:passage:d08dd66109cb5126844adcf6ea9b9c71c0854d61e9c035c4aac41e0b0a03d5cf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00007","start":0,"end":65,"exact":"Saeed Payvandi, a sociology professor in Paris, comments on this:"},{"@id":"urn:doxa:passage:c8abfa90256134a817ca3b1c6dc7c2059349d142a5407c2b436cb321240b62f3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00008","start":0,"end":235,"exact":"> During the Islamic Republic, all societal cultural institutions, especially the education system, propagate the belief that Islam is the ultimate heavenly religion with solutions for all societal problems among the young generation. "},{"@id":"urn:doxa:passage:2c07d14e4ef10a04003b6b4d33bc88778cab8d08f5aad3c8ca4b511846b1c039","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00008","start":235,"end":496,"exact":"This results in strong Islamic-Shiite propaganda not only in religious subjects but across various disciplines, constituting a form of direct cultural or even symbolic violence against religious minorities and those dissenting from government-style religiosity."},{"@id":"urn:doxa:passage:d19f877e71389f55cef49dc5d90396f0c7596a7860d68846e2fa1d027ac64e7d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00009","start":0,"end":201,"exact":"Many minorities, including Baha'is, Yarasanis, and Christian converts, are denied the right to learn their religious subjects in schools and are compelled to attend Islamic religious education classes."},{"@id":"urn:doxa:passage:a23fb905ddc3d25619c7472489f1ab152a423a568f585ae4dbedc9d0b6e67612","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00010","start":0,"end":184,"exact":"According to Payvandi, “This educational system imposes constant humiliation and suffering on segments of the young generation, extending beyond schools to poison the soul of society.”"},{"@id":"urn:doxa:passage:b6010f0473927d23f916459ee9b61253ca29aaa69932c6cd8109a57a491414db","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00011","start":0,"end":162,"exact":"Besides the educational system, state-funded groups continuously target “non-recognized” religious minorities with so-called “historic” research books and sites. "},{"@id":"urn:doxa:passage:f27a539160f8e419fd28793602eed0e4642acd59341e3a10d39f2fb6c4d2ed7b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00011","start":162,"end":245,"exact":"And the targeted groups have no right to discuss and reply against such propaganda."},{"@id":"urn:doxa:passage:a2c71897d02aa8b1c2f28f01acd2f769504b55d1df142a0d3990ab05934c730d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00012","start":0,"end":23,"exact":"Dehumanizing minorities"},{"@id":"urn:doxa:passage:167d979b99ec4ca8fbc55ce196207860e1139db17e21dcbcfceb8477f68d6d53","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00013","start":0,"end":365,"exact":"In addition to the dominance of the Islamic perspective in education and books, religious or news sites periodically publish question-and-answer sessions with ayatollahs focusing on “religious minorities.” During these sessions, clerics are asked whether Muslims should consider religious minorities “najis” (impure), normalizing the dehumanization of these groups."},{"@id":"urn:doxa:passage:6189ff35c418f1bb92799a9377f986cc2329eb92c66144adb443dff9316b011c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00014","start":0,"end":62,"exact":"The impact of this dehumanization is evident in various ways. "},{"@id":"urn:doxa:passage:0c57b39f3772eb7321729c130af001ba471194e91fed9f4c85c56703bd82fd87","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00014","start":62,"end":158,"exact":"Many Christian converts report that, when interrogated, their interrogators labeled them najis. "},{"@id":"urn:doxa:passage:9d14bb3a34145dc8c80004473c4cecf147bdc712b3fb3ba7ae3c8198832e75ba","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00014","start":158,"end":319,"exact":"The regime has, at times, established unexpected lines of demarcation, such as ordering Baha'i villagers to separate their cows from those belonging to Muslims. "},{"@id":"urn:doxa:passage:d4d73e687b84ff6f0049b3dd0e4e942814b4c6559ace0bca697a4a96b178164b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00014","start":319,"end":464,"exact":"The authorities, after increasing such pressure on Baha'i villagers, have confiscated their property and forced them out of their ancestral land."},{"@id":"urn:doxa:decision:3249ffae20fcf93212529ebe2ed2ccea","@type":["doxa:Decision","prov:Entity"],"recordId":"3249ffae20fcf93212529ebe2ed2ccea","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:80c5cac76de53b70b4f99ff6e5a1adad:u_a9afd9f419ecbd6337e6d038","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:b23440448fd