xa:passage:221d9291261e9173ec63066de52fae8365c26e593cb72e5809b0ad0a6caa0d88","urn:doxa:passage:f935af58b15a7d48891caf167d5b59a0af4ede264f36d5669007c5cc6cdb12f3","urn:doxa:passage:018b988171fe6cce5d17767a8acc550811a635497aa7c98002fa7969d74b4bbd","urn:doxa:passage:26ca419e1d1cf1b40781ee86b140a63c43e29a610157ce4b98ef191942687000","urn:doxa:passage:02f09216c0cbf166b70cf10dfaa27176806f0960d293d4833ece6964fc7db4a7","urn:doxa:passage:9fda261e18e65b97e7c3b9ad185e70a0cb9955039d55490b4071eccbad0f6396","urn:doxa:passage:2e6d88f68304a709bd039f0487ce2025efe23248b6b275345b15283df6841996","urn:doxa:passage:e1df0e0644443a26594ee265b61db79476e1752f2d66ab774d68e0ff8b65a2ec"]},{"@id":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-810600","title":"How China is trying to turn Xinjiang from concentration camp into tourist paradise","author":"Global Voices East Asia","translator":[],"publishedOn":"2024-04-18","sourceUrl":"https://globalvoices.org/2024/04/18/how-china-is-trying-to-turn-xinjiang-from-concentration-camp-into-tourist-paradise/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"0c4b6bfc54e3a122724f7e6a2c53f7b96bdeb6249f8cca2463a568d0c99c1e61","textSha256":"6ee95e71e70a46b7ff1c7f3d9dfdd8d32953339f77e3c26318dfca01ccfd8e3c","archivedRecordSha256":"5d0b2986fe99f4cdde7f66e5c555afb59d49e16c69aa0a3305030fcc7c4d0681","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:db00aad5283dda7c39b76257f3ff0143:u_2d7c50d9074e16c64932e941","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_2d7c50d9074e16c64932e941","status":"accepted","fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143"},{"@id":"urn:doxa:unit:db00aad5283dda7c39b76257f3ff0143:u_31b75094945d5b150e08d5d3","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_31b75094945d5b150e08d5d3","status":"accepted","fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143"},{"@id":"urn:doxa:unit:db00aad5283dda7c39b76257f3ff0143:u_fb3662ae361442ebb06d748e","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_fb3662ae361442ebb06d748e","status":"accepted","fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143"},{"@id":"urn:doxa:passage:098ddc5c2f0951052cdeb973618bddb7507ed94014f417db96ca6f316d036eff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00011","start":286,"end":405,"exact":"Three police officers armed with a shield, a baton with a bayonet, and a slingshot with a stun gun walked the streets. "},{"@id":"urn:doxa:passage:935bb0c4dd7bea02317388d6cff7d948539369eebf9ae2ee784e8cf6129f1798","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00011","start":405,"end":469,"exact":"They stopped young men and checked the contents of their phones."},{"@id":"urn:doxa:passage:07d3a336967f2d6de92793572cd64aaf07a7e6bad8357f55cce350e48debb8f8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00012","start":0,"end":68,"exact":"> When entering cities there were checkpoints with document checks. "},{"@id":"urn:doxa:passage:cf606beeb1254ae20950369a1f80086bf8c44a55b82cfd1d44fa9f4fd4d5f161","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00012","start":68,"end":165,"exact":"If there was a problem with you, you may not be allowed out of your city or allowed into another."},{"@id":"urn:doxa:passage:e66a6dc81eeab8eb0ba75d89cda0b108ecf5ea6199ebdb6daa70c9f0c4a1fbba","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00013","start":0,"end":181,"exact":"> What was also surprising compared to the photographs of 10 years ago was that all the young and middle-aged men were clean-shaven and the women were without religious headscarves."},{"@id":"urn:doxa:passage:7fc711aa28c396feebbf49ae7e57a53bb7f0731e84c5dc80a922c1d0d10f5044","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00014","start":0,"end":61,"exact":"GV: How much has the region changed in the last three years? "},{"@id":"urn:doxa:passage:79348e7b8f64adeb5c57a36d73bfb64ffc40a2d5f93c27a02ce7c81704d28d43","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00014","start":61,"end":119,"exact":"What differences did you notice during your visit in 2023?"},{"@id":"urn:doxa:passage:dc8ce0b0c94ae4dc9df9e70bf62ae6a227c66b23a10061c1ee3d46b78112a862","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00015","start":0,"end":324,"exact":"> ИП: К моему великому удивлению, ничего этого в 2023 г. уже не было. Исчезли блокпосты между городами, сканеры лиц в парках и рынках, пункты досмотра. Я спокойно проехал на такси в Опал к могиле знаменитого филолога XI в. Махмуда Кашгари, к которой в 2019 г. меня просто не пустили на блокпосту, сказав, что дорога закрыта."},{"@id":"urn:doxa:passage:919767d95d0afc7ba6d1c52a91ba134bbb44699c3cc153e596cda116cb51df38","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00016","start":0,"end":360,"exact":"> Посетил город Яркенд, а в 2019-м меня в нем даже не выпустили с железнодорожного вокзала. В Яркенде, правда, чувствовался надзор – при выходе из поезда меня зарегистрировали полицейские и спросили, с какой целью я приехал, а в самом городе за мной по пятам ходил какой-то человек в штатском, но все-таки мне удалось попасть там во все те места, куда я хотел."},{"@id":"urn:doxa:passage:4df5f365d9cc2d89e7cee9532359e1103d9671c7aee389aa440abd2109bf60da","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00017","start":0,"end":226,"exact":"> Другое отличие – в 2019-м многие таксисты и владельцы общепита не говорили по-китайски. В 2023-м все они уже свободно изъяснялись на путунхуа. Я даже видел детей, которые друг с другом говорили не по-уйгурски, а на путунхуа."},{"@id":"urn:doxa:passage:99f3e01b26df97c4fc3acc1a0e36fa64af1dd56df9180b9412ec6e41ec70d15f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00018","start":0,"end":208,"exact":"> В целом, видимо, ускоренная и усиленная программа ассимиляции сработала, и власти ослабили узду. Но справедливости ради надо отметить, что эти языковые меры касаются не только уйгуров, а всех малых народов."},{"@id":"urn:doxa:passage:74e2589206cb1702beaf1f1f2d45010e8ec58f5e295b638a0903ff2f15bb59f2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00019","start":0,"end":388,"exact":"> По всей стране в последние годы школьное образование ведется только на официальном государственном языке путунхуа, а не на языках национальных меньшинств. Жители четырех автономных районов Китая – монголы, уйгуры, чжуаны и тибетцы – обучаются не на своих языках, а на путунхуа. Так что дальнейшее существование разнообразных языков и основанных на них национальных культур под вопросом."},{"@id":"urn:doxa:passage:0e40682bc90b4270db62b8201b18be1d08efda5a600dca79e615bf7c7e9d75d8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00020","start":0,"end":72,"exact":"> IP: To my great surprise, in 2023, I saw none of the stuff from 2019. "},{"@id":"urn:doxa:passage:b6269b0437d2aaf7248bd68c41645782dcd3b5ffd469d67df088c763e61f7470","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00020","start":72,"end":178,"exact":"Checkpoints between cities, face scanners in parks and markets, and security checkpoints had disappeared. "},{"@id":"urn:doxa:passage:7002c5d0ba97fd08343defa36a254f26b1aad5005d25544cb2f10e5bc829a5a2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00020","start":178,"end":305,"exact":"I calmly took a taxi to the town of Upal to visit the grave of the famous philologist of the 11th century, Mahmud al-Kashgari. "},{"@id":"urn:doxa:passage:5a3397322cff300b6096059062caa01453fb2d7095e3947d170ed8821c528ebe","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00020","start":305,"end":406,"exact":"In 2019, the authorities simply did not let me in at the checkpoint, saying that the road was closed."},{"@id":"urn:doxa:passage:82e4b22833e9a6c6174e64cb55f8b2b55b4d0efbb44f9e499feb9b2488415895","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00021","start":0,"end":98,"exact":"> I visited the city of Yarkant, and in 2019, they didn’t even let me out of the railway station. "},{"@id":"urn:doxa:passage:456c276ed27f76fabeec97b0da055c810a79d6b0d16587f03ec1851fa8374c26","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00021","start":98,"end":156,"exact":"In Yarkant, however, there was a feeling of surveillance. "},{"@id":"urn:doxa:passage:c321023182d3eafbc01cde84f563265d4179c18fcd6552e4e0e04d31b9c42bae","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00021","start":156,"end":375,"exact":"When leaving the train, the police registered me and asked for what purpose I had come, and in the city itself, a man in civilian clothes followed at my heels, but I still managed to get into every place I wanted to go."},{"@id":"urn:doxa:passage:2a06a61a68dda28244e760868c715b8496e394322c23a8c73810858cca2d5a35","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00022","start":0,"end":99,"exact":"> Another difference is that in 2019, many taxi drivers and catering owners did not speak Chinese. "},{"@id":"urn:doxa:passage:23fcdb88f5a08103a71b7d0ff34b4a48510a5ab00bbaf4f3b84bfabd2ea874da","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00022","start":99,"end":153,"exact":"In 2023, all of them were already fluent in Mandarin. "},{"@id":"urn:doxa:passage:5bea37f0c4fa19b8b2253886100e62ca74195004beb68c6684bf794ce39160da","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00022","start":153,"end":227,"exact":"I even saw children who spoke to each other not in Uyghur but in Mandarin."},{"@id":"urn:doxa:passage:2a266d1fc1ac9dc4fe6eb1f89bcb903da4b9555edb79900c8be109f7bde7ab68","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00023","start":0,"end":141,"exact":"> Overall, the accelerated and intensified assimilation program appears to have worked, and the authorities seem to have loosened the reins. "},{"@id":"urn:doxa:passage:369b2315195ae49658f9c40639ee6ff3187ff80b47700ab74fd58edd6dc80935","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00023","start":141,"end":273,"exact":"In fairness, it should be noted that these language measures apply not only to the Uyghurs, but to all national minorities in China."},{"@id":"urn:doxa:passage:debdaf9bb3eef2ed20044a25858af189848389ccc851683e3b02d76f73e38e60","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00024","start":0,"end":175,"exact":"> Throughout the country, in recent years, school education has been conducted only in the official state language, Mandarin, and not in the languages of national minorities. "},{"@id":"urn:doxa:passage:8992b29efeb885e384bfd3637c6fece8672139fc99a978e6ef9e680f55358d15","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00024","start":175,"end":293,"exact":"Residents of the four autonomous regions of China — Mongols, Uyghurs, Zhuangs, and Tibetans — are taught in Mandarin. "},{"@id":"urn:doxa:passage:66465f6f5d82312fc4ab2e51db65bff8f5d9fa706814de48054739fbfeae3d5f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00024","start":293,"end":393,"exact":"So the continued existence of various languages and national cultures based on them is questionable."},{"@id":"urn:doxa:passage:0d67954eb98bd86f9a644250669e39015c529a489f161195d20c4ada293d13e8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00025","start":0,"end":56,"exact":"GV: To what do you attribute these changes in Xinjiang? "},{"@id":"urn:doxa:passage:8b4b68d49cec614526178637298ab44a5e34e8c03ff79dc57da11a638467e163","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00025","start":56,"end":105,"exact":"Have the Chinese authorities achieved their goal?"},{"@id":"urn:doxa:decision:a2d6f2f0ed8b984fd8d26d609bedce4b","@type":["doxa:Decision","prov:Entity"],"recordId":"a2d6f2f0ed8b984fd8d26d609bedce4b","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:db00aad5283dda7c39b76257