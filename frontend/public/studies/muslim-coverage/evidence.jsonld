260782f5fde7ec0841c4742839bd2c022c0cad269d5d4","urn:doxa:passage:6ae612a24bf7943c6644a88fcbc509339e239cad96b7b28920503fb20b365218","urn:doxa:passage:402e991f3d1d6695dec6725f2ee3f5511ed1fba1bdb90c5669c537d95f17073c","urn:doxa:passage:6bbf0389e130e2af6818c7a0a5f23ce87fe3249724fe935c3823d35335ee5a48","urn:doxa:passage:cf00a69b7a7617e35f6ac79cb11a21a4fe32ae9087cc74e72390fafb06a6e465","urn:doxa:passage:3214b102189ca2d41ddec14599cea8ac86051033d1664313b9456268d1cfd173","urn:doxa:passage:a7a0c86d53e49dba36ae94b61b6a702209b9e77128a97fb96b8569bf50f7a82f","urn:doxa:passage:e62992316a67d3c58be9a0363d3ab012048d5ab76b3a49acf65cf3ec0469d659","urn:doxa:passage:ab5ab32ecdb076de8cfe36ce8fc7d24d3b0cbe0db1195cd2ca05a842a0690ae1","urn:doxa:passage:d9a342de4e38cf94e1a6be25c2f7682843ccc2712e94f8f19fcffcec60a130a6","urn:doxa:passage:9fde60bc4027c7db5390056b19797b0bb90abfd5e6f0d007e41d55042f48a42d","urn:doxa:passage:a9cbf2368396b32fa60cbb9e281d8f59fe13ef5cf57bac8e5b5fbd0749205957","urn:doxa:passage:fe53ac5a0995f51749ca2dfd9354b9132ec9f25448b56197a0862a6eddd89a92","urn:doxa:passage:4e31122c60dd8d197a61c63ac34e4fcf6906b16cda85ed4a111b3064c6763c46","urn:doxa:passage:5acad690308db0f66a81491bd58a2a3ef3fd1d84b1c644dafe15ce4821602de4","urn:doxa:passage:a10cc6ee6e3a7940b3ba08a1dcbc09f4ade920cb6201e50b5bd16cb4c11f6cfb"]},{"@id":"urn:doxa:passage:5f208259ffa878f34f9d6b901cd666e66747c80b4f2024a4ffa7dfa5bbb450b6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00001","start":0,"end":276,"exact":"The Pegasus Project, a collaboration of 17 media organisations, released a report on July 18 detailing the potential hacking and illegal surveillance of 50,000 phone numbers, mostly in countries with authoritarian regimes, through the use of the Israeli-made spyware Pegasus. "},{"@id":"urn:doxa:passage:baf267b74b5be8c8791b586090d1c838ac7fe7cb05ff5f4a3088128bcf3845d8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00001","start":276,"end":434,"exact":"The targets of this alleged espionage include human rights defenders, activists, journalists, politicians, high-ranking public officials and business people. "},{"@id":"urn:doxa:passage:3e3d790e5d83b326d41d7577561d8f7944a744448badca1b311d54c5b7bc932b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00001","start":434,"end":511,"exact":"Reportedly, more than 1,000 phone numbers from India are a part of this list."},{"@id":"urn:doxa:passage:86ee50e3a6e649bde907c99c2cbd870ca3fdcd66ef05fc96b2cfb0d4545ff392","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00002","start":0,"end":215,"exact":"Pegasus users can access unencrypted content stored on a phone (messages, emails, photos, videos, etc.), record phone calls, track geo-locations and activate microphones and cameras without the user's authorization."},{"@id":"urn:doxa:passage:2d0fe2e5138758ad6f734bf587a4606c37e2667958b799296c67df5b8df24975","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00003","start":0,"end":290,"exact":"The leaked list of Pegasus targets includes two phone numbers of Rahul Gandhi, a member of the Indian Parliament and the former President of the Indian National Congress (INC), who was unsuccessful in his election campaign against the incumbent Indian Prime Minister Narendra Modi in 2019. "},{"@id":"urn:doxa:passage:b8266e3aecdb66a59bb97bdc11cf444f19df5374d0d2ef658495fc8e951fb23b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00003","start":290,"end":472,"exact":"The Guardian noted that the selection of Indian phone numbers coincided with Modi's 2017 visit to Israel that led to significant growth in the relationship between India and Israel. "},{"@id":"urn:doxa:passage:1b7f86b45656263c52d401e8c1f1c66b77553ee2d39dcac74f0e0a17d0e19041","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00003","start":472,"end":608,"exact":"INC, the main opposition party in the Indian parliament, has accused Modi of ‘treason’ and compromising the country's national security."},{"@id":"urn:doxa:passage:e0c2831086ceceb52457010e53e9a1d453d2d63b8006fac47cd814e128370eaa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00004","start":0,"end":124,"exact":"Also included on this list is the phone number of former bureaucrat Ashok Lavasa, who was an election commissioner in 2019. "},{"@id":"urn:doxa:passage:a1b310b134649d03452977b86535ec963d5d19d9414766fa1b47bd62c59df216","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00004","start":124,"end":274,"exact":"As commissioner, he argued for imposing sanctions on Modi for his heated political speeches, which were linked to increased attacks on Indian Muslims."},{"@id":"urn:doxa:passage:1430babcf2cdcfc3c0d1b748e5a5c2049ed5b62614052708ab868d2e8635d099","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00005","start":0,"end":274,"exact":"Ashwini Vaishnaw, India's Minister of Railways, Communications and Electronics and Information Technology and Prahlad Singh Patel, the Minister of State for Jal Shakti (the water ministry), are two recently sworn-in ministers whose numbers have also been found on the list. "},{"@id":"urn:doxa:passage:e7e056383969423f58065f8b3c6969234e6106fb3e4412830cb9e91c865acd9a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00005","start":274,"end":358,"exact":"Incidentally, Vaishnaw's ministry oversees India's digital surveillance regulations."},{"@id":"urn:doxa:passage:aef89a33eb3cd76be12f24b34f458c5854f1bdf292836e052c6707acb4e1f3d9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00006","start":0,"end":16,"exact":"What is Pegasus?"},{"@id":"urn:doxa:passage:48962137f4cf960dc73ecc1fc086a56ed5e3c43618093cbf6e8a2a5196020041","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00007","start":0,"end":184,"exact":"Pegasus is a type of spyware — a software that allows users to secretly gather and receive data in someone's phone, computer or electronic device — made by Israeli tech firm NSO Group."},{"@id":"urn:doxa:passage:939bf3d18efdb94df839b06d7412c8059823c5ddea45410f33fad6c3f2f264bf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00008","start":0,"end":245,"exact":"The Pegasus Project includes 80 journalists from 17 media organizations from 10 countries, with Paris-based media not-for-profit Forbidden Stories coordinating and the human rights not-for-profit Amnesty International overseeing forensic tests. "},{"@id":"urn:doxa:passage:dc7cb9f2dece96c5fac915dfce6ddaf62e798043e9776cd2c96c0f95a749994e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00008","start":245,"end":276,"exact":"Siddharth Varadarajan and M.K. "},{"@id":"urn:doxa:passage:a8db6b713c666fd7083e569a641ac03ffd36218813f8bfc2e7eabfdcdda834bc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00008","start":276,"end":442,"exact":"Venu, the two founding editors of the Wire, an independent Indian media organisation that is assisting in the investigations, both had devices infected with Pegasus. "},{"@id":"urn:doxa:passage:1e5cc10028f792d24e617d0b10173711d11de4389abf9161767b3434e9b5cbc1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00008","start":442,"end":545,"exact":"One other editor from the Wire and three regular contributors also had their phone numbers on the list."},{"@id":"urn:doxa:passage:bfcf605093e9c85453f323b1c44fb94404e8956be344a0479928dbce53464702","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00009","start":0,"end":93,"exact":"Amnesty's Security Lab produced a detailed technical report after analyzing the leaked list. "},{"@id":"urn:doxa:passage:b2be95d35b9809f9fa1b780fa958ff5d8d96a424745878f7cdc572e45c1c8ddb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00009","start":93,"end":172,"exact":"So far they have analysed 67 phones and found traces of Pegasus in 37 of them. "},{"@id":"urn:doxa:passage:e75e9fbc20541d27e8115987c20e7d466ce9130538ae56b3aa565988cbe31413","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00009","start":172,"end":341,"exact":"Citizen Lab, an interdisciplinary research lab based at the University of Toronto, Canada has independently reviewed and approved Amnesty's forensic examination methods."},{"@id":"urn:doxa:passage:22fb83d3bd8a149b8ec8c155bda893ffc8a22199fa72f276845646f71dbf6b17","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00010","start":0,"end":209,"exact":"While having a phone number on this list does not necessarily confirm that the phone has been infected with Pegasus, the users of these phones can theoretically be targetted by one of the NSO Group's clients. "},{"@id":"urn:doxa:passage:af3c776063a9baf7b52dec504e184e92183f7fc261c4e8c329428d8aa9d35c4e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00010","start":209,"end":437,"exact":"The Amnesty Security Lab has also published the Mobile Verification Toolkit (MVT), an open-source mobile forensic tool to simplify the process of gathering and analysing data from potentially compromised Android and iOS devices."},{"@id":"urn:doxa:passage:feadb33784ddb534cff019399d397971f1a4f2dd0e917f42301a8c38999a68a3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00011","start":0,"end":22,"exact":"The aftermath in India"},{"@id":"urn:doxa:passage:41bd8f8215f516d377ce4067f4dee4946e74a41572a4731f38e0c85eba36674a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00012","start":0,"end":216,"exact":"Reporters Without Border calls India ‘one of the world’s most dangerous countries for journalists trying to do their job properly’, while placing the country's Press Freedom Index at 140 out of 180 ranked countries. "},{"@id":"urn:doxa:passage:35139bbf71c2039b2cb6c3ccfd3dff8c67959041d8a8f53b36bb99c35ef3acb8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00012","start":216,"end":344,"exact":"Journalists like Nitin Sethi cited conscious efforts to not report about the Pegasus Project in mainstream Indian media outlets."},{"@id":"urn:doxa:passage:7b5d0d1f731fd27c3776655f6e20281daa5935e1a39a23998df16a90def21579","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:95d326e2899f1d220405124ab963fc23","blockId":"gv-741671-b00013","start":0,"end":48,"exact":"The range of potential Pegasus victims is huge. "},{"@id":"urn:doxa:decision:85ba55ae460cf9ac76bd4e7b4a2e843d","@type":["doxa:Decision","prov:Entity"],"recordId":"85ba55ae460cf9ac76bd4e7b4