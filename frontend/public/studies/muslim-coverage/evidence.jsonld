b5347071c2c03ee396ad8ff203cbf85b04bb6d3dc5a039f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00014","start":765,"end":982,"exact":"Contra Haas, Iranian historian Houchang Chehabi argues the cuisine is alive and well in part because of its international adoption and fusion, as “its availability … has helped relieve the monotony of life elsewhere.”"},{"@id":"urn:doxa:passage:fa4ee08fa33720541258f84db6e1c3208ff4d57956a8102ec7f636eb7704c042","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00015","start":0,"end":335,"exact":"While Georgian identity is contested from within and against external political and economic forces, the many faces of its culinary culture — for example, the Instagram-fodder dish adjarian khachapuri coming from an ethnically Georgian and religiously Muslim region bordering Turkey — traces a past that cuts across this contestation. "},{"@id":"urn:doxa:passage:b06d2790a2a77cea93d0aaaf4eb9629a2602fe66ade1fbfc1c322d0a1edd2699","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00015","start":335,"end":479,"exact":"One hopes the public does not find ideas from this past, both us-versus-them nationalism and strong-over-weak imperialism, as tempting or tasty."},{"@id":"urn:doxa:passage:ac06b216421f68ea807f156e84307da282e0e036e45c9e8715385de375f4890f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00016","start":0,"end":119,"exact":"At Didedas, three crayon-drawn national flags of Spain, Georgia, and Ukraine are displayed prominently behind the bar. "},{"@id":"urn:doxa:passage:f5530d5d01d74de5b6e7ac03e7260701743ff1ee4be30910921f7e005b3dec31","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00016","start":119,"end":228,"exact":"“My sister is protesting every day in Georgia,” Ana says, “and we want to support the Ukrainian people, too.”"},{"@id":"urn:doxa:decision:9489cd460331441f8469ba861c5b0934","@type":["doxa:Decision","prov:Entity"],"recordId":"9489cd460331441f8469ba861c5b0934","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:0530444e03560fdac5763eede07d2fb4:u_a1eeb95827a692387708c31a","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:ae27e7138b5d2f19eb8ce524dc6584ccd959703a3395d46fcbf2260e90e1a7f4","urn:doxa:passage:4ca54da6804f11b04b5347071c2c03ee396ad8ff203cbf85b04bb6d3dc5a039f","urn:doxa:passage:fa4ee08fa33720541258f84db6e1c3208ff4d57956a8102ec7f636eb7704c042","urn:doxa:passage:b06d2790a2a77cea93d0aaaf4eb9629a2602fe66ade1fbfc1c322d0a1edd2699","urn:doxa:passage:ac06b216421f68ea807f156e84307da282e0e036e45c9e8715385de375f4890f","urn:doxa:passage:f5530d5d01d74de5b6e7ac03e7260701743ff1ee4be30910921f7e005b3dec31"]},{"@id":"urn:doxa:decision:97176bf25e7d718463bbb1c91ae7bfe6","@type":["doxa:Decision","prov:Entity"],"recordId":"97176bf25e7d718463bbb1c91ae7bfe6","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:0530444e03560fdac5763eede07d2fb4:u_a1eeb95827a692387708c31a","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":