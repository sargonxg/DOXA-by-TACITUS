7c63413ea5bd73c0bd83b"]},{"@id":"urn:doxa:passage:c808e38e5daa78e2eff51f9ae8e018b74cb72bcc07a77073104ee5a3bb3b2acf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a9cccfb5c0b0e1b59c04f201411c22c9","blockId":"gv-711015-b00020","start":0,"end":199,"exact":"One high ranking VMRO-DPMNE representative, MP Ilija Dimovski, blasted “madness straight out of the 19th century” and “discrimination on ethnic grounds against the citizens of Republic of Macedonia”."},{"@id":"urn:doxa:passage:f7c564c31fd94744389891106e8ab563fa5d7b39c936d228562cefc7d459d35b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a9cccfb5c0b0e1b59c04f201411c22c9","blockId":"gv-711015-b00021","start":0,"end":163,"exact":"Macedonian Foreign Minister Nikola Dimitrov and the government quickly retorted that they had not received any such information from their counterparts in Albania."},{"@id":"urn:doxa:passage:ed55f658077553c7e8eb14a6da28a4263c11c7b8e0d9fbf79808037fd10d71a1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a9cccfb5c0b0e1b59c04f201411c22c9","blockId":"gv-711015-b00022","start":0,"end":176,"exact":"Several days later, it was Greece's turn, as several right-wing media outlets in North Macedonia published disinformation about the popular tourist destination's border regime."},{"@id":"urn:doxa:passage:c37aa7af56a4cb8229ba27cd4fd36a924fb38081496821f7d44f2adcb51b7bcc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a9cccfb5c0b0e1b59c04f201411c22c9","blockId":"gv-711015-b00023","start":0,"end":351,"exact":"Using a photo-shopped document allegedly from the Greek MFA as ‘proof,’ they alleged that Greece will prohibit the entrance of Macedonian citizens from municipalities where large parts of the population are Muslim (mostly in ethnic Albanian and ethnic Roma communities, implying that these groups are to blame for the spread of the novel coronavirus)."},{"@id":"urn:doxa:passage:ca5a889bded95b2ae8c1191956e057a9b866e233025f411ac6689501ea6f2710","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a9cccfb5c0b0e1b59c04f201411c22c9","blockId":"gv-711015-b00024","start":0,"end":104,"exact":"The Macedonian Ministry of Foreign Affairs denied the claim in a Facebook post, calling it “false news.”"},{"@id":"urn:doxa:passage:216218b61a47cb96d052a72c31f44fcf879a2662c8f890f82f301beb76fbf3c4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a9cccfb5c0b0e1b59c04f201411c22c9","blockId":"gv-711015-b00025","start":0,"end":285,"exact":"When debunking the claim, CriThink noted that it would be highly unlikely for Greece to issue such travel restrictions relating only to citizens that live in certain territories, since that would be an infringement of the ETIAS agreement between North Macedonia and the European Union."},{"@id":"urn:doxa:passage:708a939158ac3fcce60496a8e037d530dfba9cecf52d5bf124f570a0b69a0d6a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a9cccfb5c0b0e1b59c04f201411c22c9","blockId":"gv-711015-b00026","start":0,"end":115,"exact":"Some of the media in question removed these articles, but without issuing a retraction or apology to their readers."},{"@id":"urn:doxa:passage:ec00a49cbb4d282e51ac433bcab9fffca149cf925cf45a82833bfc14ca66de8a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a9cccfb5c0b0e1b59c04f201411c22c9","blockId":"gv-711015-b00027","start":0,"end":95,"exact":"Foreign beach vacations are viewed as a middle class right in the landlocked Balkan countries. "},{"@id":"urn:doxa:passage:3faa0f5f59c3f1fd87b3c90fff2d93eb8d6e2f55c0ded598a3d7de4e775cea7d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a9cccfb5c0b0e1b59c04f201411c22c9","blockId":"gv-711015-b00027","start":95,"end":201,"exact":"Restrictions that inhibit this right, such as COVID-19 related lock-downs, have been extremely unpopular. "},{"@id":"urn:doxa:passage:5972bea5f4fa5b8d29afa23554f6f5b7f4033c713d9a23b0566f9c8e45378ae1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a9cccfb5c0b0e1b59c04f201411c22c9","blockId":"gv-711015-b00027","start":201,"end":314,"exact":"Populist forces in the region, notably the Serbian ruling party, have tapped beach dreams for political purposes."},{"@id":"urn:doxa:passage:ee646345a40c4292f51b50c1eb9c7190f929809e84bce5a14799ae8d9ead1894","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a9cccfb5c0b0e1b59c04f201411c22c9","blockId":"gv-711015-b00028","start":0,"end":197,"exact":"According to the WHO data compiled by Johns Hopkins University as of June 25, Albania has documented 2,114 COVID-19 cases, with 47 deaths, while North Macedonia listed 5,445 cases with 259 deaths. "},{"@id":"urn:doxa:passage:9b22624a1fa43139c60001bc7ee21e9645039b41496b59fd50d535403852467a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a9cccfb5c0b0e1b59c04f201411c22c9","blockId":"gv-711015-b00028","start":197,"end":262,"exact":"Greece had reported 3,310 infected persons and 190 deaths so far."},{"@id":"urn:doxa:decision:a821048d7f84aed3c697e01d83f0c1bb","@type":["doxa:Decision","prov:Entity"],"recordId":"a821048d7f84aed3c697e01d83f0c1bb","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:a9cccfb5c0b0e1b59c04f201411c22c9:u_9aea9d8f43509ea538032855","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:c808e38e5daa78e2eff51f9ae8e018b74cb72bcc07a77073104ee5a3bb3b2acf","urn:doxa:passage:f7c564c31fd94744389891106e8ab563fa5d7b39c936d228562cefc7d459d35b","urn:doxa:passage:ed55f658077553c7e8eb14a6da28a4263c11c7b8e0d9fbf79808037fd10d71a1","urn:doxa:pa