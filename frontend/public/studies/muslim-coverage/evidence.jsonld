peaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:51afd6215b60d37f5b621b6f57ab73099e5de6cb1fa06b5c85e3ae7a3c638bf8","urn:doxa:passage:b2bf4ff2c6eb241f584aa8bb289343b9651680572aa6a8b1371ad8e5d64f897a","urn:doxa:passage:38e6002a410ff50124c7596980b345c5cd55b725092e40fc5397b25087e62fa7","urn:doxa:passage:6af84f89c01d7f76609d087f855f49ed8f8fb930cb78632a877ee986429668ab","urn:doxa:passage:5fd22f035d918c7e9c46642e6604f707b3ce298705311b8b7a6d00cf50fc5dea","urn:doxa:passage:d39e2a52b353afc9ec9d8ec439c70b5e874afa7a978e089fe622407871b0b11b","urn:doxa:passage:8325bb932af2313c2b619b751f6990a7ffa3b97567b0703bc9f01122601ba7e3","urn:doxa:passage:2e52c109f5d527871ca881419431414c1c409ba9329f5d93396e01638af3aa08","urn:doxa:passage:a9bc00459704d5899bbcf054050a1b8a755dd216f606bfba037af9318ca44220","urn:doxa:passage:53b13fb63e32fdd80a44148f83dd2b9f638e0f2d7f56af3825f1f33bced5f2a0","urn:doxa:passage:5a812a1f42afc98bef25fdca9bd9c1c982476ff4d834e1cd3715e29914e11e61","urn:doxa:passage:b23b4a167ed2030ff217fc2d10bf26e3abbe49b394f6e3839e5322b3aad495e2","urn:doxa:passage:f9a62a0620170c198ac2ac4e91efd380f195353d20dfb2460e495653db203ceb","urn:doxa:passage:1e284f23cd9417989411cda694032b6457931e04b4a9508218094eaa8e9e0f37","urn:doxa:passage:151ddd4f18b90f9b608c61827a626117931f130dc985e1c242e89f7ecd68c4a9","urn:doxa:passage:ce24308cb753894fdb3df57465d3eb852971d449acc993adc93aabb7687bf03c","urn:doxa:passage:a654167eef05033154dd6d733e6433652a390b3273d4b3abcd24dacd34b2998a","urn:doxa:passage:0f17eb1945b0f95750bbd842fd615a9c9df9ac3c7ff379903373765dc2c39c7c","urn:doxa:passage:6c8f9e35471f893483a756dd0f7b4073feb84d68efd424d687770d8a089deced","urn:doxa:passage:c44fdf74d0ce89c175176780198a250fb8ae8757548c57d845e4762bdee1e897","urn:doxa:passage:8ee8526e9996503396326c732ee8238570acc6c47f2b62fba76d7de9dfb5b242","urn:doxa:passage:7693b59795e1a7103e552299c42c50cdb11c508da7220f12437896a72387c08d","urn:doxa:passage:d2ce540f024e394986df419f025f76f5f589e45dff2a85ee9fa12dade6846291","urn:doxa:passage:081a23b1eb97f3073a04487e83637c4fcdfdaf0855202fb335cf44ee748d9c1b","urn:doxa:passage:f6ea7ba5a37951be94d819dc9ff7e5684882a7ce6e82e837eb0039d23b006859"]},{"@id":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-831394","title":"Turkey’s Kurdish peace talks: A genuine effort or Erdoğan’s power play?","author":"Sinan Ciddi; Meghan Bodette","translator":[],"publishedOn":"2025-03-26","sourceUrl":"https://globalvoices.org/2025/03/26/turkeys-kurdish-peace-talks-a-genuine-effort-or-erdogans-power-play/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"1dfb859dc40bde6c471db9478815e5056bfa01e7cb3de232f86486f8969a5001","textSha256":"01393b54a6898aad870f625ddbe58196828fe29e5879a026e89424c9100bc039","archivedRecordSha256":"5020afb86f402e6d2d97ff6abb82eabe7da2e5ed140eed3356d360f5591607fe","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:22a4e2e437241fb16020940b0e08cf04:u_e9350a9e135596ead1d8456c","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_e9350a9e135596ead1d8456c","status":"accepted","fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04"},{"@id":"urn:doxa:unit:22a4e2e437241fb16020940b0e08cf04:u_f818a1eaef08fd3b180c858c","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_f818a1eaef08fd3b180c858c","status":"accepted","fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04"},{"@id":"urn:doxa:unit:22a4e2e437241fb16020940b0e08cf04:u_fc6fca53f8b0867d3c33db2c","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_fc6fca53f8b0867d3c33db2c","status":"accepted","fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04"},{"@id":"urn:doxa:passage:c1924361d73d4216d3c442c7cf9e208b89bbaea1eaaca3052402af2210c2c1c7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00001","start":0,"end":112,"exact":"After nearly half a century of fighting, Turkey’s Kurdish rebels are ready to bring their insurgency to an end. "},{"@id":"urn:doxa:passage:e130bf66f2e9a74f1c440a71cf0f45e7071a4b55ee658f400c78575c955fa461","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00001","start":112,"end":268,"exact":"If Turkish President Recep Tayyip Erdoğan takes talks seriously, this could benefit not just Turks and Kurds, but also Washington’s position in the region. "},{"@id":"urn:doxa:passage:8ecc34d0371db5470ee488dc20e0dfbe782b2cff58b9a038ffa080294e6e8ad6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00001","start":268,"end":428,"exact":"But if Erdoğan and his government simply instrumentalize the promise of peace as a regional power grab, the challenges in U.S.-Turkey relations will only grow. "},{"@id":"urn:doxa:passage:b14ebe3f9e72edadbfc086bfd98d187214b8d853bb5fc806cd5121b1169f1674","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00001","start":428,"end":629,"exact":"Erdoğan is arguably negotiating with the Kurds mainly as a means to secure Kurdish parliamentarians’ votes to prolong his rule as president, which is currently prohibited by the country’s constitution."},{"@id":"urn:doxa:passage:0e34ffd703cf5ea57c20876f3ba919ee86007b41853ba1ca05a2e18212add0f0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00002","start":0,"end":49,"exact":"Öcalan calls on the PKK to abandon armed struggle"},{"@id":"urn:doxa:passage:8f0e474f34e9af447c8e6ec8a72d03c45166dd0b33eedc784ec514afc12c98ff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00003","start":0,"end":133,"exact":"On February 27, Kurdistan Workers’ Party (PKK) founder and leader Abdullah Öcalan called on the group to lay down arms and dissolve. "},{"@id":"urn:doxa:passage:36cbfde8b60e30eef98c2c4aca5cceceee5c898f4bbb6c0811cc234e310d666e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00003","start":133,"end":221,"exact":"The call followed nearly one year of secret negotiations with the government of Turkey. "},{"@id":"urn:doxa:passage:fc2bd4b8d2a47b97869f13079c97858740fd2775f29ac40be9068dc071e822ca","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00003","start":221,"end":415,"exact":"On March 1, the PKK’s armed forces declared a ceasefire, saying that they would follow Öcalan’s orders, and calling on the Turkish side to take reciprocal action to facilitate their dissolution."},{"@id":"urn:doxa:passage:7e362e3be7287ae57ca4c0cacd5572253c0461e5aef722603265f9c5414e4128","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00004","start":0,"end":93,"exact":"The PKK took up arms in 1984 when Turkey was under authoritarian rule after a military coup. "},{"@id":"urn:doxa:passage:a0634763db543673f834357ad668cde7e3f6c7667b8191be605bfe1581f3e99f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00004","start":93,"end":209,"exact":"Kurdish language and identity were criminalized, and dissenters, Turkish or Kurdish, faced prison, exile, or worse. "},{"@id":"urn:doxa:passage:c6a8da5306a28ad28271744a78bbe7544412001c89178bb869839a9e83866ddb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00004","start":209,"end":300,"exact":"Since then, the armed conflict has cost Turkey over 40,000 lives and trillions of dollars. "},{"@id":"urn:doxa:passage:9d6fbbf4f20b35bbd3efee6e8e68ecb3ad6595570eb2d1438e4e32f2bff019c9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00004","start":300,"end":389,"exact":"Both sides have periodically engaged in negotiations since 1993, with no lasting results."},{"@id":"urn:doxa:passage:33d66bed3eea2c55994eaa076e8f2622fd27ba869023e9b04905523ff943e7c6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00005","start":0,"end":60,"exact":"The closest Turkey got to a deal was between 2013 and 2015. "},{"@id":"urn:doxa:passage:ed21f11b2ef5061d635a45a6a5428cd03f3c4326c555a04d703f14ddf0f10110","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00005","start":60,"end":203,"exact":"While Erdoğan abandoned these negotiations after a loss in the June 2015 parliamentary elections, they had a lasting impact in one area: Syria."},{"@id":"urn:doxa:passage:46648ab11bee4f61df76bb0f0f53d3ec67d261b3c2452878c1bebd5f846b2b4b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00006","start":0,"end":233,"exact":"The ceasefire allowed Kurdish forces to focus on fighting ISIS, enabling the defense of strategic regions like Sinjar in northern Iraq and Kobane in northern Syria when the Iraqi and Syrian armed forces could not or would not fight. "},{"@id":"urn:doxa:passage:0749df932c1b54e8bb97709d73f0604a7f52106eb72210154fe295f959221e67","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00006","start":233,"end":429,"exact":"It is also unlikely that the U.S.-led Global Coalition could have partnered with the Syrian Kurdish People’s Protection Units (YPG) if Kurdish groups were actively engaged in conflict with Turkey."},{"@id":"urn:doxa:passage:e8b904b606184878146ee6c98ba2a0b91861f5e5e43ea51e09b550852d261197","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00007","start":0,"end":91,"exact":"Ten years later, Washington is hopeful that peace could pay dividends in Syria once again. "},{"@id":"urn:doxa:passage:1cb9f5565ada9424ed672dba1fa57e6811eb03b923a9321e57af17bcb491d7bd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00007","start":91,"end":426,"exact":"As a White House statement welcoming Öcalan’s call noted, the U.S. believes that the dissolution of the PKK and resolution of Turkey’s Kurdish question could resolve what has become perhaps the largest challenge in U.S.-Turkey relations — Turkey’s hostility to the U.S. partnership with the Kurdish-led Syrian Democratic Forces (SDF). "},{"@id":"urn:doxa:passage:dd2167a7524e57e571d53c6ac769c441338a513045627e7682ba3b57247da6b2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00007","start":426,"end":557,"exact":"In fact, the U.S. may have quietly supported the resumption of Turkey-PKK negotiations since at least 2023, likely for this reason."},{"@id":"urn:doxa:passage:92ff7692cbfeedb97c43e7da0fef1813e84f7d25e9a2ee5abdbb9c44dd671181","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00008","start":0,"end":53,"exact":"The SDF, predictably, shared this positive reaction. "},{"@id":"urn:doxa:passage:50e2b6c30314f108166c3b8e1237f31d703edd5a1270c532ed1059e663d8edf9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00008","start":53,"end":215,"exact":"SDF Commander in Chief Mazlum Abdi said he hoped it would remove pretexts for Turkish attacks on his forces as they negotiate their place in the future of Syria. "},{"@id":"urn:doxa:passage:6ac8646da6912acac832b226f4d7237c5eae2860946abdd263cc335b703ce408","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00008","start":215,"end":373,"exact":"Abdi has been a proponent of peace in Turkey for years, publicly stating his forces’ readiness to help with any political solution in a 2022 opinion article. "},{"@id":"urn:doxa:passage:a64ce41cfae2b209a46b8e2ad956e68337cfea2eee60c813a3330b76d0f01e0f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00008","start":373,"end":457,"exact":"Other leaders in his government, like Ilham Ahmed and Salih Muslim, share this view."},{"@id":"urn:doxa:passage:9edc532ac6604e2463e00052dfe92ab79794e33c2ff52e03cb9fd5ae7de48ebc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00009","start":0,"end":58,"exact":"However, Erdoğan’s government is taking a different tone. "},{"@id":"urn:doxa:passage:b3e6a9d38ac8f2b1870642963d2b70e64329cd0903cbbf0aceb887082b850c97","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00009","start":58,"end":218,"exact":"Rather than welcome the prospect of the end of violence that has devastated their country, Turkish officials are using the declaration to threaten further war. "},{"@id":"urn:doxa:passage:654676727ad2f8dbd3562d52e013634225c45ce43bc2ad646af25550461bb544","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00009","start":218,"end":417,"exact":"They insist that Öcalan’s declaration must apply to the SDF, alluding to further military action if the Syrian Kurds do not simply surrender to Turkey-backed militias and Syria’s new Islamist rulers."},{"@id":"urn:doxa:passage:174275a3e0494b474872944b015d6d018e8a18c86c3cc6caa18532133bc754bb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00010","start":0,"end":64,"exact":"Why is Erdogan engaging in a new ‘peace process’ with the Kurds?"},{"@id":"urn:doxa:passage:f70718a517579a4dc26d513fdc7fe67814b51600cc07c44cd64923e226a08c43","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00011","start":0,"end":162,"exact":"This attitude could kill the peace process before it begins, bringing instability and insecurity to Turks, Kurds, Syrians, and the international community alike. "},{"@id":"urn:doxa:passage:954b2f1f28d5ac9b6a064ec7eab7c92bc42540373a4af707a4f61a8abb727ec4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00011","start":162,"end":301,"exact":"Before any of these calculations can be addressed, it is worth asking why Erdogan decided to pursue a new peace process with the Kurds now?"},{"@id":"urn:doxa:passage:3031928583abdce1fb259a7043422fc889200a1c218ff5ad48d27f89ade6e761","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00012","start":0,"end":32,"exact":"It is for instrumental reasons. "},{"@id":"urn:doxa:decision:472aef2973743da99015c6fbdcb89cb5","@type":["doxa:Decision","prov:Entity"],"recordId":"472aef2973743da99015c6fbdcb89cb5","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:22a4e2e437241fb16020940b0e08cf04:u_e9350a9e135596ead1d8456c","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","prop