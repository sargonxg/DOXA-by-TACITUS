7335ec2a30e6a34ff3fdbe4b975b23cad219e3875016a100aafd9a901","urn:doxa:passage:c44280597a582dda091a4f18225246e185d846b49e9a1ffb1c2c62f35cee40c8","urn:doxa:passage:3bd017635d385f0e6892558f729fc392fbf81410a831aa43de9f115366473d04","urn:doxa:passage:96e40bbbed566878aea0db2adc039d11d79309d643a4a225d00ba7f72ce93bfb","urn:doxa:passage:80cf579b9058302b56d385a13b1c3625ee97974039c3683c410c38fa847b7184","urn:doxa:passage:a7a43ebc1761127236db39646b938bf9def9f59e8c42b1c4c86e9b6e767a1856","urn:doxa:passage:1defa5215f7f64e282a4722b026c6269277fd22963d14f2fd73bbe7113dbbecd","urn:doxa:passage:33fa38a08819de68873d835143df5071afb6deb84b2059ef433fc286e25a090b","urn:doxa:passage:969335e6ae8ab4ea8bc9720c5f15ec4bcb972437119d05f65046edb968edd1ed","urn:doxa:passage:3c9cc17bf5fd9c6cfc6899930c54b719c8e694ffd37a2e33de8db13f7589a362","urn:doxa:passage:c351b0bea27bd570e8c8e7810f9f6cb0d5ae69e44a13893ed43fb4ac3503d418","urn:doxa:passage:a73b94a69a10b903cea505a5d93e39747548780d7e751c7c6824d4fb90d53ad2","urn:doxa:passage:9df9b747764bcdf88167fc31060778ff57df112affde8881cb2d617d637b6286","urn:doxa:passage:02a22cb996770d8f4222f981fc1bbeb9c71a20a7cd4d56205f7479c62a0858ee","urn:doxa:passage:d197f54d6026017a15cf28d64bc6ae4b85fa978a6b6104df61791dc3a1332831"]},{"@id":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-725386","title":"Why Macron’s tweet on the Serbian Patriarch's death angered so many people in the Balkans","author":"Mirza Hota","translator":[],"publishedOn":"2020-12-24","sourceUrl":"https://globalvoices.org/2020/12/24/why-macrons-tweet-on-the-serbian-patriarchs-death-angered-so-many-people-in-the-balkans/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"0201def5526cf0110666b33000a7f682adc99475dd57051b903395e26b171c11","textSha256":"d11464153209005fdcc6b3b1c21ef2f161d0169e57a81348ccb3adff502f4b39","archivedRecordSha256":"3835e3ee8a1957a37cc14ea8d03a11a02d1ae6edebf4262ee3913f2d095741d0","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:6b0ccb975d051edea38137c0d5ac0c50:u_0c07d2104ce1f40ea502a829","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_0c07d2104ce1f40ea502a829","status":"accepted","fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50"},{"@id":"urn:doxa:unit:6b0ccb975d051edea38137c0d5ac0c50:u_0e7feb722abced279a19ee52","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_0e7feb722abced279a19ee52","status":"accepted","fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50"},{"@id":"urn:doxa:unit:6b0ccb975d051edea38137c0d5ac0c50:u_7e547ae8162207004258b19a","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_7e547ae8162207004258b19a","status":"accepted","fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50"},{"@id":"urn:doxa:passage:565b0f3f4dfc60675f4e2e7d4bc87095e7ecdd6203d43b8f965e5ea12a1ed419","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00018","start":0,"end":246,"exact":"That notion also explains Macron's interview with The Economist last year and his outrageous and debunked comments about Bosnia and Herzegovina as a jihadist “ticking time bomb” in the Balkans, which drew criticism about structural Islamophobia. "},{"@id":"urn:doxa:decision:017eed8053039471ebaf1038c90dcfc0","@type":["doxa:Decision","prov:Entity"],"recordId":"017eed8053039471ebaf1038c90dcfc0","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:6b0ccb975d051edea38137c0d5ac0c50:u_0c07d2104ce1f40ea502a829","attribution":"reported_speaker","speaker":"Emmanuel Macron","speakerStance":"supports","documentStance":"neutral","proposition":"Bosnia and Herzegovina is a jihadist 'ticking time bomb'","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports on criticisms of Macron's characterization of Bosnia and Herzegovina as a jihadist 'ticking time bomb', noting these comments drew accusations of structural Islamophobia.","modelPassage":["urn:doxa:passage:565b0f3f4dfc60675f4e2e7d4bc87095e7ecdd6203d43b8f965e5ea12a1ed419"]},{"@id":"urn:doxa:passage:f56244456cffeb263ddebb962b90e8dc7ef06ae2839abf592774c780da5005b8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00010","start":82,"end":496,"exact":"According to Balkan Insight Irinej praised Bashar al-Assad on his “principled stand” of refusing to recognize the independence of Kosovo, as well as Assad comparing Syria to Serbia, claiming that what both countries “have been exposed to in terms of foreign interference and attempts to undermine their sovereignty and undermine their social fabric” constitute good reasons for their relationship and co-operation."},{"@id":"urn:doxa:passage:1c4d2e64ea2739cbd422f49a5ea923df29d02957f0b540f6bc322c3273297d39","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00011","start":0,"end":284,"exact":"The Patriarch, of course, did not mention the well-documented industrial-scale mass atrocities committed by Bashir al-Assad's army as well as Russian and Iranian forces, including chemical weapons attacks on civilians, carpet bombing of cities, barrel bombs, and concentration camps. "},{"@id":"urn:doxa:passage:d35a1ad4d51d02ff7ec96a1cd0f546b44ecaaa8673a6589a59604cb5753d55db","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00011","start":284,"end":378,"exact":"He also failed to mention the presence of Serb mercenaries and volunteers fighting for Assad. "},{"@id":"urn:doxa:passage:bb4141c2c4d9de817d88870a135d57c979ca8e0aaf2a516171cfee417b8eed4c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00011","start":378,"end":539,"exact":"As was reported by Balkan Insight in 2016, many Serb fighters were simply transferred from Ukraine, where they fought against the Ukrainian government, to Syria."},{"@id":"urn:doxa:passage:6c76e2183689753dc4f3d61ca06dbcfc41ccbbcde634c67442a2360d68ddf62e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00012","start":0,"end":299,"exact":"In 2014, Patriarch Irinej also weighed in on the then-upcoming Belgrade Pride parade as “the tip of the immoral iceberg” by saying that he “felt sorry for those people who belong to the so-called gay population.” He promoted discrimination and disinformation that dehumanizes LGBTQ people by adding:"},{"@id":"urn:doxa:passage:80d662a955fcf6f463488d4bbf2e4bcacca2ca99baf99099f0a749168c69514a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00013","start":0,"end":50,"exact":"> “It is a disorder or deviation of human nature. "},{"@id":"urn:doxa:passage:bd93ce68e8102f6ab3345dfb14ced42a3e52d1281e69c0b6db7cf2301f1efdc6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00013","start":50,"end":192,"exact":"I can understand them, as well as their problem, but I cannot understand why they impose this problem unto us or try to show it off publicly.”"},{"@id":"urn:doxa:passage:7c4edc9cb372aba1af295bc618514da912b564fa981d05aae0c7dda46bb142cb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00014","start":0,"end":91,"exact":"Irinej was also opposed to stricter rules for churchgoers during the outbreak of COVID-19. "},{"@id":"urn:doxa:passage:77d7dad9821efc7d96c1f11b2ab60bf455620fb6b7b3f96dbc12244a047bc366","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00014","start":91,"end":409,"exact":"He is on record as saying that he believed that the methods used as liturgical instruments to distribute Holy Communion in Eastern Orthodoxy, including glasses and spoons needing to be cleaned after each person, were not in line with Church tradition, that it was something new that was not compatible with the faith. "},{"@id":"urn:doxa:passage:ae969019165846d617df240cf440106e158b14a12c18bf870bcc86082abc9685","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00014","start":409,"end":607,"exact":"That led to footage of Serb Orthodox faithful across the Western Balkans receiving Holy Communion with the priests using a single spoon or glass, and this was at the height of the COVID-19 outbreak."},{"@id":"urn:doxa:passage:586bbe42c4724b8b6349577165801418a9041eda4c7b154db57fd6d1dafdc6be","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00015","start":0,"end":296,"exact":"This prompted some commentators to point out that the Serbian Orthodox Church was above the law of the land and was risking the lives of its followers and everyone else who came into contact with them, simply because of their unwillingness to break with tradition even when faced with a pandemic."},{"@id":"urn:doxa:passage:817c90671ec82595c2602a34c2200e8cd32aaaadce7cc7c6f0d6391389079a67","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00016","start":0,"end":136,"exact":"That unwillingness killed Irinej as well as his counterpart in Montenegro, Metropolitan Amfilohije Radović who also died from COVID-19. "},{"@id":"urn:doxa:passage:969314b53e911e025234936c3376fc25681b7644f8e2ebf541c0ae18b36e38a8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00016","start":136,"end":375,"exact":"Patriarch Irinej attended the open-casket funeral of Metropolitan Radović along with a large crowd inside the church, with almost nobody wearing masks and with mourners kissing the deceased cleric's hands and forehead, according to custom."},{"@id":"urn:doxa:passage:06d8241fa42baf811be33cf37c86e85a3c6ef75febacfb2afa6634fc5b09ec0c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00017","start":0,"end":186,"exact":"Likely reasons for Macron´s gesture include appeasing Russia, which is often promoted in the Balkans as chief ally and protector of Serbia and the Orthodox Christianity among the Slavs. "},{"@id":"urn:doxa:passage:b039cc06a3d4154383c5b7d51d92d037f4af460a0e99e9ce59306ca977972a3f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00017","start":186,"end":428,"exact":"Analysts examining his new approach to Russia, the so-called reset, inaugurated in July 2020, expressed concern that it might involve abandoning the Western Balkans to Russia, as it traditionally views the Balkans as its sphere of influence. "},{"@id":"urn:doxa:passage:5a396a53acd16dde8fcac599a8329080f69e643e03f2079e5b5d59c2e0c74348","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00017","start":428,"end":577,"exact":"The Serbian Orthodox Church is a key element in facilitating Russian influence in the Balkans with its long history of supporting the Kremlin agenda."},{"@id":"urn:doxa:passage:5c2002f6bebf402c90147485075bd61350537d93c46c9d2fe4864e5243da987c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00018","start":246,"end":407,"exact":"Added to that were his comments about Albania and North Macedonia and his subsequent veto against EU accession negotiations for the two Western Balkan countries."},{"@id":"urn:doxa:passage:8a398898124813433ef461bf53a5b831ad7271dba97188db5f94a7036c57d69a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00019","start":0,"end":73,"exact":"Another reason might be appeasing the French right and far-right voters. "},{"@id":"urn:doxa:decision:fe430429b2bc69cf96f18a9f10c972c3","@type":["doxa:Decision","prov:Entity"],"recordId":"fe430429b2bc69cf96f18a9f10c972c3","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:6b0ccb975d051edea38137c0d5ac0c50:u_0c07d2104ce1f40ea502a829","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:f56244456cffeb263ddebb962b90e8dc7ef06ae2839abf592774c780da5005b8","urn:doxa:passage:1c4d2e64ea2739cbd422f49a5ea923df29d02957f0b540f6bc322c3273297d39","urn:doxa:passage:d35a1ad4d51d02ff7ec96a1cd0f546b44ecaaa8673a6589a59604cb5753d55db","urn:doxa:passage:bb4141c2c4d9de817d88870a135d57c979ca8e0aaf2a516171cfee417b8eed4c","urn:doxa:passage:6c76e2183689753dc4f3d61ca06dbcfc41ccbbcde634c67442a2360d68ddf62e","urn:doxa:passage:80d662a955fcf6f463488d4bbf2e4bcacca2ca99baf99099f0a749168c69514a","urn:doxa:passage:bd93ce68e8102f6ab3345dfb14ced42a3e52d1281e69c0b6db7cf2301f1efdc6","urn:doxa:passage:7c4edc9cb372aba1af295bc618514da912b564fa981d05aae0c7dda46bb142cb","urn:doxa:passage:77d7dad9821efc7d96c1f11b2ab60bf455620fb6b7b3f96dbc12244a047bc366","urn:doxa:passage:ae969019165846d617df240cf440106e158b14a12c18bf870bcc86082abc9685","urn:doxa:passage:586bbe42c4724b8b63