9ccea0f4b8553acfc806e9e3363ef50263663e","urn:doxa:passage:c9eb95a432ee6ddb2e05471a96816e313a9ae5a39907252f81a8889adc033f7a","urn:doxa:passage:92ffe78905d863c23dd905f06356e32f548e82ee08f97e005468b657e64b2d50","urn:doxa:passage:d0dd22b8a2ffa70bcc96cec4869a96b6e3ced92145c59d636dfbf8dd7902fd8c","urn:doxa:passage:4a12d738cda6e10f19e4e1d97d79501f8855ed5b080d6036293d6aca97a9da88","urn:doxa:passage:b882a2414088d1741c857457289ac286bfeb2232a09f5635fa2e8c56d241fdb4","urn:doxa:passage:4a191a5db284287344c11235aa4283fb85a49f68042e6a08b629cde8fc5fcd6e","urn:doxa:passage:224348f969d1141fc68f947d9c8d72232ec833848f97b28be3ae9d36152b450c","urn:doxa:passage:c74f5dae6178c99396023923d823ac3a29ca0cba184b5bbc161982f081767010","urn:doxa:passage:98eb9c0018fdb3141ae83198893c7670780a1b55ae3248d736000d478191404b","urn:doxa:passage:eefbcd9cbd743a09ce51750e41fcd787093c5bfb82824c8a2c45eb4af7ae7e3b","urn:doxa:passage:1a5d9da51669a46cff96b1f1aff35aa7285e5f40e0c0fa7bfaa0ed78f90c1aa3","urn:doxa:passage:2c21e6c166eb1fd8e5b7fc71767d65e2a8a9fdc82e78ddd9e66d50f0b31e0825","urn:doxa:passage:0b58faaf6466a764181ded53448340e28b7b64a09e5e632d769acb0b76be9e75","urn:doxa:passage:ff798032b540aabd0a534a44741d3dac6acdf3676d727591479040f699b684dd"]},{"@id":"urn:doxa:passage:29334154783a8eae34329b12115f4012e598c95e3a2af2fb86614ccc337c1002","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00001","start":0,"end":115,"exact":"Journalist Sira Sow sits behind a green microphone in a recording booth in a hot rural village in eastern Senegal. "},{"@id":"urn:doxa:passage:6a304d8cb281efe95c4c1afe93b9ac82abbabc03d82d01556b81739f41577ed8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00001","start":115,"end":306,"exact":"She speaks in the local language of Wolof on La Laghem FM community radio, her words radiating out into the taxis, homes, stores, and cellphones of hundreds of locals in the N'Dofane region. "},{"@id":"urn:doxa:passage:85e1b9739bce48d09fd9635a4380ad19f5d517beac0251bb6b46d06e91c81e8c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00001","start":306,"end":418,"exact":"She is reporting on stopping gender violence, and the local imam she interviewed for her story agrees with her. "},{"@id":"urn:doxa:passage:58eb01f4647aa38eb2bf096e830352ed3859393d7fbb6de26abe818f55c5e19e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00001","start":418,"end":495,"exact":"Gender violence is not supported by the Quran, Islam's sacred text, he says. "},{"@id":"urn:doxa:passage:eedde6fbd4af7fc1652da432ad95cb5cc437029eb530be6c2f1c5e729cf9a0d7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00001","start":495,"end":634,"exact":"Her radio broadcast reaches many ears that day, as many locals only speak Wolof and may only get their news from an oral medium like radio."},{"@id":"urn:doxa:passage:907d801c1f3c05cba0bd36e82a7e645823ecfeaa2d5648c4d649209bf0751938","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00002","start":0,"end":233,"exact":"“Sometimes in Senegal, we encounter victims of violence, particularly very young women, but in our culture, even if you are a victim, sometimes [you] hesitate to report the violence,” Sow says in a later interview with Global Voices."},{"@id":"urn:doxa:passage:596f48a09234e2c987dd6e17409b7d232b45a704163fec6d55e4792bc58ce654","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00003","start":0,"end":271,"exact":"Sow is part of a pilot group of women journalists participating in the Reporting Fellowship for Women Journalists in Francophone Africa Project, which is now working to start a women's journalism fellowship in West Africa through a new survey and a new online community. "},{"@id":"urn:doxa:passage:a3786dd3cf2cc5f99607f0e7a5bfb22a3721ec1ba2dc9c6049cdc7276dff137c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00003","start":271,"end":581,"exact":"The news initiative in charge of this program, The Africa Women Journalism Project (AWJP), is conducting research with the goal of launching a new journalism fellowship in the francophone countries of Burkina Faso, Senegal, and Togo to create a pan-African network of women journalists covering women’s issues."},{"@id":"urn:doxa:passage:174146d955ff9234d1e8eae053d13ffa9caba3a6b5c682f403833d2ef31bb52f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00004","start":0,"end":149,"exact":"The live survey in French and English on X (formerly Twitter) is gathering data on gender coverage topics in the newsrooms of these three countries. "},{"@id":"urn:doxa:passage:401bc0349533cb81438c45d43affe5ce6cd1c1262c72ef3b7e8d3b08bece1940","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00004","start":149,"end":230,"exact":"With this data, they can create a curriculum to teach fellows journalism skills. "},{"@id":"urn:doxa:passage:7213c0628c83c6e026732f29813167f5223f42e31d5581548d54b7883eac0828","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00004","start":230,"end":354,"exact":"On May 27, AWJP launched a new online space,#AWJPWACommunity, to unite women journalists in all of francophone West Africa. "},{"@id":"urn:doxa:passage:799e5eb779a982d54b6a93083ce4050c9798dd1e2352425f585e968b13dd5523","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00004","start":354,"end":466,"exact":"This budding community can unify women journalists through new peer-to-peer relationships and regional training."},{"@id":"urn:doxa:passage:e4935ace484eab15fee783a384de110a8453aa594d3d3d03f972882196b43b5a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00005","start":0,"end":182,"exact":"As the director of the AWJP, Catherine Gicheru explains that gender-based violence and maternal-fetal health issues are significant topics that affect women in every African nation. "},{"@id":"urn:doxa:passage:a1cc67de94a2d8a796a6e0c9d118ce4b6f65891a389427820c2ab860aab02788","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00005","start":182,"end":332,"exact":"The women journalists covering these topics from Benin or Togo, bring to the newsroom highly specific local knowledge from their respective cultures. "},{"@id":"urn:doxa:passage:c11a207ea6692e0e5cf4df8cfdcde5535c446bba6fac907de79ad58bd63a3e89","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00005","start":332,"end":511,"exact":"Combining each journalist's local knowledge of women's issues — such as gender violence in Senegal compared to Nigeria — can help enrich and strengthen collaborative storytelling."},{"@id":"urn:doxa:passage:c1b6d9b33c1d4161038fbd09e7c3a1e8c9cad699e6115d623f44c4b71c660ca5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00006","start":0,"end":145,"exact":"“How do I get together the Senegalese journalist, and the Ghanaian journalist and the Tanzanian journalist who may be working on the same story? "},{"@id":"urn:doxa:passage:0e7d9a5b21b0d1d63f2fd7240aa28a781ae554303bd64b805a040c0122eb2bff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00006","start":145,"end":334,"exact":"The issues are the same; the stories can be better if we are sharing how we are dealing with this problem; we have the same problem,” Gicheru told Global Voices in an early April interview."},{"@id":"urn:doxa:passage:bbd2a35f453630b1630faa2cb12081e58efdd26ee49916f6734592fa04db9a22","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00007","start":0,"end":124,"exact":"Coverage by past AWJP fellows has had a huge success among local African audiences, with some fellows winning major awards. "},{"@id":"urn:doxa:passage:a2845f676e020fdcd2469ef27bbdd87b6d926a868132bcb949e5c59a9e3b5a13","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00007","start":124,"end":367,"exact":"Nigerian journalist and past AWJP fellow Fadare Titilope published a hard-hitting collection of articles on female genital mutilation (FGM) in the Nigerian newspaper “Premium Times” which won her the national Nigerian ReportHer award in 2023. "},{"@id":"urn:doxa:passage:e160cb7554acb6892280e4cb8d7824b14d2620d72cf0f9f0b026b39f98d2c2bd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00007","start":367,"end":478,"exact":"She received several months of coaching and editing from her AWJP mentor, Nigerian journalist Vanessa Offiong. "},{"@id":"urn:doxa:passage:f04358ef63ba98b25c9533d9cda712d6bae996bf96fb1974af34fe3c208f760f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00007","start":478,"end":609,"exact":"Offiong said when she worked with AWJP fellows in Nigeria, she helped editors back in Kenya understand Nigerian cultural contexts. "},{"@id":"urn:doxa:passage:a49a7ea994a1ac27d4d4587f13cac7bdd5ab9d2106ec77b5f44c854a92daa322","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00007","start":609,"end":827,"exact":"For example, the Nigerian practice of a mother or mother-in-law visiting a daughter who has just given birth is called omugwo, but it differs substantially from the country’s northern region versus the southern region."},{"@id":"urn:doxa:passage:2073b203ad0fbf127c1091086aa0537ce1c4193f6a4a188811ba0bd0b2740e2d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00008","start":0,"end":157,"exact":"“I have to give these kinds of local insights … I was saying to them [AWJP editors] even this practice of omugwo differs from culture to culture in Nigeria. "},{"@id":"urn:doxa:passage:5832126b3888a68f7feb1648e4cf931a812cb02b1741bb307ac220576f8c7c00","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4145f8be70c9320af514def08b00f359","blockId":"gv-813379-b00008","start":157,"end":281,"exact":"So this was an instance where AWJP was willing to listen to me,” Offiong said in an interview with Global Voices from Lagos."},{"@id":"urn:doxa:decision:2fba20c867ee08a9232e7290b08571ea","@type":["doxa:Decision","prov:Entity"],"recordId":"2fba20c867ee08a9232e7290b08571ea","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:4145f8be70c9320af514def08b00f359:u_db7922a4c10246f39596fa99","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:29334154783a8eae34329b12115f4012e598c95e3a2af2fb86614ccc337c1002",