e0a258ade0e584c932df9a175eb9c2459fa47b60864eedd353"]},{"@id":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-833828","title":"Palestinian voices: A papacy that felt closer","author":"Civic Media Observatory","translator":[],"publishedOn":"2025-05-07","sourceUrl":"https://globalvoices.org/2025/05/07/palestinian-voices-a-papacy-that-felt-closer/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"d38f4c8abffd928e8cede5428266b309fb4f8b0b6852363d4daf29e3670a100e","textSha256":"5df31bca52093a51a4cfd823df6618ed0ee0873062a21771857760af355d7465","archivedRecordSha256":"73e38f19adc6c90af3512f9136b2f090e31b2f8ba89d43a88f97b0f2c769c616","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:4f258bc5614258628ba373af35a79adf:u_b2c5c67816911b945fa461bb","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_b2c5c67816911b945fa461bb","status":"accepted","fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf"},{"@id":"urn:doxa:unit:4f258bc5614258628ba373af35a79adf:u_e66fdfa40641a4ce30d398e2","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_e66fdfa40641a4ce30d398e2","status":"accepted","fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf"},{"@id":"urn:doxa:passage:dc2965556cb522757c4b2888f8ff35b45ec5b276e5a8325546a4cf67165cdd0c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00001","start":0,"end":87,"exact":"This story is part of Undertones, Global Voices’ Civic Media Observatory‘s newsletter. "},{"@id":"urn:doxa:passage:daf4865bf839fe989779c9fa1706faa5f860cc2d01a9399d9813aee341080884","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00001","start":87,"end":111,"exact":"Subscribe to Undertones."},{"@id":"urn:doxa:passage:3e2bcf664dfff68367d32251e18f90f591250eca933c9649b52c6864e482d9a8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00002","start":0,"end":181,"exact":"The Holy See’s calls for peace in the Holy Land and Jerusalem have been recurring for decades now, aiming for coexistence and freedom of religion for Christians, Jews, and Muslims. "},{"@id":"urn:doxa:passage:6085a59890af4cd3680ca29882e56c69f0675c14dc3e2273c6f72f58e0b60c92","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00002","start":181,"end":580,"exact":"On April 20, 1984, in the Apostolic Letter Redemptionis Anno, Pope John Paul II, recalling a sentiment already shared by Pope Paul VI after visiting the Holy Land and Jerusalem in 1964, stated that from his point of view, the “failure to find an adequate solution to the question of Jerusalem” compromised further the “longed-for peaceful and just settlement of the crisis of the whole Middle East.”"},{"@id":"urn:doxa:passage:c4ad4b72c86ee3690463454a54368f0cd4278ba7ce79e989a4f390f73f55fdc9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00003","start":0,"end":317,"exact":"Under the 1993 Fundamental Agreement between the Holy See and the State of Israel, when the two states established formal diplomatic relations, the Holy See and Israel committed to the “promotion of the peaceful resolution of conflicts among States and nations, excluding violence and terror from international life.”"},{"@id":"urn:doxa:passage:23506d7016e807d6b9176f1d989643aa9d7731256055dd6b8d96922a6eb2ce31","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00004","start":0,"end":542,"exact":"In March 2000, in his jubilee pilgrimage to the Holy Land, in the speech he gave when visiting Palestine's autonomous territories governed by Chairman Yasser Arafat, Pope John Paul II noted that the Holy See “has always recognized that the Palestinian people have the natural right to a homeland, and the right to be able to live in peace and tranquillity with the other peoples of this area.” Yet it was not until 2015, under Pope Francis’s papacy, that the Holy See officially recognized the State of Palestine in a comprehensive agreement."},{"@id":"urn:doxa:passage:11117f9393506e580c644d58fdb580ddf29033b9ccb62cfd766ffcf0a39e20d4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00005","start":0,"end":62,"exact":"Narrative: Palestine lost a friend and an ally in Pope Francis"},{"@id":"urn:doxa:passage:848c856e08a5ef2932fa0d977f8308c06fbdbef07e1edb76244b00c277c17cae","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00006","start":0,"end":192,"exact":"Pope Francis's active advocacy for justice in the Israeli–Palestinian conflict has resonated deeply with Palestinians and defenders of their rights, regardless of their religious affiliation. "},{"@id":"urn:doxa:passage:5f52cc18adc4665423cf21587e4e921e0d88fdfcc66588187754d5bd984a5c56","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00006","start":192,"end":421,"exact":"Those asserting this narrative frame consider Pope Francis a true friend and ally of the Palestinian cause and see his death as a significant loss for those advocating for a peaceful solution that recognizes Palestinians’ rights."},{"@id":"urn:doxa:passage:684b834633b84fa08f0268c2e33978cc037fc421f709f2de229051f824aa0261","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00007","start":0,"end":321,"exact":"Since the beginning of his papacy, Pope Francis has been a vocal advocate for the rights of Palestinians, not only recognizing the State of Palestine but repeatedly calling for a ceasefire after the Hamas-led attack on Israel in October 2023 and the consecutive launch of Israel’s war on Gaza and until his final address."},{"@id":"urn:doxa:passage:a79e2adf3afb4f15e48549ea9e8d17fa8d40cd4e6799b4fde31bb6983b0ea396","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00008","start":0,"end":49,"exact":"Read our special coverage on Israel’s war on Gaza"},{"@id":"urn:doxa:passage:f51cd322da96ac805bf1169da7b21714f319c72d3981459239102a4478ffff0f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00009","start":0,"end":221,"exact":"In November 2023, after meeting with relatives of Israeli hostages and Palestinian families affected by the war, Pope Francis denounced the violence in Gaza as an act of terrorism, criticizing both sides of the conflict. "},{"@id":"urn:doxa:passage:6d67897605bc533ec91caee3a694c3d4c273651419b44d868a536d979841e7cd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00009","start":221,"end":390,"exact":"A month later, in December, he reiterated this condemnation, again describing the war as terrorism, this time in response to an Israeli attack on Gaza’s Catholic parish."},{"@id":"urn:doxa:passage:5b35d461330521661d3b05a36a19d7918ff15ca8ce552c2c4a2926497a4a2ae6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00010","start":0,"end":369,"exact":"In mid-November 2024, Pope Francis called for an investigation to assess whether Israel’s actions in Gaza constituted genocide, stating that there was a need to carefully determine whether they fit “into the technical definition formulated by jurists and international bodies.” To date, the cost of human lives from this conflict has been enormous and is still rising. "},{"@id":"urn:doxa:passage:c82b65a8d3f43bad87a3e933642b1e562f3c86f5582e4abd93fc1878c696c0d1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00010","start":369,"end":557,"exact":"Pope Francis was not the only one asking if Israel’s actions are genocide; the United Nations, Amnesty International, Human Rights Watch, and other international actors have said the same."},{"@id":"urn:doxa:passage:ff5bf649a6801bb150b03ce8b5c49f8d86cd545a597141b0895eb40be05950e6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00011","start":0,"end":487,"exact":"Some groups within the Catholic Church view Pope Francis’s stance on Israel’s war on Gaza, where he actively advocated for justice in addition to peace, as conflicting with the principles that uphold the unique relationship between Judaism and Catholicism, with some academics claiming that his statement on the investigation of the genocide accusation against Israel crossed a line, “that of neutrality,” and that his remarks posed a “risk for Israel as a state and for Jews worldwide.”"},{"@id":"urn:doxa:passage:be85ae4325b082a23ff49369160e45984ddae7b5a94a390d584e031d54930f48","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:4f258bc5614258628ba373af35a79adf","blockId":"gv-833828-b00012","start":0,"end":37,"exact":"How this narrative is asserted online"},{"@id":"urn:doxa:decision:6ca71f01a71d1a224b4468f8b1e0b3ae","@type":["doxa:Decision","prov:Entity"],"recordId":"6ca71f01a71d1a224b4468f8b1e0b3ae","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:4f258bc5614258628ba373af35a79adf:u_b2c5c67816911b945fa461bb","attribution":"unknown","speaker":