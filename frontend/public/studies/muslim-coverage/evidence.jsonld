6da73e472ec938695db0192f4cb113f0dab07f0c058b","urn:doxa:passage:0900fd5f4f9d7e151148ab94282cc42e8c6ed064a2d688036448c12a6abf2a38","urn:doxa:passage:4b31d14e7ecf91ef43c0ab35ce2ea298fb2b092d93dadffd6bb18c935406992a","urn:doxa:passage:87a51eb3e6f788de3abfdf14c7baf363dac0ee76de8d9e3e3e0bc11a51ebb608","urn:doxa:passage:3df3b9abd3d07271e2e32e01a9f1a9429f8f5bbf9dbf94ed7b80921bcb7a30a2","urn:doxa:passage:8b51ff1e43813dddd1dab04f9ce216eef39ebb69865748c89d333285d1d82281","urn:doxa:passage:898a7d5c0117e832e8acbc1ba42eb74cb43a5a372050065c8dad5233984b77b7","urn:doxa:passage:bb5f41cea3c2df06417a394d0c4920afa7bf64f24439a10803b18554660f590b","urn:doxa:passage:81e7f5f7323f996cdacd17e6d0b5953720812a63b4e135217db2dbcf5a8b26f0","urn:doxa:passage:d7a3967c4e81635cdbc0541a7efac9ec943a82d3af724a0d89fa37dc20d7aa75","urn:doxa:passage:f6a1978dc92c76201a922266e6cd6e8590d937973df778afc2abc9c6419fcccc","urn:doxa:passage:2624f4cb2d405787343bcd2ec93bd0ddb6050674f91ae313ba84adeac964427a","urn:doxa:passage:185490cc794d0003d90870fddb365bd0a0dbedb55f29e947ebc141412cd5acd3","urn:doxa:passage:8ad1ddb4c13a3416bdc0df75262f5bf28be9357d0b084223e8bf7b0113b2470f","urn:doxa:passage:515d66ea42f53f1431930a8ff340d2b7a806abc4a17eb61050f50c29fd3dea4d","urn:doxa:passage:e7837e27bf7ecc9e3a1496933c636625015f19ebe99ec8c3e17b8e22d4f7bb4c","urn:doxa:passage:71a6bf5a9402020c9a869464f454a68429e0f1c884d582c5a4da566b54c06863","urn:doxa:passage:21467b8819908ca74de0695e9527d64746fb1e3e02eb1639313df6e624cc2b95"]},{"@id":"urn:doxa:passage:d1465eaf542fac7b579da96940b604f02256470ceeb5f054ed846a7edf8b4815","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00016","start":0,"end":232,"exact":"In calling for racial reconciliation, the GHRA made the point that “both sides are quick to see [the murders] as a continuation of earlier ethnic upheavals” and that the country's “electoral saga […] precipitated this tragic event.”"},{"@id":"urn:doxa:passage:feaab8f7353752d16b1e295d54610a8323711c9f75a8c19de02fbd1b3e14a52d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00017","start":0,"end":316,"exact":"Guyana, perched on the edge of a major economic windfall thanks to the discovery of oil and gas reserves, cannot afford the kind of racially motivated violence it saw in the 1960s when the United States played an active role in keeping Indo-Guyanese politician Cheddi Jagan, who had Marxist leanings, out of office. "},{"@id":"urn:doxa:passage:378339713bde851235911cfab2c010b2a7c3997cc8aaf413dfdd319541ce7ef5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00017","start":316,"end":458,"exact":"Hundreds of people were killed and many who were spared fled the country, resulting in a massive brain drain, economic and social instability."},{"@id":"urn:doxa:passage:fcd616a4ebb27168914da56b77501aca7a92753a4408ed84c135cd769ef8288a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00018","start":0,"end":189,"exact":"The mushrooming tensions between the country's two main ethnic groups intensified under the rule of the People’s National Congress, led by Forbes Burnham from 1964 until his death in 1985. "},{"@id":"urn:doxa:passage:00a0b94e585a14f8f32985b418b4e76ef26fbb56ad3fb79d5db39eb45d171d88","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00018","start":189,"end":423,"exact":"Burnham often used state-sanctioned violence to quell dissent, the most infamous example of which was the murder of Black political activist Walter Rodney, although Indo-Guyanese routinely experienced discrimination during his tenure."},{"@id":"urn:doxa:passage:c5fa8d4a05eb3f80cea0a7445d509b3a06ce9777a821b8b043934273b4057991","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00019","start":0,"end":230,"exact":"Racial tensions once more resulted in violence in the early 2000s when 400-plus citizens, most of them Black, died at the hands of criminal gangs linked to the two main political parties and allegedly supported by security forces."},{"@id":"urn:doxa:decision:aebabf6e85cb33c811bc76b2fc533c94","@type":["doxa:Decision","prov:Entity"],"recordId":"aebabf6e85cb33c811bc76b2fc533c94","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:74407d2369921d5c49aba3a78ff3311e:u_e881c4b45e7212a8a645c2ec","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:d1465eaf542fac7b579da96940b604f02256470ceeb5f054ed846a7edf8b4815","urn:doxa:passage:feaab8f7353752d16b1e295d54610a8323711c9f75a8c19de02fbd1b3e14a52d","urn:doxa:passage:378339713bde851235911cfab2c010b2a7c3997cc8aaf413dfdd319541ce7ef5","urn:doxa:passage:fcd616a4ebb27168914da56b77501aca7a92753a4408ed84c135cd769ef8288a","urn:doxa:passage:00a0b94e585a14f8f32985b418b4e76ef26fbb56ad3fb79d5db39eb45d171d88","urn:doxa:passage:c5fa8d4a05eb3f80cea0a7445d509b3a06ce9777a821b8b043934273b4057991"]},{"@id":"urn:doxa:decision:dc4b36bd9be39c26225ea04dff1e05dc","@type":["doxa:Decision","prov:Entity"],"recordId":"dc4b36bd9be39c26225ea04dff1e05dc","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:74407d2369921d5c49aba3a78ff3311e:u_