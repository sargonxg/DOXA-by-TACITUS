ge:c632f6070c51063fead4e605050852cdf66f9bcc5fc32ca9daa075adeb998ca8","urn:doxa:passage:9f364f3b9adcd4c598b1016aef0a2d6a85ac4f61d1455835aed2a9b366cd011a","urn:doxa:passage:29a76e9258a639b44bebac6234bcd1d5c75fd1cd87190df20a58d3a9aaa4f108","urn:doxa:passage:216456266ed983bb44d70d7c4b5dce3fe74fa1ab7ba0170998b3dfb4c02bf8ee","urn:doxa:passage:23640baaa298ec02aeec1b1425e5fa5ff24f80acf33d3ee24783e1f8b9a3296d","urn:doxa:passage:e3f3fea9b0266b77981c23a9a402b018a460713d49c00f877e3dbb0dd6015beb","urn:doxa:passage:24ff1eb4bd4dae1326008f948597aa60e30b8e9c370f8f816335f4bbad379663","urn:doxa:passage:7017f6cc0e30ef6dc83ac96f3b3a57a1951f50f7f0770dc5d1d72441a6893fb8"]},{"@id":"urn:doxa:passage:7f7be907fb15d2851683c0de9f265afbfc49cf597d323cc99e310f1b94ac2497","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00027","start":27,"end":155,"exact":"Internationally, VPN bans have resulted in reduced foreign investment, decreased online commerce, and compromised cybersecurity."},{"@id":"urn:doxa:decision:2ac1b6a63d537d76682df7e2945065eb","@type":["doxa:Decision","prov:Entity"],"recordId":"2ac1b6a63d537d76682df7e2945065eb","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:64e8a641c2650d36f5dfc500d8041324:u_62b412c1fec2818dd4e0a2e9","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:7f7be907fb15d2851683c0de9f265afbfc49cf597d323cc99e310f1b94ac2497"]},{"@id":"urn:doxa:decision:1042c6450a1594c84cc15c030878bc07","@type":["doxa:Decision","prov:Entity"],"recordId":"1042c6450a1594c84cc15c030878bc07","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:64e8a641c2650d36f5dfc500d8041324:u_62b412c1fec2818dd4e0a2e9","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:7f7be907fb15d2851683c0de9f265afbfc49cf597d323cc99e310f1b94ac2497"]},{"@id":"urn:doxa:decision:43df5294e0004c23a92cebc0db7ccd73","@type":["doxa:Decision","prov:Entity"],"recordId":"43df5294e0004c23a92cebc0db7ccd73","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:64e8a641c2650d36f5dfc500d8041324:u_62b412c1fec2818dd4e0a2e9","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:7f7be907fb15d2851683c0de9f265afbfc49cf597d323cc99e310f1b94ac2497"]},{"@id":"urn:doxa:decision:f6f060ce7811239e64263716abf9ad62","@type":["doxa:Decision","prov:Entity"],"recordId":"f6f060ce7811239e64263716abf9ad62","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:64e8a641c2650d36f5dfc500d8041324:u_62b412c1fec2818dd4e0a2e9","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:7f7be907fb15d2851683c0de9f265afbfc49cf597d323cc99e310f1b94ac2497"]},{"@id":"urn:doxa:decision:ec5c7fcbef34dececaa510e527a48a7e","@type":["doxa:Decision","prov:Entity"],"recordId":"ec5c7fcbef34dececaa510e527a48a7e","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:64e8a641c2650d36f5dfc500d8041324:u_62b412c1fec2818dd4e0a2e9","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:7f7be907fb15d2851683c0de9f265afbfc49cf597d323cc99e310f1b94ac2497"]},{"@id":"urn:doxa:decision:c58e01acb8724edc1fddab1f1c7dde3b","@type":["doxa:Decision","prov:Entity"],"recordId":"c58e01acb8724edc1fddab1f1c7dde3b","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:64e8a641c2650d36f5dfc500d8041324:u_62b412c1fec2818dd4e0a2e9","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:7f7be907fb15d2851683c0de9f265afbfc49cf597d323cc99e310f1b94ac2497"]},{"@id":"urn:doxa:passage:7c9d85b5fe5ca0b425e539c51459d1352ac850d1c270a9ceb6c5c9fabf6174a1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00013","start":192,"end":354,"exact":"While Minister Shaza Fatima Khawaja initially blamed VPNs for the disruptions, the PTA later admitted that the firewall had been installed to manage social media."},{"@id":"urn:doxa:passage:a22df4c03e3126493533bf322bff650f5e36f06803e5ec8d81df1dce5c671c49","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00014","start":0,"end":222,"exact":"Ali Ehsan, Senior Vice Chairman of P@SHA, told Global Voices via WhatsApp that the “digital siege” is severely threatening Pakistan's IT industry, pushing it to a critical point with unprecedented operational disruptions. "},{"@id":"urn:doxa:passage:42b1cf2fcfa748e8d873dfe07c9ff9c942ee2ecee122b3abc506b8942a043486","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00014","start":222,"end":370,"exact":"He urged the government to adopt a collaborative cybersecurity framework that safeguards national interests without stifling innovation and growth. "},{"@id":"urn:doxa:passage:6fa629693943f5c35b02c68f9e5c0069e413846c049984b7a55ea5a9f8fde06a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00014","start":370,"end":523,"exact":"Emphasizing that both the economy and reliable internet are national priorities, he added, “Those acting against [them] must reconsider their decisions.”"},{"@id":"urn:doxa:passage:0b80fe5163d64353c4e0031f6e7483a99f6a57e1e2086e1970bf43c86a3ee38f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00015","start":0,"end":61,"exact":"Weaponizing religion and morals to legitimize the ban on VPNs"},{"@id":"urn:doxa:passage:f2220fd8a3812624405086654c2e6c517145e06859fa5fa490ed714fa979ec2d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00016","start":0,"end":232,"exact":"Meanwhile, on November 15, the Council of Islamic Ideology (CII), a constitutional advisory body, issued a fatwa (non-binding religious opinion) declaring the use of VPNs to access objectionable or anti-state content as un-Islamic. "},{"@id":"urn:doxa:passage:4496682690dd3614cef59f0c78cddb7bed2022b9d2647399bfd729880c152e35","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00016","start":232,"end":310,"exact":"This decision sparked criticism from the public and digital rights activists. "},{"@id":"urn:doxa:passage:81330d1bfbb93a860a22dcea115b03a8cb7f506992272956072209063875f48b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00016","start":310,"end":485,"exact":"Even Rana Sanaullah, a Member of the National Assembly from the ruling party — Pakistan Muslim League (Nawaz) — asserted that the CII had no authority to comment on the issue."},{"@id":"urn:doxa:passage:8a4d12e9b70555b9600ea48af7932b1511a85b2ba3572b195f6b60bd0974ec09","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00017","start":0,"end":320,"exact":"In response to the backlash, the CII held a press conference and conveniently clarified that “only registered VPNs are permissible under Sharia.” The chairman emphasized that “social media should promote Islamic values and national security” and stressed the importance of the ethical and lawful use of social platforms."},{"@id":"urn:doxa:passage:5cf4f24c02210a034222dfaa919e68bb6c3753d58de2fc97371a6152a71f043e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00018","start":0,"end":123,"exact":"Global Voices reached out to Barrister Ali Tahir via WhatsApp regarding the role of the Council of Islamic Ideology (CII). "},{"@id":"urn:doxa:passage:f8961670d1b882e2c9efbdbc302bf51f79b7749e883c2905617c2b2413bef768","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00018","start":123,"end":131,"exact":"He said:"},{"@id":"urn:doxa:passage:60eaefefbf0ee3ed843ebc7676d17f48d240878364926bda2b962d447900e4bf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00019","start":0,"end":113,"exact":"> The CII has often been politically exploited, including its recent involvement in justifying VPN restrictions. "},{"@id":"urn:doxa:passage:e0d01678166304d047bdbee5292557d4a3f3d878ac10ec6edd670c5e3c9bcd25","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00019","start":113,"end":249,"exact":"The Pakistan Telecommunication Authority's move to register VPNs appears aimed at controlling access, yet efforts have largely faltered."},{"@id":"urn:doxa:passage:07cb787df7926354c8c165939154eabe1705491ec67e2530e0a27fd017aa1852","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00020","start":0,"end":287,"exact":"Civil society and the Human Rights Commission of Pakistan (HRCP) have long advocated for the disbanding of the Council of Islamic Ideology (CII), accusing it of holding regressive views that enable the state to manipulate religion to suppress dissent and justify violence against women. "},{"@id":"urn:doxa:passage:3e0eaf9fb43de310d7f7433095556c2cf0b77938636af31f891f1e400794186d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00020","start":287,"end":455,"exact":"Critics argue that the CII functions as a tool to legitimize government actions under the guise of morality, often reinforcing conservative and discriminatory policies."},{"@id":"urn:doxa:passage:c6aadde8a0265ccabab81945eac7d55f10ff4437cb5d7a1a6181e51ced0f24b1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00021","start":0,"end":40,"exact":"The military's role in digital oversight"},{"@id":"urn:doxa:passage:973fa9cb14beadf8e50b096486b191c4475f3cd596f9fb8588b37960a50f3900","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00022","start":0,"end":199,"exact":"On November 15, the country's most powerful figure, Chief of Army Staff (COAS) General Asim Munir, called for controlling “unrestricted” freedom of speech, linking it to the erosion of moral values. "},{"@id":"urn:doxa:passage:a84a8195c97d61ed9055bc8bb0bfb6a703e9b287c7cb2e62aebb9378218d07b9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00022","start":199,"end":488,"exact":"The military, which has faced increasing scrutiny on social media, has labeled criticism and fake news as “digital terrorism.” Recently, Director General of the Inter-Services Public Relations (ISPR) Ahmed Sharif Chaudhry, stressed the need for stricter measures to curb online propaganda."},{"@id":"urn:doxa:passage:c6298d56890e46c8b7cdd03cf338308a694624f3c5b1dc6f85913a5f38a28ecb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00023","start":0,"end":150,"exact":"Tahir criticized the government’s use of morality and religion as justifications for digital restrictions, citing the Twitter ban as a prime example. "},{"@id":"urn:doxa:passage:dd8c28e0ca0f61706623d45e2feef79cc444f2cb954195ffdbdbbe1269f43acc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00023","start":150,"end":372,"exact":"While officials argue these measures are intended to combat terrorism and immoral content, Tahir contends that they are primarily aimed at suppressing social media criticism and labeling dissenters as “digital terrorists.”"},{"@id":"urn:doxa:passage:3b10e725ed12a9dc856c0d6cf37a37dd2aac752740ca4254d37ee90102ed60f7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00024","start":0,"end":52,"exact":"VPNs and the IT sector in Pakistan: A growing crisis"},{"@id":"urn:doxa:passage:bb17d5e6f3968ea5d779e100db0158afb383121154b7e8f6fe20919fd1da0267","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00025","start":0,"end":155,"exact":"The use of VPNs has become increasingly prevalent globally, with over 30 percent of internet users employing VPNs to ensure online security and anonymity. "},{"@id":"urn:doxa:passage:40d6b39e5c40261295c9b5d716ebc1e77aea0f38b59f00bd098ce2c4cdc704f3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00025","start":155,"end":322,"exact":"On the other hand, some countries have implemented or considered VPN bans, citing concerns over national security, cybercrime, and intellectual property infringement. "},{"@id":"urn:doxa:passage:30cfc8a47aa944582e13997c30a5277a2fd8b8134368e0e2c354f951806bffe9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00025","start":322,"end":418,"exact":"Pakistan's proposed VPN regulations have sparked concerns among IT professionals and businesses."},{"@id":"urn:doxa:passage:b5637581065c4f2cebdda98e3e6517948849522b68d22b99670ce50208635e2d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00026","start":0,"end":99,"exact":"The impact of banning VPNs can be far-reaching, with significant economic and social consequences. "},{"@id":"urn:doxa:passage:cf7c12e612c70c51fd9d17bf081d7bfbd1c651acd03436c88f9da286545b7bcd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00026","start":99,"end":167,"exact":"In Pakistan, the proposed ban is expected to cost the economy around"},{"@id":"urn:doxa:passage:b5d881ea0b799aa8287192469873577295fb654ab765bdd35090cc5282954dc6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00027","start":0,"end":27,"exact":"USD 300 million per annum. "},{"@id":"urn:doxa:decision:54a677ae4854f8c9d9e49ebcd5bfbb07","@type":["doxa:Decision","prov:Entity"],"recordId":"54a677ae4854f8c9d9e49ebcd5bfbb07","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:64e8a641c2650d36f5dfc500d8041324:u_aca514d25f1b6bd3385d8592","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:7c9d85b5fe5ca0b425e539c51459d1352ac850d1c270a9ceb6c5c9fabf6174a1","urn:doxa:passage:a22df4c03e3126493533bf322bff650f5e36f06803e5ec8d81df1dce5c671c49","urn:doxa:passage:42b1cf2fcfa748e8d873dfe07c9ff9c942ee2ecee122b3abc506b8942a043486","urn:doxa:passage:6fa629693943f5c35b02c68f9e5c0069e413846c049984b7a55ea5a9f8fde06a","urn:doxa:passage:0b80fe5163d64353c4e0031f6e7483a99f6a57e1e2086e1970bf43c86a3ee38f","urn:doxa:passage:f2220fd8a3812624405086654c2e6c517145e06859fa5fa490ed714fa979ec2d","urn:doxa:passage:4496682690dd3614cef59f0c78cddb7bed2022b9d2647399bfd729880c152e35","urn:doxa:passage:81330d1bfbb93a860a22dcea115b03a8cb7f506992272956072209063875f48b","urn:doxa:passage:8a4d12e9b70555b9600ea48af7932b1511a85b2ba3572b195f6b60bd0974ec09","urn:doxa:passage:5cf4f24c02210a034222dfaa919e68bb6c3753d58de2fc97371a6152a71f043e","urn:doxa:passage:f8961670d1