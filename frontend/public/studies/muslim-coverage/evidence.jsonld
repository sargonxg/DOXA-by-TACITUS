doxa:passage:7ed75573b66969cb95c19d3626ed48f985777a6328fb4cfd56f364ced9d4557e","urn:doxa:passage:28b502c1f59bf2122cdc58823ab9e1d9047673328415e99ba2011a4542bc24ae","urn:doxa:passage:af50991349f2e358c2cbb6db6cd26510965450b05152da30062d9dbe0889aa84","urn:doxa:passage:5db83e71bf2c8032a5d5e6341ba65151ddf286ea640202761525ec73926f8ba0"]},{"@id":"urn:doxa:passage:9392d1b882ef3b02555f99f81e4a8f38d8b2242428250a64d2ae27379d9260ed","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00019","start":55,"end":211,"exact":"The current administration has expressed an interest in ending perpetual wars, bringing peace to the Middle East, and countering jihadist groups like ISIS. "},{"@id":"urn:doxa:passage:128f1ab219fab15354ff685b37d111612b4c8cfeae1151eeb814423b3d4182a2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00019","start":211,"end":314,"exact":"Consequently, Washington has an interest in making sure that Turkey takes this peace process seriously."},{"@id":"urn:doxa:passage:7b8c75b8e730409867a5708e231ec72e6c21800b47ff2ae175cb45499047fa9b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00020","start":0,"end":161,"exact":"The U.S. should support the maintenance of existing ceasefires in Syria and the creation and observation of a bilateral Turkey-PKK ceasefire in Turkey and Iraq. "},{"@id":"urn:doxa:passage:01c73d8a3a251c474b6870de1c5ce7d061b81fa474d4e39abffffdb9d8146ae7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00020","start":161,"end":436,"exact":"It should urge Turkey to align with existing domestic and international legal standards by ending the persecution of non-violent Kurdish politicians and releasing political prisoners, like jailed HDP co-chair Selahattin Demirtas, to undermine the appeal of armed resistance. "},{"@id":"urn:doxa:passage:280ad6b1b03294f1ad42da58c2a0fa656a835d8471f10474fa2ffde3570e7727","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00020","start":436,"end":697,"exact":"It should take this opportunity to showcase the SDF’s independence from the PKK by staying the course in Syria: keeping the pressure on ISIS and facilitating a political settlement where Syrian Kurds find a place in the country’s government and security forces."},{"@id":"urn:doxa:decision:04a9acbdfbda74b1dec04dd38fd437e2","@type":["doxa:Decision","prov:Entity"],"recordId":"04a9acbdfbda74b1dec04dd38fd437e2","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:22a4e2e437241fb16020940b0e08cf04:u_fc6fca53f8b0867d3c33db2c","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:9392d1b882ef3b02555f99f81e4a8f38d8b2242428250a64d2ae27379d9260ed","urn:doxa:passage:128f1ab219fab15354ff685b37d111612b4c8cfeae1151eeb814423b3d4182a2","urn:doxa:passage:7b8c75b8e730409867a5708e231ec72e6c21800b47ff2ae175cb45499047fa9b","urn:doxa:passage:01c73d8a3a251c474b6870de1c5ce7d061b81fa474d4e39abffffdb9d8146ae7","urn:doxa:passage:280ad6b1b03294f1ad42da58c2a0fa656a835d8471f10474fa2ffde3570e7727"]},{"@id":"urn:doxa:decision:38276c582062367ea52d8a580fa304cc","@type":["doxa:Decision","prov:Entity"],"recordId":"38276c582062367ea52d8a580fa304cc","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operation