redUnit":"urn:doxa:unit:400fa8599e639ce8e5cc16adb1831ee8:u_88b8fdca8149d9ea8fc0c386","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:eb95a31cfb870dc7ec3ffb5fbca6d0779fc8e9c759322bee89e83966d1c56b11","urn:doxa:passage:a208d54894c1386190bdd693a18122caf46bc446cbbbcc46ff66d3be3b0cfd8b","urn:doxa:passage:0024d1bdea0893340fd75cdb8f9bdaa23f5c623f7981174813664f49534f40d9","urn:doxa:passage:c21d2b85180c4edb167d1abdf20e4177cf60cb7ff99fe11d07729c57883865c0","urn:doxa:passage:3bcb8cf13c35d1a52c11455b81bb152cc684c9640a7aba8a96d634c304e7f544","urn:doxa:passage:7668e5112a20e56464d7b01447d3501afa1552376c02ddcbd5f3ee672e12fe3b","urn:doxa:passage:aef6641189b3a232de6727e4ccccd097af9ef17f9ef35105c4efbe2f1bdd779b","urn:doxa:passage:379c1ddedf8bfb593ac2d32644c323881f5288714e2ebc46df6d4a0a30408bbe","urn:doxa:passage:6bbb82d8df422b4476e907f676ccca95dcb2654b4f7395cfa6c4949bc5a10b41","urn:doxa:passage:f0122828fc3e9aa8ccb4bc600b51339d791e8305edd79576be74df4f36d11b8b","urn:doxa:passage:bef8511a8414226d243237daa3e4bf9c62f6183d41fea5417eeb624f33f554fd"]},{"@id":"urn:doxa:decision:10ab5580ad7333eaff42259416e6f5f2","@type":["doxa:Decision","prov:Entity"],"recordId":"10ab5580ad7333eaff42259416e6f5f2","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:400fa8599e639ce8e5cc16adb1831ee8:u_88b8fdca8149d9ea8fc0c386","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:eb95a31cfb870dc7ec3ffb5fbca6d0779fc8e9c759322bee89e83966d1c56b11","urn:doxa:passage:a208d54894c1386190bdd693a18122caf4