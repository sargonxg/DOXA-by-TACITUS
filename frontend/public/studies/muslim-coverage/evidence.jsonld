passage:1d7eb886010026b99bba26b1aebd480942f24ae9d1389fdf41b2c748a7a9f2ef","urn:doxa:passage:1160d45bc8b06d9e432a855c5080101dfa7b590909c4be193c66abea486fd9e3","urn:doxa:passage:0bb1c39b51ef6c16315293eba49622a4f5f39efb55c5ca5dfaaeaa40c9b8cab1","urn:doxa:passage:71671914b587dd198c543144526271a2aebc5cc108cce471e5b83b803ffe876a","urn:doxa:passage:3d98aec2e7bf961f5aa646c81f92f888ff0789ab5766f74c7349df9824daa1ea","urn:doxa:passage:d7355ca290f0ba2e93e25c4756240666fb3da0a99caf093b77ed53f851e8ea58","urn:doxa:passage:9e491c11883852454bd4458f1d478a8f7b0985690d5ab6abaadbed7dbc130b88","urn:doxa:passage:6db903ce62ea1c62a4c2cb9fcc631d0a5ec62a713330e5daca0d35987abc116b","urn:doxa:passage:39bc9f291ee8b5d413e9ba9bbb3729b20d47666ecbaa598ce6a29ce08b8859a5","urn:doxa:passage:dcfacc212a182f312e0a9774963d7f2f3a4d87e2c380b0acd5bc720cfd37c1ff","urn:doxa:passage:8faa9fea2ec2f38996ff00a9a76d2fd85719ba35664453317e5801c6fa7c57e5","urn:doxa:passage:df6f12b2ab307abc191ed285a533716d57fe8fc7d9a52734ccccb8ede275e0b4","urn:doxa:passage:490fba85f0c83c89393f433363b3bcb9a9f47f5800e2a85d0d4fcf0cceb21cfc","urn:doxa:passage:b9c6308ca37faae159b7c9eb20d5fd7acc1c4ec28ad1a5812a675d77126d147a","urn:doxa:passage:e302b1c215903283e3bd363d581a39d884446b270ab03508f47d267e1471a168","urn:doxa:passage:9da36daab08dde2eea3895fdec2ff299845625ded48513b9965f4b8a2c74aa8e","urn:doxa:passage:d1ce0571aff27bae80b5d9016eaecda769e6e381b58d8c00349f7f6da41367d1","urn:doxa:passage:dd73ae6e5375f81a190d7453446213bc6371dd4900dd63f47f4c0adb7dfcb841","urn:doxa:passage:6f505eca9b0e0474302606b5fb55b13fc2d06c232f647ae822915ea3765466f9"]},{"@id":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-843525","title":"The great silence surrounding marital rape in Senegal","author":"Blogueurs invités","translator":["Jean-Christophe Brunet"],"publishedOn":"2025-10-01","sourceUrl":"https://globalvoices.org/2025/10/01/the-great-silence-surrounding-marital-rape-in-senegal/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"e8e520061ca8d28e010f4fbb531150e54aed853fc907a4145c1ef8d4aac689ea","textSha256":"e2074e4f33e291190475991a2a7d79e1c7a2e6c8f2a205d33d7dd081ea2a12a9","archivedRecordSha256":"09d844ca5013a4c856194513fefbb4ed2c6f9b9993f46c8d5d08595fc25ebd34","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:f081e0c7a57b05f9837952eec8d04cb8:u_a3508e3cb185070509ec34ee","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_a3508e3cb185070509ec34ee","status":"accepted","fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8"},{"@id":"urn:doxa:unit:f081e0c7a57b05f9837952eec8d04cb8:u_c9eb23bc247977c00c54aaf5","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_c9eb23bc247977c00c54aaf5","status":"accepted","fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8"},{"@id":"urn:doxa:passage:e83d292a8fd09ba4f769cfe4b786d6e9f74ba07cab9a983109876691894934c9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00014","start":120,"end":281,"exact":"This dissonance between the law, public discourse, and women’s lived reality highlights the urgent need for legal reform and a clear stance from the authorities."},{"@id":"urn:doxa:passage:7d53c4611c3938e9ae11335210174d94917853dd0ed557eecf65e8b29df15a19","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00015","start":0,"end":167,"exact":"By normalizing marital rape, this official rhetoric entrenches an absolute claim over women’s bodies and heavily compounds the moral weight borne by potential victims."},{"@id":"urn:doxa:passage:ea4b43923473dbe89eca8dca79cff2764b872c610b1f88a9586709ff18c290a8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00016","start":0,"end":113,"exact":"Equality Now’s 2024 report shows that the legal recognition of marital rape differs significantly across Africa. "},{"@id":"urn:doxa:passage:987c550e5c51ec8c5c752a280dc4e142d42741c4ff725d088b5d6d062df4eb10","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00016","start":113,"end":271,"exact":"The report notes that countries such as Benin, Burkina Faso, Burundi, Côte d’Ivoire, Gabon, Madagascar, Senegal, and Togo explicitly criminalize marital rape."},{"@id":"urn:doxa:passage:61c740f343947cb3b9fefa6ab6afc42e62c4338026ffd459b5c7f4f20b77cdb2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00017","start":0,"end":174,"exact":"In countries including Gambia, Equatorial Guinea, Eritrea, Ethiopia, South Sudan, and Tanzania, spouses are explicitly exempted from prosecution, except in exceptional cases."},{"@id":"urn:doxa:passage:9afdee8986cd9504837ca420d79719ed3a14dae879808d18402817102deda7d1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00018","start":0,"end":197,"exact":"In Cameroon, the Central African Republic, Congo-Brazzaville, the Democratic Republic of Congo, Guinea, Mali, Uganda, and Chad, the law remains silent on the matter, creating a complete legal void."},{"@id":"urn:doxa:passage:00f3046a964aa82d5a04b5d5db57d429eda770e8f1a66d9502f62c3e18187869","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00019","start":0,"end":100,"exact":"Senegalese law on rape and paedophilia, revised in 2020, sets out the definition of rape as follows:"},{"@id":"urn:doxa:passage:186004be38faaefdb441c557b9c1a96960e34408249aea92e3d59d1b9b76e48d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00020","start":0,"end":83,"exact":"> Tout acte de pénétration « commis par violence, contrainte, menace ou surprise »."},{"@id":"urn:doxa:passage:d8b13761dc1ad5c3cf317552952c1e2e3fe5ddd2bea4610ebb1b15fa261ab9d9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00021","start":0,"end":80,"exact":"> Any act of penetration ‘committed by violence, coercion, threat, or surprise.’"},{"@id":"urn:doxa:passage:4c8cd7905a83722efc85665f5293808a00e8dac2240bf9e97d2f71e7c73129a2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00022","start":0,"end":159,"exact":"However, the lack of clear legal provisions on marital rape and spousal consent creates a wide scope for interpretation, often to the detriment of the victim. "},{"@id":"urn:doxa:passage:742c093e02a9ef28ba26e6a6ccd0d50ddf57101002b66b60e1f60cc3565f3e50","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00022","start":159,"end":289,"exact":"As a result, marital rape is often treated as an ordinary form of domestic violence, rather than classified as a criminal offence."},{"@id":"urn:doxa:passage:fe37fb8bfb0412308b20ccb12167f7a02ad8898043418888914622bcaeb25c83","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00023","start":0,"end":260,"exact":"In Côte d’Ivoire, for example, an investigation by the French newspaper Le Monde published in February 2024 reported that a humorous TikTok video mocking women’s sexual fatigue sparked amused reactions — evidence that sexual non-consent is not taken seriously."},{"@id":"urn:doxa:passage:5fe779ea05e78715b93be361448275ca7b057832d8e18f879e0d93f310cbc547","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00024","start":0,"end":213,"exact":"According to figures published in African Health Sciences, 33 percent of women in Africa have been subjected to sexual violence at some point in their lives, with rates rising to 44 percent in sub-Saharan Africa. "},{"@id":"urn:doxa:passage:e7302993f4fd2c72d9506b24cc5b9b700bf4d673a95de4e0c9ef3dd23afd8949","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00024","start":213,"end":338,"exact":"In Côte d’Ivoire, 40 percent of women housed in the shelter run by the NGO Akwaba Mousso say they have suffered marital rape."},{"@id":"urn:doxa:passage:031f791fe6288528c2dbda60ee31433ec3aec1c79fb380f8a43a3787038e3a30","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00025","start":0,"end":190,"exact":"In many African legal systems, including in Senegal and Côte d’Ivoire, the implicit presumption of consent between spouses prevents marital rape from being effectively recognised as a crime."},{"@id":"urn:doxa:passage:81a3ca1641d77760ff5cfaeda8ff0070c14fe5cb861f47bc601e965e0bbe1fa2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00026","start":0,"end":82,"exact":"When feminists raise awareness on the subject, the issue is frequently minimised. "},{"@id":"urn:doxa:passage:4d1cd4d992c6fbf6940bc2a13436a70326eeb0d4455cc6025837ab8bd5224f5b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00026","start":82,"end":236,"exact":"In the previously mentioned Le Monde article, Ivorian activist Marie-Paule Okri, co-founder of the Ivorian League for Women’s Rights, told the journalist:"},{"@id":"urn:doxa:passage:08cfcb098c8d2c905b62e1ebc08f31367a5dd1788cab202b76bbd258a744229f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00027","start":0,"end":61,"exact":"> Quand on essaie d’en parler, on nous répond qu’on exagère. "},{"@id":"urn:doxa:passage:4c6829dde90fd4ec09fbc202af4fac86c3bf84b7faa4cd9fcc60017631c7abfa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00027","start":61,"end":166,"exact":"On nous inculque depuis l’adolescence que le corps de la femme est fait pour donner du plaisir à l’homme."},{"@id":"urn:doxa:passage:25f495a19b298e71215a8133b73a8b319d3068ee05f7670f4c49ecadf9e19b4f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00028","start":0,"end":65,"exact":"> When we try to talk about it, we are told we are exaggerating. "},{"@id":"urn:doxa:passage:d2d16265d2c7f1a487a1cc625fa324bc0103531250aeb8a91d87cd9c52ae12a6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00028","start":65,"end":148,"exact":"From adolescence, we are taught that a woman’s body exists to give pleasure to men."},{"@id":"urn:doxa:passage:4bde940da77d845cfc64d354790999121eadb90eaaa09e678edde78e6643c1cf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00029","start":0,"end":147,"exact":"Yet Article 14 of the Maputo Protocol commits African states to guaranteeing women’s fundamental rights, including health and reproductive consent."},{"@id":"urn:doxa:passage:36eb1e8acd475a32041063b5a132f5541f1b00b556157e4064d839db1e01d7b4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f081e0c7a57b05f9837952eec8d04cb8","blockId":"gv-843525-b00030","start":0,"end":157,"exact":"Beyond legislation, it will take a deep change in attitudes to improve women’s condition, grounded in respect for their bodies and equality in relationships."},{"@id":"urn:doxa:decision:cface02c900a10c59731b9191120ade3","@type":["doxa:Decision","prov:Entity"],"recordId":"cface02c900a10c59731b9191120ade3","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:f081e0c7a57b05f9837952eec8d04cb8:u_a3508e3cb185070509ec34ee","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:e83d292a8fd09ba4f769cfe4b786d6e9f74ba07cab9a983109876691894934c9","urn:doxa:passage:7d53c4611c3938e9ae11335210174d94917853dd0ed557eecf65e8b29df15a19","urn:doxa:passage:ea4b43923473dbe89eca8dca79cff2764b872c610b1f88a9586709ff18c290a8","urn:doxa:passage:987c550e5c51ec8c5c752a280dc4e142d42741c4ff725d088b5d6d062df4eb10","urn:doxa:passage:61c740f343947cb3b9fefa6ab6afc42e62c4338026ffd459b5c7f4f20b77cdb2","urn:doxa:passage:9afdee8986cd9504837ca420d79719ed3a14dae879808d18402817102deda7d1","urn:doxa:passage:00f3046a964aa82d5a04b5d5db57d429eda770e8f1a66d9502f62c3e18187869","urn:doxa:passage:186004be38faaefdb441c557b9c1a96960e34408249aea92e3d59d1b9b76e48d","urn:doxa:passage:d8b13761dc1ad5c3cf317552952c1e2e3fe5ddd2bea4610ebb1b15fa261ab9d9","urn:doxa:passage:4c8cd7905a83722efc85665f5293808a00e8dac2240bf9e97d2f71e7c73129a2","urn:doxa:passage:742c093e02a9ef28ba26e6a6ccd0d50ddf57101002b66b60e1f60cc3565f3e50","urn:doxa:passage:fe37fb8bfb0412308b20ccb12167f7a02ad8898043418888914622bcaeb25c83","urn:doxa:passage:5fe779ea05e78715b93be361448275ca7b057832d8e18f879e0d93f310cbc547","urn:doxa:passage:e7302993f4fd2c72d9506b24cc5b9b700bf4d673a95de4e0c9ef3dd23afd8949","urn:doxa:passage:031f791fe6288528c2dbda60ee31433ec3aec1c79fb380f8a43a3787038e3a30","urn:doxa:passage:81a3ca1641d77760ff5cfaeda8ff0070c14fe5cb861f47bc601e965e0bbe1fa2","urn:doxa:passage:4d1cd4d992c6fbf6940bc2a13436a70326eeb0d4455cc6025837ab8bd5224f5b","urn:doxa:passage:08cfcb