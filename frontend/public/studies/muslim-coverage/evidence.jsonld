2ce41846a944ad76adddfcac3e4665bdf9b2f84f70","urn:doxa:passage:b867b4144dfac0d6a38b44d3a4d8a137f0d0b346d9a9e660f9f55faeb67f0eab","urn:doxa:passage:02aa3a0c6455bf9daa50422e86c5a51f20594c8f133cd231f13ed8cb540d49c3","urn:doxa:passage:851e407909c58252d4e30cf863402b929a931ee3bcd5036154f926a43c94ab21","urn:doxa:passage:c26b9b3eaa934f01fd9437861e0c81628bf4fe7a207fa2a36df3da73a6f52c6b"]},{"@id":"urn:doxa:decision:1b1bc7190e5d88d8211aa4c7cf2e55bf","@type":["doxa:Decision","prov:Entity"],"recordId":"1b1bc7190e5d88d8211aa4c7cf2e55bf","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:80c5cac76de53b70b4f99ff6e5a1adad:u_0d1c486d602cf003693c61ba","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:0ff89507a23c3d542651fac666c8bcb746e41cade186bb174bf6037639635a32","urn:doxa:passage:0766d8dbc17a07ec3b764c3193969f1aa1642c76d12210c9590dfecd9be728e6","urn:doxa:passage:248a227149ebc0b5e6c6406588ad0d79b735fe53500214f03594f3f4415bbb1a","urn:doxa:passage:da2598c61d74a6856a56cd2ce41846a944ad76adddfcac3e4665bdf9b2f84f70","urn:doxa:passage:b867b4144dfac0d6a38b44d3a4d8a137f0d0b346d9a9e660f9f55faeb67f0eab","urn:doxa:passage:02aa3a0c6455bf9daa50422e86c5a51f20594c8f133cd231f13ed8cb540d49c3","urn:doxa:passage:851e407909c58252d4e30cf863402b929a931ee3bcd5036154f926a43c94ab21","urn:doxa:passage:c26b9b3eaa934f01fd9437861e0c81628bf4fe7a207fa2a36df3da73a6f52c6b"]},{"@id":"urn:doxa:passage:e4f1a4d5e8057ddbcee7530979c266de1cf0105307f0627c5e5982f8498454c2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00015","start":0,"end":111,"exact":"Surprisingly, civil rights activists in Iran have seldom protested against the labeling of minorities as najis."},{"@id":"urn:doxa:passage:276672dc7d487eaa8b03bc92cef97daa8fc670f7a8f7603549a5841ca927e2d6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00016","start":0,"end":39,"exact":"Entertainment: Dominance and defamation"},{"@id":"urn:doxa:passage:26944238b6d0e640ed29a53d5b67132a5fd47ef3f425a67ddb301e2a883b1afd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00017","start":0,"end":304,"exact":"In addition to the constant presence of Islamic programs and clerics promoting the state's version of Islam, television and state controlled film production in Iran feature numerous films that propagate Islamic values and ideology across various genres, from comedies to social or war-themed productions."},{"@id":"urn:doxa:passage:721208d50bf7046e7c88543b93add9433a5ce9b743ef439bbc107f09490ca644","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00018","start":0,"end":158,"exact":"Over the four decades of rule by the mullahs alongside the Revolutionary Guard (IRGC), some films portray them in a one-dimensional and propagandistic light. "},{"@id":"urn:doxa:passage:5fc0f941f2b737f272cb03575d81d60989b667a156d7235d53772014071069a0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00018","start":158,"end":411,"exact":"The mullahs are depicted alternatively as simple mystics who earned their living through hard work and helping others, or as clergymen victimized by their own family's corruption but fighting for justice (for example, Rooze Balva, meaning “Riot's day”)."},{"@id":"urn:doxa:passage:66afa75c02c340f0bed53ec9d4212e5cd0afa501d8b7ea39e8bbfffc73cf5a50","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00019","start":0,"end":192,"exact":"Dialogue in some films easily categorizes people into “Muslims” and “infidels” or “outsiders” (see Shahr-e-Mahtabi, meaning “Moonlight city”), where there is no place for religious minorities."},{"@id":"urn:doxa:passage:087a28492e9024ac230e55f7a4c06f95197ba0b8b34a5089187c3196fea1f9e6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00020","start":0,"end":192,"exact":"The Iranian Jewish community, in an open letter to the head of Iranian TV 19 years ago, criticized and protested the broadcast of a series “Dasiseh” (conspiracy) that “insults their religion.”"},{"@id":"urn:doxa:passage:e48d9b296a64428aa0d94f7baae26aeadf46a99fdc92c1e64d8953de69e43689","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00021","start":0,"end":59,"exact":"Ideology and urbanism: Feeling like a stranger in your city"},{"@id":"urn:doxa:passage:a514140fc0f240c49da8ca0014f22f613cb9c4da4b275336e83c0266fdbecbf2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00022","start":0,"end":196,"exact":"Since the early days of the Islamic revolution, the regime has imposed its ideological signs and symbols on every corner of cities conveying a clear message: the public space belongs to the state."},{"@id":"urn:doxa:passage:c15772b836a301cd77597ee0649552ee49e1be171a815f09e18dda936c4d669b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00023","start":0,"end":172,"exact":"Joshua Hagen, dean of the College of Letters and Science at the University of Wisconsin-Stevens Point, who wrote on Nazis and urbanism, explained to Global Voices on email:"},{"@id":"urn:doxa:passage:ad77b2f0747c900e5b6d498111260b75dbc1e4a1e66fdce88c8260e203c933f8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00024","start":0,"end":146,"exact":"> …sponsorship of murals, posters, banners, and other public displays serves political agendas, marginalizing or excluding various social groups. "},{"@id":"urn:doxa:passage:affc4ff61767b6f970b64cac92df774c988a7640a7a11075036d820ba6f21468","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00024","start":146,"end":385,"exact":"In Iran, efforts to communicate regime ideology through public space act as constant reminders, pressuring individuals to conform to the regime's wishes or, at the very least, understand the consequences of diverging from regime ideology. "},{"@id":"urn:doxa:passage:1ddcef93070bd585b47d3e56253313018750edd7c9ec3be8027e5174ff8b2298","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00024","start":385,"end":526,"exact":"This dynamic, present in both democratic and non-democratic contexts, is a common feature of human behavior and engagement with public space."},{"@id":"urn:doxa:passage:fbe6344df4c06f59b6a52779edf8f82d52f23f67b1dc73eea2fa218c51711e04","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00025","start":0,"end":198,"exact":"Alongside the Islamic and revolutionary names of public places, municipalities, and government foundations, citizens are surrounded by slogans and Islamic values through banners and wall paintings. "},{"@id":"urn:doxa:passage:cf29626fc666d3fbc7bf71d65503b66ec75364eb4240ce0632fad331de659295","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00025","start":198,"end":386,"exact":"Governmental institutions decorate public places, such as schools, with murals featuring verses and quotes from the prophet of Islam and Shi'a imams, praising Islamic values such as hijab."},{"@id":"urn:doxa:passage:00b3648b00cba5e657169dacad915956597a04bd32555fbf268100d00fd389fc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00026","start":0,"end":450,"exact":"The Islamic Republic also eliminates many signs of religious minorities from the urban landscape, even attempting to control the “afterlife” for several religious minority communities by destroying their referential and symbolic places and monuments, for example, by destroying Baha'i cemeteries, depriving Christian converts of their graveyard, or making changes to the Kharavan cemetery where many executed political prisoners were secretly buried."},{"@id":"urn:doxa:passage:1c80d0aced09bd6dcdb98dc73ba9b1b0ce522b623b213bbe5dfc9c3dd71a4f77","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00027","start":0,"end":25,"exact":"Resistance and creativity"},{"@id":"urn:doxa:passage:7b3dfb178cfea4d9be134e73290a8a27fef76288883f48624729bdb06f9e9e77","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00028","start":0,"end":101,"exact":"In the face of government violence and cultural aggression, minorities have demonstrated resilience. "},{"@id":"urn:doxa:passage:6eba0b0bc9555d5b9304fa36d4f4596711fcd23360d1d4899cb5454a04e9dc2d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00028","start":101,"end":269,"exact":"The Iranian government expelled Baha'i students and denied them education, prompting the establishment of the Baha'i Virtual University as an alternative organization. "},{"@id":"urn:doxa:passage:681375adf6e1bf96f7e95e33c35c2fcb9f610734b0c6b6ec9295bbe3fe196cf6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00028","start":269,"end":505,"exact":"Persian-speaking Christians faced a lack of worship spaces and educational centers, but the underground house churches are active in the country, despite mass arrests and repression and the converts launched a “place2worship” campaign. "},{"@id":"urn:doxa:passage:1aeae67189b7c200a1641fd66234cbef533d0a3d12cb000c9169242429b8a39e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00028","start":505,"end":584,"exact":"The Yarsan minority employs art and music to resist de-identification policies."},{"@id":"urn:doxa:passage:37af2759e9ab4368abbae815147e325f7a7166bf138e5483b9397a3aedb23ee6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00029","start":0,"end":116,"exact":"Simultaneously, individuals outside the religious minority community have actively joined the campaign for equality."},{"@id":"urn:doxa:passage:9edc741a1509a34cbc6935a47e66390edd7bfc7b73b8edf928231d2bf29a76a6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00030","start":0,"end":231,"exact":"In response to grand ayatollahs denouncing pagans, communists, atheists, and Baha'is as “unclean,” Mohammad Nourizad, a political activist and journalist, invited people to visit Baha'i and atheist houses and share food with them. "},{"@id":"urn:doxa:decision:7111c1a82c4748963530509119215e75","@type":["doxa:Decision","prov:Entity"],"recordId":"7111c1a82c4748963530509119215e75","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUni