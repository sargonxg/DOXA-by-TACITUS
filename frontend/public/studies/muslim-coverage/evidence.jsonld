oxa:passage:1aafb96901838a45837ed0231c5e58d9aae73ac7d15a445f8e04d5cd92fc869b","urn:doxa:passage:a004e764a343fb003706925cd57ccce8f7c6babe42d884e22da5745e137fa993","urn:doxa:passage:6daece7906cd5dc48ad11c59492bf6033bee2e56226ed2d87e52795bec84e095","urn:doxa:passage:2844607b4c1d11917206b1d18da330a64c7b3590d706412dedc3e8159a68dffb","urn:doxa:passage:8b3fa3feeebcc3793a8423d4aecfedfa685785d65cc5aff4dcaa4fb98aaa375c"]},{"@id":"urn:doxa:passage:eb95a31cfb870dc7ec3ffb5fbca6d0779fc8e9c759322bee89e83966d1c56b11","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00012","start":461,"end":536,"exact":"As if all of us, and me, especially myself, are a continuation of the war. "},{"@id":"urn:doxa:passage:a208d54894c1386190bdd693a18122caf46bc446cbbbcc46ff66d3be3b0cfd8b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00012","start":536,"end":556,"exact":"The integral whole. "},{"@id":"urn:doxa:passage:0024d1bdea0893340fd75cdb8f9bdaa23f5c623f7981174813664f49534f40d9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00012","start":556,"end":572,"exact":"The generation. "},{"@id":"urn:doxa:passage:c21d2b85180c4edb167d1abdf20e4177cf60cb7ff99fe11d07729c57883865c0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00012","start":572,"end":971,"exact":"All these adults who were children yesterday and grew up in adverse conditions unexpectedly found themselves on the threshold of a new experience, an experience that overshadows all previous experiences, that makes you forget prior roles and social statuses, that distorts reality so normal no longer looks normal so you cannot tell love from indifference, peace from fatigue, necessity from dreams."},{"@id":"urn:doxa:passage:3bcb8cf13c35d1a52c11455b81bb152cc684c9640a7aba8a96d634c304e7f544","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00013","start":0,"end":53,"exact":"I have never wished to disrupt the order of my life. "},{"@id":"urn:doxa:passage:7668e5112a20e56464d7b01447d3501afa1552376c02ddcbd5f3ee672e12fe3b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00013","start":53,"end":169,"exact":"I was comfortable in the world of my childhood memories, of a clear past, of warm comfort and comprehensible peace. "},{"@id":"urn:doxa:passage:aef6641189b3a232de6727e4ccccd097af9ef17f9ef35105c4efbe2f1bdd779b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00013","start":169,"end":327,"exact":"My usual few glasses of dry wine after 7:00 p.m., my gym workouts, my collections of music and coins, my bike, my travels, and my peaceful and regular sleep. "},{"@id":"urn:doxa:passage:379c1ddedf8bfb593ac2d32644c323881f5288714e2ebc46df6d4a0a30408bbe","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00013","start":327,"end":376,"exact":"Not to mention my family and everything related. "},{"@id":"urn:doxa:passage:6bbb82d8df422b4476e907f676ccca95dcb2654b4f7395cfa6c4949bc5a10b41","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00013","start":376,"end":432,"exact":"Indeed, I never sought to identify with any generation. "},{"@id":"urn:doxa:passage:f0122828fc3e9aa8ccb4bc600b51339d791e8305edd79576be74df4f36d11b8b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00013","start":432,"end":470,"exact":"But I became part of this generation. "},{"@id":"urn:doxa:passage:bef8511a8414226d243237daa3e4bf9c62f6183d41fea5417eeb624f33f554fd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00013","start":470,"end":641,"exact":"Of the people who are now fighting, who will come home afterward, and who will not know how to move on — because how do you live in the world after witnessing it collapse?"},{"@id":"urn:doxa:decision:01cf4b5119acd5c9785bda45bbcc6fed","@type":["doxa:Decision","prov:Entity"],"recordId":"01cf4b5119acd5c9785bda45bbcc6fed","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:400fa8599e639ce8e5cc16adb1831ee8:u_88b8fdca8149d9ea8fc0c386","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:eb95a31cfb870dc7ec3ffb5fbca6d0779fc8e9c759322bee89e83966d1c56b11","urn:doxa:passage:a208d54894c1386190bdd693a18122caf46bc446cbbbcc46ff66d3be3b0cfd8b","urn:doxa:passage:0024d1bdea0893340fd75cdb8f9bdaa23f5c623f7981174813664f49534f40d9","urn:doxa:passage:c21d2b85180c4edb167d1abdf20e4177cf60cb7ff99fe11d07729c57883865c0","urn:doxa:passage:3bcb8cf13c35d1a52c11455b81bb152cc684c9640a7aba8a96d634c304e7f544","urn:doxa:passage:7668e5112a20e56464d7b01447d3501afa1552376c02ddcbd5f3ee672e12fe3b","urn:doxa:passage:aef6641189b3a232de6727e4ccccd097af9ef17f9ef35105c4efbe2f1bdd779b","urn:doxa:passage:379c1ddedf8bfb593ac2d32644c323881f5288714e2ebc46df6d4a0a30408bbe","urn:doxa:passage:6bbb82d8df422b4476e907f676ccca95dcb2654b4f7395cfa6c4949bc5a10b41","urn:doxa:passage:f0122828fc3e9aa8ccb4bc600b51339d791e8305edd79576be74df4f36d11b8b","urn:doxa:passage:bef8511a8414226d243237daa3e4bf9c62f6183d41fea5417eeb624f33f554fd"]},{"@id"