5","urn:doxa:passage:62c009531f954ef7968be32aae1d02cfe07206180c091c532896f3a3bef7f99b","urn:doxa:passage:35b7a605f3863f0533960e13edc295b8239f903d966fea453c2800a51c8e32f5","urn:doxa:passage:a06a163947082162d2f0734b76f426ae21a3b447a04112532744a5a80a162f00","urn:doxa:passage:4b79f68376766c6d49c9173dac59de5a508e4a7f9e8ffbab570f5b7a427c3b20","urn:doxa:passage:10466259dbd1cd40f618ec57e428f5a9785f51bfabc5f9acfaf0b1ddf8c3ae7a","urn:doxa:passage:1f97a21625afa221873d7d38cb7e189fb3ea2cc85258347b95fe9651982dfe9e","urn:doxa:passage:f5032e9c65cd9cc4eaa3aa33df72a48552ca6ea28ecf755f321945d1487c4bd3","urn:doxa:passage:aeab06b80655105850000394b45aeb8c105e701d8a487e200522eae277c82817","urn:doxa:passage:5c38a1d542b9c7c829a332fd2ee96c1787d2e801a88f7f3955b4dbfb28c6dccd","urn:doxa:passage:06df753fad66742d5791dba3a262efa3e1019040e20455cac20d6b7b3ceb7a47","urn:doxa:passage:d10530f6b321765c68b75d666ae15095f970a9174a87961dd5deef98b7af9318","urn:doxa:passage:7cd35efaa5f43fb95c783487b10710297886cdcf575da1596f0d4288db34f295","urn:doxa:passage:277eb1c545ef87f39b20d7d5b7a11458d2b871b3bf69dfcb836f1f843d6f9826","urn:doxa:passage:a164bb3950f8a58eb9763fe3cca87b94d33732a94260df8611d5ec7106559fd4","urn:doxa:passage:a56cc86c74a021d27e27ec5f482829d8739d7fa68034cb1594369ca9b29a0f0c"]},{"@id":"urn:doxa:passage:4deacf3899f3daf9ab72e05a97108e24822d0d426654a7fd3fa72ff7c6800a27","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00010","start":219,"end":310,"exact":"They also shared details on donation drives and safety practices while attending protests. "},{"@id":"urn:doxa:passage:b840caef0dddd92e54afb62374a43fee27c664af993abd4b7e845d15d2983372","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00010","start":310,"end":398,"exact":"Journalists, too, rely on social media to share their stories and identify story ideas. "},{"@id":"urn:doxa:passage:cdbd349c419874410277a91d979770e03e5166577bc8a0d70a82b9e64672f150","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00010","start":398,"end":478,"exact":"Rutnam said visits to his website, Colombo Gazette, were affected by the block. "},{"@id":"urn:doxa:passage:49a1174bf96e493e53437c67d343f0f8d3923b0803413c21624e83cb3531de36","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00010","start":478,"end":659,"exact":"News websites like Colombo Gazette largely rely on social media for traffic to their site, and with fewer audience visits during the block, their revenue was impacted, he explained."},{"@id":"urn:doxa:passage:80278966337b90e255c270ce29824c728d1d675cc2dc8d07f722711796e1c077","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00011","start":0,"end":263,"exact":"Government blocks on social media platforms during volatile situations have happened since at least 2018 when several platforms including Facebook, Instagram and WhatsApp were blocked during riots across the Kandy district targeting the minority Muslim community."},{"@id":"urn:doxa:passage:b4343a7bd58bd3c23f50a2829c88ff58fadbd86dbaacfeaf060c12f75aadf6e5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00012","start":0,"end":244,"exact":"As a result, most journalists have become adept at using circumvention tools like VPNs — a move endorsed by former state minister for digital technology Namal Rajapaksa, the son of former president and current prime minister Mahinda Rajapaksa. "},{"@id":"urn:doxa:passage:7996fe32a1d434e8129be78d27abb36838bc1fa0c15022107e18375882744c9d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00012","start":244,"end":340,"exact":"He described the social media ban as “completely useless” because of the widespread use of VPNs."},{"@id":"urn:doxa:passage:ab5bdf2c7b1fa081c39580773887096173ef519697489448f95ae3ac1a345990","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00013","start":0,"end":252,"exact":"Journalists’ social media posts are also leading to punitive action; at least one journalist from the state-run Sri Lanka Rupavahini Corporation has been suspended from work for social media posts on her own profile that were critical of the president."},{"@id":"urn:doxa:passage:81f57db57eaf81f8c15864d9a550808a28385ba201b78deeefc378cbf79a5b9e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00014","start":0,"end":20,"exact":"Prolonged power cuts"},{"@id":"urn:doxa:passage:3db25008864d03de3590faa48e45e9d45d460d67223ed3d077e34a49d323a295","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00015","start":0,"end":104,"exact":"Since around February 21, Sri Lanka has experienced power cuts that are due to dwindling fuel reserves. "},{"@id":"urn:doxa:passage:7ec17f455582649dfcaadd9fd9bd39312b33902faf60affa11e7c63c4f26bff5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00015","start":104,"end":423,"exact":"This makes it difficult for journalists to carry out their work, especially with often spotty connectivity on their mobile phones. (In a notice on their website, mobile service provider Dialog confirmed there might be interruptions in connectivity during long power cuts because of constraints in backup power systems.)"},{"@id":"urn:doxa:passage:d1e34662ebc1c3e3da28e81865203da0048a8f8be74e4fc40e2e0f1c2a758556","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00016","start":0,"end":53,"exact":"Yet Sri Lankan journalists continue to file reports. "},{"@id":"urn:doxa:passage:84457d7291a6e2077b9db189bfdd064c7bc1388e9c7b6bc7ef76be21777fb4d9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00016","start":53,"end":118,"exact":"And increasingly, protesters also are telling their own stories. "},{"@id":"urn:doxa:passage:f6d43d96de6268d6746193eb9dacf0a2370cc3229cef4533c0582216597dfac5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00016","start":118,"end":267,"exact":"The documentation of attempted state repression via social media has contributed most to the longevity of protests connected to the economic crisis. "},{"@id":"urn:doxa:passage:ed51bcbda6fa51b8397a56558fdfe64a007c9e961ad9c3cc25d8efa792030b0c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00016","start":267,"end":620,"exact":"The result thus far has been an explosion of memes, protest art, discussions and critical coverage of the crisis — despite emergency regulations passed by the president on May 6 which make sharing false information or information leading to public disorder or violence a criminal offence (a thinly veiled attempt at stifling criticism of the president)."},{"@id":"urn:doxa:passage:3acd43d9312d1839da0667c157c92b420f9b94f44e756bb7af6e806ecfebfd7d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00017","start":0,"end":267,"exact":"On May 9, Mahinda Rajapaksa stepped down as prime minister due to the protests, after vehicles and homes of Sri Lanka Podujana Peramuna (SLPP) or Sri Lanka People's Front ministers were set ablaze by angry protesters in retaliation for the SLPP-led attacks on May 9. "},{"@id":"urn:doxa:passage:2ddc26fc03f375ac098f20a56961f7731e0a94d6f6821e90d5161f1fe88645d0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7b5a99a6f76cc2bd125bc93b8fab55bb","blockId":"gv-763265-b00017","start":267,"end":401,"exact":"With the profoundly unpopular Ranil Wickremesinghe being sworn in four days later amidst curfew, the protests look likely to continue."},{"@id":"urn:doxa:decision:e37182a5509080449f6d9e1accaa0a85","@type":["doxa:Decision","prov:Entity"],"recordId":"e37182a5509080449f6d9e1accaa0a85","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:7b5a99a6f76cc2bd125bc93b8fab55bb:u_fee10bc98d610b744d7b1537","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:4deacf3899f3daf9ab72e05a97108e24822d0d426654a7fd3fa72ff7c6800a27","urn:doxa:passage:b840caef0dddd92e54afb62374a43fee27c664af993abd4b7e845d15d2983372","urn:doxa:passage:cdbd349c419874410277a91d979770e03e5166577bc8a0d70a82b9e64672f150","urn:doxa:passage:49a1174bf96e493e53437c67d343f0f8d3923b0803413c21624e83cb3531de36","urn:doxa:passage:80278966337b90e255c270ce29824c728d1d675cc2dc8d07f722711796e1c077","urn:doxa:passage:b4343a7bd58bd3c23f50a2829c88ff58fadbd86dbaacfeaf060c12f75aadf6e5","urn:doxa:passage:7996fe32a1d434e8129be78d27abb36838bc1fa0c15022107e18375882744c9d","urn:doxa:passage:ab5bdf2c7b1fa081c39580773887096173ef519697489448f95ae3ac1a345990","urn:doxa:passage:81f57db57eaf81f8c15864d9a550808a28385ba201b78deeefc378cbf79a5b9e","urn:doxa:passage:3db25008864d03de3590faa48e45e9d45d460d67223ed3d077e34a49d323a295","urn:doxa:passage:7ec17f455582649dfcaadd9fd9bd39312b33902faf60affa11e7c63c4f26bff5","urn:doxa:passage:d1e3