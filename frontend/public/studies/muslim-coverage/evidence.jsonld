6587746b77343d788fbdf3583f5067ff7500b9ae4ec897c7a","urn:doxa:passage:1dbc67c975cef81e29d4083d8baa39769ec224741376889a798e27ea9a23b1bc"]},{"@id":"urn:doxa:decision:2f3ad74cb88798a96ec39e1ca111fd7a","@type":["doxa:Decision","prov:Entity"],"recordId":"2f3ad74cb88798a96ec39e1ca111fd7a","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:b06184e463b5fb9c641c1b5541dbca26:u_591882acbb4ee87f4300515b","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:57348adc5ab50776a2e94e8386fc590f2c1b7a264fcea0beeb892cc2eb82b923","urn:doxa:passage:ff9cadf208af29f38c6a5b4264d750ecf1eb45d70197e2f639efe49dde52b43f","urn:doxa:passage:f3866d61bacff33e695b55e3f00be077f53e4e1d58c42d54b07d0ef671ac20f5","urn:doxa:passage:fe38e64359dabbfdfbd0f5ab1786bd7dee13182bdf5ae2f339becf1cc4ac8779","urn:doxa:passage:b87a4f94f31da951800ca23ce076813d1b92b9670e32ebe4c79f177723a3380a","urn:doxa:passage:272ef115bda667d4739218b4088dc6c3ecf2d8ce18550ee91cc288d543a2689b","urn:doxa:passage:4819ed5b8f4b41e833c5bb57d66783dd5bbc1408685f02c5e8c69a73508e2291","urn:doxa:passage:423746048f5b94bd4e200957ef369e38204d7d27fd28816fe8eb99994f3714d1","urn:doxa:passage:e005041fa609228fedb577935a292b1f211d2967a3f5ec15de58ca1f416b0fc3","urn:doxa:passage:e4021f6065069ea6d32f527feca79e524267a4897f99e42f043bb0fa4a075867","urn:doxa:passage:5ebc74d0626213b11bb8333984a2e93b065a51e7a00fe71675c65d33a58a134a","urn:doxa:passage:cc329e6595ccaf515e6135c2cf0c3a14609d73a9be6c0b82f7d9ceac68feb885","urn:doxa:passage:cc95bbf383c821647395eb22ef69df2f71dafaf2aaee5573ad65b3174d59807a","urn:doxa:passage:2e219be74b05851a2731e7d41b1b6db63397b40a080014824c3e71d36f10d46a","urn:doxa:passage:843696138dc47021d8ac57de85b7c4d8e818dac48e5a478302dfa1619c9a117c","urn:doxa:passage:15561b3bee71f69b74527db5c2afc9337810a8075dac2f3ba3ca1b3472923f06","urn:doxa:passage:4bafa3aa29e2e3ca05bcd7db8181855c5a0d4ff857d0d247062f82521a73de1d","urn:doxa:passage:be884cc8c6894c875781fb2b22576302a218a73b07862218a086d634f7da9c46","urn:doxa:passage:9d0aa8e89bc10646587746b77343d788fbdf3583f5067ff7500b9ae4ec897c7a","urn:doxa:passage:1dbc67c975cef81e29d4083d8baa39769ec224741376889a798e27ea9a23b1bc"]},{"@id":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-809885","title":"Central Asia’s unique tradition of singing during Ramadan keeps evolving","author":"Nurbek Bekmurzaev","translator":[],"publishedOn":"2024-04-08","sourceUrl":"https://globalvoices.org/2024/04/08/central-asias-unique-tradition-of-singing-during-ramadan-keeps-evolving/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"acd389afccf7dcd5be121b79e1328729b5764fabb41f197ef85eee3f0c911934","textSha256":"f95d5aa9952311a60bf6662ada06701c0eb746a1af99ff346fe4c3387236d365","archivedRecordSha256":"5185204877995dcaf1938cc4063bda0fce68c900c40a4162d43be1035521634f","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:2d1b50736af70cdf0585256d9bd48f0b:u_96038270e6296b1d496dabce","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_96038270e6296b1d496dabce","status":"accepted","fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b"},{"@id":"urn:doxa:passage:0b076c8db5a35ca07b8387cdf41eb9145428f0d58d2f68c6dfd39d6d99042fe7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00001","start":0,"end":193,"exact":"On April 5, a deputy of the city council of Kyrgyzstan’s capital, Bishkek, Elizaveta Alymbaeva, complained about children singing jaramazan on the roads, thus creating emergencies for drivers. "},{"@id":"urn:doxa:passage:467529968dd5515eb7e856f6bb4eaef04efd5f5b9ea295d1e1a5bc634d13612e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00001","start":193,"end":508,"exact":"Jaramazan, also known as jarapazan in Kazakh and yaremezan in Turkmen, refers to traditional folk songs performed by people in the Central Asian republics of Kazakhstan, Kyrgyzstan, Turkmenistan, and Uzbekistan during Ramadan to celebrate its start and congratulate each other while going from one house to another."},{"@id":"urn:doxa:passage:ab71473f2c384af390317f23f15db39988f9934e5681a145c85c2f2cf1faffa6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00002","start":0,"end":87,"exact":"Here is a YouTube video about the history and rules of singing jaramazan in Kyrgyzstan."},{"@id":"urn:doxa:passage:0c58ee0c73ade37a890e088aaad543e397f0c44276617b1660b49579d4079eb5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00003","start":0,"end":181,"exact":"According to Alymbaeva, children who sing jaramazan in Bishkek chase people around and repeatedly visit homes, offices, cars, and restaurants, expecting treats and money in return. "},{"@id":"urn:doxa:passage:1ecc625659fe43462b1f31ba85441f3467fbff26a3daf7b8d9d08610e11a7cf7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00003","start":181,"end":329,"exact":"Her colleague, Svetlana Kenzhebayeva, added that children sing jaramazan even during the day, contrary to the tradition of singing it only at night."},{"@id":"urn:doxa:passage:ca9a4bec8bc9e8d894d67a43cb421163119294bbc22270a99a13d7e136fcbfd3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00004","start":0,"end":200,"exact":"What these deputies find annoying is the changing traditions surrounding jaramazan, a musical genre unique to Central Asia and borne from the adaptation of Islam to local cultural and social context. "},{"@id":"urn:doxa:passage:5e7d868ad438f5e656ee2dff9384aa4018e30dfd18fec1512444134beb73c0c6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00004","start":200,"end":405,"exact":"Islam first came to the region in the 8th century, after the Abbasid caliphate emerged victorious against the Chinese Tang dynasty in the Battle of Talas, which took place in modern day Kyrgyzstan in 751. "},{"@id":"urn:doxa:passage:12f9d50a60ad70549dab198af628a2dc04c054760530a1d648a503d0ae0ced60","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00004","start":405,"end":593,"exact":"The outcome of this battle transformed the region culturally, opening the door for its Islamization, and, nowadays, more than 90 percent of the Central Asia’s population are Sunni Muslims."},{"@id":"urn:doxa:passage:b64a56cb8fc8a5dd0bd24bbaa782482bad0568de717d1641a8eb7b2a7c196832","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00005","start":0,"end":41,"exact":"There are several versions of jaramazan. "},{"@id":"urn:doxa:passage:358f12cc42936d309cc1d00ac4e7368a0b0fb859077e884e31e0989b2e525afa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00005","start":41,"end":184,"exact":"Those who perform it often get creative and change the lyrics, depending on the wealth and status of people in front of whom they are singing. "},{"@id":"urn:doxa:passage:2600e5476b5d691be63ffa18fab8712eec3eb23370b60f1f447d2936600bc9b8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00005","start":184,"end":422,"exact":"However, all versions of jaramazan have a similar structure with a greeting and notifying of the arrival of Ramadan in the beginning followed by praising home owners who listen to the song, and offering prayers and good wishes at the end."},{"@id":"urn:doxa:passage:23d842fc7815cda85faec1143a65391f09b0d520f7b7b0ac7a13e0e6a45207f0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00006","start":0,"end":28,"exact":"Here is jaramazan in Kyrgyz."},{"@id":"urn:doxa:passage:2f2a8b97944392379eeaed6cd174a9f1280d6eaee76663fd5c3f92cf59b465ab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00007","start":0,"end":197,"exact":"Previously, a group of young and adult men went around went around and sung jaramazan in front of their fellow villagers, who gifted them clothes, food, and even cattle, depending on their wealth. "},{"@id":"urn:doxa:passage:903908a26906976f4e6f5294fb59e426605b17ab5c340f05e3e350db290806ca","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00007","start":197,"end":295,"exact":"Some believe that jaramazan was performed by poor people, who did it mostly for economic benefit. "},{"@id":"urn:doxa:passage:8d3ccbee94bc89b98a0e3d43dff0e65a0b57fa4d883634f543412a9a73e8f0c4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00007","start":295,"end":476,"exact":"Others state that jaramazan was performed by akyns (improviser poets) using local musical instruments as part of the local religious and national traditions associated with Ramadan."},{"@id":"urn:doxa:passage:221d9291261e9173ec63066de52fae8365c26e593cb72e5809b0ad0a6caa0d88","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00008","start":0,"end":28,"exact":"Here is jaramazan in Kazakh."},{"@id":"urn:doxa:passage:f935af58b15a7d48891caf167d5b59a0af4ede264f36d5669007c5cc6cdb12f3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00009","start":0,"end":209,"exact":"Although jamarazan emerged after the arrival of Islam to Central Asia, scholars agree that it is rooted in pre-Islamic beliefs and rituals, such as callings to start rain or end winds, which involved singing. "},{"@id":"urn:doxa:passage:018b988171fe6cce5d17767a8acc550811a635497aa7c98002fa7969d74b4bbd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00009","start":209,"end":426,"exact":"In this regard, jaramazan is similar to the celebration of Nowruz, a Zoroastrian holiday, which is still popular in Central Asia due to its cooptation by local Muslims as a national holiday instead of a religious one."},{"@id":"urn:doxa:passage:26ca419e1d1cf1b40781ee86b140a63c43e29a610157ce4b98ef191942687000","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00010","start":0,"end":113,"exact":"Jaramazan’s popularity has been growing since 1991, when Central Asia gained independence from the Soviet Union. "},{"@id":"urn:doxa:passage:02f09216c0cbf166b70cf10dfaa27176806f0960d293d4833ece6964fc7db4a7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00010","start":113,"end":285,"exact":"Since then the region’s re-Islamization has led to the popularization of Islamic practices, such as fasting during Ramadan, and various local traditions associated with it."},{"@id":"urn:doxa:passage:9fda261e18e65b97e7c3b9ad185e70a0cb9955039d55490b4071eccbad0f6396","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00011","start":0,"end":172,"exact":"Jaramazan’s growing popularity has taken it to restaurants, parks, roads, and offices, where it is performed by professional singers, small children, and youngsters alike. "},{"@id":"urn:doxa:passage:2e6d88f68304a709bd039f0487ce2025efe23248b6b275345b15283df6841996","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00011","start":172,"end":294,"exact":"It has also sparked public debates around whether jaramazan is in essence a mere begging exercise with no links to Islam. "},{"@id":"urn:doxa:passage:e1df0e0644443a26594ee265b61db79476e1752f2d66ab774d68e0ff8b65a2ec","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:2d1b50736af70cdf0585256d9bd48f0b","blockId":"gv-809885-b00011","start":294,"end":468,"exact":"What is undoubtedly true is that jaramazan is a unique living musical tradition that is adapting to different contexts and changing with each generation of its practitioners."},{"@id":"urn:doxa:decision:26decb02e636f6a23f6d367e6cbd2b40","@type":["doxa:Decision","prov:Entity"],"recordId":"26decb02e636f6a23f6d367e6cbd2b40","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:2d1b50736af70cdf0585256d9bd48f0b:u_96038270e6296b1d496dabce","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:0b076c8db5a35ca07b8387cdf41eb9145428f0d58d2f68c6dfd39d6d99042fe7","urn:doxa:passage:467529968dd5515eb7e856f6bb4eaef04efd5f5b9ea295d1e1a5bc634d13612e","urn:doxa:passage:ab71473f2c384af390317f23f15db39988f9934e5681a145c85c2f2cf1faffa6","urn:doxa:passage:0c58ee0c73ade37a890e088