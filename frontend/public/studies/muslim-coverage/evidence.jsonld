2de6727e4ccccd097af9ef17f9ef35105c4efbe2f1bdd779b","urn:doxa:passage:379c1ddedf8bfb593ac2d32644c323881f5288714e2ebc46df6d4a0a30408bbe","urn:doxa:passage:6bbb82d8df422b4476e907f676ccca95dcb2654b4f7395cfa6c4949bc5a10b41","urn:doxa:passage:f0122828fc3e9aa8ccb4bc600b51339d791e8305edd79576be74df4f36d11b8b","urn:doxa:passage:bef8511a8414226d243237daa3e4bf9c62f6183d41fea5417eeb624f33f554fd"]},{"@id":"urn:doxa:decision:014a878aac4fe5e5c20da40c3ae90bb2","@type":["doxa:Decision","prov:Entity"],"recordId":"014a878aac4fe5e5c20da40c3ae90bb2","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:400fa8599e639ce8e5cc16adb1831ee8:u_88b8fdca8149d9ea8fc0c386","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:eb95a31cfb870dc7ec3ffb5fbca6d0779fc8e9c759322bee89e83966d1c56b11","urn:doxa:passage:a208d54894c1386190bdd693a18122caf46bc446cbbbcc46ff66d3be3b0cfd8b","urn:doxa:passage:0024d1bdea0893340fd75cdb8f9bdaa23f5c623f7981174813664f49534f40d9","urn:doxa:passage:c21d2b85180c4edb167d1abdf20e4177cf60cb7ff99fe11d07729c57883865c0","urn:doxa:passage:3bcb8cf13c35d1a52c11455b81bb152cc684c9640a7aba8a96d634c304e7f544","urn:doxa:passage:7668e5112a20e56464d7b01447d3501afa1552376c02ddcbd5f3ee672e12fe3b","urn:doxa:passage:aef6641189b3a232de6727e4ccccd097af9ef17f9ef35105c4efbe2f1bdd779b","urn:doxa:passage:379c1ddedf8bfb593ac2d32644c323881f5288714e2ebc46df6d4a0a30408bbe","urn:doxa:passage:6bbb82d8df422b4476e907f676ccca95dcb2654b4f7395cfa6c4949bc5a10b41","urn:doxa:passage:f0122828fc3e9aa8ccb4bc600b51339d791e8305edd79576be74df4f36d11b8b","urn:doxa:passage:bef8511a8414226d243237daa3e4bf9c62f6183d41fea5417eeb624f33f554fd"]},{"@id":"urn:doxa:passage:ca7e62e22165d2edc10b4d342f3bee1aa89fb298acb15d850b3459dc16747e62","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00001","start":0,"end":45,"exact":"Translated from Ukrainian by Svitlana Bregman"},{"@id":"urn:doxa:passage:79ffe32bd078fa314b68c7c9207bc40d64ad999fcbfbdb9c6ae0cd914dfdd9a6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00002","start":0,"end":186,"exact":"This story is part of a series of essays and articles written by Ukrainian artists who decided to stay inside Ukraine after Russia’s full-scale invasion of Ukraine on February 24, 2022. "},{"@id":"urn:doxa:passage:010f43fbbdfba04986e67f68d2891d716117ee1b3969cae78f9ac176f67ee219","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00002","start":186,"end":420,"exact":"This series is produced in collaboration with the Folkowisko Association/Rozstaje.art, thanks to co-funding by the governments of the Czech Republic, Hungary, Poland, and Slovakia through a grant from the International Visegrad Fund. "},{"@id":"urn:doxa:passage:596902317e81779c5e354ac8ae63ef6f62dfd50e6dfc601630480c7ef70a78c8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00002","start":420,"end":519,"exact":"The mission of the fund is to advance ideas for sustainable regional cooperation in Central Europe."},{"@id":"urn:doxa:passage:8c0420185b8ffe37ff64bdc15dab2a1bcc5a51aa9c27ae64317ada6053be8cb5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00003","start":0,"end":84,"exact":"It's not that I didn't believe in the possibility of a full-scale Russian invasion. "},{"@id":"urn:doxa:passage:95478e7ab526b3cea1f60ff7670071dbdec144f25016abd03fc02b58c4477189","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00003","start":84,"end":113,"exact":"I didn't want to believe it. "},{"@id":"urn:doxa:passage:7c9b1e1a8be60b604ab640047eb65213d6875bf295c2729de5f8e95f4e4234ce","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00003","start":113,"end":169,"exact":"I didn't want to disrupt the regular course of my life. "},{"@id":"urn:doxa:passage:a836b1c12855d9d4600597c5db35277f2db590970bbd7779b8f30555da8a5ce6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00003","start":169,"end":460,"exact":"For me, there is nothing better than my daily rituals: morning workouts, daytime work on texts, an evening book with a glass of dry wine, conversations with my wife about creativity and raising our son, dear friends who come to visit and bring prosecco … But then it happened: the invasion. "},{"@id":"urn:doxa:passage:e55fcb1f8140d2a605f615f273b678376189dbc7b6e08e8759708693718ffd5b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00003","start":460,"end":519,"exact":"I did not want to experience cold, hunger, fear, or anger. "},{"@id":"urn:doxa:passage:b8668896384c2e4e8297b294e90bdc9f6e2126bc4aa1ffe3a3f595b4c1e90462","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00003","start":519,"end":582,"exact":"An introverted homebody like me wasn't suited for such trials. "},{"@id":"urn:doxa:passage:7cb526d218255576d0d02329bcfae8cadc19447ebd3a73a179feb5ec21e03548","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00003","start":582,"end":691,"exact":"I couldn't imagine anything worse than being forced to stay with a group of strangers, fighting as a soldier."},{"@id":"urn:doxa:passage:8c80d8f3616c50bd06c6d5f3ea0ebc0f827b672d447d3e87e43deaed7b89ff04","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00004","start":0,"end":32,"exact":"I have experienced this before. "},{"@id":"urn:doxa:passage:6b547c11e7962dc1360a2f2433a982142d2bc0a10a8f2cd67e1efcfc3a4346da","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00004","start":32,"end":150,"exact":"Forced socialization in adulthood is depressing when you are surrounded by people who are mostly not kindred spirits. "},{"@id":"urn:doxa:passage:2cc0c2e0d280c269a66062aee5929a655bd0b2a0871a60bbda2e07a885d4809d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00004","start":150,"end":242,"exact":"And you certainly understand perfectly well that it is their natural right to be different. "},{"@id":"urn:doxa:passage:202ca470678fe495d328cc37e9a496afde9ebb915f6da79f7da784b9509041d5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00004","start":242,"end":435,"exact":"In war, you have to adapt to circumstances and find a common language with those who you would never associate with in civilian life, obey those who disgust you, and command those you distrust."},{"@id":"urn:doxa:passage:0654605549348175c36943d697ecc558d9484611a9e643d2c25bf7cf00ee1adc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00005","start":0,"end":44,"exact":"Yes, I had already experienced this before. "},{"@id":"urn:doxa:passage:68817b11c61ec9010ee891a7eedf9947b5e53af0d32620b2bfee9383e53da6c2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00005","start":44,"end":665,"exact":"In 2015, when I first joined the Armed Forces of Ukraine, when the war in the East started, I ⁠met the following people: a miner from the Dnipropetrovsk region who became like a brother to me; a criminal investigator from the Cherkasy region with whom I learned to find a common language; a flock of classical gopniks from the south who I initially avoided, although their fearlessness eventually earned my respect; guys from Podillya who taught me simple farmers’ philosophy and showed me how to love and notice subtle beauty such as birds singing, ice patterns on the car window, and the silence of the Donbas steppes. "},{"@id":"urn:doxa:passage:ff7dd8cd9b8c6fe4a2cfaf8e4b13bf5c673b394cdca10d5283d4930a5856459e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00005","start":665,"end":766,"exact":"But all this came later, after weeks and even months of us clashing like metal rubbing against metal."},{"@id":"urn:doxa:passage:f476cfc5cd17663f463cd70f5bdd5a7132401ad62171010a6413f6bcf46fd89d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00006","start":0,"end":63,"exact":"This time, during the full-scale war, other people came along. "},{"@id":"urn:doxa:passage:29e31ff616524a462e3d86e4d0450c4ae7ed34a65c267ba70143b33182346657","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00006","start":63,"end":104,"exact":"They turned out to be my kind of people. "},{"@id":"urn:doxa:passage:77fc871352bef7059eb24e95df383a75f63aefbde5bba086d4b4fbed774b18ba","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00006","start":104,"end":207,"exact":"In theory, I could drink red Californian wine in my kitchen with them, even back before February 2022. "},{"@id":"urn:doxa:passage:a9f9e0fee2b58ee254fca0d886561aec82d5eed260efd30427f7d69b47fd5e0c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00006","start":207,"end":391,"exact":"My battalion is mostly made up of residents of the capital city, and despite our different social statuses, political views, and cultural backgrounds, we have more in common than not. "},{"@id":"urn:doxa:passage:c6efef148b40c933454db3c35aff1bfeb945965b0cd4aaa80e9bddf0f65f65c3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00006","start":391,"end":491,"exact":"After all, most of us are the vintage of the same year, and we were maturing in similar conditions. "},{"@id":"urn:doxa:passage:9b2dab2fe220c768abe81a8847c2b5ea7e4f5dea258696733169842b13c006cf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00006","start":491,"end":586,"exact":"Kyiv's Syrets district of the 1990s did not differ much from my home district “D” in Cherkasy. "},{"@id":"urn:doxa:passage:2bff21d03f9e2a749424c9d9022e31aef187c62bf645b5510052d4b8aac83124","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00006","start":586,"end":693,"exact":"Our general secondary education gave us fairly equal opportunities, although each of us chose our own path."},{"@id":"urn:doxa:passage:9515483ac841190de2467086822954fb056bd9ee1c87d54d31008790e5ef58f1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00007","start":0,"end":199,"exact":"Well, as an author, I suppose I could distinguish myself from the general public, claiming that my choice is about the achievement of life goals in a way that is quite unusual for my current circle. "},{"@id":"urn:doxa:passage:d12ad3fe7a73b44ac7f6eefbd955163008510acfa47345eb921512365febe20b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00007","start":199,"end":318,"exact":"But the essential point, such as the mental rooting of my generation in our country's historical context, is the same. "},{"@id":"urn:doxa:passage:612ac4582420393c436a4e1fb95c9bcb36ae19888d2ff89e41a119f7f9f3e453","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00007","start":318,"end":353,"exact":"There is much affinity between us. "},{"@id":"urn:doxa:passage:5b4cacfdb7cb9a692923d362d6cb11ecff5e50038db00549389e42038fd4ce7d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00007","start":353,"end":600,"exact":"I — a writer — am not different from my brothers in arms: a trucker with the code name “Geographer,” a “Virus” IT guy, or an odd-jobber “Jet.” We are all different, but we share the same enemy and goal — not to pass this war down to our children. "},{"@id":"urn:doxa:passage:3da5d43cf216edaa8d93bf2f82117a60d2962b98ced261e92ae4940edfa72169","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00007","start":600,"end":658,"exact":"Because we were once children ourselves not too long ago. "},{"@id":"urn:doxa:passage:8e6ed1ce4438cf465a1f0eedf4d3146a46e54ebdd66aabda7adf6b8c4e468819","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:400fa8599e639ce8e5cc16adb1831ee8","blockId":"gv-788705-b00007","start":658,"end":819,"exact":"We are children of the unstable post-Soviet reality who have experienced a number of metamorphoses and have grown into a new and unexpectedly strong generation. "},{"@id":"urn:doxa:decision:d606abb92c97f02e472c5d379c78ba6d","@type":["doxa:Decision","prov:Entity"],"recordId":"d606abb92c97f02e472c5d379c78ba6d","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:400fa8599e639ce8e5cc16adb1831ee8:u_d42033fd8eccb01eeffa3fb9","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:ca7e62e22165d2edc10b4d342f3bee1aa89fb298acb15d850b3459dc16747e62","urn:doxa:passage:79ffe32bd078fa314b68c7c9207bc40d64ad999fcbfbdb9c6ae0cd914dfdd9a6","urn:doxa:passage:010f43fbbdfba04986e67f68d2891d716117ee1b3969cae78f9ac176f67ee219","urn:doxa:passage:596902317e81779c5e354ac8ae63ef6f62dfd50e6dfc601630480c7ef70a78c8","urn:doxa:passage:8c0420185b8ffe37ff64bdc15dab2a1bcc5a51aa9c27ae64317ada6053be8cb5","urn:doxa:passage:95478e7ab526b3cea1f60ff7670071dbdec144f25016abd03fc02b58c4477189","urn:doxa:passage:7c9b1e1a8be60b604ab640047eb65213d6875bf295c2729de5f8e95f4e4234ce","urn:doxa:passage:a836b1c12855d9d4600597c5db35277f2db590970bbd7779b8f30555da8a5ce6","urn:doxa:passage:e55fcb1f8140d2a605f615f273b678376189dbc7b6e08e8759708693718ffd5b","urn:doxa:passage:b8668896384c2e4e8297b294e90bdc9f6e2126bc4aa1ffe3a3f595b4c1e90462","urn:doxa:passage:7cb526d218255576d0d02329bcfae8cadc19447ebd3a73a179feb5ec21e03548","urn:doxa:passage:8c80d8f3616c50bd06c6d5f3ea0ebc0f827b672d447d3e87e43deaed7b89ff04","urn:doxa:passage:6b547c11e7962dc1360a2f2433a982142d2bc0a10a8f2cd67e1efcfc3a4346da","urn:doxa:passage:2cc0c2e0d280c269a66062aee5929a655bd0b2a0871a60bbda2e07a885d4809d","urn:doxa:passage:202ca470678fe495d328cc37e9a496afde9ebb915f6da79f7da784b9509041d5","urn:doxa:passage:0654605549348175c36943d697ecc558d9484611a9e643d2c25bf7cf00ee1adc","urn:doxa:passage:68817b11c61ec9010ee891a7eedf9947b5e53af0d32620b2bfee9383e53da6c2","u