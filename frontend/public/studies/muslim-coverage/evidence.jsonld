sses.” German Chancellor Olaf Scholz also said the two were unrelated."},{"@id":"urn:doxa:decision:d40a9a24c80299b7d5cfba242d1db56e","@type":["doxa:Decision","prov:Entity"],"recordId":"d40a9a24c80299b7d5cfba242d1db56e","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:84fdf54b1f618c7772a2da56d62a54d8:u_14828afa19771a684a8f3590","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cd5c646b946b37d332a7ac111d4207b360deac1f49b86e3e0fd368e7738c24f1","urn:doxa:passage:243ac7a7fb4177cb3bf25e11e14d86683c19da08fbb444bbeb5345f7970d189b"]},{"@id":"urn:doxa:decision:9b0b3416b4482f6909addadd2b40ed5b","@type":["doxa:Decision","prov:Entity"],"recordId":"9b0b3416b4482f6909addadd2b40ed5b","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:84fdf54b1f618c7772a2da56d62a54d8:u_14828afa19771a684a8f3590","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cd5c646b946b37d332a7ac111d4207b360deac1f49b86e3e0fd368e7738c24f1","urn:doxa:passage:243ac7a7fb4177cb3bf25e11e14d86683c19da08fbb444bbeb5345f7970d189b"]},{"@id":"urn:doxa:decision:5e3fa00531e3997d2dabe4e196d6d807","@type":["doxa:Decision","prov:Entity"],"recordId":"5e3fa00531e3997d2dabe4e196d6d807","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:84fdf54b1f618c7772a2da56d62a54d8:u_14828afa19771a684a8f3590","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cd5c646b946b37d332a7ac111d4207b360deac1f49b86e3e0fd368e7738c24f1","urn:doxa:passage:243ac7a7fb4177cb3bf25e11e14d86683c19da08fbb444bbeb5345f7970d189b"]},{"@id":"urn:doxa:decision:da2cd907cde23739fc91ac210eb3d7e5","@type":["doxa:Decision","prov:Entity"],"recordId":"da2cd907cde23739fc91ac210eb3d7e5","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:84fdf54b1f618c7772a2da56d62a54d8:u_14828afa19771a684a8f3590","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cd5c646b946b37d332a7ac111d4207b360deac1f49b86e3e0fd368e7738c24f1","urn:doxa:passage:243ac7a7fb4177cb3bf25e11e14d86683c19da08fbb444bbeb5345f7970d189b"]},{"@id":"urn:doxa:decision:67a0722f4050d5d7ed2ccdf6ee98b5f9","@type":["doxa:Decision","prov:Entity"],"recordId":"67a0722f4050d5d7ed2ccdf6ee98b5f9","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:84fdf54b1f618c7772a2da56d62a54d8:u_14828afa19771a684a8f3590","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cd5c646b946b37d332a7ac111d4207b360deac1f49b86e3e0fd368e7738c24f1","urn:doxa:passage:243ac7a7fb4177cb3bf25e11e14d86683c19da08fbb444bbeb5345f7970d189b"]},{"@id":"urn:doxa:decision:17fd7cabed949c3c0f288c62e4e854c6","@type":["doxa:Decision","prov:Entity"],"recordId":"17fd7cabed949c3c0f288c62e4e854c6","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:84fdf54b1f618c7772a2da56d62a54d8:u_14828afa19771a684a8f3590","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cd5c646b946b37d332a7ac111d4207b360deac1f49b86e3e0fd368e7738c24f1","urn:doxa:passage:243ac7a7fb4177cb3bf25e11e14d86683c19da08fbb444bbeb5345f7970d189b"]},{"@id":"urn:doxa:passage:d92ae47e0536d423b4be04d7abcde5009b3304091f89861ab56283ef2c8e29e6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00001","start":0,"end":132,"exact":"On July 20, European Union foreign ministers met to discuss Ankara's renewed accession demands and agreed to re-engage with Turkey. "},{"@id":"urn:doxa:passage:8887cde33ccb3577ec40a6f9af293366a7a51a45417f9ba088994649718db0fa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00001","start":132,"end":492,"exact":"In the European Commission report on enlargement for 2022, they noted the EU's concerns over the country's “continued deterioration of democracy, the rule of law, fundamental rights and the independence of the judiciary.” However, Russia's invasion of Ukraine has reportedly shifted perceptions within the EU toward its neighboring countries, including Turkey."},{"@id":"urn:doxa:passage:90e6ab4c9b39be320803744bcf5384e322e726d461ffaa647f58e16f632aa466","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00002","start":0,"end":173,"exact":"Turkey's aspirations to join the EU started 24 years ago — or 36 when Turkey applied for association with the European Economic Community, the precursor to the EU, in 1987. "},{"@id":"urn:doxa:passage:a6e71f08108507c4fe424cb928384e2d9a65c5008052cdcfda3555b3b80d02c4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00002","start":173,"end":307,"exact":"It renewed these aspirations ahead of the North Atlantic Treaty Organization (NATO) summit in Vilnius, Lithuania, earlier this month. "},{"@id":"urn:doxa:passage:0ae46c3df4cb4e7bdfe4e6c6ae3c1cbe86cb415807b98d75f9e7d4e36907ba7f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00002","start":307,"end":424,"exact":"As such, as one senior EU official told the Financial Times, “We’re not swallowing the membership demand line whole. "},{"@id":"urn:doxa:passage:c32ce99cba0292ec42b0da60231096b9b688712df1dd5bcccec17a021939e559","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00002","start":424,"end":515,"exact":"But there’s definitely a willingness from many of us to see where we can do more together.”"},{"@id":"urn:doxa:passage:dc42042051cc13553b27273de881936036b5237b34afd51dac60be4e30a13f06","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00003","start":0,"end":14,"exact":"How it started"},{"@id":"urn:doxa:passage:8fa47fe0b05ff1b1f55b2fcdf2bce792ea7a9585c5d8bb8b7b00138513cd9645","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00004","start":0,"end":280,"exact":"Turkey was granted candidate status in 1999, and accession negotiations opened in 2005 under the condition that Turkey must meet a series of policy fields (called chapters) within the enlargement process and abide by a set of principles known as the Copenhagen political criteria."},{"@id":"urn:doxa:passage:93312ad9c4e03f65e2eb73ef12632513067417f9600da1594258e4f85902f0f4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00005","start":0,"end":129,"exact":"Since then, Turkey's EU bid grew weaker each year under the ruling Justice and Development Party (AKP) which took power in 2002. "},{"@id":"urn:doxa:passage:34d33d8e1c38c1d5606227c26e4cc4fa9065226c771764353d3cfaa5fce89404","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00005","start":129,"end":275,"exact":"Over the years, internal political riffs and crackdowns on freedoms and rights have reduced the chances of the country joining the European body. "},{"@id":"urn:doxa:passage:1f07e0a4e72494ee5612eac62631ef39f0680afcad99cc43d69297bc942d958e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00005","start":275,"end":536,"exact":"That and Turkish President Recep Tayyip Erdoğan's inflammatory rhetoric, calling Europe “sick” and “collapsing,” while threatening to roll back some of the reforms like reinstating the death penalty, pushed the country's European aspirations even further away. "},{"@id":"urn:doxa:passage:dd96eaf528d670bd1fbb17c43cd6137212049fa02e0afffd462c623eadd97afd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00005","start":536,"end":640,"exact":"Other contested issues include Turkey's hostile relations with Greece and Cyprus, both EU member states."},{"@id":"urn:doxa:passage:749a331a9704bd4f6b85c24935b17b776f66ce38d6d3aa63ea3fbfaa2ef7bce0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00006","start":0,"end":62,"exact":"By 2018, Turkey's accession negotiations came to a standstill."},{"@id":"urn:doxa:passage:7f1a29cc75048fbc199be630e73f140fd03690f9b82b90478efd3267bc8ad707","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00007","start":0,"end":98,"exact":"Following Russia's invasion of Ukraine, Sweden and Finland announced their decision to join NATO. "},{"@id":"urn:doxa:passage:5f17a58f40ec55d907cd041e7d76585db4747e26febce521cd85995b2865fadc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00007","start":98,"end":224,"exact":"However, the decision, which must be approved unilaterally by all 30 member states, was vetoed by Turkey, also a NATO member. "},{"@id":"urn:doxa:passage:84beac567f5b37732a8c766ceaf43aeae72eb6d3f2f1ca40960e55c5a1c969e7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00007","start":224,"end":516,"exact":"Ankara said last year that unless both countries met its demands, it wouldn't approve the bid, “citing their history of hosting members of Kurdish militant groups and Sweden’s suspension of arms sales to Turkey since 2019 over Ankara’s military operation in Syria” according to the Guardian. "},{"@id":"urn:doxa:passage:6397cd20efda671f029cb6bec6227d5e7ce6ab2fd3995bdfb08d088f6bfddac6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00007","start":516,"end":616,"exact":"In addition to Turkey, Hungary also vetoed the decision for the two countries to join the alliance. "},{"@id":"urn:doxa:passage:ff1d078c2bf4ebc70fa653cee8c2d3ab01a902b5f1b2b52b5c834435a0d571c7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00007","start":616,"end":819,"exact":"In February 2023, Turkey withdrew from attending a meeting in Brussels between Sweden, Finland, and Turkey, which was meant to hash out the diplomatic standoff over Finland and Sweden's bid to join NATO."},{"@id":"urn:doxa:passage:be28253e458a6b905c7dc5790d281320ba0986fa9dc5c6bf472c8aff18f57dce","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00008","start":0,"end":42,"exact":"Finland joined the alliance in April 2023."},{"@id":"urn:doxa:passage:cbbb301c4340823173e1e3fd3946233ccad448d5baaabd4b1cbd65ff037df9d0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00009","start":0,"end":112,"exact":"So it was rather surprising to hear Erdoğan renew the country's accession aspirations ahead of the NATO summit. "},{"@id":"urn:doxa:passage:8d7a9d4bcfb8c072811d5786a32b605ff2c253794d8885645c8e1db92e4a7f9f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00009","start":112,"end":354,"exact":"Shortly before leaving for the summit, he spoke to the local media, where he was quoted as saying, “First, open the way for Turkey’s membership in the European Union, and then we will open it for Sweden, just as we had opened it for Finland.”"},{"@id":"urn:doxa:passage:d2e2f481e3685ea9241b8a96480a9accdc6fbf61b07972895a0aa00a8c7f7970","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00010","start":0,"end":98,"exact":"Turkey was at odds with Sweden joining NATO following a Quran-burning incident earlier this year. "},{"@id":"urn:doxa:passage:0ffa4b5bca1d2ec3ed5b51c572eb196f7fe8449cf890c1df466a2f8d71ed075e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00010","start":98,"end":215,"exact":"But Erdoğan's gripe with Sweden goes beyond what the leader described as an “insult to the sacred values of Muslims.”"},{"@id":"urn:doxa:passage:cd2543e335bb3f6322d7dfde31bba493581b77e08b93ad7c21e1f113f1694ac1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00011","start":0,"end":78,"exact":"Whatever the explanation is, soon there will be answers, wrote Turkey experts:"},{"@id":"urn:doxa:passage:0653e13524b443bfbaac94656043af8c4d48cf16c7ab3aa36255263ba4e4dc00","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00012","start":0,"end":199,"exact":"Official Ankara has other asks from Sweden too, including banning pro-Kurdish demonstrations in Sweden and extraditing various individuals Turkey labels as terrorists, wrote journalist Amberin Zaman."},{"@id":"urn:doxa:passage:534dc992d16fe3c6caccea05355651cbfac4719d302fa0689990a8c070421dde","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00013","start":0,"end":15,"exact":"How it is going"},{"@id":"urn:doxa:passage:b86d978740f4b1220705297021c2e5fe9c566ecf1baf4cf63e0743d1601c6a1e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:84fdf54b1f618c7772a2da56d62a54d8","blockId":"gv-792968-b00014","start":0,"end":247,"exact":"During the meeting on July 20, EU foreign ministers convened to discuss Turkey's demands, such as “greater access to the EU customs union, visa liberalization for Turkish citizens, and an extension of aid to Ankara linked to migration management.”"},{"@id":"urn:doxa:decision:665cd39794c92258170ae2030e54b919","@type":["doxa:Decision","prov:Entity"],"recordId":"665cd39794c92258170ae2030e54b919","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:84fdf54b1f618c7772a2da56d62a54d8:u_553228d64d71dd50cea7ee06","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:d92ae47e0536d423b4be04d7abcde5009b3304091f89861ab56283ef2c8e29e6","urn:doxa:passage:8887cde33ccb3577ec40a6f9af293366a7a51a45417f9ba088994649718db0fa","urn:doxa:passage:90e6ab4c9b39be320803744bcf5384e322e726d461ffaa647f58e16f632aa466","urn:doxa:passage:a6e71f08108507c4fe424cb928384e2d9a65c5008052cdcfda3555b3b80d02c4","urn:doxa:passage:0ae46c3df4cb4e7bdfe4e6c6ae3c1cbe86cb415807b98d75f9e7d4e36907ba7f","urn:doxa:passage:c32ce99cba0292ec42b0da60231096b9b688712df1dd5bcccec17a021939e559","urn:doxa:passage:dc42042051cc13553b27273de881936036b5237b34afd51dac60be4e30a13f06","urn:doxa:passage:8fa47fe0b05ff1b1f55b2fcdf2bce792ea7a9585c5d8bb8b7b00138513cd9645","urn:doxa:passage:93312ad9c4e03f65e2eb73ef12632513067417f9600da1594258e4f85902f0f4","urn:doxa:passage:34d33d8e1c38c1d5606227c26e4cc4fa9065226c771764353d3cfaa5fce89404","urn:doxa:passage:1f07e0a4e72494ee5612eac62631ef39f0680afcad99cc43d69297bc942d958e","urn:doxa:passage:dd96eaf528d670bd1fbb17c43cd6137212049fa02e0afffd462c623eadd97afd","urn:doxa:passage:749a331a9704bd4f6b85c24935b17b776f66ce38d6d3aa63ea3fbfaa2ef7bce0","urn:doxa:passage:7f1a29cc75048fbc199be630e73f140fd03690f9b82b90478efd3267bc8ad707","urn:doxa:passage:5f17a58f40ec55d907cd041e7d76585db4747e26febce521cd85995b2865fadc","urn:doxa:passage:84beac567f5b37732a8c766ceaf43aeae72eb6d3f2