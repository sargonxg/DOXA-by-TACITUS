assage:cf9df96996d0adf139dfd7979f62310f5821c68da85df1bba096b44a1824fd33","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00015","start":182,"end":222,"exact":"But my family are law-abiding citizens. "},{"@id":"urn:doxa:passage:c2d1792e35fed6212c19ef9dff4bdd5677169e2649881125816f5920b1f685fa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00015","start":222,"end":272,"exact":"My mother works as a tailor, she designs clothes. "},{"@id":"urn:doxa:passage:cf9bae4e3d6d8d4704000f565bc2171eea9a6ea579ec15100328a3b38662a3d4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00015","start":272,"end":352,"exact":"My father is a businessman who used to run his own shop selling imported goods. "},{"@id":"urn:doxa:passage:adfd3f4239715ef3c9339962234a347f054152f40e041188517be7226ca22178","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00015","start":352,"end":478,"exact":"And my brother studied biomedical analysis, but was always very interested in cars and ended up starting his own car business."},{"@id":"urn:doxa:passage:593928286e96945ec976c5172ba8f69dcf583e2e9192806d42a4fcb6a06b7ef8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00016","start":0,"end":137,"exact":"> I believe that by sentencing my family, the Chinese authorities want to put pressure on me and my sisters, and break us down mentally. "},{"@id":"urn:doxa:passage:3c287216e61fea9933edb5af6225ef902d9a1284da63aad946fea5bb343b4568","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00016","start":137,"end":162,"exact":"But I will not let them! "},{"@id":"urn:doxa:passage:d6dd9c56be19a4591d77f2cfb36913f6c5999ffb47699b34b40bcbf87836d692","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00016","start":162,"end":190,"exact":"I'm even more dedicated now!"},{"@id":"urn:doxa:passage:34ea44640523282905f909e717d14617dc5f7cf8d264c2569281078b6ba4853c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00017","start":0,"end":80,"exact":"GV: You recently received some news about your mother, can you tell us about it?"},{"@id":"urn:doxa:passage:1dce0b5670165510f4ebc8b794077b8390696687044fbaa8319fe9568e7614bb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00018","start":0,"end":159,"exact":"> MA In September, my aunt suddenly called my sister in Norway, saying that she had visited my mother in prison, and that my mother sends her greetings to us. "},{"@id":"urn:doxa:passage:c66433cef26963245f0cb5afd709db8cee1e0d3e6884d8f8e21e23ec86f2136e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00018","start":159,"end":242,"exact":"According to my aunt, my mother is doing fine, and is allowed visits twice a month."},{"@id":"urn:doxa:passage:84276c1cebcdf0d32103b066f78e3f4cf848514c0e5d029353d0b923ab61b629","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00019","start":0,"end":124,"exact":"> I believe that the authorities forced my aunt to call us, as a way to calm me down, in the hope I would quit my activism. "},{"@id":"urn:doxa:passage:ca0e2d13ffe795d46407a86752a09fdda2d52cad0d473d6ba89a9d1fcaf38a26","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00019","start":124,"end":252,"exact":"Any contact with relatives abroad is dangerous for Uyghurs these days, so there is no way my aunt called on her own initiative. "},{"@id":"urn:doxa:passage:121f660802f1b733fc890090a2b7abb06cf6167e3ddf16ac145e064a9738758f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00019","start":252,"end":356,"exact":"When answering the phone she told my sister: “Don't ask me anything, just listen to what I have to say.”"},{"@id":"urn:doxa:passage:2e92d5e065385f31da941dd449310d80361363ee504237b2d27a51c393289558","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00020","start":0,"end":85,"exact":"> Until I can talk to my mother myself I don't believe anything I am told about her. "},{"@id":"urn:doxa:passage:66e884150b1c24f1288ab910b412ae59118d283115c0d71f2341199de4777fb9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00020","start":85,"end":178,"exact":"This call from my aunt came just after a period when I had been very active on social media. "},{"@id":"urn:doxa:passage:cc9465725bf755a9c390d6c26909fc6b0b4eb64391f89c6cb8f2e8b49337c93a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00020","start":178,"end":323,"exact":"The Chinese authorities want to show that: “Look, Uyghurs can actually contact their relatives abroad.” I believe my activism is pressuring them."},{"@id":"urn:doxa:passage:3c68f30a0a82a2cef1e9a763ebdc7833ff6435dd224bdfbc1fd3adee483713ca","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00021","start":0,"end":142,"exact":"> In Chinese prisons, relatives have to pay 300-400 Chinese renminbi (US$ 45 to 61) every month, to provide a prisoner with food and clothes. "},{"@id":"urn:doxa:passage:6af47c8e84fcb1178de0dc6f21ab3b7ba1604966d44b1a46f92b31ef4df80d3b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00021","start":142,"end":234,"exact":"I know that my aunt is paying this sum for my mother, but what about my father and brother? "},{"@id":"urn:doxa:passage:7f2d42b7335ec2a30e6a34ff3fdbe4b975b23cad219e3875016a100aafd9a901","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00021","start":234,"end":337,"exact":"It's just the close family, like siblings, parents and children, that are allowed to visit a prisoner. "},{"@id":"urn:doxa:passage:c44280597a582dda091a4f18225246e185d846b49e9a1ffb1c2c62f35cee40c8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00021","start":337,"end":370,"exact":"So who is caring for my brother? "},{"@id":"urn:doxa:passage:3bd017635d385f0e6892558f729fc392fbf81410a831aa43de9f115366473d04","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00021","start":370,"end":438,"exact":"Both his parents are in prison too, and his siblings are now abroad."},{"@id":"urn:doxa:passage:96e40bbbed566878aea0db2adc039d11d79309d643a4a225d00ba7f72ce93bfb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00022","start":0,"end":47,"exact":"GV: How do you cope such a stressful situation?"},{"@id":"urn:doxa:passage:80cf579b9058302b56d385a13b1c3625ee97974039c3683c410c38fa847b7184","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00023","start":0,"end":84,"exact":"> MA Of course, when I got the news of what happened to my family I was devastated. "},{"@id":"urn:doxa:passage:a7a43ebc1761127236db39646b938bf9def9f59e8c42b1c4c86e9b6e767a1856","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00023","start":84,"end":104,"exact":"I cried for months. "},{"@id":"urn:doxa:passage:1defa5215f7f64e282a4722b026c6269277fd22963d14f2fd73bbe7113dbbecd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00023","start":104,"end":154,"exact":"I would have been less sad if they had just died. "},{"@id":"urn:doxa:passage:33fa38a08819de68873d835143df5071afb6deb84b2059ef433fc286e25a090b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00023","start":154,"end":256,"exact":"The thought of what they are enduring in the Chinese prison is so painful, it is such a heavy burden. "},{"@id":"urn:doxa:passage:969335e6ae8ab4ea8bc9720c5f15ec4bcb972437119d05f65046edb968edd1ed","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00023","start":256,"end":292,"exact":"But I can't just stay home and cry. "},{"@id":"urn:doxa:passage:3c9cc17bf5fd9c6cfc6899930c54b719c8e694ffd37a2e33de8db13f7589a362","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00023","start":292,"end":344,"exact":"I have to be strong – I have two children to raise. "},{"@id":"urn:doxa:passage:c351b0bea27bd570e8c8e7810f9f6cb0d5ae69e44a13893ed43fb4ac3503d418","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00023","start":344,"end":405,"exact":"And I have beautiful dreams about taking care of my parents. "},{"@id":"urn:doxa:passage:a73b94a69a10b903cea505a5d93e39747548780d7e751c7c6824d4fb90d53ad2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00023","start":405,"end":477,"exact":"The more active I am and the more things I do, the more positive I get. "},{"@id":"urn:doxa:passage:9df9b747764bcdf88167fc31060778ff57df112affde8881cb2d617d637b6286","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00023","start":477,"end":525,"exact":"This is something I learnt from my dear mother. "},{"@id":"urn:doxa:passage:02a22cb996770d8f4222f981fc1bbeb9c71a20a7cd4d56205f7479c62a0858ee","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00023","start":525,"end":560,"exact":"I will keep fighting for my family."},{"@id":"urn:doxa:passage:d197f54d6026017a15cf28d64bc6ae4b85fa978a6b6104df61791dc3a1332831","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00024","start":0,"end":77,"exact":"Read more stories on the persecution of minorities in China’s Xinjiang region"},{"@id":"urn:doxa:decision:a6b49eca6bc331af4f7aff4340f7997f","@type":["doxa:Decision","prov:Entity"],"recordId":"a6b49eca6bc331af4f7aff4340f7997f","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:ac84e1a21d3973a7427f780cc45da249:u_8d7849c44e7d3034ce8ebb4d","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:392b3817bcaefa7c9ae52a69932dd5c1687d383465a9214f102e292a06bba975","urn:doxa:passage:7b3e55feb8026fe17be6c6a18062198b2fb1f691d65217ab646531fe0e984733","urn:doxa:passage:cff603ab9bcd1c7efbe4b82c74647861b508f49d9f4c1aa0d684cbdd7be79b82","urn:doxa:passage:cf9df