19a6ece8abc4bd2717db8945cbbc6","urn:doxa:passage:08e3ce7cc86d5eaeb3f2d4e04b36f1623a1168d14c0aabc240233cafcf389d07","urn:doxa:passage:2a4b2bf9c41d9a39cf6fbd492038c487e331a0e9a2c4e9f36ef7c828c322d102","urn:doxa:passage:531293605def353a58e6a77791f4953ab1749330a68f372c289bf2b37b490587","urn:doxa:passage:c228d7b93d67e633af743f40caebfd6b3437824e072d199627e0f9f19e874f06","urn:doxa:passage:0be739bb8f1a4fad7d5ff23d8be3b9774d00c014aa9043052b3049f95676047f","urn:doxa:passage:6f23544ef267bad5aa109375ac871a1fa31bf23a4ca264cf67279e99bcb71734","urn:doxa:passage:4e1b7874f65acb4b3f35f13d62ce09b4f8ab90f26857e8e3ab176fe77f709c9e","urn:doxa:passage:82ddd3170fbba00ae730ea3c3eceee37d768bcd2bde3901b041abd4e623307d8","urn:doxa:passage:d176471c72f20a3f56071066069596a9271c3037effa5497b593afd4b8ed6197","urn:doxa:passage:175a2094c03e53528afdea61b6631ee4fd5b98ef02d470a20e0664a0130b5606","urn:doxa:passage:cd22f718755baee55a09b2c9dd95852d97654f2eeb224457dd1d82524c2f1130","urn:doxa:passage:dec30fa9c8137012f3f80c1cb011c3107cf79abe759163a6e83f75d3232a5135","urn:doxa:passage:84794c14a68cc3968c4c65bcc42035fecbf629b965f953f918924affa87fa73a","urn:doxa:passage:9f0811fb27e6b3e776a71a589252bec91c8c82e6fef11854d61a684aa677c845"]},{"@id":"urn:doxa:decision:b3ae7eda69d584b7227c1acf1d6e87bd","@type":["doxa:Decision","prov:Entity"],"recordId":"b3ae7eda69d584b7227c1acf1d6e87bd","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:c9db0ddf1b2c11ef6a8b787d3f15e4fb:u_91aafb17d3df2ae314465e8f","attribution":"author","speaker":"Syed Salman Mehdi","speakerStance":"neutral","documentStance":"neutral","proposition":"none","hypothetical":false,"reviewStatus":"unreviewed","modelPassage":["urn:doxa:passage:18e743e97077eab4ab861c29a36d51cbadb4bd0845863c4873f7a04c628e3cc6"]},{"@id":"urn:doxa:passage:92e897fd6abef8a164276655dd1fceac16d59643a1b7d8041c449387aaeb19f1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00001","start":0,"end":71,"exact":"Across continents, women face the same struggle under different names. "},{"@id":"urn:doxa:passage:39176190b0d1e1c8dbf9f54584a9d2d60449e1edc2f12a283d9cb4c330093fe2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00001","start":71,"end":187,"exact":"Some are told to cover their faces in the name of morality, others are told to uncover them in the name of freedom. "},{"@id":"urn:doxa:passage:0c0d5fcf35f85908f55471669d9b8bd6c8b6d113dd56f94ad68e3848c210b47f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00001","start":187,"end":211,"exact":"The result is the same. "},{"@id":"urn:doxa:passage:5a2bdbcf4b217e2af69b03868a17c3e1e146f8db01eb7b4b2b486c2c63d12d23","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00001","start":211,"end":299,"exact":"A woman’s right to choose remains in the hands of men and lawmakers rather than her own."},{"@id":"urn:doxa:passage:0c0e5039eba6f5e667a14ef6768a5fc3e3f3deb0b55d310125df09375d9f7a3f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00002","start":0,"end":80,"exact":"The year 2025 began with Switzerland enforcing its nationwide ban on the burqa. "},{"@id":"urn:doxa:passage:1b91a153008436507ed4ba96ee3562e9092cc48ed5b0286fc236a7c3684c1b59","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00002","start":80,"end":190,"exact":"Soon after, Portugal followed, and now Canada has joined the list through Quebec’s expanding secularism laws. "},{"@id":"urn:doxa:passage:c1bcf0c7578898c40d20ae6b66b8ef9cc9233152f3856cde8eafb08512d07f9d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00002","start":190,"end":293,"exact":"The idea behind these bans is often framed as liberation, yet the outcome feels more like restriction. "},{"@id":"urn:doxa:passage:5e3b7ebf9413a3fc76b8d3c141a1bf1486cfc198ba15cef8d52f9feda18d705a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00002","start":293,"end":403,"exact":"In these societies that call themselves “free,” women are once again being told what they can and cannot wear."},{"@id":"urn:doxa:passage:71f4cf082fa09f9a0c5b0fbf5817ffcb5a1030bdf7e8ba6d18b722691bab1256","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00003","start":0,"end":216,"exact":"In Quebec, the government has recently reinforced its secularism policy with a new law that prohibits students, teachers, and even volunteers in public schools from covering their faces or wearing religious symbols. "},{"@id":"urn:doxa:passage:6cdd051bfcded096407c4df96219e45ebffcec7ac2d650b8fa9e9462447f9d74","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00003","start":216,"end":395,"exact":"While the officials defend this move as necessary for equality and neutrality, it has become an obstacle to education and employment for Muslim women who wear the hijab or niqab. "},{"@id":"urn:doxa:passage:5321e55c0012c9d02b29849805c55451b7fe3a28131ae51bbccb62334a6d48be","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00003","start":395,"end":503,"exact":"Those who once taught or took care of children are now excluded because they choose to practice their faith."},{"@id":"urn:doxa:passage:15434277d6a6a8d1fc61cc812c7bf58539621c654d69cd00cb92cd3228dda6c0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00004","start":0,"end":46,"exact":"The policy has spread further into childcare. "},{"@id":"urn:doxa:passage:049586639a2a7bbf58a40a06c765599f3c18e5dbfa6a83e044ac7003bebddf4e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00004","start":46,"end":164,"exact":"The government plans to ban religious symbols in daycares, claiming it protects young minds from religious influence. "},{"@id":"urn:doxa:passage:983323f39b2b8a2597aef3e52d80adafda7176d30c91de89812208d92dc75203","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00004","start":164,"end":274,"exact":"Yet many daycare directors and staff argue the move will worsen staff shortages and push out skilled workers. "},{"@id":"urn:doxa:passage:2a77af02959a0149a053ce25b9b0b859f8026895dc5233974189d7bffd06717a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00004","start":274,"end":331,"exact":"A teacher wearing a headscarf is not preaching a sermon. "},{"@id":"urn:doxa:passage:11a85dc141d814a78df0603032d6ae84e353b0af8bbe920c455a6f5f6a40718a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00004","start":331,"end":359,"exact":"She is caring for children. "},{"@id":"urn:doxa:passage:c1e1f6c5afce0e61683cc61032d39b727989d0c2dfdac1689cf5c9d98dd74131","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00004","start":359,"end":450,"exact":"The idea that her clothing threatens neutrality exposes a deeper fear of visible diversity."},{"@id":"urn:doxa:passage:a7d9245f59e14fdb2172abd6aaccc1b7eaf799a5aef86c5f26a4b460aff15c7b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00005","start":0,"end":58,"exact":"Political competition in Quebec has made the issue worse. "},{"@id":"urn:doxa:passage:1c8cba3013c321193684fbdf2e6c0806d61fdd630956ab841d043995a89a93ca","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00005","start":58,"end":161,"exact":"The Parti Québécois recently vowed to ban religious symbols for elementary school students if elected. "},{"@id":"urn:doxa:passage:8f2759cbc1b1874a56013cacd5edcfbbb1e1b30fc5e2682eac39efb1453426e4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00005","start":161,"end":241,"exact":"The ruling Coalition Avenir Québec party also plans to restrict public prayers. "},{"@id":"urn:doxa:passage:df39f7fc5a23c6915eed8ced76cbb0de141398bd8c9f440c9def6be62c28eda3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00005","start":241,"end":354,"exact":"Both sides are pushing minorities towards marginalization and promoting such measures in the race for secularism."},{"@id":"urn:doxa:passage:fe306d205135a979c58082805c47ef8281ec4645114f904a28bbb641edf54e16","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00006","start":0,"end":44,"exact":"This debate has now centered on the courts. "},{"@id":"urn:doxa:passage:3d9ccf4e43b630432fd8edb820e94a2f2c5d9b7b5b2ac2ae8c82085d8cf65c80","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00006","start":44,"end":176,"exact":"The federal government has questioned the exercise by Quebec to use the “notwithstanding clause” to shield the analysis of Bill 21. "},{"@id":"urn:doxa:passage:8d3fb66b4cb5ad739ce2a53227c669594f4ffbce896e30853fbf393818842dec","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00006","start":176,"end":290,"exact":"Ottawa argues that this clause, used repeatedly, weakens the Canadian Constitution and undermines minority rights."},{"@id":"urn:doxa:passage:9254763561761498707055d7fd63ad3b1cf24026b6d1360c128cdb452af98fc6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00007","start":0,"end":30,"exact":"Legal experts remain divided. "},{"@id":"urn:doxa:passage:695680692b444e8bb0582ad237fa819415d4c15b570562eb45f5df58808e9276","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00007","start":30,"end":138,"exact":"Some call this use of the clause preventive and dangerous; others say it preserves provincial independence. "},{"@id":"urn:doxa:passage:626eb6fbe6bb88748483aee47e9ba0e4d0610110c32110d41683eab9edc97af5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00007","start":138,"end":291,"exact":"The coming Supreme Court decision will determine not only the limits of religious freedom but also how far governments can go in shaping private choices."},{"@id":"urn:doxa:passage:23a64abd6986b8ec355619af94f1db6d729152012e13c364874cd5b7d11fd222","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00008","start":0,"end":54,"exact":"This wave of bans is not limited to Canada or Europe. "},{"@id":"urn:doxa:passage:b1353bddaa317a4fc459ec5fbe0c1d12018b0f3b832f66527762c3a3f70ddedd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00008","start":54,"end":145,"exact":"In some West Asian and South Asian countries, the control works in the opposite direction. "},{"@id":"urn:doxa:passage:4e78fbbc632a7b0e2d307b7bdf9d814cf4cfee263d1916c6f021f356fa2a464d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00008","start":145,"end":204,"exact":"In Afghanistan, women are forced by law to wear the burqa. "},{"@id":"urn:doxa:passage:9d31b23a46f0baae3dba20bd171bbb803eedd7528713c31518027137207bfad1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00008","start":204,"end":258,"exact":"In Iran, they face punishment for removing the hijab. "},{"@id":"urn:doxa:passage:618f303e359710b684118dc6bd32049538046ddfca07d6402d4c3a820fcc99f5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00008","start":258,"end":353,"exact":"In Saudi Arabia, although some restrictions have eased, women still live under moral policing. "},{"@id":"urn:doxa:passage:8101ce839597b1b0d4c7965bdbc181a5f306c44e85fc9c94a9c94e5d67e0c3a5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00008","start":353,"end":442,"exact":"Even in places like Syria, Jordan or Egypt, traditional pressures push women to conform. "},{"@id":"urn:doxa:passage:75af94e64c452a6485b1a555964879316a6b74e8c9ae33296a897ad05c7ebdeb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00008","start":442,"end":485,"exact":"Across borders, the message is consistent. "},{"@id":"urn:doxa:passage:0f176a0912821802021de5c95fa0a7685dac0755b2299873905b494a666fcea8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00008","start":485,"end":609,"exact":"Whether it is forced covering or forced unveiling, women’s bodies remain the battleground of political and cultural agendas."},{"@id":"urn:doxa:passage:4c5b89ddc3367b798d750e3f374b96be3cb1e9da932be951f19568aefbbd4472","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00009","start":0,"end":31,"exact":"The contradiction is striking. "},{"@id":"urn:doxa:passage:8e8832c25d7316e34baf0e7e5d7bfa1d922a37946a669f2892791ac2cd39ab9c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00009","start":31,"end":129,"exact":"Western democracies, while condemning religious coercion abroad, impose dress codes of their own. "},{"@id":"urn:doxa:passage:47e24a67b8fc4751087809427a8e5f3c928ee3a2c62acd3d1c3789de95882704","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00009","start":129,"end":239,"exact":"They argue that removing the veil helps integration, but in doing so, they push women further to the margins. "},{"@id":"urn:doxa:passage:e2bf81dce22092f24170f98795a3ca23e27fbab06353f92f486cb27df195b4b6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00009","start":239,"end":401,"exact":"A Muslim woman who chooses to wear a headscarf in Paris or Toronto should not have to defend her choice any more than someone choosing not to wear one in Tehran. "},{"@id":"urn:doxa:passage:8b7d1f1a08461b8c106e25bfadccc92f4444555ed3b608626291e64b11780f9c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00009","start":401,"end":474,"exact":"The heart of freedom is the ability to decide without fear or punishment."},{"@id":"urn:doxa:passage:00a7f1c4e141453dc5d965d7c4a89db99136facc9fba3312540079a774b08423","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00010","start":0,"end":55,"exact":"The argument that these bans protect equality is weak. "},{"@id":"urn:doxa:passage:e75524f06faa2526913767b59379fdf12a49e2dcad14abcec4a074959ecdf48e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00010","start":55,"end":109,"exact":"True equality comes from opportunity, not uniformity. "},{"@id":"urn:doxa:passage:37d115f4e68047e7f269d5b0e6032770a36825c2e4660d62e63eac669f948d2c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00010","start":225,"end":308,"exact":"It also conveys a message that religion and serving the people are not compatible. "},{"@id":"urn:doxa:decision:d653db6a3131280d20e14ec3d0b94c55","@type":["doxa:Decision","prov:Entity"],"recordId":"d653db6a3131280d20e14ec3d0b94c55","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:c9db0ddf1b2c11ef6a8b787d3f15e4fb:u_92e9dcd28e870c2877c80871","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:92e897fd6abef8a164276655dd1fceac16d59643a1b7d8041c449387aaeb19f1","urn:doxa:passage:39176190b0d1e1c8dbf9f54584a9d2d60449e1edc2f12a283d9cb4c330093fe2","urn:doxa:passage:0c0d5fcf35f85908f55471669d9b8bd6c8b6d113dd56f94ad68e3848c210b47f","urn:doxa:passage:5a2bdbcf4b217e2af69b03868a17c3e1e146f8db01eb7b4b2b486c2c63d12d23","urn:doxa:passage:0c0e5039eba6f5e667a14ef6768a5fc3e3f3deb0b55d310125df09375d9f7a3f","urn:doxa:passage:1b91a153008436507ed4ba96ee3562e9092cc48ed5b02