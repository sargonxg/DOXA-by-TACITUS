ge:7bd7092bcdf46c222b640634e9ea76e703924a9e12663fda437e253367f5d90f","urn:doxa:passage:0fbf04b0243e3fac5f08ccf1bc40ea471e818b6b43edd5a7e8006de889084675","urn:doxa:passage:2f0903294ce1032f894bbb03598f4674d1bbf1ed936a4406f569397295747dbe","urn:doxa:passage:d879ad5696c74d66afb55b4f91c2733f1068efe9d38d14312de089200589bb89"]},{"@id":"urn:doxa:decision:ae3a5219538dd9f477dfff71f66c609b","@type":["doxa:Decision","prov:Entity"],"recordId":"ae3a5219538dd9f477dfff71f66c609b","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:0e9f9553a6bf8d137818af3d0c4dca51:u_3d6482f7d008980666a116e0","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:e3e34951a6ab9d8cc4222032e2d6920f7b0406ac88a5cd84cee62a9f2c2c9b28","urn:doxa:passage:8c0151bd4d51b1e96e95db63d64d978cf34e0814a85ca28a10d8d8728af6acf9","urn:doxa:passage:135c5b713fb110435afadaa9e34df1391fcb58e0623ddee864aa8679db2956fa","urn:doxa:passage:b05524fcdd87ee4536045773820825d717b723f4827768922123700b1b00903b","urn:doxa:passage:5a99fb1a8b56748d287ce9d42bd8af0a35993dd869ee9fe29f4c4ddac0549788","urn:doxa:passage:a59e514f36e7bb2ca2b988054ea0640d6cc23dd9058f0329a2aad59afdb9c0c7","urn:doxa:passage:04249c7b4b99626369cf1ff8881a6e0fa8ecab50857f6f250ee08311dcfeea53","urn:doxa:passage:f8ad8c187258ca6c70b6b7f5412b82667a6a1b1590f13322e7a078c84dad6a37","urn:doxa:passage:65fbf688a9adc395aae2e27aeb90c27fcc2eb21c99a50288841c5486d6bc7f08","urn:doxa:passage:7bd7092bcdf46c222b640634e9ea76e703924a9e12663fda437e253367f5d90f","urn:doxa:passage:0fbf04b0243e3fac5f08ccf1bc40ea471e818b6b43edd5a7e8006de889084675","urn:doxa:passage:2f0903294ce1032f894bbb03598f4674d1bbf1ed936a4406f569397295747dbe","urn:doxa:passage:d879ad5696c74d66afb55b4f91c2733f1068efe9d38d14312de089200589bb89"]},{"@id":"urn:doxa:passage:41d8e8d83e4420bf8d176d647af018784751a553dd8e6e6a03d4642dce0f6d51","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00013","start":0,"end":350,"exact":"In an interview with Global Voices, Saad Salloum, an academic specializing in Iraqi minorities, and an Assistant Professor in International Relations at Mustansiriyah University in Baghdad, highlighted that the Simele massacre deepened the distrust between Assyrians and their Kurdish and Arab neighbors, especially that the oppression never stopped."},{"@id":"urn:doxa:passage:12b4ad19cc1c1ee990e3fbf9839fb4bdc42deac2f38526be7bdc92a3b113c0be","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00014","start":0,"end":129,"exact":"> In 1933, the Simele massacre, led by General Bakr Sedqi, mirrored the horrific legacy of the 1915 massacre against minorities. "},{"@id":"urn:doxa:passage:9bf2e00305ce6dbc572dc64c7c82bd53ab28053e58705462d8db824ede832f78","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00014","start":129,"end":208,"exact":"By 2015, ISIS terrorist group continued this grim pattern of gradual attrition."},{"@id":"urn:doxa:passage:7165a9c7eb322f6888d70b5e5bfee0503799fd3d72d06fd09d1225ac853789cb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00015","start":0,"end":126,"exact":"Massacres stories were passed down orally across generations, as Assyrians lacked the freedom of expression to document them. "},{"@id":"urn:doxa:passage:055aecd3871cb245ce784f9a031978731485e373411d6be7bc99c0d50cb793f5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00015","start":126,"end":316,"exact":"In the second half of the 20th century, following their mass migration to Western countries, they gained more freedom of expression to publicly share these stories through their descendants."},{"@id":"urn:doxa:passage:1fb444a27edbab236171317a7f30faae2019a2b7141422b0669e9918b876891b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00016","start":0,"end":161,"exact":"In the early 1970s, the Ba’ath government in Iraq tried to improve the status of Assyrians by enacting a law acknowledging their cultural and linguistic rights. "},{"@id":"urn:doxa:passage:228f6bafe7dace53654f9e79f3a8b068d51d79d9e9acd375841f36fd0841fe5f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00016","start":161,"end":340,"exact":"Adad Youssef, head of the Alliance of Iraqi Minorities Network (AIM Network), noted in a conversation with Global Voices that, although the law was a step forward, it felt short. "},{"@id":"urn:doxa:passage:68d334d23a40c8e5c002c7aed68b8b8ee2d2193faa889719eb0690321e8ecd6b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00016","start":340,"end":485,"exact":"It recognized Assyrians as speakers of the Assyrian language, but not as an ethnic group, nor did it grant official recognition to the language. "},{"@id":"urn:doxa:passage:bc94c061ec3755d0a36e93668784f2bee79f8765b68e883252c6c56d049059df","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00016","start":485,"end":552,"exact":"Nevertheless, this support helped preserve the language for a time."},{"@id":"urn:doxa:passage:0884470ea8588746fcfc40f842fd9da0db36a7fbc770f3616e56f53adc7fbe08","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00017","start":0,"end":153,"exact":"> The recognition of the rights of Assyrian speakers was far from the truth, as the Ba’ath Party categorized everyone as Arabs except Kurds and Turkmen. "},{"@id":"urn:doxa:passage:8c7f615e1c267e42ace0e515bc439875222535a32ba761138e332793fee6155b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00017","start":153,"end":297,"exact":"Nonetheless, this recognition enabled teaching Assyrian language in official schools in Assyrian-majority areas for many years until it stopped."},{"@id":"urn:doxa:passage:bef9f95366d82b33a5ceff12723c229fe57ed9f95a029eb97750b3ea0859bf83","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00018","start":0,"end":162,"exact":"In the late 1970s, Saddam Hussein unleashed a campaign of oppression against his critics, including minorities such as the Kurds, Turkmen, Assyrians, and others. "},{"@id":"urn:doxa:passage:b5df643aeb304daa5ea43aa1153580f171cab40836b4c518ac4f0e4684c030ea","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00018","start":162,"end":287,"exact":"He stifled their expression of identity and Indigenous languages, wielding an iron fist over media and freedom of expression."},{"@id":"urn:doxa:passage:5cc78d8bd4b82629c4bb5602c0a2372e58ee252a0f03fe221631b5599214f58b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00019","start":0,"end":121,"exact":"Under Hussein’s rule, an unusual dynamic unfolded for some minority groups, as noted by Assyrian activist Juliana Khamo. "},{"@id":"urn:doxa:passage:c7c561f934cd5c6c2fc8a4ae08061a79a0836ec6e27d45fc4ccdb3de4769c1b1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00019","start":121,"end":295,"exact":"It was a social contract where Hussein offered a relatively comfortable standard of living in exchange for minorities refraining from exercising their freedom of expression. "},{"@id":"urn:doxa:passage:62241e2df2b82b79e52fdf82754bb5a1d7e4be2b94faa628596e0d2f0dcbf8a9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00019","start":295,"end":409,"exact":"For Assyrians, this meant preserving their religious identity and language by remaining on the fringes of society."},{"@id":"urn:doxa:passage:d7a69eaec5790e04b1171a3215f43582a07d4c4d4b83c170d46dbaf8c3e62b64","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00020","start":0,"end":209,"exact":"But this delicate balance shifted with the American occupation of Iraq, which not only dismantled Hussein’s regime but also paved the way for the resurgence of militias and terrorist groups, most notably ISIS."},{"@id":"urn:doxa:passage:a8cb1700055d3db1ee99c1f23414551ffa504d6df50d01e4a3f75c362b7c05fe","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00021","start":0,"end":93,"exact":"ISIS targeted Assyrian minorities among others, committing horrific atrocities against them. "},{"@id":"urn:doxa:passage:89d765f96b8f8e40f80e09855535ebc2e5d5e17c681c8739559b440c23130d4e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00021","start":93,"end":253,"exact":"They destroyed churches, monasteries, and invaluable Assyrian cultural treasures, such as the ancient city of Nimrud, a vital archaeological site in the region."},{"@id":"urn:doxa:passage:83281cde2d712d4d077648a3f6ac3c49d9ecf6c54b8d3d4d53c936308f415e1a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00022","start":0,"end":134,"exact":"Assyrians were coerced into converting to Islam, had their properties seized, and faced strict religious and linguistic restrictions. "},{"@id":"urn:doxa:passage:b7eacaa24f3ea85de12d4674aa7ae486c688f1e2b04992aea5e0999056304069","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00022","start":134,"end":215,"exact":"Assyrian women and girls, suffered repeated sexual violence and forced marriage. "},{"@id":"urn:doxa:passage:a59fb3a1b3729d7df994e1fc742f96ed2bbbb8cfc7babca9d45a3df33442bf24","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00022","start":215,"end":292,"exact":"This reign of terror created a climate of fear, self-censorship, and silence."},{"@id":"urn:doxa:passage:1781f26ccbb1f813ffd92eef8049c963c7d4fdc3dede5f9a3aa73f397dbdce0d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00023","start":0,"end":67,"exact":"The status of Assyrians’ freedom of expression in contemporary Iraq"},{"@id":"urn:doxa:passage:af65b8b20bc9c025e71ad8e11b19c21457acb1d5e8ec35614cc157a09e346c0a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00024","start":0,"end":107,"exact":"Before ISIS emerged, significant developments regarding Assyrian’s freedom of expression in Iraq unfolded. "},{"@id":"urn:doxa:passage:85315ca2da339b5083436ae4401d96b97e82e75e4b29d1eb7afda6e569326d10","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00024","start":107,"end":262,"exact":"In 2005, the Iraqi Constitution officially recognized the Assyrian language as a minority language, providing new opportunities for linguistic expression. "},{"@id":"urn:doxa:passage:83efeb33a09e753347972ddfe0dc4b0cf19fee001e43c606eff11ebc0efc32b3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00024","start":262,"end":289,"exact":"Activist Adad Youssef says:"},{"@id":"urn:doxa:passage:cec8e98513c8cae6d51c1f990f9b7639c9cadcb374c591093b07f3f336da99c8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00025","start":0,"end":117,"exact":"> With the official adoption of the Assyrian language in Assyrian-majority areas, Assyrian education has flourished. "},{"@id":"urn:doxa:passage:96f00f948762242f4c9635895c8147df66a2fb5f9cea6af9b9fdf4afb96f6ad4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00025","start":117,"end":268,"exact":"Over 260 schools in Iraq now offer Assyrian, and the languages department at the University of Baghdad has established an Assyrian Language department."},{"@id":"urn:doxa:passage:537001ef13b76ce3a296c6349ebd5062b4a40e473169b664ec1e4fc71693cdeb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00026","start":0,"end":202,"exact":"> Additionally, associations, clubs, and parties that publish material in both Assyrian and Arabic have been formed, covering a wide range of topics including religion, culture, politics, and education."},{"@id":"urn:doxa:decision:74b20764b1e876b240239de7327dbfdb","@type":["doxa:Decision","prov:Entity"],"recordId":"74b20764b1e876b240239de7327dbfdb","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:0e9f9553a6bf8d137818af3d0c4dca51:u_47573188b029323b142b5518","attributio