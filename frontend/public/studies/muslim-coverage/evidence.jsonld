9e6115d623f44c4b71c660ca5","urn:doxa:passage:0e7d9a5b21b0d1d63f2fd7240aa28a781ae554303bd64b805a040c0122eb2bff","urn:doxa:passage:bbd2a35f453630b1630faa2cb12081e58efdd26ee49916f6734592fa04db9a22","urn:doxa:passage:a2845f676e020fdcd2469ef27bbdd87b6d926a868132bcb949e5c59a9e3b5a13","urn:doxa:passage:e160cb7554acb6892280e4cb8d7824b14d2620d72cf0f9f0b026b39f98d2c2bd","urn:doxa:passage:f04358ef63ba98b25c9533d9cda712d6bae996bf96fb1974af34fe3c208f760f","urn:doxa:passage:a49a7ea994a1ac27d4d4587f13cac7bdd5ab9d2106ec77b5f44c854a92daa322","urn:doxa:passage:2073b203ad0fbf127c1091086aa0537ce1c4193f6a4a188811ba0bd0b2740e2d","urn:doxa:passage:5832126b3888a68f7feb1648e4cf931a812cb02b1741bb307ac220576f8c7c00"]},{"@id":"urn:doxa:decision:709aa6d5db886b6a54b75f3ed8979f1d","@type":["doxa:Decision","prov:Entity"],"recordId":"709aa6d5db886b6a54b75f3ed8979f1d","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:4145f8be70c9320af514def08b00f359:u_db7922a4c10246f39596fa99","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:29334154783a8eae34329b12115f4012e598c95e3a2af2fb86614ccc337c1002","urn:doxa:passage:6a304d8cb281efe95c4c1afe93b9ac82abbabc03d82d01556b81739f41577ed8","urn:doxa:passage:85e1b9739bce48d09fd9635a4380ad19f5d517beac0251bb6b46d06e91c81e8c","urn:doxa:passage:58eb01f4647aa38eb2bf096e830352ed3859393d7fbb6de26abe818f55c5e19e","urn:doxa:passage:eedde6fbd4af7fc1652da432ad95cb5cc437029eb530be6c2f1c5e729cf9a0d7","urn:doxa:passage:907d801c1f3c05cba0bd36e82a7e645823ecfeaa2d5648c4d649209bf0751938","urn:doxa:passage:596f48a09234e2c987dd6e17409b7d232b45a704163fec6d55e4792bc58ce654","urn:doxa:passage:a3786dd3cf2cc5f99607f0e7a5bfb22a3721ec1ba2dc9c6049cdc7276dff137c","urn:doxa:passage:174146d955ff9234d1e8eae053d13ffa9caba3a6b5c682f403833d2ef31bb52f","urn:doxa:passage:401bc0349533cb81438c45d43affe5ce6cd1c1262c72ef3b7e8d3b08bece1940","urn:doxa:passage:7213c0628c83c6e026732f29813167f5223f42e31d5581548d54b7883eac0828","urn:doxa:passage:799e5eb779a982d54b6a93083ce4050c9798dd1e2352425f585e968b13dd5523","urn:doxa:passage:e4935ace484eab15fee783a384de110a8453aa594d3d3d03f972882196b43b5a","urn:doxa:passage:a1cc67de94a2d8a796a6e0c9d118ce4b6f65891a389427820c2ab860aab02788","urn:doxa:passage:c11a207ea6692e0e5cf4df8cfdcde5535c446bba6fac907de79ad58bd63a3e89","urn:doxa:passage:c1b6d9b33c1d4161038fbd09e7c3a1e8c9cad699e6115d623f44c4b71c660ca5","urn:doxa:passage:0e7d9a5b21b0d1d63f2fd7240aa28a781ae554303bd64b805a040c0122eb2bff","urn:doxa:passage:bbd2a35f453630b1630faa2cb12081e58efdd26ee49916f6734592fa04db9a22","urn:doxa:passage:a2845f676e020fdcd2469ef27bbdd87b6d926a868132bcb949e5c59a9e3b5a13","urn:doxa:passage:e160cb7554acb6892280e4cb8d7824b14d2620d72cf0f9f0b026b39f98d2c2bd","urn:doxa:passage:f04358ef63ba98b25c9533d9cda712d6bae996bf96fb1974af34fe3c208f760f","urn:doxa:passage:a49a7ea994a1ac27d4d4587f13cac7bdd5ab9d2106ec77b5f44c854a92daa322","urn:doxa:passage:2073b203ad0fbf127c1091086aa0537ce1c4193f6a4a188811ba0bd0b2740e2d","urn:doxa:passage:5832126b3888a68f7feb1648e4cf931a812cb02b1741bb307ac220576f8c7c00"]},{"@id":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-814361","title":"Turkey's Erdoğan reigns supreme at hypocrisy and double-speak","author":"Sinan Ciddi","translator":[],"publishedOn":"2024-06-10","sourceUrl":"https://globalvoices.org/2024/06/10/turkeys-erdogan-reigns-supreme-at-hypocrisy-and-double-speak/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"ba463f41ce43f503e7259fde329fb6f762ddd2ffd112c50346f1cd723aaa9dc6","textSha256":"bc31206a93ee4172b0fd9f5d723fe5441b47562f37d77befe852d83ad640c179","archivedRecordSha256":"72bc906a1b6cbbca25546d0e57b7bee4c769e492a62297d29c89529214b3b551","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:058a98317bd0948c5009874d3bb78176:u_7323e8350b5fce225e5fca14","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_7323e8350b5fce225e5fca14","status":"accepted","fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176"},{"@id":"urn:doxa:unit:058a98317bd0948c5009874d3bb78176:u_bd4749631db9b4729995fbac","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_bd4749631db9b4729995fbac","status":"accepted","fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176"},{"@id":"urn:doxa:passage:edfd9a3ed5a80bfe3470cd65ca1953de7d1dcdb6a37d8a47e55fba2cb90d78d7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00001","start":0,"end":135,"exact":"While hypocrisy is nothing new in global politics, Turkey’s President, Recep Tayyip Erdoğan takes the practice to soaring new heights. "},{"@id":"urn:doxa:passage:04eabc11382785e87d5cf2740abafd3a70d050fad63a19a35e458929f97b23f8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00001","start":135,"end":238,"exact":"He is a seasoned hypocrite, causing irreparable reputational damage to himself, and Turkey’s interests."},{"@id":"urn:doxa:passage:05569c30b76abd1f239787fe4325d3b5c6e286e1234a8a0417cbc3883e4657c6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00002","start":0,"end":87,"exact":"Erdoğan’s stance on the Gaza war is demonstrative of the pot calling the kettle black. "},{"@id":"urn:doxa:passage:b3e226f3a4f5ceb57d2d91a44bdb74bbf9894793de7ab92d3319b3041b10f6df","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00002","start":87,"end":167,"exact":"He wants the world to believe he is the champion and protector of Palestinians. "},{"@id":"urn:doxa:passage:df2b43809d6c755891e9b7ef8b3ddd115133478b4e3a01cb9ea8f647312117fa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00002","start":167,"end":332,"exact":"From his perspective, Gazans are being killed by a “spoiled” and “aggressive” Israeli war machine that is enabled by Western powers, particularly the United States. "},{"@id":"urn:doxa:passage:5cde74edf98f10952e29768a575ee25d8595243ada17024ca388aa87e9f92681","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00002","start":332,"end":575,"exact":"His supposed principled stance to stop Jerusalem from prosecuting its war against Hamas is based on three pillars: the refusal by Ankara to designate Hamas as a terrorist organization and to provide material support to it, and its leadership. "},{"@id":"urn:doxa:passage:d10e623bc538ff6f22472a3a705a2ffc76460e51ff1b0c82c00a0eba9506fea2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00002","start":575,"end":708,"exact":"As far as he’s concerned, Hamas is a resistance movement, struggling to liberate stolen lands from Palestinians by Jewish occupiers. "},{"@id":"urn:doxa:passage:94f6a22c043cde00a81684c0d3c79c3d5d9197744c83e8e40a0f1712bea17f2b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00002","start":708,"end":860,"exact":"Ankara also delivers the most aid to Gazans, coming in first among all nations shipping vital supplies to civilians caught up in the war against Hamas. "},{"@id":"urn:doxa:passage:faf1517072e2aac0cc98add1f3c699ae98123f76201c2d6327bdab87a81b5e5f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00002","start":860,"end":931,"exact":"Finally, Turkey inserted itself into legal proceedings against Israel. "},{"@id":"urn:doxa:passage:4af0589f2c99648714b076f14a08b3ee2c38e31ae559f1735dc0cfe9a1826aa4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00002","start":931,"end":1094,"exact":"Turkey declared its intention to join a lawsuit, filed by South Africa at the International Court of Justice (ICJ), accusing Israel of committing genocide in Gaza."},{"@id":"urn:doxa:passage:5d649523f80951b0eda4dfb77b3d8f2a6c95fe30974664b8735b3dd35979b4d1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00003","start":0,"end":234,"exact":"Given that Erdoğan is president of a Muslim-majority country, which is overwhelmingly critical of Israel’s actions against Hamas in Gaza, one could be forgiven for thinking that Erdoğan is simply echoing the sentiments of his people. "},{"@id":"urn:doxa:passage:b265e13e89309d2cfc01d4d1adfb88c4fc2aa3843827300e449ec34f20b9a38e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00003","start":234,"end":478,"exact":"Especially throughout the Muslim world, Erdoğan wants people to know that Turkey is the loudest condemner of Israel’s actions, while many Arab states — especially those which are signatories of the Abraham Accords, have chosen to remain quiet. "},{"@id":"urn:doxa:passage:b87cb213747065e46411bdc0fb474dd932426204b9a844defe5c9a612be47f94","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00003","start":478,"end":687,"exact":"He employed a similar tactic against the ousting of Egypt’s Mohammad Morsi in 2013 by Abdel Fattah el-Sisi, by calling upon world audiences to reject the forceful deposition of a democratically elected leader."},{"@id":"urn:doxa:passage:f693df53ad700445ad1e8671567c1b685e592d1c992def994c384b56fcfca58c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00004","start":0,"end":66,"exact":"Erdogan’s entire stance is a façade, built on lies and hypocrisy. "},{"@id":"urn:doxa:passage:6a3e20376e3bfd3c5c0de3de9a3236b496bfa30c5baba2b920c22aec65cbffbc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00004","start":66,"end":251,"exact":"If Erdoğan believed Israel to be the “terror” state he accuses it of being, committing genocide which even “Hitler would have been jealous of,” why would Ankara continue business ties? "},{"@id":"urn:doxa:passage:738af12bd6daa68e4e2cec7cfe8a38ea67ac89e92aa5a6dfbf7d2093b57bb6f7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00004","start":251,"end":361,"exact":"Since October 7, trade with Israel has been a top issue that has sharpened criticism against Erdogan at home. "},{"@id":"urn:doxa:passage:e4e62120ad6df33b56fc0e40d4516678b3e8afba760b0dc5681154843188346b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00004","start":361,"end":476,"exact":"With a total bilateral trade volume of USD 5.7 billion in 2023, Turkey has been a top exporter of goods to Israel. "},{"@id":"urn:doxa:passage:e30d5072ea529f09c61ed6cf44b807cf723ca576637ccbc0cc1fea64c451b6f8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00004","start":476,"end":622,"exact":"This figure is even more important when one considers Ankara to be among the top suppliers of strategic goods vital to Israel’s defense industry. "},{"@id":"urn:doxa:passage:d9defbb484b3f68c671642d8e4396c82f5570f3c5326e06fad6bab2942d89277","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00004","start":622,"end":702,"exact":"Exports include USD 1.2 billion in steel and USD 563 million worth of vehicles. "},{"@id":"urn:doxa:passage:3bc227a857608900bad6fc950d8cebd875af998db322d541db98fa9bc60a68c8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00004","start":702,"end":878,"exact":"Additionally, Turkey continued to sell other vital materials, including everything from explosives, and concrete to thermal underwear worn by the Israeli Defense Forces (IDF). "},{"@id":"urn:doxa:passage:846d3c3c3cd46813ff499ebe010eaec1e1944bd327683118d8f6b475a688beef","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00004","start":878,"end":1079,"exact":"Many political elites with business interests in Israel and close to Erdogan, including former Prime Minister Binali Yildirim, and Erdoğan’s own son, are profiteers from continued business with Israel."},{"@id":"urn:doxa:passage:6bf946d9c0b57302eb403d2230424d9194021d70ef01e6c795aad6b052dae5c4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00005","start":0,"end":93,"exact":"The escalation of the war against Hamas coincided with Turkey’s local elections on March 31. "},{"@id":"urn:doxa:passage:2bbe4daead4fdddb7d0770445821f8c436352ac08b56407a90fe78b151bdb0ff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00005","start":93,"end":202,"exact":"The country’s political opposition exposed Erdoğan’s weak underbelly and exploited it to devastating effect. "},{"@id":"urn:doxa:passage:4304b2470adb450bab54f3ce7ec4c2efc7311ff9f5f5467e51fe76fa8b054883","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00005","start":202,"end":385,"exact":"The Islamist New Welfare Party (Yeniden Refah-WP), led by Fatih Erbakan, appealed to conservative constituents who ordinarily voted for Erdoğan’s Justice and Development Party (AKP). "},{"@id":"urn:doxa:passage:3adb9be9fbf6f9ae217c0eac3738a65bd5a374959be6ae8d55cc281bfc1f7a4e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00005","start":385,"end":471,"exact":"Erbakan cornered Erdogan, by directly exposing his ongoing business ties with Israel. "},{"@id":"urn:doxa:passage:fb0857983679da88b3a54c42edf563444c60481a216dce10c3ad3cf447e14e98","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00005","start":471,"end":743,"exact":"Supported by fiery speeches and journalists’ disclosures of trade statistics, Erbakan did not land any big victories, but he may have helped divert 7 percent of the vote from the AKP, while the main opposition Republican People’s Party (CHP) clobbered the AKP nationwide. "},{"@id":"urn:doxa:passage:761e75afe70446070227e3bfa65dbb35552c27b9fc807a84a3868c4f0e8696e5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00005","start":743,"end":892,"exact":"A lot of the dissatisfied voters likely punished Erdoğan for his bad stewardship of the economy, plagued by high inflation and high consumer prices. "},{"@id":"urn:doxa:decision:5472ee1762a8247ab3c9d735f6af37c5","@type":["doxa:Decision","prov:Entity"],"recordId":"5472ee1762a8247ab3c9d735f6af37c5","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:058a98317bd0948c5009874d3bb78176:u_7323e83