d4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:a9cccfb5c0b0e1b59c04f201411c22c9:u_9aea9d8f43509ea538032855","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:c808e38e5daa78e2eff51f9ae8e018b74cb72bcc07a77073104ee5a3bb3b2acf","urn:doxa:passage:f7c564c31fd94744389891106e8ab563fa5d7b39c936d228562cefc7d459d35b","urn:doxa:passage:ed55f658077553c7e8eb14a6da28a4263c11c7b8e0d9fbf79808037fd10d71a1","urn:doxa:passage:c37aa7af56a4cb8229ba27cd4fd36a924fb38081496821f7d44f2adcb51b7bcc","urn:doxa:passage:ca5a889bded95b2ae8c1191956e057a9b866e233025f411ac6689501ea6f2710","urn:doxa:passage:216218b61a47cb96d052a72c31f44fcf879a2662c8f890f82f301beb76fbf3c4","urn:doxa:passage:708a939158ac3fcce60496a8e037d530dfba9cecf52d5bf124f570a0b69a0d6a","urn:doxa:passage:ec00a49cbb4d282e51ac433bcab9fffca149cf925cf45a82833bfc14ca66de8a","urn:doxa:passage:3faa0f5f59c3f1fd87b3c90fff2d93eb8d6e2f55c0ded598a3d7de4e775cea7d","urn:doxa:passage:5972bea5f4fa5b8d29afa23554f6f5b7f4033c713d9a23b0566f9c8e45378ae1","urn:doxa:passage:ee646345a40c4292f51b50c1eb9c7190f929809e84bce5a14799ae8d9ead1894","urn:doxa:passage:9b22624a1fa43139c60001bc7ee21e9645039b41496b59fd50d535403852467a"]},{"@id":"urn:doxa:decision:618b8f21f8477e836f1d455a9802820a","@type":["doxa:Decision","prov:Entity"],"recordId":"618b8f21f8477e836f1d455a9802820a","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:a9cccfb5c0b0e1b59c04f201411c22c9:u_9aea9d8f43509ea538032855","attribution":"reported_speaker","speaker":"right-wing media outlets in North Macedonia","speakerStance":"unclear","documentStance":"neutral","proposition":"Muslim-majority municipalities are to blame for the spread of the novel coronavirus","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports on disinformation alleging travel restrictions targeting citizens from municipalities with large Muslim populations, implying these groups are responsible for virus spread.","modelPassage":["urn:doxa:passage:c37aa7af56a4cb8229ba27cd4fd36a924fb38081496821f7d44f2adcb51b7bcc"]},{"@id":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-718474","title":"Brutal murders in Guyana seen as ‘continuation of earlier ethnic upheavals’","author":"Janine Mendes-Franco","translator":[],"publishedOn":"2020-09-17","sourceUrl":"https://globalvoices.org/2020/09/17/brutal-murders-in-guyana-seen-as-continuation-of-earlier-ethnic-upheavals/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"94c267ee6165c7a9a6e73a7301719399629f06d2d6df7b15de0393d9634d01d5","textSha256":"d05bc3978a8fe3c2f487218668f8a213134edc08a18dbd5db9617eb9b0f5c904","archivedRecordSha256":"6155cecdee84915872d8f7b36d3f1165c9660f943b3a99f85b4ec911491295f0","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:74407d2369921d5c49aba3a78ff3311e:u_27218a7ef59f91f02457488b","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_27218a7ef59f91f02457488b","status":"accepted","fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e"},{"@id":"urn:doxa:unit:74407d2369921d5c49aba3a78ff3311e:u_e881c4b45e7212a8a645c2ec","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_e881c4b45e7212a8a645c2ec","status":"accepted","fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e"},{"@id":"urn:doxa:passage:b27b4dd8072a7096cdee6da73e472ec938695db0192f4cb113f0dab07f0c058b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00001","start":0,"end":307,"exact":"Like many other regional territories, Guyana's politics have historically been race-based — a reality that was on display during the country's recent election impasse, in which the incumbent government, predominantly appealing to Afro-Guyanese voters, was accused of trying to rig the results in its favour."},{"@id":"urn:doxa:passage:0900fd5f4f9d7e151148ab94282cc42e8c6ed064a2d688036448c12a6abf2a38","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00002","start":0,"end":414,"exact":"Although the dust has settled and the opposition People's Progressive Party (PPP), which has a primarily Indo-Guyanese support base, has taken office, many pressing issues are still being painted with the broad brush of race — from the arrest of Clairmont Mingo, the election officer accused of fraud in the election process to the gruesome murder of two Black youth who were found chopped to death on September 6."},{"@id":"urn:doxa:passage:4b31d14e7ecf91ef43c0ab35ce2ea298fb2b092d93dadffd6bb18c935406992a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00003","start":0,"end":128,"exact":"Joel and Isaiah Henry, who were cousins, were allegedly killed by an Indo-Guyanese farm owner whose coconuts they were picking. "},{"@id":"urn:doxa:passage:87a51eb3e6f788de3abfdf14c7baf363dac0ee76de8d9e3e3e0bc11a51ebb608","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00003","start":128,"end":167,"exact":"Seven people have since been arrested. "},{"@id":"urn:doxa:passage:3df3b9abd3d07271e2e32e01a9f1a9429f8f5bbf9dbf94ed7b80921bcb7a30a2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00003","start":167,"end":362,"exact":"Ever since the details of the double murder have come to light, villagers from the boys’ community have been calling for justice and staging protests by blocking roads and setting debris on fire."},{"@id":"urn:doxa:passage:8b51ff1e43813dddd1dab04f9ce216eef39ebb69865748c89d333285d1d82281","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00004","start":0,"end":186,"exact":"Guyana's home affairs minister, Robeson Benn, criticised statements from “leading political persons” and “agitators” who were alluding that the attack on the boys was racially motivated."},{"@id":"urn:doxa:passage:898a7d5c0117e832e8acbc1ba42eb74cb43a5a372050065c8dad5233984b77b7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00005","start":0,"end":292,"exact":"By September 8, several civil society groups noted that the killings have exacerbated the country's already charged political race relations, and called on the Ethnic Relations Commission (ERC), which works in the interest of racial harmony and justice, to help ease mounting racial tensions."},{"@id":"urn:doxa:passage:bb5f41cea3c2df06417a394d0c4920afa7bf64f24439a10803b18554660f590b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00006","start":0,"end":443,"exact":"Pointing to “the mental racial violence that is being perpetrated on social media,” the International Decade for People of African Descent Assembly-Guyana (IDPADA-G), established under the previous administration under the auspices of the United Nations Decade for People of African Descent, called the murders “another manifestation of the festering division, ethnic strife and utter contempt for the lives of those from other ethnic groups.”"},{"@id":"urn:doxa:passage:81e7f5f7323f996cdacd17e6d0b5953720812a63b4e135217db2dbcf5a8b26f0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00007","start":0,"end":234,"exact":"The Society for African Guyanese Empowerment (SAGE) put a political and racial spin on the murders, saying the attack emphasised “the need to rally and defend African Guyanese against aggression by the newly installed PPP government.”"},{"@id":"urn:doxa:passage:d7a3967c4e81635cdbc0541a7efac9ec943a82d3af724a0d89fa37dc20d7aa75","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00008","start":0,"end":165,"exact":"The very next day, September 9, Haresh Singh, the 17-year-old grandson of one of the murder suspects, also died after being found with head injuries and chop wounds."},{"@id":"urn:doxa:passage:f6a1978dc92c76201a922266e6cd6e8590d937973df778afc2abc9c6419fcccc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00009","start":0,"end":138,"exact":"In a separate incident, Chatterpaul Harripaul, 34, fired his shotgun toward a crowd of protestors, who retaliated by beating him to death."},{"@id":"urn:doxa:passage:2624f4cb2d405787343bcd2ec93bd0ddb6050674f91ae313ba84adeac964427a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00010","start":0,"end":45,"exact":"The country's newly installed president, Dr. "},{"@id":"urn:doxa:passage:185490cc794d0003d90870fddb365bd0a0dbedb55f29e947ebc141412cd5acd3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00010","start":45,"end":174,"exact":"Irfaan Ali, has called all four deaths “barbaric” and said the violent protests had “nothing to do with standing up for justice.”"},{"@id":"urn:doxa:passage:8ad1ddb4c13a3416bdc0df75262f5bf28be9357d0b084223e8bf7b0113b2470f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00011","start":0,"end":284,"exact":"The president, as well as other political players, criticised the divisive statements of the country's opposition leader, Joseph Harmon, who framed the incident not as “a struggle between the races,” but as “a struggle against oppression […] a struggle against fraudulent government.”"},{"@id":"urn:doxa:passage:515d66ea42f53f1431930a8ff340d2b7a806abc4a17eb61050f50c29fd3dea4d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00012","start":0,"end":231,"exact":"The opposition's politicisation of the issue, according to Home Affairs Minister Benn, is exacerbating the situation with the protests and compromising security in the area of West Berbice, where most of the unrest is taking place."},{"@id":"urn:doxa:passage:e7837e27bf7ecc9e3a1496933c636625015f19ebe99ec8c3e17b8e22d4f7bb4c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00013","start":0,"end":304,"exact":"Meanwhile, organisations like the Muslim Youth Organisation of Guyana (MYO) have spoken out against the murders, and the Guyana Human Rights Association (GHRA) has approached the country's United Nations resident coordinator to ask that international forensic experts help with the murder investigations."},{"@id":"urn:doxa:passage:71a6bf5a9402020c9a869464f454a68429e0f1c884d582c5a4da566b54c06863","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00014","start":0,"end":178,"exact":"The acrimony that has come to the surface after the double murder and its resultant revenge killings is uncomfortably reminiscent of the country's history of race-based violence."},{"@id":"urn:doxa:passage:21467b8819908ca74de0695e9527d64746fb1e3e02eb1639313df6e624cc2b95","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:74407d2369921d5c49aba3a78ff3311e","blockId":"gv-718474-b00015","start":0,"end":233,"exact":"In a statement, the Guyana Human Rights Association (GHRA) noted that “the prevailing poisonous political atmosphere has penetrated the society to the point where public trust in an impartial investigation is virtually non-existent.”"},{"@id":"urn:doxa:decision:f9a48243511cc391a434a9e3379f55de","@type":["doxa:Decision","prov:Entity"],"recordId":"f9a48243511cc391a434a9e3379f55de","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:74407d2369921d5c49aba3a78ff3311e:u_27218a7ef59f91f02457488b","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:b27b4dd8072a7096cdee6da73e472ec938695db0192f4cb113f0dab07f0c058b","urn:doxa:passage:0900fd5f4f9d7e151148ab94282cc42e8c6ed064a2d688036448c12a6abf2a38","urn:doxa:passage:4b31d14e7ecf91ef43c0ab35ce2ea298fb2b092d93dadffd6bb18c935406992a","urn:doxa:passage:87a51eb3e6f788de3abfdf14c7baf363dac0ee76de8d9e3e3e0bc11a51ebb608","urn:doxa:passage:3df3b9abd3d07271e2e32e01a9f1a9429f8f5bbf9dbf94ed7b80921bcb7a30a2","urn:doxa:passage:8b51ff1e43813dddd1dab04f9ce216eef39ebb69865748c89d333285d1d82281","urn:doxa:passage:898a7d5c0117e832e8acbc1ba42eb74cb43a5a372050065c8dad5233984b77b7","urn:doxa:passage:bb5f41cea3c2df06417a394d0c4920afa7bf64f24439a10803b18554660f590b","urn:doxa:passage:81e7f5f7323f996cdacd17e6d0b5953720812a63b4e135217db2dbcf5a8b26f0","urn:doxa:passage:d7a3967c4e81635cdbc0541a7efac9ec943a82d3af724a0d89fa37dc20d7aa75","urn:doxa:passage:f6a1978dc92c76201a922266e6cd6e8590d937973df778afc2abc9c6419fcccc","urn:doxa:passage:2624f4cb2d405787343bcd