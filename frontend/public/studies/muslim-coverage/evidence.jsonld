e73886ae29","urn:doxa:passage:ce2bb3e5c8ecf643c3dce3c1ad224e378a5fac144b5a62be7cd70d3c1309cae2","urn:doxa:passage:50bea57806ab2e7f4902fd62fa3ee7deb75e1121155007fb07799de46e7f02f2","urn:doxa:passage:744f89cfbd086a12ef288740f19f0b357f114397d6ada378256dd709ed917649","urn:doxa:passage:7eeeaa98d9bcbe51f9437f5fff1b4932f549e84d689ea4389c1135d3431fc09f","urn:doxa:passage:5cf9b725aca804fccdbb47018d093345c84b774845a789e547748b9e4677cebb","urn:doxa:passage:f1422da952e9f8aea0d88358f96c38c320e232cd4b3c1ea48c01e3eaa3109f60"]},{"@id":"urn:doxa:passage:39ab689c8fa14ed6d3d8f953e3168ca93a625e3d87425ebaa09924feec0d6bef","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00023","start":0,"end":192,"exact":"Industry watchers, many of whom declined to be named in the Economist’s report, attribute these actions to the government’s Hindu-first ideology and its growing intolerance of opposing views. "},{"@id":"urn:doxa:passage:a15df8f3daa8e57610038fec04d6ac01a2a27bc4583b4f8ce8576595fdebe428","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00023","start":192,"end":309,"exact":"Non-Hindu faith-based NGOs, particularly those with Christian or Muslim affiliations, are among the primary targets. "},{"@id":"urn:doxa:passage:0dd6e82da34c0123b1f82589e0777396e24273647d4136aaaf5c089432457931","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00023","start":309,"end":416,"exact":"Additionally, groups perceived as ideological opponents, including political rivals, face similar scrutiny."},{"@id":"urn:doxa:passage:f8a8e06fe788b6b855e4a1a18a4ba0194c7cb784b39fc3e0e965069257111187","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00024","start":0,"end":211,"exact":"Yamini Aiyar, policy researcher and the president of the Think Tank Centre for Policy Research, penned a critical article on March 23, 2024, lamenting the damage to India's economy during Narendra Modi's reign. "},{"@id":"urn:doxa:passage:b2e0a6a0ce7159d1c55c26a20e9cd8ac2bf1a3538a8e473cb20ffe27f60a0626","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00024","start":211,"end":300,"exact":"Development economist Justin Sandefur posted on X about her resignation a few days after:"},{"@id":"urn:doxa:passage:1088cf50ef60bd7c3d1f6bb8f7a86de63719f36f4a7715db9631b3f0e1c98fcc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00025","start":0,"end":196,"exact":"India's poor ranking in the Electoral Democracy Index 2023, where it placed 108th below countries like Tanzania, Bolivia, Mexico, Singapore, and Nigeria, underscores the urgency of the situation. "},{"@id":"urn:doxa:passage:2d26fac3cb495bb44c5cd1a06676778a0fcd100832f49fd453a091918424d7ba","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00025","start":196,"end":404,"exact":"Now, more than ever, there is an urgent need for the courts to intervene and halt processes — like the arbitrary raids and arrests — that violate due process under the law and are blatantly unconstitutional. "},{"@id":"urn:doxa:passage:03ef245390de7fb8b2d43a154d2910b01dd059ece52ad73a9947fc10d033c6ef","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00025","start":404,"end":547,"exact":"These actions pose a serious threat to India's democratic principles and institutions, jeopardizing the country's standing on the global stage."},{"@id":"urn:doxa:passage:34e8a38a822673c7beac43d746a75ee181d946accd07e4727b2499257bbb9b85","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00026","start":0,"end":126,"exact":"Ironically, the same group that is under siege must coalesce together if it ever hopes to withstand the onslaught against it. "},{"@id":"urn:doxa:passage:5f35f0d233b50e62fa94725fd66e16ff94f1e238c5bc571bf353077dcf9820d2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00026","start":126,"end":206,"exact":"Civil society leaders must recognize that an attack on one is an attack on all. "},{"@id":"urn:doxa:passage:520e75f37985948e14b8283f779a8ff47c2e8e2b078116d1111409b9b163a8e1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00026","start":206,"end":331,"exact":"There is a pressing need for a united counter-mobilization movement against the BJP to prevent the erosion of civil society. "},{"@id":"urn:doxa:passage:0464851c8a62b514eed76dec338aaf7402b126074fa7e6c7d2251ed501b0adb0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00026","start":331,"end":470,"exact":"Otherwise, the sector may face further challenges if Modi retains power in 2024, a scenario that current polls suggest is extremely likely."},{"@id":"urn:doxa:decision:4db58e08a403561229d1b084e04afc2b","@type":["doxa:Decision","prov:Entity"],"recordId":"4db58e08a403561229d1b084e04afc2b","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:b06184e463b5fb9c641c1b5541dbca26:u_20aea7c69502580c08de8035","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitConte