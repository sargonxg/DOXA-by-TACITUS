51c8a62b514eed76dec338aaf7402b126074fa7e6c7d2251ed501b0adb0"]},{"@id":"urn:doxa:decision:e05af924031943081c0be82b9d81bbf0","@type":["doxa:Decision","prov:Entity"],"recordId":"e05af924031943081c0be82b9d81bbf0","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:b06184e463b5fb9c641c1b5541dbca26:u_20aea7c69502580c08de8035","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:39ab689c8fa14ed6d3d8f953e3168ca93a625e3d87425ebaa09924feec0d6bef","urn:doxa:passage:a15df8f3daa8e57610038fec04d6ac01a2a27bc4583b4f8ce8576595fdebe428","urn:doxa:passage:0dd6e82da34c0123b1f82589e0777396e24273647d4136aaaf5c089432457931","urn:doxa:passage:f8a8e06fe788b6b855e4a1a18a4ba0194c7cb784b39fc3e0e965069257111187","urn:doxa:passage:b2e0a6a0ce7159d1c55c26a20e9cd8ac2bf1a3538a8e473cb20ffe27f60a0626","urn:doxa:passage:1088cf50ef60bd7c3d1f6bb8f7a86de63719f36f4a7715db9631b3f0e1c98fcc","urn:doxa:passage:2d26fac3cb495bb44c5cd1a06676778a0fcd100832f49fd453a091918424d7ba","urn:doxa:passage:03ef245390de7fb8b2d43a154d2910b01dd059ece52ad73a9947fc10d033c6ef","urn:doxa:passage:34e8a38a822673c7beac43d746a75ee181d946accd07e4727b2499257bbb9b85","urn:doxa:passage:5f35f0d233b50e62fa94725fd66e16ff94f1e238c5bc571bf353077dcf9820d2","urn:doxa:passage:520e75f37985948e14b8283f779a8ff47c2e8e2b078116d1111409b9b163a8e1","urn:doxa:passage:0464851c8a62b514eed76dec338aaf7402b126074fa7e6c7d2251ed501b0adb0"]},{"@id":"urn:doxa:decision:c25ebf836688146da8ead69c63d961bb","@type":["doxa:Decision","prov:Entity"],"recordId":"c25ebf836688146da8ead69c63d961bb","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:b06184e463b5fb9c641c1b5541dbca26:u_20aea7c69502580c08de8035","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:39ab689c8fa14ed6d3d8f953e3168ca93a625e3d87425ebaa09924feec0d6bef","urn:doxa:passage:a15df8f3daa8e57610038fec04d6ac01a2a27bc4583b4f8ce8576595fdebe428","urn:doxa:passage:0dd6e82da34c0123b1f82589e0777396e24273647d4136aaaf5c089432457931","urn:doxa:passage:f8a8e06fe788b6b855e4a1a18a4ba0194c7cb784b39fc3e0e965069257111187","urn:doxa:passage:b2e0a6a0ce7159d1c55c26a20e9cd8ac2bf1a3538a8e473cb20ffe27f60a0626","urn:doxa:passage:1088cf50ef60bd7c3d1f6bb8f7a86de63719f36f4a7715db9631b3f0e1c98fcc","urn:doxa:passage:2d26fac3cb495bb44c5cd1a06676778a0fcd100832f49fd453a091918424d7ba","urn:doxa:passage:03ef245390de7fb8b2d43a154d2910b01dd059ece52ad73a9947fc10d033c6ef","urn:doxa:passage:34e8a38a822673c7beac43d746a75ee181d946accd07e4727b2499257bbb9b85","urn:doxa:passage:5f35f0d233b50e62fa94725fd66e16ff94f1e238c5bc571bf353077dcf9820d2","urn:doxa:passage:520e75f37985948e14b8283f779a8ff47c2e8e2b078116d1111409b9b163a8e1","urn:doxa:passage:0464851c8a62b514eed76dec338aaf7402b126074fa7e6c7d2251ed501b0adb0"]},{"@id":"urn:doxa:passage:57348adc5ab50776a2e94e8386fc590f2c1b7a264fcea0beeb892cc2eb82b923","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00001","start":0,"end":253,"exact":"Despite the rich, vibrant, and ideologically diverse strands of India's political landscape and civil society groups, there is a worrisome trend of the Indian state suppressing dissenting voices, especially civil society groups, with minimal resistance."},{"@id":"urn:doxa:passage:ff9cadf208af29f38c6a5b4264d750ecf1eb45d70197e2f639efe49dde52b43f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00002","start":0,"end":36,"exact":"Civil society in India: Then and now"},{"@id":"urn:doxa:passage:f3866d61bacff33e695b55e3f00be077f53e4e1d58c42d54b07d0ef671ac20f5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00003","start":0,"end":250,"exact":"Indian political theorist and former Professor of Political Science at the University of Delhi Neera Chandhoke offers a compelling historical analysis of Indian civil society, revealing a rich tapestry woven with threads of resistance and pluralism. "},{"@id":"urn:doxa:passage:fe38e64359dabbfdfbd0f5ab1786bd7dee13182bdf5ae2f339becf1cc4ac8779","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00003","start":250,"end":434,"exact":"Emerging in opposition to colonialism and the restrictive state ideologies of its time, civil society in India has always been a dynamic constellation of diverse groups and ideologies."},{"@id":"urn:doxa:passage:b87a4f94f31da951800ca23ce076813d1b92b9670e32ebe4c79f177723a3380a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00004","start":0,"end":155,"exact":"From the 19th century onwards, social and religious reform movements like the Brahmo Samaj and Arya Samaj played a crucial role in shaping societal norms. "},{"@id":"urn:doxa:passage:272ef115bda667d4739218b4088dc6c3ecf2d8ce18550ee91cc288d543a2689b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00004","start":155,"end":296,"exact":"The early 20th century saw the rise of Gandhian organizations like the Harijan Sevak Sangh in 1932, dedicated to eradicating untouchability. "},{"@id":"urn:doxa:passage:4819ed5b8f4b41e833c5bb57d66783dd5bbc1408685f02c5e8c69a73508e2291","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00004","start":296,"end":460,"exact":"This cause was central to Mahatma Gandhi's life's work, and it included desegregating public spaces like wells, schools, and temples, ensuring equal access for all."},{"@id":"urn:doxa:passage:423746048f5b94bd4e200957ef369e38204d7d27fd28816fe8eb99994f3714d1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00005","start":0,"end":295,"exact":"Industrialization fostered the growth of self-help organizations around trade unions in cities like Bombay (currently Mumbai) and Ahmedabad, while anti-caste movements like the Self-Respect Movement in Tamil Nadu challenged India's rigid social hierarchy and pushed for a more equitable society."},{"@id":"urn:doxa:passage:e005041fa609228fedb577935a292b1f211d2967a3f5ec15de58ca1f416b0fc3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00006","start":0,"end":490,"exact":"Other civil society groups included associations like the Bombay Presidency Association that petitioned the colonial government to increase access to education and employment opportunities for the middle class, affiliated groups for women and youth established by The Indian National Congress during the independence era, and social and cultural organizations like the Hindu Mahasabha and the Rashtriya Swayamsevak Sangh (RSS) that emerged with a distinct aim: establishing a Hindu nation. "},{"@id":"urn:doxa:passage:e4021f6065069ea6d32f527feca79e524267a4897f99e42f043bb0fa4a075867","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00006","start":490,"end":648,"exact":"The presence of the RSS and other Hindu nationalist groups, in particular, showcases the diverse ideological spectrum that exists within Indian civil society."},{"@id":"urn:doxa:passage:5ebc74d0626213b11bb8333984a2e93b065a51e7a00fe71675c65d33a58a134a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00007","start":0,"end":189,"exact":"Today, with the Bharatiya Janata Party (BJP) — a Hindu nationalist government — at the helm, the relationship between civil society and the state is undergoing a concerning transformation. "},{"@id":"urn:doxa:passage:cc329e6595ccaf515e6135c2cf0c3a14609d73a9be6c0b82f7d9ceac68feb885","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00007","start":189,"end":339,"exact":"While groups associated with the BJP, like the RSS, have become more prominent, space for those opposed to the BJP’s ideology appears to be shrinking."},{"@id":"urn:doxa:passage:cc95bbf383c821647395eb22ef69df2f71dafaf2aaee5573ad65b3174d59807a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00008","start":0,"end":101,"exact":"This raises critical questions about the future of pluralism and dissent within Indian civil society."},{"@id":"urn:doxa:passage:2e219be74b05851a2731e7d41b1b6db63397b40a080014824c3e71d36f10d46a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00009","start":0,"end":50,"exact":"The onslaught against the dissenting civil society"},{"@id":"urn:doxa:passage:843696138dc47021d8ac57de85b7c4d8e818dac48e5a478302dfa1619c9a117c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00010","start":0,"end":223,"exact":"Back in September 2022, India's Income Tax (IT) Department conducted “surveys” at multiple locations, including Oxfam India, the Independent and Public-Spirited Media Foundation (IPSMF), and the Centre for Policy Research. "},{"@id":"urn:doxa:passage:15561b3bee71f69b74527db5c2afc9337810a8075dac2f3ba3ca1b3472923f06","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00010","start":223,"end":603,"exact":"Amnesty International's South Asia Regional Director, Yamini Mishra, alleged that the government's financial and investigative agencies were being weaponized to harass, intimidate, silence, and criminalize independent critical voices in the country, aiming to instil fear among these organizations’ staff and funders to impose a chilling effect and silence civil society at large."},{"@id":"urn:doxa:passage:4bafa3aa29e2e3ca05bcd7db8181855c5a0d4ff857d0d247062f82521a73de1d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00011","start":0,"end":52,"exact":"Legal Rights Protection Forum posted on X (Twitter):"},{"@id":"urn:doxa:passage:be884cc8c6894c875781fb2b22576302a218a73b07862218a086d634f7da9c46","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00012","start":0,"end":264,"exact":"Two years later, on March 29, officials of the crime investigating agency Central Bureau of Investigation (CBI) raided the residence of former bureaucrat Harsh Mander and the office of a think tank, the Centre for Equity Studies (CES) in New Delhi, linked to him. "},{"@id":"urn:doxa:passage:9d0aa8e89bc10646587746b77343d788fbdf3583f5067ff7500b9ae4ec897c7a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00012","start":264,"end":407,"exact":"The raids alleged financial irregularities under the Foreign Contribution (Regulation) Act (FCRA) — allegations that the organization refuted. "},{"@id":"urn:doxa:passage:1dbc67c975cef81e29d4083d8baa39769ec224741376889a798e27ea9a23b1bc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00012","start":407,"end":548,"exact":"Notably, Mander has been a fierce critic of the Modi government's Hindu nationalist agenda since the BJP-ledgovernment came to power in 2014."},{"@id":"urn:doxa:decision:9318070b1798a45d5115e3f92b69f4cf","@type":["doxa:Decision","prov:Entity"],"recordId":"9318070b1798a45d5115e3f92b69f4cf","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:b06184e463b5fb9c641c1b5541dbca26:u_591882acbb4ee87f4300515b","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:57348adc5ab50776a2e94e8386fc590f2c1b7a264fcea0beeb892cc2eb82b923","urn:doxa:passage:ff9cadf208af29f38c6a5b4264d750ecf1eb45d70197e2f639efe49dde52b43f","urn:doxa:passage:f3866d61bacff33e695b55e3f00be077f53e4e1d58c42d54b07d0ef671ac20f5","urn:doxa:passage:fe38e64359dabbfdfbd0f5ab1786bd7dee13182bdf5ae2f339becf1cc4ac8779","urn:doxa:passage:b87a4f94f31da951800ca23ce076813d1b92b9670e32ebe4c79f177723a3380a","urn:doxa:passage:272ef115bda667d4739218b4088dc6c3ecf2d8ce18550ee91cc288d543a2689b","urn:doxa:passage:4819ed5b8f4b41e833c5bb57d66783dd5bbc1408685f02c5e8c69a73508e2291","urn:doxa:passage:423746048f5b94bd4e200957ef369e38204d7d27fd28816fe8eb99994f3714d1","urn:doxa:passage:e005041fa609228fedb577935a292b1f211d2967a3f5ec15de58ca1f416b0fc3","urn:doxa:passage:e4021f6065069ea6d32f527feca79e524267a4897f99e42f043bb0fa4a075867","urn:doxa:passage:5ebc74d0626213b11bb8333984a2e93b065a51e7a00fe71675c65d33a58a134a","urn:doxa:passage:cc329e6595ccaf515e6135c2cf