34eb33bf","urn:doxa:passage:94ec0d791a441a5ba0e306861eaf3ecc166238a1409823380d40f9eb09614cbd","urn:doxa:passage:5bd6ab8c61094ab757858e319a5cb5ce0a5614bf1b8757ddb1b984e3c5b47d69"]},{"@id":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-840669","title":"Withering roots: The waning health and resilience of the women left behind in Afghanistan","author":"Davi Jacobs","translator":[],"publishedOn":"2025-08-06","sourceUrl":"https://globalvoices.org/2025/08/06/withering-roots-the-waning-health-and-resilience-of-the-women-left-behind-in-afghanistan/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"ec99c37acfc5d091f109463531a3205074a893b9cded194b3d11190c67253ca4","textSha256":"695985a69798ead1201ffd950323a55c7d628a0be708481568e686464a69407b","archivedRecordSha256":"a5c1369768a2e9d85b44ba9fcb36203ec27a896f73b163962b278b50dcba8a06","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:0eb1d18162d1295309be1eafa9829b32:u_596acedc807886b6e3a620fe","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_596acedc807886b6e3a620fe","status":"accepted","fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32"},{"@id":"urn:doxa:unit:0eb1d18162d1295309be1eafa9829b32:u_bf11677b3212fefefd4cc989","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_bf11677b3212fefefd4cc989","status":"accepted","fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32"},{"@id":"urn:doxa:unit:0eb1d18162d1295309be1eafa9829b32:u_ebdb6a46d7a7647a2bfe5990","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_ebdb6a46d7a7647a2bfe5990","status":"accepted","fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32"},{"@id":"urn:doxa:passage:fbbb405cd36d8f097f5eb432dbe3bfd3071f51db2de271ded7a669d43e2a9a47","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00034","start":0,"end":39,"exact":"Learn more about our donation campaign."},{"@id":"urn:doxa:decision:9541ae0cddd3d12073f785c9a9e9d431","@type":["doxa:Decision","prov:Entity"],"recordId":"9541ae0cddd3d12073f785c9a9e9d431","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:0eb1d18162d1295309be1eafa9829b32:u_596acedc807886b6e3a620fe","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:fbbb405cd36d8f097f5eb432dbe3bfd3071f51db2de271ded7a669d43e2a9a47"]},{"@id":"urn:doxa:decision:9e1100747e48e69a3f5478cb9f0441db","@type":["doxa:Decision","prov:Entity"],"recordId":"9e1100747e48e69a3f5478cb9f0441db","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:0eb1d18162d1295309be1eafa9829b32:u_596acedc807886b6e3a620fe","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:fbbb405cd36d8f097f5eb432dbe3bfd3071f51db2de271ded7a669d43e2a9a47"]},{"@id":"urn:doxa:decision:eb12260ebed37b9d9ef86839477d0d5d","@type":["doxa:Decision","prov:Entity"],"recordId":"eb12260ebed37b9d9ef86839477d0d5d","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:0eb1d18162d1295309be1eafa9829b32:u_596acedc807886b6e3a620fe","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:fbbb405cd36d8f097f5eb432dbe3bfd3071f51db2de271ded7a669d43e2a9a47"]},{"@id":"urn:doxa:decision:b2d6abfd0a49dcf7e9c1cfc9cd9959f7","@type":["doxa:Decision","prov:Entity"],"recordId":"b2d6abfd0a49dcf7e9c1cfc9cd9959f7","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:0eb1d18162d1295309be1eafa9829b32:u_596acedc807886b6e3a620fe","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:fbbb405cd36d8f097f5eb432dbe3bfd3071f51db2de271ded7a669d43e2a9a47"]},{"@id":"urn:doxa:decision:68095be65d0c5bcd6bf5b3b8c9ca1d41","@type":["doxa:Decision","prov:Entity"],"recordId":"68095be65d0c5bcd6bf5b3b8c9ca1d41","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:0eb1d18162d1295309be1eafa9829b32:u_596acedc807886b6e3a620fe","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:fbbb405cd36d8f097f5eb432dbe3bfd3071f51db2de271ded7a669d43e2a9a47"]},{"@id":"urn:doxa:decision:bae35a0fd9a8bb41fc31429b5788937f","@type":["doxa:Decision","prov:Entity"],"recordId":"bae35a0fd9a8bb41fc31429b5788937f","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:0eb1d18162d1295309be1eafa9829b32:u_596acedc807886b6e3a620fe","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:fbbb405cd36d8f097f5eb432dbe3bfd3071f51db2de271ded7a669d43e2a9a47"]},{"@id":"urn:doxa:passage:dde7448d27a3a629d8304d7fd26e87fec311838e6ed941ebe6b2316ee3a8909d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00014","start":0,"end":320,"exact":"Fatima had hoped that her family would be evacuated through the P2 process — a special visa pathway where Afghans who helped U.S. forces during war times could emigrate to the U.S. — but the suspension of the P2 process by the Trump administration affected her the same way the government's collapse in Afghanistan did. "},{"@id":"urn:doxa:passage:2790a91410bfc66d7369c129d1de9f6cc1cf7e1b415c38e7b452ef3c5533c39f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00014","start":320,"end":383,"exact":"Women had no hope then, and now they are in the same situation."},{"@id":"urn:doxa:passage:64ef5cde01423e62a8735c6a3cb3ce6a975a0845c7a2f958f986920a90031560","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00015","start":0,"end":67,"exact":"Her past work once gave her purpose — now it chains her to danger. "},{"@id":"urn:doxa:passage:fb1fa31f6abd86b3ae888a692ebc1f4fe1f74bd4f8afb5477e3132101ef9415a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00015","start":67,"end":124,"exact":"“I feel like I’m falling apart,” she wrote via WhatsApp. "},{"@id":"urn:doxa:passage:dac392e6ec8f7a5afc8b8736bc9fb691efc717b64088ce96446f880beaa3b19a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00015","start":124,"end":159,"exact":"“How can I care for my sick child? "},{"@id":"urn:doxa:passage:b574e583fb759827655e420b04214f067786780690af6a9d23f62651b054f9ff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00015","start":159,"end":217,"exact":"How can I give a good life to the one growing in my womb?”"},{"@id":"urn:doxa:passage:67e3a991269fa06d924a18784c086c10260cf74a43b8cb65448e144fb5bde8b2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00016","start":0,"end":108,"exact":"In the past, Fatima was the one advocating for others, but now she is in a situation where she is helpless. "},{"@id":"urn:doxa:passage:0c33e764f633ce50f15179ed29db5fc8e65956e2ee6daba81b00d8cc69e234fa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00016","start":108,"end":193,"exact":"Like the majority of women left behind in Afghanistan, she is a prisoner in her home."},{"@id":"urn:doxa:passage:0cc0f8f10264e6e88852b09020ba182697d733204f99ee4a91796d47bacef7a6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00017","start":0,"end":169,"exact":"In such difficult circumstances, she still went out of her way to connect me with a female healthcare worker, a testament to the strength and resilience that define her."},{"@id":"urn:doxa:passage:7f8f4ad893a5a51cb36ed76e1826b7503edb880f0060e7101f09ce1b98952114","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00018","start":0,"end":50,"exact":"Her skills were a lifeline — now, they're a threat"},{"@id":"urn:doxa:passage:986ad4c6594699598b47035be6d5062ecb8eaec2a2d6c0c7ca01804db1ef4975","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00019","start":0,"end":8,"exact":"For Dr. "},{"@id":"urn:doxa:passage:3d2ebc5f3e04610a902d24866062ce5e00a4057221fecd13e4fa587d23d54f5a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00019","start":8,"end":72,"exact":"Zahra, midwifery was more than a profession — it was a promise. "},{"@id":"urn:doxa:passage:159cd1f5e44dbcc58b0b45a33efaa1694cd4a8a809217dd04ec8c57435125642","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00019","start":72,"end":148,"exact":"She had seen women die silently in childbirth, denied medicine and dignity. "},{"@id":"urn:doxa:passage:ac11224a1c444670edb8104ce2d5178c97e83e7d1038b58b6f7621462413c1f3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00019","start":148,"end":193,"exact":"Tradition reigned, often at the cost of life."},{"@id":"urn:doxa:passage:a490a3f41ec8225ed445d0de49b9a8fa3c463a343716bc2a27f726301169ddad","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00020","start":0,"end":17,"exact":"For decades, Dr. "},{"@id":"urn:doxa:passage:cca0d781cb015059739b1441bbee9bbe19cedb32d1019950f0a4de9a09616a76","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00020","start":17,"end":55,"exact":"Zahra dedicated herself to the field. "},{"@id":"urn:doxa:passage:4adf83c2e2416ffed94fa2ce2a836cd7114d3d89663832de55c6fa76dce5c8c1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00020","start":55,"end":223,"exact":"As a young midwife, she was able to expand her capabilities while spending days, sometimes completely alone, on the road and nights in the darkness of remote hospitals."},{"@id":"urn:doxa:passage:048b2d74af24aab518ef8d5223a5819d7e1ece08552c7c1297935df243e2b363","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00021","start":0,"end":131,"exact":"Entering the medical field in Afghanistan under the Islamic Republic began with passing the national Kankor exam after 12th grade. "},{"@id":"urn:doxa:passage:c1bf3e1a795ddad582ada1db65f9c1824f82c4387faa8d0bc3d714a3ef2117c7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00021","start":131,"end":180,"exact":"High scores allowed admission to study medicine. "},{"@id":"urn:doxa:passage:7e2cb85cb56c4c3a870ce09b1e5bfe5408813127f90e0f6d85689c8f15c135c3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00021","start":180,"end":387,"exact":"Midwives, however, did not attend medical school and were often trained through two-year programs like the Community Midwifery Education (CME), backed by the Ministry of Public Health and international NGOs."},{"@id":"urn:doxa:passage:efd00102f68c0193dba7494265896f5b8ccf5b5597a2f7872440e0ea8266e514","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00022","start":0,"end":92,"exact":"Afghanistan’s women’s health system has long reflected the country’s political instability. "},{"@id":"urn:doxa:passage:61df9c18fe16c0cdba5ef9a1bf7801ba52be53d8a2053b7a8caa98e842d671e8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00022","start":92,"end":171,"exact":"Under the first Taliban regime, women were barred from accessing medical care. "},{"@id":"urn:doxa:passage:2c953429d00f52528abc4ace23ee316104288b4201b31a3ee7f4a2257dc9cbd3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00022","start":171,"end":262,"exact":"The U.S.-backed era brought clinics and training — but only as long as foreign aid lasted. "},{"@id":"urn:doxa:passage:8138825f60017b6ef22caa7a78c12fec63aa04a1149e4992a157f7dea28d899c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00022","start":262,"end":297,"exact":"Many professionals have since fled."},{"@id":"urn:doxa:passage:c23ada33d2c18a304c9156d57f04f4160ff5dbc001e395bfa7d1c36a5bf8fbb8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00023","start":0,"end":84,"exact":"Now, the Taliban allows women to work in hospitals — under suffocating constraints. "},{"@id":"urn:doxa:passage:c42a4486c64e36c23f3ca6ba69f5b42d17f79c19b3dbedadfa706b37bf0ead13","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00023","start":84,"end":114,"exact":"Strict uniforms are required. "},{"@id":"urn:doxa:passage:8d33b1aa3339b0aad6c0713f7ab5cab1ff457693524337b17227e9de812e0501","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00023","start":114,"end":229,"exact":"If the “Promotion of Virtue” team finds a woman speaking to a male colleague, both risk interrogation or detention."},{"@id":"urn:doxa:passage:a4445913034245adf2e111f445552400c57efccdd6892d562109e78bee19ec27","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00024","start":0,"end":66,"exact":"With hands trained to save lives and a heart scarred by loss, Dr. "},{"@id":"urn:doxa:passage:e7f6bd432f4647222eacb3e613a659e582d5c622d30811c3073bf6e96a82ec37","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00024","start":66,"end":106,"exact":"Zahra has been pushed into the shadows. "},{"@id":"urn:doxa:passage:01a1090ddcd939323c1ebaf8aa83919f1c602225f389867ea13d189e1c475c6e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00024","start":106,"end":194,"exact":"One of thousands of midwives now sidelined by a regime that treats healing as rebellion."},{"@id":"urn:doxa:passage:1b5ff70fb2e5dc78f964872ff0455f7e365ade55dfeda267f0a1b128ffa10592","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00025","start":0,"end":50,"exact":"From the frontlines of polio to tending new ground"},{"@id":"urn:doxa:passage:93b7bc3178508fadb52031099ca4afe174a63162a927fec5c09cf6fa2733db9b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00026","start":0,"end":4,"exact":"Dr. "},{"@id":"urn:doxa:passage:ae5af21f8438ba1d2e31f7985455865c25c98a4dd44dc77a98371827db1609cc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00026","start":4,"end":69,"exact":"Maryam found her calling in door-to-door immunization campaigns. "},{"@id":"urn:doxa:passage:9e0a4c443efaf2e8712cea5e1cc231dcdb0495d69bf2e5499c5904160ef2365e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00026","start":69,"end":127,"exact":"For two decades, she worked as a provincial polio officer."},{"@id":"urn:doxa:passage:abf4f64a7de67b43109c5b23b2cbd97cf768099bacb00d3f506f8c7e4ab18071","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00027","start":0,"end":25,"exact":"Her work was never easy. "},{"@id":"urn:doxa:passage:1d0ea5dcaf3b03066b26ed3afbe8249226e483812df9209c4c8c226885619906","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00027","start":25,"end":146,"exact":"Many believed vaccines were a Western plot to cause infertility, and others asked why she brought medicine but not food. "},{"@id":"urn:doxa:passage:8868f06b0aed9f98a7c0902bec4ab3a0b40f233f14c0e7957a51c76f9e2ce5d3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00027","start":146,"end":192,"exact":"She repeatedly returned until trust took root."},{"@id":"urn:doxa:passage:1c784d4d803c326fa3c10edd4a6accc0a5ea4be6b32358f14f56c99f60fb4cdd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00028","start":0,"end":71,"exact":"Polio remains endemic in only two countries: Afghanistan and Pakistan. "},{"@id":"urn:doxa:passage:5b5591b6933ef5c7f21c659ce63b15f4f817efecb21b6fe725ac2d7a5d6ade99","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00028","start":71,"end":151,"exact":"Under the Taliban, many vaccination campaigns have been suspended or restricted."},{"@id":"urn:doxa:passage:3bb6b787d1a6a97d3fac6632710264960256d501efd28979323cc9c631b8e2f3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00029","start":0,"end":4,"exact":"Dr. "},{"@id":"urn:doxa:passage:5f7bfff1ae8a498df9584e8d28afd5c687944724bcb94ab45f66ed66ac707c94","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00029","start":4,"end":31,"exact":"Maryam escaped to the U.S. "},{"@id":"urn:doxa:passage:a1d04b1271a929a7c75403904c440ff5cb26a2b872869681a4ad6c13b3a7f0b7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00029","start":31,"end":75,"exact":"13 months ago under her husband’s SIV case. "},{"@id":"urn:doxa:passage:f0fcb4600f011b5f49793742ec08e44b829633d95eeeb76fe6e672990021d6e7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00029","start":75,"end":158,"exact":"She works as a substitute teacher and is studying for a public health certificate. "},{"@id":"urn:doxa:passage:27f8227cfbf2d07fc7825342bb12fced6b035e2df24cafc2c410b3f2e4686c4e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00029","start":158,"end":250,"exact":"She hopes to serve again — this time among immigrant and underserved populations in the U.S."},{"@id":"urn:doxa:passage:71e17453f6571f0eda2b60c04f8539395ad10e1fef667a5e83c75da9f2650faf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00030","start":0,"end":154,"exact":"But her heart remains with those left behind: colleagues in despair, friends barred from working, and children at risk of diseases once nearly eradicated."},{"@id":"urn:doxa:passage:ce3b70f9c36cbaa8579abec669233d510fe314fe8ed647904c5f7f2481335293","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00031","start":0,"end":83,"exact":"Once pillars of the community, these women are now deprived of the tools to serve. "},{"@id":"urn:doxa:passage:3d41a032ce2816c7df2162bed8bc3adabdd1d987b5c00eb5646a1714cdca8d69","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00031","start":83,"end":173,"exact":"The U.S. invoked them when their skills were needed and abandoned them in a time of need. "},{"@id":"urn:doxa:passage:db698cc2bd98125dd83d449275636cb8aafd341943e09eafdaf1517cd28a916e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00031","start":173,"end":232,"exact":"The futures they were working to build have been forfeited."},{"@id":"urn:doxa:passage:073648f491d58338d68cefe2fc27a159d9f7fa6ee3a87379065b2a2be33166ba","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00032","start":0,"end":70,"exact":"Their stories demand that we reckon with the cost of broken promises. "},{"@id":"urn:doxa:passage:197bcf8330ff0309978a38cacfa8a5e0b98a7353b7233182dfcc59523055c282","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00032","start":70,"end":209,"exact":"We must act now to restore their rights, reopen pathways to safety, and uphold the promises made to those who risked everything for change."},{"@id":"urn:doxa:passage:f7ce988699f0ca93f9a31985d2687d6cec72b1797d48f37c94d45e0685c33318","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00033","start":0,"end":63,"exact":"Support Global Voices as we publish more articles like this one"},{"@id":"urn:doxa:decision:4c50e55bfd5907924318487f3c757b28","@type":["doxa:Decision","prov:Entity"],"recordId":"4c50e55bfd5907924318487f3c757b28","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:0eb1d18162d1295309be1