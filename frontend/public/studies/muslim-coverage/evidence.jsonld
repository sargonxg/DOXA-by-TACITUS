8fd04c3c99cd6498dc6c71960601928bb27c0730c81b2","urn:doxa:passage:41928f4555c5360bec7d35d97d12bcfc0087db316ff2d6ea5f225b45dd11ee50","urn:doxa:passage:709edfcab96c97e30218ba37d64599c81775a56df1183107fd2a1d3b2f4ded81","urn:doxa:passage:12e5a9f28da865af47de36633f0aa32055afd4870c73b2e679405c2a944f54a3","urn:doxa:passage:8f1999c56afe46b0a7ff9fb22c79b8e9cb0396459d49275c13190cd6acef2114","urn:doxa:passage:e6b38be86459122c672ca3c4e915016dada9508d0f63fb43c5d1c9b483839724","urn:doxa:passage:9c2efc7dfaa29e6e29cb23fad0deb7c959e1bb56e1a7f9cb6b009d4bd5c3ed69","urn:doxa:passage:d08dd66109cb5126844adcf6ea9b9c71c0854d61e9c035c4aac41e0b0a03d5cf","urn:doxa:passage:c8abfa90256134a817ca3b1c6dc7c2059349d142a5407c2b436cb321240b62f3","urn:doxa:passage:2c07d14e4ef10a04003b6b4d33bc88778cab8d08f5aad3c8ca4b511846b1c039","urn:doxa:passage:d19f877e71389f55cef49dc5d90396f0c7596a7860d68846e2fa1d027ac64e7d","urn:doxa:passage:a23fb905ddc3d25619c7472489f1ab152a423a568f585ae4dbedc9d0b6e67612","urn:doxa:passage:b6010f0473927d23f916459ee9b61253ca29aaa69932c6cd8109a57a491414db","urn:doxa:passage:f27a539160f8e419fd28793602eed0e4642acd59341e3a10d39f2fb6c4d2ed7b","urn:doxa:passage:a2c71897d02aa8b1c2f28f01acd2f769504b55d1df142a0d3990ab05934c730d","urn:doxa:passage:167d979b99ec4ca8fbc55ce196207860e1139db17e21dcbcfceb8477f68d6d53","urn:doxa:passage:6189ff35c418f1bb92799a9377f986cc2329eb92c66144adb443dff9316b011c","urn:doxa:passage:0c57b39f3772eb7321729c130af001ba471194e91fed9f4c85c56703bd82fd87","urn:doxa:passage:9d14bb3a34145dc8c80004473c4cecf147bdc712b3fb3ba7ae3c8198832e75ba","urn:doxa:passage:d4d73e687b84ff6f0049b3dd0e4e942814b4c6559ace0bca697a4a96b178164b"]},{"@id":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-804266","title":"A horse for a car — a tale of modern diplomacy between Turkey and Hungary","author":"Arzu Geybullayeva","translator":[],"publishedOn":"2024-01-03","sourceUrl":"https://globalvoices.org/2024/01/03/a-horse-for-a-car-a-tale-of-modern-diplomacy-between-turkey-and-hungary/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"64a49f616d36ff7d1f66698cb4976d27ae79f69bd68e5eb408da1a2c56b90079","textSha256":"8bdf0574e52fd5e26765d5a4e4bcecebd3307aaedb522da38a4cd6f1ac565c77","archivedRecordSha256":"16fa7cf9c4ed769b60f46b001d5278fc4fb3a016f901626c5773a232a2748fab","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:bf3b5ce259ec2962041514122207db13:u_3128b2e06d4ef8fee36db8c6","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_3128b2e06d4ef8fee36db8c6","status":"accepted","fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13"},{"@id":"urn:doxa:unit:bf3b5ce259ec2962041514122207db13:u_c9cd53da2ff6e72138fffeef","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_c9cd53da2ff6e72138fffeef","status":"accepted","fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13"},{"@id":"urn:doxa:passage:70bf86e93f4acfcce59ccb498608c0761e8b6bd35b2a8fa0992d24b5bbfddec6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00001","start":0,"end":126,"exact":"In December 2023, Turkey's President Recep Tayyip Erdoğan traveled to Hungary, where he met with Prime Minister Viktor Orban. "},{"@id":"urn:doxa:passage:272903e585efca63ad4f6de0292993051c7b9272cd3ec8b9464f281be759bb53","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00001","start":126,"end":204,"exact":"With December being the holiday season, the two leaders also exchanged gifts. "},{"@id":"urn:doxa:passage:5206ec57e759e38b9d4bfca0597dbec046b04b909a5e0ad95e9eb91953376aff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00001","start":204,"end":364,"exact":"Orban gifted Erdoğan a horse, while Erdoğan presented a Turkish-made car — the best deal Orban ever made, according to the Prime Minister of Hungary in a tweet:"},{"@id":"urn:doxa:passage:eec0210c8deba3f0dfc18929f8f02359d3032b42deea01b99d72aca1fb62c014","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00002","start":0,"end":161,"exact":"The gift exchange reminded some of last year's blockbuster Barbie, where horses “symbolize the epitome of masculinity,” wrote journalist Ali Walker for Politico."},{"@id":"urn:doxa:passage:95dedf20515cc1283b82edbfac66034cb9d76c4033546a72abbc71876b3f91b0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00003","start":0,"end":66,"exact":"Both leaders share something more than their love for horsepower. "},{"@id":"urn:doxa:passage:a28d242b7fce62bad1a936b295f44eb0d44acb366af73c6b62881ac1501afbf7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00003","start":66,"end":246,"exact":"Erdoğan and Orban have been fierce opponents to Sweden's NATO bid, and the meeting, which took place on December 19, may have finally resolved the issue, according to Turkey Recap."},{"@id":"urn:doxa:passage:36c717b9378225759f0fc51d0400d53440a9a8a782d1860b066b680698988d0c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00004","start":0,"end":98,"exact":"Following Russia's invasion of Ukraine, Sweden and Finland announced their decision to join NATO. "},{"@id":"urn:doxa:passage:d106418f5b7c81f5034bbeead5ef29d39d3860780ee566979c1562841bc23442","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00004","start":98,"end":224,"exact":"However, the decision, which must be approved unilaterally by all 30 member states, was vetoed by Turkey, also a NATO member. "},{"@id":"urn:doxa:passage:213d07d0d74a15d9926266b1f89ee8b564e392c3b40166888d99c579108476c8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00004","start":224,"end":516,"exact":"Ankara said last year that unless both countries met its demands, it wouldn't approve the bid, “citing their history of hosting members of Kurdish militant groups and Sweden’s suspension of arms sales to Turkey since 2019 over Ankara’s military operation in Syria” according to the Guardian. "},{"@id":"urn:doxa:passage:7e233233d71d47574988a7c05727a81776680cf558927dc971ad64673dea86c8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00004","start":516,"end":616,"exact":"In addition to Turkey, Hungary also vetoed the decision for the two countries to join the alliance. "},{"@id":"urn:doxa:passage:00b9eeafdfb911d604882b1f5aa049c1548ae4b309a6fc047635bb2e2349c631","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00004","start":616,"end":819,"exact":"In February 2023, Turkey withdrew from attending a meeting in Brussels between Sweden, Finland, and Turkey, which was meant to hash out the diplomatic standoff over Finland and Sweden's bid to join NATO."},{"@id":"urn:doxa:passage:9ffe8c6e780738750d79f6de4798280a2b8bff066c5b7028c5fcc9b6d4a780b9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00005","start":0,"end":66,"exact":"Despite the opposition, Finland joined the alliance in April 2023."},{"@id":"urn:doxa:passage:09419eecee48fe8412ea20c52394e579e5d6381f180181115019db31b1ff3a70","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00006","start":0,"end":90,"exact":"Turkey was at odds with Sweden joining NATO following a Quran-burning incident last year. "},{"@id":"urn:doxa:passage:21a67f06299a2c3eaf6a339da4ee64a5e218de12d6c0050edb909df971e57281","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00006","start":90,"end":407,"exact":"But Erdoğan's gripe with Sweden goes beyond what the leader described as an “insult to the sacred values of Muslims.” Official Ankara has other asks from Sweden too, including banning pro-Kurdish demonstrations in Sweden and extraditing various individuals Turkey labels as terrorists, wrote journalist Amberin Zaman."},{"@id":"urn:doxa:passage:435d71bb8e4fec9aa6eb52cc3b74cf0802a103d4afad6bebe9e75a04e9903f7b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00007","start":0,"end":117,"exact":"The meeting between Prime Minister Orban and President Erdoğan on December 18, 2023, took place behind closed doors. "},{"@id":"urn:doxa:passage:cfc83e35ec347816a619c7262f353e3731e29640169208aba1369a0b012db422","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00007","start":117,"end":412,"exact":"“The pair didn’t mention NATO expansion in a joint presser that day, but their governments have held back the last two votes required to approve Swedish accession, and observers believe the visit likely involved coordination on whether to advance Stockholm’s bid,” wrote journalist Diego Cupolo."},{"@id":"urn:doxa:passage:8354292efc5703159a4de6c3c4526c5c4943380a3aa796acf1980a55802aca77","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00008","start":0,"end":124,"exact":"But days after the meeting, it looked like the two did not make much progress on reaching an agreement on Sweden's NATO bid:"},{"@id":"urn:doxa:passage:3249e93ed7009290e1f57444e5bd7808d33b41b1fe03c85f3e349e76f12c7bf0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00009","start":0,"end":174,"exact":"In addition to a horse, Orban also pledged support for granting Turkish citizens visa-free travel in Hungary, according to reporting by an online news platform Gercek Gundem."},{"@id":"urn:doxa:passage:540b9ca0ab0c423955160033ac5cb05be17e227315ee9b3b46a49b648b349633","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00010","start":0,"end":54,"exact":"The two leaders also share a few other commonalities. "},{"@id":"urn:doxa:passage:03e540d198720f79447ecdc2202a9cd5d2424ea56331ac86b7640c795aacd220","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00010","start":54,"end":366,"exact":"Both Orban and Erdoğan rule their countries with an authoritarian populist playbook and both excel in manipulating public opinion, silencing independent voices and intimidating opponents, building beneficial ties with business elites, and portraying their respective governments as true patriots, to name a few. "},{"@id":"urn:doxa:passage:2b067193c4b681790b14d2ec7768080eab0181c83c2fba1f99680215c9f50078","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00010","start":366,"end":501,"exact":"According to Stephen Pogany, an emeritus professor at the University of Warwick these nationalistic claims are “absurd and disturbing:”"},{"@id":"urn:doxa:passage:57ec028a8941199a4205c0c9bfe129ad3b707c12dde838674077ac5e34a7f4a9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00011","start":0,"end":135,"exact":"> No single political party can plausibly claim to represent the supposed values of an entire people or have a monopoly on patriotism. "},{"@id":"urn:doxa:passage:cf3abfac38f43bdd725e953485a4bf06152367f70b8fc35073ce06459583ad0f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00011","start":135,"end":332,"exact":"In seeking to entrench their political ascendancy, however, the authoritarian-populist regimes in Ankara and Budapest have instituted broad-ranging policies to remake the nation in their own image."},{"@id":"urn:doxa:passage:eacf208f77591c1783f39428d9d3b4b76857944b2e77af8defbde51fee7c0c97","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00012","start":0,"end":190,"exact":"As Oliver Hartwich noted in this column, although the two countries are 1,400 kilometers apart, “as far as populism and anti-liberalism are concerned, Erdoğan and Orbán are close neighbors.”"},{"@id":"urn:doxa:passage:83d18e2a76a6755e1cc2d5625dc5edb6b5b6970f165872e920109412bba5d40c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:bf3b5ce259ec2962041514122207db13","blockId":"gv-804266-b00013","start":0,"end":160,"exact":"Following the first round of general elections in May 2023, Orban was among the first leaders to prematurely congratulate President Erdoğan on securing victory:"},{"@id":"urn:doxa:decision:cfe0e559c3bd8fc170c6cb4574ef9212","@type":["doxa:Decision","prov:Entity"],"recordId":"cfe0e559c3bd8fc170c6cb4574ef9212","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:bf3b5ce259ec2962041514122207db13:u_3128b2e06d4ef8fee36db8c6","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:70bf86e93f4acfcce59ccb498608c0761e8b6bd35b2a8fa0992d