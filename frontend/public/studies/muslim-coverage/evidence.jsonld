:passage:cbb9cb5640531fad0f8c0642534be1b14a802e1cf8f260544dbb576a5752eb97","urn:doxa:passage:1d9f034b243f368e6d36517485abf995c1b40bb9307a3272bb6c2fab48614b79","urn:doxa:passage:13c363562ebe734d0d2c847b27bc094627b8c86a094c4ea8f112dc31c9fb1c4d","urn:doxa:passage:f302c599cbfe27dfdb689af37647ac5115a51b50f0a78402b4a3e6d22d189a44","urn:doxa:passage:fbeaf474bdc17af3111c9c7438c54308d00e68cb8ca6d49a00c82e9721851621","urn:doxa:passage:32978657ed36e020f33b17c7d185ecb1f7e2a89c2c95205e2b0c988f4ab658d2","urn:doxa:passage:abfeb7697902258a98c07d9bf36bcd842368d2b6b8f8a337384f02d84146651f","urn:doxa:passage:edeec98b43ba07b4bd103617d7fb94a167ef94fe3f5f3b8976f32ae448d5fa96","urn:doxa:passage:bd9b63eb172161530f811e128f5e5f3fafc32db2d38309429665fa4aaee323d1","urn:doxa:passage:581c5463d35026ca55bcfe565f346ea09e9806c6375cdb2dd0136ad1749185e9","urn:doxa:passage:237ed0394eddfb48dccf957f9200e0a3b3b05acb1335f255db2e8bbd759f1cf3","urn:doxa:passage:65052e96938515831f432522ec894692cce23fa71b9fac3cdcfd2a2af6b3e549","urn:doxa:passage:c67242051ed12d222016f11b264922d9ac5ebd8b0f1a13b9353425238e39fd2d","urn:doxa:passage:81df93a643cad01bd5a3b693a59c8dcf6e362eaae4899ec4904fb47ef4897a75","urn:doxa:passage:68747fcd4d5fc8c1ce8a91de4a133018e8ea48866c9f33372c2e11d2a8b2f951","urn:doxa:passage:0497727a7c3d2eddebc13f3e26cf93ffd1e128285acd12935534ec59141635dd","urn:doxa:passage:ceffad81c605b5f21e1045ab50b12daac32142dde6d1ffec07575655ea140384","urn:doxa:passage:5adda49720e296f205238793a7ccd159a4d3369153d0d537f1c06d1b3bcb78a5","urn:doxa:passage:673f4bef2931cc01c3bcc3fab0cf9fdf2c354e9aaa7f19637e79839b662424a3","urn:doxa:passage:01e9f5f22942e53b52344c405a79f80fdabc8b750cb49b2121f333437b0e2c55","urn:doxa:passage:849a04c8386c19e8b6297cd28ac90a32eaa79fcc3039c5e5a0268e6ca2cae995","urn:doxa:passage:52a6804e932db9e3c42115a8f743fcd77ea4ef073c7ff9a5cc141b7a471dbe81","urn:doxa:passage:a29e62f1e573157f90fccc98b3830bf9838dbbb2bdeab0c6304a9e40d7a4219a","urn:doxa:passage:2efeedd6d89531a05665bdaf370becd0c1ac9a9725ec4a3ee86c377a9255e401"]},{"@id":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-785881","title":"The consequences of online discrimination and authoritarianism for minorities","author":"Valentina Vera-Quiroz","translator":[],"publishedOn":"2023-04-28","sourceUrl":"https://globalvoices.org/2023/04/28/the-consequences-of-online-discrimination-and-authoritarianism-for-minorities/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"5d2ecd23e7f4c065ade58e73ac4566c1d9ec48ddfedfc665d318f58e5b51cabc","textSha256":"f2e83c6a7a2892579ac903f6277a365004a23a02020c8a1962d810627783c77b","archivedRecordSha256":"f707cdeea5c88691be6b1208f753bbd7ff355b77cb96d8e24addc39eb5c85fc6","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:7bb9d7771989d27af70cb4a6c7faf462:u_d89052617d9c3174ea64a7e4","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_d89052617d9c3174ea64a7e4","status":"accepted","fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462"},{"@id":"urn:doxa:unit:7bb9d7771989d27af70cb4a6c7faf462:u_e72c109d5dbbc21a968e2e53","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_e72c109d5dbbc21a968e2e53","status":"accepted","fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462"},{"@id":"urn:doxa:passage:957fc2400667fdfe4b17f4b267ae30eee1f4bdc00a46dbbc214f047ad05e54aa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00006","start":113,"end":255,"exact":"That is the case in Egypt, where police have used apps like Grindr to arbitrarily track, arrest, and torture members of the LGBTQ+ community. "},{"@id":"urn:doxa:passage:1a2a1ad00a23a22d1a3415f0bd39ad8cfa7020042349dba86f33dfd5f4b7f2cc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00006","start":255,"end":509,"exact":"Similarly, authorities and intelligence agencies require Tinder to store its users’ data (including messages and pictures) on local servers in Russia, while the app has been pushed as a source of sensitive information online during the Ukraine invasion. "},{"@id":"urn:doxa:passage:af6207b291b3c247c0d62a60d64374cc36d12bff02042fa27fc406b8417ca04e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00006","start":509,"end":726,"exact":"Meanwhile, after the region’s takeover by the Taliban in 2021, people in Afghanistan are trying to delete any information related to their past and political views on their social media profiles to avoid persecution. "},{"@id":"urn:doxa:passage:752e11e7fd78910b2164eaf195277c8ff0dd61046d0155968e6ff9bedb78c5eb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00006","start":726,"end":836,"exact":"Regrettably, the Taliban have used these platforms to threaten and track some members of the LGBTQ+ community."},{"@id":"urn:doxa:passage:f9f0b68369a0d3414cadc4f232f18947f0cd2340e26888143f51d0b1597389bc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00007","start":0,"end":139,"exact":"Although the internet is not a virtual space completely separated from the offline realm, it is also not a mere replica of the real world. "},{"@id":"urn:doxa:passage:4880357cd0ce4956ffdf00b0d03997b7f38e73d23a2c7349da3380295c9641a9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00007","start":139,"end":247,"exact":"Digital technologies have introduced new dynamics within the online world that were never witnessed before. "},{"@id":"urn:doxa:passage:a41197ab3a3463e47e088112fcd9c058bdc6e38b17e36196940bea4eac86681f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00007","start":247,"end":397,"exact":"Furthermore, digital platforms have developed new ways for people to interact and construct their own identities through their design and algorithms. "},{"@id":"urn:doxa:passage:5975465b284a1652369333445075ac214c3988c18eba21089cd8e16f36c9ffd0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00007","start":397,"end":506,"exact":"However, these new dynamics introduced by large tech companies are also affecting disadvantaged communities. "},{"@id":"urn:doxa:passage:c69d30743c60f0477d7e6e3f6543f39a44d183e6e1fffde371d1675fec8e227e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00007","start":506,"end":747,"exact":"Although there may be a few attempts to decrease the unbalanced impact that these technologies have against these groups, the reality proves that the most vulnerable groups are those who are segregated and expelled from online participation."},{"@id":"urn:doxa:passage:b85674f93f097adb175b199e101e56fce939b34df897f8f6b6cbb81bcabf9a09","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00008","start":0,"end":148,"exact":"Concentrated minority groups are seen as threats by authoritarian regimes because they are more likely to mobilise and engage in collective action. "},{"@id":"urn:doxa:passage:53c1b5767eee57eac2ac7f0062bd6d61c1e8300aa5e707a22c3e3c1291bf572e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00008","start":148,"end":332,"exact":"Considering that the overarching goal of such regimes is to remain in power and maintain control over society, dissenting minority groups are often the target of harassment campaigns. "},{"@id":"urn:doxa:passage:619e309f6a2a9eb13bf6c7439772f7c04281d4815591cd2b6e174f5925251ab5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00008","start":332,"end":451,"exact":"Thus, it is expected that online and offline discrimination campaigns are promoted in order to silence opposing views. "},{"@id":"urn:doxa:passage:67328363245fb1135057ee6a751d778163a7469b920901810fb962b393e251d3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00008","start":451,"end":638,"exact":"However, the digital realm has increased authoritarian regimes’ capacity to penetrate different levels of society and mobilise majoritarian groups against minorities through the internet."},{"@id":"urn:doxa:passage:d53c63d3b5ccad91492b6021b0952a78811f6f8632271f343b2d676b20d04b75","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00009","start":0,"end":226,"exact":"Last, with minorities forming the overwhelming majority of targets of online hate speech and being one of the main targets of authoritarian regimes, social media platforms must prioritise their efforts to address hate speech. "},{"@id":"urn:doxa:passage:e2301c612eb2fd3791585fb17648935de03731b703523017ad00acf8d1ad0a0b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00009","start":226,"end":321,"exact":"Although some platforms are already moving in this direction, there is still a long way to go. "},{"@id":"urn:doxa:passage:6cee648e3f21719872c7b7bd1e25699d1156c689ebc54af28d4ceec28dc88bee","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00009","start":321,"end":501,"exact":"All of this makes it clear that understanding and addressing discrimination strengthens the capacity of countries and institutions to respond and prevent digital authoritarianism. "},{"@id":"urn:doxa:passage:26cd1abe2259ab6adca008f32284755fd879826447f41a2bdb89eace7805107e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00009","start":501,"end":671,"exact":"Rigorous monitoring of authoritarian practices is thus a crucial requirement and an instrument for recovering the voice that is often taken away from marginalised groups."},{"@id":"urn:doxa:passage:75d6a3d21c618bc7c66a6716d9fdf413e789ddd8386610e43a4c1c2d4fbb7df6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00010","start":0,"end":73,"exact":"Please visit the project page for more pieces from the Unfreedom Monitor."},{"@id":"urn:doxa:decision:9eaa0eb04d6ee292db24da308f7ebd90","@type":["doxa:Decision","prov:Entity"],"recordId":"9eaa0eb04d6ee292db24da308f7ebd90","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:7bb9d7771989d27af70cb4a6c7faf462:u_d89052617d9c3174ea64a7e4","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:957fc2400667fdfe4b17f4b267ae30eee1f4bdc00a46dbbc214f047ad05e54aa","urn:doxa:passage:1a2a1ad00a23a22d1a3415f0bd39ad8cfa7020042349dba86f33dfd5f4b7f2cc","urn:doxa:passage:af6207b291b3c247c0d62a60d64374cc36d12bff02042fa27fc406b8417ca04e","urn:doxa:passage:752e11e7fd78910b2164eaf195277c8ff0dd61046d0155968e6ff9bedb78c5eb","urn:doxa:passage:f9f0b68369a0d3414cadc4f232f18947f0cd2340e26888143f51d0b1597389bc","urn:doxa:passage:4880357cd0ce4956ffdf00b0d03997b7f38e73d23a2c7349da3380295c9641a9","urn:doxa:passage:a41197ab3a3463e47e088112fcd9c058bdc6e38b17e361