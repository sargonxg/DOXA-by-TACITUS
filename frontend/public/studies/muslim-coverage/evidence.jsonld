df1b2c11ef6a8b787d3f15e4fb"},{"@id":"urn:doxa:unit:c9db0ddf1b2c11ef6a8b787d3f15e4fb:u_92e9dcd28e870c2877c80871","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_92e9dcd28e870c2877c80871","status":"accepted","fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb"},{"@id":"urn:doxa:passage:6f23544ef267bad5aa109375ac871a1fa31bf23a4ca264cf67279e99bcb71734","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00013","start":188,"end":328,"exact":"It is not about a woman covering her face or not, but about whether she will be able to live without being judged and discriminated against."},{"@id":"urn:doxa:passage:d3992916f8c91915e13141a619660145c22c10aaad3a6ded42d165bcef70c4d4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00010","start":109,"end":225,"exact":"Excluding women from classrooms, offices, and daycares because of their dress strips them of economic independence. "},{"@id":"urn:doxa:decision:04abefed865ec931ee95f8a208ea80cd","@type":["doxa:Decision","prov:Entity"],"recordId":"04abefed865ec931ee95f8a208ea80cd","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:c9db0ddf1b2c11ef6a8b787d3f15e4fb:u_91aafb17d3df2ae314465e8f","attribution":"author","speaker":"Syed Salman Mehdi","speakerStance":"supports","documentStance":"supports","proposition":"women face discrimination based on their choice to cover or not cover their faces","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The author highlights the risk of women being judged and discriminated against based on whether they cover their faces.","modelPassage":["urn:doxa:passage:6f23544ef267bad5aa109375ac871a1fa31bf23a4ca264cf67279e99bcb71734","urn:doxa:passage:d3992916f8c91915e13141a619660145c22c10aaad3a6ded42d165bcef70c4d4"]},{"@id":"urn:doxa:passage:5fb71bc380f3cf64d549747e944419c55d4908a3d69dbbb4ae27c16a0da1fd5d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00010","start":308,"end":407,"exact":"The more the government controls what individuals believe, the less accommodating society becomes. "},{"@id":"urn:doxa:passage:6f25cbe36a092e61f6a70b4da2611486a0ed559cc17433a1b5e71acec4f858e2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00010","start":407,"end":509,"exact":"As history has recorded, when one group starts to lose its freedom, it will become limited in no time."},{"@id":"urn:doxa:passage:2de609ac62e546cf930da3716183eb1f03b051326bffdcf9b5f0400e61b71831","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00011","start":0,"end":124,"exact":"Most Western leaders promise to champion the rights of women in other countries, yet they do not defend those of their own. "},{"@id":"urn:doxa:passage:ac72f83c5ab1f637c115b1b2362686419d6cdc194df245701a4e2c200c2a50a3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00011","start":124,"end":264,"exact":"The very cries about religious conservatism in West Asia are cheers of the laws, limiting religious expression in Europe and North America. "},{"@id":"urn:doxa:passage:1844a482a115d10ab45963dadb9dabbcc874af4a503c6dafb73592c5103eb3f6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00011","start":264,"end":329,"exact":"This double standard exposes the political nature of the debate. "},{"@id":"urn:doxa:passage:7c74c27c6006811fa2f884cfe1056f8a1ea037e8dadb170162ce8573e6a0af5e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00011","start":329,"end":362,"exact":"Religion is not the real threat. "},{"@id":"urn:doxa:passage:18e743e97077eab4ab861c29a36d51cbadb4bd0845863c4873f7a04c628e3cc6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00011","start":362,"end":384,"exact":"Fear of difference is."},{"@id":"urn:doxa:passage:779ccf60427e3bfc0d0d1dc503459bf47ffd6e0a3bc80689a8fb6bea91180187","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00012","start":0,"end":69,"exact":"What is missing from these debates is the voice of women themselves. "},{"@id":"urn:doxa:passage:267427a5f2587625b06ba374f507715150865bd4f26fa639c56d45987f0cd5af","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00012","start":69,"end":166,"exact":"Few policymakers ask how women feel about being told what to wear, either in Kabul or in Quebec. "},{"@id":"urn:doxa:passage:07bb46f8fa7e1924aafde04fc40e5f6d708339456e666888464479377550792d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00012","start":166,"end":206,"exact":"For some, the hijab is an act of faith. "},{"@id":"urn:doxa:passage:6d9cee927736cfdde4f7211c9f716875b3b19a6ece8abc4bd2717db8945cbbc6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00012","start":206,"end":246,"exact":"For others, it is cultural or personal. "},{"@id":"urn:doxa:passage:08e3ce7cc86d5eaeb3f2d4e04b36f1623a1168d14c0aabc240233cafcf389d07","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00012","start":246,"end":332,"exact":"The right answer is not to remove or enforce it, but to respect the choice behind it. "},{"@id":"urn:doxa:passage:2a4b2bf9c41d9a39cf6fbd492038c487e331a0e9a2c4e9f36ef7c828c322d102","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00012","start":332,"end":383,"exact":"When a woman decides for herself, that is freedom. "},{"@id":"urn:doxa:passage:531293605def353a58e6a77791f4953ab1749330a68f372c289bf2b37b490587","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00012","start":383,"end":427,"exact":"When others decide for her, that is control."},{"@id":"urn:doxa:passage:c228d7b93d67e633af743f40caebfd6b3437824e072d199627e0f9f19e874f06","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00013","start":0,"end":104,"exact":"The challenge today is to protect individual freedom without turning it into another form of dominance. "},{"@id":"urn:doxa:passage:0be739bb8f1a4fad7d5ff23d8be3b9774d00c014aa9043052b3049f95676047f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00013","start":104,"end":188,"exact":"Governments must stop using secularism or religion as tools for social engineering. "},{"@id":"urn:doxa:passage:4e1b7874f65acb4b3f35f13d62ce09b4f8ab90f26857e8e3ab176fe77f709c9e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00014","start":0,"end":52,"exact":"Freedom should not depend on geography or ideology. "},{"@id":"urn:doxa:passage:82ddd3170fbba00ae730ea3c3eceee37d768bcd2bde3901b041abd4e623307d8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00014","start":52,"end":106,"exact":"It should mean the same in Toronto, Tehran, or Kabul. "},{"@id":"urn:doxa:passage:d176471c72f20a3f56071066069596a9271c3037effa5497b593afd4b8ed6197","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00014","start":106,"end":152,"exact":"The real measure of a free society is simple. "},{"@id":"urn:doxa:passage:175a2094c03e53528afdea61b6631ee4fd5b98ef02d470a20e0664a0130b5606","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00014","start":152,"end":230,"exact":"It is not how women look, but how much control they have over their own lives."},{"@id":"urn:doxa:passage:cd22f718755baee55a09b2c9dd95852d97654f2eeb224457dd1d82524c2f1130","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00015","start":0,"end":107,"exact":"In conclusion, the struggle over the veil has become a mirror reflecting society’s fears and insecurities. "},{"@id":"urn:doxa:passage:dec30fa9c8137012f3f80c1cb011c3107cf79abe759163a6e83f75d3232a5135","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00015","start":107,"end":207,"exact":"Different parts of the world claim to defend with dignity, yet deny women agency in different ways. "},{"@id":"urn:doxa:passage:84794c14a68cc3968c4c65bcc42035fecbf629b965f953f918924affa87fa73a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00015","start":207,"end":320,"exact":"True liberation will come only when a woman’s appearance is no longer a matter of state policy or public debate. "},{"@id":"urn:doxa:passage:9f0811fb27e6b3e776a71a589252bec91c8c82e6fef11854d61a684aa677c845","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c9db0ddf1b2c11ef6a8b787d3f15e4fb","blockId":"gv-846347-b00015","start":320,"end":408,"exact":"Until then, the world will continue to argue about freedom while denying it in practice."},{"@id":"urn:doxa:decision:ad0740f7e0d02f30c6b0e327f1308fb5","@type":["doxa:Decision","prov:Entity"],"recordId":"ad0740f7e0d02f30c6b0e327f1308fb5","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:c9db0ddf1b2c11ef6a8b787d3f15e4fb:u_91aafb17d3df2ae314465e8f","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:5fb71bc380f3cf64d549747e944419c55d4908a3d69dbbb4ae27c16a0da1fd5d","urn:doxa:passage:6f25cbe36a092e61f6a70b4da2611486a0ed559cc17433a1b5e71acec4f858e2","urn:doxa:passage:2de609ac62e546cf930da3716183eb1f03b051326bffdcf9b5f0400e61b71831","urn:doxa:passage:ac72f83c5ab1f637c115b1b2362686419d6cdc194df245701a4e2c200c2a50a3","urn:doxa:passage:1844a482a115d10ab45963dadb9dabbcc874af4a503c6dafb73592c5103eb3f6","urn:doxa:passage:7c74c27c6006811fa2f884cfe1056f8a1ea037e8dadb170162ce8573e6a0af5e","urn:doxa:passage:18e743e97077eab4ab861c29a36d51cbadb4bd0845863c4873f7a04c628e3cc6","urn:doxa:passage:779ccf60427e3bfc0d0d1dc503459bf47ffd6e0a3bc80689a8fb6bea91180187","urn:doxa:passage:267427a5f2587625b06ba374f507715150865bd4f26fa639c56d45987f0cd5af","urn:doxa:passage:07bb46f8fa7e1924aafde04fc40e5f6d708339456e666888464479377550792d","urn:doxa:passage:6d9cee927736cfdde4f7211c9f716875b3b19a6ece8abc4bd2717db8945cbbc6","urn:doxa:passage:08e3ce7cc86d5eaeb3f2d4e04b36f1623a1168d14c0aabc240233cafcf389d07","urn:doxa:passage:2a4b2bf9c41d9a39cf6fbd492038c487e331a0e9a2c4e9f36ef7c828c322d102","urn:doxa:passage:531293605def353a58e6a77791f4953ab1749330a68f372c289bf2b37b490587","urn:doxa:passage:c228d7b93d67e633af