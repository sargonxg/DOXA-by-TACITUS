5-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:7bb9d7771989d27af70cb4a6c7faf462:u_d89052617d9c3174ea64a7e4","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:957fc2400667fdfe4b17f4b267ae30eee1f4bdc00a46dbbc214f047ad05e54aa","urn:doxa:passage:1a2a1ad00a23a22d1a3415f0bd39ad8cfa7020042349dba86f33dfd5f4b7f2cc","urn:doxa:passage:af6207b291b3c247c0d62a60d64374cc36d12bff02042fa27fc406b8417ca04e","urn:doxa:passage:752e11e7fd78910b2164eaf195277c8ff0dd61046d0155968e6ff9bedb78c5eb","urn:doxa:passage:f9f0b68369a0d3414cadc4f232f18947f0cd2340e26888143f51d0b1597389bc","urn:doxa:passage:4880357cd0ce4956ffdf00b0d03997b7f38e73d23a2c7349da3380295c9641a9","urn:doxa:passage:a41197ab3a3463e47e088112fcd9c058bdc6e38b17e36196940bea4eac86681f","urn:doxa:passage:5975465b284a1652369333445075ac214c3988c18eba21089cd8e16f36c9ffd0","urn:doxa:passage:c69d30743c60f0477d7e6e3f6543f39a44d183e6e1fffde371d1675fec8e227e","urn:doxa:passage:b85674f93f097adb175b199e101e56fce939b34df897f8f6b6cbb81bcabf9a09","urn:doxa:passage:53c1b5767eee57eac2ac7f0062bd6d61c1e8300aa5e707a22c3e3c1291bf572e","urn:doxa:passage:619e309f6a2a9eb13bf6c7439772f7c04281d4815591cd2b6e174f5925251ab5","urn:doxa:passage:67328363245fb1135057ee6a751d778163a7469b920901810fb962b393e251d3","urn:doxa:passage:d53c63d3b5ccad91492b6021b0952a78811f6f8632271f343b2d676b20d04b75","urn:doxa:passage:e2301c612eb2fd3791585fb17648935de03731b703523017ad00acf8d1ad0a0b","urn:doxa:passage:6cee648e3f21719872c7b7bd1e25699d1156c689ebc54af28d4ceec28dc88bee","urn:doxa:passage:26cd1abe2259ab6adca008f32284755fd879826447f41a2bdb89eace7805107e","urn:doxa:passage:75d6a3d21c618bc7c66a6716d9fdf413e789ddd8386610e43a4c1c2d4fbb7df6"]},{"@id":"urn:doxa:passage:e0c80a9e3f60d24015cd4b60a919c0983f138f481d46221eeb2e3f6cd247c479","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00001","start":0,"end":88,"exact":"Studies have shown that discrimination often correlates with authoritarian preferences. "},{"@id":"urn:doxa:passage:0c02979b488198d47ec61afdf4aeaa32b819cfc771b20114a36380a9ae14a9ce","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00001","start":88,"end":218,"exact":"Discrimination against religious minorities, in particular, is more severe in authoritarian regimes than in democratic countries. "},{"@id":"urn:doxa:passage:b5c406f07ea72e4310f8b2a9e95003375c16ee084b394e37d01026a48393032f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00001","start":218,"end":347,"exact":"For example, Myanmar has a long history of repressive military rule, poor governance, and civil war with ethnic minority groups. "},{"@id":"urn:doxa:passage:f7df538357c0db5a374c40ed687b715385368e37475d7fa817228b392cd67925","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00001","start":347,"end":546,"exact":"In addition, the ongoing persecution of the Rohingya people by the Myanmarese military has forced more than 700,000 Rohingya to flee to Bangladesh, while thousands of women and girls have been raped."},{"@id":"urn:doxa:passage:4ac3126b228a1f03431c6c7b948316d74b135d76a6d5a5179c2f871c254384f4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00002","start":0,"end":103,"exact":"Repression has always been one of the toughest challenges that vulnerable communities and groups face. "},{"@id":"urn:doxa:passage:7331b5b8ad96a4323b4154ba4cbfb51ab18f27478dde568e8e11372dcf9e1378","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00002","start":103,"end":218,"exact":"Digital technologies have added new dimensions to what authoritarian regimes can attempt to repress or demobilise. "},{"@id":"urn:doxa:passage:8d228d0fe2ece2172b1705444eb2ba60f5adb544fe7f0ae2183982a14fbd6d7c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00002","start":218,"end":410,"exact":"Around the world, groups that have been historically discriminated against face stigma, which serves to exclude them from public participation, markets, services, spaces, and data collection. "},{"@id":"urn:doxa:passage:ae4a95bfa92ed5636f7ec449f96aa624b670101ca6ed50fca0db1be9b3a87781","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00002","start":410,"end":518,"exact":"The battle against exclusion these groups face is exacerbated by inaccessible or unaffordable connectivity. "},{"@id":"urn:doxa:passage:8b3c18ff99c230aab7d71cf9d6615f275aa521b42eb162b4d49c4fae58288c66","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00002","start":518,"end":721,"exact":"According to the World Bank, people with disabilities, over 1 billion people worldwide, face barriers to communication, interaction, access to information, and participation in civic society activities. "},{"@id":"urn:doxa:passage:e446b558dc4cde45070bc18ccd2b1e18481af67076593811e899292e387929b5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00002","start":721,"end":914,"exact":"Although digital technologies are helping overcome some of these barriers, their mere existence is insufficient to bridge the gaps in the socio-economic ecosystem for people with disadvantages."},{"@id":"urn:doxa:passage:48eae1516b5539bb8df070a331dd1d558033361ca9f4739625970ce6f9cc8323","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00003","start":0,"end":240,"exact":"Too often, the most vulnerable groups are more prone to discrimination and harassment because offline targets are usually the same victims of online abuse, in particular, young women, racial minorities, and members of the LGBTQ+ community. "},{"@id":"urn:doxa:passage:75e4feeff5e52071cb8d3905894ad0fefdb55df84208603b4c97caf8aec19ee8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00003","start":240,"end":423,"exact":"Frequently, the disparate impact of technology affects women and marginalised groups more, as they are less likely to access the internet and exercise their rights to digital speech. "},{"@id":"urn:doxa:passage:93972a88f1b6660766e851e52254101a035ac29c7b2fb1c6d015258113f4aab9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00003","start":423,"end":553,"exact":"As the digitalisation of economics expands worldwide, gender inequality in the physical world is replicated in the digital world. "},{"@id":"urn:doxa:passage:3629aac4a8498eb3b00ceb6da2fa78ad135d10dcc001cd9e98a3c665384fcd3d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00003","start":553,"end":696,"exact":"Consequently, women and other marginalised groups have fewer employment opportunities and face additional barriers to workforce participation. "},{"@id":"urn:doxa:passage:368051beecb35dfd7ff6d2a72fb61813a983e0f58b54f3b4c44b2b37703843d4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00003","start":696,"end":863,"exact":"Moreover, the harm these people experience is made worse by how harmful content spreads across the internet at a speed and scale that is almost impossible to control. "},{"@id":"urn:doxa:passage:f2e5e44a0b39844602d22c1887869fa5a6b6f188fc4521343f090bef5a8557a3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00003","start":863,"end":1094,"exact":"The internet thus reinforces the same discrimination that marginalised groups have historically battled, discouraging them from online public participation and making their social integration ever more difficult than it already is."},{"@id":"urn:doxa:passage:b2b3c0411efdca5c31106743886798f22d12a65041b60464e688db2623fa3fbc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00004","start":0,"end":83,"exact":"Online harassment has shamefully become one of the main features of the world web. "},{"@id":"urn:doxa:passage:e0e07ec4b8a1753618eec53051f3a42eba9bf6fd10aff0789995a5ef2de9b572","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00004","start":83,"end":137,"exact":"Today, it is hard to imagine the internet without it. "},{"@id":"urn:doxa:passage:e1a6c492fc747c9733d257760f66eb435f584cc61b25082b4d85f8c28e6aaa22","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00004","start":137,"end":262,"exact":"From online violence to authoritarian governments silencing dissent, online toxicity is common to almost all internet users. "},{"@id":"urn:doxa:passage:e68c910c8e0dd284e0bde60a5ccbefa75001a94806623fb867234c8bc2e924c8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00004","start":262,"end":485,"exact":"While evidence shows that any person is susceptible to online harassment, extensive research shows that women, people of colour, religious minorities, and members of the LGBTQ+ community are far more likely to be targeted. "},{"@id":"urn:doxa:passage:5546b7845816678857c542a8bebe1215f293683f6d6aa3c237af743ada6d131a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00004","start":485,"end":698,"exact":"The growth of the internet has expanded this problem and the ways people can be targeted; with the rise of smartphones, harassment is now a 24/7 problem for people who have been historically discriminated against."},{"@id":"urn:doxa:passage:44bc9377503bf73c62a0ba4bd7e68f50a9c6bc03726df66a457461df2e8fbca6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00005","start":0,"end":64,"exact":"The efforts to fight online discrimination are largely failing. "},{"@id":"urn:doxa:passage:91d0989b0b6c09f4732989fd6cf45ba53235d28ec8fa3bfed07057ad3a2c721d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00005","start":64,"end":219,"exact":"According to the latest report by the Special Rapporteur on minority issues, Fernand de Varennes, online hate is only getting worse for vulnerable groups. "},{"@id":"urn:doxa:passage:19ec1a113e3d19131833a52540a8e04f2d4ca09e48f84a4ed8ed4cbb7791d675","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00005","start":219,"end":376,"exact":"In most countries, three-quarters or more of the targets of online hate speech are members of minority groups, with women being disproportionately targeted. "},{"@id":"urn:doxa:passage:c832fc6d77d72126aba9473c4d5187b65f07cd5973df230dd04a6b17accafe3a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00005","start":376,"end":617,"exact":"Similarly, LGBTQ+ individuals, Muslims, Hispanics or Latinos, and Black people faced especially high rates of identity-based discrimination in the United States, making it harder and less safe to be online as a member of any of these groups."},{"@id":"urn:doxa:passage:24585dc16f3c38a32956aa6e5c584243698154c298d3bcc01d58933926b7795a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7bb9d7771989d27af70cb4a6c7faf462","blockId":"gv-785881-b00006","start":0,"end":113,"exact":"At the same time, governments have deployed sophisticated strategies to increase the repression of these groups. "},{"@id":"urn:doxa:decision:ab1b8c730f90d0b415c78b6045b95d86","@type":["doxa:Decision","prov:Entity"],"recordId":"ab1b8c730f90d0b415c78b6045b95d86","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:7bb9d7771989d27af70cb4a6c7faf462:u_e72c109d5dbbc21a968e2e53","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:e0c80a9e3f60d24015cd4b60a919c0983f138f481d46221eeb2e3f6cd247c479","urn:doxa:passage:0c02979b488198d47ec61afdf4aeaa32b819cfc771b20114a36380a9ae14a9ce","urn:doxa:passage:b5c406f07ea72e4310f8b2a9e95003375c16ee084b394e37d01026a48393032f","urn:doxa:passage:f7df538357c0db5a374c40ed687b715385368e37475d7fa817228b392cd67925","urn:doxa:passage:4ac3126b228a1f03431c6c7b948316d74b135d76a6d5a5179c2f871c254384f4","urn:doxa:passage:7331b5b8ad96a4323b4154ba4cbfb51ab18f27478dde568e8e11372dcf9e1378","urn:doxa:passage:8d228d0fe2ece2172b1705444eb2ba60f5adb544fe7f0ae2183982a14fbd6d7c","urn:doxa:passage:ae4a95bfa92ed5636f7ec449f96aa624b670101ca6ed50fca0db1be9b3a87781","urn:doxa:passage:8b3c18ff99c230aab7d71cf9d6615f275aa521b42eb162b4d49c4fae58288c66","urn:doxa:passage:e446b558dc4cde45070bc18