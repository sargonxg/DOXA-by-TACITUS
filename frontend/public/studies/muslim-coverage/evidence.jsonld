343a7bd58bd3c23f50a2829c88ff58fadbd86dbaacfeaf060c12f75aadf6e5","urn:doxa:passage:7996fe32a1d434e8129be78d27abb36838bc1fa0c15022107e18375882744c9d","urn:doxa:passage:ab5bdf2c7b1fa081c39580773887096173ef519697489448f95ae3ac1a345990","urn:doxa:passage:81f57db57eaf81f8c15864d9a550808a28385ba201b78deeefc378cbf79a5b9e","urn:doxa:passage:3db25008864d03de3590faa48e45e9d45d460d67223ed3d077e34a49d323a295","urn:doxa:passage:7ec17f455582649dfcaadd9fd9bd39312b33902faf60affa11e7c63c4f26bff5","urn:doxa:passage:d1e34662ebc1c3e3da28e81865203da0048a8f8be74e4fc40e2e0f1c2a758556","urn:doxa:passage:84457d7291a6e2077b9db189bfdd064c7bc1388e9c7b6bc7ef76be21777fb4d9","urn:doxa:passage:f6d43d96de6268d6746193eb9dacf0a2370cc3229cef4533c0582216597dfac5","urn:doxa:passage:ed51bcbda6fa51b8397a56558fdfe64a007c9e961ad9c3cc25d8efa792030b0c","urn:doxa:passage:3acd43d9312d1839da0667c157c92b420f9b94f44e756bb7af6e806ecfebfd7d","urn:doxa:passage:2ddc26fc03f375ac098f20a56961f7731e0a94d6f6821e90d5161f1fe88645d0"]},{"@id":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-762708","title":"A Uyghur journalist's demand: Bring an end to my family’s decades of suffering","author":"Shohret Hoshur","translator":[],"publishedOn":"2022-05-19","sourceUrl":"https://globalvoices.org/2022/05/19/a-uyghur-journalists-demand-bring-an-end-to-my-familys-decades-of-suffering/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"286b6d69227ae6f4f499fcb11a5aec3c0df6a95e801ac1a971939eff4b5eb43e","textSha256":"8c47e29a86faf1478f210b0b07d9100fdb75bb2b631fe299decb0579e9717d2e","archivedRecordSha256":"d4d0cf3b6f44726b49129940738a3c18a2ff64e07963c2029dc3c50c8ef6c683","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:42d90b4c13d9df644b08b64ee1ef964e:u_930e5dff76903167cfcc2874","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_930e5dff76903167cfcc2874","status":"accepted","fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e"},{"@id":"urn:doxa:unit:42d90b4c13d9df644b08b64ee1ef964e:u_d6df94d6981299abda40fe31","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_d6df94d6981299abda40fe31","status":"accepted","fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e"},{"@id":"urn:doxa:passage:e45e5a949486f4fcc7cbb9828ee09c138771f2967098c890dfb90e82076174e7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00008","start":454,"end":633,"exact":"When I called my mother two months later, her grandchild picked up the phone and said that my mother had been summoned by the police the week before and had never come back since."},{"@id":"urn:doxa:passage:8076fa256e88866d8ea268fc870a4b4568b98bd95b8eddedec29f75d3d0b1ce4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00009","start":0,"end":82,"exact":"Thus, 11 members of my family are missing, and no one’s fate has been determined. "},{"@id":"urn:doxa:passage:a2a9389c232017b8f8252159029897e02f8b8c4e47d496ba6a30fa6a3c8830f5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00009","start":82,"end":304,"exact":"I have been reporting on this situation with my family to the US State Department since the end of 2017, and I have asked China to provide information about my relatives, but I have received no response from either entity."},{"@id":"urn:doxa:passage:2c5d1e28e8114888aa26f6f7f2bef7faf273adf58cbda054555115a03e63c087","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00010","start":0,"end":170,"exact":"In the summer of 2021, I heard that my mother had been sentenced to eight years in prison at the end of 2018 for leaking state secrets and obstructing the legal process. "},{"@id":"urn:doxa:passage:98ddd9dc516b718d12b192ee8fafdd6488c23f1b814a47c2943e8e6d8418d6fe","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00010","start":170,"end":268,"exact":"My letter to the Chinese embassy in Washington to confirm my mother’s charges has gone unanswered."},{"@id":"urn:doxa:passage:723976e59e77868e29e2096d5920493bf23630c33f328c51519a135f2b7108bb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00011","start":0,"end":112,"exact":"A week ago, I called some residents of our hometown in Korgas County, to inquire about my mother’s whereabouts. "},{"@id":"urn:doxa:passage:385a6085b80f13c08cf3de7f1e78ac9c2c2cc1631eacf18d1dd21c5155651cec","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00011","start":112,"end":278,"exact":"One of the residents said that the house where my mother lived had not been cleared of snow for several years, which reflects the absence of any adults in our family."},{"@id":"urn:doxa:passage:4571286c5e856762af8a00a9d6938d1a593b134b5685d7c37348a6d286a4b538","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00012","start":0,"end":107,"exact":"I firmly believe that all my missing relatives were jailed as retaliation for my journalism work with RFA. "},{"@id":"urn:doxa:passage:acb26611770572e98321d7fc3d8b0afeed10414d258701277c2c42bc2569dec5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00012","start":107,"end":246,"exact":"My mother is 82, my eldest brother is 62, and my younger brothers, Tudahun and Rehim, have health issues (stomach and lung, respectively). "},{"@id":"urn:doxa:passage:ded5f76f1fd6b1958ba802b71fc8a55d8e9a4a7181b4819de29c6f5442fcf446","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00012","start":246,"end":302,"exact":"Thus, I am extremely worried about their health status. "},{"@id":"urn:doxa:passage:73cb0976684b35810746f0a08f654c4532d4d449ed7cc8aac9e356af52527800","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00012","start":302,"end":442,"exact":"I urge UN staff to help get information on whether my 11 relatives are alive and, if so, where are they and why and how they were punished. "},{"@id":"urn:doxa:passage:d67f1d25dcb18ed8cd6e1e436b3a27db79c4c16b828c096d7ae1be83129c62ef","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00012","start":442,"end":559,"exact":"I believe that investigating their fate could help the UN team gain a clearer understanding of the Uyghur situation. "},{"@id":"urn:doxa:passage:d34805308156398b8de92d2fada73ba3242d364d657d235838cd9104b7ebd2d3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00012","start":559,"end":704,"exact":"China cannot deny that my relatives are captives; all information about their detention should be publicly available in the international media. "},{"@id":"urn:doxa:passage:a5ccc76d02867d9e40cf43e831a8c0ffd7eb617c166b952de006cbe96cfeb061","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00012","start":704,"end":850,"exact":"Additionally, my relatives may have the courage to tell the truth because they have benefited from the results of a foreign investigation in 2015."},{"@id":"urn:doxa:passage:d46cb81eb0c4aafb1c96cbb33bf142b2ca81adac9413fbe0278895b2aede5ab5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00013","start":0,"end":252,"exact":"China is not only retaliating by punishing the relatives of an American journalist but also trying to erase all signs of hope for millions of people in the region, making them believe that the outside world does not care and is unwilling to help them. "},{"@id":"urn:doxa:passage:593c49f50a89b84a63a31844df9f33cfe7434c63703132505d6d9048d38fa7f3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00013","start":252,"end":529,"exact":"Therefore, I urge the UN investigation team to include all my relatives, or at the very least my mother (Tuhan Musa, 82), three siblings (Shawket, 62; Tudaxun, 48; and Rexim, 46), and ex-wife (Peridem Abdurusul) on the list of people who should be released from camps in China."},{"@id":"urn:doxa:passage:55d4ea145ea367be4c80b0bd5c8c4a850445758af0605a614a824bf61a7d1cd3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00014","start":0,"end":179,"exact":"In 2002, my ex-wife, Peridem Abdurusul, and our two children were held at Shanghai International Airport while traveling to the US with immigration documents for the family unit. "},{"@id":"urn:doxa:passage:e924f18d3aa4f8a3016891165a533c36079d6e14b0696b52bde47903da457eab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00014","start":179,"end":282,"exact":"They were unable to obtain passports because of my articles published in Uyghur publications overseas. "},{"@id":"urn:doxa:passage:f23aaec1e452bf8b09049eef94181e2a2d0ce8dfcbc0524b48aaf955ee874f10","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00014","start":282,"end":411,"exact":"In 2009, Chinese state-owned broadcaster CCTV called me a provocateur for the July 5th Urumchi Incident because of my reporting. "},{"@id":"urn:doxa:passage:ba47afec1f07a6bde3af22ad2a153deebb9c6fb364579acac14788a715b7e25c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00014","start":411,"end":524,"exact":"Just this year, I was called a liar by China’s spokesperson Zhao Lijian over my testimony at the Uyghur Tribunal."},{"@id":"urn:doxa:passage:0ca37a3b4dba94dd31cbb7090889f204477f5584c7edee38517459c42270424c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00015","start":0,"end":289,"exact":"I know that China will not forgive me or end the retaliation against my family, but I hope that your experience and the high-level international team that you lead, along with the meaningful investigation you have proposed, could help end my family members’ years of undeserved punishment."},{"@id":"urn:doxa:passage:e60146a61df8371d79ab02c6ca8d5a0b148c9dfaea02e6f6fe837b252b58418c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00016","start":0,"end":10,"exact":"Thank you,"},{"@id":"urn:doxa:passage:e621643a92051e806c5432f366c92e21816f16fcc0cf306aad794b3384184abf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00017","start":0,"end":14,"exact":"Shohret Hoshur"},{"@id":"urn:doxa:decision:75e7e682dcdf4ff548da6e8001a772f3","@type":["doxa:Decision","prov:Entity"],"recordId":"75e7e682dcdf4ff548da6e8001a772f3","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:42d90b4c13d9df644b08b64ee1ef964e:u_930e5dff76903167cfcc2874","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition