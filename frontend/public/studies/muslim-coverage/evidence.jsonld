b","urn:doxa:passage:6937fedcc456ebe29c374057b9e37671fae51865bea71e5bd105e3a54f9ff2ed"]},{"@id":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-809499","title":"The slow but steady erosion of India’s civil society","author":"Kanav Narayan Sahgal","translator":[],"publishedOn":"2024-04-01","sourceUrl":"https://globalvoices.org/2024/04/01/the-slow-but-steady-erosion-of-indias-civil-society/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"3f693e689ab009f3744b40b1a26af0f8af1de9583834264998e7f5b7422d75d4","textSha256":"b66f40fe0525476960e38cff0b9232c2a4048c30c305fcce18426ca9ab45903f","archivedRecordSha256":"bf817c021bae50e5483d346967f808f19125ba3c0a25c070ddd083dda3b8191e","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:b06184e463b5fb9c641c1b5541dbca26:u_202d2aa5e9b1319d53746c25","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_202d2aa5e9b1319d53746c25","status":"accepted","fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26"},{"@id":"urn:doxa:unit:b06184e463b5fb9c641c1b5541dbca26:u_20aea7c69502580c08de8035","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_20aea7c69502580c08de8035","status":"accepted","fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26"},{"@id":"urn:doxa:unit:b06184e463b5fb9c641c1b5541dbca26:u_591882acbb4ee87f4300515b","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_591882acbb4ee87f4300515b","status":"accepted","fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26"},{"@id":"urn:doxa:passage:1faa60fef36641691c5a76a366d97d5d212dea6b55291ae0ee3581bf4a101296","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00013","start":0,"end":269,"exact":"A few days before the raids at CES, the Enforcement Directorate (ED), a law enforcement agency responsible for fighting economic crimes, arrested opposition politician Hemant Soren hours after he resigned as the chief minister of the eastern Indian state of Jharkhand. "},{"@id":"urn:doxa:passage:5642120491cee2cf61bc6e520f3a0f5e05bffeb84967e2700895935734e3eb38","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00013","start":269,"end":311,"exact":"His jailing was met with severe backlash. "},{"@id":"urn:doxa:passage:29aafe247009342824577de05da3e3b88d2b6a2817bcbbf32e7a3f3f0e05417d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00013","start":311,"end":591,"exact":"Opposition leaders criticized the selective deployment of the ED, Central Bureau of Investigation (CBI), and the IT Department, alleging that these purportedly impartial government agencies were being weaponized to “destroy democracy,” weaken federalism, and jail the opposition. "},{"@id":"urn:doxa:passage:f1d97ae83addde1c689657e2b78262f2b7e5927b81b0e0bb90ae737675b16372","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00013","start":591,"end":795,"exact":"It is important to note that the same ED official who supervised Soren's arrest also supervised the recent arrest of Arvind Kejriwal, another member of the opposition and current Chief Minister of Delhi. "},{"@id":"urn:doxa:passage:9ac5d3524f33328e0bb5b133dba419e9ff31d56b7899590bdd85c19641e618c8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00013","start":795,"end":871,"exact":"Kejriwal’s arrest makes him the first sitting chief minister to be arrested."},{"@id":"urn:doxa:passage:42624d6a0ca3a1baf6fe7ce6b7027d324f7beaf0b80d4926c1fe637ce976bef0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00014","start":0,"end":73,"exact":"Delhi-based filmmaker and journalist Alishan Jafri posted on X (Twitter):"},{"@id":"urn:doxa:passage:0eb2d38ee45092175c729500ead87cbed16c8e18be820cf727d59044878edd3b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00015","start":0,"end":24,"exact":"A long arc of repression"},{"@id":"urn:doxa:passage:5d81a9f4703a4a53bb6b47e60a93b46b921cff135b38fe61ed738f8e7aaf6ef8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00016","start":0,"end":132,"exact":"The Indian state's tendency to clamp down on opposing voices, particularly civil society groups, is nothing new nor unique to India."},{"@id":"urn:doxa:passage:c480817cf3218f1d3f8598d9b31e4f7f3ebe2e235e8a1741ca3b8d7410306a21","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00017","start":0,"end":249,"exact":"On September 21, 2020, the Lok Sabha passed the Foreign Contribution (Regulation) Amendment (FCRA) Bill 2020, which redefined terms for how non-governmental organizations (NGOs) can accept, transfer, and utilize foreign donations and contributions. "},{"@id":"urn:doxa:passage:e67ac3ee8af92d14027d1c4a0d5b3bebf19d31b61263f4abd7ab6d0d367b341d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00017","start":249,"end":365,"exact":"It should be noted that FCRA originated as emergency-era legislation in 1976 to monitor foreign influence in India. "},{"@id":"urn:doxa:passage:21d137d16a066b1f39d7815dacbd6f8fedf80c15457f326db9b6265a6be5bdc5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00017","start":365,"end":554,"exact":"The 1976 legislation was subsequently repealed in 2010 to create a more stringent law, which was amended once again in 2020 to further tighten the noose around civil society organizations. "},{"@id":"urn:doxa:passage:76dc7c1af5ec8d928259f5c9056d85b1809504c40e1ceb78595236aded5e7ca6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00017","start":554,"end":925,"exact":"These amendments include provisions that prohibit transferring foreign funds between organizations, reduce the cap on FCRA funds for administrative purposes to 20 percent (down from 50 percent), and mandate all office bearers, directors, or key functionaries of NGOs furnish their Aadhaar (personal identification card) details, thereby increasing administrative hurdles."},{"@id":"urn:doxa:passage:41e0006000bf9762c33b5803ceac0b1107fa949a4fba11b4014b0477c64e66a3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00018","start":0,"end":198,"exact":"International affairs scholar Suparna Chaudhry explains that over 130 countries worldwide have repressed NGOs in the last three decades, suggesting a broad perception of NGOs as a potential threat. "},{"@id":"urn:doxa:passage:21504e5f9c5cfd48a39eb193c6bc77d5cd7807ef143515be80e947c0a68e66ec","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00018","start":198,"end":416,"exact":"While violent crackdowns are typically used for immediate domestic threats like protests, violence can backfire, increasing the state's criminal liability, reducing its legitimacy, and violating human rights treaties. "},{"@id":"urn:doxa:passage:bb8b6356ce39483e05ba2ce576fabbf0c65481e33dadedd1cb12f1e73333ee0a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00018","start":416,"end":594,"exact":"Therefore, states are more likely to use administrative crackdowns to address long-term threats, such as NGOs influencing elections or challenging the state's economic interests."},{"@id":"urn:doxa:passage:1c551e2f14d328e7b620d03d7df634c67f111fc410a6f167b9d3930b7bbcc74e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00019","start":0,"end":159,"exact":"In the Indian context, this explains the use of government agencies to clamp down on civil society groups and launch selective probes into opposition leaders. "},{"@id":"urn:doxa:passage:4557c91119e08932a4d6ed81498f930b5e97da297879567d8452c1c85c014a1c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00019","start":159,"end":269,"exact":"The same level of scrutiny is rarely applied by those in power to weed out corruption within their own ranks. "},{"@id":"urn:doxa:passage:6ac68e369b84df5a8927bbf25621893f7617184f6297c5d47511232a8082d219","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00019","start":269,"end":418,"exact":"These raids and investigations thus become tools for consolidating power under the guise of anti-corruption measures and curbing “foreign influence”."},{"@id":"urn:doxa:passage:4755d6abe92a53665682c197e0f729cf95a1b7fe9576f72d13dac9e73886ae29","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00020","start":0,"end":21,"exact":"2024: A decisive year"},{"@id":"urn:doxa:passage:ce2bb3e5c8ecf643c3dce3c1ad224e378a5fac144b5a62be7cd70d3c1309cae2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00021","start":0,"end":177,"exact":"As India approaches the polls in 2024, civil society groups and NGOs will play an increasingly vital role in holding the ruling party accountable for its actions and decisions. "},{"@id":"urn:doxa:passage:50bea57806ab2e7f4902fd62fa3ee7deb75e1121155007fb07799de46e7f02f2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00021","start":177,"end":303,"exact":"They provide platforms for public discourse on ideologically diverse positions, facilitating constructive dialogue and debate."},{"@id":"urn:doxa:passage:744f89cfbd086a12ef288740f19f0b357f114397d6ada378256dd709ed917649","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00022","start":0,"end":225,"exact":"According to a recent report by The Economist, since coming to power in 2014, Narendra Modi’s administration has systematically shut down or depleted thousands of charities, creating an environment of fear within the sector. "},{"@id":"urn:doxa:passage:7eeeaa98d9bcbe51f9437f5fff1b4932f549e84d689ea4389c1135d3431fc09f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00022","start":225,"end":344,"exact":"The exact number of affected organizations is difficult to determine due to the various legal means used against them. "},{"@id":"urn:doxa:passage:5cf9b725aca804fccdbb47018d093345c84b774845a789e547748b9e4677cebb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00022","start":344,"end":430,"exact":"However, the chilling effect is undeniable, as such cases rarely lead to convictions. "},{"@id":"urn:doxa:passage:f1422da952e9f8aea0d88358f96c38c320e232cd4b3c1ea48c01e3eaa3109f60","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b06184e463b5fb9c641c1b5541dbca26","blockId":"gv-809499-b00022","start":430,"end":541,"exact":"By tying up limited resources and paralyzing operations, the legal process itself becomes a form of oppression."},{"@id":"urn:doxa:decision:3bd65d2f401bba3843a109e59968b6f0","@type":["doxa:Decision","prov:Entity"],"recordId":"3bd65d2f401bba3843a109