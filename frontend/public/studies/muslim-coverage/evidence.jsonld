2f264bf","urn:doxa:passage:dc7cb9f2dece96c5fac915dfce6ddaf62e798043e9776cd2c96c0f95a749994e","urn:doxa:passage:a8db6b713c666fd7083e569a641ac03ffd36218813f8bfc2e7eabfdcdda834bc","urn:doxa:passage:1e5cc10028f792d24e617d0b10173711d11de4389abf9161767b3434e9b5cbc1","urn:doxa:passage:bfcf605093e9c85453f323b1c44fb94404e8956be344a0479928dbce53464702","urn:doxa:passage:b2be95d35b9809f9fa1b780fa958ff5d8d96a424745878f7cdc572e45c1c8ddb","urn:doxa:passage:e75e9fbc20541d27e8115987c20e7d466ce9130538ae56b3aa565988cbe31413","urn:doxa:passage:22fb83d3bd8a149b8ec8c155bda893ffc8a22199fa72f276845646f71dbf6b17","urn:doxa:passage:af3c776063a9baf7b52dec504e184e92183f7fc261c4e8c329428d8aa9d35c4e","urn:doxa:passage:feadb33784ddb534cff019399d397971f1a4f2dd0e917f42301a8c38999a68a3","urn:doxa:passage:41bd8f8215f516d377ce4067f4dee4946e74a41572a4731f38e0c85eba36674a","urn:doxa:passage:35139bbf71c2039b2cb6c3ccfd3dff8c67959041d8a8f53b36bb99c35ef3acb8","urn:doxa:passage:7b5d0d1f731fd27c3776655f6e20281daa5935e1a39a23998df16a90def21579"]},{"@id":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-744531","title":"Turkey's ruling Justice and Development Party turns 20","author":"Arzu Geybullayeva","translator":[],"publishedOn":"2021-09-01","sourceUrl":"https://globalvoices.org/2021/09/01/turkeys-ruling-justice-and-development-party-turns-20/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"ae15f2baefd99ead37196ca29608b5085f6d746c1b7c795cb40cbe6023df768d","textSha256":"cdb5cd91988d11c8145391983097f7ea330d4780a76a6c69eb5448bd95f557ff","archivedRecordSha256":"fea30210a8e88c59f83c096700fccc22be557c514ec900e8ef9ea413c3b8e729","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:6c96715b4a5645039ba0f050ca5a083c:u_0914677d0e919659af4149b3","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_0914677d0e919659af4149b3","status":"accepted","fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c"},{"@id":"urn:doxa:unit:6c96715b4a5645039ba0f050ca5a083c:u_73037f2d533db916f04050c5","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_73037f2d533db916f04050c5","status":"accepted","fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c"},{"@id":"urn:doxa:passage:0c9f0850b95615bb60ff3ef5d6d635ce0e5441a41c3030899e17074ae2d7b847","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00001","start":0,"end":112,"exact":"In August, Turkey's Justice and Development (AK) Party marked its 20th anniversary since it was formed in 2001. "},{"@id":"urn:doxa:passage:1bc05b7b8021841a3283a0d0990f0d539a3a6b1a7f00b30018fa61371ac1154a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00001","start":112,"end":288,"exact":"The Party has secured victory in almost all major elections since 2002, narrowly escaped being closed down in 2008, and has enjoyed wide support and popularity over the years. "},{"@id":"urn:doxa:passage:a1cbe9975a3de23bfde15224985ebc67df12d4742b968856ef7261c6e9b10b0a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00001","start":288,"end":431,"exact":"One of the AKP’s founders, Recep Tayyip Erdoğan, served three terms as the country’s Prime Minister and since 2014, as the President of Turkey."},{"@id":"urn:doxa:passage:34d3b5ee96e55bdcab90c6e8366261dce067a2072c58dfa855eebb276134cdc9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00002","start":0,"end":241,"exact":"Twenty years later, looking back at nearly two decades of AK party rule, the party’s popularity is dwindling and its ties with Western governments have deteriorated significantly as the country is facing an economic and democratic precipice."},{"@id":"urn:doxa:passage:1f3937974e92d9337b1c8eebd46d8698a799e3198ef260f5150539a24bb26dd8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00003","start":0,"end":50,"exact":"The promise of economic growth and good governance"},{"@id":"urn:doxa:passage:af0598749ac13492b70ffc48359d4c1c1084046e10e21f8ad1e9ddbc4fa0c384","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00004","start":0,"end":173,"exact":"Much of AKP’s popularity in its early years was directly related to the economic stability that the ruling party delivered after winning the parliamentary election in 2002. "},{"@id":"urn:doxa:passage:979f0aa2ee5b750db29579f36a2c7f187baaf67b8930802ec6aff06335fed9f8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00004","start":173,"end":296,"exact":"Despite the global financial crisis between 2008–2009, the Turkish economy experienced a 4.5 percent average annual growth."},{"@id":"urn:doxa:passage:33765aba0a67c529857d5370f1274967c83128ae83364bde77890ce7ad001a98","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00005","start":0,"end":114,"exact":"In 2004, Turkey received a formal invitation to kick off negotiations over its accession into the European Union. "},{"@id":"urn:doxa:passage:95fd33218ffe09a7aa2db04379be85553eeb84b4bae5eccaf23f92a07dc70df3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00005","start":114,"end":245,"exact":"Triumphant Erdoğan, who was prime minister at the time, was determined to showcase that democracy was possible in a Muslim country."},{"@id":"urn:doxa:passage:47bdc1dd51e5781ac889b187456150363cbe3184bb1afbe0d0f90156bb116915","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00006","start":0,"end":29,"exact":"This lasted only a few years."},{"@id":"urn:doxa:passage:3fe086ed9ff1b4634d42024a902fc4de193ec1bd2ee63d03ca1b3172e74c7d55","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00007","start":0,"end":234,"exact":"In the spring of 2007, the Turkish military released a statement saying they were not in favor of the next presidential candidate (who was appointed by the parliament at the time according to national legislation) favored by the AKP. "},{"@id":"urn:doxa:passage:05c27cfc6896a815564ddbd18afd1747bc786c574293c0da8d63d84be7776ebd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00007","start":234,"end":332,"exact":"Somehow, police in Istanbul uncovered a network of plotters planning to overthrow the government. "},{"@id":"urn:doxa:passage:be3dbb0c250ab08e2e257576f674e031e71302620faf8f512b37bece6b7fb0a8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00007","start":332,"end":438,"exact":"Among many members of the group were military, intelligence, business people, journalists, and academics. "},{"@id":"urn:doxa:passage:d973a8d729ed0b3351c36a7e79344c07d11c975889851c50f8a97accb4d9440b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00007","start":438,"end":587,"exact":"Known today as the Ergenekon case, and the Sledgehammer investigations, the operation led to the prosecutions of several senior military commanders. "},{"@id":"urn:doxa:passage:fca9f4f9672f9b2899aab4d7b802356ebef0cecb02f6de606b7519eab6d3a43e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00007","start":587,"end":686,"exact":"Years later, evidence emerged, suggesting that both the Ergenekon and Sledgehammer were fabricated."},{"@id":"urn:doxa:passage:1f84d681eeca6ae7f22a85d65ba463f39e73362aaa885288dfab083c33fd0d66","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00008","start":0,"end":168,"exact":"After these controversies, Turkey witnessed an emboldened party, arrests of government critics, and power consolidation in the hands of the ruling party and its leader."},{"@id":"urn:doxa:passage:bbb069812f43f80af682eb3a24f322b696f43af0183938fdb69afb58e6264a7d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00009","start":0,"end":61,"exact":"It was a downhill journey on the democracy front after that. "},{"@id":"urn:doxa:passage:4bb231f3e7afe97c848f809e9e0868b93d58cae39ccfc9cf4850aac37a35c632","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00009","start":61,"end":200,"exact":"The constitutional referendum in 2007 replaced the election of the president by the members of the parliament with a direct national vote. "},{"@id":"urn:doxa:passage:cd6114c658d924c4f65698734d89e63301d0632392c8f4adfc886e688ca2f2de","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00009","start":200,"end":341,"exact":"The referendum in 2010, granted both the legislative and the executive branches of the government broader powers over judicial appointments. "},{"@id":"urn:doxa:passage:51e9f9e1f26ce604f16d997f74247492c231b20ad426f735b5f2679d59e08731","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00009","start":341,"end":529,"exact":"As a result, the AKP leadership was able to gradually erode the judiciary and the military branches of the government, ending any potential barriers to the government's preferred policies."},{"@id":"urn:doxa:passage:1d8974553ad66137b45804c3ae260feee62536ae259799e92d679c728f227ef4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00010","start":0,"end":23,"exact":"Protests and corruption"},{"@id":"urn:doxa:passage:d16c0587476c818f093cd0ff4990f13b16f8b7989002286cfa0a349be48c461e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00011","start":0,"end":82,"exact":"In 2013, Erdoğan’s AKP was faced with its first popular unrest and graft scandal. "},{"@id":"urn:doxa:passage:be08fefdce8bb1c2ee091417748f293caec743ea3f3fb3fa21699f947942d18b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00011","start":82,"end":171,"exact":"Known today as the Gezi Park protests, anti-government protests spread across 83 cities. "},{"@id":"urn:doxa:passage:2f72dcf44e642029f8e5cd07de9eb7243ff75848bd637da793debfd151633225","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00011","start":171,"end":418,"exact":"Scores of people were arrested during and in the aftermath of Gezi Park protests for questioning police brutality, crony capitalism, and power inequality, all the while riot police used water cannons and tear gas across cities to quash the unrest."},{"@id":"urn:doxa:passage:1f2746e2f852a8ebcf4bae4ee9ed7e95829f02b12e3d7e67c80fcc8f75ea9118","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00012","start":0,"end":89,"exact":"That same year, three government ministers resigned as a result of a corruption scandal. "},{"@id":"urn:doxa:passage:877e423571ae09ae4f8eca03b5a60c2d520c2970e1e4f5e18f2630ce3f0a5ed3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00012","start":89,"end":194,"exact":"Erdoğan, who was prime minister at the time, claimed the allegations were orchestrated by foreign powers."},{"@id":"urn:doxa:passage:34dd31686f8e2c84de5c4511d56673d57fdf7b1b0a83174b99117ff317130146","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00013","start":0,"end":168,"exact":"And yet, despite the mishandling of the protests, the corruption allegations, and signs of a lagging economy, in 2014, Erdoğan was elected, as the President of Turkey. "},{"@id":"urn:doxa:passage:d99af4844b21e1f694128d739337bf6b040f065c270aa49f3cb2d578cabe2e70","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00013","start":168,"end":231,"exact":"But AKP’s biggest selling point — the economy — was weakening. "},{"@id":"urn:doxa:passage:7fa4ea22cea36f2f81feb994ba3b2292bdb515cd887e4a4f9eb7b7d396a196bd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00013","start":231,"end":337,"exact":"Unemployment and inflation were reaching double digits and the Turkish Lira was losing its value quickly. "},{"@id":"urn:doxa:passage:d2ea861f66584e9bca5ce8ebd4feba69f7f1209f526a05fea39a25206fd441aa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00013","start":337,"end":491,"exact":"According to reporting by Reuters, the Turkish Lira, “shed 75 percent of its value against the dollar since 2013, more than half in the last three years.”"},{"@id":"urn:doxa:passage:94ae72956d13a8bfc0fd3ee78b7f41b112a284f6149c4e2b10f33405ee542685","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00014","start":0,"end":51,"exact":"But the party continued to enjoy relative support. "},{"@id":"urn:doxa:passage:ae9ed11f984e244eeb90f045ef72b6cc050a1ee055000544eefc267cced256d9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00014","start":51,"end":99,"exact":"In 2015, AKP secured another landslide victory. "},{"@id":"urn:doxa:decision:e04edb296df727eb72c6efeae116592b","@type":["doxa:Decision","prov:Entity"],"recordId":"e04edb296df727eb72c6efeae116592b","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:6c96715b4a5645039ba0f050ca5a083c:u_0914677d0e919659af4149b3","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:0c9f0850b95615bb60ff3ef5d6d635ce0e5441a41c3030899e17074ae2d7b847","urn:doxa:passage:1bc05b7b8021841a3283a0d0990f0d539a3a6b1a7f00b30018fa61371ac1154a","urn:doxa:passage:a1cbe9975a3de23bfde15224985ebc67df12d4742b968856ef7261c6e9b10b0a","urn:doxa:passage:34d3b5ee96e55bdcab90c6e8366261dce067a2072c58dfa855eebb276134cdc9","urn:doxa:passage:1f3937974e92d9337b1c8eebd46d8698a799e3198ef260f5150539a24bb26dd8","urn:doxa:passage:af0598749ac13492b70ffc48359d4c1c1084046e10e21f8ad1e9ddbc4fa0c384","urn:doxa:passage:979f0aa2ee5b750db29579f36a2c7f187baaf67b8930802ec6aff06335fed9f8","urn:doxa:passage:33765aba0a67c529857d5370f1274967c83128ae83364bde77890ce7ad001a98","urn:doxa:passage:95fd33218ffe09a7aa2db04379be85553eeb84b4bae5eccaf23f92a07dc70df3","urn:doxa:passage:47bdc1dd51e5781ac889b187456150363cbe3184bb1afbe0d0f90156bb116915","urn:doxa:passage:3fe086ed9ff1b4634d42024a902fc4de193ec1bd2ee63d03ca1b3172e74c7d55","urn:doxa:passage:05c27cfc6896a815564ddbd18afd1747bc786c574293c0da8d63d