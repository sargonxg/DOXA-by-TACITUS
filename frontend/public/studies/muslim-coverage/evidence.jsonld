ssage:5495b835a9f350fe8528ce68b927d261b1e3d6a3666c355f631091721db80e27","urn:doxa:passage:fe5c102164883cd3503a6b2df30b08a9d8b58436f9999945acff321d27e45683","urn:doxa:passage:1d7cb04635b7351eabd47808106ea47ecc664e00b2711b483f7a7052f146566d","urn:doxa:passage:bbf8a7a0fbadce1467271ed4cedc59720c883fd62f958e93f22238085e156ebc","urn:doxa:passage:a112ebc0f507fdee3bf8af597b6d8eabceb0bbf69530d7300a461d1118f09fd9","urn:doxa:passage:ab950290f129a5e42ea1189f18d61e6aa5c7c5152b65a91aa59e6971bb0e7dea","urn:doxa:passage:21e3e05fdf2936cec0c864eb0a977c45ea699e5b7331b3950da3412c5bb56c8a","urn:doxa:passage:c5457d4a189a0465e1d6aebe9a1a911cd698a551014ada9e8af72e9603aa06b3","urn:doxa:passage:6bf79041d50686ce9b50d097eb4021e69de69bd7ed5a070ea9acad00c0b84424","urn:doxa:passage:e084722390f6a639fcc07b483f50cdf1faa5bee39ba97da831fdf500fb191356","urn:doxa:passage:c287da54f70f71405b9dc09e98a159af5ee1dd47b122e40a654e560de382ab41","urn:doxa:passage:ec76d5191cf306e3f71d3644b14451de60d8e75c6e7ca5866e6fac5595acf74f","urn:doxa:passage:fcdac0c8d401ef998fffc6b689526803d63efe70c120c608a8b08ba36465fae2","urn:doxa:passage:157b036f0628b41ea139361332a32aa9fa47e49943752b695d761d365c933515","urn:doxa:passage:a2b46411aa04843af7c5ec82d2f3a161f8969e9ff4bb0f44b730c482196c9979","urn:doxa:passage:8b9173c5008cf0205163d69998eae1c113885e474b98890e998b95197a059753","urn:doxa:passage:223d746cdd1d7740adc714975aabec5a365ef6fa34dac776d61280bd8a5299d7","urn:doxa:passage:79c39500261186c1b1f50e9c631dc277bef2b30bf6f840d85c8d4411f46b1d29","urn:doxa:passage:ee2a8bca0bdb6c8e87eb979e7cbe2e6a9af8912d3888c3aeaba45ac0d80abbae","urn:doxa:passage:7829f70af738109eb15b2b881a3a455d6baf4493dec621ac05c0ef1d22b7553d","urn:doxa:passage:643dcf69d9c71aa3d6fd379c185d15f6b5ead08ac1ed23ae3fec1dfe91b34e2f","urn:doxa:passage:04609f8f99b7f6db029dc75a77927309b80eb1f91bc08d2738a4af43f554c0a6"]},{"@id":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-736381","title":"Czechia's Muslim women celebrated Ramadan with mixed experiences","author":"Elmira Lyapina","translator":[],"publishedOn":"2021-05-29","sourceUrl":"https://globalvoices.org/2021/05/29/czechias-muslim-women-celebrated-ramadan-with-mixed-experiences/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"6c147ac74f215dc8ee22a0b0ae81b1aa129ca7a34a87fd96f67ef865c773f62e","textSha256":"37747518f86e07dd014710454ef16fbb61f282913c429722e35417f01cab0de3","archivedRecordSha256":"def17d4603b1008b6998c41c743a61d4082a0ad6e77cc57110d13f07c2d52635","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:b73ab00c514dbbf600be2707a54e6c3f:u_2b51ba382cb3a579a404e385","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_2b51ba382cb3a579a404e385","status":"accepted","fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f"},{"@id":"urn:doxa:unit:b73ab00c514dbbf600be2707a54e6c3f:u_cbcc06a4361dd67477554eba","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_cbcc06a4361dd67477554eba","status":"accepted","fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f"},{"@id":"urn:doxa:unit:b73ab00c514dbbf600be2707a54e6c3f:u_d25767b87e1769eb0b405372","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_d25767b87e1769eb0b405372","status":"accepted","fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f"},{"@id":"urn:doxa:passage:294dc28cb7dc1c2cc8ebeb8dc8860b61fa637bf0ab80cb2f0bb9bf602e677d94","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00012","start":0,"end":180,"exact":"An example of such is the famous 2016 case of the Somalia student who wore hijab to class, and was pressured by the school's principal to take off her headscarf or face expulsion. "},{"@id":"urn:doxa:passage:d47e10d4a4be49a0c36086615e5a16c92a5701a83efcd3452ab4a587741203fd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00013","start":57,"end":220,"exact":"Initially, court of first and second instances decided to back the principal's position, emphasizing the Czech's stance as following the “western liberal ideals”. "},{"@id":"urn:doxa:decision:7e08d3e3122332f76811e3bd9e9cbefb","@type":["doxa:Decision","prov:Entity"],"recordId":"7e08d3e3122332f76811e3bd9e9cbefb","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:b73ab00c514dbbf600be2707a54e6c3f:u_2b51ba382cb3a579a404e385","attribution":"reported_speaker","speaker":"School principal","speakerStance":"opposes","documentStance":"neutral","proposition":"A student should remove her headscarf or face expulsion.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports a case where a student faced potential expulsion for wearing a hijab, with initial court decisions supporting the principal's pressure.","modelPassage":["urn:doxa:passage:294dc28cb7dc1c2cc8ebeb8dc8860b61fa637bf0ab80cb2f0bb9bf602e677d94","urn:doxa:passage:d47e10d4a4be49a0c36086615e5a16c92a5701a83efcd3452ab4a587741203fd"]},{"@id":"urn:doxa:passage:2705b074521a0d81ced754a58688f4758a2f7d63817499651008383cbf729859","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00007","start":393,"end":593,"exact":"Anti-Islam attackers often justify their behavior by alleging that they protect human rights values, and are attempting to ‘save’ Muslim women who they say are oppressed and forced into wearing hijab."},{"@id":"urn:doxa:decision:379ae9149b71080543c0ac38edabc48a","@type":["doxa:Decision","prov:Entity"],"recordId":"379ae9149b71080543c0ac38edabc48a","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:b73ab00c514dbbf600be2707a54e6c3f:u_2b51ba382cb3a579a404e385","attribution":"reported_speaker","speaker":"Anti-Islam attackers (as reported by the author)","speakerStance":"not_applicable","documentStance":"neutral","proposition":"Attackers claim they are 'saving' Muslim women from oppression.","hypothetical":false,"reviewStatus":"unreviewed","modelPassage":["urn:doxa:passage:2705b074521a0d81ced754a58688f4758a2f7d63817499651008383cbf729859"]},{"@id":"urn:doxa:passage:b0d56434f232ab3deac0e08628e3fb5b9cb231a9a0debcb85ba467796bcca0e1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00007","start":0,"end":192,"exact":"In 2017, rhetoric incitement of violence led to an attempted terrorist attack against Muslims, when a citizen caused two passenger trains to derail, and vied to blame it on Muslim immigrants. "},{"@id":"urn:doxa:passage:77c4bd15675b685b7a66f6e33127fb4af33e76b0a88436c8f9cadd2802e638e6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00007","start":192,"end":393,"exact":"Fluctuating in momentum, Islamophobic views and ideas remain prevalent in Czechia, with Muslim women being the usual main targets for hate speech and attacks since wearing hijabs displays their faith. "},{"@id":"urn:doxa:decision:0fa781c5b38f5eef86af11ce6b963ed8","@type":["doxa:Decision","prov:Entity"],"recordId":"0fa781c5b38f5eef86af11ce6b963ed8","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:b73ab00c514dbbf600be2707a54e6c3f:u_2b51ba382cb3a579a404e385","attribution":"reported_speaker","speaker":"Author (reporting on documented incidents)","speakerStance":"neutral","documentStance":"neutral","proposition":"Muslims are targets of hate speech and violence in Czechia.","hypothetical":false,"reviewStatus":"unreviewed","modelPassage":["urn:doxa:passage:b0d56434f232ab3deac0e08628e3fb5b9cb231a9a0debcb85ba467796bcca0e1","urn:doxa:passage:77c4bd15675b685b7a66f6e33127fb4af33e76b0a88436c8f9cadd2802e638e6"]},{"@id":"urn:doxa:decision:2ea7e0571a83f3ca8812f9b88a7eac39","@type":["doxa:Decision","prov:Entity"],"recordId":"2ea7e0571a83f3ca8812f9b88a7eac39","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:b73ab00c514dbbf600be2707a54e6c3f:u_2b51ba382cb3a579a404e385","attribution":"reported_speaker","speaker":"School principal","speakerStance":"opposes","documentStance":"neutral","proposition":"The student must remove her headscarf or face expulsion.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports an incident where a student was pressured to remove her hijab to avoid expulsion, representing a restriction based on identity.","modelPassage":["urn:doxa:passage:294dc28cb7dc1c2cc8ebeb8dc8860b61fa637bf0ab80cb2f0bb9bf602e677d94"]},{"@id":"urn:doxa:passage:9b80d6b350668689c332c3174d89bd674b6e145bd263f38f269553547444b1bb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00012","start":180,"end":433,"exact":"The principal received support from Islamophobic movements and political parties, and was even awarded a medal in 2018 by the right-wing Czech president Zeman for being “a brave woman in the fight against intolerant ideology, for services to the state”."},{"@id":"urn:doxa:decision:09f824e6a4af44ac297dc8ec25fc4c85","@type":["doxa:Decision","prov:Entity"],"recordId":"09f824e6a4af44ac297dc8ec25fc4c85","outcome":"uncertain","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:b73ab00c514dbbf600be2707a54e6c3f:u_2b51ba382cb3a579a404e385","attribution":"reported_speaker","speaker":"The document (reporting on the 2016 case and subsequent legal proceedings)","speakerStance":"neutral","documentStance":"neutral","proposition":"The school principal's pressure on a student to remove her hijab was supported by political entities and lower courts.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"While a school principal's actions were supported by political entities and initially upheld by lower courts, the Supreme Court later overturned the decision, making a systemic pattern of institutional practice unestablished in this single case.","modelPassage":["urn:doxa:passage:294dc28cb7dc1c2cc8ebeb8dc8860b61fa637bf0ab80cb2f0bb9bf602e677d94","urn:doxa:passage:9b80d6b350668689c332c3174d89bd674b6e145bd263f38f269553547444b1bb","urn:doxa:passage:d47e10d4a4be49a0c36086615e5a16c92a5701a83efcd3452ab4a587741203fd"]},{"@id":"urn:doxa:passage:b1d4019c9eb00a4b3adb27e89802a803fff8eff8ba782aa6452400e258482335","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00005","start":127,"end":212,"exact":"Here, Islam has historically been associated with something alien and even dangerous."},{"@id":"urn:doxa:decision:9fbcb9fbe5bfdc3a5f7b8b9c0a96270d","@type":["doxa:Decision","prov:Entity"],"recordId":"9fbcb9fbe5bfdc3a5f7b8b9c0a96270d","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:b73ab00c514dbbf600be2707a54e6c3f:u_2b51ba382cb3a579a404e385","attribution":"reported_speaker","speaker":"unspecified","speakerStance":"neutral","documentStance":"neutral","proposition":"Islam is associated with something alien and dangerous.","hypothetical":false,"reviewStatus":"unreviewed","modelPassage":["urn:doxa:passage:b1d4019c9eb00a4b3adb27e89802a803fff8eff8ba782aa6452400e258482335"]},{"@id":"urn:doxa:passage:40647e3073fc7b1e45f89e56511a493db3740892d68f162f655a5e1f15fda090","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00013","start":220,"end":391,"exact":"However, in 2020, the Supreme Court affirmed the Muslim student's right in donning the hijab, stating that the “prohibition of hijab was not following the legitimate aim”."},{"@id":"urn:doxa:passage:cca6d719e487e7c354ea5dd6dd682722dbbd002b3597c820023c8347da387eac","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00014","start":0,"end":296,"exact":"Despite the ruling not being final since the principal plans to appeal, people from Czechia's Muslim community consider it to be a positive development, not only in the clash between Islam and Islamophobes, but also within a democratic system at its best, with politicians versus judicial system."},{"@id":"urn:doxa:passage:57fb327ad8b150e5627117b902758ed387078c21af57978596ee7572aca78113","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00015","start":0,"end":160,"exact":"Despite all this, the word Islamophobia cannot be fully used to describe Czechia, since such incidents remain isolated cases, rather than a systematic approach."},{"@id":"urn:doxa:passage:fd2417e1a9b58084cb2ddd0f1b5976a5b52877e42a41de500045f91afe749a33","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00016","start":0,"end":110,"exact":"Moreover, sentiments of hostilities against Muslims in the country vary depending on political circumstances. "},{"@id":"urn:doxa:passage:0e0cc756f5c05d3c47725fe1fa4e4e2107e72fc158018b57d0979aaa8ab97e79","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00016","start":110,"end":211,"exact":"Furthermore, local Muslims invest much effort in increasing public understanding of their community. "},{"@id":"urn:doxa:passage:c6ae00aaa1fd6c8a8e0dcabefda35872b52d92ddd789329e3a07b836118f7f1b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00016","start":211,"end":405,"exact":"They organize and participate in different events, open dialogues, write blogs and articles to educate people, as well as invite them to the celebrations of Islam holidays home or to the mosque."},{"@id":"urn:doxa:passage:42a9879ca77499677cfbd88e0d7f7fa2d8187f9a58941b2219a9b06fd4c29b44","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00017","start":0,"end":16,"exact":"“Female Ramadan”"},{"@id":"urn:doxa:passage:1bfb5d80f60530d23b834392c0ff21d58e4a3db057f74f1daea45b2dc87fb680","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00018","start":0,"end":223,"exact":"Throughout the month of Ramadan, women of different ages, social class, and origins come to the mosque at the time of iftar – or sunset, which is the time Muslims break their daily fast – and sit together at the same table."},{"@id":"urn:doxa:passage:1df5e3bbcf2361146de430689082fa3d46f2030ece92f5fa0b39e3faf4970ca5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00019","start":0,"end":71,"exact":"Some of them come to the mosque every day, while others choose not to. "},{"@id":"urn:doxa:passage:4fb9455ee7f3158eed717c139ea67d31f34eaab192d76d12bbb2271ed8dc9e10","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00019","start":71,"end":201,"exact":"During daytime, they go about with their normal daily lives, studying or working, then come to the mosque for late night prayers. "},{"@id":"urn:doxa:passage:cd983e07244edfa4cb7b91566667db254c51148c47677d9d0ed06e189c307b09","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00019","start":201,"end":317,"exact":"Others spend the whole day at the mosque, studying in the small classroom, or reading Muslim's holy book, the Quran."},{"@id":"urn:doxa:passage:d9ea8059e86a4de1a961daa848ebaeb6c441a34bf79a0d10ef9e199276ac1d39","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00020","start":0,"end":93,"exact":"Zulfira, a Tatar girl from Moldova who has been living in Prague for over 4 years, explained:"},{"@id":"urn:doxa:passage:f6e0976ab07609c7a48bcb22945d0a22cd7fd6b8f77936654cad10f841635543","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00021","start":0,"end":80,"exact":"> This year, I went to the mosque for Iftar almost every day, 3-4 times a week. "},{"@id":"urn:doxa:passage:d6e17dfab808b3ba978eec8366153a7c1381057d07884d17c720ec3478bbffc7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00021","start":80,"end":180,"exact":"This gives me strength and patience in fasting, because not eating or drinking all day is not easy. "},{"@id":"urn:doxa:passage:46544e29a9b7208c71557c49320873bcc3ebe6be6f304df1a492651770780855","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00021","start":180,"end":237,"exact":"And you need somehow to motivate and encourage yourself. "},{"@id":"urn:doxa:passage:317109f3f9e7dc7921116a951c385594f3d28000424ca90af32ee7101faa80ca","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00021","start":237,"end":316,"exact":"People here are very nice: they fast too, and observe, which is very inspiring."},{"@id":"urn:doxa:passage:3e9135ce5fba8298dd79ff29a8b0c19ced41a3490b208ed0198eff89b4db7f4e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00022","start":0,"end":110,"exact":"Celebrating Eid Al-Fitr starts for many women days in advance as they buy gifts and prepare for the occasion. "},{"@id":"urn:doxa:passage:17f512a0de53384be470526d7871c06cc6a7bb681f39f9b8cd7427b17f753ba6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00022","start":110,"end":159,"exact":"The night before Eid is usually spent in cooking."},{"@id":"urn:doxa:passage:d588ea32a1cd015d1eccdf3ebd00198ed0b5a8fa7aa66de26f160444aa48dca4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00023","start":0,"end":207,"exact":"On the day, the imam who leads the prayers begin the recitals at 8.00 am on the first floor, and his voice is heard through the loudspeakers all over the second floor, where female worshippers pray in rows. "},{"@id":"urn:doxa:passage:604403af0188c141af3eb9dc79d6073388ee5bdda90476b9585c2fd0a81133ab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00023","start":207,"end":424,"exact":"In comparison with many other places like the Balkans or Russia, where males attend prayers and females mostly stay at home, in Czech mosque, families come together: husband, wife and children who wish to participate."},{"@id":"urn:doxa:passage:2b3864ae988a5eda3e08a1913710388b9c78564c4a138ea5b77511d57bb51e4c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00024","start":0,"end":85,"exact":"Later, community members exchange greetings and gifts, as well as meals and recipes. "},{"@id":"urn:doxa:passage:550fec5f8d13da8b60d395a4f9def32fcc05bef3805ab83ad80db89b5570ce2e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00024","start":85,"end":149,"exact":"The dishes served mirror the diversity among Muslim women here. "},{"@id":"urn:doxa:passage:5b6400620723b983864bf531e067a9b2ec0479e6e8a16d8b2dea05a30cbf4a98","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00024","start":149,"end":366,"exact":"Alongside Arabic and Turkish cuisines, Czech convert Šárka prepared Czech pancakes, while Katya, a Russian convert, made traditional Russian salads and cakes, as well as other national meals from all around the world."},{"@id":"urn:doxa:passage:4e6c3283910d1a868e31aff2ec62709f085a32e096984b6356f218c992c65adf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00025","start":0,"end":95,"exact":"If Eid meals vary worldwide, Eid rituals across the global Muslim community are quite similar. "},{"@id":"urn:doxa:passage:078d22a0a7473cff829964149b7ea6b78599c76195d94aebf25707499477a205","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00025","start":95,"end":144,"exact":"After prayers, family and friends come together. "},{"@id":"urn:doxa:passage:5e260aed89d114135b2de29d5985275c392281cb3b20a5579de988bf1bcbdad1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00025","start":144,"end":184,"exact":"Photographer Sönmez shared her memories:"},{"@id":"urn:doxa:passage:711811634e5d3c7ad110d9ccb340654993003b8e83e74f318145f6b7c9573d78","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00026","start":0,"end":77,"exact":"> In Turkey, children receive many sweets, especially “baklava” or “kadaif”. "},{"@id":"urn:doxa:passage:b98dc9a00308c54f2b531de712d6a48e26e09dba4da62f5a52177c8a5427bc70","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00026","start":77,"end":134,"exact":"Relatives and neighbors come, and we exchange the gifts. "},{"@id":"urn:doxa:passage:1ece9f6ccc8627db85b5630082a454a527f3711b43f606af749dbc94525113ff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00026","start":134,"end":179,"exact":"Younger generations visit the elderly people."},{"@id":"urn:doxa:passage:60a85aaf2bc0f855192e30af55a26cba7ce42d748c5a127d33b38b3216da91fd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00027","start":0,"end":134,"exact":"Jacquiline, a women of mixed Czech and Sudanese origin who celebrates Ramadan in both countries, usually bakes cookies called “Ka’ak”,"},{"@id":"urn:doxa:passage:0f1fa6fde43bf8d9a74c22d01391da99c2e29bd785b53046d49addd6cd98c4cd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00028","start":0,"end":74,"exact":"> In Czechia, not much time is spent in preparing food compared to Sudan. "},{"@id":"urn:doxa:passage:bf3e4b1f06797bad29a18bcfccfed9a3f4f704c0402403edcf66d0478a392548","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00028","start":74,"end":131,"exact":"So women in Czechia spend more time in worshiping Allah.”"},{"@id":"urn:doxa:passage:a4a6a9c04ac9555c8e058b4e6bfb0947ecd4602916ee50cc0a253eb340bb7c5b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00029","start":0,"end":66,"exact":"When asked how she feels being Muslim in Czechia, Jacquiline said:"},{"@id":"urn:doxa:passage:d8b09006c45317e3f64fcc650d30450388607de8da1dff36d0704a70bb9f7176","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00030","start":0,"end":35,"exact":"> “I wear hijab and I'm satisfied. "},{"@id":"urn:doxa:passage:15ad3f7ae8ee0c419d3e355915efc599af7e5a1f9f8309f6d0cab96b2f52f0fc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b73ab00c514dbbf600be2707a54e6c3f","blockId":"gv-736381-b00030","start":35,"end":100,"exact":"Although sometimes there is some criticism, it can be withstood”."},{"@id":"urn:doxa:decision:59dabdfd50121eb20111bcc4bb95af6d","@type":["doxa:Decision","prov:Entity"],"recordId":"59dabdfd50121eb20111bcc4bb95af6d","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:b73ab00c514dbbf600be2707a54e6c3f:u_cbcc06a4361dd67477554eba","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:d47e10d4a4be49a0c36086615e5a16c92a5701a83efcd3452ab4a587741203fd","urn:doxa:passage:40647e3073fc7b1e45f89e56511a493db3740892d68f162f655a5e1f15fda090","urn:doxa:passage:cca6d719e487e7c354ea5d