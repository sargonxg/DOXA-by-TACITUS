874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:bf3b5ce259ec2962041514122207db13:u_c9cd53da2ff6e72138fffeef","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:2f872f88f89dd9a381b2edebc7792be551f6903211cff6cd65ed9c118cbe6baa","urn:doxa:passage:6ac2b5c44c8151203f25265b5f86aae5d7e914b4f0c1cdd41c98c98c74007b4a","urn:doxa:passage:20dfe90c5374deb4cbff2ed0849ce1c57c04374867ab682b8727d3245b45429f","urn:doxa:passage:684660e7ac824321d544cac75dce18a6588ca5baec40924e2c60c30279e370b0","urn:doxa:passage:8e79c22ba22847bc5aa1b745dfa0a659b68900246ade74242233216e473952d9","urn:doxa:passage:fabe359752de3037b59e2072618fc22f5b183df72fedcf450607f33ae7540a05"]},{"@id":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-806959","title":"‘I don’t feel safe': Reactions to Germany’s suppression of pro-Palestine solidarity","author":"Safa","translator":[],"publishedOn":"2024-02-16","sourceUrl":"https://globalvoices.org/2024/02/16/i-dont-feel-safe-reactions-to-germanys-suppression-of-pro-palestine-solidarity/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"ea5172323d9b1620adc59672628d8c23ef03b81f038d2d0790c3c87f9f2e12fd","textSha256":"f7f2208991a4c39f5ca62360461c2a0c2183f2063d9ca6896393d8143d1d6be4","archivedRecordSha256":"60aacf070360b002410e32b09afc0f038f7654d4661c1c6ac8e98b22b35480a0","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_80f990dc05bce66c4514a233","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_80f990dc05bce66c4514a233","status":"accepted","fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738"},{"@id":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_9e727d5c9b9f0abf483312e8","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_9e727d5c9b9f0abf483312e8","status":"accepted","fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738"},{"@id":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_cf34ee6949726ded0ebccdec","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_cf34ee6949726ded0ebccdec","status":"accepted","fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738"},{"@id":"urn:doxa:passage:da1fdae00066dbace2a897da353e7dc7fc9b16defacb0348dcd40dfab61a302c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00002","start":125,"end":260,"exact":"Protests have been banned or cancelled, and authorities target individuals displaying Palestinian symbols, like the flag and keffiyeh. "},{"@id":"urn:doxa:passage:bba6c58f6e366391bdfcb32b8c1f1fac54819571d4be95dd29739ffb3381fba4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00002","start":260,"end":380,"exact":"Furthermore, legitimate resistance phrases like “Free Palestine” and “From the river to the sea” have been criminalized."},{"@id":"urn:doxa:passage:cfe49ed96a89790214462acc1f25bc7564c249f6e2203733f1af7347374cdd34","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00016","start":59,"end":163,"exact":"I was the only passenger stopped by the police for inspection because of my hijab and Arab Muslim looks."},{"@id":"urn:doxa:decision:bfa49d0ee605d68fadb00d5e554fb085","@type":["doxa:Decision","prov:Entity"],"recordId":"bfa49d0ee605d68fadb00d5e554fb085","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_80f990dc05bce66c4514a233","attribution":"reported_speaker","speaker":"Journalist/Interviewees","speakerStance":"opposes","documentStance":"neutral","proposition":"Targeting of individuals based on symbols and appearance","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports claims of authorities targeting individuals for displaying Palestinian symbols and a passenger being stopped by police due to hijab and Arab Muslim appearance.","modelPassage":["urn:doxa:passage:da1fdae00066dbace2a897da353e7dc7fc9b16defacb0348dcd40dfab61a302c","urn:doxa:passage:bba6c58f6e366391bdfcb32b8c1f1fac54819571d4be95dd29739ffb3381fba4","urn:doxa:passage:cfe49ed96a89790214462acc1f25bc7564c249f6e2203733f1af7347374cdd34"]},{"@id":"urn:doxa:passage:e44337b7df051927fc628382cca6d1259ef26fdf5cdc7b18dcc07b6823ee466a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00013","start":0,"end":151,"exact":"“It’s not fear that overwhelms me when I read the crazy headlines (labeling us as the new Islamists and advocating for deporting us), but sheer anger. "},{"@id":"urn:doxa:decision:3cfdc7171d5f3d310c40929bc3867d87","@type":["doxa:Decision","prov:Entity"],"recordId":"3cfdc7171d5f3d310c40929bc3867d87","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_80f990dc05bce66c4514a233","attribution":"quoted_speaker","speaker":"Rania","speakerStance":"neutral","documentStance":"neutral","proposition":"Media headlines label Palestinians as 'the new Islamists'.","hypothetical":false,"reviewStatus":"unreviewed","modelPassage":["urn:doxa:passage:e44337b7df051927fc628382cca6d1259ef26fdf5cdc7b18dcc07b6823ee466a"]},{"@id":"urn:doxa:decision:20c6636e03eae512bd7a77bd5db5f2ce","@type":["doxa:Decision","prov:Entity"],"recordId":"20c6636e03eae512bd7a77bd5db5f2ce","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_80f990dc05bce66c4514a233","attribution":"quoted_speaker","speaker":"Marwa","speakerStance":"neutral","documentStance":"neutral","proposition":"A passenger was stopped by police due to her hijab and Arab Muslim looks.","hypothetical":false,"reviewStatus":"unreviewed","modelPassage":["urn:doxa:passage:cfe49ed96a89790214462acc1f25bc7564c249f6e2203733f1af7347374cdd34"]},{"@id":"urn:doxa:decision:a4af8081d429353a7665c1ed357fe67c","@type":["doxa:Decision","prov:Entity"],"recordId":"a4af8081d429353a7665c1ed357fe67c","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_80f990dc05bce66c4514a233","attribution":"reported_speaker","speaker":"Journalist/Interviewees","speakerStance":"opposes","documentStance":"neutral","proposition":"Suppression of Palestinian identity and expression","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports on the criminalization of specific phrases and the banning of protests, which interviewees link to the suppression of Palestinian identity.","modelPassage":["urn:doxa:passage:da1fdae00066dbace2a897da353e7dc7fc9b16defacb0348dcd40dfab61a302c","urn:doxa:passage:bba6c58f6e366391bdfcb32b8c1f1fac54819571d4be95dd29739ffb3381fba4"]},{"@id":"urn:doxa:passage:acf45ad1ebb492cc7b5be608ac10b5ed78dc1bf54e78bec98de70ed86b8d1086","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00001","start":0,"end":101,"exact":"In Berlin, Arabs are reaching out to one another, extending private sanctuaries to grieve over Gaza. "},{"@id":"urn:doxa:passage:4eded95b1dede445fa4446ec4ea32c59e547f5f8ba219626546b1049434a61fe","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00001","start":101,"end":218,"exact":"While the stifling of pro-Palestinian sentiments isn’t new, recent crackdowns in Germany have struck a deeper chord. "},{"@id":"urn:doxa:passage:d9f87891e3b78be130ff3e7431013f1f926360384c069ca0195f806da81059f9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00001","start":218,"end":319,"exact":"Israel's latest war on Gaza has killed at least 28,663 Palestinians and wounded 67,984 others so far."},{"@id":"urn:doxa:passage:f279c89dbf56b8983a476b2eca98e912c513249535c1091e102993b366e70e0e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00002","start":0,"end":125,"exact":"Since October 7, Germany has intensified its crackdown on Palestinian identity and solidarity, stifling peaceful expression. "},{"@id":"urn:doxa:passage:cb694875a4113b4d82c4cdb19acff30a52c559300f699628672cb91a295237f7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00003","start":0,"end":152,"exact":"Global Voices interviewed six Arabs in Berlin who expressed concerns about the crackdown on dissent and the erasure of Palestinian identity in Germany. "},{"@id":"urn:doxa:passage:763a12351cafc7972db772702f5cdc47f320a4ebdbc757eabb663e7c6b899ff6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00003","start":152,"end":222,"exact":"For safety, their identities are undisclosed, and pseudonyms are used."},{"@id":"urn:doxa:passage:d827f758ba2cc6da6b5a76099b20452414736516c7a200194ab8d13f25f4cdd7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00004","start":0,"end":34,"exact":"An overwhelming sense of fragility"},{"@id":"urn:doxa:passage:f0548a32435256eb421b9f313cb1055baa01400ac9d6d68cd18575d367b84857","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00005","start":0,"end":176,"exact":"Fouad, a 30-year-old graphic designer and Iraqi refugee living in Germany for a decade, expressed disappointment with Berlin's lack of commitment to peace and freedom, stating:"},{"@id":"urn:doxa:passage:a9226cf915732790ca4da94a0f7097cf1e17ba99b020335109119e6bb20bbde3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00006","start":0,"end":134,"exact":"“Though the crackdown isn’t new, this is the first time I’ve truly felt like a refugee in Berlin, which I used to see as a sanctuary. "},{"@id":"urn:doxa:passage:8f4bd4dd90f092905e9b3f51350c98496fa50adafc95744566a50971736948a0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00006","start":134,"end":219,"exact":"Germany is once again failing to stand on the side that calls for peace and freedom. "},{"@id":"urn:doxa:passage:1be811e94555d14dfc2aca4c1b142feaf0ace593cdbdf51730eba556a0f4a914","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00006","start":219,"end":266,"exact":"It pains me that my tax money aids oppression. "},{"@id":"urn:doxa:passage:01a8d7b469aa77dc23d1bb2baa90ca31a99d6cf3f7a1e00790cd8bfd144152c9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00006","start":266,"end":305,"exact":"There is a negative energy everywhere. "},{"@id":"urn:doxa:passage:8fce2908d47c66e612b1b7a27c89467976c5ffcac99a1dfdc7c0265920a87b00","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00006","start":305,"end":364,"exact":"I feel watched, and I'm on high alert — I don't feel safe.”"},{"@id":"urn:doxa:passage:d63f412d16d4678b2a09435e5a74a7933a6cfa4759c70004ca3adb448813df9e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00007","start":0,"end":20,"exact":"Fouad is not alone. "},{"@id":"urn:doxa:passage:abfb003d59f1f48b263fedb86f787a3de03b8c9ecf30ab47dd8195be1d0d123f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00007","start":20,"end":185,"exact":"Hanan, a 25-year-old Egyptian who moved to Germany as a teenager, is dismayed that her eight years in Germany have been marked by insincerity: “I felt safer before. "},{"@id":"urn:doxa:passage:e4e1a59d6e21f5bedee8e07b0d72c176db54d989545294767a01c868007d9469","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00007","start":185,"end":239,"exact":"I’m not afraid to confront racist comments or stares. "},{"@id":"urn:doxa:passage:03ef71f2cfd6c509939705d6cafbc6848878f37d73073ebaa77080ce4d15236d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00007","start":239,"end":359,"exact":"It's just that I used to feel safer in the company of genuine people who shared the same values and principles in life. "},{"@id":"urn:doxa:passage:dd71d5f047b4076c06e30d2f281ed6fce300ef43dc433a892e1a54d4eace4807","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00007","start":359,"end":387,"exact":"Now, everything feels fake.”"},{"@id":"urn:doxa:passage:831ac356affdf4550002773267549d06847eff084ec8bde90dc566d25b4b3853","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00008","start":0,"end":144,"exact":"Omniya, a 39-year-old, Egyptian-Polish woman born and raised in Germany, echoes their sentiments, feeling an ever-present risk of displacement. "},{"@id":"urn:doxa:passage:294f7e2bda0fc64ebdd420716472dc392485d307ab60196713a2f952e609b4d9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00008","start":144,"end":239,"exact":"She expresses a similar longing for safety: “When I was a kid, one of my parents was deported. "},{"@id":"urn:doxa:passage:0d84213a69e408d7e895e02ae500af9b8f367293a80266d00880bfeb55dd0870","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00008","start":239,"end":290,"exact":"Now, politicians are discussing mass deportations. "},{"@id":"urn:doxa:passage:b545f2084b6cdb4ba667be8f6ccb70208e35c3a97af44dfd1e63ddea9a83def1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00008","start":290,"end":419,"exact":"The right-wing party, AfD, is gaining power in parliament and garnering support, aiming to transform Germany into an ethno-state."},{"@id":"urn:doxa:passage:b2efe334592bd3cf3ca3efac285fafa49afa0198c8c8283234f2204b572e829f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00009","start":0,"end":130,"exact":"If AfD succeeds in implementing its agenda—along with other parties leaning in that direction— it could have severe consequences. "},{"@id":"urn:doxa:passage:518ed84a361b6b5c1af913524fb592620719bddc711c0a9086b9f3e1ef53931c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00009","start":130,"end":212,"exact":"I wouldn’t say I felt ‘safe’ before, but I felt ‘safer.’ Now, I feel very unsafe.”"},{"@id":"urn:doxa:passage:68a199154381aa01b5d15d680e3a2a38cfba41ee7e1290c5146cc0cdc3a9e611","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00010","start":0,"end":162,"exact":"Souad, a 36-year-old US-born Palestinian educator in Germany for over 10 years, shares feelings of confusion amidst the unpredictable regulations in the country. "},{"@id":"urn:doxa:passage:cc83e62236ba44ac7dfd2b4255f5ecd90b159231dde166f68e0c93cf315afe42","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00010","start":162,"end":178,"exact":"She pointed out:"},{"@id":"urn:doxa:passage:b6826e84d5231397fbae3501925871f39d24b231d0705373f57a1decac9893e6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00011","start":0,"end":88,"exact":"“Germany changes the rules by the day, yet they are not officially documented anywhere. "},{"@id":"urn:doxa:passage:8c87ef72cb0e0a0143219450b0861940e1b44f592560a0c8cc19a43151b84771","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00011","start":88,"end":116,"exact":"It is incredibly confusing. "},{"@id":"urn:doxa:passage:31a08683bbd10602671a760c16819373d8f247a1f7851c23dd076e0ccec98149","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00011","start":116,"end":203,"exact":"One day, saying “Free Palestine” is acceptable; the next, it's ‘verboten’ (forbidden). "},{"@id":"urn:doxa:passage:23baa4f9a997074e61f1e879c680f63887ce38b891fd63ae9951e35eb48c70b6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00011","start":203,"end":277,"exact":"Another day, discussing “genocide” is fine; then suddenly, it's verboten. "},{"@id":"urn:doxa:passage:2d58b723e480cda3a1ad31333a4f9a3e55b9108dbf59a3fd39af2abc8c346fdc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00011","start":277,"end":362,"exact":"We will find ways to express ourselves, but we need clarity on what’s on their list. "},{"@id":"urn:doxa:passage:1ce4fdecfe990c8a5f4615609ae35425689f3e5f9b3cec36ce7d3d2f0d6a4fb4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00011","start":362,"end":429,"exact":"Why play mind games with us when our people are being slaughtered?”"},{"@id":"urn:doxa:passage:6d1c1a87d0feace185fba5daf88c879126d1a57591d67a1262e4448666e77ad8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00012","start":0,"end":143,"exact":"Rania, a 40-year-old Palestinian-German humanitarian born and raised in Germany, questions the state of the political landscape in the country:"},{"@id":"urn:doxa:passage:45182366ae0c4c5b6188c120de545e9547cf127dd015be1c6b66c9b858eb18f1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00013","start":151,"end":247,"exact":"The same anger I feel when the government I voted for abstains from the UN ceasefire referendum."},{"@id":"urn:doxa:passage:5673dff2f39350e485924dab903e736d1404cda6b155f412befa1227790b34e5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00014","start":0,"end":142,"exact":"My true concern: Is there still a political party that individuals who identify as Black, Indigenous, and People of Colour (BIPOC) can trust?”"},{"@id":"urn:doxa:passage:dbe89c86b51b1d9868332bb475261a12f963ffaaf91984961c0c2fcf5aaa5880","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00015","start":0,"end":114,"exact":"Marwa, a 35-year-old Jordanian engineer on a three-month fellowship to Berlin, felt unsettled throughout her stay."},{"@id":"urn:doxa:passage:7c1447ebafe19f4454a318701d28deabf86e517033c636394797623d81aba4ff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00016","start":0,"end":59,"exact":"> “I felt unsafe in Berlin since I arrived at the airport. "},{"@id":"urn:doxa:decision:0bb68963f489840fcc0d5e5c35791513","@type":["doxa:Decision","prov:Entity"],"recordId":"0bb68963f489840fcc0d5e5c35791513","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_80f990dc05bce66c4514a233","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:acf45ad1ebb492cc7b5be608ac10b5ed78dc1bf54e78bec98de70ed86b8d1086","urn:doxa:passage:4eded95b1dede445fa4446ec4ea32c59e547f5f8ba219626546b1049434a61fe","urn:doxa:passage:d9f87891e3b78be130ff3e7431013f1f926360384c069ca0195f806da81059f9","urn:doxa:passage:f279c89dbf56b8983a476b2eca98e912c513249535c1091e102993b366e70e0e","urn:doxa:passage:da1fdae00066dbace2a897da353e7dc7fc9b16defacb0348dcd40dfab61a302c","urn:doxa:passage:bba6c58f6e366391bdfcb32b8c1f1fac54819571d4be95dd29739ffb3381fba4","urn:doxa:passage:cb694875a41