applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:adcf2e61ff230d5bd6292b1243f7aa0127e1550b71125446f1a780c9b20bdb68","urn:doxa:passage:7b05a097227ff8794b5a0342628ffed3adb22bd943364366d28455920ae63073","urn:doxa:passage:37c79e522e96878fb7565ad096402acaa7af5c46881112f6537db7f09c3b1b21","urn:doxa:passage:0207fbd5ae19e87b5b07587b599eae68eb1d177ca4bad9f65dfdf1de724ed2c1","urn:doxa:passage:5d8492cc7c8e764321d41ad30b4997e5e403ed320e3ce64dfcd83f1947e2aae5","urn:doxa:passage:d7805fc2203622963c4d69fe8a11e2ab52beade187ddab3ed88dda5e4d6c5f25","urn:doxa:passage:f9f1039622fdc695d4d6eda2f0d465bc626936eedc95b748cf2f780a6460ef52"]},{"@id":"urn:doxa:decision:eaef1cee8b571e20807d871b06d09c97","@type":["doxa:Decision","prov:Entity"],"recordId":"eaef1cee8b571e20807d871b06d09c97","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:a0cd64f061915a496a206780d881d51d:u_f78a8f78282653b9ebf6afb3","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:adcf2e61ff230d5bd6292b1243f7aa0127e1550b71125446f1a780c9b20bdb68","urn:doxa:passage:7b05a097227ff8794b5a0342628ffed3adb22bd943364366d28455920ae63073","urn:doxa:passage:37c79e522e96878fb7565ad096402acaa7af5c46881112f6537db7f09c3b1b21","urn:doxa:passage:0207fbd5ae19e87b5b07587b599eae68eb1d177ca4bad9f65dfdf1de724ed2c1","urn:doxa:passage:5d8492cc7c8e764321d41ad30b4997e5e403ed320e3ce64dfcd83f1947e2aae5","urn:doxa:passage:d7805fc2203622963c4d69fe8a11e2ab52beade187ddab3ed88dda5e4d6c5f25","urn:doxa:passage:f9f1039622fdc695d4d6eda2f0d465bc626936eedc95b748cf2f780a6460ef52"]},{"@id":"urn:doxa:decision:fe2d5df07321832f3b9aebf9afe690c3","@type":["doxa:Decision","prov:Entity"],"recordId":"fe2d5df07321832f3b9aebf9afe690c3","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:a0cd64f061915a496a206780d881d51d:u_f78a8f78282653b9ebf6afb3","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:adcf2e61ff230d5bd6292b1243f7aa0127e1550b71125446f1a780c9b20bdb68","urn:doxa:passage:7b05a097227ff8794b5a0342628ffed3adb22bd943364366d28455920ae63073","urn:doxa:passage:37c79e522e96878fb7565ad096402acaa7af5c46881112f6537db7f09c3b1b21","urn:doxa:passage:0207fbd5ae19e87b5b07587b599eae68eb1d177ca4bad9f65dfdf1de724ed2c1","urn:doxa:passage:5d8492cc7c8e764321d41ad30b4997e5e403ed320e3ce64dfcd83f1947e2aae5","urn:doxa:passage:d7805fc2203622963c4d69fe8a11e2ab52beade187ddab3ed88dda5e4d6c5f25","urn:doxa:passage:f9f1039622fdc695d4d6eda2f0d465bc626936eedc95b748cf2f780a6460ef52"]},{"@id":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-732098","title":"Transition in Tanzania: From President Magufuli to President Hassan","author":"Amanda Lichtenstein; Pernille Baerendtsen; Nwachukwu Egbunike","translator":[],"publishedOn":"2021-03-24","sourceUrl":"https://globalvoices.org/2021/03/24/transition-in-tanzania-from-president-magufuli-to-president-hassan/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"e0e1182d81e028fb6cc240c3109943bf6b2f9e9e360068fa371a8ba75048cebc","textSha256":"1592b739831d9cc4b12a36396a7fa12897a12f53dbab3bc581ab519f7265c7cb","archivedRecordSha256":"f59ba3f5eb3fc506556db02d467d69afa76b73719c94ba68bde925e767fabf6d","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:9b08fc21cf3e043f3ed8b5d147531e7a:u_72833c330a8cc85ccb1ae588","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_72833c330a8cc85ccb1ae588","status":"accepted","fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a"},{"@id":"urn:doxa:unit:9b08fc21cf3e043f3ed8b5d147531e7a:u_d63cb39e3b464580eb9655e4","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_d63cb39e3b464580eb9655e4","status":"accepted","fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a"},{"@id":"urn:doxa:passage:0e334f2051e87bb412f4e5e5eb36ea306449c147f7ca235cb9a62c6b7f0e10d7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00023","start":0,"end":194,"exact":"Magufuli’s administration often used legislation like Electronic and Postal Communication (Online Content) (EPOCA), or the Cybercrimes Act to clamp down on opposition voices and public dissent. "},{"@id":"urn:doxa:passage:69731d8bc8fda09b7ce4bc9a2c951e53d748ec93772f870a335e766ce7ee9bdc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00023","start":194,"end":450,"exact":"Amended regulations in 2020 prohibited citizens from sharing public information “that may cause public chaos or disorder” and “content with information about an outbreak of a deadly or contagious disease” without the government approval from top officials."},{"@id":"urn:doxa:passage:6c12b2051e06b39a2e07edbb7424ceb754f62e3e7b00d293cd47af572e15b2bf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00024","start":0,"end":143,"exact":"Citizens couldn’t speak about an earthquake that shook the coastal region last year, let alone the pandemic that reached Tanzania months later."},{"@id":"urn:doxa:passage:ab474ba1f30717495dfeca19455c98eefa203649aba996a39b2f49a6d4d9c42a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00025","start":0,"end":197,"exact":"And during the two-week period of wild speculation about Magufuli’s whereabouts and health status in early March, at least four people were reportedly arrested for tweeting about the ill president."},{"@id":"urn:doxa:passage:df18cd92aaf113e58e26f75c6d7e4d6057009ea208ee923382126edac3e7205b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00026","start":0,"end":30,"exact":"‘Did he die of COVID-19, tho?’"},{"@id":"urn:doxa:passage:85f41e6d958bd54621c469c155018df3d51854e4c4dd9c433de74a06fe7b549f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00027","start":0,"end":115,"exact":"Magufuli reportedly died of heart complications — an issue for which he had been receiving treatment for 10 years. "},{"@id":"urn:doxa:passage:6c94c0696391feec98d9cb9fd5165882ecb5baac3366bba01bb61321c243024f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00027","start":115,"end":203,"exact":"But Magufuli’s sudden death left many wondering if he had perhaps succumbed to COVID-19."},{"@id":"urn:doxa:passage:5ab081d9ec006691fe2bda546e7d0273fdf9ada8daeabd0eceb26ae3d982f6d6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00028","start":0,"end":97,"exact":"To many — not the least, Western audiences — Magufuli will be remembered for his COVID-19 denial."},{"@id":"urn:doxa:passage:243fab0c901e535031595a146f11b25591676e1629a09923f033be4e0e20473b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00029","start":0,"end":185,"exact":"Tanzania did initially impose restrictions and guidelines to curb the spread of the virus, but Magufuli repeatedly denounced lockdowns as a greater threat to the economy than the virus."},{"@id":"urn:doxa:passage:2815c57b7c072153667cd0385a28ead2e23842fc32078e0d6569f0fb230e4c0c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00030","start":0,"end":181,"exact":"He actively rebuked international guidance on public health protocols like wearing masks, social distancing and vaccines — urging citizens to use prayer and herbal remedies instead."},{"@id":"urn:doxa:passage:b06c40ea63e634da61322d80823389fc52319727e9051615584db4a7632529d0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00031","start":0,"end":132,"exact":"After Magufuli halted the publication of COVID-19 data last year in April, he then insisted COVID-19 had been fended off by prayer. "},{"@id":"urn:doxa:passage:0a46963d28f3527243ad7535942b5e7ee67574ed1383633f7046add34a8a9147","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00031","start":132,"end":181,"exact":"Soon after, he declared Tanzania “COVID-19 free.”"},{"@id":"urn:doxa:passage:ef2103a0e402c115967cad0a5dfbfb33bee96ce7ce6a48ddc28cf73a2f0c446a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00032","start":0,"end":94,"exact":"Though it is impossible to say exactly how COVID-19 has affected Tanzania, it did not go away."},{"@id":"urn:doxa:passage:8012c68cbea75d61a970b6ecbbe42e12db89f63abc8ca70b49074771bf43aa38","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00033","start":0,"end":143,"exact":"When a new COVID-19 wave reemerged in January, many Tanzanians shared testimonies on social media of becoming ill with COVID-19-like symptoms. "},{"@id":"urn:doxa:passage:6500e84d8244b9a4e29b61785b5a7594ad140e8d86a98fba30290a993af28321","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00033","start":143,"end":274,"exact":"Knowing that it could be punishable to discuss COVID-19, people wrote nimonia mpya or “the new pneumonia” and “breathing problems.”"},{"@id":"urn:doxa:passage:71a6d6ec049b8c196a1127ad3bcd0932538cc4087eb602039a40abb446dd7100","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00034","start":0,"end":109,"exact":"But Magufuli doubled down with his anti-vaccination stance in a speech from his home in Chato, on January 27:"},{"@id":"urn:doxa:passage:38e7a6be6319b78d19957a90cdfafd8aa4ecbcb81f23cd149b70d2deadbb2407","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00035","start":0,"end":279,"exact":"> If the white man was able to come up with vaccinations, he should now have found a vaccination against AIDS; he would now have found a vaccination against tuberculosis; he would now have found a vaccination against malaria; he would now have found a vaccination against cancer."},{"@id":"urn:doxa:passage:1a052fc2ed62f32fb234c3d951296b2f1cd244327c1608573e95220cf5e516c7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00036","start":0,"end":145,"exact":"This was a major departure from Magufuli's predecessor, President Jakaya Kikwete, who served as global ambassador for immunization in early 2016."},{"@id":"urn:doxa:passage:48a963ad89759662121908bdb53a8dca3e62cd3b2e5a84a3c69e58cba265b7ec","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00037","start":0,"end":134,"exact":"Last month, Magufuli finally did admit that his country had a coronavirus problem, urging Tanzanians to wear locally made face masks. "},{"@id":"urn:doxa:passage:f441f40e64cbf9d262aff42793f610950fe49e488761c7df8694139cc44ac236","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00037","start":134,"end":246,"exact":"It took the death of Zanzibar’s Vice President Seif Sharif Hamad, apparently, to break Magufuli’s intransigence."},{"@id":"urn:doxa:passage:bb3668c362727139f774244be446af903caceb548a5cf609da2ca7fc59fc4306","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00038","start":0,"end":108,"exact":"Several high-ranking officials from the political elite and close to Magufuli have also died of the disease."},{"@id":"urn:doxa:passage:ffb7bae9276e9c76de8290ada42a3196ae11e20839600be06498a44ca04c2a10","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00039","start":0,"end":124,"exact":"As throngs of people continue to gather to pay their respects to the late president, his death has also brought some relief."},{"@id":"urn:doxa:passage:7e49b26a8b98c81e04506a65f4dcc4dc27d7ce19e41d6cbac2eb2cd2522cc4e5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00040","start":0,"end":229,"exact":"Shortly after Magufuli’s death, writer Elsie Eyakuze came forward on social media to speak openly about what it was like to live through the pandemic in Tanzania, with a president who showed willful disregard for the coronavirus."},{"@id":"urn:doxa:passage:7e77ec159385d44e68be270b25dd999ba3ab8692e337f139f8cd863531ab8dcc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00041","start":0,"end":36,"exact":"In a long Twitter thread, she wrote:"},{"@id":"urn:doxa:passage:3935b75eff375327228c38eecb5b888e9d6658b6ab395a24a5ce4d2a0dba96b0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00042","start":0,"end":36,"exact":"In one of her last tweets, she asks:"},{"@id":"urn:doxa:passage:4281d923e8c1067c15caa9b959635db4825c7b29d29db14baa0ecd6ea939d121","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00043","start":0,"end":179,"exact":"In an open letter to Magufuli, Eyakuze points out the inconsistency of Magufuli's ideas, but also applies the empathy Magufuli himself seemed to lack, at times — and forgives him."},{"@id":"urn:doxa:passage:f82a163056ede100cbcccca4d8ec619f5435ed17b0598980e634443498d4f437","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00044","start":0,"end":146,"exact":"Tanzanians are coming to terms with the complexity and gravity of Magufuli’s death and the legacy he left behind — with a close eye on the future."},{"@id":"urn:doxa:decision:035f590f76baa87a5f89acabb484470b","@type":["doxa:Decision","prov:Entity"],"recordId":"035f590f76baa87a5f89acabb484470b","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:9b08fc21cf3e043f3ed8b5d147531e7a:u_72833c330a8cc85ccb1ae588","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:0e334f2051e87bb412f4e5e5eb36ea306449c147f7ca235cb9a62c6b7f0e10d7","urn:doxa:passage:69731d8bc8fda09b7ce4bc9a2c951e53d748ec93772f870a335e766ce7ee9bdc","urn:doxa:passage:6c12b2051e06b39a2e07edbb7424ceb754f62e3e7b00d293cd47af572e15b2bf","urn:doxa:pa