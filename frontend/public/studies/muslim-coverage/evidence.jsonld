f7a63dc8e1e0463f7039ad277c2caa5f8436e1ad","urn:doxa:passage:77fc39d700881e2f5c4f19376b414e08a1b2be25eba5b7c2b29834219ce86e2e","urn:doxa:passage:5f162b1cecb62f3cefef7a4d29cc29f0624fa1e344826836fad96dfd43636426","urn:doxa:passage:730cd9724d4785f010c89018bc5abfbcc312ea68de11417eeaf618ae235a1f22"]},{"@id":"urn:doxa:source:279df248e33224115839169ef653ffa0","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-822021","title":"Miya Muslims of Assam, India, face eviction, threats, and oppression","author":"GV South Asia","translator":[],"publishedOn":"2024-10-13","sourceUrl":"https://globalvoices.org/2024/10/13/miya-muslims-of-assam-india-face-eviction-threats-and-oppression/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"be7a455544d4a40c085dc4a36ca15a6e17d1be38a2648fe14da8a01c6babe9f7","textSha256":"656c0b3631fd40a64e6a9eac713e9ffb9918a1882f2cc79c0a87afd2e5255c1f","archivedRecordSha256":"213c6ae7b9ff5032bafd68ad409edb92d30feff348eaf6d433124c24c3efad2e","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:279df248e33224115839169ef653ffa0:u_4b23534141cf9a20813f0096","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_4b23534141cf9a20813f0096","status":"accepted","fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0"},{"@id":"urn:doxa:unit:279df248e33224115839169ef653ffa0:u_60bb50afc26364b0fd5ad93a","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_60bb50afc26364b0fd5ad93a","status":"accepted","fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0"},{"@id":"urn:doxa:passage:4755ed7eb3365ebf35264e97da1217f9e94c426e03ce892997d125edfacae140","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00015","start":97,"end":220,"exact":"In the Charaideo district of Upper Assam, a local BJP leader has forced several Miya labourers working under him to leave. "},{"@id":"urn:doxa:passage:afac761bb6e2565812ed520530a694756f8aa997763c9cfc47c710f4b06211b8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00016","start":0,"end":173,"exact":"Similarly, in Nagaon, the Veer Lachit Sena, a controversial ultra-nationalist Assamese organisation, has prevented Bengali-Muslim fishermen from selling fish in the market. "},{"@id":"urn:doxa:passage:379c0d473d27cc47addaf6f0104dc4eb0de4cf78e084ce9f83c5f5daf86d30f9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00019","start":0,"end":166,"exact":"As Assam prepares for its next state general election in 2026, the right-wing government led by Himanta Biswa Sarma has intensified its targeting of Bengali Muslims. "},{"@id":"urn:doxa:decision:a0b7af3921899e528eeeeb71737502f4","@type":["doxa:Decision","prov:Entity"],"recordId":"a0b7af3921899e528eeeeb71737502f4","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:279df248e33224115839169ef653ffa0:u_4b23534141cf9a20813f0096","attribution":"reported_speaker","speaker":"The document (reporting on local leaders and government actions)","speakerStance":"unclear","documentStance":"neutral","proposition":"Bengali-Muslim fishermen are prevented from selling fish and certain groups are targeted for intensified eviction.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text describes instances of unequal treatment, such as being prevented from selling goods and targeted eviction drives. ","modelPassage":["urn:doxa:passage:4755ed7eb3365ebf35264e97da1217f9e94c426e03ce892997d125edfacae140","urn:doxa:passage:afac761bb6e2565812ed520530a694756f8aa997763c9cfc47c710f4b06211b8","urn:doxa:passage:379c0d473d27cc47addaf6f0104dc4eb0de4cf78e084ce9f83c5f5daf86d30f9"]},{"@id":"urn:doxa:passage:43ef031e2d30a7796fc1f3d8be29bee935264dc049c5a6da98ac0199d4b6431f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00016","start":173,"end":279,"exact":"The group was engaged in spreading hate speech and issuing threats against Bengali Muslims in upper Assam."},{"@id":"urn:doxa:decision:0eaef2391eab4df48fef95d39856b781","@type":["doxa:Decision","prov:Entity"],"recordId":"0eaef2391eab4df48fef95d39856b781","outcome":"uncertain","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:279df248e33224115839169ef653ffa0:u_4b23534141cf9a20813f0096","attribution":"reported_speaker","speaker":"Veer Lachit Sena","speakerStance":"unclear","documentStance":"neutral","proposition":"Groups are spreading hate speech against Bengali Muslims.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"While hate speech and threats are reported, the specific intent to encourage hatred via stereotyping is not explicitly detailed in the text. ","modelPassage":["urn:doxa:passage:43ef031e2d30a7796fc1f3d8be29bee935264dc049c5a6da98ac0199d4b6431f"]},{"@id":"urn:doxa:passage:6d17b059009cd2a817290ebacd0c690192a29a384ddce065512a2e0e1bb6ed5b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00012","start":261,"end":400,"exact":"According to social media posts, these organizations and groups are seeking out Bengali Muslim laborers and warning them to leave the area."},{"@id":"urn:doxa:passage:a8afb0af937ae759922b5d8f576b519e60c6e1f9cbc2f81639f5ca1229631d87","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00015","start":0,"end":97,"exact":"The outrage has escalated into physical attacks, with a group of Miya labourers being assaulted. "},{"@id":"urn:doxa:decision:70b05e8e90b2c94c24a45abd1159e804","@type":["doxa:Decision","prov:Entity"],"recordId":"70b05e8e90b2c94c24a45abd1159e804","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:279df248e33224115839169ef653ffa0:u_4b23534141cf9a20813f0096","attribution":"reported_speaker","speaker":"The document (reporting on social media, leaders, and organizations)","speakerStance":"unclear","documentStance":"neutral","proposition":"Groups are issuing threats and conducting physical attacks against Bengali Muslims.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports on physical attacks, threats, and groups preventing Bengali-Muslims from conducting business or warning them to leave. ","modelPassage":["urn:doxa:passage:6d17b059009cd2a817290ebacd0c690192a29a384ddce065512a2e0e1bb6ed5b","urn:doxa:passage:a8afb0af937ae759922b5d8f576b519e60c6e1f9cbc2f81639f5ca1229631d87","urn:doxa:passage:afac761bb6e2565812ed520530a694756f8aa997763c9cfc47c710f4b06211b8","urn:doxa:passage:43ef031e2d30a7796fc1f3d8be29bee935264dc049c5a6da98ac0199d4b6431f"]},{"@id":"urn:doxa:decision:25401aa5407e8b20987153edb9f3bff3","@type":["doxa:Decision","prov:Entity"],"recordId":"25401aa5407e8b20987153edb9f3bff3","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:279df248e33224115839169ef653ffa0:u_4b23534141cf9a20813f0096","attribution":"reported_speaker","speaker":"Veer Lachit Sena","speakerStance":"opposes","documentStance":"neutral","proposition":"Bengali-Muslim fishermen are prevented from selling fish in the market.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"An organization is reported to have prevented Bengali-Muslim fishermen from participating in market activities. ","modelPassage":["urn:doxa:passage:afac761bb6e2565812ed520530a694756f8aa997763c9cfc47c710f4b06211b8"]},{"@id":"urn:doxa:passage:b5a8c5b489f9867a3920f7175804098fbb851b788d5cffbbe939d1e1b8385b38","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00017","start":0,"end":205,"exact":"On September 9, an eviction drive turned violent, leading to clashes between police and local residents, in Kosutoli village, Kamrup district, where the population is predominantly Bengali-origin Muslims. "},{"@id":"urn:doxa:passage:904ea58eb68749c86547f8e6485320ce78c37ff9bbba1d707b7a4589963c3996","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00018","start":0,"end":114,"exact":"Similar eviction drives were conducted in the reserve forest of Goalpara district, displacing around 450 families."},{"@id":"urn:doxa:decision:066d29b166352688a9e0b59f5dc63f1d","@type":["doxa:Decision","prov:Entity"],"recordId":"066d29b166352688a9e0b59f5dc63f1d","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:279df248e33224115839169ef653ffa0:u_4b23534141cf9a20813f0096","attribution":"author","speaker":"GV South Asia","speakerStance":"neutral","documentStance":"neutral","proposition":"The government is conducting targeted eviction drives against Bengali Muslims.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The article describes multiple instances of eviction drives and intensified targeting of Bengali Muslims by the government. ","modelPassage":["urn:doxa:passage:b5a8c5b489f9867a3920f7175804098fbb851b788d5cffbbe939d1e1b8385b38","urn:doxa:passage:904ea58eb68749c86547f8e6485320ce78c37ff9bbba1d707b7a4589963c3996","urn:doxa:passage:379c0d473d27cc47addaf6f0104dc4eb0de4cf78e084ce9f83c5f5daf86d30f9"]},{"@id":"urn:doxa:passage:2dd2d75fd0beb668ac300d34f3497a7e21fb32bf69e022ef76350f4af2c32875","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00013","start":107,"end":324,"exact":"Sarma went so far as to state that the Bengali Muslim labourers shouldn’t go to Upper Assam without the consent of the local Assamese population, further revealing his bias by siding openly with the Indigenous groups."},{"@id":"urn:doxa:decision:ee54321cff3b84438052bdb36aa6292a","@type":["doxa:Decision","prov:Entity"],"recordId":"ee54321cff3b84438052bdb36aa6292a","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:279df248e33224115839169ef653ffa0:u_4b23534141cf9a20813f0096","attribution":"reported_speaker","speaker":"Himanta Biswa Sarma","speakerStance":"opposes","documentStance":"neutral","proposition":"Bengali Muslim laborers should not enter Upper Assam without local consent.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports on political statements that differentiate Bengali Muslim laborers from the 'local Assamese population' based on origin and identity. ","modelPassage":["urn:doxa:passage:2dd2d75fd0beb668ac300d34f3497a7e21fb32bf69e022ef76350f4af2c32875"]},{"@id":"urn:doxa:passage:8deb8e0da96e65d89b9a2872a1f723057db8276f6f141b991c61a17e42803b0f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00001","start":248,"end":485,"exact":"While such evictions are not isolated to Assam, the incident sparked allegations of government bias, with accusations that the government is specifically targeting Bengali Muslims and leveraging tensions in the region to drive them away."},{"@id":"urn:doxa:passage:66d8dc05869751907154d2952643dd0de3a0a58044c8f95d2767d5325695ab43","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00012","start":100,"end":261,"exact":"In the Sivsagar district, around 30 Indigenous organisations (Assamese nationalists) have issued a seven-day ultimatum for Bengali Muslims to leave Upper Assam. "},{"@id":"urn:doxa:decision:cacabf79d6f0ee9a3ff0b3f733e98e0a","@type":["doxa:Decision","prov:Entity"],"recordId":"cacabf79d6f0ee9a3ff0b3f733e98e0a","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:279df248e33224115839169ef653ffa0:u_60bb50afc26364b0fd5ad93a","attribution":"reported_speaker","speaker":"unspecified (allegations/accusations)","speakerStance":"opposes","documentStance":"neutral","proposition":"The government is specifically targeting Bengali Muslims and leveraging regional tensions to drive them away.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports allegations of government bias targeting Bengali Muslims and ultimatums for them to leave specific regions.","modelPassage":["urn:doxa:passage:8deb8e0da96e65d89b9a2872a1f723057db8276f6f141b991c61a17e42803b0f","urn:doxa:passage:66d8dc05869751907154d2952643dd0de3a0a58044c8f95d2767d5325695ab43"]},{"@id":"urn:doxa:passage:c69b55074b7b3d6ee05dda433c789783048a56082064c23f7d129e18f854714b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00004","start":213,"end":318,"exact":"Because of this, the term “Miya” is now used in a derogatory way, referring to undocumented Bangladeshis."},{"@id":"urn:doxa:passage:2bc850597a6b4916dddedb0454da852d357d46fe49f05162a4792abd0ef97b84","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00008","start":0,"end":190,"exact":"In August 2024, Sarma accused the University of Science and Technology, Meghalaya, a Muslim-run institution, of engaging in “flood jihad,” blaming it for the outbreak of floods in Guwahati. "},{"@id":"urn:doxa:decision:9b5d00f7d4cc48e8b110183dec29bc74","@type":["doxa:Decision","prov:Entity"],"recordId":"9b5d00f7d4cc48e8b110183dec29bc74","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:279df248e33224115839169ef653ffa0:u_60bb50afc26364b0fd5ad93a","attribution":"reported_speaker","speaker":"Indigenous organizations / Sarma","speakerStance":"opposes","documentStance":"neutral","proposition":"The Miya community is associated with illegal immigration and religious warfare.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports how the term 'Miya' is used derogatorily and how officials use 'jihad' labels to stereotype community activities.","modelPassage":["urn:doxa:passage:c69b55074b7b3d6ee05dda433c789783048a56082064c23f7d129e18f854714b","urn:doxa:passage:2bc850597a6b4916dddedb0454da852d357d46fe49f05162a4792abd0ef97b84"]},{"@id":"urn:doxa:passage:6bf39d5c14810faa35e129e2110120f44a91c9373e72bef6d925cec93d724994","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00007","start":0,"end":157,"exact":"The Quint, an independent digital news platform in India, recorded Sarma spreading hate speech targeting Bengali-speaking Muslims 18 times in a single year. "},{"@id":"urn:doxa:passage:032e33441724e7539bbf399447bb85096dd3487a19eedf7461312472283e3a8c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00011","start":278,"end":432,"exact":"The many Indigenous groups and right-wing political parties, including the BJP, have used the rape case to target Bengali-speaking Muslims in upper Assam."},{"@id":"urn:doxa:decision:d1d93bbf1d73a850f32e0f8e39d618cc","@type":["doxa:Decision","prov:Entity"],"recordId":"d1d93bbf1d73a850f32e0f8e39d618cc","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:279df248e33224115839169ef653ffa0:u_60bb50afc26364b0fd5ad93a","attribution":"reported_speaker","speaker":"The Quint / Indigenous groups","speakerStance":"opposes","documentStance":"neutral","proposition":"Bengali-speaking Muslims are targets of hate speech and political pressure.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The article reports on documented hate speech and political targeting of Bengali-speaking Muslims by government officials and groups.","modelPassage":["urn:doxa:passage:6bf39d5c14810faa35e129e2110120f44a91c9373e72bef6d925cec93d724994","urn:doxa:passage:032e33441724e7539bbf399447bb85096dd3487a19eedf7461312472283e3a8c"]},{"@id":"urn:doxa:decision:236c612afdc7c2fb03e85146cb14d602","@type":["doxa:Decision","prov:Entity"],"recordId":"236c612afdc7c2fb03e85146cb14d602","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:279df248e33224115839169ef653ffa0:u_60bb50afc26364b0fd5ad93a","attribution":"reported_speaker","speaker":"Indigenous organisations (Assamese nationalists)","speakerStance":"opposes","documentStance":"neutral","proposition":"Bengali Muslims must leave Upper Assam.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports on Indigenous organizations issuing ultimatums for Bengali Muslims to leave Upper Assam.","modelPassage":["urn:doxa:passage:66d8dc05869751907154d2952643dd0de3a0a58044c8f95d2767d5325695ab43","urn:doxa:passage:6d17b059009cd2a817290ebacd0c690192a29a384ddce065512a2e0e1bb6ed5b"]},{"@id":"urn:doxa:passage:3440e934ac2752e9bd90c5654b218f2ac4c2990397762f879515e5daaa86cba7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00006","start":0,"end":199,"exact":"Anti-Muslim rhetoric has a long history in Assam, but this sentiment has been further fueled by the Bharatiya Janata Party (BJP)-led right-wing government and its chief minister Himanta Biswa Sarma. "},{"@id":"urn:doxa:decision:edabbb9fc73b108e1fa5cd6e19666d4c","@type":["doxa:Decision","prov:Entity"],"recordId":"edabbb9fc73b108e1fa5cd6e19666d4c","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:279df248e33224115839169ef653ffa0:u_60bb50afc26364b0fd5ad93a","attribution":"reported_speaker","speaker":"The Quint (reporting on Sarma's speech)","speakerStance":"supports","documentStance":"neutral","proposition":"The BJP-led government and chief minister fuel anti-Muslim sentiment through repeated hate speech and rhetoric.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports a pattern of anti-Muslim rhetoric fueled by the state government, citing specific instances of recorded hate speech by the chief minister targeting Bengali-speaking Muslims.","modelPassage":["urn:doxa:passage:6bf39d5c14810faa35e129e2110120f44a91c9373e72bef6d925cec93d724994","urn:doxa:passage:3440e934ac2752e9bd90c5654b218f2ac4c2990397762f879515e5daaa86cba7"]},{"@id":"urn:doxa:passage:cbd7b37b73da123126325d35e1c71a67d7d8bd7ca4dba3b7b952f69761e5f89e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:279df248e33224115839169ef653ffa0","blockId":"gv-822021-b00004","start":0,"end":213,"exact":"However, many Indigenous organisations and political groups claim that there has been an influx of Bangladeshi citizens illegally immigrating to Assam, and they often associate the Miya community with this group. "},{"@id":"urn:doxa:decision:a82c38fea13eb6dbc090758da28abbc1","@type":["doxa:Decision","prov:Entity"],"recordId":"a82c38fea13eb6dbc090758da28abbc1","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:279df248e33224115839169ef653ffa0:u_60bb50afc26364b0fd5ad93a","attribution":"reported_speaker","speaker":"Indigenous organisations and political groups","speakerStance":"opposes","documentStance":"neutral","proposition":"The Miya community is associated with illegal Bangladeshi immigration.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text describes how the Miya identity is associated with illegal immigration and used as a derogatory term for undocumented persons.","modelPassage":["urn:doxa:passage:cbd7b37b73da123126325d35e1c71a67d7d8bd7ca4dba3b7b952f69761e5f89e","urn:doxa:passage:c69b55074b7b3d6ee05dda433c789783048a56082064c23f7d129e18f854714b"]},{"@id":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-824529","title":"The great Pakistan firewall and use of religion as a tool for digital authoritarianism","author":"Ramna Saeed","translator":[],"publishedOn":"2024-11-22","sourceUrl":"https://globalvoices.org/2024/11/22/the-great-pakistan-firewall-and-use-of-religion-as-a-tool-for-digital-authoritarianism/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"d712694e530ee374f676b05ef01fd77444b7f7bb0a12c93e2c0fe0a45abd7a42","textSha256":"4f45034cf1d4b70364dc84b933bf3405a3c30825de026d9e8377b9b3822090c0","archivedRecordSha256":"146ca1269d66e9167c31e9e0ce220aa0cbef59057abf6e733f36479d78969685","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:64e8a641c2650d36f5dfc500d8041324:u_32d7b9478504f438b6027f9b","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_32d7b9478504f438b6027f9b","status":"accepted","fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324"},{"@id":"urn:doxa:unit:64e8a641c2650d36f5dfc500d8041324:u_62b412c1fec2818dd4e0a2e9","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_62b412c1fec2818dd4e0a2e9","status":"accepted","fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324"},{"@id":"urn:doxa:unit:64e8a641c2650d36f5dfc500d8041324:u_aca514d25f1b6bd3385d8592","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_aca514d25f1b6bd3385d8592","status":"accepted","fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324"},{"@id":"urn:doxa:passage:5a1899dcefe464cb3f2134494087460790b314739e5c8e92ae4d3bb817c999ef","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00001","start":0,"end":248,"exact":"Pakistan has once again demonstrated authoritarian tendencies by announcing the blocking of “illegal Virtual Private Networks (VPNs),” citing their alleged use in facilitating terrorist activities and accessing blasphemous or pornographic content. "},{"@id":"urn:doxa:passage:a92703ec2525a2070727526a220361f37d2f9aa725df5eec472a255266e7a120","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00001","start":248,"end":446,"exact":"As per the reinforced VPN regulation strategy, users must submit an application detailing the legal purpose of their VPN use to the Pakistan Telecommunication Authority (PTA) and wait for approval. "},{"@id":"urn:doxa:passage:94c363b4b65a8ab13c293b20d8e2c8110d9d83a91ad56f2965621cab10a20756","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00001","start":446,"end":564,"exact":"The PTA has set a deadline of November 30 to register VPNs, warning of a nationwide crackdown starting on December 1. "},{"@id":"urn:doxa:passage:95e5cfa30df3719efb876c4117ff8e478663c9ea794fcfccbf7718c9a176770a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00001","start":564,"end":757,"exact":"To facilitate this process, PTA has launched an online portal to whitelist IP addresses and register VPNs, aimed at supporting software houses, call centers, banks, embassies, and freelancers. "},{"@id":"urn:doxa:passage:3649c1b5025c273efb485edd2e7f625bcb893cb784f3b9b8d870abc9cd76f953","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00001","start":757,"end":812,"exact":"The PTA first introduced VPN registration in July 2020."},{"@id":"urn:doxa:passage:7a607605c2d2a3ca1d3c4eaa993c9f2043617cd5264a5f5be88f8946437581e3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00002","start":0,"end":263,"exact":"As citizens were already grappling with the news of the impending VPN ban, reports have begun surfacing about the blocking of Bluesky, an open source social media platform gaining popularity in Pakistan following the ban on X (formerly Twitter) earlier this year."},{"@id":"urn:doxa:passage:d498c7258772b80a934ef1600661d90cbe6b88b124324dc14351000018b47bfb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00003","start":0,"end":49,"exact":"Digital rights activist Usama Khilji posted on X:"},{"@id":"urn:doxa:passage:f18c69f35f30970a0630d89bd13fa6d2a98c6138df3cafe8fdb5eb6348bbafcb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00004","start":0,"end":111,"exact":"Since February 2024, using VPNs has become common practice following the ban on X after the general elections. "},{"@id":"urn:doxa:passage:438ffe66e1b6783c7904356afcc7adb8748b495d5f39bd2cae61149cbc488d07","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00004","start":111,"end":218,"exact":"Ironically, government representatives have continued using the platform despite imposing the restriction. "},{"@id":"urn:doxa:passage:6d5df09cf7b86f743231e1d03db0d3aeb38ec954c9f3b2bb4d2b2aae533e800e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00004","start":218,"end":338,"exact":"Internet users have consistently complained about deteriorating internet quality since this government came into power. "},{"@id":"urn:doxa:passage:5779a80e279a7c2fc755bf8875e58a513f3445c3a2a2fed9101bbfbb119ebf9e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00004","start":338,"end":521,"exact":"On November 10, users across multiple platforms, including X, voiced concerns about VPN throttling and slow internet access, amplifying frustrations about restricted digital freedoms."},{"@id":"urn:doxa:passage:172fd4eaca0743cfd9460c261aae4835f0fc2159b899573bfd6ece98fe517db7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00005","start":0,"end":32,"exact":"Blogger Hina Safdar posted on X:"},{"@id":"urn:doxa:passage:9090dde32c1a502420de9cca2471cebfcdfd282f6565025a00642c7257c6915d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00006","start":0,"end":22,"exact":"PTA justifying the ban"},{"@id":"urn:doxa:passage:714059090987a80ba5221487abfe6c366317a68be2939323b6392b20e50b583d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00007","start":0,"end":103,"exact":"Initially, the PTA denied accusations of VPN throttling, dismissing slow speeds as a technical glitch. "},{"@id":"urn:doxa:passage:9a2886c05c4dab971b6451a937e5477fc09fefaf17e6070ac9331ae2021bb730","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00007","start":103,"end":207,"exact":"However, on November 13, it organized a consultation session to discuss its VPN registration framework. "},{"@id":"urn:doxa:passage:07f92231f7906fb680932a67ee258431cd894de02f55ff3a53f75c8bbb2597da","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00007","start":207,"end":384,"exact":"The session was attended by representatives from the Ministry of IT & Telecommunication (MoIT&T), Pakistan Software Export Board (PSEB), and the Pakistan IT Association (P@SHA)."},{"@id":"urn:doxa:passage:8f51319fb7ab807e1c163f00e1b6ae4f8fc33e57b483e3c77bbb4deecc460c92","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00008","start":0,"end":185,"exact":"Following the PTA's announcement of the ban on illegal VPNs, the regulator claimed that nearly 20 million attempts were made daily from within Pakistan to access pornographic websites. "},{"@id":"urn:doxa:passage:44c090c0ff5bd1e11d9db8399c26a782e6c9114a4650f8f1aa92a29494add2eb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00008","start":185,"end":311,"exact":"Additionally, it reported blocking over 100,000 URLs containing blasphemous content, as well as 844,000 pornographic websites."},{"@id":"urn:doxa:passage:b769a2fa109d11c149d167447b9885dae9bc47f24ae28ea0cb9147cc2afdaaac","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00009","start":0,"end":171,"exact":"In August of this year, Pakistan implemented a national firewall capable of tracking, blocking, or significantly limiting access to content it considers to be propaganda. "},{"@id":"urn:doxa:passage:0c37f4c33382ee0f2e609cc9bb1501f5b2727778b02d932691340d2105216e75","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00009","start":171,"end":240,"exact":"Since then the authority is bolstering its efforts to register VPNs. "},{"@id":"urn:doxa:passage:c632f6070c51063fead4e605050852cdf66f9bcc5fc32ca9daa075adeb998ca8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00009","start":240,"end":481,"exact":"On November 16, the Ministry of Interior and the Federal Investigation Agency instructed the PTA to block illegal or unregistered VPNs across Pakistan to prevent terrorists and individuals from accessing pornographic and blasphemous content."},{"@id":"urn:doxa:passage:9f364f3b9adcd4c598b1016aef0a2d6a85ac4f61d1455835aed2a9b366cd011a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00010","start":0,"end":150,"exact":"Before the VPN ban was announced, Prime Minister Shehbaz Sharif congratulated US president-elect Donald Trump on his victory in the recent elections. "},{"@id":"urn:doxa:passage:29a76e9258a639b44bebac6234bcd1d5c75fd1cd87190df20a58d3a9aaa4f108","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00010","start":150,"end":277,"exact":"In response, a Community Note appeared, stating, “He is using a VPN to access X, which is unlawful according to Pakistani law.”"},{"@id":"urn:doxa:passage:216456266ed983bb44d70d7c4b5dce3fe74fa1ab7ba0170998b3dfb4c02bf8ee","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00011","start":0,"end":27,"exact":"The great Pakistan firewall"},{"@id":"urn:doxa:passage:23640baaa298ec02aeec1b1425e5fa5ff24f80acf33d3ee24783e1f8b9a3296d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00012","start":0,"end":81,"exact":"Since July 2024, Pakistanis have reported slow internet services and disruption. "},{"@id":"urn:doxa:passage:e3f3fea9b0266b77981c23a9a402b018a460713d49c00f877e3dbb0dd6015beb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00012","start":81,"end":402,"exact":"Bytes for All Pakistan, a research think tank, debunked the government's clarification of slow internet in its report, “Slow Internet in Pakistan and the Smokescreen of VPNs.” The report links the slow internet speeds to the trials of an upgraded web management system or a Chinese style firewall, rather than VPN usage. "},{"@id":"urn:doxa:passage:24ff1eb4bd4dae1326008f948597aa60e30b8e9c370f8f816335f4bbad379663","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00012","start":402,"end":521,"exact":"The report argues that these measures are part of a broader strategy aimed at monitoring and controlling online spaces."},{"@id":"urn:doxa:passage:7017f6cc0e30ef6dc83ac96f3b3a57a1951f50f7f0770dc5d1d72441a6893fb8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:64e8a641c2650d36f5dfc500d8041324","blockId":"gv-824529-b00013","start":0,"end":192,"exact":"Amid reports of disruptions to digital platforms and slow internet speeds, the government completed the second trial of its much-debated firewall aimed at blocking unwanted content in August. "},{"@id":"urn:doxa:decision:e579f5b7859db513f67b3c085c0e4d6a","@type":["doxa:Decision","prov:Entity"],"recordId":"e579f5b7859db513f67b3c085c0e4d6a","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:64e8a641c2650d36f5dfc500d8041324:u_32d7b9478504f438b6027f9b","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:5a1899dcefe464cb3f2134494087460790b314739e5c8e92ae4d3bb817c999ef","urn:doxa:passage:a92703ec2525a2070727526a220361f37d2f9aa725df5eec472a255266e7a120","urn:doxa:passage:94c363b4b65a8ab13c293b20d8e2c8110d9d83a91ad56f2965621cab10a20756","urn:doxa:passage:95e5cfa30df3719efb876c4117ff8e478663c9ea794fcfccbf7718c9a176770a","urn:doxa:passage:3649c1b5025c273efb485edd2e7f625bcb893cb784f3b9b8d870abc9cd76f953","urn:doxa:passage:7a607605c2d2a3ca1d3c4eaa993c9f2043617cd5264a5f5be88f8946437581e3","urn:doxa:passage:d498c7258772b80a934ef1600661d90cbe6b88b124324dc14351000018b47bfb","urn:doxa:passage:f18c69f35f30970a0630d89bd13fa6d2a98c6138df3cafe8fdb5eb6348bbafcb","urn:doxa:passage:438ffe66e1b6783c7904356afcc7adb8748b495d5f39bd2cae61149cbc488d07","urn:doxa:passage:6d5df09cf7b86f743231e1d03db0d3aeb38ec954c9f3b2b