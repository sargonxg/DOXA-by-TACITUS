lse,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:bf7b7ce18212136e0b3f1f527c69ff3c322a917490db4d02bce20825922b424e","urn:doxa:passage:e9769c4573966b39d6eef0f5d45acbe60d9feb7dcf2b85780cb7b48d1369816c","urn:doxa:passage:9eab0dec90edb94549566d45b8b23b3c0e46782b0c25440bdc4ea378f23a63e4","urn:doxa:passage:889de5bd34de3d0a80d75c49742273a1996b6db3f68199495d721f61f693b95e","urn:doxa:passage:122fb7393f10bd9325750afa7fcf1bd92ab3cd6bd82ef68295a601610eb7374e","urn:doxa:passage:e2819b7f9614c305fffb83cd8a72e0a53650a8953ea9536c7bbe8aa2985f27a6","urn:doxa:passage:a4c42dd98cbbbb72f226a65aa267ec071e128c84557d2ea24d24e00e8c4d4768","urn:doxa:passage:0296e4d2fc3cc3b3c657379699775a96e277761345e9ec3d27f6dbce101dff5d","urn:doxa:passage:ab7a3196b54a59768ce1a669101595dbcc00ffba1ea1b18a78b8bc1ae2a11285","urn:doxa:passage:5bbdb99ab7f043b682d4098fa92ba0401d83cf587d35e61212de8b5718be0dc6","urn:doxa:passage:8c9989f2f8f17b2171a20dd061f1772f0937a13533582059039ddd11c4d53f2f"]},{"@id":"urn:doxa:decision:7e05ad6eaae6a2dde8c987632f16bd9a","@type":["doxa:Decision","prov:Entity"],"recordId":"7e05ad6eaae6a2dde8c987632f16bd9a","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:7f5b5b12d89770a1a76d111438059c1a:u_85594938761c7817023a0e54","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:bf7b7ce18212136e0b3f1f527c69ff3c322a917490db4d02bce20825922b424e","urn:doxa:passage:e9769c4573966b39d6eef0f5d45acbe60d9feb7dcf2b85780cb7b48d1369816c","urn:doxa:passage:9eab0dec90edb94549566d45b8b23b3c0e46782b0c25440bdc4ea378f23a63e4","urn:doxa:passage:889de5bd34de3d0a80d75c49742273a1996b6db3f68199495d721f61f693b95e","urn:doxa:passage:122fb7393f10bd9325750afa7fcf1bd92ab3cd6bd82ef68295a601610eb7374e","urn:doxa:passage:e2819b7f9614c305fffb83cd8a72e0a53650a8953ea9536c7bbe8aa2985f27a6","urn:doxa:passage:a4c42dd98cbbbb72f226a65aa267ec071e128c84557d2ea24d24e00e8c4d4768","urn:doxa:passage:0296e4d2fc3cc3b3c657379699775a96e277761345e9ec3d27f6dbce101dff5d","urn:doxa:passage:ab7a3196b54a59768ce1a669101595dbcc00ffba1ea1b18a78b8bc1ae2a11285","urn:doxa:passage:5bbdb99ab7f043b682d4098fa92ba0401d83cf587d35e61212de8b5718be0dc6","urn:doxa:passage:8c9989f2f8f17b2171a20dd061f1772f0937a13533582059039ddd11c4d53f2f"]},{"@id":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-731325","title":"Sri Lanka reverses decision to bury COVID-19 victims on remote island after protests","author":"Rezwan","translator":[],"publishedOn":"2021-03-15","sourceUrl":"https://globalvoices.org/2021/03/15/sri-lanka-government-reverses-decision-to-bury-covid-19-victims-on-remote-island-after-protests-from-inhabitants/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"ea24073f95fc771bedea44aa22c1c59c0a57a01cb96dd8446c874819f38e0a75","textSha256":"d62abd9ff07aaec1bcf633896fef0404f0ecf722affbbe8e4248ade2b4937407","archivedRecordSha256":"ebbad2443fb6971cd2b3dc925865cb44008157ef4c0e813e0e5039639539da15","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:a0cd64f061915a496a206780d881d51d:u_32511b899eb6ad1626f92191","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_32511b899eb6ad1626f92191","status":"accepted","fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d"},{"@id":"urn:doxa:unit:a0cd64f061915a496a206780d881d51d:u_f78a8f78282653b9ebf6afb3","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_f78a8f78282653b9ebf6afb3","status":"accepted","fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d"},{"@id":"urn:doxa:passage:1ef582ab309c227e6c7ca4d18858fd7ed8caf607010949c19e13b3a53ec61619","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00001","start":0,"end":256,"exact":"On March 2, the Sri Lankan government announced that it would allow the burial of COVID-19 victims from Muslim and Christian communities at one location—on the “thinly populated” island of Iranaitivu in the Gulf of Mannar, 300 km from the capital, Colombo."},{"@id":"urn:doxa:passage:f9f8055869d6f69b4c1f5221b46d492541cbe8dc8d7f1580507ee4e1c64e3526","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00002","start":0,"end":111,"exact":"This decision came after the country lifted an 11-month ban on the burial of COVID-19 victims, on February 26. "},{"@id":"urn:doxa:passage:c0a4be380876f6db19d10563afdb1e8a8f7788919581935fcffa94a53b82512c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00002","start":111,"end":368,"exact":"The ban had been in place partly on the premise that burying those who had died from the disease might lead to contamination of the groundwater, but it went against religious practices of the Muslim and Christian minorities in the majority Buddhist country."},{"@id":"urn:doxa:passage:20be875a4e421cb237602fe1fdf5146b569c6be5b25be7c7bab4662e96899714","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00003","start":0,"end":463,"exact":"However, the islanders of Iranaitivu, home to around 360 families, protested against the government’s decision to use the island as a burial site, many claiming that this would create a division in the solidarity between the ethnic Tamil and Muslim communities — the government had ignored areas suggested by the Muslim community, choosing instead a Tamil area, that is still reeling from the effects of prolonged military occupation and the Sri Lankan Civil war."},{"@id":"urn:doxa:passage:e018fca305348e18fc8d598fd747448cf698d88c33d8fb0f942e05d4e4507cbc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00004","start":0,"end":107,"exact":"Dr Kumaravadivel Guruparan, Former Senior Lecturer in Law at the University of Jaffna tweeted in agreement:"},{"@id":"urn:doxa:passage:b7713cda43791572fc46bb4d44172de7c3df66a77ce897542984dcc8de8827b7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00005","start":0,"end":173,"exact":"On March 5, Fisheries Minister Douglas Devananda came out in support of the villagers saying that the Iranaitivu island was not suitable for the burial of COVID-19 victims. "},{"@id":"urn:doxa:passage:664a9a96c9abff959c0ed788366598e18a707532c607a37ac4cb051a4090aa92","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00005","start":173,"end":306,"exact":"Three days later, he confirmed that the government had suspended the decision to bury victims of the disease on the tiny twin-island."},{"@id":"urn:doxa:passage:7dc1c58ce7534b1ff20678cbf8c67775a53571ac97b6f0f0968423772d5b827a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00006","start":0,"end":238,"exact":"On March 8, government authorities stated that they were no longer considering Iranaitivu as a burial site and started burying COVID-19 victims at Oddamavadi, a town located in the Batticaloa district in the Eastern Province of Sri Lanka."},{"@id":"urn:doxa:passage:0abb49401e6512b292cae19bd542d7c037c5f135f6df8d5086d3d195e47a77ff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00007","start":0,"end":34,"exact":"Why people in Iranaitivu protested"},{"@id":"urn:doxa:passage:16265e4ff42ae70a644f215f6b84763800336a02c9ab7a900b019323f2263704","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00008","start":0,"end":145,"exact":"Iranaitivu (or Iranaitheevu) is a double island, and its north and south parts (Periyathivu and Sinnathivu) are joined by a small piece of land. "},{"@id":"urn:doxa:passage:1429347e8034dd57bcfb56ec90d4f00dd775ef25b68331cb48d2d69381b563e2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00008","start":145,"end":314,"exact":"During the 30-year long Sri Lankan Civil War (1982-2009), the island, mostly inhabited by a community of ethnic Tamil fishers, was within the area of military conflict. "},{"@id":"urn:doxa:passage:d2c191954e2437daa7998dd0e47d88673ca0b7cdbe236a6966896ed149ec19b1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00008","start":314,"end":428,"exact":"In 1992, a naval base was set up there and the islanders were relocated, forced to abandon their homes and cattle."},{"@id":"urn:doxa:passage:a9ab144d4fb56a628dac5b69e62bb632f20ed7e627449049fcb510ae1ca5aeef","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00009","start":0,"end":263,"exact":"In April 2018, a predominantly female group of about 300 former islanders accompanied by Roman Catholic priests, fishers, local journalists and civil rights activists in a 40-strong fishing boat flotilla had arrived on Iranaitivu to re-establish residence there. "},{"@id":"urn:doxa:passage:ab1c9575af901c7c5ee8720c3aa14250765c26afc49304006d175501487b1cf5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00009","start":263,"end":300,"exact":"But they were sent back by the navy. "},{"@id":"urn:doxa:passage:6a083b339d4114259bb6b238717f264732f3567d6fb4785380badf8b3659dc50","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00009","start":300,"end":412,"exact":"However, after a month, the government allowed the former inhabitants, even those without land titles, to stay. "},{"@id":"urn:doxa:passage:b2b79d0c8384fcc5a77c080a539b4f5ad95e0a915ab57fad76881d3ba36eb8ee","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00009","start":412,"end":524,"exact":"During the following years, the government and the navy began to rebuild some infrastructure for the population."},{"@id":"urn:doxa:passage:335b111ddc6a2d7757d83a4044de76edfe8edff255667e06b086156b4f54acd7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00010","start":0,"end":117,"exact":"The locals raised several concerns in their protest against the decision to use the island as a COVID-19 burial site."},{"@id":"urn:doxa:passage:99554a8228ed39ee4ee92e290ce529c3c70df7edf307ec4313976f3d143a03e0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00011","start":0,"end":46,"exact":"Citizen journalism portal Groundviews tweeted:"},{"@id":"urn:doxa:passage:ad74be5a18c1652c87fd616b05c0935943272816ec829ade7c149e3a79d06900","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00012","start":0,"end":83,"exact":"The villagers continued their protests even as the navy started digging the graves."},{"@id":"urn:doxa:passage:e80a4983008d891eec785c2f8144e497ed22527fed497585f6f2002f2b8ad04a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00013","start":0,"end":13,"exact":"Mari tweeted:"},{"@id":"urn:doxa:passage:6a71e5975863e1fd3b8b2faef035fa2fcd5585a52ae680c1153673a74825c29a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00014","start":0,"end":84,"exact":"Journalists and activists were prevented from visiting the island amid the protests."},{"@id":"urn:doxa:passage:e854f394e835e8ee6da1e19dd21d396035bd057e1f4db9a360081cc3a9cc05f1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00015","start":0,"end":97,"exact":"Ambika Satkunanathan, the former commissioner of the Human Rights Commission of Sri Lanka, asked:"},{"@id":"urn:doxa:passage:b419e0488bfab7dc8e1b21425582dafacce039b222e0bff62d6b52c9219c6477","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00016","start":0,"end":78,"exact":"Human rights activist Ruki Fernando visited Iranaitivu on March 9 and tweeted:"},{"@id":"urn:doxa:passage:b91a4b05f080d03963bb225eecf6b3a1b017eb48f7a6d4836f9df53aa0078a7c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00017","start":0,"end":160,"exact":"Fernando also highlighted the withholding of basic infrastructure development on the island by successive governments in a photo story published in Groundviews."},{"@id":"urn:doxa:passage:4a54ddb3436b5b09ab0a0ceca7b2e52a26386c0c59fdfe11c0df049348a62f7c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00018","start":0,"end":18,"exact":"The ban on burials"},{"@id":"urn:doxa:passage:287cd3ff7494b7c86beb801b2b2912979574a6a05a9825caa9b42a4a0cdc9190","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00019","start":0,"end":223,"exact":"Despite opposition from the Muslim community (10 per cent of the population), Sri Lanka amended the Quarantine and Prevention of Diseases Ordinance in April 2020, to make cremation compulsory for those dying from COVID-19. "},{"@id":"urn:doxa:passage:5ac36370d035b86cd0c2e5f57a08916d4353dfe3a8d1cf65b50a77972221a5ff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00019","start":223,"end":310,"exact":"Some health officials cited the fear of groundwater contamination behind the decision. "},{"@id":"urn:doxa:passage:c3fbf57547b80c7e8124afff239699c7dd344384f9bb2d6595e63464eacbfe17","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0cd64f061915a496a206780d881d51d","blockId":"gv-731325-b00019","start":310,"end":548,"exact":"Leaders from the Muslim communities and the civil society pointed out that Islam prohibited cremation and the decision contravened the World Health Organisation (WHO) guidelines on COVID-19 deaths which allowed both cremation and burials."},{"@id":"urn:doxa:decision:177ed9c53316041946e915433e0c44c1","@type":["doxa:Decision","prov:Entity"],"recordId":"177ed9c53316041946e915433e0c44c1","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:a0cd64f061915a496a206780d881d51d:u_32511b899eb6ad1626f92191","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:1ef582ab309c227e6c7ca4d18858fd7ed8caf607010949c19e13b3a53ec61619","urn:doxa:passage:f9f8055869d6f69b4c1f5221b46d492541cbe8dc8d7f1580507ee4e1c64e3526","urn:doxa:passage:c0a4be380876f6db19d10563afdb1e8a8f7788919581935fcffa94a53b82512c","urn:doxa:passage:20be875a4e421cb237602fe1fdf5146b569c6be5b25be7c7bab4662e96899714","u