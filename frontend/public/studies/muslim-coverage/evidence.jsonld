36c88f9da286545b7bcd","urn:doxa:passage:b5d881ea0b799aa8287192469873577295fb654ab765bdd35090cc5282954dc6"]},{"@id":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-829591","title":"Georgian food goes international","author":"Elliot Friar","translator":[],"publishedOn":"2025-03-02","sourceUrl":"https://globalvoices.org/2025/03/02/georgian-food-goes-international/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"60d530073677a80021d10420d32a3d5e3e6d81ea5978633905e272d019d57ba6","textSha256":"16a58475840558989d49a6ef357a0262c89af03d6f8e0a525c3e1dcc97c0be1a","archivedRecordSha256":"b9cb4024bfe72a430a4d51d60f09c8890c7fcdba2bfbb9d595371f9162637576","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:0530444e03560fdac5763eede07d2fb4:u_00ba8afbb5fc62fe2ee28a36","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_00ba8afbb5fc62fe2ee28a36","status":"accepted","fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4"},{"@id":"urn:doxa:unit:0530444e03560fdac5763eede07d2fb4:u_a1eeb95827a692387708c31a","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_a1eeb95827a692387708c31a","status":"accepted","fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4"},{"@id":"urn:doxa:unit:0530444e03560fdac5763eede07d2fb4:u_e8ac7175e99fe3543ac987ee","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_e8ac7175e99fe3543ac987ee","status":"accepted","fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4"},{"@id":"urn:doxa:passage:67528152430e2240b12cfc12c0e8e536191d48c29b6f6c7c8da2dccb9dff0900","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00007","start":377,"end":567,"exact":"Khinkali is eaten by hand, usually without eating its doughy stem handle, providing both a traditional experience and opportunities for I’ve-Done-This-Before status for cosmopolitan diners. "},{"@id":"urn:doxa:passage:3fa446d56bfbe56ab8c8e8ea75cae37b585adc7952cb74173c2119082d4d5e80","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00007","start":567,"end":695,"exact":"This is especially true as high-income groups spend more on out-of-home dining while spending for low-income groups has stalled."},{"@id":"urn:doxa:passage:6217fe34fe71b0fa7871a15c46b70f3a3c6cd2efdda7dfe93c7c5898ae987940","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00008","start":0,"end":151,"exact":"For example, sourcing a type of Georgian cheese known as sulguni — the heart (guli) and soul (suli) of Georgian cuisine — was challenging for Didedas. "},{"@id":"urn:doxa:passage:c36e9c4aa20322c817471a4e407e521eba6b7b30fb2a2e7d0a89a167169e532e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00008","start":151,"end":337,"exact":"They worked with a Spanish cheesemaker who had never made sulguni, asking them to only start the cheese culture process before handing curds to the restaurant for cheddaring and curing. "},{"@id":"urn:doxa:passage:65290a2bf2aa3394eea13b95aefba34d28ffa59ab4afd50c60ba91eb7e8f025a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00008","start":337,"end":478,"exact":"As for technique, Ana says she didn’t know any Georgians in Madrid but required their cooking knowledge and famously hospitable disposition. "},{"@id":"urn:doxa:passage:44377a349e2a9529ef072683d95270532ba2994be73135c34c183e149c9e8778","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00008","start":478,"end":551,"exact":"“I knew there was one place I could find Georgians, and that was church. "},{"@id":"urn:doxa:passage:06a4acf407b5fb9b33c1bff4fba2c2528a75c353ff72666069d3dce498659e23","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00008","start":551,"end":791,"exact":"That’s how I found my team.” These explanations — as Georgian religiosity pairs with reality and myth of exotic culinary tradition — may force us to lie in the long history of Georgian cultural dissemination to understand its cresting wave."},{"@id":"urn:doxa:passage:1c14864225eb906a73e35c597b102c3cb34a5714998627464940c1ac16d07435","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00009","start":0,"end":31,"exact":"The history of Georgian culture"},{"@id":"urn:doxa:passage:3c835acb6dcd7137f9adccec7ff7f36d8128a345c69755d5a9fc7c1a6a0dbdfe","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00010","start":0,"end":194,"exact":"A departure point for understanding Georgian cultural dissemination may be Leo Tolstoy and Mikhail Lermontov’s romantic depictions of a traditional, solidly agrarian life in Russian literature. "},{"@id":"urn:doxa:passage:c37ad7d79a59041daf8484ab3c641e13d83405c56312fdc01094599ba98a10b3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00010","start":194,"end":496,"exact":"Such works may be read as mirrors of Georgian poet Ilia Chavchavadze’s cultural entrepreneurship of national identity, which focused on “recovering [Georgia’s] history, culture, and language while at the same time developing a strong appreciation for imperial culture,” writes historian Adrian Brisku. "},{"@id":"urn:doxa:passage:d7dd5d8ceb05737fcf264f9ef662283a7168dd8a3688587ac699afa6dd131318","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00010","start":496,"end":648,"exact":"In the early 20th century, a short-lived Georgian Democratic Republic promoted this tradition as being civilizationally connected to Greece and Europe. "},{"@id":"urn:doxa:passage:dd367293bf9453278e4298bce9ed20a1f441e1d6e72be493b60c586fa317f457","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00010","start":648,"end":832,"exact":"Five thousand years before Hesiod wrote of Prometheus and his punishment in a Georgian cave, researchers believe the world’s first wine was being produced in Georgia, in buried qvevri."},{"@id":"urn:doxa:passage:4e279a349799625e465a7e61cdeca47a54cf6320f2afe5e4312112f7b1e9cc80","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00011","start":0,"end":157,"exact":"After the Soviet invasion, a member of the Georgian winemaking trust, Samtrest, was assigned to open a new restaurant in Moscow’s historic theatre district. "},{"@id":"urn:doxa:passage:4d7b04abb53e3111b549bb78da5d4d2230aa181cc1417efdac4a0d2141c6963c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00011","start":157,"end":386,"exact":"The restaurant, named Aragvi, played on earlier intrigue with Persianate and Turkic influences, serving “Oriental coffee” to opera-going guests and being featured in the English-language Fodor’s travel guide for decades to come. "},{"@id":"urn:doxa:passage:f905d124cd92308c94539e15c68e8a33000a97fd3e169f49918fd6ab7ae5efdd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00011","start":386,"end":601,"exact":"The Kremlin exerted control while resistance was partially negotiable — after an attempt to make Russian an official language met significant protest, Moscow accepted Georgian as the sole official language in 1978. "},{"@id":"urn:doxa:passage:2fa1a1bb0f8cab4262d5fe38619df8dcaa317f906d0dc6b58938bd852e21bfa1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00011","start":601,"end":656,"exact":"This excluded sizable populations of ethnic minorities."},{"@id":"urn:doxa:passage:c4a8c6a1a675a23a102e0bab9acb12408d3a3aa6a337a0bb4bc278e89dc0d360","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00012","start":0,"end":110,"exact":"In the years since independence, the country’s relationships with Russia and the European Union have shifted. "},{"@id":"urn:doxa:passage:01d655a5054a7b68aea8c683feda734b528617d344c908c4a8e4626c63d1358f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00012","start":110,"end":352,"exact":"Inching ever closer to the former, the ruling party, the Georgian Dream (GD), has damaged much of its ties with the West in a short time while accusing socially progressive movements, such as LGBTQ+ rights, of ruining Georgian traditionalism."},{"@id":"urn:doxa:passage:16337aa5c9c48265f996ed619bb59b0aae217cc67895f310786715776a393b92","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00013","start":0,"end":278,"exact":"Philosopher Roland Barthes writes that the French culinary project — the original “cuisine” — is only permitted to be innovative when it re-discovers secrets from the past, as dishes represent “the flavorful survival of an old, rural society” against encroaching non-tradition. "},{"@id":"urn:doxa:passage:ee1e2c25c69c0522bfd1fc0e8c9f26780576c231d99ec216af01076e7792e32a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00013","start":278,"end":368,"exact":"Georgian cuisine’s pre-modern myth and reality is a key differentiator in Western Europe. "},{"@id":"urn:doxa:passage:db0ae9f20b57d3837f51aded4cd8a74550a5bcfcc158070c772c0e17c027c5b5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00013","start":368,"end":457,"exact":"However, Georgia suffers from more salient outcomes of a political embrace of tradition. "},{"@id":"urn:doxa:passage:b3678adfe127c47bb0b18a65e0398d13016fdb0f58543b2e6f692def2fd8336c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00013","start":457,"end":567,"exact":"To borrow a term from online fascists, cuisine may permit a “retvrn” without controversy for would-be diners. "},{"@id":"urn:doxa:passage:73367d4dff0dffc6759bb05a60027e5a4a5f8ba621996655d43a4e534a76916f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00013","start":567,"end":605,"exact":"Diners in Moscow had similar intrigue."},{"@id":"urn:doxa:passage:aa07aec386623d2b076c45ac67423fcf00505f22590c9524fd9f77435ac0749e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00014","start":0,"end":123,"exact":"Kinkally is one of the new Georgian restaurants in London — opening a few years after Aragvi in Moscow permanently closed. "},{"@id":"urn:doxa:passage:878ef1648e8e89225d5330a4a3b2c8f0904ebdd7eb634f0ddfc03506e63943ca","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00014","start":123,"end":261,"exact":"The restaurant transgresses tradition; one can eat black-striped wasabi khinkali with their hands before visiting “Kinky Bar” downstairs. "},{"@id":"urn:doxa:passage:a8d299b371ae4942eb909ee0fb6fb84112430b91a44b7c9cc51add07ffb5c201","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0530444e03560fdac5763eede07d2fb4","blockId":"gv-829591-b00014","start":261,"end":389,"exact":"In the 1940s, German scholar and advisor to the Iranian government William Haas lamented the Westernization of Iranian cuisine. "},{"@id":"urn:doxa:decision:f8b7b57a29704858798bc5634fc01270","@type":["doxa:Decision","prov:Entity"],"recordId":"f8b7b57a29704858798bc5634fc01270","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:0530444e03560fdac5763eede07d2fb4:u_00ba8afbb5fc62fe2ee28a36","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:67528152430e2240b12cfc12c0e8e536191d48c29b6f6c7c8da2dccb9dff0900","urn:doxa:passage:3fa446d56bfbe56ab8c8e8ea75cae37b585adc7952cb74173c2119082d4d5e80","urn:doxa:passage:6217fe34fe71b0fa7871a15c46b70f3a3c6cd2efdda7dfe93c7c5898ae987940","urn:doxa:passage:c36e9c4aa20322c817471a4e407e521eba6b7b30fb2a2e7d0a89a167169e532e","urn:doxa:passage:65290a2bf2aa3394eea13b95aefba34d28ffa59ab4afd50c60ba91eb7e8f025a","urn:doxa:passage:44377a349e2a9529ef072683d95270532ba2994be73135c34c183e149c9e8778","urn:doxa:passage:06a4acf407b5fb9b33c1bff4fba2c2528a75c353ff72666069d3dce498659e23","urn:doxa:passage:1c14864225eb906a73e35c597b102c3cb34a5714998627464940c1ac16d07435","urn:doxa:passage:3c835acb6dcd7137f9adccec7ff7f36d8128a345c69755d5a9fc7c1a6a0dbdfe","urn:doxa:passage:c37ad7d79a59041daf8484ab3c641e13d83405c56312fdc01094599ba98a10b3","urn:doxa:passage:d7dd5d8ceb05737fcf264f9ef662283a7168dd8a3688587ac699afa6dd131318","urn:doxa:passage:dd367293bf9453278e4298bce9ed20a1f441e1d6e72be493b60c586fa317f457","urn:doxa:passage:4e279a349799625e465a7e61cdeca47a54cf6320f2afe5e4312112f7b1e9cc80","urn:doxa:passage:4d7b04abb53e3111b549bb78da5d4d2230aa1