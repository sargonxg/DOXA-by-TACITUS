sage:f9d8bc293a514f04e42232a20e55e69f0685ccae3155add406f912c05e4bb374","urn:doxa:passage:b800ea02de4c75a13af44c06e5074f2d021624cfd636aadd0fc3cd35cde2ae2a","urn:doxa:passage:6beaf0e0d8cd567a9f7343d970a325de801cf37d9eb8187cc39b63b9400c5c23","urn:doxa:passage:8104dfd3ea03e9cc51dbcd103f86ac996659e4d90e8ae5dbf3b9d42ce5ff1660","urn:doxa:passage:f72b8df7e6c5b059d4b60799975727afc696da98a47bb8b06b06c91430dba4f8","urn:doxa:passage:b058c2a4eccca3f0d3bd69d9117842c08635b6cc3e8e17ece86016e082b7d821","urn:doxa:passage:54e912622b3c4a1bd245c0823b506ffa8527e8c0483dddfeda87a744a6ced051","urn:doxa:passage:27337ae97f3696b786443dbeb77f1713d8c66f9b9010506d127c3483a1bf6e0d","urn:doxa:passage:0d1cc53cd397b924c5bc80bbc2a263c5c2ce2bd2c336c8f3b7852b0d1c991003","urn:doxa:passage:4f62a003ebf5171f39d0c36ec46c52626c09ca78cbe838ae576831e44e42178f","urn:doxa:passage:8faae36884580d240eadf46ce526bd2ce1d0848c1acd2c292567a43489544344","urn:doxa:passage:c2e23cc264983c55961f6bee5ea5f4ddee69bc836340a1ab24f8f187f1898b16","urn:doxa:passage:9de8412a6d6c84fc1c8a75c806cbf7fef2023b2d433d315d9362c2ccf44cef27","urn:doxa:passage:0b45cfc184bbaf92b6a51f3baf0d0ae0df3f055def27f52b3d441854aa4542f1","urn:doxa:passage:f1910df6425dd74b4bcd3fd0c5eb1335d6aec14916b1673e378d15e1d3656ad8","urn:doxa:passage:e3bb6c1f4a4d0bc59355f757f3fd78a0f77b3dc3f649dee3ff99d79d0e3051d7","urn:doxa:passage:fa8d7951d4fce5e64dc3420cde28c08f8f6bd8f1610aa17259e977dbe6f00948","urn:doxa:passage:3cc0cab183e61e807171a2a54814cbe2e7c16cf70fe7d5e8d538ec7ced86ae61","urn:doxa:passage:c5a17df7e31214aff062ea516c1068cb2183055dafa395fe3621c0a0e787a371","urn:doxa:passage:f7587fa4ed9bf78c1f8716cf8209347607bd915c10cf06874f273394b42662aa"]},{"@id":"urn:doxa:decision:82fb4ee6b4d3b5637f767edfc6973f2d","@type":["doxa:Decision","prov:Entity"],"recordId":"82fb4ee6b4d3b5637f767edfc6973f2d","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:db00aad5283dda7c39b76257f3ff0143:u_31b75094945d5b150e08d5d3","attribution":"reported_speaker","speaker":"The Chinese authorities","speakerStance":"unclear","documentStance":"neutral","proposition":"Authorities portrayed the region as a source of instability and danger to justify repression.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports on how authorities portrayed specific ethnic and religious groups as sources of instability and danger to justify repressive measures.","modelPassage":["urn:doxa:passage:f130c1ad44b9bbed3f5eca67babb85ce29d16f3d868c50b33b6cedd3ce6d53a6","urn:doxa:passage:77d13e039174d1fb86ad808a5f8aa4473dcc6d1b0a5ae76875cb535fc5b78a64"]},{"@id":"urn:doxa:passage:3e1cabce89c9c4df5c58dbe2c4f3768f0aeb77d99e8deaf2b04e7b4f4bb24d5e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00026","start":0,"end":309,"exact":"> ИП: Я думаю, тут несколько факторов. Один, как я сказал, сработала программа ассимиляции. Другой, возможно – личный. Раньше Синьцзяном руководил переведенный из Тибета Чэнь Цюаньго, там он осуществлял похожую политику. А сейчас его сменил ученый и технократ Ма Синжуй из более либеральной провинции Гуандун."},{"@id":"urn:doxa:passage:1a3787a8ddb03cadda26ebddf5844a3caf9dce7983328870ccfaed0ad60767ff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00027","start":0,"end":298,"exact":"> Еще один фактор – давление Запада, на которое Китай был вынужден отреагировать. Как мне говорили знакомые уйгуры, программа лагерей, куда людей отправляли без суда и следствия, отменена. Большую часть закрыли, а оставшиеся переформатировали в тюрьмы. Теперь туда заключают по формальным причинам."},{"@id":"urn:doxa:passage:c8e647a7ca6ab85fdeb4082089fddaff917bba29c17f6c45fde2ff598e1dd85e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00028","start":0,"end":287,"exact":"> Ну и наконец, Китай решил развивать туризм в Синьцзян. Нужно показать, что это благополучный регион. А как это сделать, если на каждом шагу проверки – блокпосты и пункты досмотра? Ведь этим утомительным проверкам подвергались и туристы-ханьцы. Так что пришлось отретушировать картинку."},{"@id":"urn:doxa:passage:2b22d215edc162f24cbc4bbed06306727becfcafc9256c172eb8304a02cb998b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00029","start":0,"end":46,"exact":"> IP: I think there are several factors here. "},{"@id":"urn:doxa:passage:f8cb8df3e9e6f1c3800c930ca25c1784ce8f85da2355766b29b6873f3acbccfa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00029","start":46,"end":103,"exact":"One, as I said, is that the assimilation program worked. "},{"@id":"urn:doxa:passage:7f0372b19b15a7d77e29365d0f58b9a65fbbb3a09c9ca3151506a558636a1bee","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00029","start":103,"end":139,"exact":"Another reason is perhaps personal. "},{"@id":"urn:doxa:passage:c85cfe4676de93352881170152a9ad597420a7a9be40bbdab47dee9038d13d43","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00029","start":139,"end":267,"exact":"Previously, Xinjiang was led by Chen Quanguo, who was transferred from Tibet, where he implemented a similar repressive policy. "},{"@id":"urn:doxa:passage:7c89cc429c0d840b49f59905d6021f1f83d8dcbdcf67730407626e652ec1a8a0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00029","start":267,"end":377,"exact":"Now, he has been replaced by a scientist and technocrat, Ma Xingrui, from the more liberal Guangdong province."},{"@id":"urn:doxa:passage:393be0197680a3f6382435fac6b9deccb332d5cc878d01d708967ada0b2d9202","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00030","start":0,"end":79,"exact":"> Another factor is the Western pressure which China was forced to respond to. "},{"@id":"urn:doxa:passage:dfe88d063334cda46e4a220ec177691c8f0b9b202d41e07c42b66b40e86bbeec","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00030","start":79,"end":191,"exact":"As Uyghur acquaintances told me, the program of camps where people were sent without trial have been cancelled. "},{"@id":"urn:doxa:passage:cf1bb0f675b05c7894251063a3ed6933ef04feef71d1c3fc446c0dacf771d147","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00030","start":191,"end":261,"exact":"Most of them were closed, and the rest were reformatted into prisons. "},{"@id":"urn:doxa:passage:6d7769c0f4df4551aafecba9cc4cfbcb0a28155bf609fb27eb81a8f83a567fc3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00030","start":261,"end":325,"exact":"Now people who are sent there are imprisoned for formal reasons."},{"@id":"urn:doxa:passage:67a4480acf394701efa229bd6623c908fc45a278b73c36462e38693818924ce2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00031","start":0,"end":61,"exact":"> Finally, China has decided to develop tourism in Xinjiang. "},{"@id":"urn:doxa:passage:ba22ef3080057978e9c942638b76da2e5fc9e62ef1c3a19552c458ba5b70847a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00031","start":61,"end":119,"exact":"It is necessary to show that this is a prosperous region. "},{"@id":"urn:doxa:passage:4aea2a7109b6024cf4f7aa639bfa25814b4fdbd3e73dd76a581ccb7415abbcb2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00031","start":119,"end":196,"exact":"How can this be done if checkpoints and inspection points are at every step? "},{"@id":"urn:doxa:passage:daa24acea1e45ab8a30a3bdb00c33a446a4808cc6e4c56726a031c97a1352663","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00031","start":196,"end":273,"exact":"After all, Han Chinese tourists were also subjected to these tedious checks. "},{"@id":"urn:doxa:passage:4d99c537587005a59938b97b6c45f1f518f8796abc1ce17eafe7dd26f287ae42","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00031","start":273,"end":318,"exact":"So the authorities had to change the picture."},{"@id":"urn:doxa:passage:ad3c280a2537d040ad374d100569148d2ee73e4d2ac5596282b9dcda1ad210b3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00032","start":0,"end":87,"exact":"GV: It seems as if people in Xinjiang are no longer imprisoned on an industrial scale. "},{"@id":"urn:doxa:passage:37244ea0d2f53f5dc3a4ff7c67a5fc743c545fc12bab72f2a9e021a963cac0b5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00032","start":87,"end":197,"exact":"However, what will happen to the 500,000 people who were imprisoned earlier and are not likely to be released?"},{"@id":"urn:doxa:passage:be2620a713e240fc6f773f8d99592da1fd09329ad5bb39a58cc94bde9bd8bd50","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00033","start":0,"end":248,"exact":"> ИП: Отпустили тех, кто находился в лагерях без приговора и на взгляд властей встал на путь исправления. Тем же, кому не посчастливилось попасть в жернова судебной системы, никто не собирается пересматривать обвинения, часто ужасающе смехотворные."},{"@id":"urn:doxa:passage:5520e50f35caef2f92a16d594a6edb974d04bfbf4a427406d46af00ca9dcac5c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00034","start":0,"end":436,"exact":"> Так, например, на много лет сажали женщин за то, что они изучали Коран в детстве, 50-60 лет назад, или приговаривали к пожизненным и длительным срокам заключения редакторов одобренных государством учебников, по которым до того велось преподавание в школах всего Синьцзяна. Эти люди, как правило воспринимаются как глубоко религиозные верующие или национально ориентированные интеллигенты, надолго или навсегда изолированы от общества."},{"@id":"urn:doxa:passage:8fdd7c0a46815255ead09cfdee332c9729e92c3167b9f4ca0d9aa40c467b8136","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00035","start":0,"end":43,"exact":"> IP: I think they will remain in custody. "},{"@id":"urn:doxa:passage:e70dfddc4448c772e8292e8d50bc3583820e54f0e8a1b8582619224535baaf27","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00035","start":43,"end":173,"exact":"Those who were in the camps without a sentence and, in the opinion of the authorities, took the path of correction were released. "},{"@id":"urn:doxa:passage:1727bc187881d8d0a4c158c4aa6f7b8071d173e2263dc17a1b92537bfe1a8b81","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00035","start":173,"end":329,"exact":"For those who were not lucky enough to get caught up in the judicial system, no one is going to reconsider the charges, which are often terribly ridiculous."},{"@id":"urn:doxa:passage:70bdaf787d048b8454b0eafa0002376b1368e3f63522845a90d6271b3b3a1216","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00036","start":0,"end":104,"exact":"> For example, women were imprisoned for many years for studying the Quran as children 50–60 years ago. "},{"@id":"urn:doxa:passage:dbe21b4da67e5d3627650b1de87ee8d2ba4ccd47e76d77fd86ab7f0583bf39c8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00036","start":104,"end":248,"exact":"Editors of state-approved textbooks, which were previously taught in schools throughout Xinjiang, were sentenced to life and long prison terms. "},{"@id":"urn:doxa:passage:8c358cd7ce7ad100eafcae6208707e88d65dc7ea518810a26da0ba952d3cbc74","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00036","start":248,"end":397,"exact":"These people, as a rule, who are seen as deeply religious or nationally oriented intellectuals, are isolated from society for a long time or forever."},{"@id":"urn:doxa:passage:5b021eb81b768add665d5bcec26ae1f369b9710003f1540d8b6323f7d521cae7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00037","start":0,"end":122,"exact":"Read also Global Voices’ Special Coverage: Documenting state-directed persecution of minorities in China's Xinjiang region"},{"@id":"urn:doxa:decision:12e0a4291086529f626be6597d2fd5e6","@type":["doxa:Decision","prov:Entity"],"recordId":"12e0a4291086529f626be6597d2fd5e6","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:d