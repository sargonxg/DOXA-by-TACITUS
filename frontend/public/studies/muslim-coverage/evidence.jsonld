6947a8e","urn:doxa:passage:37b6a3cb88c411c07cdf957172afe46a2c07fd8f2553e7001d7651d20dca20f5","urn:doxa:passage:0ea759ce60dad8baf73a32cfc8383d21ec361ce20729f121baf6329c45e4efdb","urn:doxa:passage:119a24f28dc560f05e492d8457db8377c30ce6c6f44f6fec210601ba5053c086","urn:doxa:passage:ee857bbfbe4122d31b432ed0cde0c32aafbe9c66cb27a675dd4aceaaaace1e25","urn:doxa:passage:b35782842ba1eb32f4d585885c13298f2954bea501178b5177128c15f2cd258e","urn:doxa:passage:ab2926986c2922ef541e89157b777ba6c8eeb2d84d56ac228cc8f7f8c1083c37","urn:doxa:passage:da1abad9fa98ac551a00a39b685fadcc6d01c2d72acdc39e3c58fec9bd76f790","urn:doxa:passage:a5d627541f10bfd1a722df74ee40143d6a47a829fc4703011aab085e366296a0","urn:doxa:passage:045b7a88b42d26fc0d0699b9f78c300fd7a459877cb7d2be5bf98ab0bc18a686","urn:doxa:passage:5fbc99d113565168ea338f52ff7b5d96e81296e95e2a3ebde522c1d1cfdd563e","urn:doxa:passage:c8382e2b965285ea9329b93774953bfe689ee500fdb9a9b91c66a7184b26ab7e","urn:doxa:passage:ff27106b0317b55b8d42737c4a0b05ad5f4ec825cb61da899a9a5806060b9a12","urn:doxa:passage:d7412aa0893572759b3315fe7edf628149bf3a6e2ef1a64f35ac5cfac613128d","urn:doxa:passage:7f8185f0585d0476b8b59d4a0ee538d065f04aca7f341e9550e0732e33d9f993","urn:doxa:passage:6ce400e53128edda2f5f4a757b4b596d8f8adbe7b0f00a65f014d338a68f41c6","urn:doxa:passage:656075a013b1328ba439d02ec7f8ed7cd57538b954f5c99074e7721fc25665fc","urn:doxa:passage:89fa33ed574c536ca4b43ef7618bf08b8b87366e065400be28f8234b9cb4f9f3","urn:doxa:passage:8b161d8a54c99c2d913e3471877fd74ee099c9d943fcbbbbf3a185577aa470e8","urn:doxa:passage:90aff434c806d082183a9c7415882298a2c52fc7550927a9f4944c471764b973","urn:doxa:passage:c4eb6e1ac8c22a01bace9a77d8f7a1ad6cdea70b6a241dc347c59946c45237aa","urn:doxa:passage:333dd90b1063e2be810a9a3955281ad5362e5d22287f3521a9fc83195b75893c","urn:doxa:passage:0995ec9ae9e7cd84a1a9086081bbedd4fa341493691abceddf7a4e43827a95d8","urn:doxa:passage:d6610f8e665a5972f0d79680967c334ef485dab49eff89b8127062228c1561f6","urn:doxa:passage:11411f6e890da4533a26e3b4067c74a9ccdbcfb02b54e6eeea61cecc50dd074b","urn:doxa:passage:46887022329a1d6ebcb1b7bc7bed06a1e4776c1acba594a7cbbe4d708ccba77a","urn:doxa:passage:fab494c68877366c18ad04499644ada58ea194fd9aae631cccf4342dda15aad0"]},{"@id":"urn:doxa:passage:c99d389a819d4d9c76cc095e8bfb93896745557f647a5cda0753156a560ba240","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00021","start":0,"end":289,"exact":"Mobile phones and SMS text messaging have long been used as tools for organizing mob justice and destabilizing communities, but it wasn't until WhatsApp and other platforms emerged that false information could spread so rapidly and exponentially with the click of a button, Iyer continued."},{"@id":"urn:doxa:passage:da7ac2c8855e88a699a354fd5d8f1561aee054a1202f26554d56bb8744bc5a71","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00022","start":0,"end":254,"exact":"Iyer cites the lynchings in India caused by WhatsApp rumors about child kidnappings and the sectarian violence in Nigeria that erupted after images circulated on WhatsApp showed accused Fulani Muslim people committing acts of violence against Christians."},{"@id":"urn:doxa:passage:13539f49490c14aa1dbcc0040470a7aa13b1997590a80bf0bcfc72d37f52cee3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00023","start":0,"end":160,"exact":"In April 2020, at the height of the pandemic, WhatsApp finally took action to curb the spread of fake news by limiting the number of forwards from five to one. "},{"@id":"urn:doxa:passage:0487144dfff9ad5cd6203fddd4b6716798306ca3688025fc8cbbd0b5e73f6970","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00023","start":160,"end":323,"exact":"“The move is designed to reduce the speed with which information moves through WhatsApp, putting truth and fiction on a more even footing,” according to The Verge."},{"@id":"urn:doxa:passage:9aeb2a7f7c5a463cc92c2c6a58dc9119d77f672dd9a1c0eddab0e28a5d4e1e1d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00024","start":0,"end":37,"exact":"To criminalize or not to criminalize?"},{"@id":"urn:doxa:passage:0c62b957cb7467e83d40d7bdc25d06681a9868b3d2985f2a459d1fef4f13f483","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00025","start":0,"end":73,"exact":"People often turn to social media to fill gaps left by mainstream media. "},{"@id":"urn:doxa:passage:c0647b2596704122478492916f598aa462239134711bdaa7a7631f5e38d78648","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00025","start":73,"end":215,"exact":"But with the democratization of social media, anyone can produce content — with very few guidelines for monitoring, vetting, or fact-checking."},{"@id":"urn:doxa:passage:ca6ce2be028300095a4ea041eb3ff4d825c7996457f47aa837d47922436ce266","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00026","start":0,"end":206,"exact":"In East Africa, governments have created a range of policies and laws designed to control “fake news” and hate speech — but they end up becoming the rationale for penalizing opposition or dissenting voices."},{"@id":"urn:doxa:passage:0c69b9e22ead65bca437590e7374bc7abde4c33492e6595e594cb339fe3492d0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00027","start":0,"end":321,"exact":"In March 2020, in South Africa, the government criminalized the sharing of COVID-19 information “intended to deceive citizens or the government’s response to the pandemic” under the 2002 Disaster Management Act — violators may receive fines, imprisonment, or both, according to the Committee to Protect Journalists (CPJ)."},{"@id":"urn:doxa:passage:e002d5f924ac2fcfc74e45d974373293755114dd231f305a044d4d74db2b50a6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00028","start":0,"end":166,"exact":"CPJ warned, however, that “passing laws that emphasize criminalizing disinformation over educating the public and encouraging fact-checking present a slippery slope.”"},{"@id":"urn:doxa:passage:16f594a61e204145ca0bdbe87877d99f0f5c4b17c5f9f7f3a16e5e85f72ca2df","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00029","start":0,"end":248,"exact":"In Nigeria, disinformation has sown distrust in institutions that “should ideally be the lighthouse during a pandemic” said ‘Gbenga Sesan, executive director of the Paradigm Initiative in Nigeria, who joined Iyer and Taye on “Terms and Conditions.”"},{"@id":"urn:doxa:passage:9cc0b3601909e63327b5673be648bb504c16d4764c100d86fba381baf5a37d81","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00030","start":0,"end":191,"exact":"“You have a lot of information that should not get into the hands of vulnerable people,” Sesan, referring to the deluge of videos, messages and memes shared to promote fake coronavirus cures."},{"@id":"urn:doxa:passage:20718f14af1e9bf126fada667ca099299c89dcefe7dcde042621da7b0e48c1cb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00031","start":0,"end":189,"exact":"But Nigeria's Protection from Internet Falsehood and Manipulation Bill — known as the “social media bill” — is woefully inadequate and dangerously vague to truly make a dent in the problem."},{"@id":"urn:doxa:passage:7c367ffb3299e65779ac2f9c55778dcf2394e64f256160ab82b361cfc452a5aa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00032","start":0,"end":25,"exact":"Making the truth go viral"},{"@id":"urn:doxa:passage:4f4c3423306cf4c884d2c53c68d02835a654f90400697b9265fa3466cd2639cc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00033","start":0,"end":163,"exact":"Research shows that it is very difficult to change a person's mind once an idea gets planted and let's face it — the typical internet user often glances headlines."},{"@id":"urn:doxa:passage:319990dcddf9bc78c6bd64fcadb272e9496e38c1315c1079f3bdafed3d692491","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00034","start":0,"end":186,"exact":"AI technology can attempt to intercept fake news or hate speech but this method is often inaccurate and does not capture nuance in terms of language and cultural context, Iyer explained."},{"@id":"urn:doxa:passage:e071f7a10953e274bac656422a5222842a31a8a3cc4fb90712a838b6120c78c6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00035","start":0,"end":178,"exact":"For example, Facebook's 2020 Transparency report claimed to remove 9.6 million pieces of content that were hateful or deemed hateful in the first four months of 2020, Iyer said. "},{"@id":"urn:doxa:passage:1cb14ee908837d94707110d7d5a3d3bb5dd15bdbf4dfbde43b2dded405b134e0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00035","start":178,"end":230,"exact":"But she cautioned the likelihood of false positives."},{"@id":"urn:doxa:passage:bc69d56c107b60a5ab970b22bf5ccf9f065fd9e73c3eeb2edb4ad1edc00e826b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00036","start":0,"end":175,"exact":"Content moderators have immense power to take down anything deemed false or hateful, but Facebook does not hire adequately to handle multiple languages and cultural contexts. "},{"@id":"urn:doxa:passage:4943f3dbb7582c85bfa34482e741a06a33ae37abf2c0ab40c6be3ec5d6ed2d52","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00036","start":175,"end":237,"exact":"Also, many users are unaware of their power to report content."},{"@id":"urn:doxa:passage:aac4d22f05344794b9168e889bee5bf112d8bfc4c31a32354038ead9723914e8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00037","start":0,"end":156,"exact":"Fact-checkers also do not have the reach to sway opinion once fake news takes hold — in the United States alone, they are outspent by campaigns 100 to one. "},{"@id":"urn:doxa:passage:3f5ef67871ca385733d89dc7816c41a499eea4e79cd3c121c8c1063fc7b80ab1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00037","start":156,"end":277,"exact":"Fact-checking also varies greatly depending on a country's laws regarding transparency, data and freedom of information. "},{"@id":"urn:doxa:passage:346b5f4cb085279f251754f1bb2dd2576eaef3331c1a49d4ec46deaf6b72e21b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00037","start":277,"end":413,"exact":"In Tanzania, for example, the government has essentially prohibited fact-checking, insisting that its statistics are the absolute truth."},{"@id":"urn:doxa:passage:410b7d1a2c2babf859fe18079f708b6dd2f0b35b4fed800dc343ead5602c7989","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00038","start":0,"end":51,"exact":"How do we discourage the spread of misinformation? "},{"@id":"urn:doxa:passage:45dac4f9e265234cecc407ffa2dcf16045df3d2dbd4ddf0091fa3bd4a580a354","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00038","start":51,"end":110,"exact":"Iyer insists on disrupting fake news before you spread it. "},{"@id":"urn:doxa:passage:dfbc63c75c5a001ebe4ac8f47cc13ad93acb7f5d47c952aed7fbdb01c75ef397","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00038","start":110,"end":143,"exact":"Instead, make the truth go viral."},{"@id":"urn:doxa:decision:a9250798418eb6ae4084e7bc53ac4c38","@type":["doxa:Decision","prov:Entity"],"recordId":"a9250798418eb6ae4084e7bc53ac4c38","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:0125ef8707117e29810149054046cdfa:u_721c8dce3d6f89e24c0903c1","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:c99d389a819d4d9c76cc095e8bfb93896745557f647a5cda0753156a560ba240","urn:doxa:passage:da7ac2c8855e88a699a354fd5d8f1561aee054a1202f26554d56bb8744bc5a71","urn:doxa:passage:13539f49490c14aa1dbcc0040470a7aa13b1997590a80bf0bcfc72d37f52cee3","urn:doxa:passage:0487144dfff9ad5cd6203fddd4b6716798306ca3688025fc8cbbd0b5e73f6970","urn:doxa:passage:9aeb2a7f7c5a463cc92c2c6a58dc9119d77f672dd9a1c0eddab0e28a5d4e1e1d","urn:doxa:passage:0c62b957cb7467e83d40d7bdc25d06681a9868b3d2985f2a459d1fef4f13f483","urn:doxa:passage:c0647b2596704122478492916f598aa462239134711bdaa7a7631f5e38d78648","urn:doxa:passage:ca6ce2be028300095a4ea041eb3ff4d825c7996457f47