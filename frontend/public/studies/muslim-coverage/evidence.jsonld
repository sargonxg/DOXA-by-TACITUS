8dafe4b8d1013f","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_5ad64440b98dafe4b8d1013f","status":"accepted","fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad"},{"@id":"urn:doxa:unit:80c5cac76de53b70b4f99ff6e5a1adad:u_a9afd9f419ecbd6337e6d038","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_a9afd9f419ecbd6337e6d038","status":"accepted","fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad"},{"@id":"urn:doxa:passage:0ff89507a23c3d542651fac666c8bcb746e41cade186bb174bf6037639635a32","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00030","start":231,"end":316,"exact":"He even visited the house of a Baha'i prisoner and kissed the foot of a Baha'i child."},{"@id":"urn:doxa:passage:0766d8dbc17a07ec3b764c3193969f1aa1642c76d12210c9590dfecd9be728e6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00031","start":0,"end":208,"exact":"In the film “Lerd” (A Man of Integrity), Mohammad Rasoulof, the renowned Iranian director, addressed implicitly the persecution of Baha'is, including their expulsion from schools and denial of burial rights. "},{"@id":"urn:doxa:passage:248a227149ebc0b5e6c6406588ad0d79b735fe53500214f03594f3f4415bbb1a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00031","start":208,"end":307,"exact":"Rasoulof faced multiple arrests, imprisonment, and the banning of his films by Iranian authorities."},{"@id":"urn:doxa:passage:da2598c61d74a6856a56cd2ce41846a944ad76adddfcac3e4665bdf9b2f84f70","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00032","start":0,"end":109,"exact":"Resistance to religious apartheid isn't limited to elites; it emerges from the masses and ordinary citizens. "},{"@id":"urn:doxa:passage:b867b4144dfac0d6a38b44d3a4d8a137f0d0b346d9a9e660f9f55faeb67f0eab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00032","start":109,"end":294,"exact":"In the 1980s, the state aimed to marginalize food shops owned by religious minorities, forcing them to announce, “This shop belongs to religious minorities,” displayed at the entrance. "},{"@id":"urn:doxa:passage:02aa3a0c6455bf9daa50422e86c5a51f20594c8f133cd231f13ed8cb540d49c3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00032","start":294,"end":474,"exact":"However, this discriminatory policy failed, and many customers became more enthusiastic about purchasing from these shops, as some mention it as a civil rights disobedience action."},{"@id":"urn:doxa:passage:851e407909c58252d4e30cf863402b929a931ee3bcd5036154f926a43c94ab21","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00033","start":0,"end":159,"exact":"The history of combating religious apartheid intertwines with the fight against gender apartheid, exemplified by the “Women, Life, Freedom” national movement. "},{"@id":"urn:doxa:passage:c26b9b3eaa934f01fd9437861e0c81628bf4fe7a207fa2a36df3da73a6f52c6b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:80c5cac76de53b70b4f99ff6e5a1adad","blockId":"gv-803478-b00033","start":159,"end":289,"exact":"Iranians from diverse ethnic, gender, and religious backgrounds have collectively fought for their dignity, freedom, and identity."},{"@id":"urn:doxa:decision:1fa3889d4ccac7ab87cf5454c6a45ce3","@type":["doxa:Decision","prov:Entity"],"recordId":"1fa3889d4ccac7ab87cf5454c6a45ce3","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec