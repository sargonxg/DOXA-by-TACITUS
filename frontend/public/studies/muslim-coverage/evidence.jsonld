:Decision","prov:Entity"],"recordId":"08cb666b3f934b79965726fbd5a6539a","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:7f5b5b12d89770a1a76d111438059c1a:u_2a51a9b963c6b873b5524aa0","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:fb3328ee1dd640b7bba9ea2c264bb99cc1dc18622059d5b78936985e0c0420ee","urn:doxa:passage:6d085aaf210079ae3b6f55b503f101c552c2a553a0c41b10673074ead93e2505","urn:doxa:passage:0fe7704711dc7b05fce9d16b455e534410edef928c3f2e12c28f12b7c7461b18","urn:doxa:passage:25f473c10a4d3f0289e79e2eded1f4f5d0f161fd301092648c6e6754e4f72220","urn:doxa:passage:339eb5a892be2f80a773755ad2f4cac0f7ad9578b2aea026c83745844745d8b1","urn:doxa:passage:22aa24bef444f0f50fe87a0ca73c8e5db51ac5880b2cf29e666baa4c478c0822","urn:doxa:passage:19a5533d57e8723f9e6e4d227f1da6a665806d7deb6e9ccfc55b2db65dde6e45","urn:doxa:passage:7d9c244f219220a49a39650c3561f6131ac6b6f4405f0efbe2353755a4217c4d","urn:doxa:passage:ad39fd9228c1003a6ac15b650fbe6d6d86a771cbe7abc87ecb81684a504145d0","urn:doxa:passage:abc3bafa37561dea6c9d0d93879a995814993bc0ceaf4d4df5db7148e00e6a38","urn:doxa:passage:7a9ae548b95a9bad20fd39582669119fb1cdd5e2f16702097454e97a1ab7f2ca","urn:doxa:passage:32181f3f86f246ad1db1a10eb9d82ef7fa3b59f8de52cce8b82c59209122eedc","urn:doxa:passage:cd20bcfd95aa4d8e5b8379823b5ee77ad12377f9f8f04cc0986dac80c362dce2","urn:doxa:passage:d042f5f792f741df3cdfbec1f621ac8ed5ac166d98f17c92837e58b660ec6ed0","urn:doxa:passage:49b346ac16978ce3b7d094f2efd5f9bc13a04bd48146170b61f4724029d011d2","urn:doxa:passage:bf4b6ff78c9b0c80cdc52ec532af6705427d6e314aa796668e10095e6d708207","urn:doxa:passage:2bc47b5ae447043220a04ae8057b77afce9f7ed25f43de60c84102670bf9b8e7","urn:doxa:passage:f64650fc205fa3d0d468e2d4b1e511785240df37d638b88fbfca0f0e1ff60106","urn:doxa:passage:af679ecd0ebecd1e0e462f3c2ae4565e82a3502205a0e23fe7ab7dbca406ace7","urn:doxa:passage:128130b098cd0d578f6371dfc4af4faa47b1762ddf1e4fd130136439887e47f0","urn:doxa:passage:cf89b56a6347b88870aefc60ec54fe7437460c05a49b872eacc478d4d7eaf7e0"]},{"@id":"urn:doxa:passage:a8774ece160aa05a30340b3e5aba4529086455e23dcb7f5ca5f37e461b88a6cc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00001","start":0,"end":124,"exact":"This piece was first published by Raseef22, an Arabic media platform, on January 25, 2021, and was written by Reem Mahmoud. "},{"@id":"urn:doxa:passage:45a61527bbd8b87876e72d3498610eff861f665437db2bb94d44c1390bfcbcd4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00001","start":124,"end":189,"exact":"It is published on Global Voices via a content-sharing agreement."},{"@id":"urn:doxa:passage:426260f8abed4420235b40e368328b4a7f84eb0460201855072dc580a37b0631","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00002","start":0,"end":190,"exact":"If we were to browse the history textbooks of high school students in Egypt's state-owned schools today, we’d come across few pages about the events that unfolded during the 2011 revolution."},{"@id":"urn:doxa:passage:9de520fde66241b7be87fd370ce93509df1776fd40b4403c35e3aa8147d238bc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00003","start":0,"end":181,"exact":"Including the events of Egypt's Arab Spring in the school syllabi began in 2012, but has changed drastically over the subsequent years in concert with the country's political power."},{"@id":"urn:doxa:passage:b2fdd2340a830678467bc8c18fa553c7dfc59c83f75fce32d746661b881c7199","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00004","start":0,"end":503,"exact":"On the tenth anniversary of the 2011 uprising, Raseef22 captures how textbooks changed from detailing in great lengths all that had happened since the first eruption of the revolution, and how the squares overflowed with Egyptian revolutionaries seeking different social and political goals followed by former president Hosni Mubarak’s removal, to omitting much of the aforementioned specifics, and including “only the breadcrumbs”, as described by several of those tasked with drafting these textbooks."},{"@id":"urn:doxa:passage:c51684b49dbcba7051a19c03970e8105d93c523e6044f25287c845252ef1d2ef","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00005","start":0,"end":28,"exact":"What has changed since 2012?"},{"@id":"urn:doxa:passage:a79770639f85db5a15c537c0a15bfb76666e8859926c7568e1d4178e64a4d71d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00006","start":0,"end":429,"exact":"In the current “Modern Egyptian and Arab history” curriculum taught to secondary level students, we're told that the January 25, 2011 revolution had preludes, which manifested in “the political opposition starting in 2004 to reorganize themselves in the form of political movements and blocs that appealed to the youth in order to bring down the ruling regime at the time, and the hold of the National Democratic Party on Egypt.”"},{"@id":"urn:doxa:passage:0d50d62838028d804da1ab407efe72707bb877d523fec4538a6f026fe5a0c677","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00007","start":0,"end":242,"exact":"The revolution, according to these textbooks, also had triggers: dire economic conditions, the ongoing state of emergency imposed by law, and the rigging of the 2010 Egyptian parliamentary elections in favour of the National Democratic party."},{"@id":"urn:doxa:passage:6b4b47c3999b987de540508a822e54088a1d80f98e44628104f917832d81c488","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00008","start":0,"end":421,"exact":"After a brief segment composed of two sentences about the revolution's events, the curriculum states that one of the outcomes of the revolution — in addition to Hosni Mubarak stepping down and the Supreme Council of Armed Forces’ interventions — is “a state of instability that engulfed the country, as a result of repeated and rapid ministerial changes as part what became known as the ‘transitional caretaker cabinet’.”"},{"@id":"urn:doxa:passage:0d98408eb9835403ae223877d4d0a6d274cfc693295e0722a154db69b04934d8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00009","start":0,"end":217,"exact":"In an interview with Raeef22, Alaa Al-Iraqi, one of the most renowned history teachers in Egypt, recalled the varying frequencies by which the 2011 revolution was mentioned in Egyptian curricula from 2012 and onwards."},{"@id":"urn:doxa:passage:1dc5e12c21cae09f962590320185eb97e2e62361b4fe3a9762aefef1aaf08332","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00010","start":0,"end":181,"exact":"He said that, following the revolution, the eighth chapter of history books of the third year of secondary schools included a complete narration of the revolution and its triggers. "},{"@id":"urn:doxa:passage:245bb86e0731c19ef59c4effed6524956dd926e8610a004b15c8463d1d0990be","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00010","start":181,"end":340,"exact":"In his opinion, the description was highly-accurate and was well-received by the students, many of whom were first-hand witnesses of the events of that period."},{"@id":"urn:doxa:passage:6d407cb6ba7630d5976811fd13fa4b618701233acdeedee359429cb872ac4de5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00011","start":0,"end":435,"exact":"Al-Iraqi added that, following the protests of June 30, 2013, the curricula changed: Mentions of the 2011 revolution were superficial, former President Mubarak's achievements were removed, and the curriculum included the failures of the Muslim Brotherhood’s reign, as well as mentions of “the [2013] revolution, and how the military council — led by President Abdelfatah-Al Sisi — succeeded in getting rid of the brotherhood’s regime.”"},{"@id":"urn:doxa:passage:ad38c6ae3ad878390f1823c113c31b42825e4097220836d386de2663d14ffa14","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00012","start":0,"end":104,"exact":"Al-Iraqi says that replacing a whole chapter on the revolution with a mere few lines was a big mistake. "},{"@id":"urn:doxa:passage:1b9edaead4caedb6b5253138f2207870ccbcb1b57965b09386178a4c6b545d10","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00012","start":104,"end":291,"exact":"“It creates a void in students’ minds, especially since some of them observed the revolution and remember its events, and the parents of some of them participated in its events,” he said."},{"@id":"urn:doxa:passage:c59ceef32562c53fe3e22e995c20aae272883e790342099cea3b333459014208","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00013","start":0,"end":106,"exact":"“I hope that the narrative would shift back to the complete version that was there in 2012,” he concluded."},{"@id":"urn:doxa:passage:538373cdb5ceeb8236fc80c7d848b775dc4b812c1a82ae102712969fb972e9e4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00014","start":0,"end":43,"exact":"Insufficient documents with all the details"},{"@id":"urn:doxa:passage:9bdd961b50441f302d037e5c1b04ec27d92c6e76991139ef37109ac17e0945bd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7f5b5b12d89770a1a76d111438059c1a","blockId":"gv-730425-b00015","start":0,"end":283,"exact":"Professor Gamal Shakra, a lecturer at the University of Ain Shams and one of the editors of the history courses in Egypt's curricula, says that these syllabuses do not mention details of the 2011 uprising because of the unavailability of reliable documents on which they can rely on."},{"@id":"urn:doxa:decision:3b466d8920922fe1e272c1a76307036d","@type":["doxa:Decision","prov:Entity"],"recordId":"3b466d8920922fe1e272c1a76307036d","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:7f5b5b12d89770a1a76d111438059c1a:u_3b7b0c653529fc3f65afa3b4","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:a8774ece160aa05a30340b3e5aba4529086455e23dcb7f5ca5f37e461b88a6cc","urn:doxa:passage:45a61527bbd8b87876e72d3498610eff861f665437db2bb94d44c1390bfcbcd4","urn:doxa:passage:426260f8abed4420235b40e368328b4a7f84eb0460201855072dc580a37b0631","urn:doxa:passage:9de520fde66241b7be87fd370ce93509df1776fd40b4403c35e3aa8147d238bc","urn:doxa:passage:b2fdd2340a830678467bc8c18fa553c7dfc59c83f75fce32d746661b881c7199","urn:doxa:passage:c51684b49dbcba7051a19c03970e8105d93