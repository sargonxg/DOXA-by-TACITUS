e1c4035fc74ec6a04c92ec36e8d89dd69cc76e3f861aaae","urn:doxa:passage:da014e361bd5fe3439955fa8a464eb88bcc3caa60f4a5613d03c8e9a08f0b91c","urn:doxa:passage:92463d13a100e58206129c3ff76ea630c4c752233601f2c127a8cdb992e36fc2","urn:doxa:passage:62af12484820049fb98a66c2458854aad071bdab7d51261c63d18d3d8893dfaf","urn:doxa:passage:609fa1ce4f93b78af987fe2bd7825bcbdd0a0c73d57630ca2f6e8621753eaa12","urn:doxa:passage:04a75a1422c8fefdba43d020289c41afe82f271776e56f158f8976c8a5aa5e78","urn:doxa:passage:ff41ffb1417dc1076332546b63821695ed8b0a16ceea136e60d53e3989eece9d","urn:doxa:passage:9ab4f6f6435261c87331390a9f3084d0e59c509130d732a882264ec9a44a5658","urn:doxa:passage:86c7b585c5f2c499ed4a8e5d5dabee0a60d0913c46ae1c1b3367ddd10319a8e0","urn:doxa:passage:b4e3103bc89c4ad7f4b487662fe63a4ec70b943d29d8af833e5b96f3282e5e2e","urn:doxa:passage:7b3c18e8ee438e7cfe3bc536c3bf597a1a40395f221f28793ec82164fbcae7f4","urn:doxa:passage:bf108b7e10627d51a410e8f5cd0313bb4d9ef67e5f004a9d9f9f569ddb77438b","urn:doxa:passage:a22b0a7187ae836d079a8b895b18906d15e9cee5be127533a38acf9c3c567f72","urn:doxa:passage:553127f50c429553c0d2a559036b9a3a64fa06d05e5b7c7683a96fd6eb5558a5","urn:doxa:passage:c33f1d8c01803461b743d3fc67cf4fc1a94e8c429a2f05e3e727edf7c73a8d3e","urn:doxa:passage:f312218eda838ab2a727e9a2bb4aa343575e35331b4a220f01e8e2470cce5a21","urn:doxa:passage:f3e40f0e34182340dfadebd5320d385d81f273ca76d795a85a07528059333739","urn:doxa:passage:d7ed12ddfa689e4316e14f63200dc59d1616edafd37bbec6f5d885a1d244eac8","urn:doxa:passage:36ab0ae5e29f386dfb529ad6979dcfd8542f76ca08ff0f55a6d62ef66b3c95ef","urn:doxa:passage:872cd8ebc6cbae3fa5cb4f2a0c82472deab355ce8af8fb0fa4220acbb6407112","urn:doxa:passage:ae6b52857bbb0a47ba18d3a41b0d9aadcbaa46997525c80cd46508cef4a801c5","urn:doxa:passage:9a466b0904cd8190480410d8f91c0b19fa26f7e9a21eedbb805e015b21222d36"]},{"@id":"urn:doxa:passage:a0d46dc92ff475c684b820b11e81519c0417ec96e8849be2618a47b3e8b56037","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00008","start":224,"end":435,"exact":"In recent times the Indian government has taken down entire YouTube channels, some of which cover local events that the mainstream media ignores, leaving them with no information about why they were taken down. "},{"@id":"urn:doxa:passage:6ac6e6f4ca663afafbec1b6cf836748dbd7bad37e8522c555d492ed4e5767b72","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00008","start":435,"end":669,"exact":"Section 69A fits into a larger set of laws in India that Alok calls “lawless laws” because they are used on the whims of the government: the consequences on individuals are heavy, and there is room for neither explanation nor redress."},{"@id":"urn:doxa:passage:db32e74617ffbe485f097d07d8660c1555297d627aecc638d0f561460ccb0919","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00009","start":0,"end":159,"exact":"In Hungary, one specific law made for good but open to much abuse is the Child Protection Law of 2021, enacted ostensibly to protect children from pedophiles. "},{"@id":"urn:doxa:passage:4524a8c39b316fb46d302b5c899a78cbf7647ff5ec0e380dee32e3fdb2be32d0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00009","start":159,"end":277,"exact":"Because the law limits who is allowed to talk to children about sexuality, it is used to attack the LGBTQ+ community. "},{"@id":"urn:doxa:passage:2d7b7632f4f4c8b8143c7a883254200e87b060d98e13bbec66aab4750103dae4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00009","start":277,"end":558,"exact":"Wessenauer says, “It is enacted by banning content of any kind that is connected to the LGBTQ+ community that is made for those under the age of 18,” drawing a parallel with Saudi Arabia’s investigation of a Netflix cartoon with two girls kissing and a similar incident in Hungary."},{"@id":"urn:doxa:passage:eb18efc4957f6fc42cca58779e2d4e1a7289d11c4d96295d2e694ebfee5b4076","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00010","start":0,"end":93,"exact":"Though we’re looking at three very different contexts, there are very interesting parallels. "},{"@id":"urn:doxa:passage:66f0c3ffa9620edc451e957c5b172cdc75573ad820df5ac5f1f6edf5a0520b72","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00010","start":93,"end":197,"exact":"Martins points out that Brazil also sees a lot of policing of who can talk to children about sexuality. "},{"@id":"urn:doxa:passage:c541b578c9b1c7fa5ab96722363c3935d367640e38bc4831aea1a0dd86bc0d9c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00010","start":197,"end":359,"exact":"For Alok, what’s striking is how the government keeps choosing new enemies: Muslims, “the West,” LGBTQ+ people, immigrants… Whatever suits their current campaign."},{"@id":"urn:doxa:passage:397d22251a84b1092494260e582425df7913a71f5aec0d035e40ab992ad4ffec","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00011","start":0,"end":282,"exact":"The larger point here, and the flip side of regulating the internet, is that this enables the state to mobilise itself and erase the existence of these communities and their identities from popular culture and discussion: India is for Hindus, and perhaps Hungary is for Hungarians. "},{"@id":"urn:doxa:passage:a91e94c367f123b19000c4df78439a245ea00a44efb42d287dc17c6fd374536e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00011","start":282,"end":364,"exact":"What Wessenauer finds most upsetting is that they do it in the name of democracy. "},{"@id":"urn:doxa:passage:641e4122bd98504e337eb4e56f967f7f5ed55d842cc8927c7c8df6bc6a951300","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00011","start":364,"end":412,"exact":"“How can you argue with a child protection law? "},{"@id":"urn:doxa:passage:bbf3f307571f67a74789c8e436b3b60fad53a717d36c049607ec269a13fdc20b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00011","start":412,"end":489,"exact":"If you criticise it you become the person taking the side of the pedophiles.”"},{"@id":"urn:doxa:passage:6316f32daef01b7478253b56dcc8c9473820cfe46d8f0dc567496fe710e29fec","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00012","start":0,"end":60,"exact":"Can the big technology companies be a bulwark for democracy?"},{"@id":"urn:doxa:passage:45bac3e239316ef13cdef694c653e145a861f7dc151953ebf58a3e544e8be46c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00013","start":0,"end":132,"exact":"This provokes the question: “What are the parts of a democracy that should be working but are not that are allowing this to happen? "},{"@id":"urn:doxa:passage:01570427c44977a3dbc3fd74940fdb240c914cb7e4d5b1f0731eefdc0a5ab210","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00013","start":132,"end":235,"exact":"How is it possible that Section 66A is still being used seven years after it was struck down in India?”"},{"@id":"urn:doxa:passage:2aa47f47831e00bbe60e2de960ac4d14034d40d5410f92d652d63f0cd9b86ce9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00014","start":0,"end":94,"exact":"For Alok, one part is definitely the fact that the police and judiciary have lost their path. "},{"@id":"urn:doxa:passage:c5ea91bd404789d0eb7feb70d529743649e75d5a506dbd0e69712fe9ede72cbd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00014","start":94,"end":269,"exact":"The police in India were originally intended as a colonial force, to keep the people down and quiet, and they have not been changed at all — they even wear the same uniforms. "},{"@id":"urn:doxa:passage:fc75b483658736c80e7c2ed29c5056ba8dea0d137ea554752708c24bd3b8ab53","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00014","start":269,"end":337,"exact":"The signal: The police are here to keep the peace — for the rulers. "},{"@id":"urn:doxa:passage:2ac806a0fb59f8a6fdaab2e02dbdb318a403c9b87098886fa6163bd7888577a0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00014","start":337,"end":449,"exact":"In a democracy, the agency that holds the police accountable is the judiciary, but it has also lost its mission."},{"@id":"urn:doxa:passage:c26ebb7aa1b73d6c5fe56832dd4f88a9eb623b56fadee44eb67a03a9b2359846","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00015","start":0,"end":118,"exact":"Alok gives us an example: “Within 24 hours of being arrested in India you have the right to be heard by a magistrate. "},{"@id":"urn:doxa:passage:6589389cd7fe932539ad5f48bd975a5f4749b62210f5b6aea0cf2c97f5610c9e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00015","start":118,"end":373,"exact":"And the question they tend to ask is: ‘How many days should I send them to jail for?’ not ‘Should they be in jail?’ When did magistrates stop feeling their job was to hold the police accountable, to make the citizens’ lives easier, not the police forces? "},{"@id":"urn:doxa:passage:a5bb03c9b776aed69cd4f8d742a610425f3ef0f02c08df96a68fafe51b9e3b45","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00015","start":373,"end":402,"exact":"That is the serious problem. "},{"@id":"urn:doxa:passage:1e7ee38b19fc97bed19543f95ae203b341591a1531c8b0540a165768e3593c7b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00015","start":402,"end":471,"exact":"They don’t take the rights of citizens or the rule of law seriously.”"},{"@id":"urn:doxa:passage:7bc3f3cfb5641101b1bd1852f7e0feb7e9a78e9ac9779d627b7b859e544bb7a3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00016","start":0,"end":53,"exact":"There’s another force at work here though: Big Tech. "},{"@id":"urn:doxa:passage:3449be722441744ac47477480465804d5c831ef24bc4e83d4286a9e0f8bbaf77","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00016","start":53,"end":156,"exact":"What should or could tech companies do to support their users who are being targeted by the government?"},{"@id":"urn:doxa:passage:9dd1671c6e4d18f45a12c7034d96a1f732e1844c4857c3c9083e8c6701752f06","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00017","start":0,"end":158,"exact":"In Brazil, says Martins, it’s clear that the fake news bill did not pass because of pressure from Big Tech, both lobbying lawmakers and running ad campaigns. "},{"@id":"urn:doxa:passage:2dd472aa2d9d3c3c67a5a9d1afb9007759193f1fc7a4eec95969a7c4eb721f5c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00017","start":158,"end":208,"exact":"The companies knew which pressure points to push. "},{"@id":"urn:doxa:passage:acc61ba9571879dbe919ab537844298094bfa11c50983c40769aa21e65bd8a8c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00017","start":208,"end":266,"exact":"“Our lawmakers understand very little about social media. "},{"@id":"urn:doxa:passage:6e0c4fd8accad4b59f6b4a341c3a1dd01c96a3373514330959ec181e97f7d8e9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00017","start":266,"end":455,"exact":"This means Big Tech can run free in Brazil, which is alarming for citizens, and it is a very big market, so in turn, they have very little incentive to allow regulation to be put in place.”"},{"@id":"urn:doxa:passage:a14b0cbbb62b0dbf4a241a13c2ef45bf57d15529ecd55a7aab72955a18206788","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00018","start":0,"end":194,"exact":"Alok would be deeply sceptical of Big Tech working to support citizens and lobbying the government for regulation, but if they did so, it should be public and transparent to inspire confidence. "},{"@id":"urn:doxa:decision:318276860f9fe4457768142f9b42fd6c","@type":["doxa:Decision","prov:Entity"],"recordId":"318276860f9fe4457768142f9b42fd6c","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:dd68f730606cfcd60f1ccd5461ff2b97:u_d0ff100c60a5b7902ce6b7b2","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:a0d46dc92ff475c684b820b11e81519c0417ec96e8849be2618a47b3e8b56037","urn:doxa:passage:6ac6e6f4ca663afafbec1b6cf836748dbd7bad37e8522c555d492ed4e5767b72","urn:doxa:passage:db32e74617ffbe485f097d07d8660c1555297d627aecc638d0f561460ccb0919","urn:doxa:passage:4524a8c39b316fb46d302b5c899a78cbf7647ff5ec0e380dee32e3fdb2be32d0","urn:doxa:passage:2d7b7632f4f4c8b8143c7a883254200e87b060d98e13bbec66aab4750103dae4","urn:doxa:passage:eb18efc4957f6fc42cca58779e2d4e1a7289d11c4d96295d2e694ebfee5b4076","urn:doxa:passage:66f0c3ffa9620edc451e957c5b172cdc75573ad820df5ac5f1f6edf5a0520b72","urn:doxa:passage:c541b578c9b1c7fa5ab96722363c3935d367640e38bc4831aea1a0dd86bc0d9c","urn:doxa:passage:397d22251a84b1092494260e582425df7913a71f5aec0d035e40ab992ad4ffec","urn:doxa:passage:a91e94c367f123b19000c4df78439a245ea00a44efb42d287dc17c6fd374536e","urn:doxa:passage:641e4122bd98504e337eb4e56f967f7f5ed55d842cc8927c7c8df6bc6a951300","urn:doxa:passage:bbf3f307571f67a74789c8e436b3b60fad53a717d36c049607ec269a13fdc20b","urn:doxa:passage:6316f32daef01b7478253b56dcc8c9473820cfe46d8f0dc567496fe710e29fec","urn:doxa:passage:45bac3e239316ef13cdef694c653e145a861f7dc151953ebf58a3e544e8be46c","urn:doxa:passage:01570427c44977a3dbc3fd74940fdb240c914cb7e4d5b1f0731eefdc0a5ab210","urn:doxa:passage:2aa47f47831e00bbe60e2de960ac4d14034d40d5410f92d652d63f0cd9b86ce9","urn:doxa:passage:c5ea91bd404789d0eb7feb70d529743649e75d5a506dbd0e69712fe9ede72cbd","urn:doxa:passage:fc75b483658736c80e7c2ed29c5056ba8dea0d137ea554752708c24bd3b8ab53","urn:doxa:passage:2ac806a0fb59f8a6fdaab2e02dbdb318a403c9b87098886fa6163bd7888577a0","urn:doxa:passage:c26ebb7aa1b73d6c5fe56832dd4f88a9eb623b56fadee44eb67a03a9b2359846","urn:doxa:passage:6589389cd7fe932539ad5f48bd975a5f4749b62210f5b6aea0cf2c97f5610c9e","urn:doxa:passage:a5bb03c9b776aed69cd4f8d742a610425f3ef0f02c08df96a68fafe51b9e3b45","urn:doxa:passage:1e7ee38b19fc97bed19543f95ae203b341591a1531c8b0540a165768e3593c7b","urn:doxa:passage:7bc3f3cfb5641101b1bd1852f7e0feb7e9a78e9ac9779d627b7b859e544bb7a3","urn:doxa:passage:3449be722441744ac47477480465804d5c831ef24bc4e83d4286a9e0f8bbaf77","urn:doxa:passage:9dd1671c6e4d18f45a12c7034d96a1f732e1844c4857c3c9083e8c6701752f06","urn:doxa:passage:2dd472aa2d9d3c3c67a5a9d1afb9007759193f1fc7a4eec95969a7c4eb721f5c","urn:doxa:passage:acc61ba9571879dbe919ab537844298094bfa11c50983c40769aa21e65bd8a8c","urn:doxa:passage:6e0c4fd8accad4b59f6b4a341c3a1dd01c96a3373514330959ec181e97f7d8e9","urn:doxa:passage:a14b0cbbb62b0dbf4a241a13c2ef45bf57d15529ecd55a7aab72955a18206788"]},{"@id":"urn:doxa:decision:d44f4db4517bc0b86a76c0f51cd97260","@type":["doxa:Decision","prov:Entity"],"recordId":"d44f4db4517bc0b86a76c0f51cd97260","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:dd68f730606cfcd60f1ccd5461ff2b97:u_d0ff100c60a5b7902ce6b7b2","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:a0d46dc92ff475c684b820b11e81519c0417ec96e8849be2618a47b3e8b56037","urn:doxa:passage:6ac6e6f4ca663afafbec1b6cf836748dbd7bad37e8522c555d492ed4e5767b72","urn:doxa:passage:db32e74617ffbe485f097d07d8660c1555297d627aecc638d0f561460ccb0919","urn:doxa:passage:4524a8c39b316fb46d302b5c899a78cbf7647ff5ec0e380dee32e3fdb2be32d0","urn:doxa:passage:2d7b7632f4f4c8b8143c7a883254200e87b060d98e13bbec66aab4750103dae4","urn:doxa:passage:eb18efc4957f6fc42cca58779e2d4e1a7289d11c4d96295d2e694ebfee5b4076","urn:doxa:passage:66f0c3ffa9620edc451e957c5b172cdc75573ad820df5ac5f1f6edf5a0520b72","urn:doxa:passage:c541b578c9b1c7fa5ab96722363c3935d367640e38bc4831aea1a0dd86bc0d9c","urn:doxa:passage:397d22251a84b1092494260e582425df7913a71f5aec0d035e40ab992ad4ffec","urn:doxa:passage:a91e94c367f123b19000c4df78439a245ea00a44efb42d287dc17c6fd374536e","urn:doxa:passage:641e4122bd98504e337eb4e56f967f7f5ed55d842cc8927c7c8df6bc6a951300","urn:doxa:passage:bbf3f307571f67a74789c8e436b3b60fad53a717d36c049607ec269a13fdc20b","urn:doxa:passage:6316f32daef01b7478253b56dcc8c9473820cfe46d8f0dc567496fe710e29fec","urn:doxa:passage:45bac3e239316ef13cdef694c653e145a861f7dc151953ebf58a3e544e8be46c","urn:doxa:passage:01570427c44977a3dbc3fd74940fdb240c914cb7e4d5b1f0731eefdc0a5ab210","urn:doxa:passage:2aa47f47831e00bbe60e2de960ac4d14034d40d5410f92d652d63f0cd9b86ce9","urn:doxa:passage:c5ea91bd404789d0eb7feb70d529743649e75d5a506dbd0e69712fe9ede72cbd","urn:doxa:passage:fc75b483658736c80e7c2ed29c5056ba8dea0d137ea554752708c24bd3b8ab53","urn:doxa:passage:2ac806a0fb59f8a6fdaab2e02dbdb318a403c9b87098886fa6163bd7888577a0","urn:doxa:passage:c26ebb7aa1b73d6c5fe56832dd4f88a9eb623b56fadee44eb67a03a9b2359846","urn:doxa:passage:6589389cd7fe932539ad5f48bd975a5f4749b62210f5b6aea0cf2c97f5610c9e","urn:doxa:passage:a5bb03c9b776aed69cd4f8d742a610425f3ef0f02c08df96a68fafe51b9e3b45","urn:doxa:passage:1e7ee38b19fc97bed19543f95ae203b341591a1531c8b0540a165768e3593c7b","urn:doxa:passage:7bc3f3cfb5641101b1bd1852f7e0feb7e9a78e9ac9779d627b7b859e544bb7a3","urn:doxa:passage:3449be722441744ac47477480465804d5c831ef24bc4e83d4286a9e0f8bbaf77","urn:doxa:passage:9dd1671c6e4d18f45a12c7034d96a1f732e1844c4857c3c9083e8c6701752f06","urn:doxa:passage:2dd472aa2d9d3c3c67a5a9d1afb9007759193f1fc7a4eec95969a7c4eb721f5c","urn:doxa:passage:acc61ba9571879dbe919ab537844298094bfa11c50983c40769aa21e65bd8a8c","urn:doxa:passage:6e0c4fd8accad4b59f6b4a341c3a1dd01c96a3373514330959ec181e97f7d8e9","urn:doxa:passage:a14b0cbbb62b0dbf4a241a13c2ef45bf57d15529ecd55a7aab72955a18206788"]},{"@id":"urn:doxa:decision:1d032c192eedb843b81be35fb169226e","@type":["doxa:Decision","prov:Entity"],"recordId":"1d032c192eedb843b81be35fb169226e","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:dd68f730606cfcd60f1ccd5461ff2b97:u_d0ff100c60a5b7902ce6b7b2","attribution":"reported_speaker","speaker":"Alok","speakerStance":"unclear","documentStance":"neutral","proposition":"The government chooses new enemies, including Muslims.","hypothetical":false,"reviewStatus":"unreviewed","modelPassage":["urn:doxa:passage:c541b578c9b1c7fa5ab96722363c3935d367640e38bc4831aea1a0dd86bc0d9c"]},{"@id":"urn:doxa:decision:5793c32593012712087191a95ff0eada","@type":["doxa:Decision","prov:Entity"],"recordId":"5793c32593012712087191a95ff0eada","outcome":"uncertain","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:dd68f730606cfcd60f1ccd5461ff2b97:u_d0ff100c60a5b7902ce6b7b2","attribution":"quoted_speaker","speaker":"Alok","speakerStance":"opposes","documentStance":"neutral","proposition":"The government chooses Muslims as enemies in its campaigns.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"Alok identifies Muslims as a target of government campaigns, but the text focuses on political targeting rather than specific discriminatory restrictions or exclusion based on identity alone.","modelPassage":["urn:doxa:passage:c541b578c9b1c7fa5ab96722363c3935d367640e38bc4831aea1a0dd86bc0d9c","urn:doxa:passage:397d22251a84b1092494260e582425df7913a71f5aec0d035e40ab992ad4ffec"]},{"@id":"urn:doxa:decision:3a4b44ea113dbc252767a628272eafe2","@type":["doxa:Decision","prov:Entity"],"recordId":"3a4b44ea113dbc252767a628272eafe2","outcome":"uncertain","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:dd68f730606cfcd60f1ccd5461ff2b97:u_d0ff100c60a5b7902ce6b7b2","attribution":"quoted_speaker","speaker":"Alok","speakerStance":"opposes","documentStance":"neutral","proposition":"The government targets Muslims as part of a campaign.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"While Alok suggests a pattern of targeting various groups including Muslims, the text does not provide sufficient evidence of a repeated institutional practice specifically against Muslims.","modelPassage":["urn:doxa:passage:c541b578c9b1c7fa5ab96722363c3935d367640e38bc4831aea1a0dd86bc0d9c"]},{"@id":"urn:doxa:decision:cb261f52ff1ff15d96a0fdc5af503d58","@type":["doxa:Decision","prov:Entity"],"recordId":"cb261f52ff1ff15d96a0fdc5af503d58","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:dd68f730606cfcd60f1ccd5461ff2b97:u_d0ff100c60a5b7902ce6b7b2","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:a0d46dc92ff475c684b820b11e81519c0417ec96e8849be2618a47b3e8b56037","urn:doxa:passage:6ac6e6f4ca663afafbec1b6cf836748dbd7bad37e8522c555d492ed4e5767b72","urn:doxa:passage:db32e74617ffbe485f097d07d8660c1555297d627aecc638d0f561460ccb0919","urn:doxa:passage:4524a8c39b316fb46d302b5c899a78cbf7647ff5ec0e380dee32e3fdb2be32d0","urn:doxa:passage:2d7b7632f4f4c8b8143c7a883254200e87b060d98e13bbec66aab4750103dae4","urn:doxa:passage:eb18efc4957f6fc42cca58779e2d4e1a7289d11c4d96295d2e694ebfee5b4076","urn:doxa:passage:66f0c3ffa9620edc451e957c5b172cdc75573ad820df5ac5f1f6edf5a0520b72","urn:doxa:passage:c541b578c9b1c7fa5ab96722363c3935d367640e38bc4831aea1a0dd86bc0d9c","urn:doxa:passage:397d22251a84b1092494260e582425df7913a71f5aec0d035e40ab992ad4ffec","urn:doxa:passage:a91e94c367f123b19000c4df78439a245ea00a44efb42d287dc17c6fd374536e","urn:doxa:passage:641e4122bd98504e337eb4e56f967f7f5ed55d842cc8927c7c8df6bc6a951300","urn:doxa:passage:bbf3f307571f67a74789c8e436b3b60fad53a717d36c049607ec269a13fdc20b","urn:doxa:passage:6316f32daef01b7478253b56dcc8c9473820cfe46d8f0dc567496fe710e29fec","urn:doxa:passage:45bac3e239316ef13cdef694c653e145a861f7dc151953ebf58a3e544e8be46c","urn:doxa:passage:01570427c44977a3dbc3fd74940fdb240c914cb7e4d5b1f0731eefdc0a5ab210","urn:doxa:passage:2aa47f47831e00bbe60e2de960ac4d14034d40d5410f92d652d63f0cd9b86ce9","urn:doxa:passage:c5ea91bd404789d0eb7feb70d529743649e75d5a506dbd0e69712fe9ede72cbd","urn:doxa:passage:fc75b483658736c80e7c2ed29c5056ba8dea0d137ea554752708c24bd3b8ab53","urn:doxa:passage:2ac806a0fb59f8a6fdaab2e02dbdb318a403c9b87098886fa6163bd7888577a0","urn:doxa:passage:c26ebb7aa1b73d6c5fe56832dd4f88a9eb623b56fadee44eb67a03a9b2359846","urn:doxa:passage:6589389cd7fe932539ad5f48bd975a5f4749b62210f5b6aea0cf2c97f5610c9e","urn:doxa:passage:a5bb03c9b776aed69cd4f8d742a610425f3ef0f02c08df96a68fafe51b9e3b45","urn:doxa:passage:1e7ee38b19fc97bed19543f95ae203b341591a1531c8b0540a165768e3593c7b","urn:doxa:passage:7bc3f3cfb5641101b1bd1852f7e0feb7e9a78e9ac9779d627b7b859e544bb7a3","urn:doxa:passage:3449be722441744ac47477480465804d5c831ef24bc4e83d4286a9e0f8bbaf77","urn:doxa:passage:9dd1671c6e4d18f45a12c7034d96a1f732e1844c4857c3c9083e8c6701752f06","urn:doxa:passage:2dd472aa2d9d3c3c67a5a9d1afb9007759193f1fc7a4eec95969a7c4eb721f5c","urn:doxa:passage:acc61ba9571879dbe919ab537844298094bfa11c50983c40769aa21e65bd8a8c","urn:doxa:passage:6e0c4fd8accad4b59f6b4a341c3a1dd01c96a3373514330959ec181e97f7d8e9","urn:doxa:passage:a14b0cbbb62b0dbf4a241a13c2ef45bf57d15529ecd55a7aab72955a18206788"]},{"@id":"urn:doxa:passage:75978afdb6dd43dbe967409550e836fbc0abf4207f6ae3230140c4d7cb670041","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00018","start":194,"end":379,"exact":"There was the Personal Data Protection Bill that was an effort to reduce the power of Big Tech, which, though it had its problems, was a five-year effort that fell apart from lobbying. "},{"@id":"urn:doxa:passage:11f519c2aef3b5537ddd879d0af4a3d9a6e75c7c0ec1550a867eeab59aca82ba","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00018","start":379,"end":552,"exact":"“They may not have an army today, but given India was originally colonised by a company, I am cynical and wary of efforts from Big Tech to push back against the government.”"},{"@id":"urn:doxa:passage:52a562d3f8c0a881751931b76b99080e4a0252df321fe2a354029f3d7ae7c8c7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00019","start":0,"end":189,"exact":"In Hungary, Wessenauer tells us, the government centralised and took control of traditional media, and they have now tried to implement the same control on social media, using influencers. "},{"@id":"urn:doxa:passage:8696c080e63be1810011af5e91bae4f2ec09271f63ecbc9a3ec9cd825814f49e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00019","start":189,"end":276,"exact":"This means companies need to accept that they are in a position where they are a tool. "},{"@id":"urn:doxa:passage:c632b062fc5e234cc0a4b22e98187dfb46697bd4ef6c365f88ede6aa4ca41d6e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00019","start":276,"end":334,"exact":"This is what makes transparency very important, she says. "},{"@id":"urn:doxa:passage:edcaabb8958e64fb85d82cff1c7e5485e5a6b23e75fec5f91726d39e64617696","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00019","start":334,"end":539,"exact":"“Even if you comply, you can openly say that you are complying under protest, and make public the requests and the actions.” This is what Twitter is trying to do in India by taking the government to court."},{"@id":"urn:doxa:passage:8ef93e34537449e8d2e6ca419796a39280d627d1300b387e40176951f4ccb813","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00020","start":0,"end":206,"exact":"There are no laws around this at all in Brazil, though, which means everything has to go through the judiciary, even something as small as finding out information about one small thing, Martins points out. "},{"@id":"urn:doxa:passage:851b2440cb98ed7102bd213916d8ba017df7cfb190c480826fd4abfba615f3a0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00020","start":206,"end":273,"exact":"“But it must be said platforms tend to push back against requests. "},{"@id":"urn:doxa:passage:4960edca3281a3d3ab1144646a737d50bfa0da206ce02dd5faab63353c97118e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00020","start":273,"end":497,"exact":"I think that platforms, especially after Trump, are very aware of what is done with their tools and that they might have to go to the point of taking down an account — for example, if Bolsonaro says the election was stolen. "},{"@id":"urn:doxa:passage:9c615e49f95ff38f41c590787c9bd781b893ade9e172b8a4f6d87376f0fe806a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00020","start":497,"end":527,"exact":"But they won’t say so openly.”"},{"@id":"urn:doxa:passage:857ef3f884390c57f3c96802d43702b8dbb0edd3144137c14d1a9cc48628d4bd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00021","start":0,"end":314,"exact":"Whether it is the administrative challenge to just find out why something is taken down or a political reason that leaves people in the dark about what has happened to their expression online, tech companies can help by institutionalising transparency at least for users to find out what happened to their content."},{"@id":"urn:doxa:passage:388945b61bf6a3092d330cfc621e8d625b0014b70521611d010453c753658c62","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00022","start":0,"end":120,"exact":"Sometimes it can seem like a neverending protest, but we have to keep speaking up, raising our voices, says Wessenauer. "},{"@id":"urn:doxa:passage:62704e80800c2e55b683ce38bfca590bd7ecf8d2a5142a7e2bc432f984c0a412","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00022","start":120,"end":261,"exact":"“It’s cliche, but silence is what enabled the Nazis.” Martins finds it hard to find optimism though she tries not to see things as binaries. "},{"@id":"urn:doxa:passage:941f9ce37279840fb273cbd2e447f941bec955500bb99834ca826eee3cf3fcd5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00022","start":261,"end":351,"exact":"“I’m worried about democracy in Brazil and even if we retain it, how can we move forward? "},{"@id":"urn:doxa:passage:c174c24aa44349ae9b86e8a940b3ac806b95ba824114efca5b587dfaf6d20a05","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00022","start":351,"end":583,"exact":"As a journalist, I can educate people about what’s at stake.” Alok, for his cynicism about tech, is the most optimistic, saying that we rarely ask “What can be built?” Not everything needs vast resources; it is okay to start small. "},{"@id":"urn:doxa:passage:2b89380f754906f0c0cdd5da3f37079668fc1315dbc3c7d30be480a1fd4ade7a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00022","start":583,"end":634,"exact":"“Can we build better institutions and governments? "},{"@id":"urn:doxa:passage:81df864f11639e1fddb30fe94e55bef11a14b8e7bf2fcd3dd7d5a726bc75cd0c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00022","start":634,"end":759,"exact":"Because actually, governance rises up, it doesn’t trickle down.” What we need to do is stay alert, educate, and build better."},{"@id":"urn:doxa:passage:ff3b277e7b6b819c8b562f3429531fa7eb6f9f7fa54c49e1fc6b935387f25ab3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00023","start":0,"end":37,"exact":"Watch the full discussion on YouTube:"},{"@id":"urn:doxa:passage:8fddf6e3869ed7b137b5505e4f285a3d8243e8d06fb19a6f423fcbe0bfed675b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dd68f730606cfcd60f1ccd5461ff2b97","blockId":"gv-772751-b00024","start":0,"end":73,"exact":"Please visit the project page for more pieces from the Unfreedom Monitor."},{"@id":"urn:doxa:decision:a2e1b2ed90f5d22f5330fab7567364cb","@type":["doxa:Decision","prov:Entity"],"recordId":"a2e1b2ed90f5d22f5330fab7567364cb","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:dd68f730606cfcd60f1ccd5461ff2b97:u_eb7f95f1afdc35898472b6c9","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","u