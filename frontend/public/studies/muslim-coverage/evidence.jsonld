ge:370ce01ce1e6959dd2818d34b8a5fd46ffd34292bf173d7536fe185a04af6f02","urn:doxa:passage:6c307b42c400a4f80698ec8bbcbe9451fc6a4adba1d0f96cd65ec56b63560c05","urn:doxa:passage:1544aaa6cd98eafbb80ffa497bb439cfa5cfc945317fadbe117dc1f3c99bcc24","urn:doxa:passage:d1a52f4a4ee004999409de3cf07df788a4df6013ed29bffd2fb3c471884b3060","urn:doxa:passage:6c65364256d78ad51c15de7fccf63550cf99a9c69b2d4dbc523f189ce23f6f0f","urn:doxa:passage:71584db32b62f4008e565aebade91ebc65df5a1ff752baa0bb1c367c3c8a5c2b","urn:doxa:passage:db3cf0361e8d676f784454c9e3fe29b782e92c3577d7dab5287c4bf81e864094","urn:doxa:passage:6031c26f2a138eb8f2ebe4440e76b8e2a4ec59d45144f318f663bee95d15ab84","urn:doxa:passage:e2db32cd371ea4f75496028c3e9dcce1b99561fb5d1076d6ae63f65a15e16ac5","urn:doxa:passage:2aa65cac5df0133bf53f55bda6719464eba16657ffb94c25532ebf5a2487f6c1","urn:doxa:passage:817a9eb56631ab909c40b88a3bdb81f175d044b79f24ad56bfbdc01c28d296b3","urn:doxa:passage:61763001300db9ccd95204648b65663d3b86fa7a3ce2f321fcafcaa50d918920","urn:doxa:passage:6eff90df9d959581e61ae76b2f758e5e7584c68b3658e971de70b6a637a9dc3f","urn:doxa:passage:a4b2cfa0f59cb6d9517cd1680e405053b866794012cdfda11996d2f5115c1f90","urn:doxa:passage:e00dc8bd6c258fccedd53ac68da1e5967b2d8b5ee10af22842a98920081c0ac6","urn:doxa:passage:4db815d4a3fe4c895e17d4827914268eeb3f8187c4582494b0313eaad5f4d3f9","urn:doxa:passage:2ff461bb1be8521ae8e7571f77306a9891da894e2d6473968045fdfbbb3ae581","urn:doxa:passage:b11a5b2d979a2cc5d994e927b77b485456ed8a056cb5b64996daad8d79123698","urn:doxa:passage:8a992a6314f7cb5fec694f1feac8667061177ed4d690f2baf501af26fa85d16b","urn:doxa:passage:b4837e00d97044afa03fbfdf2faf6470223142b1f358a753457132a4793f2ad9","urn:doxa:passage:749553c37eee6e188d8e22547da2a16ad3f47fa57e26977f525f4556beb5b155","urn:doxa:passage:4a6c5763300a0c33e18ac820c65f0a215705308ec7b817555b8d6c08f3c35cc0","urn:doxa:passage:917512e71d438af1c683b1b115bd7237c6e5a085b5abed30b231ff3e49bd6ddf","urn:doxa:passage:3cff82a740ed18990fa505c4ea1c81096a2f66c43e3afaac9eec16f163683ee8","urn:doxa:passage:e6594877f4c226555a84edc9e821c44242121dae1b106f32f60d84457f8b996e"]},{"@id":"urn:doxa:passage:a94537d8c90b52e2d7896e659ecd7b2987dd8e246bc21c8a1bb49d90221165c8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00011","start":235,"end":360,"exact":"This attention has, to some extent, protected him despite his notoriety — at least until the August 2020 attempt on his life."},{"@id":"urn:doxa:passage:bf4cf4e86a51a1a707f81cf68e3c4744557f08bd48e9a64092df2e33f4bbda46","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00012","start":0,"end":249,"exact":"Global Voices spoke to Almut Rochowanski, a human rights expert focusing on the post-Soviet space and the impact of Western foreign policy on the democratization of that space, to understand why many Western voices downplay any criticism of Navalny:"},{"@id":"urn:doxa:passage:89cf52aab4cf6b885188571d6a29a4f40903126c5cf71062f068f522c4ebc1be","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00013","start":0,"end":186,"exact":"> [This tendency] comes from an assumption among post-Cold War Western policy-makers they should have control or at least influence over Russia’s leadership and bend them to their will. "},{"@id":"urn:doxa:passage:0c46c5dbba85264dc4b8de8ad8e187d4da13c2ca7f7db47feab3e1ca4a826575","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00013","start":186,"end":380,"exact":"This definitely became reality in the 1990s, when Western policy-makers imposed their will on Russia in foreign and security policy and internal reforms, and from then on they came to expect it."},{"@id":"urn:doxa:passage:df0c60c923905bea7cdcc9cf20a143b0d34779be47c97559d67ecd45a71a5606","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00014","start":0,"end":140,"exact":"> When Putin arrived on the scene, this influence abruptly ended; Russia was no longer ‘rolling over’ for Western foreign policy interests. "},{"@id":"urn:doxa:passage:d32bb522312a04ec6a5b3e7c1bdb3f5ac2b030d3cbb1ae4e37bec32ee04a3139","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00014","start":140,"end":386,"exact":"This new status quo has lasted intolerably long in the eyes of Western policy makers, and the longer it lasts, the more desperate the grasping for someone new becomes, and that means they are more and more ready to overlook anything problematic. "},{"@id":"urn:doxa:passage:90400de353d2b53293a807606619e829c6053e174fa84a33a8a7269f47416652","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00014","start":386,"end":546,"exact":"Interestingly, Western policy-makers even turn a blind eye to the fact that Navalny’s foreign and security policies run directly counter to Western objectives. "},{"@id":"urn:doxa:passage:8f8c1f5730639fc758ec7b06baedacd4c0d91083c55ce4110e8d32201e2e10c3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00014","start":546,"end":602,"exact":"He supports Russia’s annexation of Crimea, for example. "},{"@id":"urn:doxa:passage:df90e45b7ac64e303668a2e22fa7ff01d4fd2dfb2bbda7f8f043c82e6c36cea8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00014","start":602,"end":641,"exact":"Maybe they think it’s worth the gamble."},{"@id":"urn:doxa:passage:4da27e4347d05ecd668172a4c0f78260ae8e1f3e823b838b054fdcd99c5bc9dd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00015","start":0,"end":247,"exact":"Rochowanski thinks this stance of the end justifying the means is shared by many Russian liberals — as seen in one of the popular slogans Navalny's supporters use in street demonstrations — which also contributes to making him an untouchable icon:"},{"@id":"urn:doxa:passage:1713e7611cc1bdc9a9c9295712f07664c31e7320ecb4697d70983b51e592cf8a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00016","start":0,"end":205,"exact":"Global Voices interviewed Aleksey Shlyapuzhnikov, an outspoken critic of Putin who runs an independent media output in the city of Vladimir, in Central Russia, who calls for caution with regard to Navalny:"},{"@id":"urn:doxa:passage:15067d03cf8f948a0d4d0fedc0441c2a51d019787a4e54be4711788ebe58d68a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00017","start":0,"end":341,"exact":"> Многим наблюдателям, включая меня, кажется довольно опасной тенденция единственного лидера российской оппозиции идти на поводу у самых низменных, но при этом самых массовых стереотипов российской политической действительности. Крайне опасно стремление потворствовать низменным чувствам широких слоёв населения, в стремлении понравиться им."},{"@id":"urn:doxa:passage:c1578e251ad154fd67f55969c17ddc998c54bd5c9f5beb5ca156d57d38d45aab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00018","start":0,"end":192,"exact":"> Many observers, including me, consider the tendency of the single leader of the Russian opposition to fulfill the basest and widely shared stereotypes of our political reality as dangerous. "},{"@id":"urn:doxa:passage:bd1ebd6c575979b5ffe119c3fe83203047b886c7247a957f5586a1f665dafc44","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00018","start":192,"end":320,"exact":"What is extremely dangerous is to flatter the lowest feelings of the majority of the masses in the hope that they will like you."},{"@id":"urn:doxa:passage:102a5f7b3346f8ad9884b39f5644deadb8ca4a39a94af6a15d311ac760311de1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00019","start":0,"end":112,"exact":"While Rochowanski agrees that people who have been unjustly jailed should absolutely be released, she cautioned:"},{"@id":"urn:doxa:passage:e8dc8ca3b66a1300a7776172fc4a4c84b8af07b19e86c3163f090bae444934dc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00020","start":0,"end":206,"exact":"> We should never lionize anyone or make excuses for their actions, because we consider them useful (meaning, for Western policy-makers), or because they might oppose someone we find even more unpalatable. "},{"@id":"urn:doxa:passage:fdf0b4187fb8daf4e0ee798e6996130c5a23dbeb3c1d720eab95191a4afbbfab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00020","start":206,"end":254,"exact":"It’s not only immoral, it also never ends well. "},{"@id":"urn:doxa:passage:6720450fb23b7bba1421ebafd8107bc2f58c418b5febb325252dd8705aa14019","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00020","start":254,"end":351,"exact":"Think Western support for Yeltsin’s armed crackdown of parliament in 1993, and what that led to. "},{"@id":"urn:doxa:passage:9325eccc2da06dc0867f029b09427bd700983e6503724ed77fcb075e37084a6b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00020","start":351,"end":449,"exact":"Racism, antisemitism, Islamophobia are inherently incompatible with democracy and the rule of law."},{"@id":"urn:doxa:passage:1aac7442d09edc41c9b5d67ed4a48f96a0fef8de56fd0a8c299c28a04167ef74","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00021","start":0,"end":279,"exact":"> If you deny people of different religion, ethnicity or colour their very humanity, if you propose to use violence against them and eliminate them, then you’re incapable of building a democratic, rights-based system — anywhere, but especially in a country as diverse as Russia. "},{"@id":"urn:doxa:passage:c0a7fb878b60902ad81859f8e7f9bd26041f0c3d36c0af908507950e28471d89","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00021","start":279,"end":411,"exact":"So my critique of Navalny isn’t about minor political differences, like flat versus progressive tax rates or the right pension age. "},{"@id":"urn:doxa:passage:bd8372ad21b0a53d563432d53155fd083078cb76a35e36337d8f417e95bd7b88","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00021","start":411,"end":453,"exact":"This is about the very heart of democracy."},{"@id":"urn:doxa:passage:a1ea38640a369a649408947b7204a26a017c28ce8e694234bd5368c0d6a431a6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00022","start":0,"end":143,"exact":"Editor’s note: This is a two-part analysis on the perception of Russian opposition politician Alexey Navalny from a Central Asian perspective. "},{"@id":"urn:doxa:passage:cd7d26a0336665f18b950002203dd22c29bbf39164efd454f43761190c2a4eb1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00022","start":143,"end":160,"exact":"Read Part 1 here."},{"@id":"urn:doxa:decision:5024201699f502a453f8080784b5a21b","@type":["doxa:Decision","prov:Entity"],"recordId":"5024201699f502a453f8080784b5a21b","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:004d6aa176feec8766c4365507c3e92d:u_bff171b96c9218ac711cc058","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:a94537d8c90b52e2d7896e659ecd7b2987dd8e246bc21c8a1bb49d90221165c8","urn:doxa:passage:bf4cf4e86a51a1a707f81cf68e3c4744557f08bd48e9a64092df2e33f4bbda46","urn:doxa:passage:89cf52aab4cf6b885188571d6a29a4f40903126c5cf71062f068f522c4ebc1be","urn:doxa:passage:0c46c5dbba85264dc4b8de8ad8e187d4da13c2ca7f7db47feab3e1ca4a826575","urn:doxa:passage:df0c60c923905bea7cdcc9cf20a143b0d34779be47c97559d67ecd45a71a5606","urn:doxa:passage:d32bb522312a04ec6a5b3e7c1bdb3f5ac2b030d3cbb1ae4e37bec32ee04a3139","urn:doxa:passage:90400de353d2b53293a807606619e829c6053e174fa84a33a8a7269f47416652","urn:doxa:passage:8f8c1f5730639fc758ec7b06baedacd4c0d91083c55ce4110e8d32201e2e10c3","urn:doxa:passage:df90e45b7ac64e303668a2e22fa7ff01d4fd2dfb2bbda7f8f043c82e6c36cea8","urn:doxa:passage:4da27e4347d05ecd668172a4c0f78260ae8e1f3e823b838b054fdcd99c5bc9dd","urn:doxa:passage:1713e7611cc1bdc9a9c9295712f07664c31e7320ecb4697d70983b51e592cf8a","urn:doxa:passage:15067d03cf8f948a0d4d0fedc0441c2a51d019787a4e54be4711788ebe58d68a","urn:doxa:passage:c1578e251ad154fd67f55969c17ddc998c54bd5c9f5beb5ca156d57d38d45aab","urn:doxa:passage:bd1ebd6c575979b5ffe119c3fe83203047b886c7247a957f5586a1f665dafc44","urn:doxa:passage:102a5f7b3346f8ad9884b39f5644deadb8ca4a39a94af6a15d311ac760311de1","urn:doxa:passage:e8dc8ca3b66a1300a7776172fc4a4c84b8af07b19e86c3163f090bae444934dc","urn:doxa:passage:fdf0b4187fb8daf4e0ee798e6996130c5a23dbeb3c1d7