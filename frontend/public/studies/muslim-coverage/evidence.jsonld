e60ac1bd","urn:doxa:passage:aafd9e7b13331b626f6ad4712ac6daf15d87df84f400aabd94b748b1d68fd33f","urn:doxa:passage:4c33b7a4634eab86d9751cab9e4c25e92c364e224b57e38267c5969678a436ed"]},{"@id":"urn:doxa:source:0125ef8707117e29810149054046cdfa","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-709956","title":"A new game plays with ideas about how disinformation works in East Africa","author":"Amanda Lichtenstein","translator":[],"publishedOn":"2020-06-16","sourceUrl":"https://globalvoices.org/2020/06/16/a-new-game-plays-with-ideas-about-how-disinformation-works-in-east-africa/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"4d2d42b691a55f470c9eead9203ac45a5447066276ead3ad966c866dc59f09ad","textSha256":"7873f5d9a738eef9b46059afc4bebc7702e6005a9fa62904d4654582e688bfb8","archivedRecordSha256":"d2fae6903a52b8ef27b49919e31534eb5835ad95d1c88bc2887d93605f8abbe6","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:0125ef8707117e29810149054046cdfa:u_165675460f1ee2ad5f883f30","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_165675460f1ee2ad5f883f30","status":"accepted","fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa"},{"@id":"urn:doxa:unit:0125ef8707117e29810149054046cdfa:u_721c8dce3d6f89e24c0903c1","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_721c8dce3d6f89e24c0903c1","status":"accepted","fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa"},{"@id":"urn:doxa:passage:bf8d30398e3e664eb477f1027f0b2144933b0c8ea81bb305e130064a2c6887eb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00001","start":0,"end":155,"exact":"Disinformation — intentionally “fake news” — is a chronic problem everywhere in the world, but the COVID-19 pandemic has exacerbated information overload. "},{"@id":"urn:doxa:passage:9dcd267c65875a5e4628c080816af8bef95fc8899f905c9b9979b8020e1df1a3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00001","start":155,"end":331,"exact":"From fake coronavirus cures to misleading information about mandatory vaccinations that have stoked fears worldwide, it has become increasingly difficult to suss out the truth."},{"@id":"urn:doxa:passage:dadbd9afccd20dc6a2f8ef51e73bbadf27752ca2c6e0ed0b38c23ee8b55d507f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00002","start":0,"end":213,"exact":"All it takes is the click of a “share” or “forward” button for disinformation to become misinformation that spreads like wildfire through personal networks on applications and platforms like WhatsApp and Facebook."},{"@id":"urn:doxa:passage:6f47a9005ed0ecff01447876ff5a95f7d66aae1a4e529b8c64a4d54ee6947a8e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00003","start":0,"end":147,"exact":"Across Africa, where internet penetration is still relatively low at about 40 percent on average, many users are coming online for the first time. "},{"@id":"urn:doxa:passage:37b6a3cb88c411c07cdf957172afe46a2c07fd8f2553e7001d7651d20dca20f5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00003","start":147,"end":308,"exact":"And around the world, many internet users, whether experienced or not, lack the digital literacy tools necessary to distinguish trustworthy news from false news."},{"@id":"urn:doxa:passage:0ea759ce60dad8baf73a32cfc8383d21ec361ce20729f121baf6329c45e4efdb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00004","start":0,"end":57,"exact":"How can all internet users become more discerning online?"},{"@id":"urn:doxa:passage:119a24f28dc560f05e492d8457db8377c30ce6c6f44f6fec210601ba5053c086","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00005","start":0,"end":266,"exact":"This is the main idea behind “Choose Your Own Fake News,” a web-based game exploring how disinformation spreads across East Africa, created by Neema Iyer, founder and director of Pollicy, an Uganda-based organization supporting civic technology across the continent."},{"@id":"urn:doxa:passage:ee857bbfbe4122d31b432ed0cde0c32aafbe9c66cb27a675dd4aceaaaace1e25","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00006","start":0,"end":84,"exact":"Iyer explained the motivation behind her game in a Mozilla Foundation press release:"},{"@id":"urn:doxa:passage:b35782842ba1eb32f4d585885c13298f2954bea501178b5177128c15f2cd258e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00007","start":0,"end":55,"exact":"> Online misinformation has real implications offline. "},{"@id":"urn:doxa:passage:ab2926986c2922ef541e89157b777ba6c8eeb2d84d56ac228cc8f7f8c1083c37","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00007","start":55,"end":126,"exact":"It can threaten people’s lives, freedom of expression, and prosperity. "},{"@id":"urn:doxa:passage:da1abad9fa98ac551a00a39b685fadcc6d01c2d72acdc39e3c58fec9bd76f790","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00007","start":126,"end":313,"exact":"This is especially true in parts of East Africa, where people are coming online for the first time and don’t yet have the proper context to distinguish what’s trustworthy from what’s not."},{"@id":"urn:doxa:passage:a5d627541f10bfd1a722df74ee40143d6a47a829fc4703011aab085e366296a0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00008","start":0,"end":37,"exact":"‘Did you see that video on WhatsApp?’"},{"@id":"urn:doxa:passage:045b7a88b42d26fc0d0699b9f78c300fd7a459877cb7d2be5bf98ab0bc18a686","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00009","start":0,"end":147,"exact":"“Chose Your Own Fake News” teaches new internet users how to be more discerning about the information they receive and encounter in digital spaces."},{"@id":"urn:doxa:passage:5fbc99d113565168ea338f52ff7b5d96e81296e95e2a3ebde522c1d1cfdd563e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00010","start":0,"end":147,"exact":"Players select one of three characters in East Africa: Flora, a job-seeking student, Jo, a shopkeeper, or Aida, a 62-year-old retired grandmother. "},{"@id":"urn:doxa:passage:c8382e2b965285ea9329b93774953bfe689ee500fdb9a9b91c66a7184b26ab7e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00010","start":147,"end":252,"exact":"Players then scrutinize news headlines, videos and social media posts through the lens of each character."},{"@id":"urn:doxa:passage:ff27106b0317b55b8d42737c4a0b05ad5f4ec825cb61da899a9a5806060b9a12","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00011","start":0,"end":215,"exact":"“Players’ decisions make the difference between correctly debunking disinformation — or falling victim to fraud, hospitalizing a loved one, and even accidentally inciting a mob,” the Mozilla press release explained."},{"@id":"urn:doxa:passage:d7412aa0893572759b3315fe7edf628149bf3a6e2ef1a64f35ac5cfac613128d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00012","start":0,"end":248,"exact":"As players follow their character's various decisions, the game provides detailed information about how dis- and misinformation work, highlighting the role that individuals play in intercepting false or unverified information before they spread it."},{"@id":"urn:doxa:passage:7f8185f0585d0476b8b59d4a0ee538d065f04aca7f341e9550e0732e33d9f993","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00013","start":0,"end":129,"exact":"For example, Aida receives a forwarded message from her cousin with a video of a child crying after receiving a measles vaccine. "},{"@id":"urn:doxa:passage:6ce400e53128edda2f5f4a757b4b596d8f8adbe7b0f00a65f014d338a68f41c6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00013","start":129,"end":159,"exact":"Should Aida share that video? "},{"@id":"urn:doxa:passage:656075a013b1328ba439d02ec7f8ed7cd57538b954f5c99074e7721fc25665fc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00013","start":159,"end":242,"exact":"Measles is vaccine-preventable but cases continue to soar due to false information."},{"@id":"urn:doxa:passage:89fa33ed574c536ca4b43ef7618bf08b8b87366e065400be28f8234b9cb4f9f3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00014","start":0,"end":169,"exact":"“Platforms like YouTube and Facebook recommend and amplify content that keeps internet users clicking — even if it’s radical or flat-out wrong,” Mozilla Foundation said."},{"@id":"urn:doxa:passage:8b161d8a54c99c2d913e3471877fd74ee099c9d943fcbbbbf3a185577aa470e8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00015","start":0,"end":28,"exact":"Forward-forward-forward-stop"},{"@id":"urn:doxa:passage:90aff434c806d082183a9c7415882298a2c52fc7550927a9f4944c471764b973","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00016","start":0,"end":270,"exact":"In Season 2, Episode 3 of “Terms and Conditions,” a new podcast exploring digital rights in Africa, Neema Iyer speaks with digital rights activist Berhane Taye, to look at the history of online disinformation in Africa and how it intersects with bots, trolls and beyond."},{"@id":"urn:doxa:passage:c4eb6e1ac8c22a01bace9a77d8f7a1ad6cdea70b6a241dc347c59946c45237aa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00017","start":0,"end":103,"exact":"Iyer and Taye talk about the potentially dangerous consequences of a seemingly simple forward or share."},{"@id":"urn:doxa:passage:333dd90b1063e2be810a9a3955281ad5362e5d22287f3521a9fc83195b75893c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00018","start":0,"end":86,"exact":"The internet is riddled with bots — a software application that runs automated tasks. "},{"@id":"urn:doxa:passage:0995ec9ae9e7cd84a1a9086081bbedd4fa341493691abceddf7a4e43827a95d8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00018","start":86,"end":204,"exact":"Iyer estimates that up to half of all online activity is run by bots designed to influence and shape opinions online. "},{"@id":"urn:doxa:passage:d6610f8e665a5972f0d79680967c334ef485dab49eff89b8127062228c1561f6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00018","start":204,"end":280,"exact":"Trolls — real-life people — also disrupt, attack and offend with intention. "},{"@id":"urn:doxa:passage:11411f6e890da4533a26e3b4067c74a9ccdbcfb02b54e6eeea61cecc50dd074b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00018","start":280,"end":352,"exact":"Deepfakes — radically altered videos — can often make fiction seem real."},{"@id":"urn:doxa:passage:46887022329a1d6ebcb1b7bc7bed06a1e4776c1acba594a7cbbe4d708ccba77a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00019","start":0,"end":138,"exact":"This mixture of online agitators contributes to disinformation that ultimately causes chaos, discord and polarizes communities, said Iyer."},{"@id":"urn:doxa:passage:fab494c68877366c18ad04499644ada58ea194fd9aae631cccf4342dda15aad0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0125ef8707117e29810149054046cdfa","blockId":"gv-709956-b00020","start":0,"end":149,"exact":"To complicate matters, many internet users are “unwitting agents” who amplify false information without realizing it, writes Kate Starbird in Nature."},{"@id":"urn:doxa:decision:bb2b30e2702c4c47846808308e09d34e","@type":["doxa:Decision","prov:Entity"],"recordId":"bb2b30e2702c4c47846808308e09d34e","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:0125ef8707117e29810149054046cdfa:u_165675460f1ee2ad5f883f30","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:bf8d30398e3e664eb477f1027f0b2144933b0c8ea81bb305e130064a2c6887eb","urn:doxa:passage:9dcd267c65875a5e4628c080816af8bef95fc8899f905c9b9979b8020e1df1a3","urn:doxa:passage:dadbd9afccd20dc6a2f8ef51e73bbadf27752ca2c6e0ed0b38c23ee8b55d507f","urn:doxa:passage:6f47a9005ed0ecff0144787