db53a8dca3e62cd3b2e5a84a3c69e58cba265b7ec","urn:doxa:passage:f441f40e64cbf9d262aff42793f610950fe49e488761c7df8694139cc44ac236","urn:doxa:passage:bb3668c362727139f774244be446af903caceb548a5cf609da2ca7fc59fc4306","urn:doxa:passage:ffb7bae9276e9c76de8290ada42a3196ae11e20839600be06498a44ca04c2a10","urn:doxa:passage:7e49b26a8b98c81e04506a65f4dcc4dc27d7ce19e41d6cbac2eb2cd2522cc4e5","urn:doxa:passage:7e77ec159385d44e68be270b25dd999ba3ab8692e337f139f8cd863531ab8dcc","urn:doxa:passage:3935b75eff375327228c38eecb5b888e9d6658b6ab395a24a5ce4d2a0dba96b0","urn:doxa:passage:4281d923e8c1067c15caa9b959635db4825c7b29d29db14baa0ecd6ea939d121","urn:doxa:passage:f82a163056ede100cbcccca4d8ec619f5435ed17b0598980e634443498d4f437"]},{"@id":"urn:doxa:passage:1c1718156e8e3c2c2b0fe8d19953a0d1b0f9b36a42bd125e4be8560e67310d4c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00001","start":0,"end":138,"exact":"Across Tanzania, thousands of people are crowding into stadiums, airports, and curbsides to catch a glimpse of the late President John P. "},{"@id":"urn:doxa:passage:672b8fc0745dd29c136e8dfc3bdec1b5d569e16fbed30830f0fb3bd34bdf179b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00001","start":138,"end":331,"exact":"Magufuli, as his body is flown for week-long ceremonial processions in Dodoma, the capital, the islands of Zanzibar, Mwanza, and Chato, his home at Lake Victoria, where he will be laid to rest."},{"@id":"urn:doxa:passage:5768c1208d127c7ea6c1501f03c90091cbb97ae55a68724b1ee9065605983ffb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00002","start":0,"end":199,"exact":"Magufuli was announced dead at the age of 61, on March 17, in a speech on national TV by then-Vice President Samia Suluhu Hassan, ending weeks of speculation about his health status and whereabouts. "},{"@id":"urn:doxa:passage:9cc613acdf83f882486655e8fd55e208181b0c9710e0aadfb59de9d3b91fa598","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00002","start":199,"end":246,"exact":"He allegedly died of a chronic heart condition:"},{"@id":"urn:doxa:passage:7ff09a24328b68a90b6f4a6f3bf2696ea6094255e7bf2caee458af742906a851","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00003","start":0,"end":74,"exact":"> Death announcement for the president of the United Republic of Tanzania."},{"@id":"urn:doxa:passage:f35d10c66764ad422194a44464506a88d7a95f294f162e6d3b16c4d80a913c2f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00004","start":0,"end":145,"exact":"Magufuli’s sudden death has, however, left Tanzanians, and others, speculating about the future of politics and power in the East African nation."},{"@id":"urn:doxa:passage:5495b835a9f350fe8528ce68b927d261b1e3d6a3666c355f631091721db80e27","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00005","start":0,"end":247,"exact":"On Friday, Hassan was sworn in as the sixth president of Tanzania, making history as Tanzania’s first female president, the first president born on the semi-autonomous islands of Zanzibar, and Tanzania’s first Muslim woman serving in the top role."},{"@id":"urn:doxa:passage:fe5c102164883cd3503a6b2df30b08a9d8b58436f9999945acff321d27e45683","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00006","start":0,"end":105,"exact":"Under Tanzania’s constitution, Hassan will serve the remainder of Magufuli’s five-year term through 2025."},{"@id":"urn:doxa:passage:1d7cb04635b7351eabd47808106ea47ecc664e00b2711b483f7a7052f146566d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00007","start":0,"end":122,"exact":"In a short video clip, widely circulated on social media, Hassan dismisses any doubt about her ability to lead as a woman:"},{"@id":"urn:doxa:passage:bbf8a7a0fbadce1467271ed4cedc59720c883fd62f958e93f22238085e156ebc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00008","start":0,"end":336,"exact":"> For those who have doubts that this woman will be able to be the president of the United Republic of Tanzania I would like to say to you that this person standing here is the president. [applause] … I would like to repeat that this person standing here is the president of the United Republic of Tanzania, [and] happens to be a woman."},{"@id":"urn:doxa:passage:a112ebc0f507fdee3bf8af597b6d8eabceb0bbf69530d7300a461d1118f09fd9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00009","start":0,"end":86,"exact":"As Tanzanians mourn Magufuli and process this sudden shift, many have welcomed Hassan."},{"@id":"urn:doxa:passage:ab950290f129a5e42ea1189f18d61e6aa5c7c5152b65a91aa59e6971bb0e7dea","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00010","start":0,"end":150,"exact":"Opposition politician Zitto Kabwe, party leader for ACT Wazalendo, finds hope in Hassan’s history of activism and work as a “member of civil society.”"},{"@id":"urn:doxa:passage:21e3e05fdf2936cec0c864eb0a977c45ea699e5b7331b3950da3412c5bb56c8a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00011","start":0,"end":159,"exact":"> A very nice history of President @SuluhuSamia in 20 minutes, shared by herself [in her own words.] She says she was an “activist.” She was a public servant. "},{"@id":"urn:doxa:passage:c5457d4a189a0465e1d6aebe9a1a911cd698a551014ada9e8af72e9603aa06b3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00011","start":159,"end":201,"exact":"Thanks Chambi for making sure I see this. "},{"@id":"urn:doxa:passage:6bf79041d50686ce9b50d097eb4021e69de69bd7ed5a070ea9acad00c0b84424","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00011","start":201,"end":222,"exact":"Don't fail to listen."},{"@id":"urn:doxa:passage:e084722390f6a639fcc07b483f50cdf1faa5bee39ba97da831fdf500fb191356","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00012","start":0,"end":240,"exact":"Whereas Hassan is commonly known as a consensus-builder, calling for unity and calm during the transition, Magufuli was known as “the bulldozer,” a nickname he initially earned as Minister of Works for his efficiency in getting roads built."},{"@id":"urn:doxa:passage:c287da54f70f71405b9dc09e98a159af5ee1dd47b122e40a654e560de382ab41","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00013","start":0,"end":20,"exact":"Remembering Magufuli"},{"@id":"urn:doxa:passage:ec76d5191cf306e3f71d3644b14451de60d8e75c6e7ca5866e6fac5595acf74f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00014","start":0,"end":106,"exact":"Many Tanzanians — and Africans — are remembering Magufuli on social media for both “the bad and the good.”"},{"@id":"urn:doxa:passage:fcdac0c8d401ef998fffc6b689526803d63efe70c120c608a8b08ba36465fae2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00015","start":0,"end":94,"exact":"Magufuli gained popularity early on in his presidency for his strong anti-corruption promise. "},{"@id":"urn:doxa:passage:157b036f0628b41ea139361332a32aa9fa47e49943752b695d761d365c933515","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00015","start":94,"end":264,"exact":"His efforts to boost major infrastructure projects and industrialization fed into many Tanzanians’ wishes for self-reliance after decades of international aid dependency."},{"@id":"urn:doxa:passage:a2b46411aa04843af7c5ec82d2f3a161f8969e9ff4bb0f44b730c482196c9979","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00016","start":0,"end":198,"exact":"Last April, for example, Magufuli rejected a $10 billion loan (United States dollars) from China for a proposed mega-port project in Dar es Salaam, saying “only a drunkard would accept these terms.”"},{"@id":"urn:doxa:passage:8b9173c5008cf0205163d69998eae1c113885e474b98890e998b95197a059753","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00017","start":0,"end":115,"exact":"His anti-corruption focus also appealed to Western audiences, and the media initially covered his ideas positively."},{"@id":"urn:doxa:passage:223d746cdd1d7740adc714975aabec5a365ef6fa34dac776d61280bd8a5299d7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00018","start":0,"end":100,"exact":"To some, Magufuli is remembered as a “true African statesman” and pan-African putting Africa first. "},{"@id":"urn:doxa:passage:79c39500261186c1b1f50e9c631dc277bef2b30bf6f840d85c8d4411f46b1d29","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00018","start":100,"end":186,"exact":"Others remember him as a “populist” president who promoted nationalism above all else:"},{"@id":"urn:doxa:passage:ee2a8bca0bdb6c8e87eb979e7cbe2e6a9af8912d3888c3aeaba45ac0d80abbae","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00019","start":0,"end":118,"exact":"However, Magufuli applied an authoritarian-style rule during which human rights and free speech increasingly suffered."},{"@id":"urn:doxa:passage:7829f70af738109eb15b2b881a3a455d6baf4493dec621ac05c0ef1d22b7553d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00020","start":0,"end":209,"exact":"Over the last six years, Human Rights Watch, Amnesty International, Committee to Protect Journalists, Global Voices and others have steadily tracked the deterioration of the civil and human rights protections."},{"@id":"urn:doxa:passage:643dcf69d9c71aa3d6fd379c185d15f6b5ead08ac1ed23ae3fec1dfe91b34e2f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00021","start":0,"end":111,"exact":"Tanzania dropped six places on Freedom House’s scorecard measuring democracy and freedom between 2020 and 2021."},{"@id":"urn:doxa:passage:04609f8f99b7f6db029dc75a77927309b80eb1f91bc08d2738a4af43f554c0a6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9b08fc21cf3e043f3ed8b5d147531e7a","blockId":"gv-732098-b00022","start":0,"end":179,"exact":"When parliament in January 2019 debated the Political Parties Act, leading to a restriction of opposition parties, it was interpreted as a bad omen when an owl entered parliament."},{"@id":"urn:doxa:decision:1384e6203aa6cb81dca2f8a827b66ac3","@type":["doxa:Decision","prov:Entity"],"recordId":"1384e6203aa6cb81dca2f8a827b66ac3","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operatio