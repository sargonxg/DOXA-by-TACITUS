cb0292e19743e2e778f3534b70497b249344","urn:doxa:passage:35ec886ed4213af51777207804d617e482f01c5dc0b2def84e678cc72c300e33","urn:doxa:passage:afe597b4136fc4603f894ee21801624ca4c8782c09af9974088a09dc8ba42cad","urn:doxa:passage:0d434b1f43a82b9b42323ee8d3b0f90d1d393cb5c70936a37e464bc13d1c4cc3","urn:doxa:passage:03e68abb7349c5713cd4c91316261acdf242f24aa48445c1de8f2d8d4d10b61a","urn:doxa:passage:31a211f82cd20789fb955dc1da9b4a69a8f7276cccfe7b2f95feae561c948e3e","urn:doxa:passage:646efe325eaccf61d980d79f7f12080f8cd72d7c90129cf3f2cbf81bafcdc6b8","urn:doxa:passage:fc78acd7d72e20a9e9d49288fe782e548fb1cbc9acd961eee92a9ff7aa2fee88","urn:doxa:passage:e45d083b2fc532e38a586851b8132d8754f32e981af4c6250d63e85cc0d3d472","urn:doxa:passage:cb1fcf79976d078a848714cf4b9c7da840a30dda14f7ea58457734dbbf6a1417","urn:doxa:passage:f3fe0fd76d8f2fdd936195ce19898296ed04e6cdb7fbcd71f993f5a4a9f13c06","urn:doxa:passage:95f335f4827fb66e6338855ba83e19637a7ac4dbcc2daaf1927b880a3e22e83e","urn:doxa:passage:fef11236f5b5837dbc7ee59093cb71c1d4e84a5f8ff3227bd383f9af888bc654","urn:doxa:passage:49564ef7cf3bbb644dc1376d05f03ff62e8aa16d6efb917fb9788eed17bf35f2","urn:doxa:passage:c40996b138b29968cefcc7d27ec8fc2bbd6793b5972abf6a914585cc8f9a5af8","urn:doxa:passage:dca21985ddc37cae84d8add9045215b2b89a1973d17b89aee9711c7d9e490857","urn:doxa:passage:ae4f598125acb142b634205fc8f1c8df48e31b440b7d584028f07300bcfef255","urn:doxa:passage:7a0c551d0f44f1b790e56d0f4e39f98be32e5d6212e55c0616b62e439c3625ad","urn:doxa:passage:2d88769d57b6f898b34cf24c73344c222f193fb2501c39462bd627632e44ffc0","urn:doxa:passage:e43897bb776f45432a4f7679341d18bb4816f7d98188085f3a378dc4087f3494"]},{"@id":"urn:doxa:passage:d5e1e6c81927e34688ab4aa1e3a2711e7296230c1b08e2f27960bb6f29e3a126","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00021","start":338,"end":409,"exact":"The entire discussion was about men — men who are unworthy of the name."},{"@id":"urn:doxa:passage:e426759b5f8cef52981ecf17b92ba827730f47a08a1399f9ada9a16c387badd9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00022","start":0,"end":82,"exact":"Meanwhile, the Russian Orthodox Church has distanced itself from Smirnov's words. "},{"@id":"urn:doxa:passage:28a94353b7987482076669e439837e608235e2d9f9c0d257ddf1b3356b026c9e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00022","start":82,"end":309,"exact":"On February 17, Metropolitan Hilarion of Volokolamsk, the Moscow Patriarchate's director of external relations, apologised for Smirnov's “abhorrent statements,” though said that he believed they were made with good intentions. "},{"@id":"urn:doxa:passage:74f9fc6a293676c3e591898cd174b39e657ce278f56fcb6f98d0cdf308aa217e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00022","start":309,"end":523,"exact":"Similarly Vladimir Legoyda, the church's spokesman, remarked on his Telegram channel that it while it is no surprise that a priest would support traditional marriages, Smirnov's words were those of a single priest:"},{"@id":"urn:doxa:passage:a9379622392745d1df22eb2ac3d143b325383ea807e9ae837f3afc13a657ac69","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00023","start":0,"end":274,"exact":"> От себя еще могу добавить, что троллинг, в форме которого отец Димитрий периодически пытается донести некоторые свои мысли, приносит обратный результат, к сожалению. Кроме того, это не “в РПЦ считают”, но мнение одно лишь священника. Даже не мнение, а троллинг. Неудачный…"},{"@id":"urn:doxa:passage:9135cde61c1fc70acff98726c22d60d2d7f477f502f407a8b39fb558298f22d4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00024","start":0,"end":48,"exact":"> — Vladimir Legoyda, Telegram, 15 February 2020"},{"@id":"urn:doxa:passage:1cfb3d73f1613119a6074ce1406cdc5ca1ca9e5045326e8867d4f0a5b4ac652d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00025","start":0,"end":178,"exact":"> Personally I can add that the trolling, through which Father Dmitry periodically attempts to express some of his thoughts, unfortunately has the opposite result than intended. "},{"@id":"urn:doxa:passage:f0572dedf279b0af1ac2fc2ff4b93cf0292ce8ce648802355532d16a6b8f30e4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00025","start":178,"end":291,"exact":"Furthermore, this is not a matter of “the Russian Orthodox Church believes,” but the opinion of a single priest. "},{"@id":"urn:doxa:passage:cb93138d91c6210fb2a7b74cd3e922937f7d6ff013688cd82d134671b95303f8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00025","start":291,"end":330,"exact":"And not even an opinion, but trolling. "},{"@id":"urn:doxa:passage:d0bf48ab37eccecd666094c5a1264d337f2530979a21cfbfa0eb9c2abcd65a42","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00025","start":330,"end":345,"exact":"Unsuccessfully…"},{"@id":"urn:doxa:passage:e8f9effe89a9112a32a41c9ba94146a0e527adada39a86dbfbd99522bfdc09bf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00026","start":0,"end":47,"exact":"It seems that this year, Smirnov is on a roll. "},{"@id":"urn:doxa:passage:91da500ab8fd29ade1b7a387689be640fefd2f2ed3ce7751c54687ecd6952307","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00026","start":47,"end":174,"exact":"On March 4, the priest yet again provoked an uproar after he wondered aloud whether a school education was necessary for girls."},{"@id":"urn:doxa:passage:a8d2663053cc922f39fe7d31eff9fbe286a540b9e15d26a9ffdb6c0e03cb1d4d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00027","start":0,"end":18,"exact":"Race for the prize"},{"@id":"urn:doxa:passage:6384bb62f8efc1f695d7c895bacd92f5d9c3b3e8ec06a56596b22a7798bc4288","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00028","start":0,"end":124,"exact":"After a decade of its operation, the Sexist of the Year award has a degree of fame or infamy, depending on where you stand. "},{"@id":"urn:doxa:passage:064586ab4def2b88553b2a7c82b79390334a9cf73deb2596d88bfa8b3e39f66e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00028","start":124,"end":212,"exact":"But what do the victors themselves make of the award, and how do they find out about it?"},{"@id":"urn:doxa:passage:18a448ab41018e4194277f11091d74a9f525872d60c6d951b9ef24df5301e42e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00029","start":0,"end":151,"exact":"Bitten told GlobalVoices that she personally invited Alexander Ilyashenko, 2018's Sexist of the Year, to an awards ceremony to receive his anti-prize. "},{"@id":"urn:doxa:passage:a16822609650f1bea6ed16ac3ce35bc4d1a431aa6420e1e1c0025c022995c3bc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00029","start":151,"end":321,"exact":"Ilyashenko, another cleric who was nominated for advocating girls marrying and having children at the age of 17, promised to think about it but did not turn up, she says."},{"@id":"urn:doxa:passage:424d6ea1565a08fa1ba2af97fd1587444a7109b379f0ed66d6c443f1c7563790","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00030","start":0,"end":627,"exact":"> Поскольку феминисткие паблики в социальных сетях читают многие наши оппоненты, наши номинанты довольно быстро узнают о голосовании. Часто они сами “пиарят” премию в своих аккаунтах. Были случаи, когда о премии СМИ писали в негативном ключе. Но чаще СМИ рассказывают о голосовании и номинантах, распространялся информацию о премии. Сначала мы рассылали приглашения победителям с предложением принять участие в церемонии оглашения результатов голосования. Но ни один из них на мероприятие не пришёл. В прошлом году я лично пригласила на церемонию победителя протиерея Александра Ильяшенко, он обещал подумать, и тоже не пришёл."},{"@id":"urn:doxa:passage:f94868b85a792338e0f0dfb7de6a72346e0739a491342fa601a24c4f382e5874","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00031","start":0,"end":129,"exact":"> Given that many of our opponents read feminist posts on social networks, our nominees find out about the voting quite quickly. "},{"@id":"urn:doxa:passage:a4db63a82a1ad3a4eb76a6d9dbb9fdd13836633780d889281b274efc186103bc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00031","start":129,"end":190,"exact":"They frequently “advertise” the award on their own accounts. "},{"@id":"urn:doxa:passage:c78166aefa877bc8eb5283eaf2becf32b12b8f7959427e72e13fad46ea94ce10","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00031","start":190,"end":270,"exact":"There have been cases when the media wrote about the awards in a negative tone. "},{"@id":"urn:doxa:passage:95116b1b8cc229517ec608e2d7249a849038b4d85a435b650cbc7926d0dfbecb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00031","start":270,"end":377,"exact":"But usually the media report about the voting and the nominees and distribute information about the award. "},{"@id":"urn:doxa:passage:b7b5a3c6b820675056d1476a4187cd540da24fe7e84d7f8972d15771375afea2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00031","start":377,"end":526,"exact":"Initially, we distributed invitations to the winners, inviting them to take part in a ceremony where the results of the voting were to be announced. "},{"@id":"urn:doxa:passage:aac046852c16b4bd189c7586607353b62627381bc34f81b658c6f98bb70caad7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00031","start":526,"end":578,"exact":"But not a single one of them turned up to the event."},{"@id":"urn:doxa:passage:6fe6972cda51bead6a56034ce2351a1f433edbccb4c658e71e204ccb422ee67a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00032","start":0,"end":130,"exact":"Nevertheless, it is sadly safe to assume that there may be an ample supply of contestants for Sexist of the Year in years to come."},{"@id":"urn:doxa:decision:03158102aa306799d171cccf07ee5f13","@type":["doxa:Decision","prov:Entity"],"recordId":"03158102aa306799d171cccf07ee5f13","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:96f457489e551382ea19273005b15d39:u_c1321c308cbe571c88fb4262","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewSta