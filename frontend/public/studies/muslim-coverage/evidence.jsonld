c6ed50","urn:doxa:passage:b5dba9ab7680a64fa1b8c1d17c76134b2ba4fcfed551b7d8231e9f2bca1a5f06","urn:doxa:passage:7e254ff3e6091e2d9b6f58f5cc3409508f4bbc33c9502cf8c2c402f1ebe9d799"]},{"@id":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-796968","title":"Pakistani movie ‘Zindagi Tamasha’ is finally made available online after injunctions on its release","author":"Satdeep Gill","translator":[],"publishedOn":"2023-09-19","sourceUrl":"https://globalvoices.org/2023/09/19/pakistani-movie-zindagi-tamasha-is-finally-made-available-online-after-injunctions-on-its-release/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"e878a6e98566efb60b23f92fbe5f89e4b86a218c0904d0a141e75f9d23e4d1d0","textSha256":"b262d021d6793e1aa9287bbcc86808854393f87f5d3bd50234544d23c5a66ae2","archivedRecordSha256":"ec962062b2683027395550b7980277e92b7b0867e8ded4607b18f7f23ba45380","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:82809a1dca03ff6b9e0f2f7b7748177f:u_09669050b0775b9a64e519d7","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_09669050b0775b9a64e519d7","status":"accepted","fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f"},{"@id":"urn:doxa:unit:82809a1dca03ff6b9e0f2f7b7748177f:u_fdf3a925ca88187868f8c651","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_fdf3a925ca88187868f8c651","status":"accepted","fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f"},{"@id":"urn:doxa:passage:529882b076a7077882c89b97178bf77536dc91921031be495e5b552b217983ba","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00001","start":0,"end":267,"exact":"The Pakistani Punjabi-Urdu film ‘Zindagi Tamasha’ (Circus of Life), was originally scheduled for theatre release in 2020, but after numerous delays due to threats from religious hardliners, the film was finally made available to viewers on YouTube on August 4, 2023. "},{"@id":"urn:doxa:passage:0d1618982c672238b4d575caff65c1fbf0055d4fe87dde581674dd9737665c75","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00001","start":267,"end":419,"exact":"Director Sarmad Khoosat says in the introduction to the film, “In the month of [Pakistan's] independence, I am letting my film be independent and free.”"},{"@id":"urn:doxa:passage:2185094562b9de16d5b2984f0bca46b544f841c46e8dfbb4f042b4f0fa5a5886","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00002","start":0,"end":31,"exact":"Why was the film controversial?"},{"@id":"urn:doxa:passage:d6202b01e83939b8bc0b29b9571924631d674ad7dd2d322616a464b0003f0d67","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00003","start":0,"end":151,"exact":"The 2019 Pakistani drama film tells the story of a devout Muslim who sings and even records Naʽats, which is poetry in praise of the Prophet Muhammad. "},{"@id":"urn:doxa:passage:d264232be152c3a8d47ebd7c6cc259445511fcc51814718bc19cf1223a61a7b0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00003","start":151,"end":285,"exact":"His life takes a dramatic turn after a video of him dancing to a Punjabi song, with the eponymous title, ‘Zindagi Tamasha’ goes viral."},{"@id":"urn:doxa:passage:cf94e3572b93efd7eb789860c2d694622574293e10778b2579993e01a400588b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00004","start":0,"end":89,"exact":"Read More: Pakistani director halts release of award-winning film after receiving threats"},{"@id":"urn:doxa:passage:18b100d4227fcb225219a0016e245f77eb5bf8e8635b0809425470e94c8e8bcc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00005","start":0,"end":215,"exact":"The film premiered at the 24th Busan International Film Festival in October 2019 and served as Pakistan's official submission to the 93rd Academy Awards (The Oscars) in 2021, although it didn't receive a nomination."},{"@id":"urn:doxa:passage:ca2e8a63af415f00b0efcaabd4c9275120b2d7c1a9147e99e70d1ed4cf0ba782","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00006","start":0,"end":260,"exact":"It was scheduled to be released theatrically in Pakistan in January 2020 after being cleared by the censors’ board, but the release was suspended due to widespread protests led by Tehreek-e-Labaik Pakistan (TLP), a far-right Islamic extremist political party. "},{"@id":"urn:doxa:passage:0a09fa7845f9348368f8379ed9828f5c1d2ab9ac068b78620afd001d88725227","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00006","start":260,"end":408,"exact":"A spokesperson of TLP deemed the film blasphemous, claiming that the characterisation of the naat-reader may lead the public to deviate from Islam. "},{"@id":"urn:doxa:passage:9f3ea8cfc192b7b5867c680c57efb118ed2725060fdf0d741d195674ed7395a2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00006","start":408,"end":542,"exact":"The other contentious issue was the film's reference to bacha bazi, which is the sexual abuse of young boys by clerics and older men. "},{"@id":"urn:doxa:passage:6abc72cb27c1b99498eea448e837d0b2d006c33e3bbf072a0e62bfd438624c2c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00006","start":542,"end":647,"exact":"As a political outfit, TLP demands that the Islamic Sharia law be declared the official law of Pakistan. "},{"@id":"urn:doxa:passage:28867fa10633815da656dab457ab2331fc303050802ca3eabf315a680a3d0e25","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00006","start":647,"end":729,"exact":"TLP was banned in Pakistan in early 2021, but the ban was lifted in November 2021."},{"@id":"urn:doxa:passage:4ba8a19cdec096b5bbeb37c560e2ec0922d045ce402a59760c0ad650b401e9b3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00007","start":0,"end":25,"exact":"The fight for its release"},{"@id":"urn:doxa:passage:17add3ce3c680df181cb1355bdc782f1ad753004fc8b71a238d49de0578402fc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00008","start":0,"end":147,"exact":"In January 2020, director Sarmad Khoosat filed a petition against the TLP in a Lahore court for interfering with the film's screening and release. "},{"@id":"urn:doxa:passage:a410c41f7c7f4e699c03e9786db4bbe5ee3fb2fe3b0d26c660376934381ab106","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00008","start":147,"end":280,"exact":"The Senate Committee for Human Rights approved the film for screening while dismissing all objections against the film in July 2020. "},{"@id":"urn:doxa:passage:92004882c2143bf1ae3efe1120881b7bbefe8ef2303b4eb6cd4afad4b8d3ea0d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00008","start":280,"end":383,"exact":"However, shortly thereafter, a petition seeking a lifetime ban on the film was filed in a Lahore court."},{"@id":"urn:doxa:passage:c3775c27753ba8b424d039725fd8697cf337c3a9e74ae021c6625a7bf5dbe82f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00009","start":0,"end":100,"exact":"The movie was rescheduled to be released on March 18, 2022, but the screening was halted once again."},{"@id":"urn:doxa:passage:0882854f543deb9bcd4abb0a9fd648eafaa2a6921213c8f593bea2391757a5dd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00010","start":0,"end":220,"exact":"The film was eventually published on YouTube in August 2023, and it has received acclaim from critics and appreciation from fans on social media, with many people questioning the basis of the objections against the film."},{"@id":"urn:doxa:passage:85bf99bbef8321bb3655ff77b94a5986e73ab4b8ff88223b441f387872b303d0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00011","start":0,"end":69,"exact":"Author and TV presenter Zarrar Khuhro posted on X (formerly Twitter):"},{"@id":"urn:doxa:passage:331b682e82881dfb267669a3fd475685fab96929b9a830706008400bc77e2590","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00012","start":0,"end":51,"exact":"Journalist and film critic Umair Sandhu questioned:"},{"@id":"urn:doxa:passage:798ba7db945571d3a52dbeb4093f51b2a5bff85115983b6ab701cb254d75c7e1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00013","start":0,"end":110,"exact":"Aeshvaraya Thakur, a writer and architect from India shared her own commentary after watching the film online:"},{"@id":"urn:doxa:passage:3cbd4e037f37772aad1b7f907e50a4a89309255d3b99d529142576fa692529e9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00014","start":0,"end":64,"exact":"Minhal Awan, a student from Lahore, Pakistan, wrote on Facebook:"},{"@id":"urn:doxa:passage:f2fdbb4aca544f0205b229ca307af741524b11bf78371f838876e4c1ad9ba350","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00015","start":0,"end":120,"exact":"> We still believe in a steady state that religion is primarily a communal action, performance, worship of God, a cult. "},{"@id":"urn:doxa:passage:2c2355d4450e628ac4a1057feff0dcb1a362c51337182efe8a3dd917ac6d22df","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00015","start":120,"end":232,"exact":"We, the people of the post-postmodern world, I must say, are still entangled in the issues beneath the surface. "},{"@id":"urn:doxa:passage:f9b741a48e27ae3e07c81b167595f7d45494a58ea711a1eceb7feff9db79a420","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00015","start":232,"end":384,"exact":"Here, an individual, as per Durkheim's perspective, should subordinate himself to the prerequisites of religion and can't chop it down to his own size. "},{"@id":"urn:doxa:passage:e3e10065ac4e536a97eb2dbe0485f2f0457009da310762424bfa84ee4df2f77c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00015","start":384,"end":496,"exact":"May we get a sense that life and particularly Religion exists beyond the tradition-regulated church and chapel. "},{"@id":"urn:doxa:passage:df0d70b3f04ac60e2d18b2c0fea62921b7c92ec9248667d2ca28432e82e366c3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00015","start":496,"end":540,"exact":"May Allah help us out of our sick conscious."},{"@id":"urn:doxa:passage:4e3393eb3fe8d0563406a6c566afc1828abae4706b5bf10079e6e062b644a7ad","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00016","start":0,"end":201,"exact":"On August 14, 2023, Pakistan’s Independence Day, Sarmad Khoosat was honoured with Sitara-i-Imtiaz, the country's third-highest civilian award, for his contribution to Pakistan's art and culture scene. "},{"@id":"urn:doxa:passage:0b4d4874021a2193018905c17c8f3a4d8751d2ec88920cc6329acba738f92270","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00016","start":201,"end":430,"exact":"Khoosat, best known for directing the super-hit TV dramas Humsafar (2011) and Shehr-e-Zaat (2012), is also the co-producer of the Pakistani movie Joyland, which was shortlisted for the best international film at the 2023 Oscars. "},{"@id":"urn:doxa:passage:db9c879cbd8e9e33a7d4632f557258dabdb17f780aefcf95be9df1704bef591c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:82809a1dca03ff6b9e0f2f7b7748177f","blockId":"gv-796968-b00016","start":430,"end":485,"exact":"An X user pointed out the irony of the award in a post:"},{"@id":"urn:doxa:decision:03e1cff9fb4d8012fa17464bf8a72598","@type":["doxa:Decision","prov:Entity"],"recordId":"03e1cff9fb4d8012fa17464bf8a72598","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:82809a1dca03ff6b9e0f2f7b7748177f:u_09669050b0775b9a64e519d7","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:529882b076a7077882c89b97178bf77536dc91921031be495e5b552b217983ba","urn:doxa:passage:0d1618982c672238b4d575caff65c1fbf0055d4fe87dde581674dd9737665c75","urn:doxa:passage:2185094562b9de16d5b2984f0bca46b544f841c46e8dfbb4f042b4f0fa5a5886","urn:doxa:passage:d6202b01e83939b8bc0b29b9571924631d674ad7dd2d322616a464b0003f0d67","urn:doxa:pas