a9fb23099c66fda1817b4788329312c5fffff98c4c1d32f9e71350c7a4002","urn:doxa:passage:a12d564279311cd3f4f3c63dd0150f6c445aa4c5a4b58ef139561998e3afa874","urn:doxa:passage:e72d12c77429c67d6452d9960e02a7e7b626032f3484279c566d646d7d53c9b4","urn:doxa:passage:9e1f0ddfbde94e8a889cb969c1b2eb78c20ae9f82b1e520692235480701352ef","urn:doxa:passage:70c8dd3f9539dac8162ab40f43391bb8c8b6e773e58da04de1ab3c5a2b462042","urn:doxa:passage:b516881c8c6cf7d63edc25fb6e352d1dba8591c170a0af9a661340ad55ae0f55","urn:doxa:passage:57ed17f9d922f88935a3638ad008e41ad1210d589fe6179ae3ebd40cc92bea68","urn:doxa:passage:a04c763036fa37b57f11ce997a6dc06d1284577a75c523fdc9734c122dda4cc0","urn:doxa:passage:03015fffc9e33922329d0d160a03b83150520544fc53c5b89cb6be562223ed26","urn:doxa:passage:e76d1cf4196761dd8a55f8c8238713a61fe7e1b5f48c03de6ed6a209bad7502a","urn:doxa:passage:79f26a43c30b8528242a6c5390459ee8e4d63051899bffc995c2b300274283fc","urn:doxa:passage:b72395a0652d9db8b7ad3c1a23c153fd12426c2446aafc6c135a2e00e336c953"]},{"@id":"urn:doxa:passage:f48516710875adebda7fb1f5392b034ec783de073e8fab0515e3f40b3d36fc04","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00024","start":0,"end":84,"exact":"- “The government's response to the earthquake has been insufficient and inadequate”"},{"@id":"urn:doxa:passage:3720df81c9d0781f216616ddde7df8180e217c13ae65cc4272eec971e1495d95","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00025","start":0,"end":17,"exact":"On Erdoğan’s side"},{"@id":"urn:doxa:passage:e122931636eea725f248f3b162703acabb39541649f475b4504d03f298755713","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00026","start":0,"end":77,"exact":"“National and religious identities are more important than basic livelihoods”"},{"@id":"urn:doxa:passage:1c2040100c23b289250cfdee6a936fd535d6ce9f7ad60f0e3fe79310de66b9b3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00027","start":0,"end":103,"exact":"This narrative in a nutshell: “Are you going to sell your religion and identity for a bunch of onions?”"},{"@id":"urn:doxa:passage:f817c8f0b399c09a804644a5fc148e3f4fc442e2caffea217ba9655c3e4c48e6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00028","start":0,"end":159,"exact":"Erdoğan’s government bloc is losing support from its core electorate, Odabaşi says, due to the mismanagement of the earthquake relief and the economic crisis. "},{"@id":"urn:doxa:passage:8de19b8f9a76c3552aa616cc512cddeafd873bc8a6cd30ec73a089808c36ad4f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00028","start":159,"end":247,"exact":"To counter this, Erdoğan’s main campaign strategy is to galvanize nationalist sentiment."},{"@id":"urn:doxa:passage:7614f5699854aad9d9a5c797aaa8d033569a0190045977c45a5f69484523145c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00029","start":0,"end":70,"exact":"According to Odabaşi, Erdoğan is pitting “identity” versus “reality”. "},{"@id":"urn:doxa:passage:8f7dd580c50dfd6b73fa4205a2ad5661cfacd87c170b2e8ec23d22592308a2c5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00029","start":70,"end":166,"exact":"Religious and national identities are highlighted while everyday economic realities are ignored."},{"@id":"urn:doxa:passage:c4269cffae671752fa4debf06d928905450bf7d1b6b7f8d0e3268f25e4eeb2c4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00030","start":0,"end":142,"exact":"“The strategy to consolidate Erdoğan's voter base seems to be hinged on convincing voters that they are part of a culture war,” Odabaşi says. "},{"@id":"urn:doxa:passage:a5779fe230a8d68051fe708a6d00dc13e8c1bc06fa864c0ccafe8d964a0d8186","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00030","start":142,"end":307,"exact":"“Erdoğan doesn’t have much else to talk about.” Erdoğan’s people imply that anyone who criticizes the government for economic reasons is not a proud Turkish citizen."},{"@id":"urn:doxa:passage:e05292461e9a816bda44239ad1826e329d577d312af894ce7b9b813b1e6f55ce","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00031","start":0,"end":33,"exact":"This tactic might work for some. "},{"@id":"urn:doxa:passage:f2a8b28775535d96bdad0349c71d5255c0d9b19281a54dd33f6f95fdacbfff63","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00031","start":33,"end":147,"exact":"“If you keep telling people that their identity is in danger, it might influence the results,” Odabaşi reminds us."},{"@id":"urn:doxa:passage:cbb9cb5640531fad0f8c0642534be1b14a802e1cf8f260544dbb576a5752eb97","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00032","start":0,"end":62,"exact":"This narrative is used for religious and national identities. "},{"@id":"urn:doxa:passage:1d9f034b243f368e6d36517485abf995c1b40bb9307a3272bb6c2fab48614b79","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00032","start":62,"end":214,"exact":"For example, a series of photos made the rounds online, showing the opposition alliance's presidential candidate Kılıçdaroğlu stepping on a prayer mat. "},{"@id":"urn:doxa:passage:13c363562ebe734d0d2c847b27bc094627b8c86a094c4ea8f112dc31c9fb1c4d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00032","start":214,"end":529,"exact":"Even though Islamic scholars assert that a prayer mat is not a holy object, Erdoğan and his party have made it a talking point by emphasizing Kılıçdaroğlu’s “disdain for Islamic symbols.” Odabaşi analyzed such a talking point here, which also promotes the narrative that “the main opposition party is Islamophobic.”"},{"@id":"urn:doxa:passage:f302c599cbfe27dfdb689af37647ac5115a51b50f0a78402b4a3e6d22d189a44","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00033","start":0,"end":118,"exact":"Turkey has also started producing of its own car, the “TOGG,” and recently built a new aircraft carrier, TCG Anadolu. "},{"@id":"urn:doxa:passage:fbeaf474bdc17af3111c9c7438c54308d00e68cb8ca6d49a00c82e9721851621","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00033","start":118,"end":188,"exact":"These have become symbols of Turkey’s grandeur in Erdoğan’s speeches. "},{"@id":"urn:doxa:passage:32978657ed36e020f33b17c7d185ecb1f7e2a89c2c95205e2b0c988f4ab658d2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00033","start":188,"end":310,"exact":"“The narrative is not about creating jobs,” Odabaşi says, “but rather that ‘we are a great country that can produce cars. "},{"@id":"urn:doxa:passage:abfeb7697902258a98c07d9bf36bcd842368d2b6b8f8a337384f02d84146651f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00033","start":310,"end":364,"exact":"Why are they bothering us with onions and potatoes?’ ”"},{"@id":"urn:doxa:passage:edeec98b43ba07b4bd103617d7fb94a167ef94fe3f5f3b8976f32ae448d5fa96","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00034","start":0,"end":78,"exact":"An example of how this narrative spreads online: “Onion symbolism and freedom”"},{"@id":"urn:doxa:passage:bd9b63eb172161530f811e128f5e5f3fafc32db2d38309429665fa4aaee323d1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00035","start":0,"end":86,"exact":"Where it is shared: Yeni Şafak, a news outlet known to be close to the AKP and Erdoğan"},{"@id":"urn:doxa:passage:581c5463d35026ca55bcfe565f346ea09e9806c6375cdb2dd0136ad1749185e9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00036","start":0,"end":76,"exact":"Author: Yasin Aktay, one of Erdoğan's closest advisors and Islamist academic"},{"@id":"urn:doxa:passage:237ed0394eddfb48dccf957f9200e0a3b3b05acb1335f255db2e8bbd759f1cf3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00037","start":0,"end":94,"exact":"Content: Aktay, in a sermon-like tone, calls people complaining about onion prices “spoiled”. "},{"@id":"urn:doxa:passage:65052e96938515831f432522ec894692cce23fa71b9fac3cdcfd2a2af6b3e549","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00037","start":94,"end":279,"exact":"He writes: “People who have been granted freedom can forget all the bad, destructive, humiliating aspects of the days when they were slaves” and “onions are an expression of nostalgia.”"},{"@id":"urn:doxa:passage:c67242051ed12d222016f11b264922d9ac5ebd8b0f1a13b9353425238e39fd2d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00038","start":0,"end":30,"exact":"Context: same as previous item"},{"@id":"urn:doxa:passage:81df93a643cad01bd5a3b693a59c8dcf6e362eaae4899ec4904fb47ef4897a75","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00039","start":0,"end":217,"exact":"Subtext: The freedom Aktay talks about may refer to the Turkish Islamist understanding of history which claims that the Turkish Republic oppressed the country’s Sunni conservative majority until the AKP “freed” them. "},{"@id":"urn:doxa:passage:68747fcd4d5fc8c1ce8a91de4a133018e8ea48866c9f33372c2e11d2a8b2f951","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00039","start":217,"end":329,"exact":"Aktay may also refer to Erdoğan's narratives about foreign policy, which would be “free” from Western influence."},{"@id":"urn:doxa:passage:0497727a7c3d2eddebc13f3e26cf93ffd1e128285acd12935534ec59141635dd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00040","start":0,"end":144,"exact":"Civic Impact: -2 out of -3, because it is untied to the reality of the people, insulting a whole society for demanding better living conditions."},{"@id":"urn:doxa:passage:ceffad81c605b5f21e1045ab50b12daac32142dde6d1ffec07575655ea140384","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00041","start":0,"end":39,"exact":"See this item’s complete analysis here."},{"@id":"urn:doxa:passage:5adda49720e296f205238793a7ccd159a4d3369153d0d537f1c06d1b3bcb78a5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00042","start":0,"end":28,"exact":"Other developing narratives:"},{"@id":"urn:doxa:passage:673f4bef2931cc01c3bcc3fab0cf9fdf2c354e9aaa7f19637e79839b662424a3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00043","start":0,"end":55,"exact":"- “The main opposition party (the CHP) is Islamophobic”"},{"@id":"urn:doxa:passage:01e9f5f22942e53b52344c405a79f80fdabc8b750cb49b2121f333437b0e2c55","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00044","start":0,"end":93,"exact":"- “The leftist/Kurdish movement (the HDP) is the secret seventh member of the ‘table of six'”"},{"@id":"urn:doxa:passage:849a04c8386c19e8b6297cd28ac90a32eaa79fcc3039c5e5a0268e6ca2cae995","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00045","start":0,"end":69,"exact":"See this story's public dataset for more related items and narratives"},{"@id":"urn:doxa:passage:52a6804e932db9e3c42115a8f743fcd77ea4ef073c7ff9a5cc141b7a471dbe81","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00046","start":0,"end":23,"exact":"Subscribe to Undertones"},{"@id":"urn:doxa:passage:a29e62f1e573157f90fccc98b3830bf9838dbbb2bdeab0c6304a9e40d7a4219a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00047","start":0,"end":138,"exact":"This newsletter is published through the Community CMO, a new project at the Civic Media Observatory that works with our wider community. "},{"@id":"urn:doxa:passage:2efeedd6d89531a05665bdaf370becd0c1ac9a9725ec4a3ee86c377a9255e401","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00047","start":138,"end":277,"exact":"If you want to learn more or be a part of it, consider pitching us or join our next open methodology training at 11 AM UTC on May 12, 2023."},{"@id":"urn:doxa:decision:50400cd158fcd824ec91537bb9f31675","@type":["doxa:Decision","prov:Entity"],"recordId":"50400cd158fcd824ec91537bb9f31675","outcome":"does_not_meet","generate