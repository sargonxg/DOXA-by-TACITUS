6da9a33566a8a3e7f5b22fc53ec736d9e3407cddf492b53b361787"]},{"@id":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-759954","title":"Undertones: Populist discourses against the ‘elite’ and the ‘poor’ in Turkey","author":"Civic Media Observatory","translator":[],"publishedOn":"2022-03-31","sourceUrl":"https://globalvoices.org/2022/03/31/undertones-populist-discourses-against-the-elite-and-the-poor-in-turkey/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"02019239aac36777b5273eacc6cc82cb658058c4c1f47af9124ca34a3afda1de","textSha256":"1d2e5ea37941fc6dfa95e7485fb8c2a7d048d026e4df9d3954c7a0621c92536d","archivedRecordSha256":"79692e8cd2ff13c892095d960338d5ab4392dedbc92b53b11b9c26f09adeb8d9","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:f2208d69f7379135f1fce6aacb9b14d5:u_26d6d44ac6dddb2a4291ba5a","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_26d6d44ac6dddb2a4291ba5a","status":"accepted","fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5"},{"@id":"urn:doxa:unit:f2208d69f7379135f1fce6aacb9b14d5:u_2da4bc4e4065e4a93fd3145a","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_2da4bc4e4065e4a93fd3145a","status":"accepted","fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5"},{"@id":"urn:doxa:passage:3f75f9b124478d1fc478a7fd06c9ab796747ab16e31a4421ae81ba93bd9cb07d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00017","start":512,"end":631,"exact":"Yeni Şafak, which did not provide context for this video, often pushes the narrative that doctors are an elitist group."},{"@id":"urn:doxa:passage:9a584c7b9d9061fc899322444b32c265f104057b69fe8492a2f5adeca75cd715","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00018","start":0,"end":81,"exact":"See these two more items reflecting this narrative, from sources: TR_49 and TR_52"},{"@id":"urn:doxa:passage:67a41b4a030b9ace187005a8187478e3de66ef25adfb87e5231625c898a3f53c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00019","start":0,"end":3,"exact":"2. "},{"@id":"urn:doxa:passage:b2831999b3b6cd7e4c1080cccf1735f8988a6c4f022f17c868308b07a8ca7765","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00019","start":3,"end":34,"exact":"“The opposition are terrorists”"},{"@id":"urn:doxa:passage:e7ef57e6b465caf75e9ec78f8ac617db796cb5fd1fc9d8c231651630887d5db1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00020","start":0,"end":57,"exact":"Allegations of terrorism are common in Erdoğan's Turkey. "},{"@id":"urn:doxa:passage:1530da150e555b49973ef7b34821bb9d04ab344f8bdc595ce366278b11d46d3e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00020","start":57,"end":178,"exact":"For example, anyone disagreeing with the AKP’s line about the treatment of Kurds is considered treasonous and terrorist. "},{"@id":"urn:doxa:passage:bb76939dd026c627df65cfe795079e130b9e5aa4d720cbfcb1d3a73c6d45c527","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00020","start":178,"end":325,"exact":"In the same vein, having links with specific parties, such as the left-leaning People’s Democratic Party (HDP), is enough to be called a terrorist."},{"@id":"urn:doxa:passage:bb181a9b282b2d3224a3985a45aeb1e1d260f9ab61362fcc8fcca8bb07b4cc2c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00021","start":0,"end":82,"exact":"This narrative is used to delegitimize and dehumanize opposition against Erdoğan. "},{"@id":"urn:doxa:passage:0d1d78b6b85a44b1f4764db1494419527ff3d4dc7c724053930ece5338be89f7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00021","start":82,"end":186,"exact":"Attacks against the political leader Kılıçdaroğlu in 2019 happened after similar allegations by Erdoğan."},{"@id":"urn:doxa:passage:e95144af46f9332bb6e13db3883564a8c2cbe833ca6fe31af761fb0e3801a480","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00022","start":0,"end":151,"exact":"TTB is often fiercely critical of Erdogan’s government, having openly supported the wave of civil unrest known as the Gezi Park protests back in 2013. "},{"@id":"urn:doxa:passage:d9f563992c8c33a3112d0f3d2bdd28f4c41ff3dcaa20df276e146a5a7e0f2d30","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00022","start":151,"end":288,"exact":"In Turkey, medical faculties, and by extension, the medical profession, are traditionally associated with left-wing ideology and groups. "},{"@id":"urn:doxa:passage:706f85be42aecce81ad050908f78cd5dd2fe0e6453453d799c27419148327825","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00022","start":288,"end":404,"exact":"In 2020, TTB’s congress elected a leadership that is close to the opposition and to the pro-minority party, the HDP."},{"@id":"urn:doxa:passage:901766db4574d6627da1e79e6f6c388b96306aec432b73829a0ad8e7482d7626","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00023","start":0,"end":44,"exact":"How this narrative plays out on social media"},{"@id":"urn:doxa:passage:617c0ebb2818f8d86eb21c08f2f2f4d00c6830451033a19975045cd8f5a5fad9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00024","start":0,"end":153,"exact":"Pro-government media outlet Yeni Şafak tweeted a story about Mustafa Destici, chairman of a small ultranationalist and Islamist party allied to the AKP. "},{"@id":"urn:doxa:passage:ddcd5a2c61bfbba2b48680c7cdb9ebf1e9086ed53d3319265c2b723ef2bd9970","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00024","start":153,"end":312,"exact":"The outlet quoted him saying that the doctors’ union shouldn't be allowed to use the word “Turkish” because, he alleges, they support terrorist organizations. "},{"@id":"urn:doxa:passage:040d10c0ea53b6107c249c5b3e3b7f786cc2a76e21552359c8306a9a3ca939dd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00024","start":312,"end":418,"exact":"The tweet received more than 3,000 interactions, with most commentators approving of Destici’s sentiment. "},{"@id":"urn:doxa:passage:a0e6a42002f07de711fe0ed6ef6ce56980b5495fc46afaeec29d5d7b3c22b82e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00024","start":418,"end":472,"exact":"Some expressed their desire for TTB to cease to exist."},{"@id":"urn:doxa:passage:cdbbb2172ae569659c39213ce79fcec09d44b5f813f9d7d8c894836d9f1008e7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00025","start":0,"end":50,"exact":"See another item reflecting this narrative: TR_44."},{"@id":"urn:doxa:passage:b659b0d6b76ad07f0bc5f513d4f054e27bad76370f32bd37bcc89899f5b939a2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00026","start":0,"end":3,"exact":"3. "},{"@id":"urn:doxa:passage:53b8cbf9cdeed67159a5a67049dfc7e73e7440180a1b79d809ccce33c361459d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00026","start":3,"end":56,"exact":"“Syrian refugees are replacing Turks demographically”"},{"@id":"urn:doxa:passage:b3435d25ae02b133e556963221aae634f6fecfc0d174d6df968831ac032e6f97","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00027","start":0,"end":68,"exact":"Negative narratives about Syrian refugees are ubiquitous in Turkey. "},{"@id":"urn:doxa:passage:ba8b92034401761bda6d74cfc87fdda408295ce0980a3b9811dd759a58a01ade","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00027","start":68,"end":164,"exact":"According to recent polls, the vast majority of Turks want “Syrian refugees to return to Syria”."},{"@id":"urn:doxa:passage:09514e7d57f33e2a62c77ae7648a79fee5bab07d73435568b8a0884e2a8346f1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00028","start":0,"end":170,"exact":"This narrative, which espouses the idea that the large number of Syrian refugees will eventually replace Turks, exists across the political spectrum and in media houses. "},{"@id":"urn:doxa:passage:6d996b3482050b79e16336fa8c012f47e195f85fffa352af45500f26ef45e6cf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00028","start":170,"end":242,"exact":"This belief is particularly prevalent and explicit in far-right groups. "},{"@id":"urn:doxa:passage:4e5f3f0004ba0ea354f1c3abbd6ba1dbf7ef47c8aa74a85a1b8def725ec19f7f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00028","start":242,"end":383,"exact":"Erdoğan’s party and pro-government media, on their part, have used the “Islamic brotherhood” narrative to welcome Muslim refugees from Syria."},{"@id":"urn:doxa:passage:c0005aa0850332ffc04a6ddac67d87307c5dcb3caaf1675ee9814f3e8cef1599","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00029","start":0,"end":142,"exact":"Far-right politicians have gone as far as arguing that Erdoğan’s government is promoting the influx of Syrians so as to Islamize the country. "},{"@id":"urn:doxa:passage:fd7299021b367bc7b306e22e52bcea5f2b053d46ac485c4d9ad16e31a329e920","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00029","start":142,"end":231,"exact":"This has fed conspiracy theories about Turkey’s “Arabization” among secular nationalists."},{"@id":"urn:doxa:passage:ed210440337b5a6d9c41c28e47f5c11726ae5526d371bd85cbe326cb54ba7ee1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00030","start":0,"end":96,"exact":"According to the European Commission, Turkey hosts the largest refugee population in the world. "},{"@id":"urn:doxa:passage:8b9685827ae31472a5f802cb021d1062362a7b94ddb9a1a74650e8ad9d588eca","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00030","start":96,"end":285,"exact":"With a population of more than 80 million, the country currently hosts 3.6 million registered Syrian refugees who are being increasingly held responsible for the country’s economic crisis. "},{"@id":"urn:doxa:passage:7c35ab00e15e01929d49ca554b84ede112dc9127cd23e3d7de9e047eddac95af","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00030","start":285,"end":343,"exact":"Today, immigrants are constantly targeted on social media."},{"@id":"urn:doxa:passage:396f43698f38d0bc17885867b86d969867ffd26fd0b9ca2b05de6debb409a0c2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00031","start":0,"end":44,"exact":"How this narrative plays out on social media"},{"@id":"urn:doxa:passage:eb3db19a7657d825ea9707212be1a3eed41f6ad43bd018cc2e5788ce8b9bff42","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00032","start":0,"end":190,"exact":"Using an alarmist tone, theologian and writer Cemil Kılıç tweeted that Syrian, Afghan and Africanr refugees (among others) must be sent back or else they will replace the Turks in Anatolia. "},{"@id":"urn:doxa:passage:4e12cda0289fd07e0241b698fd2ed0a58e4bf5f6635d3ce4e12b76b31ceed463","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00032","start":190,"end":369,"exact":"He explicitly uses a far-right conspiracy theory of demographic replacement — similar to the French Great Replacement fascist theory, although it is not called as such in Turkey. "},{"@id":"urn:doxa:passage:54e6f57f2a8f76d8076d19c5cf6f3b67e9e7c08b6a318e9f4df071fb19fecbf3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00032","start":369,"end":489,"exact":"Kılıç’s tweet received 20,000 interactions, with most commentators agreeing with his message, while a few criticized it."},{"@id":"urn:doxa:passage:1523995edeb0608a653d17c72da28e7c9cdae5f48ab21b0e044d1f70f60c3ab5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00033","start":0,"end":74,"exact":"See these other items reflecting this narrative:TR_35, TR_41, TR_43, TR_51"},{"@id":"urn:doxa:passage:e680df0aa7843b2aceb2b429d617e3c2753ee78f6d992d106b22777858c48598","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00034","start":0,"end":30,"exact":"View our entire Turkey dataset"},{"@id":"urn:doxa:passage:7d3d1b51f0936e29f219a86f7488578f1a2fdc041ae5a0885100280df6ac3b12","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00035","start":0,"end":45,"exact":"DONATE to support the Civic Media Observatory"},{"@id":"urn:doxa:passage:9d56d279aacab8e1ef416887811cb5f33cd4ce703ca21948d9db23b6b644edda","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00036","start":0,"end":156,"exact":"Undertones is the Civic Media Observatory's newsletter, created collaboratively by the Observatory's researchers, coordinating editors, and project writer. "},{"@id":"urn:doxa:passage:01663d20c76bcc74a73113fe89cce927a04a771c253641db0fdbf9306b3c791d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00036","start":156,"end":230,"exact":"Find out more about our mission, methodology, and publicly available data."},{"@id":"urn:doxa:decision:d9c0729bb4fec00cc340c1a1fbb5d4b9","@type":["doxa:Decision","prov:Entity"],"recordId":"d9c0729bb4fec00cc340c1a1fbb5d4b9","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:f2208d69f7379135f1fce6aacb9b14d5:u_26d6d44ac6dddb2a4291ba5a","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:3f75f9b124478d1fc478a7fd06c9ab796747ab16e31a4421ae81ba93bd9cb07d","urn:doxa:passage:9a584c7b9d9061fc899322444b32c265f104057b69fe8492a2f5adeca75cd715","urn:doxa:passage:67a41b4a030b9ace187005a8187478e3de66ef25adfb