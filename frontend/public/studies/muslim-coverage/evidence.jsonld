sage:31a08683bbd10602671a760c16819373d8f247a1f7851c23dd076e0ccec98149","urn:doxa:passage:23baa4f9a997074e61f1e879c680f63887ce38b891fd63ae9951e35eb48c70b6","urn:doxa:passage:2d58b723e480cda3a1ad31333a4f9a3e55b9108dbf59a3fd39af2abc8c346fdc","urn:doxa:passage:1ce4fdecfe990c8a5f4615609ae35425689f3e5f9b3cec36ce7d3d2f0d6a4fb4","urn:doxa:passage:6d1c1a87d0feace185fba5daf88c879126d1a57591d67a1262e4448666e77ad8","urn:doxa:passage:e44337b7df051927fc628382cca6d1259ef26fdf5cdc7b18dcc07b6823ee466a","urn:doxa:passage:45182366ae0c4c5b6188c120de545e9547cf127dd015be1c6b66c9b858eb18f1","urn:doxa:passage:5673dff2f39350e485924dab903e736d1404cda6b155f412befa1227790b34e5","urn:doxa:passage:dbe89c86b51b1d9868332bb475261a12f963ffaaf91984961c0c2fcf5aaa5880","urn:doxa:passage:7c1447ebafe19f4454a318701d28deabf86e517033c636394797623d81aba4ff","urn:doxa:passage:cfe49ed96a89790214462acc1f25bc7564c249f6e2203733f1af7347374cdd34"]},{"@id":"urn:doxa:decision:90ce9a4852d8b7aa1dd89c7317e703b3","@type":["doxa:Decision","prov:Entity"],"recordId":"90ce9a4852d8b7aa1dd89c7317e703b3","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_80f990dc05bce66c4514a233","attribution":"unknown","speaker":"N/A","speakerStance":"unclear","documentStance":"neutral","proposition":"N/A","hypothetical":false,"reviewStatus":"unreviewed","modelPassage":["urn:doxa:passage:cfe49ed96a89790214462acc1f25bc7564c249f6e2203733f1af7347374cdd34"]},{"@id":"urn:doxa:passage:342dba3f7fc3e5a255ade329e02057ee5684174c9629bcfff34493261ac0723d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00017","start":0,"end":113,"exact":"> My insecurity heightened since October 7, coinciding with the increased hate speech against Arabs and Muslims. "},{"@id":"urn:doxa:passage:b8af82a399c43fc33afb2fb781a5e7988efbc67350262755f44976d89d72f28f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00020","start":0,"end":116,"exact":"“At 13, living in the US during 9/11, I endured one of the toughest periods, as Arabs and Muslims were dehumanized. "},{"@id":"urn:doxa:passage:bf6ffbc2b631ca3d60699280e5c9088976f09d19c299e77fc7871ec70d2028ab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00020","start":116,"end":207,"exact":"Hearing white people celebrate the deaths of Arab and Muslim civilians left lasting scars. "},{"@id":"urn:doxa:passage:7cc99273357b911704fa1ba75bffa03892dc37fb29d06b0f9e15488ef08dfd6b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00022","start":0,"end":108,"exact":"“My current experience with the crackdown feels retraumatizing, given that I was coming-of-age during 9/11. "},{"@id":"urn:doxa:passage:5431328aad51b66b329083ef2bfd842142f6ad038a66763ab8a745068da7894e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00024","start":168,"end":244,"exact":"It brought back memories of 9/11 and the surge of Islamophobia that ensued.”"},{"@id":"urn:doxa:decision:e49d3e4a3e19f01e5e27b44f606e2f9c","@type":["doxa:Decision","prov:Entity"],"recordId":"e49d3e4a3e19f01e5e27b44f606e2f9c","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_9e727d5c9b9f0abf483312e8","attribution":"reported_speaker","speaker":"Interviewees (Souad, Omniya, Fouad, etc.)","speakerStance":"opposes","documentStance":"neutral","proposition":"Increased hate speech and dehumanization are occurring against Arabs and Muslims.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"Interviewees report experiencing increased hate speech, dehumanization, and Islamophobia targeting Arabs and Muslims.","modelPassage":["urn:doxa:passage:342dba3f7fc3e5a255ade329e02057ee5684174c9629bcfff34493261ac0723d","urn:doxa:passage:b8af82a399c43fc33afb2fb781a5e7988efbc67350262755f44976d89d72f28f","urn:doxa:passage:bf6ffbc2b631ca3d60699280e5c9088976f09d19c299e77fc7871ec70d2028ab","urn:doxa:passage:7cc99273357b911704fa1ba75bffa03892dc37fb29d06b0f9e15488ef08dfd6b","urn:doxa:passage:5431328aad51b66b329083ef2bfd842142f6ad038a66763ab8a745068da7894e"]},{"@id":"urn:doxa:decision:83cad8b7022c45cb0cbf6a72243562c8","@type":["doxa:Decision","prov:Entity"],"recordId":"83cad8b7022c45cb0cbf6a72243562c8","outcome":"uncertain","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_9e727d5c9b9f0abf483312e8","attribution":"quoted_speaker","speaker":"Souad","speakerStance":"opposes","documentStance":"neutral","proposition":"Arabs and Muslims were dehumanized and their deaths were celebrated by others.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The interviewee reports being dehumanized and hearing others celebrate deaths, but the text does not establish the intent of the third parties to encourage hatred.","modelPassage":["urn:doxa:passage:b8af82a399c43fc33afb2fb781a5e7988efbc67350262755f44976d89d72f28f","urn:doxa:passage:bf6ffbc2b631ca3d60699280e5c9088976f09d19c299e77fc7871ec70d2028ab"]},{"@id":"urn:doxa:passage:53b9d635778cc13277ab9b6b0c1d28a11c66eeb1d3deb3cbb165ff223b7fb098","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00028","start":131,"end":267,"exact":"The feeling of betrayal impacts my sense of safety more than the ‘unsafe’ and violent racist comments we were used to before October 7.”"},{"@id":"urn:doxa:decision:d4bc85b951fde02629700f97589e4ac6","@type":["doxa:Decision","prov:Entity"],"recordId":"d4bc85b951fde02629700f97589e4ac6","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_9e727d5c9b9f0abf483312e8","attribution":"reported_speaker","speaker":"Interviewees (Souad, Hanan, etc.)","speakerStance":"opposes","documentStance":"neutral","proposition":"Muslims and Arabs are targets of dehumanization and racist comments.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"Interviewees report experiencing dehumanization and violent racist comments targeting their identity.","modelPassage":["urn:doxa:passage:bf6ffbc2b631ca3d60699280e5c9088976f09d19c299e77fc7871ec70d2028ab","urn:doxa:passage:53b9d635778cc13277ab9b6b0c1d28a11c66eeb1d3deb3cbb165ff223b7fb098"]},{"@id":"urn:doxa:passage:1972d57fac5e588aaf84b0c84ded57f8400dee886bdd28a43e05f62ed896ee29","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00017","start":113,"end":203,"exact":"Now, I feel compelled to justify why I am Muslim, why I am Arab, why I support Palestine.”"},{"@id":"urn:doxa:passage:9d23bf9ad880041ec5829033aefbda7bd84aa2c7575821f2ffd6f0a93dc68433","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00030","start":39,"end":116,"exact":"German society not only fails to understand, but doesn't want to understand. "},{"@id":"urn:doxa:passage:32be0ef8f76629c96b96dddfe1ac1616b10e06d7a733d316eb40ce5dad1273b5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00031","start":106,"end":186,"exact":"As Arabs, we share a collective feeling, but white people seem oblivious to it. "},{"@id":"urn:doxa:decision:d4acf9f9e2431396038cfc9297493e03","@type":["doxa:Decision","prov:Entity"],"recordId":"d4acf9f9e2431396038cfc9297493e03","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_9e727d5c9b9f0abf483312e8","attribution":"reported_speaker","speaker":"Omniya and others","speakerStance":"opposes","documentStance":"neutral","proposition":"German society fails to understand or empathize with Arabs and Muslims.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"Interviewees describe feeling a lack of empathy, social isolation, and a sense of being misunderstood by German society due to their identity.","modelPassage":["urn:doxa:passage:1972d57fac5e588aaf84b0c84ded57f8400dee886bdd28a43e05f62ed896ee29","urn:doxa:passage:9d23bf9ad880041ec5829033aefbda7bd84aa2c7575821f2ffd6f0a93dc68433","urn:doxa:passage:32be0ef8f76629c96b96dddfe1ac1616b10e06d7a733d316eb40ce5dad1273b5"]},{"@id":"urn:doxa:passage:606ad71d41cb7a2aed1efbc24e750024c4c54b30dc2cd4f6c78d6add18a606f8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00018","start":0,"end":64,"exact":"Echoes of post-9/11 Islamophobia and anti-Arab racism in Germany"},{"@id":"urn:doxa:passage:9f8c4c0c85bd911a493e35a0686885a799f58b501d5e9c21ad416fcf384138e8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00019","start":0,"end":122,"exact":"Following Germany’s response to October 7, the interviewees drew parallels to their past negative experiences after 9/11. "},{"@id":"urn:doxa:passage:e367a9801ddf529e683965d7f96b76a7fd49f6c2510ff7592aab8a9116587e50","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00019","start":122,"end":234,"exact":"Their reflections underscore the enduring effects of discrimination, spanning different countries and contexts. "},{"@id":"urn:doxa:passage:6eee71f22493a2b74562739d50b011391f818a540a5d46110da56e1df97b27db","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00019","start":234,"end":308,"exact":"They noted a reemergence of fear, grief, and Islamophobia in their lives. "},{"@id":"urn:doxa:passage:cd3b1f0c280d4a09403023e40819fefb223b2ec61787b934e52f2efc98fc83aa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00019","start":308,"end":326,"exact":"Souad pointed out:"},{"@id":"urn:doxa:passage:004822f981bdff55e489598523ee77da2ae01ba6203d989adf5575e11be5956c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00020","start":207,"end":304,"exact":"It took years to overcome the pain, but these recent months in Germany have reopened that wound.”"},{"@id":"urn:doxa:passage:6aa2d235b6157d68c1cf5c481cc85606aa565ef82e4eb8e6a18f319690cc229e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00021","start":0,"end":53,"exact":"Omniya echoed similar disbelief and distress, saying:"},{"@id":"urn:doxa:passage:a245754d93bb084daa14cec2a17496a513e147b7e8488488c0a75a81f0baa627","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00022","start":108,"end":230,"exact":"Back then, I couldn't believe how George Bush spoke about Arabs and Muslims and how everything led to the attack on Iraq. "},{"@id":"urn:doxa:passage:4663616f716de211aa14fd015bd5e8d34df5a4c9a34b1e4c7655999d004b5a7c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00022","start":230,"end":343,"exact":"Now, witnessing the genocide in Gaza, I recognize parallels to the post-9/11 climate, evoking the same feelings.”"},{"@id":"urn:doxa:passage:87d6ee9339cbcaf414f21c84d5698a0ec63a4cf9ece9175b310e762ddaa3fcfd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00023","start":0,"end":79,"exact":"In contrast, Fouad shared his foreboding feelings about the future, explaining:"},{"@id":"urn:doxa:passage:ca69a8b8454c6d8389920fe6604b9f63ad4e12071b098cc800f5fc8af84e5594","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00024","start":0,"end":120,"exact":"“The moment I saw the news [on October 7], I immediately thought of the consequences and felt grief for what's to come. "},{"@id":"urn:doxa:passage:66029feff4ce282ea03f1e75ab06635f1c464af88852a8fed1b801c97ac699ba","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00024","start":120,"end":168,"exact":"I contemplated how the West would interpret it. "},{"@id":"urn:doxa:passage:b41d4775a821f158c1dbb31f257186c25d36a861d3d704d27b1209883c504e4f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00025","start":0,"end":30,"exact":"Friend’s reactions deeply hurt"},{"@id":"urn:doxa:passage:1319e19a9161ef9b0e2214c18515fbb645371084789e957a31cc8f03f31ce3d6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00026","start":0,"end":172,"exact":"The interviewees conveyed a profound isolation stemming from a lack of empathy from German society and feelings of betrayal in personal relationships and societal dynamics."},{"@id":"urn:doxa:passage:562237820314edb1e6c1ec05f72c2742ec23ee3fd3d42a581e2cd683ccfef136","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00027","start":0,"end":107,"exact":"Hanan felt hurt after a former friend belittled her grief about Gaza, which she had shared on social media:"},{"@id":"urn:doxa:passage:d61790729be1167a25cca4bc474cf9285a8e695ecbb636bfc62497a0d2d9d70a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00028","start":0,"end":33,"exact":"“This is the hardest one so far. "},{"@id":"urn:doxa:passage:457c0436e81e787b05fe4e6bea484f877efef7d0bfc56b431c4a1e90482e6cd5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00028","start":33,"end":131,"exact":"I think about the good moments we shared as friends, yet I now feel very distanced from everyone. "},{"@id":"urn:doxa:passage:252e25251e2650c54aae791456c6f52939624f5686377c954f3eb25de93df986","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00029","start":0,"end":28,"exact":"Omniya also feels isolated. "},{"@id":"urn:doxa:passage:c95332e670dd6cb7767fb2df147f7098d34ee32c93499ab3227c885a2cca42b3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00029","start":28,"end":42,"exact":"She clarified:"},{"@id":"urn:doxa:passage:e0213567e702e07fff13c2c438f67bc066cf00ccbcb877dc9e1256231a3bf340","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00030","start":0,"end":39,"exact":"“I feel extremely lonely all the time. "},{"@id":"urn:doxa:passage:85435b068411670df1208eda04d2a93ebc7c9bf71aa7f7236fa3445fbcf844be","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00030","start":116,"end":176,"exact":"Even close friends have no idea of the depth of my sadness. "},{"@id":"urn:doxa:passage:d9d9293a7ee9dcc63990aeddaa60f43ff6811d674baf88dd6abb2cff4f4d6724","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00030","start":176,"end":237,"exact":"They don’t reach out, and if they do, it’s for other reasons."},{"@id":"urn:doxa:passage:88f8399a855cda030ad56384dce1ffdd9e7188ed074b627da0c6542490d8f814","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00031","start":0,"end":50,"exact":"They are clueless about the impact on Arabs here. "},{"@id":"urn:doxa:passage:62218bf01e2c51d889cdc59a38ecde40caf3dc5412837a176f567f83b913ca89","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00031","start":50,"end":106,"exact":"This isn't confined to my friends; I see it everywhere. "},{"@id":"urn:doxa:passage:84ea688aff49aeb393552d69044aacc78f10605f4ae2d0a8c62a036c7e97a68e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00031","start":186,"end":227,"exact":"Currently, I feel I cannot trust anyone.”"},{"@id":"urn:doxa:passage:fbd51eb947ee8075becc848bb6547ce6c7ee06bbd129fd66ea15d00a49c809ef","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00032","start":0,"end":84,"exact":"Rania explains the careful attention she gives to details when discussing Palestine:"},{"@id":"urn:doxa:passage:be2631c7e739660d3f2c8c6246ba6b92f7c4a858c069081a92a193688f4f5cbc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00033","start":0,"end":84,"exact":"“I shared statistics on civilian casualties in Palestine from the last two decades. "},{"@id":"urn:doxa:passage:47b7826b2e8b3a1529b359a8bd102cd7e413bfd6367d5978b0a773f366d9c690","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00033","start":84,"end":146,"exact":"As I clicked ‘share,’ my heart pounded, and I closed my eyes. "},{"@id":"urn:doxa:passage:3fa5898347ad009b2c1b1a9e048bd236b240b8232edb41bcb96f37efe9658b0a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00033","start":146,"end":215,"exact":"I'm aware that most of my followers don’t want to read this content. "},{"@id":"urn:doxa:passage:5aaa0fe128196aa56e9e3216cd47a9b6c9105477c7592df818b55c43c58ccb34","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00033","start":215,"end":255,"exact":"However, I know what I’m talking about. "},{"@id":"urn:doxa:passage:1d473530946af8f2bb9356f2743d8af2d99a39b27e4a1e10a37e4780d5f99bc8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00033","start":255,"end":271,"exact":"I know my math. "},{"@id":"urn:doxa:passage:1e89013fdc507443ab707f65a20ffcf30f2a34313637b469bf94944f23d2c701","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00033","start":271,"end":366,"exact":"When I mention that the media doesn't report on ‘our people,’ I’m addressing a specific issue.”"},{"@id":"urn:doxa:passage:c32b395c381f423cbdc6dcc4978502edcc2648d377140ef1727ad7a8982dbe4d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00034","start":0,"end":79,"exact":"She said the Palestinians symbolize more than just the struggle for Palestine. "},{"@id":"urn:doxa:passage:d18b28265b4d8dc416e2b693e3975b44b4c9596c730142ac857398a7e52af32a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00034","start":79,"end":215,"exact":"“They represent the disregard for Arab lives that don’t matter, the BIPOC lives that don’t matter, and they are victims of colonialism.”"},{"@id":"urn:doxa:passage:6ad22eae96be2ecb5970e9b0d79ad1b405bb64ced7b24e143cdc33568895a3cc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00035","start":0,"end":112,"exact":"Four months since October 7, the situation for Palestinians in Gaza and the West Bank continues to deteriorate. "},{"@id":"urn:doxa:passage:1ed47e9172b15189942db9fa7f25143239c83e632f6c8717e1477797bac3fcdf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00035","start":112,"end":264,"exact":"Despite the International Court of Justice‘s order for Israel to prevent acts of genocide, attacks on displaced Palestinians, mostly children, persist. "},{"@id":"urn:doxa:passage:4d15b639ecc7f34d235829b18110a00e0664e01e60f37100322d0f8d49350662","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00035","start":264,"end":395,"exact":"Oxfam has declared “a humanitarian crisis of unprecedented severity and scale” in Gaza, highlighting the severity of the situation."},{"@id":"urn:doxa:passage:d10642a3eb3b13c33c147deac9f7bad5dcbc69ad879d32a70bbeecd7b5417192","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00036","start":0,"end":109,"exact":"Germany’s export of millions of euros worth of weapons to Israel contradicts its commitment to human rights. "},{"@id":"urn:doxa:decision:a40ccba2427efd06d2edadfb000ee0c4","@type":["doxa:Decision","prov:Entity"],"recordId":"a40ccba2427efd06d2edadfb000ee0c4","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_9e727d5c9b9f0abf483312e8","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:342dba3f7fc3e5a255ade329e02057ee5684174c9629bcfff34493261ac0723d","urn:doxa:passage:1972d57fac5e588aaf84b0c84ded57f8400dee886bdd28a43e05f62ed896ee29","urn:doxa:passage:606ad71d41cb7a2aed1efbc24e750024c4c54b30dc2cd4f6c78d6add18a606f8","urn:doxa:passage:9f8c4c0c85bd911a493e35a0686885a799f58b501d5e9c21ad416fcf384138e8","urn:doxa:passage:e367a9801ddf529e683965d7f96b76a7fd49f6c2510ff7592aab8a9116587e50","urn:doxa:passage:6eee71f22493a2b74562739d50b011391f818a540a5d46110da56e1df97b27db","urn:doxa:passage:cd3b1f0c280d4a09403023e40819fefb223b2ec61787b934e52f2efc98fc83aa","urn:doxa:passage:b8af82a399c43fc33afb2fb781a5e7988efbc67350262755f44976d89d72f28f","urn:doxa:passage:bf6ffbc2b631ca3d60699280e5c9088976f09d19c299e77fc7871ec70d2028ab","urn:doxa:passage:004822f981bdff55e489598523ee77da2ae01ba6203d989adf5575e11be5956c","urn:doxa:passage:6aa2d235b6157d68c1cf5c481cc85606aa565ef82e4eb8e6a18f319690cc229e","urn:doxa:passage:7cc99273357b911704fa1ba75bffa03892dc37fb29d06b0f9e15488ef08dfd6b","urn:doxa:passage:a245754d93bb084daa14cec2a17496a513e147b7e8488488c0a75a81f0baa627","urn:doxa:passage:4663616f716de211aa14fd015bd5e8d34df5a4c9a34b1e4c7655999d004b5a7c","urn:doxa:passage:87d6ee9339cbcaf414f21c84d5698a0ec63a4cf9ece9175b310e762ddaa3fcfd","urn:doxa:passage:ca69a8b8454c6d8389920fe6604b9f63ad4e12071b098cc800f5fc8af84e5594","urn:doxa:passage:66029feff4ce282ea03f1e75ab06635f1c464af88852a8fed1b801c97ac699ba","urn:doxa:passage:5431328aad51b66b329083ef2bfd842142f6ad038a66763ab8a745068da7894e","urn:doxa:passage:b41d4775a821f158c1dbb31f257186c25d36a861d3d704d27b1209883c504e4f","urn:doxa:passage:1319e19a9161ef9b0e2214c18515fbb645371084789e957a31cc8f03f31ce3d6","urn:doxa:passage:562237820314edb1e6c1ec05f72c2742ec23ee3fd3d42a581e2cd683ccfef136","urn:doxa:passage:d61790729be1167a25cca4bc474cf9285a8e695ecbb636bfc62497a0d2d9d70a","urn:doxa:passage:457c0436e81e787b05fe4e6bea484f877efef7d0bfc56b431c4a1e90482e6cd5","urn:doxa:passage:53b9d635778cc13277ab9b6b0c1d28a11c66eeb1d3deb3cbb165ff223b7fb098","urn:doxa:passage:252e25251e2650c54aae791456c6f52939624f5686377c954f3eb25de93df986","urn:doxa:passage:c95332e670dd6cb7767fb2df147f7098d34ee32c93499ab3227c885a2cca42b3","urn:doxa:passage:e0213567e702e07fff13c2c438f67bc066cf00ccbcb877dc9e1256231a3bf340","urn:doxa:passage:9d23bf9ad880041ec5829033aefbda7bd84aa2c7575821f2ffd6f0a93dc68433","urn:doxa:passage:85435b068411670df1208eda04d2a93ebc7c9bf71aa7f7236fa3445fbcf844be","urn:doxa:passage:d9d9293a7ee9dcc63990aeddaa60f43ff6811d674baf88dd6abb2cff4f4d6724","urn:doxa:passage:88f8399a855cda030ad56384dce1ffdd9e7188ed074b627da0c6542490d8f814","urn:doxa:passage:62218bf01e2c51d889cdc59a38ecde40caf3dc5412837a176f567f83b913ca89","urn:doxa:passage:32be0ef8f76629c96b96dddfe1ac1616b10e06d7a733d316eb40ce5dad1273b5","urn:doxa:passage:84ea688aff49aeb393552d69044aacc78f10605f4ae2d0a8c62a036c7e97a68e","urn:doxa:passage:fbd51eb947ee8075becc848bb6547ce6c7ee06bbd129fd66ea15d00a49c809ef","urn:doxa:passage:be2631c7e739660d3f2c8c6246ba6b92f7c4a858c069081a92a193688f4f5cbc","urn:doxa:passage:47b7826b2e8b3a1529b359a8bd102cd7e413bfd6367d5978b0a773f366d9c690","urn:doxa:passage:3fa5898347ad009b2c1b1a9e048bd236b240b8232edb41bcb96f37efe9658b0a","urn:doxa:passage:5aaa0fe128196aa56e9e3216cd47a9b6c9105477c7592df818b55c43c58ccb34","urn:doxa:passage:1d473530946af8f2bb9356f2743d8af2d99a39b27e4a1e10a37e4780d5f99bc8","urn:doxa:passage:1e89013fdc507443ab707f65a20ffcf30f2a34313637b469bf94944f23d2c701","urn:doxa:passage:c32b395c381f423cbdc6dcc4978502edcc2648d377140ef1727ad7a8982dbe4d","urn:doxa:passage:d18b28265b4d8dc416e2b693e3975b44b4c9596c730142ac857398a7e52af32a","urn:doxa:passage:6ad22eae96be2ecb5970e9b0d79ad1b405bb64ced7b24e143cdc33568895a3cc","urn:doxa:passage:1ed47e9172b15189942db9fa7f25143239c83e632f6c8717e1477797bac3fcdf","urn:doxa:passage:4d15b639ecc7f34d235829b18110a00e0664e01e60f37100322d0f8d49350662","urn:doxa:passage:d10642a3eb3b13c33c147deac9f7bad5dcbc69ad879d32a70bbeecd7b5417192"]},{"@id":"urn:doxa:decision:242fd8ec1241a18b0c27d95600818164","@type":["doxa:Decision","prov:Entity"],"recordId":"242fd8ec1241a18b0c27d95600818164","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_9e727d5c9b9f0abf483312e8","attribution":"reported_speaker","speaker":"Souad and others","speakerStance":"opposes","documentStance":"neutral","proposition":"Arabs and Muslims were dehumanized and faced hate speech.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"Interviewees report being dehumanized and experiencing racism based on Arab and Muslim identity during 9/11 and recent events in Germany.","modelPassage":["urn:doxa:passage:b8af82a399c43fc33afb2fb781a5e7988efbc67350262755f44976d89d72f28f","urn:doxa:passage:bf6ffbc2b631ca3d60699280e5c9088976f09d19c299e77fc7871ec70d2028ab"]},{"@id":"urn:doxa:passage:dcfeab1e709afd57655ae7572d120021ceae93b6e8cdf47cd4a6d6a71e13b865","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00036","start":109,"end":243,"exact":"The recent affirmation of support for Israel by the German Federal Government ignores the plight of Arabs and Muslims within Germany. "},{"@id":"urn:doxa:passage:c8d280472d3f1983b876d7d5b5228765865f59cc91254846788fac74476ba3ae","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cf19c62c8d0406aa611a51cd620ee738","blockId":"gv-806959-b00036","start":243,"end":341,"exact":"This inconsistency cannot go unchallenged, as lives continue to be disregarded in Gaza and beyond."},{"@id":"urn:doxa:decision:d4801e46324a529f16c099f608fe3c3e","@type":["doxa:Decision","prov:Entity"],"recordId":"d4801e46324a529f16c099f608fe3c3e","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_cf34ee6949726ded0ebccdec","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:dcfeab1e709afd57655ae7572d120021ceae93b6e8cdf47cd4a6d6a71e13b865","urn:doxa:passage:c8d280472d3f1983b876d7d5b5228765865f59cc91254846788fac74476ba3ae"]},{"@id":"urn:doxa:decision:566623b62ab5785dd75a84e985e81ca9","@type":["doxa:Decision","prov:Entity"],"recordId":"566623b62ab5785dd75a84e985e81ca9","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:cf19c62c8d0406aa611a51cd620ee738:u_cf34ee6949726ded0ebccdec","attribution":"unknown","speaker":"Unknown","speak