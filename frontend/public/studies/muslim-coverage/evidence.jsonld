dea7d8c8526dfd240429f459310aa548bbbba2306e59c935984f20d","urn:doxa:passage:71228a9b9df9548117772b78c9869f0b8e107ccb32764b655d662f7d2aa5c5f4","urn:doxa:passage:f6a108c87e62cd5c7138470ee22716c0a85889d1972977465517f1c6a1ca65b7","urn:doxa:passage:e0c9aa1a8ad877a078bca39a90634f5bb367116013e4a20a6de69bf401d0e580","urn:doxa:passage:7f42a1792b0732c2479920f008f416072d52907d4de458c2f9c4a61e80de0969","urn:doxa:passage:6d3217d356beac824e4b0eff40a6e21c65e1984c34bc66ef88416b636124d8bc","urn:doxa:passage:c284affae9418b5a743896a60d520e14c66e71db9444261884c67f482f5215a6","urn:doxa:passage:18d3d67d2ac81adcde6f7f367e3d70c25690acb40cd2f4bf344421555be08596","urn:doxa:passage:51b86c11278b27969a25536633103e8c44d789aa1b7a31c3c146a14cb877d483","urn:doxa:passage:f913d4f08344dc9736015186b98e3b248ccd9a3ca17319b72264e65c2af2cfd1","urn:doxa:passage:e9b3114e0cd1926eecfb9ad2590900f000eda9622bc8acff1d213cdf5b9639b6","urn:doxa:passage:68bd60d3edbe492eb765322b7749630fa7ae7e182d8d059f52c9cee8eef79fb4","urn:doxa:passage:cc4f9ac3bf3e464d6277f045cb275cfb8686334268c15c7a6154ba9f190fd2c4","urn:doxa:passage:a177dfcb0b2ab94559ad061e7d896fe5687d313ab4190c426cfa4a3052e06d2a","urn:doxa:passage:76e97a326fc09937ad7744a2b182db8e80753f0ce40aa7b8231e7a0c6e36862c","urn:doxa:passage:bfab37ed9acf14cf1766c5cc53d0277c09ff59942b8cf3d7ee2fb58401947016","urn:doxa:passage:89834cf648f27ad551e3ddae2f4f61ad754ceb93bf60d98f2b2972ee26982f1a"]},{"@id":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-836133","title":"Malaysian authorities probe organizers of Pride-themed workshop for promoting ‘deviant culture’","author":"Mong Palatino","translator":[],"publishedOn":"2025-06-11","sourceUrl":"https://globalvoices.org/2025/06/11/malaysian-authorities-probe-organizers-of-pride-themed-workshop-for-promoting-deviant-culture/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"441b37c6b846a0e7f13ffe0e0c3166cd251e3098ca674ca83a8a7e4261710759","textSha256":"7afe983415ecbdeedcff2544ae116631098e0c93bdbcfc6574b59cf91c239d39","archivedRecordSha256":"07adf45ba08fe062b25ff43b9a271309b66c5e22c42c1c52cc671344648c7c15","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:c24ddd71cfef4babf4e96e1a768d5e1d:u_399a9034b4e37e8960fa87c7","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_399a9034b4e37e8960fa87c7","status":"accepted","fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d"},{"@id":"urn:doxa:unit:c24ddd71cfef4babf4e96e1a768d5e1d:u_96434aa245016522ca6b229a","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_96434aa245016522ca6b229a","status":"accepted","fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d"},{"@id":"urn:doxa:passage:90c23ccdc2cea08775a2dbc75ab28e9584aa3c7f9f9690bd22003737713bf88f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00001","start":0,"end":376,"exact":"The youth arm of Parti Sosialis Malaysia was forced to postpone its sexual health workshop for LGBTQ+ individuals after the religious affairs minister publicly denounced the event for allegedly promoting “deviant cultures.” Several human rights advocates called out authorities for harassing the organizers and inflaming discrimination against members of the LGBTQ+ community."},{"@id":"urn:doxa:passage:dfb4dac3350b86d4718d2a5a7d3fb1202123b5668d42e1d2d7b395417a64f69a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00002","start":0,"end":173,"exact":"Themed “PRIDECARE: Queer Stories and Sexual Health Awareness,” the workshop organized by the Malaysian Socialist Party Pemuda Sosialis was originally scheduled for June 21. "},{"@id":"urn:doxa:passage:abf40b25221a9edb06f666f193547b9991bcf7e23f560e16c35ddd3a790ee85c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00002","start":173,"end":416,"exact":"After the event was promoted on social media last month, Religious Affairs Minister Na’im Mokhtar said it “clearly challenges societal norms and religious values upheld by the majority of Malaysians.” He urged the police to probe the activity."},{"@id":"urn:doxa:passage:95647bb68c7da7703881301726b51b4ea3ca336dbcbd53b3f98f3aedaa385737","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00003","start":0,"end":158,"exact":"> I call on all parties to help defend our society’s social and moral structure from any elements that could undermine our faith, ethics, and national harmony"},{"@id":"urn:doxa:passage:88f4bdb870fe71aba694049f1a9b0b2e78e67e4210e4b113a0bcf4010a55f6b4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00004","start":0,"end":66,"exact":"> Deviant cultures will never be accepted as the norm in Malaysia."},{"@id":"urn:doxa:passage:6dfae27650cdeea952064217218760d0ddcb7e59c6ac3b1e05d0f5c1ed29abf9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00005","start":0,"end":97,"exact":"Subsequently, 21 police reports have been filed at 11 district headquarters against the workshop."},{"@id":"urn:doxa:passage:f057b83f6e1b60ef1ee78a95f3d2e2684c296af6048f11226df037ee969944eb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00006","start":0,"end":111,"exact":"While 63.5 percent of Malaysians self-report as Muslim, the country's Constitution promotes religious harmony. "},{"@id":"urn:doxa:passage:1f2b9d6a4bedb2d497229b38c858d36e764e0482bfe65f954db30e44cc5a52b3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00006","start":111,"end":324,"exact":"In recent years, some hardliners have pushed for the stricter integration and enforcement of Islamic teachings in governance, which has raised concerns that it could spark racial and religious tensions in society."},{"@id":"urn:doxa:passage:e5c67df127e69ce1cc8091ae332939fc291de93696258980d372b6c2606359f6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00007","start":0,"end":186,"exact":"Amanda Shweeta Louis, chair of the Malaysian Socialist Party Pemuda Sosialis, said they were forced to postpone the workshop because of the online threats directed against their members."},{"@id":"urn:doxa:passage:123d174d14cee5c1f05cd165673b1589a814b78f89bcf7af8c79c4b69af265f7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00008","start":0,"end":140,"exact":"> Since the minister’s statement, the number of hateful comments and death threats on our social media handles has increased exponentially. "},{"@id":"urn:doxa:passage:aecba8a52efc1d8c714144b3410f6c5fedc33fad538dcee65b11fd77a4904059","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00008","start":140,"end":208,"exact":"Is violence and hatred the culture we want to normalise in Malaysia?"},{"@id":"urn:doxa:passage:21ee9d454eb3ccd7f8f5f2578099e278d2731d6ecb45f787efa6e10b57ae756f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00009","start":0,"end":236,"exact":"On June 4, two organizers of the workshop were summoned by the police in relation to investigations linked to blasphemy and “improper use of network facilities or network service” under the Communications and Multimedia Act (CMA) 1998. "},{"@id":"urn:doxa:passage:e3f267d26f41fe9b273e189022f0788adc6be2ef87e7fc6de7c6eb854862bf06","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00009","start":236,"end":309,"exact":"Their phones were confiscated, and they were made to answer 38 questions."},{"@id":"urn:doxa:passage:098edaf315a2364de7b1539e029d60ba24872b9779b6857ff692e544a6402101","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00010","start":0,"end":129,"exact":"Malaysian Socialist Party Pemuda Sosialis insisted that their planned closed-door event would not have posed any harm to society."},{"@id":"urn:doxa:passage:478146d82608d589cbc98409c700727bb7fd9eb7426d8b535fcfe2153f472079","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00011","start":0,"end":205,"exact":"> We would like to reiterate that our purpose in conducting this small-scale educational workshop is to deliver accurate sexual health information…and is not a ‘moral detriment’ as accused by some parties."},{"@id":"urn:doxa:passage:bdd1e6ea22cd85ee70b12f3680aad586e123ed0037d9327def91424960078080","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00012","start":0,"end":55,"exact":"It vowed to defy unjust policies and arbitrary actions."},{"@id":"urn:doxa:passage:4f2cf33f9a788675ceb4e6e989aaf139119af7802d3332bbc8d435b3c5966f2d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00013","start":0,"end":76,"exact":"> Pemuda Sosialis stands firmly against this wave of hatred and repression. "},{"@id":"urn:doxa:passage:04fd74007cafb4119b7ffafd68780a34d59c5e9f8078a5405117896be04a4c55","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00013","start":76,"end":217,"exact":"We will not stay silent while vulnerable groups are threatened with violence and denied their dignity, whether by the state or by the public."},{"@id":"urn:doxa:passage:7d96c4b452367ac842344a9c9b1f53753f8ab43619ad76ccb91db678131067ff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00014","start":0,"end":122,"exact":"The Centre for Independent Journalism (CIJ) reminded authorities of their responsibility to uphold freedom of expression. "},{"@id":"urn:doxa:passage:dc8ccc2505bf4cc0eb6a645e41efe257b801451ca8f88144668ecabcf4d0a45d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00014","start":122,"end":275,"exact":"It pointed out that CMA is among the laws being weaponized by the government to intimidate critics and promote “archaic values and political expediency.”"},{"@id":"urn:doxa:passage:4f1aad93870c80e24b4691410fe50bc79882ae0d00d612b8aef4cfce1767fe80","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00015","start":0,"end":273,"exact":"> Despite several actors opposing this event on the grounds of moral and religious values of Malaysia, CIJ notes that freedom of expression, which includes the expression of identity, is guaranteed in our nation’s highest legal framework, reflecting the values of Malaysia."},{"@id":"urn:doxa:passage:91e5c6075d28143c3cdbb1c6333e69e9f8c72ea4a5e963bccbe78377a3157c07","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00016","start":0,"end":139,"exact":"Nalini Elumalai of ARTICLE 19, a digital rights watchdog, said the police probe highlighted the restrictions imposed on LGBTQ+ individuals."},{"@id":"urn:doxa:passage:6f4c28d4db974db2acfa95b1b898d84db4f49c6f66ecef3f549030964dd37ba2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00017","start":0,"end":217,"exact":"> This investigation highlights the repressive environment that LGBTQI communities continue to live in and the relentless discrimination they face for merely exercising their basic freedoms to expression and assembly."},{"@id":"urn:doxa:passage:0e947993be2fa5602f850aac225fe076db71877b8425a049f18aaa6737315ee5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00018","start":0,"end":112,"exact":"She also urged elected officials to promote inclusivity instead of inciting hatred against minority communities."},{"@id":"urn:doxa:passage:6911acf4244e2cbde7305f9639194ed3cd070fb42b26b0794209655ab3974b4f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c24ddd71cfef4babf4e96e1a768d5e1d","blockId":"gv-836133-b00019","start":0,"end":234,"exact":"> They must also refrain from using stigmatising language that could further fuel discrimination, intolerance or hostility, particularly towards groups already facing exclusion and significant barriers in accessing effective remedies."},{"@id":"urn:doxa:decision:e60f8a99ff068992a90479d05257bc90","@type":["doxa:Decision","prov:Entity"],"recordId":"e60f8a99ff068992a90479d05257bc90","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:c24ddd71cfef4babf4e96e1a768d5e1d:u_399a9034b4e37e8960fa87c7","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:90c23ccdc2cea08775a2dbc75ab28e9584aa3c7f9f9690bd22003737713bf88f","urn:doxa:passage:dfb4dac3350b86d4718d2a5a7d3fb1202123b5668d42e1d2d7b395417a64f69a","urn:doxa:passage:abf40b25221a9edb06f666f193547b9991bcf7e23f560e16c35ddd