ssage:e426759b5f8cef52981ecf17b92ba827730f47a08a1399f9ada9a16c387badd9","urn:doxa:passage:28a94353b7987482076669e439837e608235e2d9f9c0d257ddf1b3356b026c9e","urn:doxa:passage:74f9fc6a293676c3e591898cd174b39e657ce278f56fcb6f98d0cdf308aa217e","urn:doxa:passage:a9379622392745d1df22eb2ac3d143b325383ea807e9ae837f3afc13a657ac69","urn:doxa:passage:9135cde61c1fc70acff98726c22d60d2d7f477f502f407a8b39fb558298f22d4","urn:doxa:passage:1cfb3d73f1613119a6074ce1406cdc5ca1ca9e5045326e8867d4f0a5b4ac652d","urn:doxa:passage:f0572dedf279b0af1ac2fc2ff4b93cf0292ce8ce648802355532d16a6b8f30e4","urn:doxa:passage:cb93138d91c6210fb2a7b74cd3e922937f7d6ff013688cd82d134671b95303f8","urn:doxa:passage:d0bf48ab37eccecd666094c5a1264d337f2530979a21cfbfa0eb9c2abcd65a42","urn:doxa:passage:e8f9effe89a9112a32a41c9ba94146a0e527adada39a86dbfbd99522bfdc09bf","urn:doxa:passage:91da500ab8fd29ade1b7a387689be640fefd2f2ed3ce7751c54687ecd6952307","urn:doxa:passage:a8d2663053cc922f39fe7d31eff9fbe286a540b9e15d26a9ffdb6c0e03cb1d4d","urn:doxa:passage:6384bb62f8efc1f695d7c895bacd92f5d9c3b3e8ec06a56596b22a7798bc4288","urn:doxa:passage:064586ab4def2b88553b2a7c82b79390334a9cf73deb2596d88bfa8b3e39f66e","urn:doxa:passage:18a448ab41018e4194277f11091d74a9f525872d60c6d951b9ef24df5301e42e","urn:doxa:passage:a16822609650f1bea6ed16ac3ce35bc4d1a431aa6420e1e1c0025c022995c3bc","urn:doxa:passage:424d6ea1565a08fa1ba2af97fd1587444a7109b379f0ed66d6c443f1c7563790","urn:doxa:passage:f94868b85a792338e0f0dfb7de6a72346e0739a491342fa601a24c4f382e5874","urn:doxa:passage:a4db63a82a1ad3a4eb76a6d9dbb9fdd13836633780d889281b274efc186103bc","urn:doxa:passage:c78166aefa877bc8eb5283eaf2becf32b12b8f7959427e72e13fad46ea94ce10","urn:doxa:passage:95116b1b8cc229517ec608e2d7249a849038b4d85a435b650cbc7926d0dfbecb","urn:doxa:passage:b7b5a3c6b820675056d1476a4187cd540da24fe7e84d7f8972d15771375afea2","urn:doxa:passage:aac046852c16b4bd189c7586607353b62627381bc34f81b658c6f98bb70caad7","urn:doxa:passage:6fe6972cda51bead6a56034ce2351a1f433edbccb4c658e71e204ccb422ee67a"]},{"@id":"urn:doxa:passage:67676efbbe5a7b2437432a752ebdebf5692ddc00d7ab70a254f41139bf9cd5e9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00009","start":523,"end":827,"exact":"Aggressive anti-female propaganda is growing in the Russian media, based on fundamentalist religious views and so-called “traditions.” In our view, the goal of this propaganda is to remove women from the economic sphere and segregate them in the sphere of unpaid domestic labour and coerced childbearing."},{"@id":"urn:doxa:passage:0d073286c4a6f75e2277c486bf8e1f0eea22a3713252b76957b0df6a1fcc0399","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00010","start":0,"end":129,"exact":"That, according to Bitten, is why there are now five categories for the anti-prize, compared to just three when it was launched. "},{"@id":"urn:doxa:passage:4addd4bc74c82037f983db55f250066350ff284576426cb1c973d6719469b2b7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00010","start":129,"end":237,"exact":"These include “awards” for the most sexist media outlet, advertisement, and policies (or policy proposals). "},{"@id":"urn:doxa:passage:9061c3124802c40766025cd032ad4899af15ab9671a398676a50a91bd4cae2fc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00010","start":237,"end":375,"exact":"Interestingly, there is also an award for “women against women,” or female public figures who support or express misogynistic viewpoints. "},{"@id":"urn:doxa:passage:67085b313e11f6d51f2c6c403c4ae81da4a84a793dcb0c3acc1da20a9be92acb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00010","start":375,"end":632,"exact":"This year, the latter prize went to Nailya Zhiganshina, chair of the Union of Muslim Women of Russia and Tatarstan, who argued that nothing could be done if a girl was married off to a boy against her will, as “parents have full rights over their children.”"},{"@id":"urn:doxa:passage:73b34714e70d33c0259b3096f0a8cfd9cc803d13fe1efa40f9d6c950deb775ac","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00011","start":0,"end":17,"exact":"A winning streak?"},{"@id":"urn:doxa:passage:7102d5da6248e563b551073bb43a1d89669972aacea1be056424cb31be34079a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00012","start":0,"end":72,"exact":"A few months into 2020, Smirnov is at the heart of another controversy. "},{"@id":"urn:doxa:passage:558c42c8f08b0d97b99f7c79c53b4e6912d4bd8e9e23e4589f9dbbc23601f516","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00012","start":72,"end":263,"exact":"On February 15, the priest, who also heads the Patriarchate's Commission on Family Affairs, made the following comments during a meeting with members of OrthodoxBRO, a Christian social group:"},{"@id":"urn:doxa:passage:2a7431704186149a7f3cd904c9fdc9aeab3701b17bef37c0b34d376e67ca35d6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00013","start":0,"end":241,"exact":"> У нас женщины сами не понимают, что такое брак. Неохота сказать, что «я бесплатная проститутка», поэтому говорят: у меня гражданский брак. Здрасьте! Да нет, ты просто бесплатно оказываешь услуги — и все, а так тебя никто за жену не считает"},{"@id":"urn:doxa:passage:855c9d4aba3f6af013da9ee43bb13b2acbea1dbcc98d4e4aa7a42d9c5778ae5f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00014","start":0,"end":59,"exact":"> Women here themselves don't understand what marriage is. "},{"@id":"urn:doxa:passage:eebdf9241d2fb251af748cca227f4d91e4c3110f4cdfb167275771abef420805","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00014","start":59,"end":171,"exact":"It's not the done thing to say “I am an unpaid prostitute,” so they say “I'm in a civil marriage.” Well, hello! "},{"@id":"urn:doxa:passage:1d234dd8c626a784b0f5fef712714b0964507f325cc65fee9926b0cef9aa61af","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00014","start":171,"end":262,"exact":"No, you're just providing services for free — and that's all, nobody regards you as a wife."},{"@id":"urn:doxa:passage:63801f5d9839bdb04ebbc9a975b24a1f4b503c6bcc89579b7e65e0d36d78a5bb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00015","start":0,"end":72,"exact":"Smirnov's outburst has angered many prominent women in Russian society. "},{"@id":"urn:doxa:passage:cc2a404a89d2d4002b87f71d3e19758b1b0b7839709e5fee942e38297e8e8adc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00015","start":72,"end":273,"exact":"Among them are not just feminist activists, but even pro-government figures who have publicly supported conservative cultural causes, such as editor in chief of the RT news network Margarita Simonyan. "},{"@id":"urn:doxa:passage:bfab4f8f90d6b55e6bfd90c86f52c3306c41d0c9e88de926109dca2e3396b40e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00015","start":273,"end":406,"exact":"In an acerbic Facebook post on February 16, Zakharova called on the church to come up with a name for men living in civil marriages. "},{"@id":"urn:doxa:passage:fba796b0511ef12f2d6c7f90b7104d081f7a1b30772f815efa28c3a421afad49","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00015","start":406,"end":566,"exact":"Ekaterina Lakhova, chair of the Union of Women of Russia, called Smirnov's words “ugly and improper,” though stressed that she supported the traditional family."},{"@id":"urn:doxa:passage:18bd0d04efbcf6d01c7fc63a8bacc43d8fcf24bf8a6af85043636b495febd4f0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00016","start":0,"end":183,"exact":"Several users drew parallels with the furore over a 2013 law against “insulting the feelings of religious believers,” and asked why clerics were not as considerate to those of women. "},{"@id":"urn:doxa:passage:00240a84ad7375cc56aaca8006c75e3b9b6af7a33889c8e83b8e3ff1f2797be9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00016","start":183,"end":318,"exact":"This Twitter user, whose handle translate as “Woman Who Has Had Enough,” sums up the feelings of many Russian women on Smirnov's words:"},{"@id":"urn:doxa:passage:1b011d88cd5693edfc2eb511acf28c76c2c1b1c390a71b2b0ff7eb7ecaf8086d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00017","start":0,"end":66,"exact":"https://twitter.com/DamaSperegarom/status/1229021320580599809?s=20"},{"@id":"urn:doxa:passage:8a456e9240d873a655d022e8f641a145bf74b52573e30dbafee5f24cc75b8d0a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00018","start":0,"end":62,"exact":"> I woke up this morning and found out that I'm a prostitute. "},{"@id":"urn:doxa:passage:b856f0ed01b79c9a1c1358db0eca78f433a865a6a9db614aa35e5ab0ea0fe656","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00018","start":62,"end":72,"exact":"Yes, yes! "},{"@id":"urn:doxa:passage:95b916a2d92ced6906c095696ebe334b4f19cd976b7ad70e1c1553fee546a5e2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00018","start":72,"end":117,"exact":"That's what archpriest Smirnov has declared! "},{"@id":"urn:doxa:passage:f2e5e28d5a14228442a715d30c091a89ffc1dba6b1dafcb82c4529f2236b8cec","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00018","start":117,"end":240,"exact":"So it means that we have an article against offending the feelings of believers, but what about offending honest citizens? "},{"@id":"urn:doxa:passage:190fca3e0840aaeb2966ff11a8377a7f419daf3ac34ccde03f358aa2d499820c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00018","start":240,"end":359,"exact":"Here's an idea: all of us, Russian women, should write a mass declaration against Smirnov for offending [our feelings.]"},{"@id":"urn:doxa:passage:fbaf8d30f3f8282a293632176725a545a6b392bc8873dbcd21f858e84efb3a07","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00019","start":0,"end":95,"exact":"Smirnov, who says he has received threats online for his words, has nonetheless defended them. "},{"@id":"urn:doxa:passage:d903978b99f807fda257782db09be7518d4aa60339199d1dba70fac485fa4f21","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00019","start":95,"end":202,"exact":"In this interview with RadioBaltkom on February 19, Smirnov complained of inaccurate journalistic coverage:"},{"@id":"urn:doxa:passage:353622d0deb75c1cf9383b06ad4ba56fc93d365842944f553ea5f0095ce91be5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00020","start":0,"end":380,"exact":"> Вот пишут, заголовок – «Смирнов оскорбил половину русских женщин». Женщина, когда читает, уже готова к тому, что ее оскорбили. Я никакую женщину никогда не оскорблял и вообще считаю это ниже своего собственного достоинства. У меня совершенно другие задачи, а здесь вообще слова выдернули из контекста. Вообще, вся беседа была посвящена мужчинам, которые недостойны такого звания"},{"@id":"urn:doxa:passage:5087e01bf36f68e84ddb1aa727a4e799841642c16efcaa4ef425c817ee5ea31b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00021","start":0,"end":167,"exact":"> Here they write, in quotation marks: “Smirnov has offended half of Russian women.” When a woman reads that, she's already open to the fact that she's been offended. "},{"@id":"urn:doxa:passage:5c037ca83cfacc6edc50cf6d4d14fe2e1b1d77bec1a0e9354d5b72a39aba6895","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00021","start":167,"end":241,"exact":"I have never offended any woman and consider it beneath me to ever do so. "},{"@id":"urn:doxa:passage:d66b8e7ccdecb45d6b85a1ebfbb58b8c026a65904bb154db3ea438e58fe1f30b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:96f457489e551382ea19273005b15d39","blockId":"gv-699775-b00021","start":241,"end":338,"exact":"My goals are completely different, and here my words have been entirely torn from their context. "},{"@id":"urn:doxa:decision:0421ece7cb58f2330bcbe803faa545f0","@type":["doxa:Decision","prov:Entity"],"recordId":"0421ece7cb58f2330bcbe803faa545f0","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:96f457489e551382ea19273005b15d39:u_da07d08d90055149e7908152","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:67676efbbe5a7b2437432a752ebdebf5692ddc00d7ab70a254f41139bf9cd5e9","urn:doxa:passage:0d073286c4a6f75e2277c486bf8e1f0eea22a3713252b76957b0df6a1fcc0399","urn:doxa:passage:4addd4bc74c82037f983db55f250066350ff284576426cb1c973d6719469b2b7","urn:doxa:passage:9061c3124802c40766025cd032ad4899af15ab9671a398676a50a91bd4cae2fc","urn:doxa:passage:67085b313e11f6d51f2c6c403c4ae81da4a84a793dcb0c3acc1da20a9be92acb","urn:doxa:passage:73b34714e70d33c0259b3096f0a8cfd9cc803d13fe1efa40f9d6c950deb775ac","urn:doxa:passage:7102d5da6248e563b551073bb43a1d89669972aacea1be056424cb31be34079a","urn:doxa:passage:558c42c8f08b0d97b99f7c79c53b4e6912d4bd8e9e23e4589f9dbbc23601f516","urn:doxa:passage:2a7431704186149a7f3cd904c9fdc9aeab3701b17bef37c0b34d376e67ca35d6","urn:doxa:passage:855c9d4aba3f6af013da9ee43bb13b2acbea1dbcc98d4e4aa7a42d9c5778ae5f","urn:doxa:passage:eebdf9241d2fb251af748cca227f4d91e4c3110f4cdfb167275771abef420805","urn:doxa:passage:1d234dd8c626a784b0f5fef712714b0964507f325cc65fee9926b0cef9aa61af","urn:doxa:passage:63801f5d9839bdb04ebbc9a975b24a1f4b503c6bcc89579b7e65e0d36d78a5bb","urn:doxa:passage:cc2a404a89d2d4002b87f71d3e19758b1b0b7839709e5fee942e38297e8e8adc","urn:doxa:passage:bfab4f8f90d6b55e6bfd90c86f52c3306c41d0c9e88de926109dca2e3396b40e","urn:doxa:passage:fba796b0511ef12f2d6c7f90b7104d081f7a1b30772f815efa28c3a421afad49","urn:doxa:passage:18bd0d04efbcf6d01c7fc63a8bacc43d8fcf24bf8a6af85043636b495febd4f0","urn:doxa:passage:00240a84ad7375cc56aaca8006c75e3b9b6af7a33889c8e83b8e3ff1f2797be9","urn:doxa:passage:1b011d88cd5693edfc2eb511acf28c76c2c1b1c390a71b2b0ff7eb7ecaf8086d","urn:doxa:passage:8a456e9240d873a655d022e8f641a145bf74b52573e30dbafee5f24cc75b8d0a","urn:doxa:passa