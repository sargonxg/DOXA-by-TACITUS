998fed9b6f74dace5029b6b30bc0069290b122043b0f1edfa0944b3"]},{"@id":"urn:doxa:decision:71daa994a3257f3530abf32f548cf4fb","@type":["doxa:Decision","prov:Entity"],"recordId":"71daa994a3257f3530abf32f548cf4fb","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:82809a1dca03ff6b9e0f2f7b7748177f:u_fdf3a925ca88187868f8c651","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:6f89b7f1b046dca808f03aae74ad58c6e4918b8a00485b32edc554e99733e95a","urn:doxa:passage:eb59c99f7e0cb29b5feb761711f13a3589a75894c59f6a58236f2fa93d370e07","urn:doxa:passage:49f969e9f998fed9b6f74dace5029b6b30bc0069290b122043b0f1edfa0944b3"]},{"@id":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-797677","title":"Iraqi Assyrians struggle for freedom of expression amid political and extremist threats","author":"Saman Dawood سامان داود","translator":["Honey Hashem","Mariam A."],"publishedOn":"2023-09-26","sourceUrl":"https://globalvoices.org/2023/09/26/iraqi-assyrians-struggle-for-freedom-of-expression-amid-political-and-extremist-threats/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"28838f9aebc447f11c89a97242fa2bb7bf307d98d78dba7eaf496dba6b68ebf4","textSha256":"8800337eb2a8ba78a8743403ada9d8dd1848260dceba3acff439ae077f9cd116","archivedRecordSha256":"01883c73c31601259ca3d6cd143fe0a2e84171fc2e2eb7edf631e9505527c522","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:0e9f9553a6bf8d137818af3d0c4dca51:u_3d6482f7d008980666a116e0","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_3d6482f7d008980666a116e0","status":"accepted","fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51"},{"@id":"urn:doxa:unit:0e9f9553a6bf8d137818af3d0c4dca51:u_47573188b029323b142b5518","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_47573188b029323b142b5518","status":"accepted","fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51"},{"@id":"urn:doxa:unit:0e9f9553a6bf8d137818af3d0c4dca51:u_6a0255c3f2cc790b3e85cc7d","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_6a0255c3f2cc790b3e85cc7d","status":"accepted","fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51"},{"@id":"urn:doxa:passage:e3e34951a6ab9d8cc4222032e2d6920f7b0406ac88a5cd84cee62a9f2c2c9b28","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00027","start":0,"end":127,"exact":"Constitutional recognition of Assyrian linguistic rights and technological progress has fueled optimism about Assyrian future. "},{"@id":"urn:doxa:passage:8c0151bd4d51b1e96e95db63d64d978cf34e0814a85ca28a10d8d8728af6acf9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00027","start":127,"end":267,"exact":"The digital age has equipped Assyrians with powerful tools to express themselves in their own language, and revitalize their mother tongue. "},{"@id":"urn:doxa:passage:135c5b713fb110435afadaa9e34df1391fcb58e0623ddee864aa8679db2956fa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00027","start":267,"end":415,"exact":"Social media platforms, online forums, and Assyrian-language websites have become hubs for communication, content sharing, and cultural celebration."},{"@id":"urn:doxa:passage:b05524fcdd87ee4536045773820825d717b723f4827768922123700b1b00903b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00028","start":0,"end":210,"exact":"Iraqi Assyrian journalist Khalpeel, detained by Kurdish troops in 2019, highlighted in a conversation with Global Voices that the Assyrian language gained support from iOS and Android mobile operating systems. "},{"@id":"urn:doxa:passage:5a99fb1a8b56748d287ce9d42bd8af0a35993dd869ee9fe29f4c4ddac0549788","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00028","start":210,"end":318,"exact":"A group of Assyrian youth is diligently working on integrating the Assyrian language into Google Translate. "},{"@id":"urn:doxa:passage:a59e514f36e7bb2ca2b988054ea0640d6cc23dd9058f0329a2aad59afdb9c0c7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00028","start":318,"end":332,"exact":"Khlapeel said:"},{"@id":"urn:doxa:passage:04249c7b4b99626369cf1ff8881a6e0fa8ecab50857f6f250ee08311dcfeea53","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00029","start":0,"end":118,"exact":"> Technology has been a tremendous asset for Assyrians, playing a pivotal role in revitalizing our cultural heritage. "},{"@id":"urn:doxa:passage:f8ad8c187258ca6c70b6b7f5412b82667a6a1b1590f13322e7a078c84dad6a37","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00029","start":118,"end":194,"exact":"It has provided us with the means to use our language in the digital world. "},{"@id":"urn:doxa:passage:65fbf688a9adc395aae2e27aeb90c27fcc2eb21c99a50288841c5486d6bc7f08","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00029","start":194,"end":269,"exact":"Today, Assyrians around the world can communicate using their own language."},{"@id":"urn:doxa:passage:7bd7092bcdf46c222b640634e9ea76e703924a9e12663fda437e253367f5d90f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00030","start":0,"end":176,"exact":"Despite significant progress, freedom of expression in Iraq, especially for Assyrians remains grim, entangled in a broader context of fear, threats, violence, and persecution. "},{"@id":"urn:doxa:passage:0fbf04b0243e3fac5f08ccf1bc40ea471e818b6b43edd5a7e8006de889084675","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00030","start":176,"end":261,"exact":"In the World Press Freedom Index (WPFI) Iraq ranked 172 out of 180 countries in 2022."},{"@id":"urn:doxa:passage:2f0903294ce1032f894bbb03598f4674d1bbf1ed936a4406f569397295747dbe","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00031","start":0,"end":129,"exact":"In recent decades, Iraq’s Assyrians were forcibly moved to Kurdish-controlled areas, facing severe penalties for non-compliance. "},{"@id":"urn:doxa:passage:d879ad5696c74d66afb55b4f91c2733f1068efe9d38d14312de089200589bb89","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00031","start":129,"end":324,"exact":"Despite constitutional guarantees of religious and linguistic freedoms, ongoing oppression, religious discrimination, and movement restrictions, have left them with little choice but to emigrate."},{"@id":"urn:doxa:decision:0102cf9f401962a466723ac99184276b","@type":["doxa:Decision","prov:Entity"],"recordId":"0102cf9f401962a466723ac99184276b","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:0e9f9553a6bf8d137818af3d0c4dca51:u_3d6482f7d008980666a116e0","attribution":"unknown","speak