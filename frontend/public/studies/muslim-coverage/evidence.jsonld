67","urn:doxa:passage:b41d9a3d51ee349e038d2b524ac9f2b3bd8e4ac4af8affffca95e6ba48a8a215"]},{"@id":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-785886","title":"Undertones: What do onions have to do with the Turkish elections?","author":"Civic Media Observatory","translator":[],"publishedOn":"2023-04-26","sourceUrl":"https://globalvoices.org/2023/04/26/undertones-what-do-onions-have-to-do-with-the-turkish-elections/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"f976fb2943dddea2b98a737eca88add359933ef41bcee70298c0cc977c43792f","textSha256":"1240585dcece2c6a4c45608b281e47a6b43c15764f0f959b4e59325505a7ac45","archivedRecordSha256":"f22545670be3ceeb47f1d0c9eb19ea001ba4dfc38865a729db293b0b8243f9cb","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:a0a9681611bb4e1b48173fc50b40e0f4:u_289701977e18de33cb695b80","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_289701977e18de33cb695b80","status":"accepted","fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4"},{"@id":"urn:doxa:unit:a0a9681611bb4e1b48173fc50b40e0f4:u_3868629560a50eba6614bc25","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_3868629560a50eba6614bc25","status":"accepted","fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4"},{"@id":"urn:doxa:passage:1a82a9c8002a9148cea65475c5ecd453eb1ac95324cba520f1c56bbda2feec62","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00001","start":0,"end":87,"exact":"This story is part of Undertones, Global Voices’ Civic Media Observatory‘s newsletter. "},{"@id":"urn:doxa:passage:2fa0891a570fc7f78012da8ce21ce4bd0e30e1ae9a68a3e8082edcb2e2e1b2df","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00001","start":87,"end":111,"exact":"Subscribe to Undertones."},{"@id":"urn:doxa:passage:876d2f19e83b7536669c65bfa9d8ef7504b3edb0786c01ee1c519ebd9c66b033","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00002","start":0,"end":107,"exact":"Turkey is headed for general elections scheduled for May 14, 2023 amidst important campaigning narratives. "},{"@id":"urn:doxa:passage:fcc494bbd64afa6775e15136969000c0fe1685b9c959a45a46cec1428544e12c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00002","start":107,"end":330,"exact":"Sencer Odabaşi, a Turkish researcher from Global Voices’ Civic Media Observatory, will guide us through the most important pre-electoral narratives at play to understand how Turkey's citizens are perceiving these elections."},{"@id":"urn:doxa:passage:62a661de8e3238684530e51b7014a6eeb83a24dfc0c5bcca694ebe39c76fa567","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00003","start":0,"end":147,"exact":"Today, millions of Turkish citizens who want Erdoğan out – about 53 percent of the population, according to recent polls – are hopeful and nervous."},{"@id":"urn:doxa:passage:f7b28fd5325a7ad4bfee3d00a3be986225a45fe792d812f707caa3b76e4dff79","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00004","start":0,"end":117,"exact":"Hopeful, because if the opposition wins, they believe democracy has a chance to be restored, along with the economy. "},{"@id":"urn:doxa:passage:0b42db8d2b70eced35b3cca580c66ba7c7fa8de8aff1d3de0efda899ddf8b180","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00004","start":117,"end":316,"exact":"Nervous, because if Erdoğan and Justice and Development Party (AKP for its acronym in Turkish) win, “it may be Turkey’s last elections, given how increasingly authoritarian the president has become.”"},{"@id":"urn:doxa:passage:a71f2fb9a770a615848a4dbdcf203c5eba18080ae6e3d339255c9dc43cf70af3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00005","start":0,"end":33,"exact":"No one truly knows who will win. "},{"@id":"urn:doxa:passage:493a58598725ebad17f7daac9f2bc2ccdf4ed659228668daf8bb7e31b93b6534","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00005","start":33,"end":176,"exact":"Most polls show tight results between the candidates, and historically, most polling companies failed to predict the results in past elections."},{"@id":"urn:doxa:passage:71362f8d5a22158fbcf017dce41f1e4c444b9d9eec1dfe3f9c77e55c344e2beb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00006","start":0,"end":104,"exact":"Turkish citizens are still reeling from this year’s devastating earthquakes and skyrocketing inflation. "},{"@id":"urn:doxa:passage:992b87ab28bdba200c039714eeae69160ea5b90d9a987432d6f5b236275c0565","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00006","start":104,"end":185,"exact":"In this taut context, some everyday items have been elevated to a status symbol. "},{"@id":"urn:doxa:passage:0cdb8398df190a86de9dffba3c7d5807eb596d817d6be13958b52b3baac2a4f3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00006","start":185,"end":232,"exact":"Onions, prayer rugs, and cars are on that list."},{"@id":"urn:doxa:passage:de08bcedceb0ced75381e7f17dd1e0a541baf71b028911dd8b40bacaefa4b9b0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00007","start":0,"end":32,"exact":"On the side of Erdoğan’s critics"},{"@id":"urn:doxa:passage:000304af7754d7ed0f033a8d4b63a27095bf264ff39de7c6fff7ed21fc32c1e7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00008","start":0,"end":54,"exact":"“The inflation and currency crises are out of control”"},{"@id":"urn:doxa:passage:22e61627be87daff732e05073098e69a6580789c9b68f77cae166b729ff5b92c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00009","start":0,"end":115,"exact":"This narrative in a nutshell: “No one can afford anything anymore, and it’s because of the government’s corruption”"},{"@id":"urn:doxa:passage:2ba8a7b7f4ebf3b53868d26a7029119f4677d7012e1677f4a79ff4f6e0440079","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00010","start":0,"end":103,"exact":"The poor management of the Turkish economy is the opposition’s main argument against the ruling party. "},{"@id":"urn:doxa:passage:e542e861cc198ea8b4b48cc66ba48d71faaaa68155d4154a907b3083757d3143","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00010","start":103,"end":184,"exact":"Inflation in Turkey reached nearly 100 percent in 2022 and is now at 60 percent. "},{"@id":"urn:doxa:passage:09ec3ae4db301740e69bfcb3a92ae35c24f41b9f5e29087f6d1a86034f681065","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00010","start":184,"end":251,"exact":"In everyday terms, people are struggling to pay rent and buy food. "},{"@id":"urn:doxa:passage:2e7d3229db9a94964bfca21433724be480cdd2c3aa95a119cc8621e42bd1a726","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00010","start":251,"end":378,"exact":"“The middle class disappeared in Turkey,” Odabaşi says, and malnutrition is becoming a threat, according to opposition figures."},{"@id":"urn:doxa:passage:9f6c91ec90927d00cd609217ac4616a81e4a33341e34d34d89b372efabf920a8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00011","start":0,"end":186,"exact":"The main opposition bloc – led by Kemal Kılıçdaroğlu and his diverse “Millet” coalition – claims that the economy is suffering because of corruption and bad overall economic management. "},{"@id":"urn:doxa:passage:2e35a920f65dbd62868bdd5475c45fac0c5a436af613e9067c66ec3468693cdb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00011","start":186,"end":427,"exact":"Since the Millet coalition gathers politicians of different stripes who do not fully agree on economic solutions, their main argument is that democracy must be restored in order to give a chance to meritocracy, and as a result, the economy. "},{"@id":"urn:doxa:passage:06d931643cc4f978ae47107c24e5520a0d600263a6d96d9d8aca98e9ef134916","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00011","start":427,"end":574,"exact":"One of their main campaign promises is to give back power to lawmakers, who lost their leverage when Turkey embraced a presidential system in 2016."},{"@id":"urn:doxa:passage:40286e63fcd544d5263f99d48490153a664bcd8aa363d6f0ce17e5f05a07bbc1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00012","start":0,"end":127,"exact":"Today, even complaining about the price of onions can be “seen as an act of defiance” by the government, according to Odabaşi. "},{"@id":"urn:doxa:passage:6fb5d94488e9121857e3e7943583221fbb6f47e6bdfb38aeb9e3cbaddb5cc768","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00012","start":127,"end":287,"exact":"By lamenting about the challenges of living in a hugely inflationary economy, citizens earn the wrath of the government, which blames them for being ungrateful."},{"@id":"urn:doxa:passage:76319f54efd96690299125fa971fe0649f2e3d99c8104cca4dedefb11ddaca4c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00013","start":0,"end":118,"exact":"An example of how this narrative spreads online: “What is the first thing that comes to mind when you see this photo?”"},{"@id":"urn:doxa:passage:d900f87e918c26be9b8bf20a8deebe2b22c4700baeeea8d20db710c7492f62a6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00014","start":0,"end":27,"exact":"Where it is shared: Twitter"},{"@id":"urn:doxa:passage:9d1f3145ce2e30255ac1b469c6a324ca4a1329045ac7baa8c59685a884a5d323","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00015","start":0,"end":79,"exact":"Author: Vedat Milor, a Turkish scholar, gourmet, wine sommelier, and celebrity."},{"@id":"urn:doxa:passage:a4ba9fb23099c66fda1817b4788329312c5fffff98c4c1d32f9e71350c7a4002","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00016","start":0,"end":118,"exact":"Content: Milor shared a photo from a supermarket showing that a kilo of onions is being sold for 26,49 TL (1.36 USD). "},{"@id":"urn:doxa:passage:a12d564279311cd3f4f3c63dd0150f6c445aa4c5a4b58ef139561998e3afa874","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00016","start":118,"end":212,"exact":"In the caption, he asks, “What is the first thing that comes to mind when you see this photo?”"},{"@id":"urn:doxa:passage:e72d12c77429c67d6452d9960e02a7e7b626032f3484279c566d646d7d53c9b4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00017","start":0,"end":73,"exact":"Context: The price of onions has increased ninefold since December 2021. "},{"@id":"urn:doxa:passage:9e1f0ddfbde94e8a889cb969c1b2eb78c20ae9f82b1e520692235480701352ef","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00017","start":73,"end":211,"exact":"Onions, a staple in Turkish cuisine and generally considered the cheapest option to find in a grocery store, are now increasingly costly. "},{"@id":"urn:doxa:passage:70c8dd3f9539dac8162ab40f43391bb8c8b6e773e58da04de1ab3c5a2b462042","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00017","start":211,"end":296,"exact":"There are even proverbs in Turkish about eating onions and bread to refer to poverty."},{"@id":"urn:doxa:passage:b516881c8c6cf7d63edc25fb6e352d1dba8591c170a0af9a661340ad55ae0f55","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00018","start":0,"end":87,"exact":"Subtext: Milor received backlash for speaking about politics instead of food recently. "},{"@id":"urn:doxa:passage:57ed17f9d922f88935a3638ad008e41ad1210d589fe6179ae3ebd40cc92bea68","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00018","start":87,"end":138,"exact":"He shared this image as a response to the backlash."},{"@id":"urn:doxa:passage:a04c763036fa37b57f11ce997a6dc06d1284577a75c523fdc9734c122dda4cc0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00019","start":0,"end":156,"exact":"Civic Impact: +2 out of +3, because a celebrity food critic speaking up about nutritional issues of popular classes is rare and has a positive civic impact."},{"@id":"urn:doxa:passage:03015fffc9e33922329d0d160a03b83150520544fc53c5b89cb6be562223ed26","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00020","start":0,"end":39,"exact":"See this item’s complete analysis here."},{"@id":"urn:doxa:passage:e76d1cf4196761dd8a55f8c8238713a61fe7e1b5f48c03de6ed6a209bad7502a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00021","start":0,"end":28,"exact":"Other developing narratives:"},{"@id":"urn:doxa:passage:79f26a43c30b8528242a6c5390459ee8e4d63051899bffc995c2b300274283fc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00022","start":0,"end":70,"exact":"- “Erdoğan is willing to use all means necessary to win the elections”"},{"@id":"urn:doxa:passage:b72395a0652d9db8b7ad3c1a23c153fd12426c2446aafc6c135a2e00e336c953","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:a0a9681611bb4e1b48173fc50b40e0f4","blockId":"gv-785886-b00023","start":0,"end":64,"exact":"- “Erdoğan’s ‘Cumhur’ alliance is a radical right-wing alliance”"},{"@id":"urn:doxa:decision:4f56be05370f81c8e657a25eedf0554a","@type":["doxa:Decision","prov:Entity"],"recordId":"4f56be05370f81c8e657a25eedf0554a","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:a0a9681611bb4e1b48173fc50b40e0f4:u_289701977e18de33cb695b80","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:1a82a9c8002a9148cea654