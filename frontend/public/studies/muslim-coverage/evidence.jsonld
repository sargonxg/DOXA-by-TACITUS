fa10592","urn:doxa:passage:93b7bc3178508fadb52031099ca4afe174a63162a927fec5c09cf6fa2733db9b","urn:doxa:passage:ae5af21f8438ba1d2e31f7985455865c25c98a4dd44dc77a98371827db1609cc","urn:doxa:passage:9e0a4c443efaf2e8712cea5e1cc231dcdb0495d69bf2e5499c5904160ef2365e","urn:doxa:passage:abf4f64a7de67b43109c5b23b2cbd97cf768099bacb00d3f506f8c7e4ab18071","urn:doxa:passage:1d0ea5dcaf3b03066b26ed3afbe8249226e483812df9209c4c8c226885619906","urn:doxa:passage:8868f06b0aed9f98a7c0902bec4ab3a0b40f233f14c0e7957a51c76f9e2ce5d3","urn:doxa:passage:1c784d4d803c326fa3c10edd4a6accc0a5ea4be6b32358f14f56c99f60fb4cdd","urn:doxa:passage:5b5591b6933ef5c7f21c659ce63b15f4f817efecb21b6fe725ac2d7a5d6ade99","urn:doxa:passage:3bb6b787d1a6a97d3fac6632710264960256d501efd28979323cc9c631b8e2f3","urn:doxa:passage:5f7bfff1ae8a498df9584e8d28afd5c687944724bcb94ab45f66ed66ac707c94","urn:doxa:passage:a1d04b1271a929a7c75403904c440ff5cb26a2b872869681a4ad6c13b3a7f0b7","urn:doxa:passage:f0fcb4600f011b5f49793742ec08e44b829633d95eeeb76fe6e672990021d6e7","urn:doxa:passage:27f8227cfbf2d07fc7825342bb12fced6b035e2df24cafc2c410b3f2e4686c4e","urn:doxa:passage:71e17453f6571f0eda2b60c04f8539395ad10e1fef667a5e83c75da9f2650faf","urn:doxa:passage:ce3b70f9c36cbaa8579abec669233d510fe314fe8ed647904c5f7f2481335293","urn:doxa:passage:3d41a032ce2816c7df2162bed8bc3adabdd1d987b5c00eb5646a1714cdca8d69","urn:doxa:passage:db698cc2bd98125dd83d449275636cb8aafd341943e09eafdaf1517cd28a916e","urn:doxa:passage:073648f491d58338d68cefe2fc27a159d9f7fa6ee3a87379065b2a2be33166ba","urn:doxa:passage:197bcf8330ff0309978a38cacfa8a5e0b98a7353b7233182dfcc59523055c282","urn:doxa:passage:f7ce988699f0ca93f9a31985d2687d6cec72b1797d48f37c94d45e0685c33318"]},{"@id":"urn:doxa:passage:54d05f5e5418ebb2d703b9a63452257d60e1be20d4011925b9fbdab3afa8aad2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00001","start":0,"end":158,"exact":"In 2014, agriculture professor Sophia Wilcox at the University of Maryland launched the Women in Afghanistan (WIA) program to teach Afghan women how to farm. "},{"@id":"urn:doxa:passage:ca3543cca048683d51258f865a8bc84a8108d47b07dd1cb28f57aadec61ff78c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00001","start":158,"end":228,"exact":"It was a seed of hope among barren soil marred by decades of turmoil. "},{"@id":"urn:doxa:passage:348142a4f71bb4b0353c3a6ef4a1975719952acc9cf6bd82cbdad03fec256b31","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00001","start":228,"end":446,"exact":"Through her, I met and interviewed several women whose lives have since unraveled under the Taliban rule: a pregnant activist in hiding, a midwife barred from working, and a polio advocate unable to save more children."},{"@id":"urn:doxa:passage:be6e37045c9ff24e1075dcd0a2fc9b52e0b9fafd53a81d7a6e1d36709ee835ff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00002","start":0,"end":61,"exact":"Their names are changed in this article for security reasons."},{"@id":"urn:doxa:passage:d4a2eebc532ad8b906f587b76aa3dfec99d7baff78cdaa155cc123b27ec32c83","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00003","start":0,"end":314,"exact":"After the United States’ withdrawal from Afghanistan in 2021, at-risk Afghans were offered three pathways to safety: the overwhelmed Special Immigrant Visa (SIV) program, the rare Priority-1 (P1) refugee referrals, and the Priority-2 (P2) track requiring civil society workers to self-evacuate to a third country. "},{"@id":"urn:doxa:passage:8863704b47bc1334878fc4306625ead07b89176ed8151589868185641ec3c9e3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00003","start":314,"end":395,"exact":"But neighboring Pakistan has begun detaining and deporting undocumented Afghans. "},{"@id":"urn:doxa:passage:6fd9d37e8f6616206ab72fcfac0d2e5feda8764d91297524ffd0691d67c3e8e7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00003","start":395,"end":503,"exact":"The situation worsened when the Trump administration indefinitely froze refugee admissions from Afghanistan."},{"@id":"urn:doxa:passage:6af1048e327fb45a318998840e8a5780eab41c1e5f1a975911f3b3afc488cf82","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00004","start":0,"end":127,"exact":"The narratives of these women unearth the repercussions of political abandonment and healthcare failures under the new regime. "},{"@id":"urn:doxa:passage:0d34a079730e78abc6835a74932a03172a5ec00d27b4c2e68410135698bcfb2c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00004","start":127,"end":186,"exact":"The strongest voices are silenced before they can be heard."},{"@id":"urn:doxa:passage:9d10d07b47ca8d6999e0f0b46965e289e8e22bda75d89f6e4c4c5138bc001954","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00005","start":0,"end":42,"exact":"When cultivating change becomes impossible"},{"@id":"urn:doxa:passage:f5e4c03ea385ab7ccf0e6e80009123710f8c2759bfa5c34a8cd169efd2892297","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00006","start":0,"end":116,"exact":"At 17, Fatima’s drive for change took root when she defied her family’s expectations to study chemical engineering. "},{"@id":"urn:doxa:passage:520be29137abf949fce8d48be905c41b693091921f0878ae343df35635dfd84a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00006","start":116,"end":244,"exact":"Her brother followed her to university every day until he was convinced she wasn’t doing anything “haram” (forbidden in Islam). "},{"@id":"urn:doxa:passage:00da1dd57c6173991a130c99b695a7148b2c57477c58ce16a106cf4c6b933c2d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00006","start":244,"end":368,"exact":"With her father’s support, she persisted — and later dedicated herself to transforming how families viewed girls’ education."},{"@id":"urn:doxa:passage:949ea7587a71c5d4dbe08662ea6f7bffebb03752711e628fd9bd23a05afa4489","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00007","start":0,"end":60,"exact":"Afghanistan’s educational progress has always been fragile. "},{"@id":"urn:doxa:passage:37935838136f731c6636dd258cd482e2200f9d65a330b1d8722c156729d06f40","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00007","start":60,"end":128,"exact":"Before the Soviet invasion in 1979, schooling was slowly expanding. "},{"@id":"urn:doxa:passage:d3761228ed13245a674e049d7e193eaca967eacb16ad8ad9d8bbe348b438ac52","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00007","start":128,"end":260,"exact":"The Soviets introduced reforms, but the prolonged military conflict between the different mujahideen factions reversed those gains. "},{"@id":"urn:doxa:passage:7e251df8c706e6979a05c3b7b2045cc7ef2093fce5609fd458f41eb013113feb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00007","start":260,"end":344,"exact":"Under the first Taliban regime (1996–2001), girls were barred from school entirely. "},{"@id":"urn:doxa:passage:fc94de2f21a3272bfbac6c82d71334cf20e170298a7a7e2829e7aec96288f2ff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00007","start":344,"end":392,"exact":"After the 2001 U.S. invasion, schools reopened. "},{"@id":"urn:doxa:passage:1d7eb886010026b99bba26b1aebd480942f24ae9d1389fdf41b2c748a7a9f2ef","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00007","start":392,"end":487,"exact":"Today, Afghanistan is the only country that bans both secondary and higher education for girls."},{"@id":"urn:doxa:passage:1160d45bc8b06d9e432a855c5080101dfa7b590909c4be193c66abea486fd9e3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00008","start":0,"end":96,"exact":"After graduating, Fatima founded a grassroots NGO that promoted education and civic engagement. "},{"@id":"urn:doxa:passage:0bb1c39b51ef6c16315293eba49622a4f5f39efb55c5ca5dfaaeaa40c9b8cab1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00008","start":96,"end":233,"exact":"Her team turned to imams (Islamic religious leaders) and referenced the Quran, which supports the pursuit of knowledge for every Muslim. "},{"@id":"urn:doxa:passage:71671914b587dd198c543144526271a2aebc5cc108cce471e5b83b803ffe876a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00008","start":233,"end":313,"exact":"She also became a community mobilizer, a council deputy, and a local radio host."},{"@id":"urn:doxa:passage:3d98aec2e7bf961f5aa646c81f92f888ff0789ab5766f74c7349df9824daa1ea","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00009","start":0,"end":140,"exact":"Her unwavering dedication to social impact, documented through numerous interviews and social media posts, drew attention from the Taliban. "},{"@id":"urn:doxa:passage:d7355ca290f0ba2e93e25c4756240666fb3da0a99caf093b77ed53f851e8ea58","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00009","start":140,"end":258,"exact":"However, since the government was then under the Islamic Republic of Afghanistan, she was able to navigate this risk. "},{"@id":"urn:doxa:passage:9e491c11883852454bd4458f1d478a8f7b0985690d5ab6abaadbed7dbc130b88","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00009","start":258,"end":360,"exact":"But, ever since the Republic was overthrown by the Taliban in August 2021, her life has been at stake."},{"@id":"urn:doxa:passage:6db903ce62ea1c62a4c2cb9fcc631d0a5ec62a713330e5daca0d35987abc116b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00010","start":0,"end":54,"exact":"Her province fell to the Taliban within three months. "},{"@id":"urn:doxa:passage:39bc9f291ee8b5d413e9ba9bbb3729b20d47666ecbaa598ce6a29ce08b8859a5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00010","start":54,"end":135,"exact":"She briefly fled, then returned to a community where Taliban searches had begun. "},{"@id":"urn:doxa:passage:dcfacc212a182f312e0a9774963d7f2f3a4d87e2c380b0acd5bc720cfd37c1ff","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00010","start":135,"end":191,"exact":"Relatives warned her that gunmen were asking questions. "},{"@id":"urn:doxa:passage:8faa9fea2ec2f38996ff00a9a76d2fd85719ba35664453317e5801c6fa7c57e5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00010","start":191,"end":276,"exact":"Then came the threats: a phone call informing her that colleagues had been beheaded. "},{"@id":"urn:doxa:passage:df6f12b2ab307abc191ed285a533716d57fe8fc7d9a52734ccccb8ede275e0b4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00010","start":276,"end":347,"exact":"Another offering a former colleague a Taliban post if he turned her in."},{"@id":"urn:doxa:passage:490fba85f0c83c89393f433363b3bcb9a9f47f5800e2a85d0d4fcf0cceb21cfc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00011","start":0,"end":96,"exact":"Her father urged her fiancé — formerly the WIA project’s security manager — to help her escape. "},{"@id":"urn:doxa:passage:b9c6308ca37faae159b7c9eb20d5fd7acc1c4ec28ad1a5812a675d77126d147a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00011","start":96,"end":170,"exact":"They married in secret, went into hiding, and sold everything to survive. "},{"@id":"urn:doxa:passage:e302b1c215903283e3bd363d581a39d884446b270ab03508f47d267e1471a168","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00011","start":170,"end":197,"exact":"But they couldn’t get out. "},{"@id":"urn:doxa:passage:9da36daab08dde2eea3895fdec2ff299845625ded48513b9965f4b8a2c74aa8e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00011","start":197,"end":316,"exact":"Targeted murders have been unprecedentedly increasing, and the bodies of the people they once knew continue to surface."},{"@id":"urn:doxa:passage:d1ce0571aff27bae80b5d9016eaecda769e6e381b58d8c00349f7f6da41367d1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00012","start":0,"end":52,"exact":"Fatima hasn’t seen her family in nearly four years. "},{"@id":"urn:doxa:passage:dd73ae6e5375f81a190d7453446213bc6371dd4900dd63f47f4c0adb7dfcb841","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00012","start":52,"end":125,"exact":"She spends her days confined indoors, moving outside only when necessary."},{"@id":"urn:doxa:passage:6f505eca9b0e0474302606b5fb55b13fc2d06c232f647ae822915ea3765466f9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0eb1d18162d1295309be1eafa9829b32","blockId":"gv-840669-b00013","start":0,"end":174,"exact":"Her struggles are compounded by her young son, who is fighting a severe kidney disease, and a very difficult pregnancy, which has made her too weak to safely get an abortion."},{"@id":"urn:doxa:decision:7873af13543a440e9ec6ee2fbb55c8c8","@type":["doxa:Decision","prov:Entity"],"recordId":"7873af13543a440e9ec6ee2fbb55c8c8","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:0eb1d18162d1295309be1eafa9829b32:u_ebdb6a46d7a7647a2bfe5990","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:54d05f5e5418ebb2d703b9a63452257d60e1be20d4011925b9fbdab3afa8aad2","urn:doxa:passage:ca3543cca048683d51258f865a8bc84a8108d47b07dd1cb28f57aadec61ff78c","urn:doxa:passage:348142a4f71bb4b0353c3a6ef4a1975719952acc9cf6bd82cbdad03fec256b31","urn:doxa:passage:be6e37045c9ff24e1075dcd0a2fc9b52e0b9fafd53a81d7a6e1d36709ee835ff","urn:doxa:passage:d4a2eebc532ad8b906f587b76aa3dfec99d7baff78cdaa155cc123b27ec32c83","urn:doxa:p