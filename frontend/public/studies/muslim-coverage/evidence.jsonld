017df7cfb190c480826fd4abfba615f3a0","urn:doxa:passage:4960edca3281a3d3ab1144646a737d50bfa0da206ce02dd5faab63353c97118e","urn:doxa:passage:9c615e49f95ff38f41c590787c9bd781b893ade9e172b8a4f6d87376f0fe806a","urn:doxa:passage:857ef3f884390c57f3c96802d43702b8dbb0edd3144137c14d1a9cc48628d4bd","urn:doxa:passage:388945b61bf6a3092d330cfc621e8d625b0014b70521611d010453c753658c62","urn:doxa:passage:62704e80800c2e55b683ce38bfca590bd7ecf8d2a5142a7e2bc432f984c0a412","urn:doxa:passage:941f9ce37279840fb273cbd2e447f941bec955500bb99834ca826eee3cf3fcd5","urn:doxa:passage:c174c24aa44349ae9b86e8a940b3ac806b95ba824114efca5b587dfaf6d20a05","urn:doxa:passage:2b89380f754906f0c0cdd5da3f37079668fc1315dbc3c7d30be480a1fd4ade7a","urn:doxa:passage:81df864f11639e1fddb30fe94e55bef11a14b8e7bf2fcd3dd7d5a726bc75cd0c","urn:doxa:passage:ff3b277e7b6b819c8b562f3429531fa7eb6f9f7fa54c49e1fc6b935387f25ab3","urn:doxa:passage:8fddf6e3869ed7b137b5505e4f285a3d8243e8d06fb19a6f423fcbe0bfed675b"]},{"@id":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-775348","title":"China in Uzbek media: Friend or foe?","author":"Mukhammadsodik Donaev","translator":[],"publishedOn":"2022-11-28","sourceUrl":"https://globalvoices.org/2022/11/28/china-in-uzbek-media-friend-or-foe/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"33496111c2ff3ebdc8366a380c256100a1c804a71dc935fa55b24a0522c914f2","textSha256":"0e0b7b63ebf4528d2dca0a08771078c5a65c8d737d60a0b92e4eccd54df5fa02","archivedRecordSha256":"2873102057dceb3e4cd60d502b2e9087735438dcf8fbd3082397217c08f6bd77","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:31cea45e671b55e4cd205d98160faf77:u_1fcc0ee8afa602b76b315c14","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_1fcc0ee8afa602b76b315c14","status":"accepted","fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77"},{"@id":"urn:doxa:unit:31cea45e671b55e4cd205d98160faf77:u_c06ecd80985b9160b8712995","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_c06ecd80985b9160b8712995","status":"accepted","fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77"},{"@id":"urn:doxa:unit:31cea45e671b55e4cd205d98160faf77:u_ff2e530a731dd2ae91195fe6","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_ff2e530a731dd2ae91195fe6","status":"accepted","fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77"},{"@id":"urn:doxa:passage:27e1ec87342d54440c5b4e76796120251562b522c047646897c888f56d255b22","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00011","start":143,"end":371,"exact":"Although media freedom has not been fully achieved yet, private websites and independent bloggers have started to write or speak more freely about specific political and social situations that are rarely covered by state media. "},{"@id":"urn:doxa:passage:717748a09692192dc1e9863d91ca0391e0d86a4b9c568986d680f9efbeca8720","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00011","start":371,"end":460,"exact":"Therefore, different opinions and discussions about China can be found on such platforms."},{"@id":"urn:doxa:passage:3193be207a4e4a9971fa4fc7b5cb96f717f2ea07bce876621be5b073a384c7f6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00012","start":0,"end":295,"exact":"The private news agency kun.uz, which is locally considered to be one of the most objective and independent media outlets, has the largest audience in terms of coverage: it is currently the most popular news website in Uzbekistan, with a total number of daily subscribers exceeding one million. "},{"@id":"urn:doxa:passage:76650e28401d58216b75f3129820353dfb2f1987b6e03d0fb34683fb0ceab668","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00012","start":295,"end":465,"exact":"An analysis by Global Voices of the news related to China published on kun.uz between October 1, 2021 and October 1, 2022, indicates there were 332 articles about China. "},{"@id":"urn:doxa:passage:13f44431d5c704eeae4693b9148104e9e6cee715791390557d661e10bb60e952","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00012","start":465,"end":562,"exact":"Most covered political situations, including the conflicts between China and the US over Taiwan. "},{"@id":"urn:doxa:passage:95a66e8c0469a4c126775ab0607b6db210d4695112113296fcc2d5a2b63cfd87","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00012","start":562,"end":673,"exact":"The second largest category, soft news, is followed by bilateral relations and a few mentions of the pandemic. "},{"@id":"urn:doxa:passage:0486978873b24d1d02e0cc11e5e3f4683ae7c9e55130aeeb6302a3d258ec80b8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00012","start":673,"end":732,"exact":"It also includes material about Uyghurs living in Xinjiang."},{"@id":"urn:doxa:passage:536ceec29759a98c66795f319dea5cfaa0c2c82bb4a8debfc1f279e55435e94d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00013","start":0,"end":276,"exact":"> Хитой ҳукумати уйғурларга қарши юқори технологик кузатувлар олиб бориш ва уларни фарзандлар ота-оналаридан ажратиладиган мажбурий меҳнат лагерларига жўнатишда айблаб келинмоқда. Расмий Пекин эса лагерлар кўнгилли таълим ва малака ошириш учун ташкил қилинганини айтиб келади."},{"@id":"urn:doxa:passage:38599ce0f0c6ee295c036e3c0c38e61e2699b057398ecc3154307b702e689b76","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00014","start":0,"end":183,"exact":"> The Chinese government has been accused of conducting high-tech surveillance against Uyghurs and sending them to forced labor camps where children are separated from their parents. "},{"@id":"urn:doxa:passage:619348a84573ad963c0689a547a1e586dc7f2dcdd7b2d87682ec06ccba97dd72","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00014","start":183,"end":273,"exact":"Official Beijing claims that the camps are organized for volunteer education and training."},{"@id":"urn:doxa:passage:1603c52000412e4ca859d9eddb482c3f9ed7d8c1d8effb4a6487822f54a6e199","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00015","start":0,"end":38,"exact":"China's evolving image on social media"},{"@id":"urn:doxa:passage:c6be9d321ab534255119030e05cf35eed74c08843af36d22219e0e47a8c57a37","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00016","start":0,"end":174,"exact":"People in Uzbekistan get uncensored information through the Uzbek-language sections of foreign media companies, such as BBC Uzbek, Radio Liberty Uzbek, and Voice of America. "},{"@id":"urn:doxa:passage:577227a7ab579b08c6a30356ad6d6393329296ce538a9c85ea1efb7ec0ae71f1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00016","start":174,"end":337,"exact":"Those media outlets are also known to be loud critics of the political situation in Uzbekistan, and they usually touch on topics that are taboo in the local media."},{"@id":"urn:doxa:passage:bf27744d3dfae51e3173b340eb705af49f9a819f0731bfc8a6a31186a7ec4d37","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00017","start":0,"end":75,"exact":"Another source are Uzbek influencers, both inside and outside the country. "},{"@id":"urn:doxa:passage:e9aa4abcb61c4ce5642cc4913e671be3857275e118d1f67e22f4c1e75db97c8c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00017","start":75,"end":223,"exact":"In Uzbekistan, influencers often unpack world news and political affairs for the general public in a simpler language, based on their own opinions. "},{"@id":"urn:doxa:passage:7956637da7172cdc39a49bfd10c186c8b5d299621a16dec89266867b763b5fad","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00017","start":223,"end":345,"exact":"People who do not read or watch news on TV or websites usually get information from such opinion leaders on social media. "},{"@id":"urn:doxa:passage:96070585f45fc697e614038a59ac5acafe3a5894895021cdfe10ce75df85ea68","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00017","start":345,"end":567,"exact":"Some of those influencers, for example popular blogger Khushnud Khudayberdiev who usually publishes news about legal affairs and social situation in Uzbekistan on his channel on Telegram, have as many as 400,000 followers."},{"@id":"urn:doxa:passage:a877edfe55286c2ca093244ef09c6352c1c576c0583f6bc3668eeb4e2d2e5160","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00018","start":0,"end":148,"exact":"Uzbek political influencers and those who run independent blogs abroad often mention that Uyghurs face strong pressure from the Chinese government. "},{"@id":"urn:doxa:passage:9389774a965635ebdfa7d49933b4703c78a5a22d5fa629d66391df2ef6b05b54","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00018","start":148,"end":271,"exact":"It is important to note that the Uyghurs are a nation that is linguistically and culturally extremely close to the Uzbeks. "},{"@id":"urn:doxa:passage:8178cf12cfbc09fafd43de3f8b16eb654eab2cb4359271bd65dee3bae6d43115","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00018","start":271,"end":347,"exact":"In some influencer narratives China can be seen as adverse and threatening. "},{"@id":"urn:doxa:passage:ad4464b43fee36e6442475a1596dcc722a6c85414148976c05ca880c0c08c89c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00018","start":347,"end":503,"exact":"For instance, popular Uzbek blogger Sanjar Xoja, based outside of Uzbekistan, explained in his vlog how certain countries fell into China's debt diplomacy. "},{"@id":"urn:doxa:passage:a7b70b2d921455bd1e364c89bbb90f8eac4d0467cf05c7854ed57851a5672a33","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00018","start":503,"end":646,"exact":"Another journalist, Doston Iskandarov, has thoroughly analyzed such “debt trap” cases in Tajikistan, Kyrgyzstan, Laos, Sri Lanka, and Djibouti."},{"@id":"urn:doxa:passage:e38f1abd4dba3d14ca2f9eff3c85a3e0e4dc4e87fc4b9dd221059aec069ee2b9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00019","start":0,"end":136,"exact":"Some, such as Kamoliddin Rabbimov, point out the unreliability of China’s economic and political muscle given its deficit in democracy. "},{"@id":"urn:doxa:passage:9cea6125db4f432ca33217229190dfe582739e042550f99ce4100eb545cd548f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00019","start":136,"end":204,"exact":"Some bloggers openly criticize Beijing's policies with such context:"},{"@id":"urn:doxa:passage:3384ea55fcacaec80e829c669c03380cd329809c0b6bc994bf8adc0eaf272f54","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00020","start":0,"end":460,"exact":"> Туркий халқлар орасида маданият жиҳатидан, тилнинг шаклланиши томонидан ўзбеклар билан уйғурлар жуда яқин. Афсуски, бизнинг энг яқин қариндошларимиз ҳисобланган Шарқий Туркистондаги уйғурларга бугун жуда агрессив сиёсат қўлланиляпти. Хитой ҳукумати томонидан “ахлоқ лагерлари” деб номланаётган лагерлардаги қӯлланилиши тахмин қилинаётган ўта даҳшатли ҳолатлар, турли қийноқлар ва жинсий тазйиқлар интернет оламини бир қанча вақтдан бери ларзага солиб келади."},{"@id":"urn:doxa:passage:25a52606e57146daf4040559b7a1b7189f4cc53a194faca1bf26ae0a9391442b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:31cea45e671b55e4cd205d98160faf77","blockId":"gv-775348-b00021","start":0,"end":96,"exact":"> Among the Turkic peoples, Uyghurs and Uzbeks are very close in terms of culture and language. "},{"@id":"urn:doxa:decision:879c399f93c6c7690afbfd54b7941e8c","@type":["doxa:Decision","prov:Entity"],"recordId":"879c399f93c6c7690afbfd54b7941e8c","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:31cea45e671b55e4cd205d98160faf77:u_1fcc0ee8afa602b76b315c14","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:27e1ec87342d54440c5b4e76796120251562b522c047646897c888f56d255b22","urn:doxa:passage:717748a09692192dc1e9863d91ca0391e0d86a4b9c568986d680f9efbeca8720","urn:doxa:passage:3193be207a4e4a9971fa4fc7b5cb96f717f2ea07bce876621be5b073a384c7f6","urn:doxa:passage:76650e28401d58216b75f3129820353dfb2f1987b6e03