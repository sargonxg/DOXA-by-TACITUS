6":"96b7c43ef0d6a3dbf10dd6bcba6fa6a3b045bbf1d67b25a5adfa881164e9b686","textSha256":"bee56768eba86eb0b998e0d6401da3a56ef88e066b34fdf5e0d25dd8a3fcf35a","archivedRecordSha256":"0c9f21eb2f3c0f8c7e3e0efb338cd707c51ffda360f3bceb68d59f58c19f449f","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:cb82a7b6cd0bcdb2c79e885d5c83009c:u_429caff8b89323493d7c2a87","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_429caff8b89323493d7c2a87","status":"accepted","fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c"},{"@id":"urn:doxa:unit:cb82a7b6cd0bcdb2c79e885d5c83009c:u_584d7fe77c543c28e47b78e6","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_584d7fe77c543c28e47b78e6","status":"accepted","fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c"},{"@id":"urn:doxa:passage:191e0cff67fb4c83ea3b7d09aa3c70bc8ecc313820af003fde4ea9dc5f222e22","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00001","start":0,"end":136,"exact":"The Ghaith family, living in Jerusalem's Muslim Quarter since 1945, has been fighting forced eviction from their home for four decades. "},{"@id":"urn:doxa:passage:ee773ac78d266fcc047550ad53d50dfcaf9499619374a49d7a164dcb2e262954","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00001","start":136,"end":252,"exact":"Israeli settler organizations persist in their efforts to displace them and seize their home for Jewish settlement. "},{"@id":"urn:doxa:passage:fe1b21b3993d0ea8872f8bf43c1462c5b3fccde93f2473e046d56a666d5c9930","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00001","start":252,"end":334,"exact":"The recent court ruling favored the settler group and left the family unprotected."},{"@id":"urn:doxa:passage:d1e6e5c545f9bda443667acb6328004bd9f936b753423e211bb6871b85446c29","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00002","start":0,"end":57,"exact":"Nora Ghaith’s family has lived in this house since 1948. "},{"@id":"urn:doxa:passage:82909445cd681551a968c5b3520063ce0c5aac417208b614d2f541d58cbd1147","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00002","start":57,"end":229,"exact":"The family obtained a rent contract from the Jordanian government in 1953, which assumed custodianship of Jerusalem in 1950 in the aftermath of 1948 Nakbah (“Catastrophe”)."},{"@id":"urn:doxa:passage:3ba37e6b994ee488d653483360015a1ae6bc0baba7536738fe5974a684453d3e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00003","start":0,"end":163,"exact":"The Nakbah led to the destruction of Palestinian society and the displacement of over 700,000 indigenous Palestinians to make room for the establishment of Israel."},{"@id":"urn:doxa:passage:645acdad4cbdf8fca767416c189fbecb4d83e29714b790325102e9e16d06e343","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00004","start":0,"end":155,"exact":"Palestinians were forced to leave their lives and properties behind, and for the last seven decades they have been fighting for their right to return home."},{"@id":"urn:doxa:passage:5e707852cad68ba3ffa55ca997a32cfbc27f805d5b85e6f295a2cfa9a376bb36","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00005","start":0,"end":135,"exact":"Since 1953, the Ghaith family has been classified as “protected tenants,” safeguarding them from eviction as long as this status holds."},{"@id":"urn:doxa:passage:d9d5ca633a5e35d192111fc7816a2dc7325ee48f662e6449b2e8b5cd2ab2794b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00006","start":0,"end":249,"exact":"Despite the 1967 “Naksa” (“setback”), when Israel assumed control of the West Bank and Gaza Strip, in what the UN deemed as an illegal annexation, the family has maintained their designation and faithfully paid rent to the Israeli General Custodian."},{"@id":"urn:doxa:passage:f19a7acad6ba8d2f647016e421390f174b0ac2377d2546f985ca4eb537d5d4ee","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00007","start":0,"end":193,"exact":"In a WhatsApp conversation between Global Voices and human rights activist Raafat Sub Laban — Nora Ghaith's son, and a UNHCR employee — he shed light on his family’s connection with the house. "},{"@id":"urn:doxa:passage:9ea542f58a8de913b9e8dedf87dfda9fb4e9e3d0a9cfe4e7372c503507da26cf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00007","start":193,"end":367,"exact":"His father Mustafa Sub Laban, 73 years old, joined his wife Nora, who is now 68 years old, at the time of their marriage in 1978, and they have been living there ever since. "},{"@id":"urn:doxa:passage:d0c9728ae1393e922a3b0caa0d20a0664402f0a33fe2e4a64da164f2feb1d990","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00007","start":367,"end":388,"exact":"Sub Laban elaborates:"},{"@id":"urn:doxa:passage:3d36c92fcd249a61595e427c97381b88bed76d47974344ab417b095c97aa5ed7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00008","start":0,"end":38,"exact":"> My mother lived there all her life. "},{"@id":"urn:doxa:passage:d5f81fc3346db1a371acad0c39fdfac8734296bb10916337189628f85aedae4f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00008","start":38,"end":161,"exact":"In the 1970s, the Shuvu Banim settler movement tried to blackmail my uncle [Nora’s brother] to acquire the tenancy rights. "},{"@id":"urn:doxa:passage:0a12f6f19e3a3dacddb568ad30c4bce5b4409dd927271b1d472172fe09c2334a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00008","start":161,"end":217,"exact":"He was the head of the family after his parents’ death. "},{"@id":"urn:doxa:passage:b963b7e8dd3ea7bbd39da23db7943108c9721ee7a2fd0c51c67086b4f43a33d0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00008","start":217,"end":296,"exact":"However, upon his refusal, the settler orchestrated his deportation to Jordan. "},{"@id":"urn:doxa:passage:f4bf6de2411445ee809cacc30b6f97901cf9614e3ff45d07fe20a9f5cb392ce9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00008","start":296,"end":368,"exact":"My mother and father assumed responsibility for the house at that point."},{"@id":"urn:doxa:passage:a6175c78e3f2543164d20016e21177ba6d893db7709dbadff0b1eb6b4f74480a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00009","start":0,"end":100,"exact":"The Sub Laban family has deep roots in Jerusalem, predating the establishment of Israel by decades. "},{"@id":"urn:doxa:passage:0467565a1698920f285c752b1224343a539c245244a97b6a094dfa8a64bb5383","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00009","start":100,"end":176,"exact":"Their lineage traces back to a Sufi scholar who moved to Jerusalem in 1692. "},{"@id":"urn:doxa:passage:ffe5fbc5cd8e24cdbf1630a6b0a05170d7c49c975eab42275e37de777d47d573","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00009","start":176,"end":346,"exact":"The family had several properties, including the notable building that houses the Rockefeller Archaeological Museum in Jerusalem, confiscated by Israel in 1948 and 1967. "},{"@id":"urn:doxa:passage:34a5b675b5fbb2fd1289f183e0203d362b1e4662dcd778c1cc0b50b060be8fc5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00009","start":346,"end":435,"exact":"This historical context explains the family’s home attachment, as described by Sub Laban."},{"@id":"urn:doxa:passage:097d2e2680afec164fbd77640708c55bd62b423377f1cd4bc6f8cd451785f58b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00010","start":0,"end":143,"exact":"> We have always been conscious that this property is the last remaining one for my parents, and it has been important for us to safeguard it. "},{"@id":"urn:doxa:passage:a4f84ed5faf4f1d9d3de75eb37eb5df1dea7a251440d7ef7a3152f1b164dbb4f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00010","start":143,"end":199,"exact":"We always made sure to maintain a presence in the house."},{"@id":"urn:doxa:passage:60f5594fd81787d9ab4bd3bd38c8d2531e85fea672940b069dcaac3fe809cff3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00011","start":0,"end":111,"exact":"> Our properties were confiscated by Israel, and as Palestinians we are denied the right to reclaim ownership. "},{"@id":"urn:doxa:passage:c3db26516f6e6dd160ef3dda228248426f7ffcd35cf9866469d7b7909a8df633","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00011","start":111,"end":209,"exact":"Meanwhile, Jewish individuals are granted the right to reclaim property, regardless of ownership. "},{"@id":"urn:doxa:passage:da081fca17f4cdbdac231628b9f4b821b3a8c88d653471b51da9acda1f917bc7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00011","start":209,"end":231,"exact":"This is simply unfair."},{"@id":"urn:doxa:passage:79a281084a626af1acf3dd7671c49537ab35151d687213e655c6ca15635f8d28","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00012","start":0,"end":142,"exact":"In the 1970s, Israel enacted an administrative law that perpetuates a system of apartheid and discrimination, by favoring Jews over non-Jews. "},{"@id":"urn:doxa:passage:11902abdabb8f426d596f7b2aa673250df39e20125a5aee10fbe6d15ab367a0e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00012","start":142,"end":243,"exact":"It allows settlers to reclaim pre-1948 Jewish-owned properties in East Jerusalem, even if unrelated. "},{"@id":"urn:doxa:passage:6e37444f5e004795f76127e14d172066633688b74ff98ac61363686c659932be","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00012","start":243,"end":335,"exact":"However, Palestinians are denied the right to claim their own properties in West Jerusalem. "},{"@id":"urn:doxa:passage:b58947bccf3aa6180552392dc66bd81b26dec9ba234505b7dbf66dc5d76ace60","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00012","start":335,"end":452,"exact":"This law has been exploited by settler organizations to undermine Palestinian ownership rights across East Jerusalem."},{"@id":"urn:doxa:passage:367033825ba2cabcad05f777ebb829e9722f3b83d807170afd6d30b09bb70c93","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00013","start":0,"end":23,"exact":"A lifelong legal battle"},{"@id":"urn:doxa:passage:2fa47ca4ddc860ea194c0abfd64f986fb6d031479640a3826da1c6c2526eaddf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00014","start":0,"end":96,"exact":"The Ghaith Sub Laban family has been entangled in a 40-year legal battle against settler groups."},{"@id":"urn:doxa:passage:9879c6b5c58b0036c341453f0e1e060990d7975d1f92259f6dd83f83f836df75","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00015","start":0,"end":376,"exact":"According to Israeli NGO Ir Amim, dedicated to promoting a more equitable Jerusalem, the family's case involves the Atara Leyoshna group affiliated with the Ateret Cohanim, a notorious settler organization known for its efforts to Judaize Jerusalem and displace indigenous residents, including a high-profile attempt to seize iconic Christian hotel properties near Jaffa Gate."},{"@id":"urn:doxa:passage:40600ba13be711553c515293eaf78290bc7974691529525f1ed6fd018e5913b8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:cb82a7b6cd0bcdb2c79e885d5c83009c","blockId":"gv-791069-b00016","start":0,"end":83,"exact":"Sub Laban highlights that other Palestinian families have faced a gradual eviction:"},{"@id":"urn:doxa:decision:fab9a528efe363b1cb2002a08a76ad4d","@type":["doxa:Decision","prov:Entity"],"recordId":"fab9a528efe363b1cb2002a08a76ad4d","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:cb82a7b6cd0bcdb2c79e885d5c83009c:u_429caff8b89323493d7c2a87","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","p