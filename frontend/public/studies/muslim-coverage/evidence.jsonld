b0dcf0edbf450728700c6ce1326306de0b03bcf413317c18","urn:doxa:passage:e62d12410a45021de7bd3070d2d245a4a5a0b027295ea637adcce2b17b1a67b5","urn:doxa:passage:602b9aa2b42f970dc172a30da978bac57f5b60e882417e4a3197ff69e51449cb"]},{"@id":"urn:doxa:decision:3409732f1dc2bf0603f5a8ef1672870f","@type":["doxa:Decision","prov:Entity"],"recordId":"3409732f1dc2bf0603f5a8ef1672870f","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:c3643b65db7d1469e60ce128e528b7fd:u_82125d07ba5a577b0350222e","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:2ab3589d9b66f3b486f74fec3cc5eb82619da33b44944d47c00859f088e37776","urn:doxa:passage:b1bb6a577db51080b68d82eb9df488a1cdb5f560f4beadbcb2a4acb2a4eb5087","urn:doxa:passage:2ae61947f3f6b6512ccd26c85dd5ebd8bf5527b2a69641e7e5d6c7d2086020c2","urn:doxa:passage:53c349c3d4d09fb16c4178290cd3e920f22a88db6ec34bc9e4fe00e45bfa369c","urn:doxa:passage:fc72bcf2f6067e95794433516ab6051b8a2ad229dee2344088d3fd98f2280092","urn:doxa:passage:fafd70261d2db32098ffb23dde792912204a22ca70722386be2bc723e17b97cc","urn:doxa:passage:520394281a5ad6fbbd7c437a2096b8cefbce723cf47d1dcb7de0a92d1454418b","urn:doxa:passage:1ac28862ac9d42e1ca2b5177a7469e3d09b1cfa5a708d1e2cbd290b87bc146b9","urn:doxa:passage:7442c680e67867d56a3a68ac4d1eb2759ef3022b72ecbcc13f233b0b831911a1","urn:doxa:passage:8f2c6d3d6161e43d9ed60d258ab2661d41b484de12b958bffdddc046c84e5317","urn:doxa:passage:d47e91698e412e6de5a0907c3579780b17be721c25a08d50209a6ada7c662a8f","urn:doxa:passage:1e987556f340a04fb59ccaadd2729ae23c9f6a82f17a6ac6b5e3841004bccef8","urn:doxa:passage:cf915d4535fbdcee195cbb5cc6e3b27a91cf5643c8ccc5d85bdf40a7a33214c8","urn:doxa:passage:3f4f209111dbceb9d041991fcece6d19f2d078ab62433dbef10fa77c9872e3e6","urn:doxa:passage:b08af7f9fbd706bb9a0c975ab257807b42331c33892e1493f19ae6ea66178168","urn:doxa:passage:8eefd26ba32845d4c0990ab45930d6a22c70310b2aded5b8daac23498fc5bbb5","urn:doxa:passage:1203b53529e73e0401f150f12bc267a1aa2dbbe215dde2b1105e5828233afbd8","urn:doxa:passage:3f384162d10b194554ac3b480f63545f2cdf439f9c6c4c14a6889436bb425590","urn:doxa:passage:fb374e64a1b00fda3ec597c566049c068bb0f44ae43ef82bf88d9fe9d0469236","urn:doxa:passage:e4b648a19e5d63b7aa68857b8a69f01446e741d42a36ebd5c0b384fe0b88d1b0","urn:doxa:passage:dac209b6fdd07454879719b9e6ba190e95150effb6859f9cb787d3a3a3ffff96","urn:doxa:passage:dae34f403d4383c1923cf2d2fab15ba2babbd4ca95b7ec7debd1f632f445961d","urn:doxa:passage:104844836b48e78eb0dcf0edbf450728700c6ce1326306de0b03bcf413317c18","urn:doxa:passage:e62d12410a45021de7bd3070d2d245a4a5a0b027295ea637adcce2b17b1a67b5","urn:doxa:passage:602b9aa2b42f970dc172a30da978bac57f5b60e882417e4a3197ff69e51449cb"]},{"@id":"urn:doxa:passage:a34d0be32967c2f9b948743e84450c0750bb41f1d6ba8886503a1798d5ea8ed4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00017","start":0,"end":220,"exact":"Responding to a known case of bubonic plague on a ship in East African waters, the British Foreign Office in London established a quarantine station in 1899 on Prison Island, just off the coast of present-day Stone Town."},{"@id":"urn:doxa:passage:bc82999e8db5037ffbf541e4d2bfa4200e9ed187ec1992eeb8b44af746462528","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00018","start":0,"end":137,"exact":"The island was previously used as a prison for people caught smuggling slaves after the abolition of the slave trade in Zanzibar in 1873."},{"@id":"urn:doxa:passage:e116961cf732d796460cb61aed76aefd6e8d7aa5bce0421485b0b99112e76b26","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00019","start":0,"end":175,"exact":"From 1899 until at least the mid-1950s, Prison Island became a quarantine station for all of East Africa, first for bubonic plague and eventually for cholera and yellow fever."},{"@id":"urn:doxa:passage:3221984ce2b970baf0fc1e3c87096afa90a2c09569e1af4d4be18801421ed14c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00020","start":0,"end":135,"exact":"Despite the establishment of a colonial quarantine station just off its shores, Zanzibar experienced a bubonic plague outbreak in 1905."},{"@id":"urn:doxa:passage:ef093fc547e068395d381742a758cbd9cef9d15d4247628c89ecf0833b304d16","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00021","start":0,"end":118,"exact":"According to Issa, colonial officials stopped commercial activities and prevented merchandise from entering the port. "},{"@id":"urn:doxa:passage:8947c267a8ec1870f8528f11182045db937d891ebbc0aa0163c6abe43f916b74","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00021","start":118,"end":253,"exact":"They also required all passengers and crews on incoming vessels to undergo a mandatory quarantining period of 10 days on Prison Island."},{"@id":"urn:doxa:passage:39567150a93fd24623ab8dc975d44f148b8afe8286ecea63b690000aa52ebefc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00022","start":0,"end":150,"exact":"Meanwhile, in Stone Town, the British colonial administration enacted harsh public health measures against Zanzibaris of Indian descent, Issa writes. "},{"@id":"urn:doxa:passage:faf7f44e8abd30ebfe50cf0921b5cbbabc2b18de4162b2fb8ba52a107cf7dff3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00022","start":150,"end":313,"exact":"Colonial officials blamed Indians for the spread of bubonic plague, which first emerged in India, in 1896, before reaching other Indian Ocean ports in early 1897. "},{"@id":"urn:doxa:passage:8bcec0df13cd453b57f00cc28495524b59c0f86fadf4128caf3b6522e69f9430","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00022","start":313,"end":407,"exact":"Medical officials attributed the 1905 bubonic plague outbreak to a cargo of rice from Bombay. "},{"@id":"urn:doxa:passage:1431b701f2b61472c5f4c193b8a6ca4ed648aeba53023eb5fe555b34a85b6425","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00022","start":407,"end":597,"exact":"That year, “a decree gave powers to the medical authorities to detain suspected plague victims, to segregate, to hospitalize them and to destroy the property of plague victims,” Issa writes."},{"@id":"urn:doxa:passage:371ffb05619b0d46e2ea2108287ddbbc0527136f08796d44d289e81836673f01","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00023","start":0,"end":204,"exact":"Zanzibaris of Indian descent resisted colonial efforts to detain and segregate their afflicted family members and perform post-mortem medical examinations, which many Muslim families viewed as un-Islamic."},{"@id":"urn:doxa:passage:31155a426b4c598788ac512b9479fc96d9137967aa1bcdf4d8570d4e71f5b4b5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00024","start":0,"end":234,"exact":"As Issa argues about the colonial response to leprosy, colonial quarantining and other public health measures reflected a desire among British colonial administrators to ensure European health and wellbeing through racial segregation."},{"@id":"urn:doxa:passage:b4c41841ec98ff67640e9bb7542fba6c5dc7f461309df2d13dd4f0fe8614a4f2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00025","start":0,"end":195,"exact":"The establishment of a quarantine station at Prison Island and the colonial response to bubonic plague were part and parcel of an era of attempted racial segregation in the name of public health."},{"@id":"urn:doxa:passage:9e5e22848ac7c018a35d246572a6b4666e61f205345f8c976ebe65b940806ad9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00026","start":0,"end":114,"exact":"Ironically, European residents frequented the island during the colonial era as an escape from bustling city life."},{"@id":"urn:doxa:passage:89dc164068b90abeab3eaa9c82ee7c8b64dc6b96ef24668c9f2945c00fda7f43","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00027","start":0,"end":55,"exact":"Today, Prison Island is a popular tourist destination. "},{"@id":"urn:doxa:passage:92b66af0036f15cdffec3f9c17c2f0e5328e85cc00e75c5fb0c646749b357dc3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00027","start":55,"end":237,"exact":"Visitors travel via a short boat ride to the island, where they can visit the “Prison Trattoria” or feed its resident tortoises, purportedly gifted from Seychelles in the late 1910s."},{"@id":"urn:doxa:passage:f842bb705f0afd56c79bf26897d20daf8440404d73ca5bc91228de3eb8b0d56e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00028","start":0,"end":25,"exact":"Quarantine in the future?"},{"@id":"urn:doxa:passage:a0c2b595f3efbd58fbbae127dfef6a38bdae508fdb746568d2e0360a30be13ab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00029","start":0,"end":157,"exact":"In light of Zanzibar’s complex history of racial segregation in the name of public health, social distancing and quarantine measures have been controversial."},{"@id":"urn:doxa:passage:f0bcb1acb4f1aca143b1b81ccb5247a8da9f619c3804c9a7738cf08e9ba81804","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00030","start":0,"end":287,"exact":"Government officials like Health Minister Hamad Rashid Mohamed, and Second Vice President Seif Iddi Ali, have scolded Zanzibaris for continuing to gather at the market, weddings, and burials and for visiting their hospitalized loved ones, despite government directives to remain at home."},{"@id":"urn:doxa:passage:95d033d149292e8f5880efba9a4d114d41628f050004fedae2ae4761087f890a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00031","start":0,"end":249,"exact":"In response to Jussa’s tweet about Zanzibar’s successful containment of the Spanish Flu in 1918, a Twitter user who goes by Lilie called into question the government’s ability to quarantine poor Zanzibaris whose livelihoods depend on their mobility."},{"@id":"urn:doxa:passage:ef9d02500ead9a53127de5a194584d362e4191b0c807cdd59c3b6ce4e60ac1bd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00032","start":0,"end":145,"exact":"> But let me ask you a question, if the government put in place a quarantine, would it really work for people who are truly struggling to get by?"},{"@id":"urn:doxa:passage:aafd9e7b13331b626f6ad4712ac6daf15d87df84f400aabd94b748b1d68fd33f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00033","start":0,"end":170,"exact":"As Zanzibar and mainland Tanzania slowly begin to reopen on June 1, authorities are working to determine social distancing and quarantine measures for the months to come."},{"@id":"urn:doxa:passage:4c33b7a4634eab86d9751cab9e4c25e92c364e224b57e38267c5969678a436ed","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00034","start":0,"end":142,"exact":"Prison Island serves as an enduring reminder of quarantine’s complex past where racial segregation shaped public health policies on the isles."},{"@id":"urn:doxa:decision:746db063dfa9d28b9ed608c1667b2424","@type":["doxa:Decision","prov:Entity"],"recordId":"746db063dfa9d28b9ed608c1667b2424","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:c3643b65db7d1469e60ce128e528b7fd:u_fa17c66438dd28d16d53ef74","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:a34d0be32967c2f9b948743e84450c0750bb41f1d6ba8886503a1798d5ea8ed4","urn:doxa:passage:bc82999e8db5037ffbf541e4d2bfa4200e9ed187ec1992eeb8b44af746462528","urn:doxa:passage:e116961cf732d796460cb61aed76aefd6e8d7aa5bce0421485b0b99112e76b26","urn:doxa:passage:3221984ce2b970baf0fc1e3c87096afa90a2c09569e1af4d4be18801421ed14c","urn:doxa:passage:ef093fc547e068395d381742a758cbd9cef9d15d4247628c89ecf0833b304d16","urn:doxa:passage:8947c267a8ec1870f8528f11182045db937d891ebbc0aa0163c6abe43f916b74","urn:doxa:passage:39567150a93fd24623ab8dc975d44f148b8afe8286ecea63b690000aa52ebefc","urn:doxa:passage:faf7f44e8abd30ebfe50cf0921b5cbbabc2b18de4162b2fb8ba52a107cf7dff3","urn:doxa:passage:8bcec0df13cd453b57f00cc28495524b59c0f86fadf4128caf3b6522e69f9430","urn:doxa:passage:1431b701f2b