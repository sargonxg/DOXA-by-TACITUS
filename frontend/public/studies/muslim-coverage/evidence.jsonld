60f5e4abce0db9bd65e97fe57bf1b30c81f55fc29c3ff27","urn:doxa:passage:5652f6428c6d73912bf9c60e99a3b533b41e983f3d58e40c4400f2a5aa744016","urn:doxa:passage:5ec0199b3c50183422229340c68744df17a28f633bd94a6d9c3bfee0757b10af","urn:doxa:passage:657e4dbe9884c97d837b9c393c85e8af4dc05322be3314381c7fcf32a2f8bcd1","urn:doxa:passage:c24158f2d1635cc93132c346194bb29af154803c19d2f1dfe090ac5b854582d6","urn:doxa:passage:e9fa233518c25f0ea26e2d92f509af46b34959858416d263227b6de9e8bcb7cd","urn:doxa:passage:24032ecd35422422f33afaf88b6c6232b58e0ad9807dee0350149427e9576826","urn:doxa:passage:e0bea3342b835eda95b7c3e69fae81d2b4001bcd15aa4c21d8819224419a0091","urn:doxa:passage:a73e88ebd30d86649f45fa0b61ef8aa61da07e5b3774e53287c3181f58ff94fc","urn:doxa:passage:cf810755da971de8fa14a7eadccdff0cc8d9cc8af9840dbeb88ca31a6b1cd62e","urn:doxa:passage:3f7190039af276da91a2c511c9b399bca20b57ceb4d579377ff22e041ee3db3f","urn:doxa:passage:c26a6f34ea84d94a0a6f5fd49ae69d59b9a9b0ecc427ec7a15825a757e579403","urn:doxa:passage:65a5624458f254510a76ee4abb040a838d875f5a1b4fcca1cc3b268ee3f7a722","urn:doxa:passage:58b8b928a6ad7b9c4a660337efda57f37f7f40155e9c40b36e7241aec162b576","urn:doxa:passage:267dc0eb08f677f8990a699c1ec513da8aebc2eb045b85ce32ba6de7c360dfec","urn:doxa:passage:59c8ed791a4c61f1f5110a68ed63e6b0c1afa33ac540c4722413f1a6b5055957","urn:doxa:passage:08e39a6b1a60e6674771d908d58584bbf56d7e5b102c19f250539b599b2bb72c","urn:doxa:passage:4e7f8e9f9222bb4f9b4be7176c2af7f821130e550c8b6b77a284a654f4fb5605"]},{"@id":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-764723","title":"Azerbaijan rocked by a new wave of politically motivated arrests","author":"Arzu Geybullayeva","translator":[],"publishedOn":"2022-06-08","sourceUrl":"https://globalvoices.org/2022/06/08/azerbaijan-rocked-by-a-new-wave-of-politically-motivated-arrests/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"fec65994ec824148e2bfd1e1fdbc3839ff4e505c3195b10be45ee2f5c8750426","textSha256":"a87db2e67858b2101c4b81ae442ea534fd5299ed527adfe3492bfb0e791e76a6","archivedRecordSha256":"9e0c61d0a63b66cdefbd149e5365660540f20dc1ca95fb39dfe8cce6d6850a79","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:0ce818854401f8b38f2c0054f5f7cb0f:u_a49da84934d4e6dda6f0bbc0","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_a49da84934d4e6dda6f0bbc0","status":"accepted","fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f"},{"@id":"urn:doxa:unit:0ce818854401f8b38f2c0054f5f7cb0f:u_b02e5505e5bf2dc3d9bd9ccd","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_b02e5505e5bf2dc3d9bd9ccd","status":"accepted","fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f"},{"@id":"urn:doxa:passage:23b6c8a60321922bba13acef15b8ab64815c49772bdc0ef0132af6eb9b76574c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00011","start":0,"end":274,"exact":"> We, civic political activists, politicians, rights defenders, journalists and citizens, are deeply concerned about the attacks, and persecution leveled against political activists and journalists and their family members, in recent months over their political activities. "},{"@id":"urn:doxa:passage:656e9e8f44666337638c867f6bd4a0f044473e984df20a598e40b0c576998517","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00011","start":274,"end":629,"exact":"The beating of member of Musavat part Tofig Yagublu in police detention, humiliation of kidnapped civic political activist Bakhtiyar Hajiyev, physical assault against the mother of Rabiyya Mammadova, and threatening of journalist Aytan Mammadova at knifepoint, show that the events were carried out by certain criminal groups for purely political reasons."},{"@id":"urn:doxa:passage:debd5945b0824d6e492c516e488d10a1a4f02767706bee50101afdc46db78fe8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00012","start":0,"end":65,"exact":"The recent wave of crackdowns also targeted religious activists. "},{"@id":"urn:doxa:passage:fdfbb5dfb809f22e2baca5cc1162ca2aea74979d64ea0b4ee179c1b7c23a34f8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00012","start":65,"end":198,"exact":"On June 7, religious activist Fagan Mamedov was sentenced to six years in prison on drug charges, an allegation the activist denied. "},{"@id":"urn:doxa:passage:15e2cbec9b0fdc64821b6ccf904416d7672d71ad27cdb84e6847be095bccaba1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00012","start":198,"end":321,"exact":"Another religious activist, Razi Abbasov was also sentenced to six years behind bars on May 20 on drug possession charges. "},{"@id":"urn:doxa:passage:7910c6937a078b87dc7e67846c5313beeaf3039d80f897eca20bd1a73d1a2773","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00012","start":321,"end":475,"exact":"On the day of the trial, a group of religious activists gathered outside the courtroom but were dispersed by the police, and five activists were detained."},{"@id":"urn:doxa:passage:cd4a03726ef28c0ca2598d9c063d5648b407823fd8a2a429d1dedde5f7d97e12","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00013","start":0,"end":140,"exact":"Three of them were sentenced to 30 days in administrative detention, and two were released after several hours, reported Turan News Agency. "},{"@id":"urn:doxa:passage:f2d74c93b2bf5f2a89d1d6270bb5b39233eb4c9d73168cabd56cebdb47dd4b3d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00013","start":140,"end":329,"exact":"According to the accounts of the two men who were released from police custody, police tortured, and humiliated both activists, using profane language against the activists as well as God. "},{"@id":"urn:doxa:passage:3eead632088b578794230322d53a4957889db0194bfcbfd0bfd06f40c2ff4d99","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00013","start":329,"end":431,"exact":"In response some imprisoned religious activist have announced their decision to go on a hunger strike."},{"@id":"urn:doxa:passage:78432ba20fc2e6b8dd8b1a0a242e81d81c2d30f151a7785d6de71d0936c6132d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00014","start":0,"end":47,"exact":"The arrests of religious activists is not new. "},{"@id":"urn:doxa:passage:26527dcfcb975eea78b493e87a016fab5907890364344e2060d7b70108498d6d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00014","start":47,"end":119,"exact":"The country's leadership has long viewed religious groups with caution. "},{"@id":"urn:doxa:passage:2b17ae0be2877d02f8055cb3f01e5ef3fad6c2d56554e401521b956e4b7ac510","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00014","start":119,"end":299,"exact":"The tensions culminated in 2015 when, following a special security operation in Nardaran, a conservative Shia village on the outskirts of the capital, police arrested fifteen men. "},{"@id":"urn:doxa:passage:b48155e46b10ba3de9ae0d4573a1a47363cd374515e3b0e76af9a2ce84035913","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00014","start":299,"end":590,"exact":"Authorities claimed, “they averted religious rebellion by fanatic Shia believers, whose goal was to install a sharia state in modern and secular Azerbaijan.” In the coming weeks, as angered residents took their resentments to the public square, the stand-off with the authorities continued. "},{"@id":"urn:doxa:passage:712b86b225ccc2a5b94cc66a686c7b7942dca8f9c76cd519ad807a8a14d9ecdb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00014","start":590,"end":687,"exact":"As a result, police arrested at least 70 people, with some estimating the total reached over 80. "},{"@id":"urn:doxa:passage:401b9cc848a0e6a45d13e791cbc05cd28f295857d8a5110ae8dffb233e77afa4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00014","start":687,"end":802,"exact":"Eventually, many were released except Taleh Bagirzade, the chair of the Muslim Unity Movement and fourteen others. "},{"@id":"urn:doxa:passage:b44c4404a76599d2643e674e13a7175ed32e2165cc7086d3610a01d2cb071a22","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00014","start":802,"end":872,"exact":"Two years later, Bagirzade was sentenced to twenty years behind bars. "},{"@id":"urn:doxa:passage:b7385fe53e69565116f9ba9dd805205ce6bf8a91dadec34f11d0db4f7d047e74","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00014","start":872,"end":928,"exact":"His deputy, Abbas Huseynov, received the same sentence. "},{"@id":"urn:doxa:passage:ac9560d254c5ca7af9bf99dd7aacb511a9752d15bad69c1ca1ed2875470a0c37","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00014","start":928,"end":1096,"exact":"Both were convicted of “publicly calling for the overthrow of the government and of inciting ethnic, religious, and social hatred,” reported Radio Liberty at the time. "},{"@id":"urn:doxa:passage:3241e06c4f363f251c3575c5cb39e4d13288fe7d3cc79f3321a77d5c8400d3bc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00014","start":1096,"end":1203,"exact":"The convictions continued in the following months, with some receiving jail time ranging from 12–15 years. "},{"@id":"urn:doxa:passage:7540f3e93f082f18e1913c4632cb98187c3ffddfe9ec732d778a96cabb4e4200","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00014","start":1203,"end":1266,"exact":"But the persecution of religious activists did not stop there. "},{"@id":"urn:doxa:passage:6f8e0d6330b1a39711c4d0c42950680db03cca3334651fed95dbba230ea72fd8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00014","start":1266,"end":1377,"exact":"Over the course of the following years, authorities continued to round up members of the Muslim Unity Movement."},{"@id":"urn:doxa:passage:449282b3ccdb4fbad13f084ee301a1337545156b83a83847c81bbfd230c462fd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00015","start":0,"end":143,"exact":"On May 29, exiled activist Tural Sadigli said his life was in danger after receiving reports of four men visiting his home address in Germany. "},{"@id":"urn:doxa:passage:f3eebc13d007f291c9afb3ff15526594e0d7429862a4339fcd5dbe2116f3f53c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00015","start":143,"end":324,"exact":"In an interview with Meydan TV, the political activist said he is being targeted because of his work exposing the government corruption, and specifically that of the ruling family. "},{"@id":"urn:doxa:passage:77d399a439315ad609f44f6abcfc7d64220632a4be58c7778c35dc78e797100e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00015","start":324,"end":432,"exact":"Sadigli runs a YouTube channel, Azad Soz [Free Word], where he often criticizes the Azerbaijani authorities."},{"@id":"urn:doxa:passage:aca5a3b4c48da9305ff080289d130bc57dd39a7d88fe6142e33808081a2a534a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00016","start":0,"end":79,"exact":"But activists continue to express defiance despite the recent wave of attacks. "},{"@id":"urn:doxa:passage:1b9b074da37f5f27db40bd3a06f8587eb923d027b832212832feaa7d4367306c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00016","start":79,"end":195,"exact":"Speaking to Global Voices, Rabiyya Mammadova said she will continue to fight and do what she can for her community. "},{"@id":"urn:doxa:passage:d7481d2673f4361e0363c3b6719192c0883ee36bdc5c5dddcf1d6c81ac1bd020","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00016","start":195,"end":267,"exact":"“I understand I am on the right path, I am not afraid,” said Mammadova. "},{"@id":"urn:doxa:passage:239cf0d368e587298b12a7e98120cdc90c0e8b4dea5dab5df22c0eb66a3a7140","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00016","start":267,"end":452,"exact":"On May 14, a group of civil society activists held a rally in Azerbaijan's capital, Baku, demanding an end to impunity against government critics, political activists, and journalists. "},{"@id":"urn:doxa:passage:6985dd2b5df89e660035a10e4e30abccc423b96feae0e23e7450279c61fcead2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00016","start":452,"end":594,"exact":"The organizers of the event said the decision to hold the rally was triggered by the violent targeting of political activists and journalists."},{"@id":"urn:doxa:decision:6eafd9a4b6151230bbf389b08791f3b3","@type":["doxa:Decision","prov:Entity"],"recordId":"6eafd9a4b6151230bbf389b08791f3b3","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:0ce818854401f8b38f2c0054f5f7cb0f:u_a49da84934d4e6dda6f0bbc0","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:23b6c8a60321922bba13acef15b8ab64815c49772bdc0ef0132af6eb9b76574c","urn:doxa:passage:656e9e8f44666337638c867f6bd4a0f044473e984df20a598e40b0c576998517","urn:doxa:passage:debd5945b0824d6e492c516e488d10a1a4f02767706bee50101afdc46db78fe8","urn:doxa:passage:fdfbb5dfb809f22e2baca5cc1162ca2aea74979d64ea0b4ee179c1b7c23a34f8","urn:doxa:passage:15e2cbec9b0fdc64821b6ccf904416d7672d71ad27cdb84e6847be095bccaba1","urn:doxa:passage:7910c6937a078b87dc7e67846c5313beeaf3039d80f897eca20bd1a73d1a2773","urn:doxa:passage:cd4a03726ef28c0ca2598d9c063d5648b407823fd8a2a429d1dedde5f7d97e12","urn:doxa:passage:f2d74c93b2bf5f2a89d1d6270bb5b39233eb4c9d73168cabd56cebdb47dd4b3d","urn:doxa:passage:3eead632088b578794230322d53a4957889db0194bfcbfd0bfd06f40c2ff4d99","urn:doxa:passage:78432ba20fc2e6b8dd8b1a0a242e81d81c2d30f151a7785d6de71d0936c6132d","urn:doxa:passage:26527dcfcb975eea78b493e87a016fab5907890364344e2060d7b70108498d6d","urn:doxa:passage:2b17ae0be2877d02f8055cb3f01e5ef3fad6c2d56554e401521b956e4b7ac510","urn:doxa:passage:b48155e46b10ba3de9ae0d4573a1a47363cd374515e3b0e76af9a2ce84035913","urn:doxa:passage:712b86b225ccc2a5b94cc66a686c7b7942dca8f9c76cd519ad807a8a14d9ecdb","urn:doxa:passage:401b9cc848a0e6a45d13e791