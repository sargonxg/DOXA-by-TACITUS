662bdfcd0c28e70b4027b3151f2faaa411e39794b82","urn:doxa:passage:81d8e63280aa6ce9a07d747ef6011a6c03922959ac6cec95a52ca05af26f8668","urn:doxa:passage:7aa78274180eaee1a03ea49e2cbb0d8df60bf582dc0c58dd093264b803ed6dda","urn:doxa:passage:9e12d0638c138f1a61f97d95c9e07ef4557d63c95cb98797631043a2ca8476bf","urn:doxa:passage:578c93e0a289e0cb390618dcdd00100a0c5b9f0a9ce0c8fa4079fe38df5b5d3b","urn:doxa:passage:79cf3a8f158a549917b814aa09faaec19f442ef510164fc427981636a87b369a","urn:doxa:passage:0637ca15ae46a91520e7292e33b2752fdd1ac9ab1b13a5c93f16a8cd7bf5b2f4","urn:doxa:passage:4b6ee67bbb24ff78ae5f1a58ee69b5be40011b786eac509bbf6860753959ddd6","urn:doxa:passage:c9a85152f69319d80e53e6562f7e5fdd0b7e84361b5591be8e78e463e943812d"]},{"@id":"urn:doxa:passage:75cb7f786961b4fe13fd36e05bb25c6d94bb0dd246e3d20aaf1a66bc8848b7de","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6b0ccb975d051edea38137c0d5ac0c50","blockId":"gv-725386-b00019","start":73,"end":428,"exact":"As CNN pointed out at the end of November, “Macron is following a well worn path of French presidents.” Their skepticism about EU expansion through admitting countries from Eastern Europe, particularly those with large Muslim populations, dovetail with Macron´s desire to appease Russia and be re-elected with the support of domestic right-leaning voters."},{"@id":"urn:doxa:decision:6dea07b7970113c9f531e695177e90bb","@type":["doxa:Decision","prov:Entity"],"recordId":"6dea07b7970113c9f531e695177e90bb","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:6b0ccb975d051edea38137c0d5ac0c50:u_7e547ae8162207004258b19a","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:75cb7f786961b4fe13fd36e05bb25c6d94bb0dd246e3d20aaf1a66bc8848b7de"]},{"@id":"urn:doxa:decision:4f8b3a1f536933bc87b2aa531f545df5","@type":["doxa:Decision","prov:Entity"],"recordId":"4f8b3a1f536933bc87b2aa531f545df5","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:6b0ccb975d051edea38137c0d5ac0c50:u_7e547ae8162207004258b19a","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:75cb7f786961b4fe13fd36e05bb25c6d94bb0dd246e3d20aaf1a66bc8848b7de"]},{"@id":"urn:doxa:decision:c41aa3218726bb9fa495aac400d20ed5","@type":["doxa:Decision","prov:Entity"],"recordId":"c41aa3218726bb9fa495aac400d20ed5","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:6b0ccb975d051edea38137c0d5ac0c50:u_7e547ae8162207004258b19a","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:75cb7f786961b4fe13fd36e05bb25c6d94bb0dd246e3d20aaf1a66bc8848b7de"]},{"@id":"urn:doxa:decision:ad034670b14bf4bb928b9f2cbe19bdbb","@type":["doxa:Decision","prov:Entity"],"recordId":"ad034670b14bf4bb928b9f2cbe19bdbb","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:6b0ccb975d051edea38137c0d5ac0c50:u_7e547ae8162207004258b19a","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:75cb7f786961b4fe13fd36e05bb25c6d94bb0dd246e3d20aaf1a66bc8848b7de"]},{"@id":"urn:doxa:decision:d1f05f0cddb0bcfd3d7bc27823f10326","@type":["doxa:Decision","prov:Entity"],"recordId":"d1f05f0cddb0bcfd3d7bc27823f10326","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:6b0ccb975d051edea38137c0d5ac0c50:u_7e547ae8162207004258b19a","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:75cb7f786961b4fe13fd36e05bb25c6d94bb0dd246e3d20aaf1a66bc8848b7de"]},{"@id":"urn:doxa:decision:a35f9e95a07c2e377d898788acdcde49","@type":["doxa:Decision","prov:Entity"],"recordId":"a35f9e95a07c2e377d898788acdcde49","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:6b0ccb975d051edea38137c0d5ac0c50:u_7e547ae8162207004258b19a","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:75cb7f786961b4fe13fd36e05bb25c6d94bb0dd246e3d20aaf1a66bc8848b7de"]},{"@id":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-728226","title":"Some Western observers share Central Asia's misgivings about Alexey Navalny","author":"Filip Noubel; Yevgeniya Plakhina","translator":[],"publishedOn":"2021-02-09","sourceUrl":"https://globalvoices.org/2021/02/09/some-western-observers-share-central-asias-misgivings-about-alexey-navalny/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"7fa23e70c6a553885d612990a39811e499f51e8e7ed6692fdd2cbe7ce13c5f9b","textSha256":"d704c931ae4c54a91a4da977b021811e3df9e6d7dcb2a248ff858b505f91fd5a","archivedRecordSha256":"18c98bc0655417502f5e9857b6702312b1d60b92ade5af498dc64278df4e7e0a","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:004d6aa176feec8766c4365507c3e92d:u_6fbf1b5f71ff13bb8d41ffb6","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_6fbf1b5f71ff13bb8d41ffb6","status":"accepted","fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d"},{"@id":"urn:doxa:unit:004d6aa176feec8766c4365507c3e92d:u_bff171b96c9218ac711cc058","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_bff171b96c9218ac711cc058","status":"accepted","fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d"},{"@id":"urn:doxa:passage:370ce01ce1e6959dd2818d34b8a5fd46ffd34292bf173d7536fe185a04af6f02","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00001","start":0,"end":262,"exact":"Today, the view among most members of the liberal Russian opposition, as well as in the West, is that whatever mistakes Alexey Navalny might have made in the past should be overlooked in the name of his fight against President Vladimir Putin's political system. "},{"@id":"urn:doxa:passage:6c307b42c400a4f80698ec8bbcbe9451fc6a4adba1d0f96cd65ec56b63560c05","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00001","start":262,"end":430,"exact":"Among Central Asians, however, that view is being disputed — and a minority in the West has voiced similar concerns about the way Navalny is being uncritically revered."},{"@id":"urn:doxa:passage:1544aaa6cd98eafbb80ffa497bb439cfa5cfc945317fadbe117dc1f3c99bcc24","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00002","start":0,"end":155,"exact":"Nazgul Yergalieva, a consultant from Kazakhstan who works in public policy and criminal justice reform, shared her views about Navalny with Global Voices. "},{"@id":"urn:doxa:passage:d1a52f4a4ee004999409de3cf07df788a4df6013ed29bffd2fb3c471884b3060","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00002","start":155,"end":322,"exact":"While she admires Navalny’s courage, condemns his imprisonment, and thinks he should be immediately released and given a fair trial, there are things that concern her:"},{"@id":"urn:doxa:passage:6c65364256d78ad51c15de7fccf63550cf99a9c69b2d4dbc523f189ce23f6f0f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00003","start":0,"end":158,"exact":"> I do not agree with his political views towards minorities, foreigners and his choice of offensive and even hateful language towards various nationalities. "},{"@id":"urn:doxa:passage:71584db32b62f4008e565aebade91ebc65df5a1ff752baa0bb1c367c3c8a5c2b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00003","start":158,"end":298,"exact":"His position on migration does the opposite of supporting fragile calls for tolerance and condemning flourishing xenophobia in the society. "},{"@id":"urn:doxa:passage:db3cf0361e8d676f784454c9e3fe29b782e92c3577d7dab5287c4bf81e864094","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00003","start":298,"end":462,"exact":"I also do not agree with the position of withholding such disagreement or having it interpreted as an attack or criticism against his other convictions and values. "},{"@id":"urn:doxa:passage:6031c26f2a138eb8f2ebe4440e76b8e2a4ec59d45144f318f663bee95d15ab84","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00003","start":462,"end":560,"exact":"I think we should have honest conversations and ask questions in order to understand the nuances. "},{"@id":"urn:doxa:passage:e2db32cd371ea4f75496028c3e9dcce1b99561fb5d1076d6ae63f65a15e16ac5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00003","start":560,"end":637,"exact":"Only such open conversation will lead to engagement, inclusion and pluralism."},{"@id":"urn:doxa:passage:2aa65cac5df0133bf53f55bda6719464eba16657ffb94c25532ebf5a2487f6c1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00004","start":0,"end":58,"exact":"This is a crucial issue, and not just for Central Asians. "},{"@id":"urn:doxa:passage:817a9eb56631ab909c40b88a3bdb81f175d044b79f24ad56bfbdc01c28d296b3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00004","start":58,"end":220,"exact":"Russia is a multiethnic country where non-ethnic Slavs (people who do not identify as Russians, Ukrainians, Belarusians) account for 17 percent of the population."},{"@id":"urn:doxa:passage:61763001300db9ccd95204648b65663d3b86fa7a3ce2f321fcafcaa50d918920","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00005","start":0,"end":47,"exact":"Most migrant workers take a dim view of Navalny"},{"@id":"urn:doxa:passage:6eff90df9d959581e61ae76b2f758e5e7584c68b3658e971de70b6a637a9dc3f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00006","start":0,"end":221,"exact":"For a majority of Central Asian migrant workers living in Russia, Navalny's rhetoric makes him a controversial, if not overtly negative figure, since he is in favor of regulating the presence of Central Asians in Russia. "},{"@id":"urn:doxa:passage:a4b2cfa0f59cb6d9517cd1680e405053b866794012cdfda11996d2f5115c1f90","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00006","start":221,"end":357,"exact":"Currently, citizens from Kazakhstan, Kyrgyzstan, Uzbekistan and Tajikistan do not need a visa to enter Russia and can stay for 90 days. "},{"@id":"urn:doxa:passage:e00dc8bd6c258fccedd53ac68da1e5967b2d8b5ee10af22842a98920081c0ac6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00006","start":357,"end":586,"exact":"While some migrant workers take the legal path and secure work contracts and visas in their home country, others simply buy a one-way plane, train or bus ticket and find jobs on the spot, often through networks of other migrants."},{"@id":"urn:doxa:passage:4db815d4a3fe4c895e17d4827914268eeb3f8187c4582494b0313eaad5f4d3f9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00007","start":0,"end":232,"exact":"Rashid [name changed for security reasons], an Uzbek migrant who has been living in Moscow for over ten years, says that in his community, Navalny is known as the politician wanting to introduce visas — the polar opposite of Putin. "},{"@id":"urn:doxa:passage:2ff461bb1be8521ae8e7571f77306a9891da894e2d6473968045fdfbbb3ae581","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00007","start":232,"end":399,"exact":"Navalny’s past mockery of Uzbeks’ alleged ignorance about the poet Pushkin, who has iconic status in Russia, is often cited as proof of his disdain for Central Asians."},{"@id":"urn:doxa:passage:b11a5b2d979a2cc5d994e927b77b485456ed8a056cb5b64996daad8d79123698","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00008","start":0,"end":250,"exact":"In a 2018 interview, Navalny said, “In Uzbekistan, no one knows Pushkin.” The statement triggered an online flash mob of Uzbeks reciting Pushkin's poetry to demonstrate that he had no idea what he was talking about, having never visited the country. "},{"@id":"urn:doxa:passage:8a992a6314f7cb5fec694f1feac8667061177ed4d690f2baf501af26fa85d16b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00008","start":250,"end":479,"exact":"This YouTube video, in Russian, from the Aliv TV channel, titled “Узбеки за Пушкина, против Навального” (Uzbeks for “Pushkin, against Navalny”), shows Navalny making the statement, followed by footage of Uzbeks reciting Pushkin. "},{"@id":"urn:doxa:passage:b4837e00d97044afa03fbfdf2faf6470223142b1f358a753457132a4793f2ad9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00008","start":479,"end":546,"exact":"The commentator adds that Navalny never apologized for his comment."},{"@id":"urn:doxa:passage:749553c37eee6e188d8e22547da2a16ad3f47fa57e26977f525f4556beb5b155","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00009","start":0,"end":238,"exact":"A similar incident happened in May 2012, when Navalny made a statement about Abay, a key figure in 19th century Kazakh literature, music and philosophy, publicly describing him as a “непонятный Казах” (“A Kazakh who doesn't make sense”). "},{"@id":"urn:doxa:passage:4a6c5763300a0c33e18ac820c65f0a215705308ec7b817555b8d6c08f3c35cc0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00009","start":238,"end":330,"exact":"On that occasion, though, he apologized on social media and declared himself a fan of Abay. "},{"@id":"urn:doxa:passage:917512e71d438af1c683b1b115bd7237c6e5a085b5abed30b231ff3e49bd6ddf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00009","start":330,"end":421,"exact":"One ironic aspect of the story is that Abay himself wrote texts calling for fair elections."},{"@id":"urn:doxa:passage:3cff82a740ed18990fa505c4ea1c81096a2f66c43e3afaac9eec16f163683ee8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00010","start":0,"end":38,"exact":"Critical views also voiced in the West"},{"@id":"urn:doxa:passage:e6594877f4c226555a84edc9e821c44242121dae1b106f32f60d84457f8b996e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:004d6aa176feec8766c4365507c3e92d","blockId":"gv-728226-b00011","start":0,"end":235,"exact":"Part of Navalny’s success as a public figure comes from a strong Western support base that presents a rather one-sided portrait of him, including through statements made by political figures, members of civil society, and journalists. "},{"@id":"urn:doxa:decision:4338b3ee2c17069541bd61c7c786305a","@type":["doxa:Decision","prov:Entity"],"recordId":"4338b3ee2c17069541bd61c7c786305a","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:004d6aa176feec8766c4365507c3e92d:u_6fbf1b5f71ff13bb8d41ffb6","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicab