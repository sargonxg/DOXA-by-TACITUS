762ac5c2d","urn:doxa:passage:050508149354e809612a076372d16f52d803a473221b2854d3b08f2e379ce8a6","urn:doxa:passage:e6870e6e09904204b5d43826af198b1bcfe68c16ad57dfdead3bf7a37742283c","urn:doxa:passage:9c8a14990cd47d47272a37f2be4fc8b8c4cf48855baaf89f43d6ba4c63da6ac7","urn:doxa:passage:594cf22f7515b88c1a57a52a29521b6a55ad1037a05518ff6f5abaddf510e3a5","urn:doxa:passage:82b88871e200cf33d7fe30212478aed8715ff0fdcababd6fc8b51789a4234dc0","urn:doxa:passage:8eddff6a92f3b83802b38ca260187e9ffa53ea7dce32c8427a2ade9eeaa685f3","urn:doxa:passage:486df2da1a072663bca6a28947da42b6cf79aecf369c9e1aa72b56c1068b4a43","urn:doxa:passage:0ed3a59fcf5c1f604c03a6c245b438bb8f8f63597fa68cea59bf481f17a74175","urn:doxa:passage:bc86a1bb3df6fcfb2277771bca8d26fc07862ccc25a95e67a6a5bbf65ef61ebd","urn:doxa:passage:544bc4f33ff82a6e6081fb72e53cc4a3048a57fcbc65fc7121ab36c9b6cdd3b2","urn:doxa:passage:404ba19efc1152c4f935f074043ca7a8d1a5561ae15f70260b26a2b786b38529","urn:doxa:passage:bfe666b1d38b111d65fe8a62c1c6a1d3c0e9cec984d50c1aaddcb976fddb3a81","urn:doxa:passage:21d4c60f05ebaaa07df1ed427facb306cdac9b0ebbc6fa538a75d24d58af423a","urn:doxa:passage:89401182c086e4d6ae26792c7679c659dd517e416113bccc9d121cb60e144a43","urn:doxa:passage:0be47d1462b7dbc6ce9edd023fc5eb005aa0791ed19c13576613ed8772d6974c","urn:doxa:passage:25dbb850c42c91fd8f293c52a797ef552d2cf4bb40fab63aad922f94f76246b3","urn:doxa:passage:6483cb7c3249b5432db6a6609520db5d8a8f7d8f378985d4c87ff6482211ad5a","urn:doxa:passage:dfff938c7f4b70b943acf3a9ea875d73f0882c5bf1b1e0480455062be53ec612"]},{"@id":"urn:doxa:decision:4df6fd35cfe5c39614b8754aaa8f50d1","@type":["doxa:Decision","prov:Entity"],"recordId":"4df6fd35cfe5c39614b8754aaa8f50d1","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:aca5b9320adfb82b697f08ef1e7a840e:u_f00916bf94db56f58af165ca","attribution":"reported_speaker","speaker":"Civic Media Observatory (reporting on Hindutva ideology)","speakerStance":"opposes","documentStance":"neutral","proposition":"Muslim women should be rescued from Islam and religious demography should be changed.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The article details how Hindutva ideology seeks to change religious demography and uses narratives of 'rescuing' women to justify discriminatory social and legal frameworks.","modelPassage":["urn:doxa:passage:544bc4f33ff82a6e6081fb72e53cc4a3048a57fcbc65fc7121ab36c9b6cdd3b2","urn:doxa:passage:404ba19efc1152c4f935f074043ca7a8d1a5561ae15f70260b26a2b786b38529"]},{"@id":"urn:doxa:decision:c17c35c59a4e00380c967aaec991d33f","@type":["doxa:Decision","prov:Entity"],"recordId":"c17c35c59a4e00380c967aaec991d33f","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:aca5b9320adfb82b697f08ef1e7a840e:u_f00916bf94db56f58af165ca","attribution":"reported_speaker","speaker":"Civic Media Observatory","speakerStance":"neutral","documentStance":"supports","proposition":"Islamophobia is institutionalized in India through specific tropes and political actions.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text describes the institutionalization of Islamophobia through specific tropes and legislative actions, such as the outlawing of Triple Talaq, which the author links to a broader narrative of rescuing Muslim women.","modelPassage":["urn:doxa:passage:8eddff6a92f3b83802b38ca260187e9ffa53ea7dce32c8427a2ade9eeaa685f3","urn:doxa:passage:404ba19efc1152c4f935f074043ca7a8d1a5561ae15f70260b26a2b786b38529","urn:doxa:passage:bfe666b1d38b111d65fe8a62c1c6a1d3c0e9cec984d50c1aaddcb976fddb3a81"]},{"@id":"urn:doxa:decision:d9ca7845dddf16edb3ebc076abbd8b22","@type":["doxa:Decision","prov:Entity"],"recordId":"d9ca7845dddf16edb3ebc076abbd8b22","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:aca5b9320adfb82b697f08ef1e7a840e:u_f00916bf94db56f58af165ca","attribution":"reported_speaker","speaker":"Civic Media Observatory (reporting on BJP/Hindutva narratives)","speakerStance":"opposes","documentStance":"neutral","proposition":"Muslims are responsible for violence against Hindus and Muslim women are inherently oppressed by their religion.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text describes how political movements use narratives that blame Muslims for violence and employ tropes of the 'oppressed Muslim woman' to suggest inherent religious inferiority.","modelPassage":["urn:doxa:passage:e6870e6e09904204b5d43826af198b1bcfe68c16ad57dfdead3bf7a37742283c","urn:doxa:passage:8eddff6a92f3b83802b38ca260187e9ffa53ea7dce32c8427a2ade9eeaa685f3","urn:doxa:passage:bc86a1bb3df6fcfb2277771bca8d26fc07862ccc25a95e67a6a5bbf65ef61ebd"]},{"@id":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-757446","title":"Ukraine's war unleashes flood of racism by media and politicians against Arab war victims","author":"Dahlia Kholaif","translator":[],"publishedOn":"2022-03-02","sourceUrl":"https://globalvoices.org/2022/03/02/ukraines-war-unleashes-flood-of-racism-by-media-and-politicians-against-arab-war-victims/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"2307b7eb23a0c270974347e39ecabc624c74ddc1cbdc9e4c7f5cbf3e89e62e17","textSha256":"9d6004904089b920ea0b930ccef012396c968ba6bf0f836f20cc750209373647","archivedRecordSha256":"49df378c74f2eb6562526de429b103600ba930121bf92808ade431466c7346c1","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:b2308a8eb6de139fa89d911d2f7bbb7c:u_52d3705590a21e3c42b6abe2","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_52d3705590a21e3c42b6abe2","status":"accepted","fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c"},{"@id":"urn:doxa:unit:b2308a8eb6de139fa89d911d2f7bbb7c:u_764b9e094eb05a14e37ffcf0","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_764b9e094eb05a14e37ffcf0","status":"accepted","fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c"},{"@id":"urn:doxa:passage:a25ef484743ce97c296ca99388ec5010faa7b79c8b62474db9184e73a418d36c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00015","start":0,"end":139,"exact":"> Here, the Bulgarian prime minister frankly says: “Ukrainian refugees are not from the refugees we're used to, and so we'll welcome them. "},{"@id":"urn:doxa:passage:5ee9a5906e8137120c3526ec9785d7c4ea8fbcb814bdaac3a93854a1296845b9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00015","start":139,"end":245,"exact":"They're smart and educated Europeans, and have no obscure pasts, like the possibility of being terrorists."},{"@id":"urn:doxa:decision:ce8b662b07e78f4b62ae8e3a75d9bc5e","@type":["doxa:Decision","prov:Entity"],"recordId":"ce8b662b07e78f4b62ae8e3a75d9bc5e","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:b2308a8eb6de139fa89d911d2f7bbb7c:u_52d3705590a21e3c42b6abe2","attribution":"reported_speaker","speaker":"Bulgarian prime minister (via Ward Furati)","speakerStance":"supports","documentStance":"neutral","proposition":"Ukrainian refugees are more welcome than others due to their European identity and lack of perceived terrorist backgrounds.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports a Bulgarian prime minister's claim that Ukrainian refugees are preferred over others because they lack 'obscure pasts' like being terrorists.","modelPassage":["urn:doxa:passage:a25ef484743ce97c296ca99388ec5010faa7b79c8b62474db9184e73a418d36c","urn:doxa:passage:5ee9a5906e8137120c3526ec9785d7c4ea8fbcb814bdaac3a93854a1296845b9"]},{"@id":"urn:doxa:decision:e60a1e1d6f8e65ee6b48d77b8fc1eaef","@type":["doxa:Decision","prov:Entity"],"recordId":"e60a1e1d6f8e65ee6b48d77b8fc1eaef","outcome":"uncertain","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:b2308a8eb6de139fa89d911d2f7bbb7c:u_52d3705590a21e3c42b6abe2","attribution":"reported_speaker","speaker":"Bulgarian premier (as reported by Ward)","speakerStance":"supports","documentStance":"opposes","proposition":"Non-European refugees have 'obscure pasts' involving the possibility of being terrorists.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"While the reported remark links non-European refugees to terrorism, the document reports this as an example of racism rather than establishing the speaker's internal intent. (s_f9d981804c120bd1da56e6e5)","modelPassage":["urn:doxa:passage:5ee9a5906e8137120c3526ec9785d7c4ea8fbcb814bdaac3a93854a1296845b9"]},{"@id":"urn:doxa:decision:35455cc2909230cc757408a95027cac8","@type":["doxa:Decision","prov:Entity"],"recordId":"35455cc2909230cc757408a95027cac8","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:b2308a8eb6de139fa89d911d2f7bbb7c:u_52d3705590a21e3c42b6abe2","attribution":"reported_speaker","speaker":"Bulgarian premier (as reported by Ward)","speakerStance":"supports","documentStance":"opposes","proposition":"Refugees from certain backgrounds are potentially terrorists, unlike 'smart and educated' Europeans.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports a politician's claim that certain refugees are preferred because they lack 'obscure pasts' like being terrorists, targeting Middle Eastern/Muslim identities. (s_f9d981804c120bd1da56e6e5)","modelPassage":["urn:doxa:passage:5ee9a5906e8137120c3526ec9785d7c4ea8fbcb814bdaac3a93854a1296845b9"]},{"@id":"urn:doxa:passage:51fdbf87bc6a8fa21def880f560c30637c83698fa9bcb84c73dad438b92c9d57","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00009","start":197,"end":506,"exact":"As thousands took the life-threatening journey of crossing the Mediterranean Sea to reach Europe and start over, European countries have set up laws, policies, and barriers to stop them from entering their countries, leaving hundreds of families in impoverished camps, exposed to the elements and deprivation."},{"@id":"urn:doxa:decision:69aa6d3844728856b25f7c9aed2bdbc9","@type":["doxa:Decision","prov:Entity"],"recordId":"69aa6d3844728856b25f7c9aed2bdbc9","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:b2308a8eb6de139fa89d911d2f7bbb7c:u_52d3705590a21e3c42b6abe2","attribution":"reported_speaker","speaker":"European countries/Bulgarian PM (via text/Ward)","speakerStance":"supports","documentStance":"neutral","proposition":"Non-European refugees face more barriers and less welcome than Ukrainian refugees.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports on European policies creating barriers for non-European refugees and a politician's stated preference for Ukrainian refugees over others.","modelPassage":["urn:doxa:passage:51fdbf87bc6a8fa21def880f560c30637c83698fa9bcb84c73dad438b92c9d57","urn:doxa:passage:a25ef484743ce97c296ca99388ec5010faa7b79c8b62474db9184e73a418d36c"]},{"@id":"urn:doxa:passage:b97ebda058d7a63466756e6db908721941a6ea519450feaa9dc99ecad901e3c4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00002","start":0,"end":190,"exact":"On February 27, Syrian Twitter user @WardFurati88 posted a thread compiling all the racial and discriminatory comments made by correspondents of global media brands as they covered the war. "},{"@id":"urn:doxa:passage:7262443c39ffa23d075d179c7a66952dd67c38e7e010faa7e65241ed9a2533ca","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00004","start":0,"end":184,"exact":"He began with the comments made by CBS senior foreign correspondent Chris D’Agata, in which he expressed his sympathy with Ukrainians, who are more European than Iraq and Afghanistan. "},{"@id":"urn:doxa:passage:8e4ec6f5fe2ced03256593a9c9275ba4fc1be59815006cd8592c533a65e8563c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00007","start":0,"end":122,"exact":"Secondly, he referred to the comments made by David Sakvarelidze, Ukraine’s former deputy general prosecutor, on the BBC. "},{"@id":"urn:doxa:passage:1416e44b1ec1a40c974f8fd4f12bee23916df44671e154f097f7e24d6f19af6e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00012","start":0,"end":130,"exact":"Moving to the print media, Ward quotes — with slight deviation — an op-ed by Daniel Hannan in the British newspaper The Telegraph:"},{"@id":"urn:doxa:passage:a3c66e748f9bbe596f6886ef6230b89db2a60f7d17ff63b298588dad508e7751","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00014","start":0,"end":87,"exact":"Shifting to politicians’ remarks, Ward outlined comments made by the Bulgarian premier:"},{"@id":"urn:doxa:decision:59300d4bef8f88da11a089797eb15ffa","@type":["doxa:Decision","prov:Entity"],"recordId":"59300d4bef8f88da11a089797eb15ffa","outcome":"uncertain","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:b2308a8eb6de139fa89d911d2f7bbb7c:u_52d3705590a21e3c42b6abe2","attribution":"reported_speaker","speaker":"Dahlia Kholaif (reporting on @WardFurati88's compilation)","speakerStance":"unclear","documentStance":"neutral","proposition":"Media and political remarks regarding Ukrainian refugees reflect a pattern of racialized comparison.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports a compilation of individual remarks from various media figures and politicians. While multiple instances are cited, the document does not provide the corpus-level evidence or comparative structural analysis required to establish a verified institutional pattern.","modelPassage":["urn:doxa:passage:b97ebda058d7a63466756e6db908721941a6ea519450feaa9dc99ecad901e3c4","urn:doxa:passage:7262443c39ffa23d075d179c7a66952dd67c38e7e010faa7e65241ed9a2533ca","urn:doxa:passage:8e4ec6f5fe2ced03256593a9c9275ba4fc1be59815006cd8592c533a65e8563c","urn:doxa:passage:1416e44b1ec1a40c974f8fd4f12bee23916df44671e154f097f7e24d6f19af6e","urn:doxa:passage:a3c66e748f9bbe596f6886ef6230b89db2a60f7d17ff63b298588dad508e7751"]},{"@id":"urn:doxa:passage:41c8bf52efb75e745c3c07400749e2219b47a3ce3c7bebacc8060949bf0e80af","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00001","start":213,"end":423,"exact":"The commentary involved expressing sympathy for Ukrainian victims of the war, and shock about the images of people because they seem more “European,” and are more “civilized” than Middle Eastern victims of war."},{"@id":"urn:doxa:passage:0c2ac3809b5f3d82032ca0f3b6fdcc17927831202cf6c2ff00ebbcdd94d824cb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00008","start":0,"end":275,"exact":"> Now, with the correspondent of the BBC who got emotional while on air, and justified this as saying: “I apologize.. but what is happening is emotion-provoking, because I am seeing European people with blue eyes and blond hair… children killed… by Putin missiles everyday”. "},{"@id":"urn:doxa:passage:be927f12468db78342e29926eec4be0cd5a1f2f9e3ec6cb6307fc8aa7150d3ac","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00011","start":272,"end":355,"exact":"They look like any European family.” This is what really matters: they're European."},{"@id":"urn:doxa:decision:c8926b61c0e2aad37b143af49af4df3c","@type":["doxa:Decision","prov:Entity"],"recordId":"c8926b61c0e2aad37b143af49af4df3c","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:b2308a8eb6de139fa89d911d2f7bbb7c:u_52d3705590a21e3c42b6abe2","attribution":"reported_speaker","speaker":"Media correspondents (via Ward Furati)","speakerStance":"supports","documentStance":"neutral","proposition":"Empathy is linked to European physical characteristics, implying non-Europeans are less 'civilized'.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The article reports media commentary that equates 'civilization' and empathy with European physical traits like blue eyes and blond hair, contrasting them with Middle Eastern victims.","modelPassage":["urn:doxa:passage:41c8bf52efb75e745c3c07400749e2219b47a3ce3c7bebacc8060949bf0e80af","urn:doxa:passage:0c2ac3809b5f3d82032ca0f3b6fdcc17927831202cf6c2ff00ebbcdd94d824cb","urn:doxa:passage:be927f12468db78342e29926eec4be0cd5a1f2f9e3ec6cb6307fc8aa7150d3ac"]},{"@id":"urn:doxa:passage:b66d67b74a02383a53d4018f46aefc4ddce4f7851198458c2bb8e40274122cc5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00024","start":0,"end":317,"exact":"As Twitter flooded with updates about the racism with which African and Middle Eastern residents of Ukraine were treated as they too tried to flee the country, and which the UN admitted has taken place, Arab and African users debated the treatment their nations have received from the West during periods of distress."},{"@id":"urn:doxa:decision:5d0884e02cafd9b43c352a7e94a57f8e","@type":["doxa:Decision","prov:Entity"],"recordId":"5d0884e02cafd9b43c352a7e94a57f8e","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:b2308a8eb6de139fa89d911d2f7bbb7c:u_764b9e094eb05a14e37ffcf0","attribution":"reported_speaker","speaker":"Twitter users and the UN","speakerStance":"opposes","documentStance":"neutral","proposition":"African and Middle Eastern residents of Ukraine were treated with racism while fleeing.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports on claims of racism and unequal treatment of African and Middle Eastern residents fleeing Ukraine, as noted by Twitter users and the UN.","modelPassage":["urn:doxa:passage:b66d67b74a02383a53d4018f46aefc4ddce4f7851198458c2bb8e40274122cc5"]},{"@id":"urn:doxa:passage:2abb27c1afa70ab9ccd196cd3abaed13c50c3c35b2ccd94588bb9743698f51fd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00016","start":0,"end":236,"exact":"Ward's following tweet evoked another argument raised by many Arabs who contrasted the West's hailing of Ukrainian resistance against Russian occupation with the West's condemnation of Palestinian resistance against Israeli occupation. "},{"@id":"urn:doxa:passage:080572feff84fd8d932303a7927d5dffcfd9323eac04d4393b31dcc4c562c0c7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00016","start":236,"end":245,"exact":"He wrote:"},{"@id":"urn:doxa:passage:55a3b5585b5f469a33f66bd2058293065ef603b77d7278fad4b82fce5a380aaa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00017","start":0,"end":186,"exact":"> Since the Bulgarian PM mentioned terrorist, lets read how the New York Post described an Ukrainian soldier as ‘heroic’ after blowing himself up on a bridge to prevent Russian advances."},{"@id":"urn:doxa:passage:0883d95ef0c9810ef8fbed037222df132b4db5659d962ae68e4e6d55fe2449d2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00018","start":0,"end":265,"exact":"He then flagged Western government's hypocrisy and double standards when it comes to immigration, as the European countries tightened control over borders to restrict entry of war refugees on the basis of fear that they were involved in fighting in their homelands."},{"@id":"urn:doxa:passage:00bc9f6b2f1a6b96b8ef5e413721f669fc52d9abc1f024552c8619849bfb0251","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00019","start":0,"end":380,"exact":"> What about “immigrants”… I mean people coming in from outside the borders of the country to fight with its people against invaders… Here were read the comments of the British Prime Minister in which he encouraged calls for those who want to fight in Ukraine, including the British, as well as the statement by Ukrainian president on establishing a platoon of foreign volunteers."},{"@id":"urn:doxa:passage:d47cd064d6688d704e0b9dd09131910af09807ff7536bfa700e3f73642109cad","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00020","start":0,"end":202,"exact":"Ward also pointed out how accommodating and tolerant world organizations are of the forms of solidarity expressed to Ukrainians, versus those expressed for Palestinians as subjects of Israeli invasion. "},{"@id":"urn:doxa:passage:fd8ccc8f3ae89452f655dbd16ee6c628c0a522b224f5ee198e2c107128020623","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00020","start":202,"end":392,"exact":"He referred to Egyptian football superstar Mahmoud Abu Trika, whose expression of solidarity with Gaza as it was pounded by Israeli raids in 2008 got him reprimanded by football authorities."},{"@id":"urn:doxa:passage:e41ef5cf1f3f441f3123b506564e333a11c0ff542f433488b7bad659dd388c8f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00021","start":0,"end":151,"exact":"> What about [a football] player who lifted his T-shirt in a game after scoring a goal, to reveal “No War in Ukraine” which he had written underneath. "},{"@id":"urn:doxa:passage:aebd5baf9e58eccb83a3e9266a58a5fe71908b81be1d7fab51ad07d1e1c49152","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00021","start":151,"end":297,"exact":"Will FIFA tell him what it told Abu Trika previously when he lifted his T-shirt after scoring a goal, to show a message of “Sympathize with Gaza”?"},{"@id":"urn:doxa:passage:efba5fdd8df6c526fda7dfef812dd18033985d70da066f0c47b83d04a51ca06b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00022","start":0,"end":366,"exact":"Ward then went on to analyze how global entities rushed to boycott Russia, blocking its participation in all fields, rendering it an outcast, while Moscow continued to participate in and host international events even as it played a key role in the war in Syria, which has killed thousands, displaced many more, fragmented families, and left the country in shambles."},{"@id":"urn:doxa:passage:b32914dee929d7e15ab1cf628327aa2421ad396d0a1d7ddc283cb3f4c77b4c8d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00023","start":0,"end":273,"exact":"Over the following days, Ward continued to build on the thread, with the help of his followers, adding more examples of how the Western world, its politicians, and media, clearly differentiate between who is entitled to the rights of peace and life based on color and race."},{"@id":"urn:doxa:passage:9360954c468290ae5044585273239700f598927dff8980bb4350e2a3d95ae960","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00025","start":0,"end":23,"exact":"One Twitter user wrote:"},{"@id":"urn:doxa:passage:84286b6a3771dd6f2c1d133aa1fbfc24328e6e96ebc68f69dcbb7978c1532e5f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00026","start":0,"end":165,"exact":"Commenting on the terms “civilized” and “developing,” which several racist comments used as indicators for who is worthy of humane treatment, one Twitter user wrote:"},{"@id":"urn:doxa:passage:2605a816f783b770dd91813a0670200ff0c169c3618aedd9b72b63f4eaa4509c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:b2308a8eb6de139fa89d911d2f7bbb7c","blockId":"gv-757446-b00027","start":0,"end":87,"exact":"For more information about this topic, see our special coverage Russia invades Ukraine."},{"@id":"urn:doxa:decision:c56b1a80250143159ab33a3a35a85dbe","@type":["doxa:Decision","prov:Entity"],"recordId":"c56b1a80250143159ab33a3a35a85dbe","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:b2308a8eb6de139fa89d911d2f7bbb7c:u_764b9e094eb05a14e37ffcf0","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:2abb27c1afa70ab9ccd196cd3abaed13c50c3c35b2ccd94588bb9743698f51fd","urn:doxa:passage:080572feff84fd8d932303a7927d5dffcfd9323eac04d4393b31dcc4c562c0c7","urn:doxa:passage:55a3b5585b5f469a33f66bd2058293065ef603b77d7278fad4b82fce5a380aaa","urn:doxa:passage:0883d95ef0c9810ef8fbed037222df132b4db5659d962ae68e4e6d55fe2449d2","urn:doxa:passage:00bc9f6b2f1a6b96b8ef5e413721f669fc52d9abc1f024552c8619849bfb0251","urn:doxa:passage:d47cd064d6688d704e0b9dd09131910af09807ff7536bfa700e3f73642109cad","urn:doxa:passage:fd8ccc8f3ae89452f655dbd16ee6c628c0a522b224f5ee198e2c107128020623","urn:doxa:passage:e41ef5cf1f3f441f3123b506564e333a11c0ff542f433488b7bad659dd388c8f","urn:doxa:passage:aebd5baf9e58eccb83a3e9266a58a5fe71908b81be1d7fab51ad07d1e1c49152","urn:doxa:passage:efba5fdd8df6c526fda7dfef812dd18033985d70da066f0c47b83d04a51ca06b","urn:doxa:passage:b32914dee929d7e15ab1cf628327aa2421ad396d0a1d7ddc283cb3f4c77b4c8d","urn:doxa:passage:b66d67b74a02383a53d4018f46aefc4ddce4f7851198458c2bb8e40274122cc5","urn:doxa:passage:9360954c468290ae5044585273239700f598927dff8980bb4350e2a3d95ae960","urn:doxa:passage:84286b6a3771dd6f2c1d133aa1fbfc24328e6e96ebc68f69dcbb7978c1532e5f","urn:doxa:passage:2605a816f783b770dd91813a0670200ff0c169c3618aedd9b72b63f4eaa4509c"]},{"@id":"urn:doxa:decision:2536b48cbd9ba45dedeb0b801885312a","@type":["doxa:Decision","prov:Entity"],"recordId":"2536b48cbd9ba45dedeb0b801885312a","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:b2308a8eb6de139fa89d911d2f7bbb7c:u_764b9e094eb05a14e37ffcf0","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:2abb27c1afa70ab9ccd196cd3abaed13c50c3c35b2ccd94588bb9743698f51fd","urn:doxa:passage:080572feff84fd8d932303a7927d5dffcfd9323eac04d4393b31dcc4c562c0c7","urn:doxa:passage:55a3b5585b5f469a33f66bd2058293065ef603b77d7278fad4b82fce5a380aaa","urn:doxa:passage:0883d95ef0c9810ef8fbed037222df132b4db5659d962ae68e4e6d55fe2449d2","urn:doxa:passage:00bc9f6b2f1a6b96b8ef5e413721f669fc52d9abc1f024552c8619849bfb0251","urn:doxa:passage:d47cd064d6688d704e0b9dd09131910af09807ff7536bfa700e3f73642109cad","urn:doxa:passage:fd8ccc8f3ae89452f655dbd16ee6c628c0a522b224f5ee198e2c107128020623","urn:doxa:passage:e41ef5cf1f3f441f3123b506564e333a11c0ff542f433488b7bad659dd388c8f","urn:doxa:passage:aebd5baf9e58eccb83a3e9266a58a5fe71908b81be1d7fab51ad07d1e1c49152","urn:doxa:passage:efba5fdd8df6c526fda7dfef812dd18033985d70da066f0c47b83d04a51ca06b","urn:doxa:passage:b32914dee929d7e15ab1cf628327aa2421ad396d0a1d7ddc283cb3f4c77b4c8d","urn:doxa:passage:b66d67b74a02383a53d4018f46aefc4ddce4f7851198458c2bb8e40274122cc5","urn:doxa:passage:9360954c468290ae5044585273239700f598927dff8980bb4350e2a3d95ae960","urn:doxa:passage:84286b6a3771dd6f2c1d133aa1fbfc24328e6e96ebc68f69dcbb7978c1532e5f","urn:doxa:passage:2605a816f783b770dd91813a0670200ff0c169c3618aedd9b72b63f4eaa4509c"]},{"@id":"urn:doxa:decision:ac741c41dc496398ad26b7daddeb3825","@type":["doxa:Decision","prov:Entity"],"recordId":"ac741c41dc496398ad26b7daddeb3825","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:b2308a8eb6de139fa89d911d2f7bbb7c:u_764b9e094eb05a14e37ffcf0","attribution":"reported_speaker","speaker":"Ward","speakerStance":"opposes","documentStance":"neutral","proposition":"European countries restricted entry of war refugees based on fears of their background.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports on claims of Western governments tightening border controls to restrict refugees based on fears of involvement in fighting.","modelPassage":["urn:doxa:passage:0883d95ef0c9810ef8fbed037222df132b4db5659d962ae68e4e6d55fe2449d2"]},{"@id":"urn:doxa:decision:6148d3a17225a5dff094770e1aa84a1a","@type":["doxa:Decision","prov:Entity"],"recordId":"6148d3a17225a5dff094770e1aa84a1a","outcome":"uncertain","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:b2308a8eb6de139fa89d911d2f7bbb7c:u_764b9e094eb05a14e37ffcf0","attribution":"reported_speaker","speaker":"Ward and various Twitter users","speakerStance":"opposes","documentStance":"neutral","proposition":"Western entities differentiate rights based on race and exhibit double standards regarding solidarity and immigration.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports on individual claims of racism and UN admissions of mistreatment, but a single passage cannot establish a verified institutional pattern of practice.","modelPassage":["urn:doxa:passage:b66d67b74a02383a53d4018f46aefc4ddce4f7851198458c2bb8e40274122cc5"]},{"@id":"urn:doxa:decision:61c3eb5315216dec2417455773318f77","@type":["doxa:Decision","prov:Entity"],"recordId":"61c3eb5315216dec2417455773318f77","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:b2308a8eb6de139fa89d911d2f7bbb7c:u_764b9e094eb05a14e37ffcf0","attribution":"reported_speaker","speaker":"Twitter users","speakerStance":"opposes","documentStance":"neutral","proposition":"Terms like 'civilized' are used to racialized groups to determine worthiness of treatment.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text mentions racist comments using 'civilized' and 'developing' as indicators of who is worthy of humane treatment.","modelPassage":["urn:doxa:passage:84286b6a3771dd6f2c1d133aa1fbfc24328e6e96ebc68f69dcbb7978c1532e5f"]},{"@id":"urn:doxa:source:61ae8b482ee6d1a7c22d8f553d9a22a8","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-758849","title":"Undertones: Putin’s war emboldens promoters of a ‘United India’","author":"Civic Media Observatory","translator":[],"publishedOn":"2022-03-18","sourceUrl":"https://globalvoices.org/2022/03/18/undertones-putins-war-emboldens-promoters-of-a-united-india/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"c07cf44216911655cacc4717c5b316830d9bb960d899f5bbd9e97a456c06cb7c","textSha256":"160603d6fc681cd6894702b63654cc822cd8ba8f49cfc717d0b51fd7d496c5e4","archivedRecordSha256":"f97086f6c6db14fd4eda89cabb889f9b90434080ca68afd6d8b17ab80bb06981","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:61ae8b482ee6d1a7c22d8f553d9a22a8:u_17cd2534c73df3f5e5f252d7","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_17cd2534c73df3f5e5f252d7","status":"accepted","fromSource":"urn:doxa:source:61ae8b482ee6d1a7c22d8f553d9a22a8"},{"@id":"urn:doxa:unit:61ae8b482ee6d1a7c22d8f553d9a22a8:u_547c86702df0e76c692efb88","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_547c86702df0e76c692efb88","status":"accepted","fromSource":"urn:doxa:source:61ae8b482ee6d1a7c22d8f553d9a22a8"},{"@id":"urn:doxa:unit:61ae8b482ee6d1a7c22d8f553d9a22a8:u_91aabb7c5342f62f8f08399e","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_91aabb7c5342f62f8f08399e","status":"accepted","fromSource":"urn:doxa:source:61ae8b482ee6d1a7c22d8f553d9a22a8"},{"@id":"urn:doxa:passage:9868beea9751f8a4834f922fbbc0c699900b27954cc1a901d106fb74d04e4ce7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:61ae8b482ee6d1a7c22d8f553d9a22a8","blockId":"gv-758849-b00031","start":0,"end":29,"exact":"View our entire India dataset"},{"@id":"urn:doxa:passage:4a9b4a172b4f6fdee1b377cdee71ee1d5766afc9ffde3df194d42150f8abe01a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:61ae8b482ee6d1a7c22d8f553d9a22a8","blockId":"gv-758849-b00032","start":0,"end":34,"exact":"Civic Media Observatory at MozFest"},{"@id":"urn:doxa:passage:a8e42404adc0590e2be3a4639edf04228c6c85372394938736777f5d9362030f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:61ae8b482ee6d1a7c22d8f553d9a22a8","blockId":"gv-758849-b00033","start":0,"end":100,"exact":"Identifying misinformation and disinformation online can feel like a hopeless game of Whack-a-Mole. "},{"@id":"urn:doxa:passage:d2c320373d76954b4da367bc866be5836baac15fdaa4a2be260500c4b0d76b5d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:61ae8b482ee6d1a7c22d8f553d9a22a8","blockId":"gv-758849-b00033","start":100,"end":350,"exact":"On March 10, at the 2022 MozFest hosted by the Mozilla Foundation, our Civic