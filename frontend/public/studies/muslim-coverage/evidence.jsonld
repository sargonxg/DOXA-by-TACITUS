a974763943e80a6eddf85e9170f4d791dfbb95ed","archivedRecordSha256":"8987ae4c01e385a8e15c501888a214f45d8675263213fd1fbf3243fcc988b7f7","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:1385ea039e5017d9f68376c0e45e60a7:u_bf11c66e9a0bfa062c6998bf","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_bf11c66e9a0bfa062c6998bf","status":"accepted","fromSource":"urn:doxa:source:1385ea039e5017d9f68376c0e45e60a7"},{"@id":"urn:doxa:passage:c52822da612ea6a7fc35b91203c766e2730dcbe42ba3ea946393f69c3087df2b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1385ea039e5017d9f68376c0e45e60a7","blockId":"gv-721315-b00012","start":0,"end":144,"exact":"A Muslim woman who posted a picture of her interfaith marriage in support of the Tanishq commercial received 40,000 abusive messages on Twitter."},{"@id":"urn:doxa:passage:1c2deb03fe1f8eb18772b5a35fb8147cc8d97596532b98700b6fda1af5df1d6f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1385ea039e5017d9f68376c0e45e60a7","blockId":"gv-721315-b00011","start":0,"end":71,"exact":"Couples of interfaith marriages have often been victims of harassment. "},{"@id":"urn:doxa:decision:9305094bfbda17262702382a209c2f6b","@type":["doxa:Decision","prov:Entity"],"recordId":"9305094bfbda17262702382a209c2f6b","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:1385ea039e5017d9f68376c0e45e60a7:u_bf11c66e9a0bfa062c6998bf","attribution":"reported_speaker","speaker":"Author (reporting on victims)","speakerStance":"neutral","documentStance":"neutral","proposition":"Muslim individuals in interfaith marriages are targets of online abuse and harassment.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text reports that interfaith couples face harassment and a Muslim woman received 40,000 abusive messages due to her marriage and support for the ad.","modelPassage":["urn:doxa:passage:c52822da612ea6a7fc35b91203c766e2730dcbe42ba3ea946393f69c3087df2b","urn:doxa:passage:1c2deb03fe1f8eb18772b5a35fb8147cc8d97596532b98700b6fda1af5df1d6f"]},{"@id":"urn:doxa:passage:503354f5f0264b787cfa1bd37e72d0bd693feb10e16070932ad8189f7ae7c778","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1385ea039e5017d9f68376c0e45e60a7","blockId":"gv-721315-b00004","start":0,"end":178,"exact":"Indian right-wing activists claimed the commercial promoted “love jihad,” a conspiracy theory whereby Muslim men are accused of converting Hindu women to their faith by marriage."},{"@id":"urn:doxa:decision:7028e726b822166eb92989c81c389607","@type":["doxa:Decision","prov:Entity"],"recordId":"7028e726b822166eb92989c81c389607","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:1385ea039e5017d9f68376c0e45e60a7:u_bf11c66e9a0bfa062c6998bf","attribution":"reported_speaker","speaker":"N/A","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"N/A","hypothetical":false,"reviewStatus":"unreviewed","modelPassage":["urn:doxa:passage:503354f5f0264b787cfa1bd37e72d0bd693feb10e16070932ad8189f7ae7c778"]},{"@id":"urn:doxa:decision:21c7d49b9c37c4269a6ee83d8a4c5f83","@type":["doxa:Decision","prov:Entity"],"recordId":"21c7d49b9c37c4269a6ee83d8a4c5f83","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:1385ea039e5017d9f68376c0e45e60a7:u_bf11c66e9a0bfa062c6998bf","attribution":"reported_speaker","speaker":"N/A","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"N/A","hypothetical":false,"reviewStatus":"unreviewed","modelPassage":["urn:doxa:passage:c52822da612ea6a7fc35b91203c766e2730dcbe42ba3ea946393f69c3087df2b"]},{"@id":"urn:doxa:passage:b8025fcc1d800f3ccebc1a50e9f232fa7c4e5d086f14b24bbee1d28a9d85303f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1385ea039e5017d9f68376c0e45e60a7","blockId":"gv-721315-b00007","start":0,"end":97,"exact":"Conservative groups also staged protests outside Tanishq jewellery stores in some Indian cities. "},{"@id":"urn:doxa:passage:3725ef78fe464312ae0b00cc5f48d0bb73fa77f4022a36592b3d4179943a60e9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1385ea039e5017d9f68376c0e45e60a7","blockId":"gv-721315-b00007","start":97,"end":171,"exact":"In Indore, they demanded stores displayed the apology note on the windows."},{"@id":"urn:doxa:decision:da2c63f372f201ca0b6336a8c9701260","@type":["doxa:Decision","prov:Entity"],"recordId":"da2c63f372f201ca0b6336a8c9701260","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:1385ea039e5017d9f68376c0e45e60a7:u_bf11c66e9a0bfa062c6998bf","attribution":"reported_speaker","speaker":"Conservative groups","speakerStance":"supports","documentStance":"neutral","proposition":"Mixed-faith representation should be removed or apologized for.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"Conservative groups staged protests and demanded the brand issue an apology, effectively pressuring the removal of a mixed-faith representation.","modelPassage":["urn:doxa:passage:b8025fcc1d800f3ccebc1a50e9f232fa7c4e5d086f14b24bbee1d28a9d85303f","urn:doxa:passage:3725ef78fe464312ae0b00cc5f48d0bb73fa77f4022a36592b3d4179943a60e9"]},{"@id":"urn:doxa:passage:19f6422fd41c267e4bf0a97834e53bce015e2f474c9270b7fa9412a912eef3ec","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:1385ea039e5017d9f68376c0e45e60a7","blockId":"gv-721315-b00011","start":71,"end":187,"exact":"With growing religious intolerance under the current government, abuse has increased — and often takes place online."},{"@id":"urn:doxa:decision:541e864287a762b0a24d49ce979d1b9a","@type":["doxa:Decision","prov:Entity"],"recordId":"541e864287a762b0a24d49ce979d1b9a","outcome":"uncertain","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:1385ea039e5017d9f68376c0e45e60a7:u_bf11c66e9a0bfa062c6998bf","attribution":"reported_speaker","speaker":"Author (Anumeha Verma)","speakerStance":"neutral","documentStance":"neutral","proposition":"Growing religious intolerance and harassment of interfaith couples under the current government.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"The text mentions increased abuse and harassment of interfaith couples under the current government, but a single news report lacks the corpus context to establish a proven systemic institutional pattern.","modelPassage":["urn:doxa:passage:19f6422fd41c267e4bf0a97834e53bce015e2f474c9270b7fa9412a912eef3ec","urn:doxa:passage:1c2deb03fe1f8eb18772b5a35fb8147cc8d97596532b98700b6fda1af5df1d6f"]},{"@id":"urn:doxa:decision:784b899f557a471b1b3f82d58d2a4508","@type":["doxa:Decision","prov:Entity"],"recordId":"784b899f557a471b1b3f82d58d2a4508","outcome":"meets_criterion","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:1385ea039e5017d9f68376c0e45e60a7:u_bf11c66e9a0bfa062c6998bf","attribution":"quoted_speaker","speaker":"Indian right-wing activists","speakerStance":"supports","documentStance":"neutral","proposition":"Muslim men use marriage to convert Hindu women.","hypothetical":false,"reviewStatus":"unreviewed","explanation":"Right-wing activists used the 'love jihad' conspiracy theory to characterize Muslim men as inherently predatory in marriage.","modelPassage":["urn:doxa:passage:503354f5f0264b787cfa1bd37e72d0bd693feb10e16070932ad8189f7ae7c778"]},{"@id":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-723620","title":"‘Don't come back, or you will disappear': Uyghur mother pleads with her daughter abroad","author":"Guest Contributor","translator":[],"publishedOn":"2020-12-04","sourceUrl":"https://globalvoices.org/2020/12/04/dont-come-back-or-you-will-disappear-uyghur-mother-pleads-with-her-daughter-abroad/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"e80cd9f438671c97402b4a7c09ddba9ef9c0a797dd5c742d51fdc6a1e49ea788","textSha256":"c8e52c44643ec0f7572fc591d5c510b9a215524d57e8d5dacb314146ec0942ac","archivedRecordSha256":"0ffde206b41bee3d6f3d8dc39c4cefc28021a0807d5dd0c5088a6ee360907a90","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:ac84e1a21d3973a7427f780cc45da249:u_45301e69d7f6927a66a2b9b6","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_45301e69d7f6927a66a2b9b6","status":"accepted","fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249"},{"@id":"urn:doxa:unit:ac84e1a21d3973a7427f780cc45da249:u_8d7849c44e7d3034ce8ebb4d","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_8d7849c44e7d3034ce8ebb4d","status":"accepted","fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249"},{"@id":"urn:doxa:passage:ab439b3cec284436e536e85e6f71080427f37a1ad1b1b72329e109548a6211aa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00001","start":0,"end":84,"exact":"The identity of the author of this story has been kept anonymous for safety reasons."},{"@id":"urn:doxa:passage:8ecee949daa7422d4094fc984d2fc2da8faeadae1ca514a5960ec0c65118c295","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00002","start":0,"end":102,"exact":"Global Voices interviewed Mehbube Abla, a 38-year-old Uyghur from Ghulja, a city in western Xinjiang. "},{"@id":"urn:doxa:passage:7132a0a6a4213301d9155af5f944d6b76df23fe1e4335e1e58b2f73f7ccc3c5b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00002","start":102,"end":166,"exact":"In 2004, she left China to study abroad and has never returned. "},{"@id":"urn:doxa:passage:690a399e8adaf3f4cb4029da735e1779f38b9e7dcfa6cde9c8361462c88d9faa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00002","start":166,"end":240,"exact":"All the members of her family who stayed in Xinjiang have been imprisoned."},{"@id":"urn:doxa:passage:7c6bcb1db8e33a5da8afbb3558a5326bd312eefe925514445ee4fd6ff325218e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00003","start":0,"end":107,"exact":"There are 11 million Uyghurs, a Muslim Turkic nation, living in the western province of Xinjiang in China. "},{"@id":"urn:doxa:passage:225014e328e3eeeed89363d528626684fa55be5d14f5931646a20912e7a20430","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00003","start":107,"end":304,"exact":"Widely portrayed as “motherland separatists” or simply “terrorists” in Chinese mainstream media, this group has been targeted more systematically since Xi Jinping became president of China in 2012."},{"@id":"urn:doxa:passage:80b4dc0dfd76131eb3ddaf7aaf59bfd9eb8fc3d88409a241dca303e5ff79e431","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00004","start":0,"end":172,"exact":"According to Human Rights Watch, the Uyghurs have been deprived of basic human rights, including freedom of religion, of movement, and also of using their native language. "},{"@id":"urn:doxa:passage:eb4a884830a08e59dedfd43fd3939b63a531fbdb97e174905fbebc50508e27a0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00004","start":172,"end":309,"exact":"And according to various testimonies and sources, over 1 million Uyghurs – as well as other Muslim minorities — are in internment camps. "},{"@id":"urn:doxa:passage:ccb551bf3d5264ccb71d2450b980d07f7e615d54ca65ea7ff67ba0cc45fe6e84","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00004","start":309,"end":376,"exact":"Some camp detainees are also sent to Xinjiang’s vast prison system."},{"@id":"urn:doxa:passage:850d10a922f51d2e6a8afa693f13f673cfac778312282f4f8b70c5fa1b24f1d0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00005","start":0,"end":237,"exact":"Given the secrecy surrounding these internment camps, which China describes as “vocational training centers“, the exact number of people currently detained is difficult to ascertain, but hundreds are believed to have died in internment. "},{"@id":"urn:doxa:passage:b4d697fdaf33cde741836fbc307e7f9f95264e9edfb4e3557327b15d50db21a2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00005","start":237,"end":309,"exact":"More detailed information is available in the Xinjiang Victims Database."},{"@id":"urn:doxa:passage:fee0201621d2365ffe4e38b92f2e0dd8b2a38fc395d8f64387ae7924664f8a33","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00006","start":0,"end":79,"exact":"Abla is active on social media, where she advocates for Uyghurs’ human rights. "},{"@id":"urn:doxa:passage:1b2f7914240968d46c14a29af57f19820a3ba4d20d9e9ff1a66bdc8d5e2ebaad","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00006","start":79,"end":166,"exact":"This interview was conducted over the phone in Uyghur and edited for brevity and style."},{"@id":"urn:doxa:passage:579a33dbf331642e6985d61837ead009d9bdd562628b47892555cf8dc2051ff8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00007","start":0,"end":44,"exact":"Global Voices (GV) When did you leave China?"},{"@id":"urn:doxa:passage:90010c0cdc990afc3e6ae088f1dde3be605cf5cfed44667450155d0617c0ad21","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00008","start":0,"end":141,"exact":"> Mehbube Abla (MA): In 2004, I left Xinjiang to study in Germany, and a year later I moved to Austria, where I have been living ever since. "},{"@id":"urn:doxa:passage:7aabd246c0850f34a73043dffd72af0fa40d074cc7deeca9d322994fd08869be","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00008","start":141,"end":269,"exact":"Back then, before getting on the airplane, I looked around me, and told myself this was the last time I was seeing my homeland. "},{"@id":"urn:doxa:passage:b54c0f4da0c54364fc82db26b2da72d2a7e9f2ff63936b7a9a0430239385b15d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00008","start":269,"end":310,"exact":"I knew that I was never going to return. "},{"@id":"urn:doxa:passage:fda970761ba4d7a9cb6d1269f749ba6a748788f4132f76018fc94eab30442a69","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00008","start":310,"end":408,"exact":"As soon as I had settled in Europe, I started to join meetings and protests for the Uyghur cause. "},{"@id":"urn:doxa:passage:38698e76f52189a84fd441e045dd4f80d1ae8c1b7144bdac624775885f98ceba","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00008","start":408,"end":448,"exact":"My two younger sisters also live abroad."},{"@id":"urn:doxa:passage:b07817f05ebdaf7f275055c7e138f0259eb802a01365890397c5bfec839e24b3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00009","start":0,"end":87,"exact":"GV: Did your parents ask you to end your activism because of police harassment at home?"},{"@id":"urn:doxa:passage:483273caa6663af7cb41fb1dc5e7483be994031c71e96ee144bf9b2730527d42","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00010","start":0,"end":127,"exact":"> MA: It is my parents and my younger brother back home who have really paid a price for me using my freedom to condemn China. "},{"@id":"urn:doxa:passage:aaeeb9948811a4b983cc40c80ab67f7604639dabef9ea65d906f2ffe69a3ed2f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00010","start":127,"end":289,"exact":"Since I became an activist, members of the Chinese police force have gone to parents’ home, and taken my father and brother in for questioning a number of times. "},{"@id":"urn:doxa:passage:15b2feb2ef899d88b746d78e8121a1afd9f9c366735651356020dcb53adf9ce5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00010","start":289,"end":344,"exact":"But my family never accused me of giving them trouble. "},{"@id":"urn:doxa:passage:a4676d3ea6745a26372f610b26e3e727afd74200bb3bf07d46fa71b85e604d53","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00010","start":344,"end":408,"exact":"The only thing my mother kept saying was “Don't ever come back! "},{"@id":"urn:doxa:passage:d3d8055b9315fed79ab6adeee70a9f16beb2c40c6cc54ecec8d42e3a54dd3238","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00010","start":408,"end":455,"exact":"If you do that, you will disappear for sure!”. "},{"@id":"urn:doxa:passage:51890e73a7ff3c657b2e820752a86eb90a4d13b94f4b30db8212f549feac15c8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00010","start":455,"end":498,"exact":"So in all these years I've never gone back."},{"@id":"urn:doxa:passage:6b0ad751db811ea14097612a8c2899f6488ab0265dfb0f0f776d0398d6dad423","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00011","start":0,"end":73,"exact":"> But it was no problem for us to talk over the phone, until April 2017. "},{"@id":"urn:doxa:passage:959c9caac24173915f7e16bdb1b874482981c99f36baa8c5d5f888c5575cf24b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00011","start":73,"end":189,"exact":"That's when my brother, Adiljan Ablajan, who was in his early thirties, was taken to a so-called re-education camp. "},{"@id":"urn:doxa:passage:b95cb461bffc2a3bed79ea5cf2edb39957a47e7ff6cf9d5c3f34e825003c8399","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00011","start":189,"end":247,"exact":"In September 2017, my mother Peyzohre Omerjan, was taken. "},{"@id":"urn:doxa:passage:c87a64c4ac6c1ad53b84fdf393208ea5b6f3368635bce14051e92281fd955320","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00011","start":247,"end":315,"exact":"And in October the same year, they took my father Ablajan Hebibulla."},{"@id":"urn:doxa:passage:c33df43930166b7dfe803fae9db004a08890ce9c0bafa928c3014b5aa2cd6fab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00012","start":0,"end":70,"exact":"GV: What has happened to your family since they were detained in 2017?"},{"@id":"urn:doxa:passage:7dafe868e5dd783379e7578eca80497dcc469cbc38fce29dccf3bf24ccc8438f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00013","start":0,"end":84,"exact":"> MA: My mother and brother were held in the same camp at first, close to our home. "},{"@id":"urn:doxa:passage:04ab76acc75793f9a32962d2cfd23cb40aa2c9d9cba7dc72392c105f78b342cf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00013","start":84,"end":151,"exact":"I don't know anything about the location where my father was held. "},{"@id":"urn:doxa:passage:a6e51fbefe515dc03d0cdffecc5e035d512deb095846ed22c83b88a75025a499","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00013","start":151,"end":337,"exact":"In June 2018, my mother and brother were sentenced to 20 years in prison, but in October 2018 I learned that they were both taken back to the camp because the verdict was deemed faulty. "},{"@id":"urn:doxa:passage:c796831ab78149a0deb408031e814926f2d3a63bf804705c23e8178768c22a80","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00013","start":337,"end":494,"exact":"In November 2019, I got the information that my mother had again been sentenced, this time to 19 years in prison, while my brother got a five year sentence. "},{"@id":"urn:doxa:passage:7a7ebd8278a1a67631dfd571e0093290be41a508c48ec73bbf646e2096ef5421","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00013","start":494,"end":584,"exact":"My brother was married and had a one-year-old daughter when he was detained back in 2017. "},{"@id":"urn:doxa:passage:6a07c0509f21798ee3d30e7b73ace7aa7f3c41aac390d91c02aefbbce0ee8a73","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00013","start":584,"end":686,"exact":"I heard that his wife was sent to a camp as well, and I have no idea what happened to their daughter. "},{"@id":"urn:doxa:passage:a3d55ae83577aed05a7748a68d658dfd670cfbc3ec7c1711fe881b4c7da13a41","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00013","start":686,"end":773,"exact":"At the same time I also learned that my father was sentenced to eight years in prison. "},{"@id":"urn:doxa:passage:878bc9bdefc1b1df340c7f566a5811150311f705793a78a550e4f85bb01a2c52","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00013","start":773,"end":872,"exact":"From what I heard, my mother is being held in a women's prison in Ghulja, in the west of Xinjiang. "},{"@id":"urn:doxa:passage:8939b7cde30d68e687882330a48f6263b28c34b3aada22139491d88f691e31b5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00013","start":872,"end":923,"exact":"I don't know where my father and brother are held. "},{"@id":"urn:doxa:passage:428ba513fb1493ca7e954e4ed8ed93d60abdc5f1de8f12ff90badcb2a74c50a0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:ac84e1a21d3973a7427f780cc45da249","blockId":"gv-723620-b00013","start":923,"end":1018,"exact":"But there has been news about Uyghur prisoners from Ghulja being moved to other parts of China."},{"@id":"urn:doxa:decision:714e6e2d2426a52b5f606b39608a7e96","@type":["doxa:Decision","prov:Entity"],"recordId":"714e6e2d2426a52b5f606b39608a7e96","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:ac84e1a21d3973a7427f780cc45da249:u_45301e69d7f6927a66a2b9b6","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:ab439b3cec284436e536e85e6f71080427f37a1ad1b1b72329e109548a6211aa","urn:doxa:passage:8ecee949daa7422d4094fc984d2fc2da8faeadae1ca514a5960ec0c65118c295","urn:doxa:passage:7132a0a6a4213301d9155af5f944d6b76df23fe1e4335e1e58b2f73f7ccc3c5b","urn:doxa:passage:690a399e8adaf3f4cb4029da735e1779f38b9e7dcfa6cde9c8361462c88d9faa","urn:doxa:passage:7c6bcb1db8e33a5da8afbb3558a5326bd312eefe925514445ee4fd6ff325218e","urn:doxa:passage:225014e328e3eeeed89363d528626684fa55be5d14f5931646a20912e7a20430","urn:doxa:passage:80b4dc0dfd76131eb3ddaf7aaf59bfd9eb8fc3d88409a241dca303e5ff79e431","urn:doxa:passage:eb4a884830a08e59dedfd43fd3939b63a531fbdb97e174905fbebc50508e27a0","urn:doxa:passage:ccb551bf3d5264ccb71d2450b980d07f7e615d54ca65ea7ff67ba0cc45fe6e84","urn:doxa:passage:850d10a922f51d2e6a8afa693f13f673cfac778312282f4f8b70c5fa1b24f1d0","urn:doxa:passage:b4d697fdaf33cde741836fbc307e7f9f95264e9edfb4e3557327b15d50db21a2","urn:doxa:passage:fee0201621d2365ffe4e38b92f2e0dd8b2a38fc395d8f64387ae7924664f8a33","urn:doxa:passage:1b2f7914240968d46c14a29af57f19820a3ba4d20d9e9ff1a66b