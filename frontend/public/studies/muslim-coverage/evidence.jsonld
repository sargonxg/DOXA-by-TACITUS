2f84f70","urn:doxa:passage:b867b4144dfac0d6a38b44d3a4d8a137f0d0b346d9a9e660f9f55faeb67f0eab","urn:doxa:passage:02aa3a0c6455bf9daa50422e86c5a51f20594c8f133cd231f13ed8cb540d49c3","urn:doxa:passage:851e407909c58252d4e30cf863402b929a931ee3bcd5036154f926a43c94ab21","urn:doxa:passage:c26b9b3eaa934f01fd9437861e0c81628bf4fe7a207fa2a36df3da73a6f52c6b"]},{"@id":"urn:doxa:decision:385edbce8fbb15cd2770bde401b08d0a","@type":["doxa:Decision","prov:Entity"],"recordId":"385edbce8fbb15cd2770bde401b08d0a","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:80c5cac76de53b70b4f99ff6e5a1adad:u_0d1c486d602cf003693c61ba","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:0ff89507a23c3d542651fac666c8bcb746e41cade186bb174bf6037639635a32","urn:doxa:passage:0766d8dbc17a07ec3b764c3193969f1aa1642c76d12210c9590dfecd9be728e6","urn:doxa:passage:248a227149ebc0b5e6c6406588ad0d79b735fe53500214f03594f3f4415bbb1a","urn:doxa:passage:da2598c61d74a6856a56cd2ce41846a944ad76adddfcac3e4665bdf9b2f84f70","urn:doxa:passage:b867b4144dfac0d6a38b44d3a4d8a137f0d0b346d9a9e660f9f55faeb67f0eab","urn:doxa:passage:02aa3a0c6455bf9daa50422e86c5a51f20594c8f133cd231f13ed8cb540d49c3","urn:doxa:passage:851e407909c58252d4e30cf863402b929a931ee3bcd5036154f926a43c94ab21","urn:doxa:passage:c26b9b3eaa934f01fd9437861e0c81628bf4fe7a207fa2a36df3da73a6f52c6b"]},{"@id":"urn:doxa:decision:4c50b820307074747df35933f3d31106","@type":["doxa:Decision","prov:Entity"],"recordId":"4c50b820307074747df35933f3d31106","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-o