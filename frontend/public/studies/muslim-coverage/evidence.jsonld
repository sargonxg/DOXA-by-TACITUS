10b684118dc6bd32049538046ddfca07d6402d4c3a820fcc99f5","urn:doxa:passage:8101ce839597b1b0d4c7965bdbc181a5f306c44e85fc9c94a9c94e5d67e0c3a5","urn:doxa:passage:75af94e64c452a6485b1a555964879316a6b74e8c9ae33296a897ad05c7ebdeb","urn:doxa:passage:0f176a0912821802021de5c95fa0a7685dac0755b2299873905b494a666fcea8","urn:doxa:passage:4c5b89ddc3367b798d750e3f374b96be3cb1e9da932be951f19568aefbbd4472","urn:doxa:passage:8e8832c25d7316e34baf0e7e5d7bfa1d922a37946a669f2892791ac2cd39ab9c","urn:doxa:passage:47e24a67b8fc4751087809427a8e5f3c928ee3a2c62acd3d1c3789de95882704","urn:doxa:passage:e2bf81dce22092f24170f98795a3ca23e27fbab06353f92f486cb27df195b4b6","urn:doxa:passage:8b7d1f1a08461b8c106e25bfadccc92f4444555ed3b608626291e64b11780f9c","urn:doxa:passage:00a7f1c4e141453dc5d965d7c4a89db99136facc9fba3312540079a774b08423","urn:doxa:passage:e75524f06faa2526913767b59379fdf12a49e2dcad14abcec4a074959ecdf48e","urn:doxa:passage:d3992916f8c91915e13141a619660145c22c10aaad3a6ded42d165bcef70c4d4","urn:doxa:passage:37d115f4e68047e7f269d5b0e6032770a36825c2e4660d62e63eac669f948d2c"]},{"@id":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-847681","title":"Senegal: Where women’s bodies belong to everyone but themselves","author":"Bowel Diop","translator":["Laura"],"publishedOn":"2025-12-27","sourceUrl":"https://globalvoices.org/2025/12/27/senegal-where-womens-bodies-belong-to-everyone-but-themselves/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"733af8b4665cd6b515e2b631b0f28db83d7eff974275e7996dff3690cb2de4a9","textSha256":"ea9f50afae682e01a92a08fe82243c604c861c012b1ed9e46699d6bfa573dcf0","archivedRecordSha256":"c9a62f90996b03451cca05b17eedadfbeaeb138a6971bf8dc761b81222027b46","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:e54438a8b4a9e8826a3d1a82f568264a:u_721b8257441844e21e00464b","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_721b8257441844e21e00464b","status":"accepted","fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a"},{"@id":"urn:doxa:unit:e54438a8b4a9e8826a3d1a82f568264a:u_cd78e222235e47e2e01c58cb","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_cd78e222235e47e2e01c58cb","status":"accepted","fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a"},{"@id":"urn:doxa:passage:cd32cf046b4600285c92f699656cd66c5e08972041b65a6ab7bd24baaf07cd2c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00018","start":0,"end":97,"exact":"The real issue is patriarchy, which continues to dictate what women should do with their bodies. "},{"@id":"urn:doxa:passage:252ad71e72265829d28ee8e2bc9ac800ef99e09ae0a6850661d8c2f641d298b8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00018","start":97,"end":285,"exact":"The power of this ideology is such that some women, including educated women, defend it, proving to what extent patriarchal norms are internalized, even by those who should dismantle them."},{"@id":"urn:doxa:passage:5fb6973c57110b13182086275ff7268b318e0e543bbb804d76a08316aed0d6dc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00019","start":0,"end":404,"exact":"In Africa, the arguments against abortion are strikingly similar and directly associated with three main areas: religion, traditions, and African values.” They revolve around the prohibition of killing found in three monotheistic religions, around the idea that abortion is an imported practice, foreign to local culture, which threatens the traditional moral values that consider motherhood a blessing. "},{"@id":"urn:doxa:passage:5e7910ac1a7932b3927967a9eaf0035b8ac8501170b804497c1423e410fb587a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00019","start":404,"end":521,"exact":"Another common argument is that an innocent, defenceless fetus should not pay for the circumstances of the pregnancy."},{"@id":"urn:doxa:passage:cd003c24f0c5933affdec4bc1aab68d697c5b76ac91695ebd93a28aebb8d41e1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00020","start":0,"end":171,"exact":"However, these arguments are primarily based on emotions, taboos, or a form of conservatism, and rarely on science, fundamental rights, or the reality of sexual violence. "},{"@id":"urn:doxa:passage:a32299d9a7dfaab024631559688579fbc3e8cff4ca59da93c1439ba7c55c5469","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00020","start":171,"end":373,"exact":"In Senegal, JGEN, an NGO committed to combating gender-based violence, has stepped up its calls for the law to stop criminalizing the victims of rape and incest, thus complying with the Maputo Protocol."},{"@id":"urn:doxa:passage:71fee35f4146ca0725532a36b9d607f51cbc20ab8e4f96dee294b35da0da1dc7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00021","start":0,"end":59,"exact":"As a woman, I support the unconditional right to abortion. "},{"@id":"urn:doxa:passage:24b24f4ed525dc82b4e854b1abae4c2e8d487c8fc54ed502992a461e9d814ee0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00021","start":59,"end":216,"exact":"All women should be able to freely decide what is best for their bodies, their lives, their health, and their future, especially in cases of rape or incest. "},{"@id":"urn:doxa:passage:eb7f3f2042b2d87e1d673088c6e5290cb3df8f2dde5e118bd4b013a231403730","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00021","start":216,"end":258,"exact":"Choice should be a right and not a luxury."},{"@id":"urn:doxa:decision:4fe6927e891d3576a8d8baeeef44c369","@type":["doxa:Decision","prov:Entity"],"recordId":"4fe6927e891d3576a8d8baeeef44c369","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:e54438a8b4a9e8826a3d1a82f568264a:u_721b8257441844e21e00464b","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cd32cf046b4600285c92f699656cd66c5e08972041b65a6ab7bd24baaf07cd2c","urn:doxa:passage:252ad71e72265829d28ee8e2bc9ac800ef99e09ae0a6850661d8c2f641d298b8","urn:doxa:passage:5fb6973c57110b13182086275ff7268b318e0e543bbb804d76a08316aed0d6dc","urn:doxa:passage:5e7910ac1a7932b3927967a9eaf0035b8ac8501170b804497c1423e410fb587a","urn:doxa:passage:cd003c24f0c5933affdec4bc1aab68d697c5b76ac91695ebd93a28aebb8d41e1","urn:doxa:passage:a32299d9a7dfaab024631559688579fbc3e8cff4ca59da93c1439ba7c55c5469","urn:doxa:passage:71fee35f4146ca0725532a36b9d607f51cbc20ab8e4f96dee294b35da0da1dc7","urn:doxa:passage:24b24f4ed525dc82b4e854b1abae4c2e8d487c8fc54ed502992a461e9d814ee0","urn:doxa:passage:eb7f3f2042b2d87e1d673088c6e5290cb3df8f2dde5e118bd4b013a231403730"]},{"@id":"urn:doxa:decision:e3278e8da54f9298a0a6f709a5e7c503","@type":["doxa:Decision","prov:Entity"],"recordId":"e3278e8da54f9298a0a6f709a5e7c503","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:e54438a8b4a9e8826a3d1a82f568264a:u_721b8257441844e21e00464b","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cd32cf046b4600285c92f699656cd66c5e08972041b65a6ab7bd24baaf07cd2c","urn:doxa:passage:252ad71e72265829d28ee8e2bc9ac800ef99e09ae0a6850661d8c2f641d298b8","urn:doxa:passage:5fb6973c57110b13182086275ff7268b318e0e543bbb804d76a08316aed0d6dc","urn:doxa:passage:5e7910ac1a7932b3927967a9eaf0035b8ac8501170b804497c1423e410fb587a","urn:doxa:passage:cd003c24f0c5933affdec4bc1aab68d697c5b76ac91695ebd93a28aebb8d41e1","urn:doxa:passage:a32299d9a7dfaab024631559688579fbc3e8cff4ca59da93c1439ba7c55c5469","urn:doxa:passage:71fee35f4146ca0725532a36b9d607f51cbc20ab8e4f96dee294b35da0da1dc7","urn:doxa:passage:24b24f4ed525dc82b4e854b1abae4c2e8d487c8fc54ed502992a461e9d814ee0","urn:doxa:passage:eb7f3f2042b2d87e1d673088c6e5290cb3df8f2dde5e118bd4b013a231403730"]},{"@id":"urn:doxa:decision:38c22f35ff57da2faa46e07fc0d2f02a","@type":["doxa:Decision","prov:Entity"],"recordId":"38c22f35ff57da2faa46e07fc0d2f02a","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:e54438a8b4a9e8826a3d1a82f568264a:u_721b8257441844e21e00464b","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cd32cf046b4600285c92f699656cd66c5e08972041b65a6ab7bd24baaf07cd2c","urn:doxa:passage:252ad71e72265829d28ee8e2bc9ac800ef99e09ae0a6850661d8c2f641d298b8","urn:doxa:passage:5fb6973c57110b13182086275ff7268b318e0e543bbb804d76a08316aed0d6dc","urn:doxa:passage:5e7910ac1a7932b3927967a9eaf0035b8ac8501170b804497c1423e410fb587a","urn:doxa:passage:cd003c24f0c5933affdec4bc1aab68d697c5b76ac91695ebd