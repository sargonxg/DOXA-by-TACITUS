3c11b19d7767","status":"accepted","fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3"},{"@id":"urn:doxa:unit:7027d116ba64f8e5af0a1196e809a6f3:u_afa7cab14005ac5e1a4f487d","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_afa7cab14005ac5e1a4f487d","status":"accepted","fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3"},{"@id":"urn:doxa:passage:9fd7639760bdb9c05130a29d2f78888fcecf3990d732b5c0c1eee2ff2bc43a4f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00001","start":0,"end":87,"exact":"This story is part of Undertones, Global Voices’ Civic Media Observatory‘s newsletter. "},{"@id":"urn:doxa:passage:c2f35f86c762691c96101b4a1e177dfc71eb2462c223fcd8c0312819b019f26a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00001","start":87,"end":111,"exact":"Subscribe to Undertones."},{"@id":"urn:doxa:passage:b8e7b4d9bfcbe1817a4d710c74f5191dcc1be10e9ba591c677371775620068cc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00002","start":0,"end":234,"exact":"The admiration of populist leaders has become a defining trait of this movement, where these figures are seen not only as personifications of national or cultural identity but also as messianic symbols promising salvation and renewal."},{"@id":"urn:doxa:passage:83ba058d6491a6b47d53479c3ebdb9f816d01d4a39d0a31bf01e38cc3775a2d5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00003","start":0,"end":258,"exact":"As Feeza Vasudeva writes in “Political Deification and Religious Populism in Modi’s India,” an article published in the journal “Populism,” leaders in countries like Turkey, Hungary, Brazil, and the US have used religion to strengthen their political image. "},{"@id":"urn:doxa:passage:dc0bf5e802849c17ca57fb8dc0022fe16245f14f4dbaf5db66eb4804dbd48208","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00003","start":258,"end":397,"exact":"They present themselves as defenders of faith-based values against secularism and external influences and even as quasi-religious figures. "},{"@id":"urn:doxa:passage:33a39d01873c2ff00ebb566336595aea39dbf68b5068d0d0594d7ff08eb957f1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00003","start":397,"end":442,"exact":"So has India’s prime minister, Narendra Modi."},{"@id":"urn:doxa:passage:4274312d8499a3d208e996b13e66cbb3f01fe7d23a0e51b449f349f0555fa26c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00004","start":0,"end":169,"exact":"The agenda of India’s ruling party, the Bharatiya Janata Party (BJP), is defined by Hindutva, a political ideology emphasizing Hindu religious and cultural nationalism. "},{"@id":"urn:doxa:passage:17b3f311666a9d4e199ab50ecb553c115f8cfce195d7f478390667df2a1c8453","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00004","start":169,"end":308,"exact":"Since coming to power in 2014, the BJP has significantly emphasized policies and initiatives that resonate with its core Hindu voter base. "},{"@id":"urn:doxa:passage:5ebc3541469adc945067109cdeb62640cdd5d3831637025f5410685095bedbbd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00004","start":308,"end":604,"exact":"Vasudeva explains that the “use of religious iconography, coupled with modern media technologies, has enabled Modi to embody a form of authority that transcends the conventional boundaries of political leadership, thus positioning him as the guardian of the nation’s spiritual and moral essence.”"},{"@id":"urn:doxa:passage:9d01ada8e2ce07368cddad5bcc4def61cdeb6675b45a7cd28493c34594561e68","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00005","start":0,"end":325,"exact":"The BJP’s efforts to “guard” Hindu religious and cultural nationalism have been reported to fuel hate speech against Muslims and other minority groups, especially under the “Bulldozer Justice” initiative led by the leader of the most populous state, Uttar Pradesh, Ajay Singh Bisht, a Hindu monk who goes by Yogi Adityanath. "},{"@id":"urn:doxa:passage:5e234240a73fa712115e59bd6623ec289ee887303212d82139b01568816779c6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00005","start":325,"end":522,"exact":"Under his purview, the authorities have deployed bulldozers to demolish the houses of accused individuals, mainly Muslims, even before the case or dispute is resolved through the judicial process. "},{"@id":"urn:doxa:passage:cf4837328d3c0376ff364ef9ff986a4418fd46b049110cb775a8da80935d64eb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00005","start":522,"end":702,"exact":"Amnesty International has deemed the de facto policy of punitively demolishing Muslim properties “ forced eviction and collective and arbitrary punishment under international law.”"},{"@id":"urn:doxa:passage:fc2e802c5167e44d693b2b8a1926eff6cd1d5c423340ed51b836ed53e1e899b8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00006","start":0,"end":94,"exact":"Click here to read some of the BJP nationalist narratives we have covered in the past in India"},{"@id":"urn:doxa:passage:e9feb059b303d730fb0f1dbca1f5ff7c28fd9554153007bbdd310e9d98faf68a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00007","start":0,"end":416,"exact":"One of the policies helping Prime Minister Narendra Modi to secure his reputation as a guardian of the nation's religious values in this battle to equate Indianness with Hinduism is the Namami Gange Programme, a project launched in June 2014 to conserve and rejuvenate the River Ganges, which is part of the second-largest river system on Earth by water discharge, and has immense religious significance in Hinduism."},{"@id":"urn:doxa:passage:237ad8e9427e1eb8b69bea5921154d6be69fdbc77e1ae8ad04c422efd32efd94","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00008","start":0,"end":60,"exact":"Narrative: The BJP is the only one protecting India's rivers"},{"@id":"urn:doxa:passage:35e8c99ca8accf3d7d60a92a986362a04d6ef8426d5cd1a5c6e88e19da6270f5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00009","start":0,"end":228,"exact":"Under this narrative frame, the BJP politicians and supporters promote the belief that they are the only party working on and advocating for the protection of India's rivers, ensuring Hindus can maintain their religious rituals."},{"@id":"urn:doxa:passage:0f87114542383082c2a72bf6585180fc0758c83556a454ecbea554e44465067b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00010","start":0,"end":121,"exact":"Between late 2024 and early 2025, two significant religious festivals reignited concerns over pollution in Indian rivers."},{"@id":"urn:doxa:passage:06b2f19f0ea4717b39874129787aa347e7dbe97e29f6b70d372d4fabd23a25b3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00011","start":0,"end":317,"exact":"During the four-day Chhath Puja in November 2024 in Delhi, safety concerns arose as devotees bathed in the Yamuna River, which was covered in toxic foam — a development later linked by Arvind Kejriwal, the leader of the Aam Aadmi Party (AAP) and the former Chief Minister of Delhi, to the BJP-led Haryana government. "},{"@id":"urn:doxa:passage:aaf01be91e8fa48c32c0d4ffb619c28a7ec963f3899bbe197455ae76b2146479","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00011","start":317,"end":549,"exact":"Kejriwal accused the Haryana government of deliberately poisoning the Yamuna River's water entering Delhi, prompting the Haryana government to lodge a criminal complaint and the Election Commission to demand proof of the allegation."},{"@id":"urn:doxa:passage:1c4a0ef04ae002ea81470fa08f1b42a48513d778b55196b09be12aad3ba88cf1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:7027d116ba64f8e5af0a1196e809a6f3","blockId":"gv-833294-b00012","start":0,"end":289,"exact":"A few months later, in January 2025, during the Maha Kumbh Mela celebrations — a pilgrimage and Hindu festival held in Uttar Pradesh at that time — the Central Pollution Control Board (CPCB) of the Indian government reported that the Ganges and Yamuna rivers had elevated coliform levels. "},{"@id":"urn:doxa:decision:12f838d26f40df08168e7f0a279cd7b5","@type":["doxa:Decision","prov:Entity"],"recordId":"12f838d26f40df08168e7f0a279cd7b5","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:7027d116ba64f8e5af0a1196e809a6f3:u_5413fbf5a53a3c11b19d7767","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:p