5a9c7eb322f6888d70b5e5bfee0503799fd3d72d06fd09d1225ac853789cb","urn:doxa:passage:055aecd3871cb245ce784f9a031978731485e373411d6be7bc99c0d50cb793f5","urn:doxa:passage:1fb444a27edbab236171317a7f30faae2019a2b7141422b0669e9918b876891b","urn:doxa:passage:228f6bafe7dace53654f9e79f3a8b068d51d79d9e9acd375841f36fd0841fe5f","urn:doxa:passage:68d334d23a40c8e5c002c7aed68b8b8ee2d2193faa889719eb0690321e8ecd6b","urn:doxa:passage:bc94c061ec3755d0a36e93668784f2bee79f8765b68e883252c6c56d049059df","urn:doxa:passage:0884470ea8588746fcfc40f842fd9da0db36a7fbc770f3616e56f53adc7fbe08","urn:doxa:passage:8c7f615e1c267e42ace0e515bc439875222535a32ba761138e332793fee6155b","urn:doxa:passage:bef9f95366d82b33a5ceff12723c229fe57ed9f95a029eb97750b3ea0859bf83","urn:doxa:passage:b5df643aeb304daa5ea43aa1153580f171cab40836b4c518ac4f0e4684c030ea","urn:doxa:passage:5cc78d8bd4b82629c4bb5602c0a2372e58ee252a0f03fe221631b5599214f58b","urn:doxa:passage:c7c561f934cd5c6c2fc8a4ae08061a79a0836ec6e27d45fc4ccdb3de4769c1b1","urn:doxa:passage:62241e2df2b82b79e52fdf82754bb5a1d7e4be2b94faa628596e0d2f0dcbf8a9","urn:doxa:passage:d7a69eaec5790e04b1171a3215f43582a07d4c4d4b83c170d46dbaf8c3e62b64","urn:doxa:passage:a8cb1700055d3db1ee99c1f23414551ffa504d6df50d01e4a3f75c362b7c05fe","urn:doxa:passage:89d765f96b8f8e40f80e09855535ebc2e5d5e17c681c8739559b440c23130d4e","urn:doxa:passage:83281cde2d712d4d077648a3f6ac3c49d9ecf6c54b8d3d4d53c936308f415e1a","urn:doxa:passage:b7eacaa24f3ea85de12d4674aa7ae486c688f1e2b04992aea5e0999056304069","urn:doxa:passage:a59fb3a1b3729d7df994e1fc742f96ed2bbbb8cfc7babca9d45a3df33442bf24","urn:doxa:passage:1781f26ccbb1f813ffd92eef8049c963c7d4fdc3dede5f9a3aa73f397dbdce0d","urn:doxa:passage:af65b8b20bc9c025e71ad8e11b19c21457acb1d5e8ec35614cc157a09e346c0a","urn:doxa:passage:85315ca2da339b5083436ae4401d96b97e82e75e4b29d1eb7afda6e569326d10","urn:doxa:passage:83efeb33a09e753347972ddfe0dc4b0cf19fee001e43c606eff11ebc0efc32b3","urn:doxa:passage:cec8e98513c8cae6d51c1f990f9b7639c9cadcb374c591093b07f3f336da99c8","urn:doxa:passage:96f00f948762242f4c9635895c8147df66a2fb5f9cea6af9b9fdf4afb96f6ad4","urn:doxa:passage:537001ef13b76ce3a296c6349ebd5062b4a40e473169b664ec1e4fc71693cdeb"]},{"@id":"urn:doxa:passage:b8ca6a0e1a382cb7979243d1d94c1d9a9cc1807896541b1affe1a10f1b3a6417","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00001","start":0,"end":40,"exact":"This article is written by Saman Daoud. "},{"@id":"urn:doxa:passage:d35e76bdefac4084c2bab57face7786555b2192b533cb9a221052c1906427c9d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00001","start":40,"end":179,"exact":"It is part of a series examining free expression and information access in civic spaces across six language communities in the MENA region."},{"@id":"urn:doxa:passage:e6b49c56c21877a95e11984c80cc369d665718aa0db1d8e6048ca6263368d9f2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00002","start":0,"end":268,"exact":"In the vibrant landscape of the Middle East challenges, addressing Assyrians’ freedom of expression necessitates examining the ongoing political marginalization they endure in their Indigenous homeland that spans contemporary Iraq, and some areas in Turkey and Syria. "},{"@id":"urn:doxa:passage:4b86b47f6d842eaa5b928191a9474930323c1db69588f9919e68cba029c4bbf3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00002","start":268,"end":386,"exact":"Their story is a reflection of the struggles faced by minority communities in a region marked by political turbulence."},{"@id":"urn:doxa:passage:696b31ae2b37f6f4e056a3aafd2ed271f786501a411e6e21e85cc39ae55f9937","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00003","start":0,"end":129,"exact":"As the world marked the Assyrian New Year, reaching the remarkable year 6773, celebrations echoed across Iraq, Syria and beyond. "},{"@id":"urn:doxa:passage:c2273a912ed10dc219d88dc4e6b0a5067c2b3ace7c46f383eea5cd6e4de95e5c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00003","start":129,"end":301,"exact":"However, beneath the surface, a profound sadness gripped Assyrian minorities who stayed in their ancestral homelands, from Duhok, and Erbil to Nineveh, and Baghdad in Iraq."},{"@id":"urn:doxa:passage:850e5e7650459727e678aedde1ed65f132c79a0b9bc959d71cafa8d7ac42b14b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00004","start":0,"end":163,"exact":"Over the past two decades, ongoing oppression, ethnic and sectarian conflicts and political unrest have sharply reduced the Assyrian community in the Middle East. "},{"@id":"urn:doxa:passage:a283528c7c4358e7970ee565a4594892ad8084ca1ca78c02c93386cdc4a28d43","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00004","start":163,"end":309,"exact":"Many have fled to Europe, the US, and Australia, endangering the Assyrian language, with its 3000-year history in its native Middle Eastern home. "},{"@id":"urn:doxa:passage:fcbf0a5790839e23a2a84c034fe8b2c181b09798a882028e6c34858ff073e8ab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00004","start":309,"end":604,"exact":"The Assyrian population in Iraq has declined significantly, plummeting from an estimated 800,000 to 1.4 million in the 1990s to less than 142,000 today, as reported by the Shalma Foundation, an organization dedicated to documenting the populations of the Assyrian Chaldean Syriac people in Iraq."},{"@id":"urn:doxa:passage:ac093745c1ca36baf85e0a13beddaaae1eb5199afd3b4fc05877499f763b181b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00005","start":0,"end":199,"exact":"This decline can be attributed to the region’s shifting political landscape, particularly in the aftermath of the US invasion of Iraq, which has cast a long shadow over the Iraqi people to this day. "},{"@id":"urn:doxa:passage:d720e4dcc7361aa854700f156cb487e24ddbdcadfed999d92dd9f786a5901bec","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00005","start":199,"end":363,"exact":"Successive Iraqi governments have failed to protect Assyrian communities from terrorist groups like the Islamic State (ISIS) and the Kurdistan Workers Party (PKK). "},{"@id":"urn:doxa:passage:dfef3fec06a0df00e5a01591d62603b16e573fe0268b9f48486106a78c69275b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00005","start":363,"end":541,"exact":"The latter has aggressively sought control over Assyrian ancestral lands in Nineveh, even using Assyrians as human shields during confrontations along the Iraqi–Turkish borders. "},{"@id":"urn:doxa:passage:535a5da80fa268f0eaba55692b59f5c70309eb1155ac8f593340e677b7e03817","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00005","start":541,"end":604,"exact":"This coercive tactic aims to intimidate Assyrians into leaving."},{"@id":"urn:doxa:passage:269d029cadb641cbe61e5c91aa4629fadb869a73e27058e9f202b3e9df2c7e06","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00006","start":0,"end":165,"exact":"These challenges have reshaped the Assyrians’ way of life, affecting their human rights and, notably, their freedom to express their identity, culture, and language."},{"@id":"urn:doxa:passage:74ffa4103871a29078cab0b9a7062482dad14c9bf73af98179d1cd727d3b4a43","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00007","start":0,"end":77,"exact":"The struggle of the Assyrians to express their identity over the last century"},{"@id":"urn:doxa:passage:91203de1dd96e2c9773adef7d8652b7b963f130a1e888d6c93871c0e4bcc698a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00008","start":0,"end":148,"exact":"In the Middle East’s diversity, the Assyrians emerge as a distinctive Indigenous minority with unique ethnic, religious, and linguistic identities. "},{"@id":"urn:doxa:passage:668b7901206170af3ce791650b79f4dfe9c26f50d7b96f73e9f605a4aa61bbd8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00008","start":148,"end":258,"exact":"They trace their ancestry back to the ancient Assyrian civilization that flourished in Mesopotamia, now Iraq. "},{"@id":"urn:doxa:passage:000fb25c0dbbaa1dd9bf8c47ba55ea9a6033afc26cb3da31c2f0d8cdff2b9ce9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00008","start":258,"end":395,"exact":"While predominantly Christian, the Assyrians also include smaller Muslim and Yazidi minorities who identify with their Assyrian heritage."},{"@id":"urn:doxa:passage:1dffc833ed91f775d79ede999cb4762fba407721c9eac6432f7cea31a9ffc5dd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00009","start":0,"end":88,"exact":"The Assyrians have endured marginalization since the collapse of their empire in 609 BC."},{"@id":"urn:doxa:passage:2bc7b3fcbe1bea20659c4c281d05f71726f2b575d6177e068fe39aaa01bedd18","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00010","start":0,"end":190,"exact":"In the dawn of the 20th century, along with other regional ethnic groups, Assyrians suffered under Ottoman rule, marked by Turkification policies that aimed at imposing a singular identity. "},{"@id":"urn:doxa:passage:c68e0b7d1365c016db4764b2c433d1a8245243e69525ba8b7897bd9732830ff7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00010","start":190,"end":392,"exact":"This era witnessed Ottoman genocides against Assyrians, Armenians, Yazidis, and others, forcing Assyrians to flee and hide their cultural, religious, and linguistic identity out of fear for their lives."},{"@id":"urn:doxa:passage:295f00d617bd9bee8036cecffbf3f04fce9150282c535296b45443f5fe361ef7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00011","start":0,"end":142,"exact":"Following World War I and the fall of the Ottoman Empire, Assyrian oppression continued as the Kingdom of Iraq emerged under British mandate. "},{"@id":"urn:doxa:passage:32979b4a0fe82a11e69f56e3cb0b81bfbb698944f1a82dda6019c8decfacb019","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00011","start":142,"end":335,"exact":"Assyrians had sought an independent entity in exchange for their army service, but Britain's failure to uphold its promises led to hostility and oppression by the newly formed Iraqi government."},{"@id":"urn:doxa:passage:cbbaefa2b9aeb37ffc5b5327f72e789e45e4d1e6b33141cd4c1eead8472c4e6b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00012","start":0,"end":128,"exact":"In 1933, the Iraqi army brutally targeted over 60 Assyrian villages in the infamous Simele massacre, claiming over 3,000 lives. "},{"@id":"urn:doxa:passage:a4f9967de8a1877231940fcb27d65a576be5a3a7a08d661cdfa8cfbf52c2ba71","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0e9f9553a6bf8d137818af3d0c4dca51","blockId":"gv-797677-b00012","start":128,"end":232,"exact":"This massacre posed a real threat to the Assyrian presence in the region, prompting another mass exodus."},{"@id":"urn:doxa:decision:33d8ee4ed54c05225e78e7998f7e420b","@type":["doxa:Decision","prov:Entity"],"recordId":"33d8ee4ed54c05225e78e7998f7e420b","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:0e9f9553a6bf8d137818af3d0c4dca51:u_6a0255c3f2cc790b3e85cc7d","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:b8ca6a0e1a382cb7979243d1d94c1d9a9cc1807896541b1affe1a10f1b3a6417","urn:doxa:passage:d35e76bdefac4084c2bab57face7786555b2192b533cb9a221052c1906427c9d","urn:doxa:passage:e6b49c56c21877a95e11984c80cc369d665718aa0db1d8e6048ca6263368d9f2","urn:doxa:passage:4b86b47f6d842eaa5b928191a9474930323c1db69588f9919e68cba029c4bbf3","urn:doxa:passage:696b31ae2b37f6f4e056a3aafd2ed271f786501a411e6e21e85cc39ae55f9937","urn:doxa:passage:c2273a912ed10dc219d88dc4e6b0a5067c2b3ace7c46f383eea5cd6e4de95e5c","urn:doxa:passage:850e5e7650459727e678aedde1ed65f132c79a0b9bc959d71cafa8d7ac42b14b","urn:doxa:passage:a283528c7c4358e7970ee565a4594892ad8084ca1ca78c02c93386cdc4a28d43","urn:doxa:passage:fcbf0a5790839e23a2a84c034fe8b2c181b09798a882028e6c34858ff073e8ab","urn:doxa:passage:ac093745c1ca36baf85e0a13beddaaae1eb5199afd3b4fc05877499f763b181b","urn:doxa:passage:d720e4dcc7361aa854700f156cb487e24ddbdcadfed999d92dd9f786a5901bec","urn:doxa:passage:dfef3fec06a0df00e5a01591d62603b16e573fe0268b9f48486106a78c69