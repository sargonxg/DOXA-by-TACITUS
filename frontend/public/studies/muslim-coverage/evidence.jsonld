57983679da88b3a54c42edf563444c60481a216dce10c3ad3cf447e14e98","urn:doxa:passage:761e75afe70446070227e3bfa65dbb35552c27b9fc807a84a3868c4f0e8696e5"]},{"@id":"urn:doxa:decision:5cb7e93db90a6e0366bfe61c1121a1b6","@type":["doxa:Decision","prov:Entity"],"recordId":"5cb7e93db90a6e0366bfe61c1121a1b6","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:058a98317bd0948c5009874d3bb78176:u_7323e8350b5fce225e5fca14","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:edfd9a3ed5a80bfe3470cd65ca1953de7d1dcdb6a37d8a47e55fba2cb90d78d7","urn:doxa:passage:04eabc11382785e87d5cf2740abafd3a70d050fad63a19a35e458929f97b23f8","urn:doxa:passage:05569c30b76abd1f239787fe4325d3b5c6e286e1234a8a0417cbc3883e4657c6","urn:doxa:passage:b3e226f3a4f5ceb57d2d91a44bdb74bbf9894793de7ab92d3319b3041b10f6df","urn:doxa:passage:df2b43809d6c755891e9b7ef8b3ddd115133478b4e3a01cb9ea8f647312117fa","urn:doxa:passage:5cde74edf98f10952e29768a575ee25d8595243ada17024ca388aa87e9f92681","urn:doxa:passage:d10e623bc538ff6f22472a3a705a2ffc76460e51ff1b0c82c00a0eba9506fea2","urn:doxa:passage:94f6a22c043cde00a81684c0d3c79c3d5d9197744c83e8e40a0f1712bea17f2b","urn:doxa:passage:faf1517072e2aac0cc98add1f3c699ae98123f76201c2d6327bdab87a81b5e5f","urn:doxa:passage:4af0589f2c99648714b076f14a08b3ee2c38e31ae559f1735dc0cfe9a1826aa4","urn:doxa:passage:5d649523f80951b0eda4dfb77b3d8f2a6c95fe30974664b8735b3dd35979b4d1","urn:doxa:passage:b265e13e89309d2cfc01d4d1adfb88c4fc2aa3843827300e449ec34f20b9a38e","urn:doxa:passage:b87cb213747065e46411bdc0fb474dd932426204b9a844defe5c9a612be47f94","urn:doxa:passage:f693df53ad700445ad1e8671567c1b685e592d1c992def994c384b56fcfca58c","urn:doxa:passage:6a3e20376e3bfd3c5c0de3de9a3236b496bfa30c5baba2b920c22aec65cbffbc","urn:doxa:passage:738af12bd6daa68e4e2cec7cfe8a38ea67ac89e92aa5a6dfbf7d2093b57bb6f7","urn:doxa:passage:e4e62120ad6df33b56fc0e40d4516678b3e8afba760b0dc5681154843188346b","urn:doxa:passage:e30d5072ea529f09c61ed6cf44b807cf723ca576637ccbc0cc1fea64c451b6f8","urn:doxa:passage:d9defbb484b3f68c671642d8e4396c82f5570f3c5326e06fad6bab2942d89277","urn:doxa:passage:3bc227a857608900bad6fc950d8cebd875af998db322d541db98fa9bc60a68c8","urn:doxa:passage:846d3c3c3cd46813ff499ebe010eaec1e1944bd327683118d8f6b475a688beef","urn:doxa:passage:6bf946d9c0b57302eb403d2230424d9194021d70ef01e6c795aad6b052dae5c4","urn:doxa:passage:2bbe4daead4fdddb7d0770445821f8c436352ac08b56407a90fe78b151bdb0ff","urn:doxa:passage:4304b2470adb450bab54f3ce7ec4c2efc7311ff9f5f5467e51fe76fa8b054883","urn:doxa:passage:3adb9be9fbf6f9ae217c0eac3738a65bd5a374959be6ae8d55cc281bfc1f7a4e","urn:doxa:passage:fb0857983679da88b3a54c42edf563444c60481a216dce10c3ad3cf447e14e98","urn:doxa:passage:761e75afe70446070227e3bfa65dbb35552c27b9fc807a84a3868c4f0e8696e5"]},{"@id":"urn:doxa:passage:75b253354a508cb29f5bad8f23d9646137fcbc97e428e17089551420bdf5df48","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00005","start":892,"end":980,"exact":"However, there is little doubt that pious voters are seriously disaffected with the AKP."},{"@id":"urn:doxa:passage:032bb384a50c1bb5a60a021680deddce6eef6ac39a813632e79ec7099ccc3c8b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00006","start":0,"end":230,"exact":"It took losing the March local elections for Erdoğan to get serious about cutting trade ties with the Jewish state, although speculation is rife that goods are still being shipped from Turkey to Israel, by way of third countries. "},{"@id":"urn:doxa:passage:55100a1120029e6fe16ed6f0961627fff2d1c263b4cedf17631e56af623ba451","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00006","start":230,"end":440,"exact":"To regain credibility with constituents, on April 9, Ankara announced trade restrictions against Israel, covering 54 categories of products, including iron, steel, cement, aluminum, and construction equipment. "},{"@id":"urn:doxa:passage:a0136adf27008087e5466fcc63badfbf961d3056c3cfbdf6c4526347cd9a4512","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00006","start":440,"end":615,"exact":"On May 2, Erdoğan announced the total suspension of trade with Israel “until the Israeli government allows an uninterrupted and sufficient flow of humanitarian aid into Gaza.”"},{"@id":"urn:doxa:passage:9d87d01c79da0183c1560a23608993e09f679204bc844e0898b4fe0eb3485ce9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00007","start":0,"end":172,"exact":"These moves by Erdoğan signal two things: that Erdoğan and his cronies have been motivated more by greed than principle, and that his U-turn to punish Israel may backfire. "},{"@id":"urn:doxa:passage:c488131bbb0d4309bee0b29ecf3d99a6da4a11e6f25534de02d4a8d8eab98337","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00007","start":172,"end":286,"exact":"The Israeli government likely has recourse to take Turkey to court for breaking existing contractual obligations. "},{"@id":"urn:doxa:passage:5808f124ee2479e34e8e7cb741829b8d705cb4054f5d467293161c585591f8ad","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00007","start":286,"end":671,"exact":"Already, U.S. members of Congress got the ball rolling by signing and sending a bipartisan letter to the Biden administration, calling upon the White House to “invoke antiboycott provisions under the Export Control Reform Act.” If the Turkish trade restrictions are enforced, then many Turkish firms engaged in business with Israel are likely to be hit with significant revenue losses."},{"@id":"urn:doxa:passage:1c78f0294ffd6b2d65cb5b120f165d2b3d82c3087acf141ee7a8aa81f6a3262a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00008","start":0,"end":121,"exact":"This whole saga furthers the damage that Erdoğan’s greed-fueled hypocrisy is doing to Turkey’s international reputation. "},{"@id":"urn:doxa:passage:8084815bd2fd2614f23101ae533b1a856e7e5b94f95c35f93338659b9914ef2f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00008","start":121,"end":176,"exact":"Turkey’s European allies are watching in bewilderment. "},{"@id":"urn:doxa:passage:a42f391b17fd765d9930bb6913e8218549f2362b4732c83e2999c113e503cbbf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00008","start":176,"end":414,"exact":"In two recent yet separate meetings, one with the German Chancellor Olaf Scholz (November 2023) and Greek Prime Minister Kyriakos Mitsotakis (May 2024), Erdoğan publicly admonished two allies that consider Hamas a terrorist organization. "},{"@id":"urn:doxa:passage:714ae57e73923f313d01d71fab5f18ba7016766cf3904134e6962d58d78db06d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00008","start":414,"end":587,"exact":"During a live press conference, Erdogan rebuked Germany’s support of Israel, remarking, “We [Turkey] do not owe Israel anything” — a clear reference to Germany’s Nazi past. "},{"@id":"urn:doxa:passage:f42077470042f969af1b9c0b4e9506695893c56710cba04f2ef3d6d35283559f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00008","start":587,"end":741,"exact":"Given Ankara’s dealings with Israel, public displays that feign moral outrage towards other states fall upon deaf ears, and nobody takes Turkey seriously."},{"@id":"urn:doxa:passage:53eefdd6f4d9e2283675d9abf7fd0df18fe5870338da5c6c09868157b8d1dc9c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00009","start":0,"end":174,"exact":"While the decision to champion Hamas may be a personal choice for Erdoğan, broadly representative of the views of Muslims around the world, he overlooks one important point. "},{"@id":"urn:doxa:passage:5fea1b34c805393dfa7e42075173805e4eee728f52620ad70361830973d89d3a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00009","start":174,"end":211,"exact":"Turkey is not just a Muslim country. "},{"@id":"urn:doxa:passage:742ff6f1389c6153fea2595286db12ce175d3e8abf59573baec74907c63c87ee","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00009","start":211,"end":288,"exact":"It is a NATO member and a candidate country to join the European Union (EU). "},{"@id":"urn:doxa:passage:5e8ac76806360869b7a724e0f7a63dc8e1e0463f7039ad277c2caa5f8436e1ad","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00009","start":288,"end":380,"exact":"Turkey is the only country in NATO and aspiring member of the EU to vocally champion Hamas. "},{"@id":"urn:doxa:passage:77fc39d700881e2f5c4f19376b414e08a1b2be25eba5b7c2b29834219ce86e2e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00009","start":380,"end":429,"exact":"This is different from being critical of Israel. "},{"@id":"urn:doxa:passage:5f162b1cecb62f3cefef7a4d29cc29f0624fa1e344826836fad96dfd43636426","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00009","start":429,"end":536,"exact":"There are far better avenues to be critical of a country’s policies, without being glaringly hypocritical. "},{"@id":"urn:doxa:passage:730cd9724d4785f010c89018bc5abfbcc312ea68de11417eeaf618ae235a1f22","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:058a98317bd0948c5009874d3bb78176","blockId":"gv-814361-b00009","start":536,"end":594,"exact":"It appears that this thought did not cross Erdoğan’s mind."},{"@id":"urn:doxa:decision:0e6767ec26de5cb405754064015ce7d0","@type":["doxa:Decision","prov:Entity"],"recordId":"0e6767ec26de5cb405754064015ce7d0","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:058a98317bd0948c5009874d3bb78176:u_bd4749631db9b4729995fbac","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:75b253354a508cb29f5bad8f23d9646137fcbc97e428e17089551420bdf5df48","urn:doxa:passage:032bb384a50c1bb5a60a021680deddce6eef6ac39a813632e79ec7099ccc3c8b","urn:doxa:passage:55100a1120029e6fe16ed6f0961627fff2d1c263b4cedf17631e56af623ba451","urn:doxa:passage:a0136adf27008087e5466fcc63badfbf961d3056c3cfbdf6c4526347cd9a4512","urn:doxa:passage:9d87d01c79da0183c1560a23608993e09f679204bc844e0898b4fe0eb3485ce9","urn:doxa:passage:c488131bbb0d4309bee0b29ecf3d99a6da4a11e6f25534de02d4a8d8eab98337","urn:doxa:passage:5808f124ee2479e34e8e7cb741829b8d705cb4054f5d467293161c585591f8ad","urn:doxa:passage:1c78f0294ffd6b2d65cb5b120f165d2b3d82c3087acf141