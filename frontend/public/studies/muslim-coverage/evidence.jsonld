42da58c2a0fa656a835d8471f10474fa2ffde3570e7727"]},{"@id":"urn:doxa:decision:48186db7774a60a5837052cca1af6de7","@type":["doxa:Decision","prov:Entity"],"recordId":"48186db7774a60a5837052cca1af6de7","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:22a4e2e437241fb16020940b0e08cf04:u_fc6fca53f8b0867d3c33db2c","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:9392d1b882ef3b02555f99f81e4a8f38d8b2242428250a64d2ae27379d9260ed","urn:doxa:passage:128f1ab219fab15354ff685b37d111612b4c8cfeae1151eeb814423b3d4182a2","urn:doxa:passage:7b8c75b8e730409867a5708e231ec72e6c21800b47ff2ae175cb45499047fa9b","urn:doxa:passage:01c73d8a3a251c474b6870de1c5ce7d061b81fa474d4e39abffffdb9d8146ae7","urn:doxa:passage:280ad6b1b03294f1ad42da58c2a0fa656a835d8471f10474fa2ffde3570e7727"]},{"@id":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-833089","title":"Filipinos pay tribute to Pope Francis who once braved a raging storm to meet with disaster victims","author":"Mong Palatino","translator":[],"publishedOn":"2025-04-25","sourceUrl":"https://globalvoices.org/2025/04/25/filipinos-pay-tribute-to-pope-francis-who-once-braved-a-raging-storm-to-meet-with-disaster-victims/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"0122d7f3abbb0ff25e614e647f52a035f92225ebeeb299b86da84f8a8815a08a","textSha256":"7c878137f1b723a2bf719d79dba30348be36062ea6c87851d217fbb18b01ab0d","archivedRecordSha256":"5a904b4d60a8524389a9b66a322e6129a1e841ba75397f94b22df70e6b5b0ba6","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:dec261d5c47a14ff6f55155f34aca257:u_07b7fd7720702c1d361bc623","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_07b7fd7720702c1d361bc623","status":"accepted","fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257"},{"@id":"urn:doxa:unit:dec261d5c47a14ff6f55155f34aca257:u_5fe00af4987ef1964b9b2512","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_5fe00af4987ef1964b9b2512","status":"accepted","fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257"},{"@id":"urn:doxa:passage:cda9a281f36bd3b75c344e42012b1e8cdd4e720ed3c8205237b72dd0f1a423bc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00017","start":327,"end":571,"exact":"In the midst of another storm, Pope Francis stood with the people in the rain, declaring, ‘I will walk with you all with my heart’ He condemned the ‘scandalous social inequalities’ and the corruption that intensified the suffering of the poor. "},{"@id":"urn:doxa:passage:6cee3cf71f009ec5318b1835fa0506487676df54d02d56a6524d9f13d77506fe","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00017","start":571,"end":708,"exact":"His presence was a rallying cry for justice, accountability, and resistance against those who treat our lives and our land as expendable."},{"@id":"urn:doxa:passage:86b2f1ccbc40826b66b28d555b6af7618c1b9b44bfa66b00cd349430b0dcfd58","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00018","start":0,"end":216,"exact":"Luis Antonio Cardinal Tagle, the highest-ranking Filipino in the Vatican Curia, is reportedly among the names being considered as the next pope, but the CBCP discouraged the public from speculating about this matter."},{"@id":"urn:doxa:passage:dab3395edad1d718d60b7f928c6f9be2d84e30f5f7fe04c0f2463833e4879bfd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00019","start":0,"end":192,"exact":"The Apostolic Nunciature in Manila has announced that books of condolence will be opened on April 29 to allow the public to express condolences and share their memories about the late pontiff."},{"@id":"urn:doxa:decision:f349837a8831ef48de8f2be94068f983","@type":["doxa:Decision","prov:Entity"],"recordId":"f349837a8831ef48de8f2be94068f983","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:dec261d5c47a14ff6f55155f34aca257:u_07b7fd7720702c1d361bc623","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cda9a281f36bd3b75c344e42012b1e8cdd4e720ed3c8205237b72dd0f1a423bc","urn:doxa:passage:6cee3cf71f009ec5318b1835fa0506487676df54d02d56a6524d9f13d77506fe","urn:doxa:passage:86b2f1ccbc40826b66b28d555b6af7618c1b9b44bfa66b00cd349430b0dcfd58","urn:doxa:passage:dab3395edad1d718d60b7f928c6f9be2d84e30f5f7fe04c0f2463833e4879bfd"]},{"@id":"urn:doxa:decision:555115e66314a1c87d2edc237c9efa6f","@type":["doxa:Decision","prov:Entity"],"recordId":"555115e66314a1c87d2edc237c9efa6f","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:dec261d5c47a14ff6f55155f34aca257:u_07b7fd7720702c1d361bc623","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cda9a281f36bd3b75c344e4201