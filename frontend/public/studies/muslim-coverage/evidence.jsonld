doxa:passage:34dd31686f8e2c84de5c4511d56673d57fdf7b1b0a83174b99117ff317130146","urn:doxa:passage:d99af4844b21e1f694128d739337bf6b040f065c270aa49f3cb2d578cabe2e70","urn:doxa:passage:7fa4ea22cea36f2f81feb994ba3b2292bdb515cd887e4a4f9eb7b7d396a196bd","urn:doxa:passage:d2ea861f66584e9bca5ce8ebd4feba69f7f1209f526a05fea39a25206fd441aa","urn:doxa:passage:94ae72956d13a8bfc0fd3ee78b7f41b112a284f6149c4e2b10f33405ee542685","urn:doxa:passage:ae9ed11f984e244eeb90f045ef72b6cc050a1ee055000544eefc267cced256d9"]},{"@id":"urn:doxa:passage:d5a595f6f7d7207c5e0e83c74b2961393d4b657bdad78c1c0e12ca268912694c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00014","start":99,"end":327,"exact":"Three years later, Erdoğan won his second term as president and his party secured an absolute majority in parliamentary elections that same year, as a result of AKP’s alliance with the far-right Nationalist Movement (MHP) party."},{"@id":"urn:doxa:passage:99811997ab3bf93dbbdab94f78d637ba72b9def2f37caf994a13d1c8f8c3a283","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00015","start":0,"end":66,"exact":"The following year, Turkey went through its fourth military coup. "},{"@id":"urn:doxa:passage:02ae5ba97b5f7587e1e25880526da43db86966acd17a81cef29ca5d15e588d28","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00015","start":66,"end":195,"exact":"Turkey’s president rallied behind his supporter base, calling on them to take the streets, promising to “clean up” the military. "},{"@id":"urn:doxa:passage:2294ab5b62194742f4381638d4458323f4689ed74c75b3d9c99f9a7c9d578b53","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00015","start":195,"end":345,"exact":"“This attempt, this move, is a great favor from God to us,” Erdoğan said as he arrived in Istanbul from Marmaris where he was reportedly on vacation. "},{"@id":"urn:doxa:passage:c6a5ae836407216f6090989a461caf767ad976ea6bf4a8ba46f2a4c4171dda1d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00015","start":345,"end":351,"exact":"“Why? "},{"@id":"urn:doxa:passage:518c8f991f5cb30ea6621f939416580d0e106dd5b34994d43b85a4c9ae585444","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00015","start":351,"end":449,"exact":"Because this move will allow us to clean up the armed forces, which needs to be completely clean.”"},{"@id":"urn:doxa:passage:d21b959268c226b289b75351072d74c47ed12d1c95f93ddde8da1ff6ac5adad2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00016","start":0,"end":23,"exact":"Then the purges began. "},{"@id":"urn:doxa:passage:002b2552d6c212b888908569f243eb49fbf6b144b1676e2b7db8eccce0ed37cb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00016","start":23,"end":137,"exact":"From the military and academia to the business world and media, thousands were rounded up and arrested in Turkey. "},{"@id":"urn:doxa:passage:1d543432fe104b82a6f0cb3e98f85f29d9011218e0649429a675c0042eb48555","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00016","start":137,"end":172,"exact":"These arrests continue to this day."},{"@id":"urn:doxa:passage:0c7e0e256fb82bbbe45190874b355c9a86909c5dba0c066fe85645f6fba82b7f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00017","start":0,"end":172,"exact":"In 2018 Turkey officially switched from a parliamentary system to a presidential system which AKP argued would make the government more effective, though experts disagree. "},{"@id":"urn:doxa:passage:bca9466118660f75e3184ac8dd9d03e8f61f2595ab63c0da6c31f651f11a5631","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00017","start":172,"end":365,"exact":"Instead, they say the change has led to a weaker parliament, undermined the separation of powers, politicized the judiciary branch, crippled institutions, and prevalent authoritarian practices."},{"@id":"urn:doxa:passage:8125fcc6d874c817f2c8ff537010a49c0578b39bb94bbd31b9d8bcd4e997bbc2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00018","start":0,"end":82,"exact":"Meanwhile, the country continued to suffer a currency crisis and sharp recession. "},{"@id":"urn:doxa:passage:b6fa43828fc42f9919eec593a4b825a3923d6267c9d100aa3dff63ca63a39fbc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00018","start":82,"end":256,"exact":"The ongoing political and economic turmoil resulted in AKP losing five of Turkey’s six largest cities in the 2019 local elections, including Istanbul and the capital Ankara. "},{"@id":"urn:doxa:passage:bd753af4d086a47258fab7f5d26fb6d0ec2fc88d28425cc08c84484ea3e62a60","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00018","start":256,"end":443,"exact":"There was also rampant corruption, including 128 billion US dollars going missing from the Central Bank reserves that, until last year, was headed by Erdoğan's son-in-law Berat Albayrak. "},{"@id":"urn:doxa:passage:30fbf6554699ed7099531892a33b432a85dc3aa1c977886402ba696a7cc8e9ac","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00018","start":443,"end":617,"exact":"Not surprisingly, Turkey’s ranking in the Corruption Perception Index of Transparency has dropped 33 places in the last seven years, ranking 86th among 180 countries in 2020."},{"@id":"urn:doxa:passage:6b6cc8cbf9231f29d88478d7a550fb1656f90ea00ba3129582ece2df1c8fbfbd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00019","start":0,"end":26,"exact":"Crackdown on civil society"},{"@id":"urn:doxa:passage:9b1eca4a8e1b19d4a43e5e8624aa6b30525ebffd25d7fa3d1570519b07df89a6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00020","start":0,"end":86,"exact":"Turkey's corruption index is not the only score that has declined under the AKP rule. "},{"@id":"urn:doxa:passage:85a6b4722e216182970fe28e7b9d3e5412dd9d99c968256b5c5dab2137f06728","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00020","start":86,"end":352,"exact":"Many international human rights and press freedom organizations have highlighted how in the aftermath of the failed coup in 2016, a systematic crackdown on rights and liberties has negatively impacted the country's score on their annual country performance reports. "},{"@id":"urn:doxa:passage:823a18c3d9686b4885ed915c39c146e10dffea5886625faa9988f134b85f211b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00020","start":352,"end":434,"exact":"Turkey was ranked “not free” on Freedom House's Freedom in the World 2021 report. "},{"@id":"urn:doxa:passage:4dfac913d022a13b65c719f23e4cdd30bac72e886438b8adab00807a8c65fca8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00020","start":434,"end":603,"exact":"PEN America’s 2020 Freedom to Write Index said Turkey was the world’s third-highest imprisoner of writers and public intellectuals, right behind China and Saudi Arabia. "},{"@id":"urn:doxa:passage:9222136f823e3fc0abd8c163cd22721dc11b669e3effea89faae1bfce37838dc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00020","start":603,"end":756,"exact":"Reporters Without Borders, ranked Turkey 153rd out of 180, describing the country as a place, where “all means possible are used to eliminate pluralism.”"},{"@id":"urn:doxa:passage:ce30ffb2d9cc40bb70e2554984dece2178e2ab80db19d8948e1d84aaa09e381e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00021","start":0,"end":337,"exact":"The current leadership also announced this year, its decision to withdraw from the Istanbul Convention, an internationally recognized doctrine protecting women's rights, and has cracked down against the opposition Peoples’ Democratic Party (HDP) including ordering its closure and targeted LGBTQ+ community during Pride month this June. "},{"@id":"urn:doxa:passage:ed5b601b061ffdb8241e07b10dea82c0a0150c8a8ef9d08fd3113332ac2b8c7f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00021","start":337,"end":551,"exact":"Erdoğan‘s government also dismissed binding European Court of Human Rights judgments ordering the release of some high-profile activists and politicians who have been behind bars on questionable terrorism charges. "},{"@id":"urn:doxa:passage:9e9a1f51f190d14678ba1367bb7984fee1f0bf185cc5033ee3e037ae9f670526","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00021","start":551,"end":695,"exact":"When students at the prestigious University of Bogazici protested against government-appointed rector earlier this year, they too were targeted."},{"@id":"urn:doxa:passage:bca96bd3598ae780462ffd4c9e83a12c43d42da3c468d6b8897b9b7eeaa1c873","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00022","start":0,"end":218,"exact":"Nearly eight years after the Gezi Protests, a court in Istanbul reopened a trial, with 16 defendants, some of whom were already acquitted, questioned on various charges including an attempt to overthrow the government."},{"@id":"urn:doxa:passage:609ed086e833552d0f0ff77fa5735531033499aa7f884b3dbe0ba5cc4384a37b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00023","start":0,"end":106,"exact":"In July of this year, the government announced plans to regulate foreign-funded media and misinformation. "},{"@id":"urn:doxa:passage:e0ea98d2cd5525c16b8cacef949429d4d0d106c3d3d212c23973d53508bc8237","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00023","start":106,"end":243,"exact":"Last year, a new social media law came into effect that will have a lasting impact on digital rights and freedom of expression in Turkey."},{"@id":"urn:doxa:passage:584c369466b1b004919d3be4faa3a38961842c8f9136879f1f76ccfd93ebf5b8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:6c96715b4a5645039ba0f050ca5a083c","blockId":"gv-744531-b00024","start":0,"end":183,"exact":"With a new election just two years away, all eyes are on the ruling party and President Erdoğan as the party is experiencing a decline in support and potential challengers to the AKP."},{"@id":"urn:doxa:decision:8055c671613d8883310538ad0e0b8ab8","@type":["doxa:Decision","prov:Entity"],"recordId":"8055c671613d8883310538ad0e0b8ab8","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e175