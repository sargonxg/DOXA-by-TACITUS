19db2d1cf684372ef1cafeaf421b58a751c","urn:doxa:passage:d8aaca6f8c7f42f2fecda329a5f0471a8e923b73192196d7514e45f86ea99ed6","urn:doxa:passage:2237bfb2cc6abc661396a542deeef6d7b5bd8bac0238af699b7bbd45f334a7da","urn:doxa:passage:3ca7cf403af16dce684ef19e069ef56bb0846d260e87752d8a0216e12b48978e","urn:doxa:passage:8ac940d2c9840914b95fa8200675d9808acd1316359f9ed1ab312244140262e7","urn:doxa:passage:c83ecc316ba93cd0b88d7c6bb8625ea7a6d1395f0afefa33d8147f7f748a55bc","urn:doxa:passage:853db64d3d1f104270ab84e0076dd726464ac6f4e9d0f7932f93dbb03119f517","urn:doxa:passage:5bc6cb66ae7fce10b082c65de552dde8015b29fa44fbdff2368d9a93c8ec49e3","urn:doxa:passage:85411b2bb2d843efd0fe720cf048cce3a6a20ae568e7ae0ecc4ecab5ab4e973d"]},{"@id":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-708338","title":"Quarantine debates in Zanzibar conjure memories of colonial racial segregation","author":"Jessica Ott","translator":[],"publishedOn":"2020-05-29","sourceUrl":"https://globalvoices.org/2020/05/29/quarantine-debates-in-zanzibar-conjure-memories-of-colonial-racial-segregation/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"c785aba83d3ca3df5201f60ef1ccdba73b345f91621bac7806c2bb1276e4bb00","textSha256":"e5ff5eba3cf9ad19a78ad9b346cad4cee2039f4c00ae64b110175157f6fdeffe","archivedRecordSha256":"b844de0a809cd4918c588c484dfd7f5beae5ac6ac5b93cd64b77036282491339","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:c3643b65db7d1469e60ce128e528b7fd:u_82125d07ba5a577b0350222e","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_82125d07ba5a577b0350222e","status":"accepted","fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd"},{"@id":"urn:doxa:unit:c3643b65db7d1469e60ce128e528b7fd:u_fa17c66438dd28d16d53ef74","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_fa17c66438dd28d16d53ef74","status":"accepted","fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd"},{"@id":"urn:doxa:passage:2ab3589d9b66f3b486f74fec3cc5eb82619da33b44944d47c00859f088e37776","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00001","start":0,"end":194,"exact":"When the first case of COVID-19 was reported on March 8 in Zanzibar, East Africa, the government closed schools and banned unnecessary public gatherings to prevent the spread of the coronavirus."},{"@id":"urn:doxa:passage:b1bb6a577db51080b68d82eb9df488a1cdb5f560f4beadbcb2a4acb2a4eb5087","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00002","start":0,"end":138,"exact":"Authorities encouraged social distancing and 14-day quarantines among people who may have been exposed but did not order a full lockdown. "},{"@id":"urn:doxa:passage:2ae61947f3f6b6512ccd26c85dd5ebd8bf5527b2a69641e7e5d6c7d2086020c2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00002","start":138,"end":280,"exact":"In a show of due diligence, Second Vice President Seif Ali Iddi self-quarantined for 21 days upon his return from a diplomatic visit to Cuba. "},{"@id":"urn:doxa:passage:53c349c3d4d09fb16c4178290cd3e920f22a88db6ec34bc9e4fe00e45bfa369c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00002","start":280,"end":329,"exact":"Several doctors also reportedly self-quarantined."},{"@id":"urn:doxa:passage:fc72bcf2f6067e95794433516ab6051b8a2ad229dee2344088d3fd98f2280092","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00003","start":0,"end":96,"exact":"Yet, some members of the political opposition have questioned whether these measures are enough."},{"@id":"urn:doxa:passage:fafd70261d2db32098ffb23dde792912204a22ca70722386be2bc723e17b97cc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00004","start":0,"end":190,"exact":"On Twitter, debates about the government's response to COVID-19 began to conjure up memories of colonial quarantining measures on the islands — which were often based on racial segregation. "},{"@id":"urn:doxa:passage:520394281a5ad6fbbd7c437a2096b8cefbce723cf47d1dcb7de0a92d1454418b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00004","start":190,"end":347,"exact":"Zanzibar came under Omani rule in 1698, although the sultan’s power was seriously undermined when the British declared a protectorate over the isles in 1890."},{"@id":"urn:doxa:passage:1ac28862ac9d42e1ca2b5177a7469e3d09b1cfa5a708d1e2cbd290b87bc146b9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00005","start":0,"end":275,"exact":"On April 25, Ismail Jussa, an Alliance for Change and Transparency (ACT) opposition party politician in Zanzibar’s House of Representatives, sparked a Twitter discussion about colonial quarantining measures after he condemned the government’s lackluster response to COVID-19."},{"@id":"urn:doxa:passage:7442c680e67867d56a3a68ac4d1eb2759ef3022b72ecbcc13f233b0b831911a1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00006","start":0,"end":263,"exact":"Citing the British colonial administration’s successful efforts to curb the spread of the Spanish Flu in 1918 through an enforced quarantine, Jussa questioned why the government had not learned from its own history and enacted more forceful quarantining measures:"},{"@id":"urn:doxa:passage:8f2c6d3d6161e43d9ed60d258ab2661d41b484de12b958bffdddc046c84e5317","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00007","start":0,"end":104,"exact":"> History has shown us that in 1918, Zanzibar controlled the Spanish Flu through forceful quarantining. "},{"@id":"urn:doxa:passage:d47e91698e412e6de5a0907c3579780b17be721c25a08d50209a6ada7c662a8f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00007","start":104,"end":259,"exact":"Now, 100 years later, the coronavirus has arrived, and it has unfortunately found Zanzibar with puppet leaders who lack self-confidence and are incapable. "},{"@id":"urn:doxa:passage:1e987556f340a04fb59ccaadd2729ae23c9f6a82f17a6ac6b5e3841004bccef8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00007","start":259,"end":341,"exact":"They are being told to make important decisions, but they are too afraid to speak."},{"@id":"urn:doxa:passage:cf915d4535fbdcee195cbb5cc6e3b27a91cf5643c8ccc5d85bdf40a7a33214c8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00008","start":0,"end":217,"exact":"Thamoka, one of Jussa’s more than 79,000 Twitter followers, criticized Jussa for lauding an era when their ancestors were under Omani rule and relegated to the supposed African quarter of Zanzibar Town called Ng’ambo."},{"@id":"urn:doxa:passage:3f4f209111dbceb9d041991fcece6d19f2d078ab62433dbef10fa77c9872e3e6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00009","start":0,"end":99,"exact":"> During that time, the sultan only allowed Europeans in that part of the city, not our ancestors. "},{"@id":"urn:doxa:passage:b08af7f9fbd706bb9a0c975ab257807b42331c33892e1493f19ae6ea66178168","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00009","start":99,"end":146,"exact":"Our ancestors were being abused by the sultan. "},{"@id":"urn:doxa:passage:8eefd26ba32845d4c0990ab45930d6a22c70310b2aded5b8daac23498fc5bbb5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00009","start":146,"end":260,"exact":"Or aren’t you aware that during that time, we were being oppressed and sold by masters on our own land in Ng’ambo?"},{"@id":"urn:doxa:passage:1203b53529e73e0401f150f12bc267a1aa2dbbe215dde2b1105e5828233afbd8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00010","start":0,"end":255,"exact":"Thamoka’s tweet reflects a common understanding of history put forth by Tanzania’s ruling Chama Cha Mapinduzi (Party of the Revolution), or CCM, that Zanzibaris of African descent were in effect slaves to the sultan before the Zanzibar Revolution of 1964."},{"@id":"urn:doxa:passage:3f384162d10b194554ac3b480f63545f2cdf439f9c6c4c14a6889436bb425590","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00011","start":0,"end":142,"exact":"Thamoka’s politicized tweet also alludes to British colonial attempts to separate the supposed European and African quarters of Zanzibar Town."},{"@id":"urn:doxa:passage:fb374e64a1b00fda3ec597c566049c068bb0f44ae43ef82bf88d9fe9d0469236","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00012","start":0,"end":270,"exact":"British colonial administrators in Zanzibar saw non-Europeans as vectors of disease and sought to ensure European health and wellbeing through racial segregation, according to William Cunningham Bissell in the book, “Urban Design, Chaos, and Colonial Power in Zanzibar.”"},{"@id":"urn:doxa:passage:e4b648a19e5d63b7aa68857b8a69f01446e741d42a36ebd5c0b384fe0b88d1b0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00013","start":0,"end":339,"exact":"Colonial public health measures like quarantine were motivated by a fear that diseases like leprosy would endanger European life in Stone Town, writes Amina Ameir Issa, director of Zanzibar's department of museums and antiquities, in “From Stinkibar to Zanzibar: Disease, Medicine, and Public Health in Colonial Urban Zanzibar, 1870-1963.”"},{"@id":"urn:doxa:passage:dac209b6fdd07454879719b9e6ba190e95150effb6859f9cb787d3a3a3ffff96","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00014","start":0,"end":121,"exact":"According to Issa, the British colonial administration began to forcibly isolate and detain people with leprosy in 1897. "},{"@id":"urn:doxa:passage:dae34f403d4383c1923cf2d2fab15ba2babbd4ca95b7ec7debd1f632f445961d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00014","start":121,"end":225,"exact":"Leprosy was a heavily stigmatized, disfiguring disease that especially afflicted the poorest Zanzibaris."},{"@id":"urn:doxa:passage:104844836b48e78eb0dcf0edbf450728700c6ce1326306de0b03bcf413317c18","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00015","start":0,"end":229,"exact":"People living with leprosy were detained at one main settlement in Walezo, just outside of Zanzibar Town on Unguja Island, and three smaller settlements on Pemba Island, writes Stephen Pierce in his case study on the settlement. "},{"@id":"urn:doxa:passage:e62d12410a45021de7bd3070d2d245a4a5a0b027295ea637adcce2b17b1a67b5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00015","start":229,"end":381,"exact":"Pierce describes frequent attempts to escape among detained patients who lived in deplorable conditions and were unable to seek support from loved ones."},{"@id":"urn:doxa:passage:602b9aa2b42f970dc172a30da978bac57f5b60e882417e4a3197ff69e51449cb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:c3643b65db7d1469e60ce128e528b7fd","blockId":"gv-708338-b00016","start":0,"end":35,"exact":"Prison Island: A quarantine history"},{"@id":"urn:doxa:decision:6884e5ec3fe0d776e6c25538879be351","@type":["doxa:Decision","prov:Entity"],"recordId":"6884e5ec3fe0d776e6c25538879be351","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:c3643b65db7d1469e60ce128e528b7fd:u_82125d07ba5a577b0350222e","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:2ab3589d9b66f3b486f74fec3cc5eb82619da33b44944d47c00859f088e37776","urn:doxa:passage:b1bb6a577db51080b68d82eb9df488a1cdb5f560f4beadbcb2a4acb2a4eb5087","urn:doxa:passage:2ae61947f3f6b6512ccd26c85dd5ebd8bf5527b2a69641e7e5d6c7d2086020c2","urn:doxa:passage:53c349c3d4d09fb16c4178290cd3e920f22a88db6ec34bc9e4fe00e45bfa369c","urn:doxa:passage:fc72bcf2f6067e95794433516ab6051b8a2ad229dee2344088d3fd98f2280092","urn:doxa:passage:fafd70261d2db32098ffb23dde792912204a22ca70722386be2bc723e17b97cc","urn:doxa:passage:520394281a5ad6fbbd7c437a2096b8cefbce723cf47d1dcb7de0a92d1454418b","urn:doxa:passage:1ac28862ac9d42e1ca2b5177a7469e3d09b1cfa5a708d1e2cbd290b87bc146b9","urn:doxa:passage:7442c680e67867d56a3a68ac4d1eb2759ef3022b72ecbcc13f233b0b831911a1","urn:doxa:passage:8f2c6d3d6161e43d9ed60d258ab2661d41b484de12b958bffdddc046c84e5317","urn:doxa:passage:d47e91698e412e6de5a0907c3579780b17be721c25a08d50209a6ada7c662a8f","urn:doxa:passage:1e987556f340a04fb59ccaadd2729ae23c9f6a82f17