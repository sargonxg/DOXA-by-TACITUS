assage:eb3db19a7657d825ea9707212be1a3eed41f6ad43bd018cc2e5788ce8b9bff42","urn:doxa:passage:4e12cda0289fd07e0241b698fd2ed0a58e4bf5f6635d3ce4e12b76b31ceed463","urn:doxa:passage:54e6f57f2a8f76d8076d19c5cf6f3b67e9e7c08b6a318e9f4df071fb19fecbf3","urn:doxa:passage:1523995edeb0608a653d17c72da28e7c9cdae5f48ab21b0e044d1f70f60c3ab5","urn:doxa:passage:e680df0aa7843b2aceb2b429d617e3c2753ee78f6d992d106b22777858c48598","urn:doxa:passage:7d3d1b51f0936e29f219a86f7488578f1a2fdc041ae5a0885100280df6ac3b12","urn:doxa:passage:9d56d279aacab8e1ef416887811cb5f33cd4ce703ca21948d9db23b6b644edda","urn:doxa:passage:01663d20c76bcc74a73113fe89cce927a04a771c253641db0fdbf9306b3c791d"]},{"@id":"urn:doxa:passage:c2018f2637b4fe522c4139d6cc56dad6085c22338c8fd1511d2aa3a5326ce42d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00001","start":0,"end":63,"exact":"Welcome to Undertones, the Civic Media Observatory newsletter! "},{"@id":"urn:doxa:passage:1693d525fbfd9371fa0a232c23659ccda0df323bc5ed9d061fa2fd5c3cf8b0e2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00001","start":63,"end":280,"exact":"In each edition we'll analyze an event, emerging trend, or a complex story, identifying key narratives of urgent public interest, delving deep into the context and subtext of local, vernacular and multilingual media. "},{"@id":"urn:doxa:passage:f817c5d04264345d3c06d30618149eb26578d3c394b0684a10d94cb07e17ffdc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00001","start":280,"end":378,"exact":"Undertones also offers an entry point into the public datasets that underpin our Observatory work."},{"@id":"urn:doxa:passage:1546a5b474303192812135f604f7d6a7280d1546f46cd3478d74bf04cc60cbc1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00002","start":0,"end":23,"exact":"Subscribe to Undertones"},{"@id":"urn:doxa:passage:ceb8c4f14e7edcb63d37a8f78bfb7933e34c5aad0085279891ef06214e88b5e6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00003","start":0,"end":165,"exact":"Turkish doctors and Syrian refugees share an unlikely commonality — they are among the groups in Turkey that are most targeted by far-right and populist narratives. "},{"@id":"urn:doxa:passage:5996ba32e2cde53d0463f92009c4da2eaf52190f2e89d56beb3ed1f8626f549a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00003","start":165,"end":349,"exact":"With the country’s ongoing downward economic spiral — worsened by nearby Russia’s war against Ukraine — anti-immigrant and anti-elite narratives are gaining ground at an alarming rate."},{"@id":"urn:doxa:passage:0a863179ba75d1141a70a103fc1353acd2750b5c7215bb1e5e5ba703acadc03b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00004","start":0,"end":193,"exact":"Some mainstream media and far-right politicians, especially those in the opposition, have used Turkey’s skyrocketing inflation to question the tax money being spent to support Syrian refugees. "},{"@id":"urn:doxa:passage:5c3fda0ba3cf377b9954eea2ea97ce440d6b343e2b6bf2f08cd8f097224b23f3","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00004","start":193,"end":267,"exact":"Turkish doctors, too, have been targeted — but by the ruling party itself."},{"@id":"urn:doxa:passage:237897963c33ee959643423abc3dd0ccb8eebd451687de7985cbe950119c8d1b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00005","start":0,"end":160,"exact":"President Erdoğan’s conservative administration has openly labeled Turkey’s doctors’ union as “terrorists”, a term that it usually reserves for the opposition. "},{"@id":"urn:doxa:passage:52a78939175fe1fa86421ff7cb1f4c348d062ce24ce9b4077f9658b11574f4f2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00005","start":160,"end":303,"exact":"The fact that this union has been consistently vocal about human rights could be a clue as to why it has received such scrutiny from the state."},{"@id":"urn:doxa:passage:485a76f6ad6c1ff60f277e36bdf6b515abf727fba810478b3ff1e970c2211c0a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00006","start":0,"end":22,"exact":"Why talk about it now?"},{"@id":"urn:doxa:passage:b506eb30a781915260914334c9940dd6886feb8e24aaaa300d8adf5e76f140b4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00007","start":0,"end":157,"exact":"While discrimination against doctors and immigrants is not new, the narratives about them are increasingly aggressive and could result in physical violence. "},{"@id":"urn:doxa:passage:b957e84a38c29cc983fcfffc880c365c37899f18340318d49abc37fd5bb5cb0a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00007","start":157,"end":208,"exact":"In January, a Syrian refugee was killed in Turkey. "},{"@id":"urn:doxa:passage:23fcdde2468fbdf3ef588fc9b0572007f6917f4991f6c0398251acf1d7e63601","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00007","start":208,"end":346,"exact":"Meanwhile, the Turkish Medical Association (TTB in Turkish) denounced tens of thousands of cases of aggression against healthcare workers."},{"@id":"urn:doxa:passage:ba8155e15c28062615844b69acb32bd2fab82905dc49b964d3bbdc8678d6a337","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00008","start":0,"end":10,"exact":"Narratives"},{"@id":"urn:doxa:passage:69390975a2fce8092de71a56400b2f9b6b1fb81613a0557fa79e0e5fc2f2101e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00009","start":0,"end":3,"exact":"1. "},{"@id":"urn:doxa:passage:b5967a713f868634b80b199ca3f1cf2e68c9860ff7e1707cb6c8023c96835247","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00009","start":3,"end":56,"exact":"“The elites lost their power with the AKP government”"},{"@id":"urn:doxa:passage:80077e29c98ae198021f9554973d5bc9148c682703ea2bb3cddfb9eaff0446b8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00010","start":0,"end":178,"exact":"President Recep Erdoğan’s Justice and Development party (AKP in Turkish) and its supporters have pushed the idea that Turkey’s educated elite lost their power because of the AKP."},{"@id":"urn:doxa:passage:d6075683d1a4cc5bf9500526f7548afa9c8e33e9e53594d925ca160f91e18b1b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00011","start":0,"end":144,"exact":"This narrative is part of a much older one that emerged during the fall of the Ottoman Empire and the creation of the Turkish Republic in 1923. "},{"@id":"urn:doxa:passage:3963cc5ff62d6a0b11051321ae2f7f3bd30f21c32e0a7066237fd348cd5a06fb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00011","start":144,"end":303,"exact":"That narrative pits Westernized, urban elites (a demographic minority) against conservatives who were mostly in the periphery of the country’s civic landscape."},{"@id":"urn:doxa:passage:e87ff71a8abc1c3492953bebc807ace866c21f7825cb76c32d90ba2692e8f6bc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00012","start":0,"end":69,"exact":"But the definition of “elite” has been kept intentionally ambiguous. "},{"@id":"urn:doxa:passage:86d352930b3b9f357319c587be7cda69cf36d012d7b097601639b77a3edd1c03","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00012","start":69,"end":189,"exact":"Pro-government media and government politicians use this ambiguity to label any of their political opponents as elites. "},{"@id":"urn:doxa:passage:d84b059f2f4410d765e4649929e47ba952dae8d6231e0eb3c6c68754a02dee85","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00012","start":189,"end":305,"exact":"This all-encompassing term has been used to target proponents of secularism, the armed forces, teachers and judges. "},{"@id":"urn:doxa:passage:79becdec8c3ffd99e323749e9455e96098cdbac078d5fdc7d5e0c96b000c5672","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00012","start":305,"end":375,"exact":"Lately, doctors and healthcare workers have also become a focal point."},{"@id":"urn:doxa:passage:4a62e0e62ef8c51d5749b02cea50b5d9a80399a154cee61d4727e08f3bb6caa0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00013","start":0,"end":69,"exact":"The rhetoric of this narrative extends beyond the rich and the poor. "},{"@id":"urn:doxa:passage:9272801b8c32887f66b458c0da265894e60d090db12153664c7e958f1c672a8f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00013","start":69,"end":256,"exact":"It refers to people who, in addition to their perceived economic privilege, allegedly hold traditionally strong political positions in society, and who exert influence from urban centers."},{"@id":"urn:doxa:passage:41f578de2c947b998a55380417901d1f0829fcf756eafbe3c7cecfe469dbed47","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00014","start":0,"end":105,"exact":"According to the Turkish Medical Association, about 88% of the country’s doctors are part of that union. "},{"@id":"urn:doxa:passage:0bbcdda8f28fff95b5ac154985547b1255377c33e95d00c8707c3caaf4965705","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00014","start":105,"end":148,"exact":"They seek better hours, wages, and safety. "},{"@id":"urn:doxa:passage:8a5f66d6cac3b5852e56dd325dd886153018f8e79ac99bebc0e118a78c6ccd02","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00014","start":148,"end":286,"exact":"The TTB claims that 13 doctors have been killed because of their work and 84 percent of all doctors have faced violence at the workplace. "},{"@id":"urn:doxa:passage:f184d2dbfeb8e96056314cac537d26105dc5d31cd3ce489322c9e6c96b8ef1e7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00014","start":286,"end":350,"exact":"The pay of specialist doctors is barely above the poverty line. "},{"@id":"urn:doxa:passage:db1f5e316c6148f8364735869023c2bb1af51aa9b0aa354b2fce82c946cf924d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00014","start":350,"end":424,"exact":"Thousands of doctors have been leaving the country for the European Union."},{"@id":"urn:doxa:passage:0ff1d4bf1be55b644a93552ec6017f49b44ed6bd9a96eb545bfb0d8bdeab67e9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00015","start":0,"end":75,"exact":"See Global Voices’ recent story on the doctors’ most recent strike in March"},{"@id":"urn:doxa:passage:7bad054a5d449f949313bbbadf1c428757ca02bda61fba57b2e76e4f02cee93b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00016","start":0,"end":44,"exact":"How this narrative plays out on social media"},{"@id":"urn:doxa:passage:3029a6b3122b67fdee248d91fe0e6724b68d51ce301c6992a22e9f287f3e112d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00017","start":0,"end":110,"exact":"The TTB went on strike between March 14 and 16, during which time all non-urgent healthcare services stopped. "},{"@id":"urn:doxa:passage:2cc1e27b10d400217cdb14c274707fea9cd0b8f686af5b85471d59a824fe52b8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00017","start":110,"end":262,"exact":"In this video shared by Yeni Şafak, a media outlet close to Erdogan, a hospital’s head physician is seen trying to force a doctor to come back to work. "},{"@id":"urn:doxa:passage:0d1c0f04b9f5acfacc2fc29430677be16e61b2ed2a15c7de9a4a3b628c5e5b19","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00017","start":262,"end":407,"exact":"The head physician makes false claims, saying, for example, that the emergency care unit was closed due to the strike, when in fact, it was not. "},{"@id":"urn:doxa:passage:61427a77a026969cd5c76de8ea282e4c4bda43e70eb9b94cdb55534d36707e1d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:f2208d69f7379135f1fce6aacb9b14d5","blockId":"gv-759954-b00017","start":407,"end":512,"exact":"The video gathered more than 1.6 million views, with most commentators agreeing with the head physician. "},{"@id":"urn:doxa:decision:7fe58b6475fa517c737dbbd8cf4a5feb","@type":["doxa:Decision","prov:Entity"],"recordId":"7fe58b6475fa517c737dbbd8cf4a5feb","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:f2208d69f7379135f1fce6aacb9b14d5:u_2da4bc4e4065e4a93fd3145a","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:c2018f2637b4fe522c4139d6cc56dad6085c22338c8fd1511d2aa3a5326ce42d","urn:doxa:passage:1693d525fbfd9371fa0a232c23659ccda0df323bc5ed9d061fa2fd5c3cf8b0e2","urn:doxa:passage:f817c5d04264345d3c06d30618149eb26578d3c394b0684a10d94cb07e17ffdc","urn:doxa:passage:1546a5b474303192812135f604f7d6a7280d1546f46cd3478d74bf04cc60cbc1","urn:doxa:passage:ceb8c4f14e7edcb63d37a8f78bfb7933e34c5aad0085279891ef06214e88b5e6","urn:doxa:passage:5996ba32e2cde53d0463f92009c4da2eaf52190f2e89d56beb3ed1f8626f549a","urn:doxa:passage:0a863179ba75d1141a70a103fc1353acd2750b5c7215bb1e5e5ba703acadc03b","urn:doxa:passage:5c3fda0ba3cf377b9954eea2ea97ce440d6b343e2b6bf2f08cd8f097224b23f3","urn:doxa:passage:237897963c33ee959643423abc3dd0ccb8eebd451687de7985cbe950119c8d1b","urn:doxa:passage:52a78939175fe1fa86421ff7cb1f4c348d062ce24ce9b4077f9658b11574f4f2","urn:doxa:passage:485a76f6ad6c1ff60f277e36bdf6b515abf727fba810478b3ff1e970c2211c0a","urn:doxa:passage:b506eb30a781915260914334c9940dd6886feb8e24aaaa300d8adf5e76f140b4","urn:doxa:passage:b957e84a38c29cc983fcfffc880c365c37899f18340318d49abc37fd5bb5cb0a","urn:doxa:passage:23fcdde2468fbdf3ef588fc9b0572007f6917f4991f6c0398251acf1d7e63601","urn:doxa:passage:ba8155e15c28062615844b69acb32bd2fab82905dc49b964d3bbdc8678d6a337","urn:doxa:passage:6