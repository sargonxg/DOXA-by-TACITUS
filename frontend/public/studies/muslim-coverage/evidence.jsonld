2830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:0ce818854401f8b38f2c0054f5f7cb0f:u_a49da84934d4e6dda6f0bbc0","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:23b6c8a60321922bba13acef15b8ab64815c49772bdc0ef0132af6eb9b76574c","urn:doxa:passage:656e9e8f44666337638c867f6bd4a0f044473e984df20a598e40b0c576998517","urn:doxa:passage:debd5945b0824d6e492c516e488d10a1a4f02767706bee50101afdc46db78fe8","urn:doxa:passage:fdfbb5dfb809f22e2baca5cc1162ca2aea74979d64ea0b4ee179c1b7c23a34f8","urn:doxa:passage:15e2cbec9b0fdc64821b6ccf904416d7672d71ad27cdb84e6847be095bccaba1","urn:doxa:passage:7910c6937a078b87dc7e67846c5313beeaf3039d80f897eca20bd1a73d1a2773","urn:doxa:passage:cd4a03726ef28c0ca2598d9c063d5648b407823fd8a2a429d1dedde5f7d97e12","urn:doxa:passage:f2d74c93b2bf5f2a89d1d6270bb5b39233eb4c9d73168cabd56cebdb47dd4b3d","urn:doxa:passage:3eead632088b578794230322d53a4957889db0194bfcbfd0bfd06f40c2ff4d99","urn:doxa:passage:78432ba20fc2e6b8dd8b1a0a242e81d81c2d30f151a7785d6de71d0936c6132d","urn:doxa:passage:26527dcfcb975eea78b493e87a016fab5907890364344e2060d7b70108498d6d","urn:doxa:passage:2b17ae0be2877d02f8055cb3f01e5ef3fad6c2d56554e401521b956e4b7ac510","urn:doxa:passage:b48155e46b10ba3de9ae0d4573a1a47363cd374515e3b0e76af9a2ce84035913","urn:doxa:passage:712b86b225ccc2a5b94cc66a686c7b7942dca8f9c76cd519ad807a8a14d9ecdb","urn:doxa:passage:401b9cc848a0e6a45d13e791cbc05cd28f295857d8a5110ae8dffb233e77afa4","urn:doxa:passage:b44c4404a76599d2643e674e13a7175ed32e2165cc7086d3610a01d2cb071a22","urn:doxa:passage:b7385fe53e69565116f9ba9dd805205ce6bf8a91dadec34f11d0db4f7d047e74","urn:doxa:passage:ac9560d254c5ca7af9bf99dd7aacb511a9752d15bad69c1ca1ed2875470a0c37","urn:doxa:passage:3241e06c4f363f251c3575c5cb39e4d13288fe7d3cc79f3321a77d5c8400d3bc","urn:doxa:passage:7540f3e93f082f18e1913c4632cb98187c3ffddfe9ec732d778a96cabb4e4200","urn:doxa:passage:6f8e0d6330b1a39711c4d0c42950680db03cca3334651fed95dbba230ea72fd8","urn:doxa:passage:449282b3ccdb4fbad13f084ee301a1337545156b83a83847c81bbfd230c462fd","urn:doxa:passage:f3eebc13d007f291c9afb3ff15526594e0d7429862a4339fcd5dbe2116f3f53c","urn:doxa:passage:77d399a439315ad609f44f6abcfc7d64220632a4be58c7778c35dc78e797100e","urn:doxa:passage:aca5a3b4c48da9305ff080289d130bc57dd39a7d88fe6142e33808081a2a534a","urn:doxa:passage:1b9b074da37f5f27db40bd3a06f8587eb923d027b832212832feaa7d4367306c","urn:doxa:passage:d7481d2673f4361e0363c3b6719192c0883ee36bdc5c5dddcf1d6c81ac1bd020","urn:doxa:passage:239cf0d368e587298b12a7e98120cdc90c0e8b4dea5dab5df22c0eb66a3a7140","urn:doxa:passage:6985dd2b5df89e660035a10e4e30abccc423b96feae0e23e7450279c61fcead2"]},{"@id":"urn:doxa:passage:be716be7d0d62610e53bf557c2e62d3c2cc0ebe3b43e0f83ef153c531f29e746","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00001","start":0,"end":278,"exact":"Under the leadership of strongman President Ilham Aliyev, Azerbaijan has often been described as the country of “revolving doors.” The term describes the state's approach to its critics — whenever it releases some political prisoners from jail, it starts a new wave of arrests. "},{"@id":"urn:doxa:passage:0cdb3ef6a9bfd2722231116fb81d366cd612cf96123618a8c1438be4db45e708","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00001","start":278,"end":409,"exact":"As such, civil society and rights advocates and state critics have for years faced targeted harassment, intimidation, and arrests. "},{"@id":"urn:doxa:passage:cd1781fb8b5e941b69cdd90fb44d0a87aceb4772709b2eca70507179cb88b22c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00001","start":409,"end":478,"exact":"The most recent wave of crackdowns attests to the standing tradition."},{"@id":"urn:doxa:passage:025f3d02be21e67ecc1e75b6f2ed5126260dda803287fa1cfd3f77d95ce4a6f4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00002","start":0,"end":229,"exact":"Following a presidential pardon decree on May 27 that ordered the release of over 150 prisoners, including a handful of political prisoners, a wave of new arrests and trials signals the return of the “revolving doors” tradition. "},{"@id":"urn:doxa:passage:02ccbb754570331690097b2c643e46ce4e1da85e191832fd0713ffc8888c2ab2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00002","start":229,"end":463,"exact":"Meanwhile, those who have narrowly escaped a prison sentence or time in administrative detention continue to complain of rampant acts of torture in police custody, something the relevant government institutions wholeheartedly dismiss."},{"@id":"urn:doxa:passage:f2f0200857d4ed1ae8ef602ee2e7e9bde3ad480e75ed03658f492fdc6b4d6d38","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00003","start":0,"end":92,"exact":"In the past, family members of outspoken critics of the government have also been targeted. "},{"@id":"urn:doxa:passage:ec2534572e6513e52f81e25a874be51911430848e1f5692d1aef2005b9a8e45f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00003","start":92,"end":257,"exact":"The latest victim of such politically motivated targeting is activist Rabiyya Mammadova whose mother was physically assaulted at work by another employee on June 3. "},{"@id":"urn:doxa:passage:99368048ce94b02f323be655bf4a78c35f9400f785bb8cc36361f63bd3b0f29b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00003","start":257,"end":350,"exact":"Mammadova told Global Voices, “this is what doing politics in 2022 looks like in Azerbaijan. "},{"@id":"urn:doxa:passage:512f02d0ab2108620dbfd10d4ef88ee2b9e9fba965c4b6ec646b6fc792d580e7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00003","start":350,"end":389,"exact":"They are trying to get to me this way.”"},{"@id":"urn:doxa:passage:e39ed4ec702f45fca6876ae6d545d7cc8e96af10f9862026bfb8017e1e2338ca","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00004","start":0,"end":104,"exact":"Mammadova, is among dozens of targeted activists, whose names dominated the local news in recent weeks. "},{"@id":"urn:doxa:passage:fb33544d9927f4b7235d771c58a74500d1f4c446a1a37cd2fe77a10f3b444549","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00004","start":104,"end":294,"exact":"Journalist Aytan Mammadova was threatened at knifepoint over critical reporting, while political activist Bakthiyar Hajiyev was kidnapped and beaten over his criticism of local authorities. "},{"@id":"urn:doxa:passage:f22ebecd0afb6d891080dd2b5856ca9e05655f46d486e83004594675751c80e4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00004","start":294,"end":434,"exact":"Another high profile case is that of veteran opposition political activist Tofig Yagublu, who was detained during a rally in December 2021. "},{"@id":"urn:doxa:passage:efd441c0be29c7e67da3d7fc42693801f06eb5754772ce9996d14c43cdccfb57","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00004","start":434,"end":636,"exact":"Images of his injuries were subsequently shared on social media — yet, according to the results of an investigation launched by the authorities, the police had no involvement in the activist's injuries."},{"@id":"urn:doxa:passage:3b9e60d31ba893ae5f0b7216a18dbdf37b047fddfb2887c9e6e7741d88d4db04","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00005","start":0,"end":90,"exact":"Local human rights watchdog groups like “The Defense Line,” confirm an uptick in attacks. "},{"@id":"urn:doxa:passage:fa54747bc9ec89f041cc57d36e29991f732e5c84d11df25207e0576d029bc02e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00005","start":90,"end":223,"exact":"Speaking to journalists on June 3, the group's director Rufat Safarov said cases of pressure and physical assaults increased in May. "},{"@id":"urn:doxa:passage:860bbab978e527dfc2fdcc09562fbb2a11043a27455181156f2bcf79efbcf5da","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00005","start":223,"end":346,"exact":"Safarov also spoke about the legal measures taken against Azerbaijani citizens who were recently repatriated from Germany. "},{"@id":"urn:doxa:passage:b8e0261b9db342631b8232e2017731bdc47ba351633a76e1e10dc5b61e69686f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00005","start":346,"end":477,"exact":"At least six people were arrested following their return to Azerbaijan on bogus drug possession charges according to media reports."},{"@id":"urn:doxa:passage:883f0f77841556d8dfb51cfe15597dc3dcadfc124bcadc4d916d594ca225ccaa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00006","start":0,"end":87,"exact":"Police also detained former political prisoner and blogger Rashad Ramazanov on May 20. "},{"@id":"urn:doxa:passage:7a92834813611a590afff850e68236fa7d6c00203357b9f97b0f7e2fcc55d8e1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00006","start":87,"end":260,"exact":"The following day, a court in Baku charged the blogger with illegal drug possession, with an intention to sell, sentencing the blogger to four months in pretrial detention. "},{"@id":"urn:doxa:passage:43e7dbaa35fb1f832976b0953e95be28ee78612580fadff654fc4f86c5e104be","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00006","start":260,"end":346,"exact":"Ramazanov also reported he had been tortured, an allegation the authorities dismissed."},{"@id":"urn:doxa:passage:332ad4fac6fc0d12bcc9f118f275747fdc93cf4e9293dda2d3f12e9ef0a91b25","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00007","start":0,"end":115,"exact":"On May 28, police detained political activist and member of opposition Popular Front Razi Alishov on drug charges. "},{"@id":"urn:doxa:passage:b5a8185ce0173cc5f74ea5ef6c45a51cd059ff0a2e072f4f4aacbbae010e97e6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00007","start":115,"end":257,"exact":"According to the leader of the Popular Front party Ali Kerimli, Alishov's arrest was politically motivated, which the authorities have denied."},{"@id":"urn:doxa:passage:b8e9848d39bfeaa71246452a40f35f0f03855ac94d5b16a0893cae88c823c0b7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00008","start":0,"end":103,"exact":"In a statement released by the opposition National Council, the group condemned the ongoing repression:"},{"@id":"urn:doxa:passage:1f12ff1f482fa307797c5189af9ffa6ef075610065a0590d6d55f375d74909eb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00009","start":0,"end":100,"exact":"> Azerbaijani law enforcement agencies often arrest opposition political activists on drug charges. "},{"@id":"urn:doxa:passage:1df14ee40f5a08c8f7c095df83fb48dd9b119166209b4abfd0bef1bec6a6a2ef","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00009","start":100,"end":176,"exact":"Razi Alishov is yet another opposition activist charged under this article. "},{"@id":"urn:doxa:passage:9edb7b31ee849b258e4084db1dfa073ead1f08d818ee32db462672e4bf6aee4b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00009","start":176,"end":378,"exact":"With the arrest of Razi Alishov, Ilham Aliyev's government has once again acknowledged that it does not intend to change its method of governance and cannot do without repression and political arrests. "},{"@id":"urn:doxa:passage:6f05aac02b93bf7c39888e46a475024ea3a0b4aac8974a2f3463d289c3c29192","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00009","start":378,"end":544,"exact":"Otherwise, no new political arrest would have been ordered immediately after the incomplete pardon order signed on May 27, which included several political prisoners."},{"@id":"urn:doxa:passage:9950c494dc541387496d1af82187ea9d9e5678f505d9ebd01d0d0c0249a6d6a7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:0ce818854401f8b38f2c0054f5f7cb0f","blockId":"gv-764723-b00010","start":0,"end":114,"exact":"The ongoing political abuse was also criticized by the opposition N!DA movement in a statement issued on Facebook:"},{"@id":"urn:doxa:decision:adecfe777f2b2b5923659625a14b7845","@type":["doxa:Decision","prov:Entity"],"recordId":"adecfe777f2b2b5923659625a14b7845","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:c