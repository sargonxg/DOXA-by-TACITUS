665f18b950002203dd22c29bbf39164efd454f43761190c2a4eb1"]},{"@id":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-730766","title":"Oman detains activists over online posts criticizing projects that could destroy Dhofar Plain","author":"Gulf Center for Human Rights","translator":[],"publishedOn":"2021-03-08","sourceUrl":"https://globalvoices.org/2021/03/08/oman-detains-activists-over-online-posts-criticizing-projects-that-could-destroy-dhofar-plain/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"6b4eda5f88c44f9e9129518ca110f7f69401ab44fd5fd3d09011d3a429ddeec9","textSha256":"86575a11facebcd32180b58bab6a68f011f5296b798c4be6520950b22679d934","archivedRecordSha256":"0d866052c53c1636632fcb37f190b223b643433b8c8a73decb89d977fed2a8d7","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:9fd7880da0e80d3b24a037f7f96bf336:u_605041b0f687d50964fac158","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_605041b0f687d50964fac158","status":"accepted","fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336"},{"@id":"urn:doxa:unit:9fd7880da0e80d3b24a037f7f96bf336:u_bcf84c112d79dc1eec7bc4ba","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_bcf84c112d79dc1eec7bc4ba","status":"accepted","fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336"},{"@id":"urn:doxa:passage:5c690b235c4cbfa5c372cc85510bae89611c532e13909cc6bbb301f5037f60b6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00017","start":273,"end":909,"exact":"According to the Public Prosecution’s office in the city of Salalah, Dhofar's provincial capital, Dr Qatan “used the Internet to publish what would harm the public order by inflaming public opinion, undermining the integrity of the minister and those working with him, accusing them of corruption and favoritism while infringing on their personalities … through the social networking application Twitter.” The pubic prosecutor's referral letter alleged that Qatan had committed “a misdemeanor to use the Internet to publish information that would harm the public order, according to the text of Article 19 of the Omani Cyber Crime Law”."},{"@id":"urn:doxa:passage:9e865ae91fbda64622b94d812442b1733724949591cc5836e19fecbd68017267","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00018","start":0,"end":260,"exact":"The Public Prosecution requested the court to confiscate the device used for the tweets in accordance with the provisions of Article 32/A, with the Twitter account used being permanently closed in accordance with the provisions of Article 32/B of the same law."},{"@id":"urn:doxa:passage:2da8e6914153ed30b32d93ae5039e44634ad44d488f84184f3afc85082ab4993","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00019","start":0,"end":495,"exact":"Article 19 of Oman's Cyber Crime Law states: “Punishment by imprisonment for a period no less than a month and not exceeding three years and a fine of not less than one thousand Omani Rials ($2601) and not exceeding three thousand Omani Rials ($7803), or one of those two penalties, for whomever uses the information network or information technology means in the production, publication, distribution, purchase or Possession of anything that would prejudice religious values ​​or public order.”"},{"@id":"urn:doxa:passage:3c7a5e95b990b34dc31a67d768cffb7e0322fbaf094fae0f678e0850c88f76a7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00020","start":0,"end":150,"exact":"Both GCHR and OAHR condemned in the strongest terms the arrest campaign led by the ISS against all environmental defenders in the Dhofar Governorate. "},{"@id":"urn:doxa:passage:680c03d3bdc356a2bab05ae18916334cc14d49163f877ef3f7671e00041a17f0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00020","start":150,"end":240,"exact":"The human rights groups called on the ISS to immediately release the three activists, Dr. "},{"@id":"urn:doxa:passage:fbf86bc8f1b2ac984b71b110a0e3516bde54fb7c9eb45777ae9a2e06a7770ec8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00020","start":240,"end":496,"exact":"Ahmed Issa Qatan, poet Salem Ali Al-Maashani and Internet activist Amer Muslim Bait Saeed (Amr Al-Hkli), and put an immediate end to “the policy of silencing other opinions and systematically targeting human rights defenders, including Internet activists.”"},{"@id":"urn:doxa:passage:8262853870b5dc40ca7c33064f711e54ca451903a84c828744d3550e57957b54","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00021","start":0,"end":320,"exact":"The two human rights groups also said that Omani authorities are taking advantage of the current exceptional situation imposed by the Coronavirus (Covid-19) pandemic to pass their plans to transfer authority of the Dhofar Plain at a time when citizens are preoccupied with matters of their health and self-preservation. "},{"@id":"urn:doxa:passage:b4a0878a3992dbf4d0305df91aa521d8b6862a2a1d41b5f9e30a4a992f3a573d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00021","start":320,"end":475,"exact":"“The authorities in Oman must respect public freedoms, including freedom of expression and opinion, on and off the Internet,” the human rights groups said."},{"@id":"urn:doxa:decision:983e111a64f77b1d96870a7c2ac1c018","@type":["doxa:Decision","prov:Entity"],"recordId":"983e111a64f77b1d96870a7c2ac1c018","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:9fd7880da0e80d3b24a037f7f96bf336:u_605041b0f687d50964fac158","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:5c690b235c4cbfa5c372cc85510bae89611c532e13909cc6bbb301f5037f60b6","urn:doxa:passage:9e865ae91fbda64622b94d812442b1733724949591cc5836e19fecbd68017267","urn:doxa:passage:2da8e6914153ed30b32d93ae5039e44634ad44d488f84184f3afc85082ab4993","urn:doxa:passage:3c7a5e95b990b34dc31a67d768cffb7e0322fbaf094fae0f678e0850c88f76a7","urn:doxa:passage:680c03d3bdc356a2bab05ae18916334cc14d49163f877ef3f7671e00041a17f0","urn:doxa:passage:fbf86bc8f1b2ac984b71b110a0e3516bde54fb7c9eb45777ae9a2e06a7770ec8","urn:doxa:passage:8262853870b5dc40ca7c33064f711e54ca451903a84c828744d3550e57957b54","urn:doxa:passage:b4a0878a3992dbf4d0305df91aa521d8b6862a2a1d41b5f9e30a4a992f3a573d"]},{"@id":"urn:doxa:decision:79c75027c20fd3c1d1f8d382af14871f","@type":["doxa:Decision","prov:Entity"],"recordId":"79c75027c20fd3c1d1f8d382af14871f","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","scoredUnit":"urn:doxa:unit:9fd7880da0e80d3b24a037f7f96bf336:u_605041b0f687d50964fac158","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:5c690b235c4cbfa5c372cc85510bae89611c532e13909cc6bbb301f5037f60b6","urn:doxa:passage:9e865ae91fbda64622b94d812442b1733724949591cc5836e19fecbd68017267","urn:doxa:passage:2da8e6914153ed30b32d93ae5039e44634ad44d488f84184f3afc85082ab4993","urn:doxa:passage:3c7a5e95b990b34dc31a67d768cffb7e0322fbaf094fae0f678e0850c88f76a7","urn:doxa:passage:680c03d3bdc356a2bab05ae18916334cc14d49163f877ef3f7671e00041a17f0","urn:doxa:passage:fbf86bc8f1b2ac984b71b110a0e3516bde54fb7c9eb45777ae9a2e06a7770ec8","urn:doxa:passage:8262853870b5dc40ca7c33064f711e54ca451903a84c828744d3550e57957b54","urn:doxa:passage:b4a0878a3992dbf4d0305df91aa521d8b6862a2a1d41b5f9e30a4a992f3a573d"]},{"@id":"urn:doxa:decision:c71f459d22a4b0bc5400f00799e0ef48","@type":["doxa:Decision","prov:Entity"],"recordId":"c71f459d22a4b0bc5400f00799e0ef48","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","scoredUnit":"urn:doxa:unit:9fd7880da0e80d3b24a037f7f96bf336:u_605041b0f687d50964fac158","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:5c690b235c4cbfa5c372cc85510bae89611c532e13909cc6bbb301f5037f60b6","urn:doxa:passage:9e865ae91fbda64622b94d812442b1733724949591cc5836e19fecbd68017267","urn:doxa:passage:2da8e6914153ed30b32d93ae5039e44634ad44d488f84184f3afc85082ab4993","urn:doxa:passage:3c7a5e95b990b34dc31a67d768cffb7e0322fbaf094fae0f678e0850c88f76a7","urn:doxa:passage:680c03d3bdc356a2bab05ae18916334cc14d49163f877ef3f7671e00041a17f0","urn:doxa:passage:fbf86bc8f1b2ac984b71b110a0e3516bde54fb7c9eb45777ae9a2e06a7770ec8","urn:doxa:passage:8262853870b5dc40ca7c33064f711e54ca451903a84c828744d3550e57957b54","urn:doxa:passage:b4a0878a3992dbf4d0305df91aa521d8b6862a2a1d41b5f9e30a4a992f3a573d"]},{"@id":"urn:doxa:decision:0ba89d5a09022e0533737ce9a1c26ddd","@type":["doxa:Decision","prov:Entity"],"recordId":"0ba89d5a09022e0533737ce9a1c26ddd","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","scoredUnit":"urn:doxa:unit:9fd7880da0e80d3b24a037f7f96bf336:u_605041b0f687d50964fac158","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:5c690b235c4cbfa5c372cc85510bae89611c532e13909cc6bbb301f5037f60b6","urn:doxa:passage:9e865ae91fbda64622b94d812442b1733724949591cc5836e19fecbd68017267","urn:doxa:passage:2da8e6914153ed30b32d93ae5039e44634ad44d488f84184f3afc85082ab4993","urn:doxa:passage:3c7a5e95b990b34dc31a67d768cffb7e0322fbaf094fae0f678e0850c88f76a7","urn:doxa:passage:680c03d3bdc356a2bab05ae18916334cc14d49163f877ef3f7671e00041a17f0","urn:doxa:passage:fbf86bc8f1b2ac984b71b110a0e3516bde54fb7c9eb45777ae9a2e06a7770ec8","urn:doxa:passage:8262853870b5dc40ca7c33064f711e54ca451903a84c828744d3550e57957b54","urn:doxa:passage:b4a0878a3992dbf4d0305df91aa521d8b6862a2a1d41b5f9e30a4a992f3a573d"]},{"@id":"urn:doxa:decision:3a88d2883474b75bf7224b9255f58bf0","@type":["doxa:Decision","prov:Entity"],"recordId":"3a88d2883474b75bf7224b9255f58bf0","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:9fd7880da0e80d3b24a037f7f96bf336:u_605041b0f687d50964fac158","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:5c690b235c4cbfa5c372cc85510bae89611c532e13909cc6bbb301f5037f60b6","urn:doxa:passage:9e865ae91fbda64622b94d812442b1733724949591cc5836e19fecbd68017267","urn:doxa:passage:2da8e6914153ed30b32d93ae5039e44634ad44d488f84184f3afc85082ab4993","urn:doxa:passage:3c7a5e95b990b34dc31a67d768cffb7e0322fbaf094fae0f678e0850c88f76a7","urn:doxa:passage:680c03d3bdc356a2bab05ae18916334cc14d49163f877ef3f7671e00041a17f0","urn:doxa:passage:fbf86bc8f1b2ac984b71b110a0e3516bde54fb7c9eb45777ae9a2e06a7770ec8","urn:doxa:passage:8262853870b5dc40ca7c33064f711e54ca451903a84c828744d3550e57957b54","urn:doxa:passage:b4a0878a3992dbf4d0305df91aa521d8b6862a2a1d41b5f9e30a4a992f3a573d"]},{"@id":"urn:doxa:decision:0c134086513c7b24682098bdba98eb1d","@type":["doxa:Decision","prov:Entity"],"recordId":"0c134086513c7b24682098bdba98eb1d","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:9fd7880da0e80d3b24a037f7f96bf336:u_605041b0f687d50964fac158","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:5c690b235c4cbfa5c372cc85510bae89611c532e13909cc6bbb301f5037f60b6","urn:doxa:passage:9e865ae91fbda64622b94d812442b1733724949591cc5836e19fecbd68017267","urn:doxa:passage:2da8e6914153ed30b32d93ae5039e44634ad44d488f84184f3afc85082ab4993","urn:doxa:passage:3c7a5e95b990b34dc31a67d768cffb7e0322fbaf094fae0f678e0850c88f76a7","urn:doxa:passage:680c03d3bdc356a2bab05ae18916334cc14d49163f877ef3f7671e00041a17f0","urn:doxa:passage:fbf86bc8f1b2ac984b71b110a0e3516bde54fb7c9eb45777ae9a2e06a7770ec8","urn:doxa:passage:8262853870b5dc40ca7c33064f711e54ca451903a84c828744d3550e57957b54","urn:doxa:passage:b4a0878a3992dbf4d0305df91aa521d8b6862a2a1d41b5f9e30a4a992f3a573d"]},{"@id":"urn:doxa:passage:e168113133a98395ef6dc9fbffb58b61b2c36ed344362e823e2a20cfe89da24e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00001","start":0,"end":213,"exact":"Editor's note: This post was written and published by Gulf Centre for Human Rights, an independent, nonprofit organization that promotes freedom of expression, association and peaceful assembly in the MENA region."},{"@id":"urn:doxa:passage:6ebd5d3c6e8a7ee54dbc4a8df53614f07a2d3050121e8eee661a613f1ecac24f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00002","start":0,"end":249,"exact":"Omani security authorities in Dhofar Governorate is cracking down on online activists who oppose the governor's development plans that will change the sultanate's southern region and wipe away parts of its landscape that have survived for centuries."},{"@id":"urn:doxa:passage:bfe833caa33bfcd9e1d519fdbc0c12f9c310d3d67232e3adfd8e76d044d6e744","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00003","start":0,"end":213,"exact":"Poet Salem Ali Al-Maashani and Amer Muslim Bait Saeed were detained on Sunday February 28, Gulf Centre for Human Rights (GCHR) and the Omani Association for Human Rights (OAHR) have learned from reliable sources. "},{"@id":"urn:doxa:passage:627ab1c392adffbce1f9188577dc4c1fa8687bafece7d94295b6d5a51824ea7e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00003","start":213,"end":413,"exact":"The arrests are a result of the Internal Security Service's (ISS) campaign against activists seeking to preserve the traditional way of life in the Dhofar Plain that has existed for hundreds of years."},{"@id":"urn:doxa:passage:d9f45e9220a931e6aa44c3cb80fb22254fb500de276a8227d815e588dda088cd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00004","start":0,"end":228,"exact":"The Dhofar province is a tourist attraction for its exquisite scenery which includes vast expansions of fertile lands straddling valleys and mountains, as well as a lush coastal plain that hosts Salalah, the provincial capital. "},{"@id":"urn:doxa:passage:4b8943d82591b356bb34e8e9c7b38709793a8a7171cf5fc3dc8e019b26363afb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00004","start":228,"end":301,"exact":"Camel herders roam these areas freely, undeterred by urban constructions."},{"@id":"urn:doxa:passage:921799b39abab9c9847fdf3b928ca7c76b938c1423b952cb5754d4899271202b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00005","start":0,"end":221,"exact":"The detained activists rejected the government's plans to transfer control over the Dhofar Plain to the Ministry of Housing and Urban Planning, which will allow the construction of housing complexes in these green spaces."},{"@id":"urn:doxa:passage:f44370e5d69eee88a408801b6024cbee804798409838531a2ded404e453c14dc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00006","start":0,"end":259,"exact":"Internet activist Bait Saeed, who manages a popular YouTube channel under the name “Amr Al-7kli” in which he publishes video clips of beaches and various places in the Dhofar Governorate to promote tourism, was briefly detained for Twitter posts he published."},{"@id":"urn:doxa:passage:f3383a633eace989d8f424d9ca7ad2d1a3c1acf4ef05fa10e39ebd764871ab96","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00007","start":0,"end":54,"exact":"On 13 February 2021, he posted on his Twitter account:"},{"@id":"urn:doxa:passage:0b5ad87483459944ef67324ed8e68b8bad888c3b8d95614fecfd05bfc8568fd7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00008","start":0,"end":20,"exact":"> Weird paradoxes !!"},{"@id":"urn:doxa:passage:a6e86ec82c84904c9ebe6255060756b1d8f3cd26c23f0ffef6e8755d338d3950","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00009","start":0,"end":260,"exact":"> Some citizens get to enjoy camel festivals being organized for them to support and encourage them, and at the same time, and on a different side, festivals are canceled for others who are forced to leave their pastures and are displaced from their homeland. "},{"@id":"urn:doxa:passage:80afbb30db003a41e0419d2b3b2ebff3e6e7221b9bd222decab4c98e00f17013","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00009","start":260,"end":322,"exact":"Are all citizens equal in this country? #Transfer_Sahel_Dhofar"},{"@id":"urn:doxa:passage:1a791f494ebd99a747acbe8c839392b704a8582c500fb37ef46f22583bac7a4a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00010","start":0,"end":90,"exact":"He was released on Monday, March 8, after Salalah's Court of First Instance acquitted him."},{"@id":"urn:doxa:passage:b54ea9d7585b64acbf2fcabe02cca140f6e6ff2f5bed49e1ff4f10822c2c133d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00011","start":0,"end":198,"exact":"Reliable local sources stated that Bait Saeed and Al-Maashani were held by the Special Division of the Salalah Police Command, which summoned and arrested them as soon as they presented themselves. "},{"@id":"urn:doxa:passage:bc89b2e205629dd4981731d5905a7c96eb1b1496e3203c493cad32d205ed7fde","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00011","start":198,"end":335,"exact":"The Special Division, which represents the executive arm of the ISS, executes, on its behalf, arrest and detention orders for activists. "},{"@id":"urn:doxa:passage:cc0d80de8fa820aaa9c816e1791f28eb60b78023ffa2e2c836456e4d6c68d48e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00011","start":335,"end":566,"exact":"These same sources confirmed that the Special Division also summoned a number of Twitter activists in the Dhofar Governorate who were forced to sign pledges not to tweet on the issue of transferring authority over the Dhofar Plain."},{"@id":"urn:doxa:passage:06e1cf4dc00f52e0522098af1e7719ae83a9a0de26eb05cfcb89d08171b9ef3c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00012","start":0,"end":180,"exact":"On his Twitter page, poet Al-Maashani wrote a thread of posts in February criticizing the governor and warning of the implications of transferring the authority over Dhofar Plain. "},{"@id":"urn:doxa:passage:c932a67c71b5f63c29858b026c32a281195517eb5aa270d6dce72d490bf60297","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00012","start":180,"end":200,"exact":"The thread included:"},{"@id":"urn:doxa:passage:5f4d4e9b2abf91f8f933b3abb2187241d0d426a9205a4c6354d31d35ba33bcc6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00013","start":0,"end":145,"exact":"> #Transfering_Dhofar_Plain_Authority Dhofar as a whole is against this decision, which is imposed on them without consultation or consideration,"},{"@id":"urn:doxa:passage:c93f768cb16dd1c5c41ea22283a6cae18012d52ad34a906f0dbcac73594113e1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00014","start":0,"end":154,"exact":"> It has also previously stood against similar decisions, not to mention some orders that resulted in clashes between tribes, and with the state at times,"},{"@id":"urn:doxa:passage:ad05e3831589be2fe9d1d24f66cab20994e1d22f839258824cb22807c1112697","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00015","start":0,"end":96,"exact":"> Today, we call on Sultan Haitham, in order to avoid such crises, to #dismiss_governo_of_Dhofar"},{"@id":"urn:doxa:passage:cdf95a7d561eb2c7ec03f3c4acc327e08af443ca0c6670771f8d0f156dc7ea50","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00016","start":0,"end":421,"exact":"On 25 February 2021, Al-Maashani published a tweet pointing out “the importance of drawing all components of the society and involving them in this issue to draw up a road map in line with the interest of the homeland and the citizen.” In another tweet posted on 23 February, he called on the authorities to respect freedom of opinion and expression, as stipulated in Articles 18, 29 and 31 of the Basic Law of the State."},{"@id":"urn:doxa:passage:c1ebec62544c70716ceab7d7c7cddd6b16353cb945ce1f2ceea0e121d8d903ab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00017","start":0,"end":40,"exact":"In a similar case, environmentalist Dr. "},{"@id":"urn:doxa:passage:8f80b57590f0f8ca89ca1bbddb147fadaf24e2973928c65a73026052bb3dd69c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00017","start":40,"end":165,"exact":"Ahmed Issa Qatan was detained on 23 February 2021, on charges of using social media in ways that could disrupt public order. "},{"@id":"urn:doxa:passage:113dc908b3f01be7fb6c0d9d7d4b9a2d82e19015f5f31b102538414f6088a921","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:9fd7880da0e80d3b24a037f7f96bf336","blockId":"gv-730766-b00017","start":165,"end":273,"exact":"Qatan, who was released on bail on Monday March 8, had also spoken out against the governor's Dhofar plans. "},{"@id":"urn:doxa:decision:1415df27366acb4a9722c3722ebc9f10","@type":["doxa:Decision","prov:Entity"],"recordId":"1415df27366acb4a9722c3722ebc9f10","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:9fd7880da0e80d3b24a037f7f96bf336:u_bcf84c112d79dc1eec7bc4ba","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:e168113133a98395ef6dc9fbffb58b61b2c36ed344362e823e2a20cfe89da24e","urn:doxa:passage:6ebd5d3c6e8a7ee54dbc4a8df53614f07a2d3050121e8eee661a613f1ecac24f","urn:doxa:passage:bfe833caa33bfcd9e1d519fdbc0c12f9c310d3d67232e3adfd8e76d044d6e744","urn:doxa:passage:627ab1c392adffbce1f9188577dc4c1fa8687bafece7d94295b6d5a51824ea7e","urn:doxa:passage:d9f45e9220a931e6aa44c3cb80fb22254fb500de276a8227d815e588dda088cd","urn:doxa:passage:4b8943d82591b356bb34e8e9c7b38709793a8a7171cf5fc3dc8e019b26363afb","urn:doxa:passage:921799b39abab9c9847fdf3b928ca7c76b938c1423b952cb5754d4899271202b","urn:doxa:passage:f44370e5d69eee88a408801b6024cbee804798409838531a2ded404e453c14dc","urn:doxa:passage:f3383a633eace989d8f424d9ca7ad2d1a3c1acf4ef05fa10e39ebd764871ab96","urn:doxa:passage:0b5ad87483459944ef67324ed8e68b8bad888c3b8d95614fecfd05bfc8568fd7","urn:doxa:passage:a6e86ec82c84904c9ebe6255060756b1d8f3cd26c23f0ffef6e8755d338d3950","urn:doxa:passage:80afbb30db003a41e0419d2b3b2ebff3e6e7221b9bd222decab4c98e00f17013","urn:doxa:passage:1a791f494ebd99a747acbe8c839392b704a8582c500fb37e