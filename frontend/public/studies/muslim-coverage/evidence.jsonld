7e6bad8357f55cce350e48debb8f8","urn:doxa:passage:cf606beeb1254ae20950369a1f80086bf8c44a55b82cfd1d44fa9f4fd4d5f161","urn:doxa:passage:e66a6dc81eeab8eb0ba75d89cda0b108ecf5ea6199ebdb6daa70c9f0c4a1fbba","urn:doxa:passage:7fc711aa28c396feebbf49ae7e57a53bb7f0731e84c5dc80a922c1d0d10f5044","urn:doxa:passage:79348e7b8f64adeb5c57a36d73bfb64ffc40a2d5f93c27a02ce7c81704d28d43","urn:doxa:passage:dc8ce0b0c94ae4dc9df9e70bf62ae6a227c66b23a10061c1ee3d46b78112a862","urn:doxa:passage:919767d95d0afc7ba6d1c52a91ba134bbb44699c3cc153e596cda116cb51df38","urn:doxa:passage:4df5f365d9cc2d89e7cee9532359e1103d9671c7aee389aa440abd2109bf60da","urn:doxa:passage:99f3e01b26df97c4fc3acc1a0e36fa64af1dd56df9180b9412ec6e41ec70d15f","urn:doxa:passage:74e2589206cb1702beaf1f1f2d45010e8ec58f5e295b638a0903ff2f15bb59f2","urn:doxa:passage:0e40682bc90b4270db62b8201b18be1d08efda5a600dca79e615bf7c7e9d75d8","urn:doxa:passage:b6269b0437d2aaf7248bd68c41645782dcd3b5ffd469d67df088c763e61f7470","urn:doxa:passage:7002c5d0ba97fd08343defa36a254f26b1aad5005d25544cb2f10e5bc829a5a2","urn:doxa:passage:5a3397322cff300b6096059062caa01453fb2d7095e3947d170ed8821c528ebe","urn:doxa:passage:82e4b22833e9a6c6174e64cb55f8b2b55b4d0efbb44f9e499feb9b2488415895","urn:doxa:passage:456c276ed27f76fabeec97b0da055c810a79d6b0d16587f03ec1851fa8374c26","urn:doxa:passage:c321023182d3eafbc01cde84f563265d4179c18fcd6552e4e0e04d31b9c42bae","urn:doxa:passage:2a06a61a68dda28244e760868c715b8496e394322c23a8c73810858cca2d5a35","urn:doxa:passage:23fcdb88f5a08103a71b7d0ff34b4a48510a5ab00bbaf4f3b84bfabd2ea874da","urn:doxa:passage:5bea37f0c4fa19b8b2253886100e62ca74195004beb68c6684bf794ce39160da","urn:doxa:passage:2a266d1fc1ac9dc4fe6eb1f89bcb903da4b9555edb79900c8be109f7bde7ab68","urn:doxa:passage:369b2315195ae49658f9c40639ee6ff3187ff80b47700ab74fd58edd6dc80935","urn:doxa:passage:debdaf9bb3eef2ed20044a25858af189848389ccc851683e3b02d76f73e38e60","urn:doxa:passage:8992b29efeb885e384bfd3637c6fece8672139fc99a978e6ef9e680f55358d15","urn:doxa:passage:66465f6f5d82312fc4ab2e51db65bff8f5d9fa706814de48054739fbfeae3d5f","urn:doxa:passage:0d67954eb98bd86f9a644250669e39015c529a489f161195d20c4ada293d13e8","urn:doxa:passage:8b4b68d49cec614526178637298ab44a5e34e8c03ff79dc57da11a638467e163"]},{"@id":"urn:doxa:passage:71cc078328984c98fbdacf370234a13dcd5038c17449587c31af4e11fafa80e2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00001","start":0,"end":218,"exact":"The Xinjiang Uyghur Autonomous Region (XUAR) in western China became known to the world through reports about the so-called “re-education camps,” in which the authorities held hundreds of thousands of local residents. "},{"@id":"urn:doxa:passage:0dbbba0bbd1cf45237e16e6a461d803ab2a7420ad3f1d29124cbb632ef325e94","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00001","start":218,"end":339,"exact":"Uyghurs, Kazakhs and representatives of other Turkic and Muslim ethnic groups were tried for any connections with Islam. "},{"@id":"urn:doxa:passage:f130c1ad44b9bbed3f5eca67babb85ce29d16f3d868c50b33b6cedd3ce6d53a6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00001","start":339,"end":571,"exact":"The Chinese authorities have portrayed the region as a source of instability and danger, citing separatist and terrorist threats, which enabled them to justify carrying out large-scale repressive measures against the local peoples. "},{"@id":"urn:doxa:passage:40c8797c785968958ca3c02057bacf27ba75b07660bc481ec597f9d0cf1e70e6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00001","start":571,"end":644,"exact":"Since the end of 2016, the situation in the region has remained critical."},{"@id":"urn:doxa:passage:2078104451ab4971704cca88cdc1238454fbeb0acd3cce05c9f0b6c2447ce60a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00002","start":0,"end":177,"exact":"According to the 2018 Human Rights Watch report, even though there had been repressions of Muslims of Turkic origin in XUAR before, a sharp escalation began at the end of 2016. "},{"@id":"urn:doxa:passage:bdb6a3e34301feabab876ee67d84ac2922b468b19bf32a5a90f7d786d521cff7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00002","start":177,"end":280,"exact":"Then, the former secretary of the Communist Party in Tibet, Chen Quanguo, was transferred to Xinjiang. "},{"@id":"urn:doxa:passage:77d13e039174d1fb86ad808a5f8aa4473dcc6d1b0a5ae76875cb535fc5b78a64","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00002","start":280,"end":493,"exact":"After his relocation, Quanguo introduced a policy of forced assimilation, in the process of which locals were detained under the pretext of fighting the “three forces of evil”: terrorism, extremism and separatism."},{"@id":"urn:doxa:passage:f9d8bc293a514f04e42232a20e55e69f0685ccae3155add406f912c05e4bb374","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00003","start":0,"end":183,"exact":"Having studied data from the XUAR prosecutor's office, HRW found out that between 2017 and 2021, almost 10 percent of the population — 540,826 people — were prosecuted in the region. "},{"@id":"urn:doxa:passage:b800ea02de4c75a13af44c06e5074f2d021624cfd636aadd0fc3cd35cde2ae2a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00003","start":183,"end":217,"exact":"Most of them are still in prison. "},{"@id":"urn:doxa:passage:6beaf0e0d8cd567a9f7343d970a325de801cf37d9eb8187cc39b63b9400c5c23","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00003","start":217,"end":303,"exact":"However, in 2019, many of the extrajudicial detention camps were gradually abolished. "},{"@id":"urn:doxa:passage:8104dfd3ea03e9cc51dbcd103f86ac996659e4d90e8ae5dbf3b9d42ce5ff1660","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00003","start":303,"end":534,"exact":"In the last couple of years, the region has seen “liberalization” with external controls weakening and the Chinese authorities actively organizing demonstrative visits, primarily for diplomats and journalists from Muslim countries."},{"@id":"urn:doxa:passage:f72b8df7e6c5b059d4b60799975727afc696da98a47bb8b06b06c91430dba4f8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00004","start":0,"end":256,"exact":"Global Voices spoke with Ivan Petrov (name changed for security reasons), a cultural expert from Belarus living in Southeast Asia, to discuss with him the different approaches Chinese authorities have employed to pacify the region in the last eight years. "},{"@id":"urn:doxa:passage:b058c2a4eccca3f0d3bd69d9117842c08635b6cc3e8e17ece86016e082b7d821","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00004","start":256,"end":301,"exact":"Petrov visited XUAR twice, in 2019 and 2023. "},{"@id":"urn:doxa:passage:54e912622b3c4a1bd245c0823b506ffa8527e8c0483dddfeda87a744a6ced051","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00004","start":301,"end":355,"exact":"The interview has been edited for brevity and clarity."},{"@id":"urn:doxa:passage:27337ae97f3696b786443dbeb77f1713d8c66f9b9010506d127c3483a1bf6e0d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00005","start":0,"end":83,"exact":"Global Voices (GV): What struck you the most in Xinjiang during your visit in 2019?"},{"@id":"urn:doxa:passage:0d1cc53cd397b924c5bc80bbc2a263c5c2ce2bd2c336c8f3b7852b0d1c991003","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00006","start":0,"end":389,"exact":"> Иван Петров (ИП): В 2019 г. меня поразила невероятная система надзора. Города были поделены на сектора, на каждом перекрестке – отделение полиции. От перекрестка до перекрестка по улицам медленно фланировали полицейские машины или даже броневики. На улицах также установлены металлические заграждения. Едешь на машине, останавливают, проверяют содержимое багажника, и кто сидит в салоне."},{"@id":"urn:doxa:passage:4f62a003ebf5171f39d0c36ec46c52626c09ca78cbe838ae576831e44e42178f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00007","start":0,"end":409,"exact":"> Во всех общественных местах, типа парков и рынков на входе – сканеры документов и лиц. В обычных магазинах, ресторанах, аптеках – рамки-металлоискатели, дежурят охранники. Даже при входе в некоторые жилые кварталы такие же металлоискатели. По улицам ходят тройки полицейских, вооруженных щитом, дубинкой со штыком и рогатиной с электрошокером. Останавливают молодых ребят, проверяют содержимое их телефонов."},{"@id":"urn:doxa:passage:8faae36884580d240eadf46ce526bd2ce1d0848c1acd2c292567a43489544344","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00008","start":0,"end":158,"exact":"> При въезде в любой город – блокпост с проверкой документов. Если с тобой какая-то проблема, тебя могут не выпустить из твоего города и не впустить в другой."},{"@id":"urn:doxa:passage:c2e23cc264983c55961f6bee5ea5f4ddee69bc836340a1ab24f8f187f1898b16","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00009","start":0,"end":168,"exact":"> Из того, что еще удивило по сравнению с фотографиями десятилетней давности – все мужчины молодого и среднего возраста гладко выбриты, женщины без религиозных платков."},{"@id":"urn:doxa:passage:9de8412a6d6c84fc1c8a75c806cbf7fef2023b2d433d315d9362c2ccf44cef27","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00010","start":0,"end":78,"exact":"> Ivan Petrov (IP): I was amazed by the incredible surveillance system there. "},{"@id":"urn:doxa:passage:0b45cfc184bbaf92b6a51f3baf0d0ae0df3f055def27f52b3d441854aa4542f1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00010","start":78,"end":160,"exact":"The cities were divided into sectors, with a police station at each intersection. "},{"@id":"urn:doxa:passage:f1910df6425dd74b4bcd3fd0c5eb1335d6aec14916b1673e378d15e1d3656ad8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00010","start":160,"end":260,"exact":"From intersection to intersection, police cars and armored vehicles slowly drove along the streets. "},{"@id":"urn:doxa:passage:e3bb6c1f4a4d0bc59355f757f3fd78a0f77b3dc3f649dee3ff99d79d0e3051d7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00010","start":260,"end":306,"exact":"Metal barriers were installed on the streets. "},{"@id":"urn:doxa:passage:fa8d7951d4fce5e64dc3420cde28c08f8f6bd8f1610aa17259e977dbe6f00948","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00010","start":306,"end":395,"exact":"Cars were stopped to check the contents of the trunk and see who is sitting in the cabin."},{"@id":"urn:doxa:passage:3cc0cab183e61e807171a2a54814cbe2e7c16cf70fe7d5e8d538ec7ced86ae61","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00011","start":0,"end":106,"exact":"> In all public places, such as parks and markets, there were document and face scanners at the entrance. "},{"@id":"urn:doxa:passage:c5a17df7e31214aff062ea516c1068cb2183055dafa395fe3621c0a0e787a371","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00011","start":106,"end":210,"exact":"In regular stores, restaurants, and pharmacies, there were metal detectors and security guards on duty. "},{"@id":"urn:doxa:passage:f7587fa4ed9bf78c1f8716cf8209347607bd915c10cf06874f273394b42662aa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:db00aad5283dda7c39b76257f3ff0143","blockId":"gv-810600-b00011","start":210,"end":286,"exact":"Even at the entrance to some residential areas, there were metal detectors. "},{"@id":"urn:doxa:decision:67233f738ce87fb753117ced42bc4dfb","@type":["doxa:Decision","prov:Entity"],"recordId":"67233f738ce87fb753117ced42bc4dfb","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:db00aad5283dda7c39b76257f3ff0143:u_31b75094945d5b150e08d5d3","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:71cc078328984c98fbdacf370234a13dcd5038c17449587c31af4e11fafa80e2","urn:doxa:passage:0dbbba0bbd1cf45237e16e6a461d803ab2a7420ad3f1d29124cbb632ef325e94","urn:doxa:passage:f130c1ad44b9bbed3f5eca67babb85ce29d16f3d868c50b33b6cedd3ce6d53a6","urn:doxa:passage:40c879