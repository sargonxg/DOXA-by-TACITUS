ac9e356af52527800","urn:doxa:passage:d67f1d25dcb18ed8cd6e1e436b3a27db79c4c16b828c096d7ae1be83129c62ef","urn:doxa:passage:d34805308156398b8de92d2fada73ba3242d364d657d235838cd9104b7ebd2d3","urn:doxa:passage:a5ccc76d02867d9e40cf43e831a8c0ffd7eb617c166b952de006cbe96cfeb061","urn:doxa:passage:d46cb81eb0c4aafb1c96cbb33bf142b2ca81adac9413fbe0278895b2aede5ab5","urn:doxa:passage:593c49f50a89b84a63a31844df9f33cfe7434c63703132505d6d9048d38fa7f3","urn:doxa:passage:55d4ea145ea367be4c80b0bd5c8c4a850445758af0605a614a824bf61a7d1cd3","urn:doxa:passage:e924f18d3aa4f8a3016891165a533c36079d6e14b0696b52bde47903da457eab","urn:doxa:passage:f23aaec1e452bf8b09049eef94181e2a2d0ce8dfcbc0524b48aaf955ee874f10","urn:doxa:passage:ba47afec1f07a6bde3af22ad2a153deebb9c6fb364579acac14788a715b7e25c","urn:doxa:passage:0ca37a3b4dba94dd31cbb7090889f204477f5584c7edee38517459c42270424c","urn:doxa:passage:e60146a61df8371d79ab02c6ca8d5a0b148c9dfaea02e6f6fe837b252b58418c","urn:doxa:passage:e621643a92051e806c5432f366c92e21816f16fcc0cf306aad794b3384184abf"]},{"@id":"urn:doxa:passage:b9718d8cb654b77e851ad2dbed2ed851d8edfef1093fdaa51f8c9c4abb045339","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00001","start":0,"end":99,"exact":"In May 2022, on the eve of the visit of a United Nations delegation led by Michelle Bachelet, U.N. "},{"@id":"urn:doxa:passage:61b5b865c5059d44b7f8206cd0512d01fcb34d29488d55cf1aea000c42cf6b24","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00001","start":99,"end":312,"exact":"High Commissioner for Human Rights, to Xinjiang, the autonomous region in the northwest of China, an Uyghur-American journalist Shohret Hoshur urged us to publish his open letter to the head of the UN delegation. "},{"@id":"urn:doxa:passage:a59346619f803836599c4683a9232b55488ad82f2f3875025b291e21bf930829","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00001","start":312,"end":578,"exact":"As this is the first ever visit of a human rights commissioner to China for the past 17 years, all eyes are on her amid allegations of serious human rights violations, genocide and crimes against humanity against Uyghurs and other Muslim minority groups in Xinjiang."},{"@id":"urn:doxa:passage:055b2553910db050a9c11cec9c79b98876ecc0a65163ae18e3b4a629a5e49d4b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00002","start":0,"end":23,"exact":"As is evident from Mr. "},{"@id":"urn:doxa:passage:fb51d5c1d544674294b3dfd621a40daac589f799f5f8bbdfb892d7cb6ad12bee","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00002","start":23,"end":233,"exact":"Hoshur’s letter, 11 members of his immediate family have either been arrested, detained or there is no information about their whereabouts — a common story for many Uygur and other Muslim families in Xinjiang. "},{"@id":"urn:doxa:passage:23d2ac64186a23385147665016c6bf18b78fd53916522d6b6c2c2d6b6b8d7fba","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00002","start":233,"end":251,"exact":"He appeals to Ms. "},{"@id":"urn:doxa:passage:2974a1a085669295eac9f8eb5133632ce184b1591dc31b47764955fafe094373","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00002","start":251,"end":380,"exact":"Bachelet for justice, transparency, and resoluteness, just like many human rights organizations urge her to adhere to principles:"},{"@id":"urn:doxa:passage:354769208a5a799370b93b5b65b6b3b229bfc84ca661708fbe9b8519cfdbf16b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00003","start":0,"end":9,"exact":"Dear Ms. "},{"@id":"urn:doxa:passage:b67d20a20d72f2c6cb3e6ea9efb182ed00812a130a98acfd3860298cbfb89d99","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00003","start":9,"end":18,"exact":"Bachelet:"},{"@id":"urn:doxa:passage:7017bc2281994536160f5e4abce0db9bd65e97fe57bf1b30c81f55fc29c3ff27","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00004","start":0,"end":302,"exact":"My brother, Shawket Hoshur, had a recurring dream during his first detention in Urumchi, the capital city of “Xinjiang” Uyghur Autonomous Region: “I was always dreaming that a group of foreigners stepped into our cell and asked, ‘Are you the brother of Shohret Hoshur, the Uyghur-American journalist?’”"},{"@id":"urn:doxa:passage:5652f6428c6d73912bf9c60e99a3b533b41e983f3d58e40c4400f2a5aa744016","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00005","start":0,"end":166,"exact":"He told my mother, Tuhan Musa, about this dream on December 31, 2015, when he was released from detention as a result of the US government’s involvement in his case. "},{"@id":"urn:doxa:passage:5ec0199b3c50183422229340c68744df17a28f633bd94a6d9c3bfee0757b10af","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00005","start":166,"end":261,"exact":"He has been in detention again since September 2017, along with 11 other members of my family. "},{"@id":"urn:doxa:passage:657e4dbe9884c97d837b9c393c85e8af4dc05322be3314381c7fcf32a2f8bcd1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00005","start":261,"end":343,"exact":"I believe that my relatives have all had the same dream over the past five years. "},{"@id":"urn:doxa:passage:c24158f2d1635cc93132c346194bb29af154803c19d2f1dfe090ac5b854582d6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00005","start":343,"end":399,"exact":"Unfortunately, my 82-year-old mother is now among them. "},{"@id":"urn:doxa:passage:e9fa233518c25f0ea26e2d92f509af46b34959858416d263227b6de9e8bcb7cd","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00005","start":399,"end":512,"exact":"They dreamed of this because they knew they were jailed because of my job with Radio Free Asia (RFA) in the USA. "},{"@id":"urn:doxa:passage:24032ecd35422422f33afaf88b6c6232b58e0ad9807dee0350149427e9576826","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00005","start":512,"end":619,"exact":"They expected that the USA and the United Nations would help them get released, but so far, they have not. "},{"@id":"urn:doxa:passage:e0bea3342b835eda95b7c3e69fae81d2b4001bcd15aa4c21d8819224419a0091","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00005","start":619,"end":696,"exact":"I hope your visit could at least make my mother’s dream of release come true."},{"@id":"urn:doxa:passage:a73e88ebd30d86649f45fa0b61ef8aa61da07e5b3774e53287c3181f58ff94fc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00006","start":0,"end":205,"exact":"As a result of one intervention by the US government, in January 2016, my mother was allowed to keep in touch with me by phone as long as she did not speak about anything other than family-related issues. "},{"@id":"urn:doxa:passage:cf810755da971de8fa14a7eadccdff0cc8d9cc8af9840dbeb88ca31a6b1cd62e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00006","start":205,"end":316,"exact":"I then began “legally” talking to my mother and was kept informed about the situation with my other relatives. "},{"@id":"urn:doxa:passage:3f7190039af276da91a2c511c9b399bca20b57ceb4d579377ff22e041ee3db3f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00006","start":316,"end":612,"exact":"I learned that in September and October 2017, my elder brother, Shawket, and my youngest brother, Rahim, were detained again and taken to a so-called “vocational training center.” My mother said they were selected for “education” because of a telephone call I had made to Ghulja (Yining) County. "},{"@id":"urn:doxa:passage:c26a6f34ea84d94a0a6f5fd49ae69d59b9a9b0ecc427ec7a15825a757e579403","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00006","start":612,"end":762,"exact":"When I asked how she learned about that, she said: “I was warned, ‘more troubles will come if your son in the USA does not stop instigating trouble’.”"},{"@id":"urn:doxa:passage:65a5624458f254510a76ee4abb040a838d875f5a1b4fcca1cc3b268ee3f7a722","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00007","start":0,"end":111,"exact":"I had called the officials in Ghulja County in August 2017 and exposed the county’s fourth reeducation center. "},{"@id":"urn:doxa:passage:58b8b928a6ad7b9c4a660337efda57f37f7f40155e9c40b36e7241aec162b576","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00007","start":111,"end":439,"exact":"That was the first clear and detailed information reported about one of the mass detention camps, including its location, name, the number of students, and the students’ so-called “crimes.” My mother later informed me that my two nephews and two brothers-in-law were taken to the training center between January and March 2018. "},{"@id":"urn:doxa:passage:267dc0eb08f677f8990a699c1ec513da8aebc2eb045b85ce32ba6de7c360dfec","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00007","start":439,"end":692,"exact":"When I last spoke to my mother in April 2018, my detained relatives numbered 11, and she said: “Now, it seems I will be the next one to be taken because they said, ‘You crossed the line when you spoke with Shohret’; please don’t call me for two months.”"},{"@id":"urn:doxa:passage:59c8ed791a4c61f1f5110a68ed63e6b0c1afa33ac540c4722413f1a6b5055957","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00008","start":0,"end":100,"exact":"The week before, my mother had said: “I cried a lot last time (when my two brothers were detained). "},{"@id":"urn:doxa:passage:08e39a6b1a60e6674771d908d58584bbf56d7e5b102c19f250539b599b2bb72c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00008","start":100,"end":259,"exact":"This year, even though 10 people from my family have been taken, I didn’t cry much because this time it was happening to all the families in our neighborhood. "},{"@id":"urn:doxa:passage:4e7f8e9f9222bb4f9b4be7176c2af7f821130e550c8b6b77a284a654f4fb5605","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:42d90b4c13d9df644b08b64ee1ef964e","blockId":"gv-762708-b00008","start":259,"end":454,"exact":"I feel that sharing the same problem with others gives you comfort.” Her statement about the neighborhood may have been considered by officials as “crossing the line” and leaking a state secret. "},{"@id":"urn:doxa:decision:ac34b46ae64a380fa869db68876afffc","@type":["doxa:Decision","prov:Entity"],"recordId":"ac34b46ae64a380fa869db68876afffc","outcome":"does_not_meet","ge