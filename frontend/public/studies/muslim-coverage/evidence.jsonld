3b75c344e42012b1e8cdd4e720ed3c8205237b72dd0f1a423bc","urn:doxa:passage:6cee3cf71f009ec5318b1835fa0506487676df54d02d56a6524d9f13d77506fe","urn:doxa:passage:86b2f1ccbc40826b66b28d555b6af7618c1b9b44bfa66b00cd349430b0dcfd58","urn:doxa:passage:dab3395edad1d718d60b7f928c6f9be2d84e30f5f7fe04c0f2463833e4879bfd"]},{"@id":"urn:doxa:decision:7abff3b212eafeebafc374c718cb478f","@type":["doxa:Decision","prov:Entity"],"recordId":"7abff3b212eafeebafc374c718cb478f","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:dec261d5c47a14ff6f55155f34aca257:u_07b7fd7720702c1d361bc623","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cda9a281f36bd3b75c344e42012b1e8cdd4e720ed3c8205237b72dd0f1a423bc","urn:doxa:passage:6cee3cf71f009ec5318b1835fa0506487676df54d02d56a6524d9f13d77506fe","urn:doxa:passage:86b2f1ccbc40826b66b28d555b6af7618c1b9b44bfa66b00cd349430b0dcfd58","urn:doxa:passage:dab3395edad1d718d60b7f928c6f9be2d84e30f5f7fe04c0f2463833e4879bfd"]},{"@id":"urn:doxa:decision:7bac48f315332372575eecb29ae5ab0e","@type":["doxa:Decision","prov:Entity"],"recordId":"7bac48f315332372575eecb29ae5ab0e","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:dec261d5c47a14ff6f55155f34aca257:u_07b7fd7720702c1d361bc623","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cda9a281f36bd3b75c344e42012b1e8cdd4e720ed3c8205237b72dd0f1a423bc","urn:doxa:passage:6cee3cf71f009ec5318b1835fa0506487676df54d02d56a6524d9f13d77506fe","urn:doxa:passage:86b2f1ccbc40826b66b28d555b6af7618c1b9b44bfa66b00cd349430b0dcfd58","urn:doxa:passage:dab3395edad1d718d60b7f928c6f9be2d84e30f5f7fe04c0f2463833e4879bfd"]},{"@id":"urn:doxa:passage:6520f54f56f9f0276244f6222ab7ceedcf606f567fbb458d17f83bbb3cc79a5c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00001","start":0,"end":106,"exact":"Filipinos are mourning the death of Pope Francis, who died on April 21, at the age of 88, in the Vatican. "},{"@id":"urn:doxa:passage:2d39328e7b038d91d6531d48bc000f359ae348afb3c8c794c731501d9c4348c5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00001","start":106,"end":388,"exact":"Pope Francis was from Buenos Aires, Argentina, and was renowned for bringing progressive change to the Catholic church, advocating for peace and environmental protections, promoting interfaith dialogue, speaking out against capitalism and war, and for being a champion for the poor."},{"@id":"urn:doxa:passage:b1399e8ebf88b6ae5ae290b1a67eb1113b90e3eb279fc317f1b41de174cfd3a4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00002","start":0,"end":151,"exact":"He was also the first pontiff from outside Europe in centuries and often used his platform to embrace and advocate for Catholics from the Global South."},{"@id":"urn:doxa:passage:11f748f0fd6bfee0229fe2feadd786b941c40fe55f490e211aefadc2f4269da7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00003","start":0,"end":73,"exact":"Almost 80 percent of the Philippines’ 108 million population is Catholic."},{"@id":"urn:doxa:passage:7f54ac924879b0913c2af372bf63e3788c81b069b6499d79a1decc627c678bf5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00004","start":0,"end":170,"exact":"During Pope Francis’ pastoral trip to the Philippines in 2015, he met not just church and government leaders but also street children, students, and urban poor dwellers. "},{"@id":"urn:doxa:passage:b39cc45592b4b7cac910cb0a46a3cf2ff06c3948e35e1a671c64c799c115bec2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00004","start":170,"end":292,"exact":"He even visited Tacloban City, which was heavily battered by a super typhoon, to express solidarity with disaster victims."},{"@id":"urn:doxa:passage:16bd460129640a68e8e064ccb63e41d3a4f531e749a4cd495f1a5b5f4a66dc5e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00005","start":0,"end":98,"exact":"The Philippine government declared a period of mourning until the burial of the pope on April 26. "},{"@id":"urn:doxa:passage:c9289bdc125b0117d57adcfb21076e447ccd31a1c638baf2ef1b71769fe86431","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00005","start":98,"end":286,"exact":"Catholic bishops, Christian formations, and even the Bangsamoro autonomous region in the Muslim-dominated region in the southern part of the country paid tribute to the legacy of the pope."},{"@id":"urn:doxa:passage:8d45c09ca83e5f457b841ad7fb3ae4380031cfb3852b70ac37eb2b79d8c54b4b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00006","start":0,"end":194,"exact":"Cardinal Orlando Quevedo from the Archdiocese of Cotabato recalled that Pope Francis was consistent in his advocacy to bring the church closer to the poor even before he became the pope in 2013."},{"@id":"urn:doxa:passage:b4c5426b8095943bc4ac868d94e2ce5204070b75ef6a5d868d4bc53497d195a2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00007","start":0,"end":144,"exact":"> His interventions at our Council discussions were usually about bringing the Gospel to the people in the peripheries, the poor and the needy. "},{"@id":"urn:doxa:passage:ca969767759cc4ba7f30fcbd5279299620345ec723ce51a4d0597b9f6192feeb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00007","start":144,"end":216,"exact":"Go to the periphery was his clarion call to the Church and her pastors. "},{"@id":"urn:doxa:passage:05f96e41fabaf6bcaf3e37d6dd8137d6ffc5f460649f317fbf1b75231c1fcf38","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00007","start":216,"end":295,"exact":"He himself was from the peripheries, not from Rome but from far away Argentina."},{"@id":"urn:doxa:passage:c31362d3c8744e5eed2c71af4ead59ca30ebd112e9bea2e18651c87096267b01","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00008","start":0,"end":161,"exact":"Pablo Virgilio Cardinal David, the head of the Catholic Bishops’ Conference of the Philippines (CBCP), wrote that the pope once paid homage to migrant Filipinos."},{"@id":"urn:doxa:passage:a8efcbb657a2b96b62b3c8d87e9a6dc0b11bad769b8dfe2bf48ab7abe3b0de66","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00009","start":0,"end":276,"exact":"> …with his characteristic wit and warmth, he once called our Overseas Filipino migrant workers ‘contrabandistas de la fe’ — smugglers of the faith —reminding us that the witness of simple, faithful lives can cross borders and touch hearts where formal missionaries cannot go."},{"@id":"urn:doxa:passage:b251a43e2f1160ab3aeb97f2dbb21acc5a9f59f958d77ecbe8d4232a23e8ade6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00010","start":0,"end":146,"exact":"Cardinal Jose Cardinal Advincula, the archbishop of Manila, praised the pope who braved a raging storm to meet with the Catholic faithful in 2015."},{"@id":"urn:doxa:passage:229bd3edbbdb6a761a892ebed8b2e5f2ab6b4102f10bd8baf6f2a2d2cb77387a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00011","start":0,"end":118,"exact":"> We will always remember his visit to our country in 2015 — a moment of grace forever etched in our national memory. "},{"@id":"urn:doxa:passage:e079c9c52d0268b1f08df0a1c5a1f20d2d9faadbc97d0d29fa3d939451bc3632","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00011","start":118,"end":288,"exact":"Under the rain in Tacloban, standing with the survivors of Typhoon Yolanda, Pope Francis showed us what it means to suffer with others and find hope in the midst of pain."},{"@id":"urn:doxa:passage:f71e5b2f39996627d10cd03bb8a51f155f0afcc5422530a9d8b7169c517d064c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00012","start":0,"end":96,"exact":"The post above mentions “Lolo Kiko,” which means “Grandfather Francis” in the Filipino language."},{"@id":"urn:doxa:passage:1099edbdfaf1c7735c1d5af3e95897afa5e72aea719dc5b49dd65500bc12c272","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00013","start":0,"end":112,"exact":"A Catholic university in Manila installed an exhibition that featured memorabilia from the pope’s visit in 2015."},{"@id":"urn:doxa:passage:2707d9842509a761eaa8ad1ed4e636f6263b8aebdc3f12faf0f44d18be00e7a1","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00014","start":0,"end":87,"exact":"Aside from church leaders, various sectors also recognized the legacy of Pope Francis. "},{"@id":"urn:doxa:passage:20316c0372156212cce1d11c227d581a7643475cf5b8366d0e469e8dc3540f42","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00014","start":87,"end":225,"exact":"Rise Up for Life and for Rights, whose members are relatives of anti-drug war victims, acknowledged the solidarity of the Catholic clergy."},{"@id":"urn:doxa:passage:86503b354d9c1d17087cf74eb91a2647f8080f936051d1f9e50f769c3f63edd7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00015","start":0,"end":296,"exact":"> When our loved ones were killed under the drug war policy, some Church leaders stood with us, when almost everyone else scattered… We know that Pope Francis encouraged and nurtured this solidarity with us, even though it resulted in bishops and other Church people being berated and threatened."},{"@id":"urn:doxa:passage:1c575051da756dfbd15d9973725d3abe2b5d1d0c5ab367575724c8eff306b1d0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00016","start":0,"end":185,"exact":"Kalikasan People’s Network for the Environment explained the historic importance of the pope’s decision to visit the “ground zero” of the super typhoon that hit the Philippines in 2015."},{"@id":"urn:doxa:passage:ae93802197bf8df7d781b66433fcf184570ea9ff0293796917ecd6e779842067","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00017","start":0,"end":99,"exact":"> For the Filipino people, Pope Francis’s solidarity was not just in words but in militant action. "},{"@id":"urn:doxa:passage:561faaab4ad916a6254deb7ace8dc428260ee054516a10fbbec3d1972e031040","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:dec261d5c47a14ff6f55155f34aca257","blockId":"gv-833089-b00017","start":99,"end":327,"exact":"His 2015 visit to the Philippines, especially to the storm-ravaged communities of Tacloban and Eastern Visayas after Typhoon Yolanda (Haiyan), was a direct rebuke to those who abandoned the survivors and profited from disaster. "},{"@id":"urn:doxa:decision:f8d7b72ebb2cb72cf571197b9acb12f4","@type":["doxa:Decision","prov:Entity"],"recordId":"f8d7b72ebb2cb72cf571197b9acb12f4","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:dec261d5c47a14ff6f55155f34aca257:u_5fe00af4987ef1964b9b2512","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:6520f54f56f9f0276244f6222ab7ceedcf606f567fbb458d17f83bbb3cc79a5c","urn:doxa:passage:2d39328e7b038d91d6531d48bc000f359ae348afb3c8c794c731501d9c4348c5","urn:doxa:passage:b1399e8ebf88b6ae5ae290b1a67eb1113b90e3eb279fc317f1b41de174cfd3a4","urn:doxa:passage:11f748f0fd6bfee0229fe2feadd786b941c40fe55f490e211aefadc2f4269da7","urn:doxa:passage:7f54ac924879b0913c2af372bf63e3788c81b069b6499d79a1decc627c678bf5","urn:doxa:passage:b39cc45592b4b7cac910cb0a46a3cf2ff06c3948e35e1a671c64c799c115bec2","urn:doxa:passage:16bd460129640a68e8e064ccb63e41d3a4f531e749a4cd495f1a5b5f4a66dc5e","urn:doxa:passage:c9289bdc125b0117d57adcfb21076e447ccd31a1c638baf2ef1b71769fe86431","urn:doxa:passage:8d45c09ca83e5f457b841ad7fb3ae4380031cfb3852b70ac37eb2b79d8c54b4b","urn:doxa:passage:b4c5426b8095943bc4ac868d94e2ce5204070b75ef6a5d868d4bc