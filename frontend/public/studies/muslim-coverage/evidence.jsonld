c6604e2463e00052dfe92ab79794e33c2ff52e03cb9fd5ae7de48ebc","urn:doxa:passage:b3e6a9d38ac8f2b1870642963d2b70e64329cd0903cbbf0aceb887082b850c97","urn:doxa:passage:654676727ad2f8dbd3562d52e013634225c45ce43bc2ad646af25550461bb544","urn:doxa:passage:174275a3e0494b474872944b015d6d018e8a18c86c3cc6caa18532133bc754bb","urn:doxa:passage:f70718a517579a4dc26d513fdc7fe67814b51600cc07c44cd64923e226a08c43","urn:doxa:passage:954b2f1f28d5ac9b6a064ec7eab7c92bc42540373a4af707a4f61a8abb727ec4","urn:doxa:passage:3031928583abdce1fb259a7043422fc889200a1c218ff5ad48d27f89ade6e761"]},{"@id":"urn:doxa:passage:3551483b4a36fd9f583ed6a48554da1f2a2935855eca27302dc475bab55afbc0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00012","start":32,"end":161,"exact":"Erdoğan needs Kurdish support in parliament in order to change the country’s constitution, to secure a fourth presidential term. "},{"@id":"urn:doxa:passage:8d5384e3f574783200af131317a6ca664e1fd326521cbab53b456a676c9b8f17","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00012","start":161,"end":364,"exact":"As it stands, Erdoğan’s Justice and Development Party (AKP)-led coalition lacks the required votes (360/600) and needs the votes of the Peoples’ Equality and Democracy Party (DEM, formerly HDP) members. "},{"@id":"urn:doxa:passage:a1ebaba80f1a8726a4ff9d55f7376ff6a7341669c9c2c0fb5cd9de7889da8de6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00012","start":364,"end":436,"exact":"The question is, what can Erdoğan offer DEM in return for their support?"},{"@id":"urn:doxa:passage:4747e2cb3d447b36c22f5b7d56a5251694f11000778bdc26aa72ce503ccbe7c8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00013","start":0,"end":87,"exact":"The Kurds’ motivation to help Erdoğan would be based on self-interest and realpolitik. "},{"@id":"urn:doxa:passage:5757531c9c2824208e6b556fd28e3ad5a746efd80af5c29c33dd4d2d8fa7063c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00013","start":87,"end":212,"exact":"In late 2024, Erdoğan and his far-right nationalist coalition ally, Devlet Bahçeli, began negotiating with DEM’s leadership. "},{"@id":"urn:doxa:passage:f1350ff35cdec992be4f1e744d3bc1946d30ed148d2ab8497a9fa564040fbf15","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00013","start":212,"end":380,"exact":"This came as a surprise, mainly because Bahçeli, who leads the ultra-far-right Nationalist Movement Party (MHP), is historically anti-Kurdish and anti-minority rights. "},{"@id":"urn:doxa:passage:487ee71b6baa2b110e7b75a04dec3bd5dadf1f209eb9bd290753d78b8698765d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00013","start":380,"end":476,"exact":"However, AKP and MHP by themselves lack the required number of seats to change the constitution."},{"@id":"urn:doxa:passage:fb54909c3589f55aa3696cc4910d5f555ff5cc451e47075eff2f9131da64b895","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00014","start":0,"end":144,"exact":"Rumors coming from the secretive deliberations between the AKP/MHP and DEM suggest that Erdoğan is preparing to announce the release of Öcalan. "},{"@id":"urn:doxa:passage:703c19c6695e74a867b4ea4537577b1514a2ffa2719364540cea9c49293d1d56","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00014","start":144,"end":244,"exact":"The inspirational figurehead has been in a Turkish prison since his capture and conviction in 1999. "},{"@id":"urn:doxa:passage:34fc1f1fd8ae17a32953010f784e898a77b5dfb1405ff7e8146f49eda771b80d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00014","start":244,"end":394,"exact":"Securing his release would be a big win for DEM, as he is widely regarded by Kurds internationally as being the Kurdish equivalent of Nelson Mandela. "},{"@id":"urn:doxa:passage:48fcdd2fe19d45c56729d5030afc769b0a322a3b9d3890868c17e081bdce37ab","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00014","start":394,"end":469,"exact":"Erdoğan is also allegedly considering granting autonomy to Turkey’s Kurds. "},{"@id":"urn:doxa:passage:bbc934edd4c0c30b71e34f4886785d3c59eeaa96cc1fe9add3a019ab127851c0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00014","start":469,"end":622,"exact":"What this means in practice is unknown, but it would likely include measures such as legally protected cultural rights and perhaps territorial autonomy. "},{"@id":"urn:doxa:passage:c917af728a7f9ad19f10d475afd682ba5bd64f089558a494d799375b93351ba6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00014","start":622,"end":730,"exact":"Together, Öcalan’s release and cultural/administrative autonomy would be gains that would be hard to refuse."},{"@id":"urn:doxa:passage:5c39f560492d62ea9d158fbf983f9a7bf5a4e3966cf1e89ae7811494bb917dbc","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00015","start":0,"end":89,"exact":"These dynamics were complicated by the March 19 arrest of Istanbul mayor Ekrem İmamoğlu. "},{"@id":"urn:doxa:passage:e6b7f773ddcceeb2a25c55d43f17e4351758b07300b27bc6eed83c047eaf4ed0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00015","start":89,"end":352,"exact":"He is a threat to Erdoğan’s continued rule, as he has a strong electoral record of defeating the AKP in local elections. İmamoğlu is widely seen by opposition voters as Turkey’s next president, and as the CHP candidate most capable of attracting Kurdish support. "},{"@id":"urn:doxa:passage:84cb866854b931a50de71df3153bdeaba753971a21ba9c62453f27b069e4a4a2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00015","start":352,"end":555,"exact":"It is unlikely that a government willing to imprison such an opposition figure on trumped-up charges will be able to make the democratic and legal reforms that Kurds demand as part of the peace process. "},{"@id":"urn:doxa:passage:c56d4e714cb2eb1e3ae07b42f3d2461e71dfca9151c9202ac95efc021219c849","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00015","start":555,"end":752,"exact":"At the same time, it will be difficult for the PKK and the DEM Party to reject negotiations outright with all that is at stake, a decision that would drive a wedge between Kurds and the opposition."},{"@id":"urn:doxa:passage:f506099a9c312ad4eea63f778af358da1f5be241f32910d282dc356e627c4745","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00016","start":0,"end":122,"exact":"Satisfying Kurds’ political demands inside Turkey is a necessary but insufficient condition for securing a lasting peace. "},{"@id":"urn:doxa:passage:e822a60ce7de1cf6d3844a2d7068e110917f2bd32e0e4f9bb77996a3ca29d714","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00016","start":122,"end":190,"exact":"The PKK is unlikely to disarm and dissolve in exchange for nothing. "},{"@id":"urn:doxa:passage:ab2b4d14e28ae4a38cc15742e80d27bca490b818e95eeecd3d3e4b78e0e78816","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00016","start":190,"end":349,"exact":"Giving Syrian Kurds a chance in negotiations is one of the few interests powerful enough to justify such major concessions to the group’s leaders and members. "},{"@id":"urn:doxa:passage:0cd7d5a3e2ff99f0048722596e3c51ed0d373025a3a97efcc6fd223e042f367a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00016","start":349,"end":461,"exact":"If this interest is off the table, the likelihood of splinter groups and spoiler violence increases drastically."},{"@id":"urn:doxa:passage:f79b0430aca57aa9118a57ed2b8a32aeac5e3a9a583e3dc7e21055f47182a7b9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00017","start":0,"end":315,"exact":"If Syrian Kurdish parties continue to be left out of their country’s political settlement at Turkey’s request, the new government will likely create a centralized system with no protections for Kurdish identity, language, and culture — conditions that spawned Kurdish rebellion under the regime of Bashar al-Assad. "},{"@id":"urn:doxa:passage:7ed75573b66969cb95c19d3626ed48f985777a6328fb4cfd56f364ced9d4557e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00017","start":315,"end":522,"exact":"Kurdish forces are also the only major alternative to the new transitional government’s hardline Islamist politics, advocating for religious freedom and the inclusion of women in addition to Kurdish rights. "},{"@id":"urn:doxa:passage:28b502c1f59bf2122cdc58823ab9e1d9047673328415e99ba2011a4542bc24ae","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00017","start":522,"end":769,"exact":"Recent massacres of Alawites on Syria’s coast by interim government forces and Turkey-backed Syrian National Army (SNA) militias, some of which are under U.S. sanctions, show a grim vision of what Syria’s future will be if the SDF is not included."},{"@id":"urn:doxa:passage:af50991349f2e358c2cbb6db6cd26510965450b05152da30062d9dbe0889aa84","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00018","start":0,"end":310,"exact":"If Turkey violates the U.S.-brokered ceasefire that has been in place between Manbij and Kobane since December and takes further military action against Syrian Kurds, they will restart the Syrian Civil War, give ISIS a new lease on life, and make any Turkish-Kurdish reconciliation impossible for a generation."},{"@id":"urn:doxa:passage:5db83e71bf2c8032a5d5e6341ba65151ddf286ea640202761525ec73926f8ba0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:22a4e2e437241fb16020940b0e08cf04","blockId":"gv-831394-b00019","start":0,"end":55,"exact":"These are all outcomes that the U.S. is keen to avoid. "},{"@id":"urn:doxa:decision:4725466a7bfda9feb778c2af600bd834","@type":["doxa:Decision","prov:Entity"],"recordId":"4725466a7bfda9feb778c2af600bd834","outcome":"does_not_meet","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:22a4e2e437241fb16020940b0e08cf04:u_f818a1eaef08fd3b180c858c","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:3551483b4a36fd9f583ed6a48554da1f2a2935855eca27302dc475bab55afbc0","urn:doxa:passage:8d5384e3f574783200af131317a6ca664e1fd