{"@context":{"@vocab":"https://tacitus.me/doxa/terms#","doxa":"https://tacitus.me/doxa/terms#","dct":"http://purl.org/dc/terms/","prov":"http://www.w3.org/ns/prov#","oa":"http://www.w3.org/ns/oa#","title":"dct:title","exact":"oa:exact","start":"oa:start","end":"oa:end","sourceUrl":{"@id":"dct:source","@type":"@id"},"license":{"@id":"dct:license","@type":"@id"},"generatedBy":{"@id":"prov:wasGeneratedBy","@type":"@id"},"fromSource":{"@id":"prov:wasDerivedFrom","@type":"@id"},"inStudy":{"@id":"doxa:inStudy","@type":"@id"},"inFramework":{"@id":"doxa:inFramework","@type":"@id"},"evaluates":{"@id":"doxa:evaluates","@type":"@id"},"scoredUnit":{"@id":"doxa:scoredUnit","@type":"@id"},"modelPassage":{"@id":"doxa:modelPassage","@type":"@id"},"unitContext":{"@id":"doxa:unitContext","@type":"@id"},"commentsOn":{"@id":"doxa:commentsOn","@type":"@id"},"selectedPassage":{"@id":"doxa:selectedPassage","@type":"@id"},"pairedDecision":{"@id":"doxa:pairedDecision","@type":"@id"}},"@id":"urn:doxa:graph:muslim-coverage-1:1","@graph":[{"@id":"urn:doxa:study:muslim-coverage-1","@type":["doxa:Study","prov:Entity"],"recordId":"muslim-coverage-1","selectionSha256":"7769ea9ab2349bbdceab61681c938895bedc1e8474540e63190f5da629074b27","independentHumanLabels":false,"freshInferenceRequests":0},{"@id":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","@type":["doxa:AnalysisRun","prov:Activity"],"recordId":"b2a2edd4ca7047128a5e433d8a874530","model":"@cf/google/gemma-4-26b-a4b-it","provider":"cloudflare","status":"partial","configSha256":"24be0b1368e4697a1844f7addc6327763420ef60689e704e560149db2954cd35","archiveSha256":"783432b8430aeadc0bcce665e897bba33d8b9a14f718f70f0c5a988c1e884827"},{"@id":"urn:doxa:framework:anti-muslim-hostility:2026-03-operational-1:6ac9353d9e716e7863d482cf4156178fe6729ae77c2d444551ea452da1ff4189","@type":["doxa:Framework","prov:Entity"],"recordId":"anti-muslim-hostility","title":"Anti-Muslim hostility · England 2026","version":"2026-03-operational-1","sourceUrl":"https://www.gov.uk/guidance/a-definition-of-anti-muslim-hostility","snapshotSha256":"6ac9353d9e716e7863d482cf4156178fe6729ae77c2d444551ea452da1ff4189"},{"@id":"urn:doxa:criterion:anti-muslim-hostility:targeted_hostility:2026-03-operational-1:72f7ea3551be2ef7fd32d774ee261f75056cf16c773d8b5a2d7a194b6c879a2d","@type":["doxa:Criterion","prov:Entity"],"recordId":"targeted_hostility","title":"Hostility toward Muslims","rule":"Identify evidenced threatening, abusive, or hostile expression targeting people because they are Muslim or perceived to be Muslim.","kind":"indicator","inFramework":"urn:doxa:framework:anti-muslim-hostility:2026-03-operational-1:6ac9353d9e716e7863d482cf4156178fe6729ae77c2d444551ea452da1ff4189"},{"@id":"urn:doxa:criterion:anti-muslim-hostility:stereotyping_and_intent:2026-03-operational-1:07d629353e1806de5b8b1a9c1b3000a003614c74470cf23c5ebe4839ea602097","@type":["doxa:Criterion","prov:Entity"],"recordId":"stereotyping_and_intent","title":"Stereotyping and intent","rule":"Assess stereotyping intended to encourage hatred of Muslims. If intent is not established by context, explicitly mark insufficient_context rather than claiming it.","kind":"indicator","inFramework":"urn:doxa:framework:anti-muslim-hostility:2026-03-operational-1:6ac9353d9e716e7863d482cf4156178fe6729ae77c2d444551ea452da1ff4189"},{"@id":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","@type":["doxa:Criterion","prov:Entity"],"recordId":"discrimination_claim","title":"Targeted discrimination indicators","rule":"Identify stated exclusion or unequal treatment directed at Muslims; do not pronounce legal unlawfulness from a passage.","kind":"indicator","inFramework":"urn:doxa:framework:anti-muslim-hostility:2026-03-operational-1:6ac9353d9e716e7863d482cf4156178fe6729ae77c2d444551ea452da1ff4189"},{"@id":"urn:doxa:framework:anti-muslim-racism:2025-operational-1:082df6dd629a01f58fbc28903d94b73fdbd5ddfbc5c89802e424891105f2bb83","@type":["doxa:Framework","prov:Entity"],"recordId":"anti-muslim-racism","title":"Islamophobia · structural racism","version":"2025-operational-1","sourceUrl":"https://www.runnymedetrust.org/publications/islamophobia-towards-a-working-definition","snapshotSha256":"082df6dd629a01f58fbc28903d94b73fdbd5ddfbc5c89802e424891105f2bb83"},{"@id":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","@type":["doxa:Criterion","prov:Entity"],"recordId":"racialization","title":"Racialization and essentializing","rule":"Assess treating Muslims or perceived Muslims as a homogeneous, inferior, threatening, or inherently suspect population.","kind":"indicator","inFramework":"urn:doxa:framework:anti-muslim-racism:2025-operational-1:082df6dd629a01f58fbc28903d94b73fdbd5ddfbc5c89802e424891105f2bb83"},{"@id":"urn:doxa:criterion:anti-muslim-racism:exclusion:2025-operational-1:58af664b53f3bbc982a55b72222757384bb7ee5f78fe0304068038feb47eafe4","@type":["doxa:Criterion","prov:Entity"],"recordId":"exclusion","title":"Exclusion and unequal treatment","rule":"Identify expressed exclusion, discriminatory expectations, or restrictions attached to Muslim identity.","kind":"indicator","inFramework":"urn:doxa:framework:anti-muslim-racism:2025-operational-1:082df6dd629a01f58fbc28903d94b73fdbd5ddfbc5c89802e424891105f2bb83"},{"@id":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","@type":["doxa:Criterion","prov:Entity"],"recordId":"institutional_pattern","title":"Institutional pattern hypothesis","rule":"Identify an evidenced institutional practice or repeated pattern. One passage cannot by itself establish a systemic pattern; mark insufficient context when required.","kind":"indicator","inFramework":"urn:doxa:framework:anti-muslim-racism:2025-operational-1:082df6dd629a01f58fbc28903d94b73fdbd5ddfbc5c89802e424891105f2bb83"},{"@id":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","@type":["doxa:SourceVersion","prov:Entity"],"recordId":"gv-695954","title":"Life on the margins: The Lyuli people of Uzbekistan","author":"Filip Noubel","translator":[],"publishedOn":"2020-02-18","sourceUrl":"https://globalvoices.org/2020/02/18/life-on-the-margins-the-lyuli-people-of-uzbekistan/","license":"https://creativecommons.org/licenses/by/3.0/","contentSha256":"c49c2eaeee12c4ef2a98c9c0280c6fd5d62f48c0925865d1944c571544594109","textSha256":"5016e681fce17041fe9215f681a5390d2213047034a040febcbdad2821240ec5","archivedRecordSha256":"508061777aef2302e742700e5e0b5832de8be20ef23207c47d92d9bfe165d7fa","inStudy":"urn:doxa:study:muslim-coverage-1"},{"@id":"urn:doxa:unit:67994cd85b93c60bbbcaf18e10673ebc:u_4d06c7a36027df4fb5f68b8a","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_4d06c7a36027df4fb5f68b8a","status":"accepted","fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc"},{"@id":"urn:doxa:unit:67994cd85b93c60bbbcaf18e10673ebc:u_c9d6c96512aab738699ac3da","@type":["doxa:SourceUnit","prov:Entity"],"recordId":"u_c9d6c96512aab738699ac3da","status":"accepted","fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc"},{"@id":"urn:doxa:passage:452eb331542e2914ab678ebf382786cd85deb8d430d0d575cdceeb55560181f6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00001","start":0,"end":159,"exact":"Uzbekistan was the cradle of several empires and nations in Central Asia, a characteristic that is reflected in its multiethnic population of over 30 million. "},{"@id":"urn:doxa:passage:9b746306f9ef5f7f8948376af91bbee0aa6feee34db836a7f2a24011cd4365d8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00001","start":159,"end":267,"exact":"While ethnic Uzbeks comprise the majority, there are close to 50 other groups, including the Luli or Lyuli. "},{"@id":"urn:doxa:passage:ef28d7518c2cfe25d3d827da9da6a6ed8e3af5ced916a8d97ae276f711563adf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00001","start":267,"end":374,"exact":"This small community lives on the margins of Uzbek society, often discriminated because of their ethnicity."},{"@id":"urn:doxa:passage:6b121af296235f57814fa0d8f963fd99f9be718b3fb868fc731b20dac3546d69","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00002","start":0,"end":138,"exact":"The Lyuli are believed to be distantly related to the Roma and Sinti people of Europe and the Middle East, but their origins are obscure. "},{"@id":"urn:doxa:passage:8156539d361b7299a2c496b3be92fb0488417d346b3d1e4d73ffc4fc6d4b7220","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00002","start":138,"end":234,"exact":"As such, there is currently little consensus on how to best describe this community in English. "},{"@id":"urn:doxa:passage:db294fa2e239c7843afc98de24d3683d6a32e8d2ff5e70db29484c9adf6da588","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00002","start":234,"end":421,"exact":"In Russian, the most commonly used term is “цыгане” — usually translated into English as “Gypsies”, which is widely considered derogatory and has largely been replaced by the word “Roma.”"},{"@id":"urn:doxa:passage:f71505e5a3e3c35cb36c15aae4d6b58bef93de8fe9d95e1ba76cf440850b31b4","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00003","start":0,"end":73,"exact":"According to a 2019 study conducted by Uzbek researcher Kamilla Zakirova:"},{"@id":"urn:doxa:passage:28f9aa640db3dd11cb665d379c59070b752ce7821213859381afa1c128db6206","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00004","start":0,"end":50,"exact":"> Central Asia's [Roma] are usually called Lyuli. "},{"@id":"urn:doxa:passage:f665b01122a9ae3d5e372f6079fc5a3a41738239e3554621e0de6f8ea995c6ea","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00004","start":50,"end":184,"exact":"The Lyuli describe themselves using the term Mughat, an Iranian term meaning “fire cult followers,” which is applied to Zoroastrians. "},{"@id":"urn:doxa:passage:e7202e1255a86d521b7478f08f637d916f02bf82ca87e0fbca3bb8a2f6ca7387","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00004","start":184,"end":328,"exact":"They have inhabited the territories of Central Asia for centuries, ever since their ancestors migrated from the Punjab in present day Pakistan. "},{"@id":"urn:doxa:passage:bbbfaa2c34ef4e216466be4b171be2b2d6c03dfbb19715aabd15d2f48dbfb51e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00004","start":328,"end":529,"exact":"There are no accurate contemporary data on the Lyuli population because it does not participate in the government conducted census and many members of the Lyuli population never obtain legal documents."},{"@id":"urn:doxa:passage:739373f4547e3c903747e05c1dc35867e7fd8306f3e3a35ec84a95f50064c97d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00005","start":0,"end":194,"exact":"I interviewed Aleksandr Barkovsky, a conceptual artist and activist who, himself an ethnic Russian, took a personal interest in the Lyuli, and made a series of short videos about the community. "},{"@id":"urn:doxa:passage:60a6df2a539428595e6bc2d13f7c33436940181b157bc11eda5bb8b0a45a1296","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00005","start":194,"end":236,"exact":"The interview has been edited for brevity."},{"@id":"urn:doxa:passage:846f565a80f3118303c85b2ad0771ddca88bb881c6e23136cb724f26618610f5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00006","start":0,"end":65,"exact":"Filip Noubel: What is the main social issue the Lyuli face today?"},{"@id":"urn:doxa:passage:2244cb5467b212b31f4c5c00ec5c889a9b41844e5dcc586f0967c880f3b74e77","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00007","start":0,"end":869,"exact":"> Александр Барковский: Проблема образования – негласное решение с обеих сторон о недостижимости образования и отчасти его ненадобности. причины этого происходят по вине обеих сторон, как цыган, в основном из-за их патриархальных принципов, когда глава клана авторитарный мужчина имеет единственное право голоса и принимает решение не в пользу получения образования, а чаще всего в пользу сложившихся правил диаспоры. В обществе доминирует идея того, что цыгане «люли» сами сделали свой выбор не в пользу получения образования и давать им возможность учится и получать различные профессии не имеет никакого смысла. Хотя при опросе самих цыган «люли» можно узнать, что среди них есть большой процент желающих изменить свою судьбу. Взрослые цыгане говорят, что хотят для своих детей «лучшей судьбы» и понимают, что этого можно добиться при получении хорошего образования."},{"@id":"urn:doxa:passage:a7890fef756005fc5cfc354e97422295059108e410b4db1b15fa375da286407f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00008","start":0,"end":47,"exact":"> Aleksandr Barkovsky: The issue of education. "},{"@id":"urn:doxa:passage:3335bc76f9cef5c9b47c571dde382890bf4c1b67932d0cd1c4c77ec635358d43","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00008","start":47,"end":135,"exact":"There is an unspoken consensus that education is unattainable and partially not needed. "},{"@id":"urn:doxa:passage:f2cf955e9838c02468a5672fd42f704cf817a51a5f37b63508beb3e3f4a19a70","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00008","start":135,"end":399,"exact":"The reasons for this lie on both sides, as the Roma people maintain patriarchal traditions and thus the head of the clan, a man who concentrates all the authority, makes decisions not in favour of education but in favour of the rules established in the community. "},{"@id":"urn:doxa:passage:78b18cb7f7bf2e15a37dc2b73088203fa885a3768516924a08ef84fecff47ae8","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00008","start":399,"end":540,"exact":"Most people think that as the Lyuli choose not to pursue education, giving them a chance to study and learn different skills is meaningless. "},{"@id":"urn:doxa:passage:a31020ca31cdcf6963b9570c88648a9f3c2085684577a847d205b607f0742858","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00008","start":540,"end":630,"exact":"Yet if one surveys the community, one can find many Lyuli who want to change their lives. "},{"@id":"urn:doxa:passage:e37a5571f8b551abd46bedc1b0afb1ce5fa68983b4198f7cd1501647f5f4f24d","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00008","start":630,"end":774,"exact":"Adults say that they want “a better life for their children,” and understand that the only way to achieve that is to get good quality education."},{"@id":"urn:doxa:passage:9d1c198d962f1598418fc055ca8516dcbd7986a77cbb2f8f598ee661aba56209","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00009","start":0,"end":69,"exact":"FN: Does that mean Lyuli children really have no access to education?"},{"@id":"urn:doxa:passage:8ee3e8f974899cffb0057edd8c709d8c0fb895c440e1e6c7e01784523fe20643","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00010","start":0,"end":487,"exact":"> AБ: Большая проблема цыган «люли» это дети лишенные детства. В семьях цыган «люли» детей рожают много, но выживают из них только половина иногда меньше. Уже с первых недель жизни мать берет ребёнка с собой в город где она ходит целый день летом под палящем солнцем зимой под снегом, в одной руке держа ребёнка, а другой прося милостыню. Таким образом ребёнок можно сказать что с молоком матери уже впитывает в себя картину мира попрошайничества, лишений, унижений и бесконечных побоев."},{"@id":"urn:doxa:passage:f8539657cbd1c96f2495413845f11955b85727a39856e7a01b5d533fa0625771","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:67994cd85b93c60bbbcaf18e10673ebc","blockId":"gv-695954-b00011","start":0,"end":99,"exact":"> AB: One of the biggest problems is the fact that Lyuli children are deprived of their childhood. "},{"@id":"urn:doxa:decision:3d6189ced2267f38c744015d365a56a1","@type":["doxa:Decision","prov:Entity"],"recordId":"3d6189ced2267f38c744015d365a56a1","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:67994cd85b93c60bbbcaf18e10673ebc:u_4d06c7a36027df4fb5f68b8a","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"rev