8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:institutional_pattern:2025-operational-1:ecbb016b6baf762e73d31e3b32c63b7fc6774025c77f32ff9fd824284fb4ac7b","scoredUnit":"urn:doxa:unit:e54438a8b4a9e8826a3d1a82f568264a:u_721b8257441844e21e00464b","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cd32cf046b4600285c92f699656cd66c5e08972041b65a6ab7bd24baaf07cd2c","urn:doxa:passage:252ad71e72265829d28ee8e2bc9ac800ef99e09ae0a6850661d8c2f641d298b8","urn:doxa:passage:5fb6973c57110b13182086275ff7268b318e0e543bbb804d76a08316aed0d6dc","urn:doxa:passage:5e7910ac1a7932b3927967a9eaf0035b8ac8501170b804497c1423e410fb587a","urn:doxa:passage:cd003c24f0c5933affdec4bc1aab68d697c5b76ac91695ebd93a28aebb8d41e1","urn:doxa:passage:a32299d9a7dfaab024631559688579fbc3e8cff4ca59da93c1439ba7c55c5469","urn:doxa:passage:71fee35f4146ca0725532a36b9d607f51cbc20ab8e4f96dee294b35da0da1dc7","urn:doxa:passage:24b24f4ed525dc82b4e854b1abae4c2e8d487c8fc54ed502992a461e9d814ee0","urn:doxa:passage:eb7f3f2042b2d87e1d673088c6e5290cb3df8f2dde5e118bd4b013a231403730"]},{"@id":"urn:doxa:decision:e8cadd055f6abefe20253e314001d394","@type":["doxa:Decision","prov:Entity"],"recordId":"e8cadd055f6abefe20253e314001d394","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-racism:racialization:2025-operational-1:22ba2440d280286f7582830210857fa8b3d81eaaa16f9803c2cd8ab087e9a643","scoredUnit":"urn:doxa:unit:e54438a8b4a9e8826a3d1a82f568264a:u_721b8257441844e21e00464b","attribution":"unknown","speaker":"Unknown","speakerStance":"not_applicable","documentStance":"not_applicable","proposition":"","hypothetical":false,"reviewStatus":"unreviewed","unitContext":["urn:doxa:passage:cd32cf046b4600285c92f699656cd66c5e08972041b65a6ab7bd24baaf07cd2c","urn:doxa:passage:252ad71e72265829d28ee8e2bc9ac800ef99e09ae0a6850661d8c2f641d298b8","urn:doxa:passage:5fb6973c57110b13182086275ff7268b318e0e543bbb804d76a08316aed0d6dc","urn:doxa:passage:5e7910ac1a7932b3927967a9eaf0035b8ac8501170b804497c1423e410fb587a","urn:doxa:passage:cd003c24f0c5933affdec4bc1aab68d697c5b76ac91695ebd93a28aebb8d41e1","urn:doxa:passage:a32299d9a7dfaab024631559688579fbc3e8cff4ca59da93c1439ba7c55c5469","urn:doxa:passage:71fee35f4146ca0725532a36b9d607f51cbc20ab8e4f96dee294b35da0da1dc7","urn:doxa:passage:24b24f4ed525dc82b4e854b1abae4c2e8d487c8fc54ed502992a461e9d814ee0","urn:doxa:passage:eb7f3f2042b2d87e1d673088c6e5290cb3df8f2dde5e118bd4b013a231403730"]},{"@id":"urn:doxa:passage:6f5fa7b017957c7bdf3553d1164fdcc9986cfeb24eed8876ff9e3d97f7a2b8aa","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00001","start":0,"end":123,"exact":"In Senegal, women who are victims of rape can be condemned for trying to take control of their lives by having an abortion."},{"@id":"urn:doxa:passage:ad30e1170bf39b517a42409abaf7733b0df9b734209ce402f0235f4c57d5d686","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00002","start":0,"end":190,"exact":"Like many other African countries, Senegal ratified the Maputo Protocol on December 27, 2004, an African Union treaty that promotes and protects the rights of women and girls across Africa. "},{"@id":"urn:doxa:passage:122eb0a41f8a4cd10bddb81229473c181681a6f422d66a38df269dde3f2355e2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00002","start":190,"end":255,"exact":"According to the provisions of Article 14, signatory states must:"},{"@id":"urn:doxa:passage:529ae359a1c0268da353a4bbab5577e215f9f830b4b8bea19f4decafe04f7309","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00003","start":0,"end":216,"exact":"> (…) autoriser l’avortement médicalisé en cas d’agression sexuelle, de viol, d’inceste, ou lorsque la poursuite de la grossesse met en danger la santé mentale ou physique de la mère ou la vie de la mère ou du fœtus."},{"@id":"urn:doxa:passage:05d358a1a9e650664d4f7a530a21f1485ab35222db0e92cdcd3988a255cf8722","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00004","start":0,"end":203,"exact":"> Authorize medical abortion in cases of sexual assault, rape, incest, and where carrying the pregnancy to term endangers the mental and physical health of the mother or the life of the mother and fetus."},{"@id":"urn:doxa:passage:b4b871323195f19178d1aa0b7d06f2bb988e65b4928c5be7c2843d089836e255","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00005","start":0,"end":60,"exact":"However, in Senegal, this right largely remains mere words. "},{"@id":"urn:doxa:passage:20fea236126f28543d8c815bd951020f6ab9be0e3c609e44b8509f1cd1a39851","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00005","start":60,"end":389,"exact":"Human rights organizations, such as the International Federation for Human Rights (FIDH), the Senegalese League of Human Rights (LSDH), and the African Assembly for the Defence of Human Rights (RADDHO), a national NGO based in the Senegalese capital Dakar, denounce the State’s non-compliance with its international commitments. "},{"@id":"urn:doxa:passage:38e1bb6e008e54f9f6f249ca93d95e43b50f8279bbbf8f3e2c1bfb45450596c0","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00005","start":389,"end":649,"exact":"In 2024, these three organizations published their Dual Hardship report, warning that Article 14 of the Maputo Protocol has not been transposed into national legislation, and that women victims of rape or incest must consequently carry their pregnancy to term."},{"@id":"urn:doxa:passage:9faa1807f10108846973364b4bbd0236060e70f79bd9aa5089e2a241be302f67","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00006","start":0,"end":146,"exact":"In Senegal, Article 305 of the Criminal Code prohibits abortion, except under limited therapeutic circumstances intended to save a mother’s life. "},{"@id":"urn:doxa:passage:794cc7357683463dec0b59db93e8168fe9506fd2c78fcbd4bc4e1000c3be4b72","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00006","start":146,"end":286,"exact":"This situation drives many women, including the victims of rape or incest, towards illegal, dangerous, and often life-threatening practices."},{"@id":"urn:doxa:passage:19ac81f4a058e09333fc249e1280a2aa95139d59a36f19e30de7c6491f17627c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00007","start":0,"end":242,"exact":"According to Prison-Insider, a France-based platform that shares information on prisons across the world, up to 46 percent of the women held in Liberté VI prison in Senegal are convicted of infanticide, demonstrating the scale of the problem."},{"@id":"urn:doxa:passage:25c0e0978babe1f7234c4537ed41a92cfe03cb510bf8ab28a94e4ed899f38f14","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00008","start":0,"end":106,"exact":"While the right to abortion is barely recognized, the reasons are not only legal, but also socio-cultural."},{"@id":"urn:doxa:passage:549660c8380c225be1818569c316b28238328fb8312a67031f48fd453c00a728","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00009","start":0,"end":18,"exact":"Religious argument"},{"@id":"urn:doxa:passage:a3f68494d1f907d21ebc4f4b92c6d0b8a9f5fd94cbc7b6545bc1f106c6e5ae43","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00010","start":0,"end":86,"exact":"The religious argument is the most often used to justify the prohibition of abortion. "},{"@id":"urn:doxa:passage:d65b992c0bf544748a47d775b227e475b964a99c084e55dd2aae9ae230d531eb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00010","start":86,"end":181,"exact":"Although 95 percent of the Senegalese population is Muslim, the country is a secular republic. "},{"@id":"urn:doxa:passage:87e6d2fffa74a47687c77caa977c2916885c7c647c2185d9b330a438ec361fdf","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00010","start":181,"end":222,"exact":"Article 1 of its constitution stipulates:"},{"@id":"urn:doxa:passage:c970e3d9e9032c7496de1275c3075fc2c613b11d1ff1d6480ca2b9df68c70df7","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00011","start":0,"end":64,"exact":"> La République du Sénégal est laïque, démocratique et sociale. "},{"@id":"urn:doxa:passage:b8d33bd97c744b7f93ccb66bcbab7bb7707a93d7d4ee06b1ae7391ef574480a9","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00011","start":64,"end":181,"exact":"Elle assure l’égalité devant la loi de tous les citoyens, sans distinction d’origine, de race, de sexe, de religion. "},{"@id":"urn:doxa:passage:1238fbd7f69790d1c06b9d5c03137be60d05368e7e889aff7e88141d15c6f204","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00011","start":181,"end":216,"exact":"Elle respecte toutes les croyances."},{"@id":"urn:doxa:passage:a83e78c8356b36c7ffa0f4433c5f3e3807e1f4c7176de2441ab099420cb556e5","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00012","start":0,"end":62,"exact":"> The Republic of Senegal is secular, democratic, and social. "},{"@id":"urn:doxa:passage:782ab5cd0510ccf80153004746ac66e4076fcd2d378cf25e609be5905c02c61e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00012","start":62,"end":166,"exact":"It ensures that all citizens are equal before the law, regardless of origin, race, gender, or religion. "},{"@id":"urn:doxa:passage:714a91e937f6f2470e4caab92afaa58ad17c6a6d7992fc3200b028bd785cb291","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00012","start":166,"end":190,"exact":"It respects all beliefs."},{"@id":"urn:doxa:passage:467c87e33e77c64a9ab1f877a38912805552d370a4b082e2cad05bb5b5a86711","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00013","start":0,"end":83,"exact":"Under a secular state, the debate should stay within the medical and legal fields. "},{"@id":"urn:doxa:passage:1c4bf40e078fc8fc9de8cc096b299e422d86eaf14250b86ab20ebd6cf3828d0f","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00013","start":83,"end":309,"exact":"It is worth noting that according to some Muslim traditions, the soul is breathed into the fetus 120 days after the embryo’s development, meaning that terminating a pregnancy before this date does not constitute ending a life."},{"@id":"urn:doxa:passage:0de3fd43db39795399ccb1f2931cec0fafd817491081e28e33b134f5481e3f67","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00014","start":0,"end":121,"exact":"In any case, all women have the right to make decisions about their bodies without any collective religious constraints. "},{"@id":"urn:doxa:passage:4d667c6c85968ddc64b675a49e36ba65d2c25b0e0a2a6050797295bb30b9d69a","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00014","start":121,"end":249,"exact":"Should the argument that an unborn child has no say in the matter take away the rights of women whose consent was not requested?"},{"@id":"urn:doxa:passage:ef84cfe5eca384693d8c1cf41e547952eab362a73aa2deca312a358554e32f25","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00015","start":0,"end":84,"exact":"Why sacrifice the lives of an already wounded conscious being for a potential life? "},{"@id":"urn:doxa:passage:01b966782588a40779e5007d5e3983a2e137eb0245393ba53667addbbf13366b","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00015","start":84,"end":182,"exact":"This argument doesn’t hold up when looking at women’s mental health, physical health, or dignity. "},{"@id":"urn:doxa:passage:a04de3b348993ca45de052467440263d682595853cff7f5a966b6ad498f83ffb","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00015","start":182,"end":233,"exact":"The right to bodily autonomy must take precedence. "},{"@id":"urn:doxa:passage:25fe2cd805676900ae4e01963928b757c9606ff34269232e648a43388a16f935","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00015","start":233,"end":383,"exact":"Asking a victim of rape or ’incest to carry an unwanted pregnancy to term for the sake of “societal values” is hypocritical, harsh, and deeply unjust."},{"@id":"urn:doxa:passage:b3eb4f36077e39c179d978e1e5234ab225e04a493e520358c098b94c68da7e68","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00016","start":0,"end":26,"exact":"Protecting moral standards"},{"@id":"urn:doxa:passage:750e77e11e002f7d3166fac426c3a38ee6c90b78036340f1cb2f38d0bb7d828e","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00017","start":0,"end":76,"exact":"The other argument used against the right to abortion is that of tradition. "},{"@id":"urn:doxa:passage:1897611e34d2a3fbee472f7f73de6ce7b26570b0b3c8d5dc619e49d54f48003c","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00017","start":76,"end":125,"exact":"What “moral standards” are we trying to protect? "},{"@id":"urn:doxa:passage:75343d6cdb42e090a40643c62f9a89a2d4dd9d60dd4c9af5ff1a1c367315a9d2","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00017","start":125,"end":202,"exact":"If “morals” mean controlling women’s bodies, then these morals are outdated. "},{"@id":"urn:doxa:passage:6cb605c0f143e1dff4fafea3d6187dc339d4b4f74c5f8f5f1cc6e83a0c6187f6","@type":["doxa:Passage","prov:Entity"],"fromSource":"urn:doxa:source:e54438a8b4a9e8826a3d1a82f568264a","blockId":"gv-847681-b00017","start":202,"end":304,"exact":"The “moral standards” we should protect are women’s dignity and freedom, not patriarchal conservatism."},{"@id":"urn:doxa:decision:d062f6d7f811ca5d7e3ad2ea52b946d0","@type":["doxa:Decision","prov:Entity"],"recordId":"d062f6d7f811ca5d7e3ad2ea52b946d0","outcome":"not_applicable","generatedBy":"urn:doxa:run:b2a2edd4ca7047128a5e433d8a874530","evaluates":"urn:doxa:criterion:anti-muslim-hostility:discrimination_claim:2026-03-operational-1:794fad83018ea1e0de86fe60ff7dec7a18160eddcba979e1750fdd782a8456f3","scoredUnit":"urn:doxa:unit:e